msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:11pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:14px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:"
"large; font-weight:600;\">បង្កើត និង​ចែករំលែក​កម្មវិធី​បន្ថែម​ប្លាស្មា</span></p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ជាមួយ Plasmate អ្នក​អាច​បង្កើត​"
"កម្មវិធី​បន្ថែម​ប្លាស្មា​ផ្ទាល់​ខ្លួន​របស់​អ្នក​យ៉ាង​ងាយស្រួល ឧទាហរណ៍​ប្លាស្មា​ដែល​បាន​សរសេរ​នៅ​ក្នុង Qt "
"Quick, JavaScript, Python or Ruby . Plasmate ណែនាំ​អ្នក​អ្នក​អំពី​ដំណើរការ​នៃ​ការ​នាំចូល​"
"កម្មវិធី​បន្ថែម​ដែល​មាន​ស្រាប់ រ​ការ​បង្កើត​ថ្មី​​ចេញពី scratch, ប្រតិបត្តិ​ការងារ​របស់​អ្នក និង​ការ​នាំចេញ​"
"កញ្ចប់​ប្លាស្មា​ដែល​រួចរាល់​សម្រាប់​ដំឡើង​កុំព្យូទ័រ​របស់​អ្នក ឬ​ការ​បោះពុម្ពផ្សាយ​ទៅ​កាន់​ពិភពលោក​ដោយ​ប្រើ Get "
"Hot New Stuff System. <br /></p>\n"
"<p style=\" margin-top:14px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-size:"
"large; font-weight:600;\">ចាប់ផ្ដើម​ជាមួយ Plasmate...</span></p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Plasmate ផ្ដល់​នូវ​ឧបករណ៍​ទាំងអស់​ដែល​"
"អ្នក​ត្រូវការ​ដើម្បី​រៀន​បង្កើត​ធាតុ​ក្រាហ្វិក​ប្លាស្មា​ថ្មីៗ ។ </p>\n"
"<ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-"
"right: 0px; -qt-list-indent: 1;\"><li style=\" margin-top:12px; margin-"
"bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-"
"indent:0px;\">ធ្វើ​តាម <span style=\" font-weight:600;\">មេរៀន</span> ដើម្បី​ចូលរួម​"
"ការ​អប់រំ និង​ស្វែងរក​អំពី​របៀប​បង្វែរ​គំនិត​របស់​អ្នក​ទៅ​រក​ការ​ពិត ។ </li>\n"
"<li style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">រកមើល​នៅ​លើ​បណ្ដាញ <span style="
"\" font-weight:600;\">ឯកសារ</span> សម្រាប់​ព័ត៌មាន​អំពី​ការ​ស្គ្រីប API ។ </li>\n"
"<li style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ធ្វើការ​លើ​គម្រោង​របស់​អ្នក​នៅ​ក្នុង "
"<span style=\" font-weight:600;\">កម្មវិធី​កែសម្រួល</span> កែសម្រួល​ស្គ្រីប និង​បន្ថែម​ធនធាន "
"។ </li>\n"
"<li style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">មើល​ជាមុន</span> ធាតុ​ក្រាហ្វិក​របស់​អ្នក​ពេល​អ្នក​ធ្វើការ​នៅ​លើ​វា ។ </li>\n"
"<li style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">នាំចេញ និង​ដំឡើង</span> លទ្ធផល​ជា​កញ្ចប់​ប្លាស្មា ។ </li>\n"
"<li style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">បោះពុម្ពផ្សាយ</span> ការ​បង្កើត​របស់​អ្នក​តាមរយៈ\t<span style=\" font-"
"style:italic;\">Get Hot New Stuff</span>. </li></ul>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">សូម​បង្កើត​តាម​សប្បាយ ! </p></"
"body></html>"

