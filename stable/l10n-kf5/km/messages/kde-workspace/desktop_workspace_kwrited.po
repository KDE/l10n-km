#: kwrited-autostart.desktop:2
msgctxt "Name"
msgid "KDE Write Daemon"
msgstr "ដេមិន​សរសេរ​របស់ KDE"

#: kwrited-autostart.desktop:92 kwrited.desktop:63
msgctxt "Comment"
msgid "Watch for messages from local users sent with write(1) or wall(1)"
msgstr "មើល​​សារ​ពី​អ្នក​ប្រើ​​មូលដ្ឋាន​ដែល​​បាន​ផ្ញើ​ដោយ​ប្រើ write(1) ឬ wall(1)"

#: kwrited.desktop:2
msgctxt "Name"
msgid "Write Daemon"
msgstr "សរសេរ Daemon"

#: kwrited.notifyrc:3
msgctxt "Comment"
msgid "Local system message service"
msgstr "សេវា​សារ​ប្រព័ន្ធ​មូលដ្ឋាន"

#: kwrited.notifyrc:67
msgctxt "Name"
msgid "New message received"
msgstr "បាន​ទទួល​សារ​ថ្មី"

#: kwrited.notifyrc:139
msgctxt "Comment"
msgid "The daemon received a new message sent with wall(1) or write(1)"
msgstr "ដេមិន​បាន​ទទួល​សារ​ថ្មី​ដែល​បានផ្ញើ​ដោយ​ wall(1) ឬ​ write(1)"
