#: knutresource.cpp:80
msgid "No data file selected."
msgstr "គ្មាន​ឯកសារ​ទិន្នន័យ​ដែល​បាន​ជ្រើស​ទេ ។"

#: knutresource.cpp:97
#, kde-format
msgid "File '%1' loaded successfully."
msgstr "បាន​ផ្ទុក​ឯកសារ '%1' ដោយ​ជោគជ័យ ។"

#: knutresource.cpp:122
msgid "Select Data File"
msgstr "ជ្រើស​ឯកសារ​ទិន្នន័យ"

#: knutresource.cpp:123
msgctxt "Filedialog filter for Akonadi data file"
msgid "Akonadi Knut Data File"
msgstr "ឯកសារ​ទិន្នន័យ Akonadi Knut"

#: knutresource.cpp:164 knutresource.cpp:323
#, kde-format
msgid "No item found for remoteid %1"
msgstr "រក​មិនឃើញ​ធាតុ​សម្រាប់ remoteid %1 ទេ"

#: knutresource.cpp:179
msgid "Parent collection not found in DOM tree."
msgstr "សម្រាំង​មេ​រកមិនឃើញ​នៅ​ក្នុង​មែកធាង DOM ទេ ។"

#: knutresource.cpp:187
msgid "Unable to write collection."
msgstr "មិនអាច​សរសេរ​​សម្រាំង​បាន​ទេ ។"

#: knutresource.cpp:201
msgid "Modified collection not found in DOM tree."
msgstr "សម្រាំង​ដែលបានកែប្រែ​រក​មិនឃើញ​នៅ​ក្នុង​មែកធាង DOM ទេ ។"

#: knutresource.cpp:234
msgid "Deleted collection not found in DOM tree."
msgstr "សម្រាំង​ដែល​បាន​លុប​រក​មិនឃើញ​នៅ​ក្នុង​មែកធាង DOM ទេ ។"

#: knutresource.cpp:250 knutresource.cpp:310 knutresource.cpp:317
#, kde-format
msgid "Parent collection '%1' not found in DOM tree."
msgstr "សម្រាំង​មេ '%1' រក​មិនឃើញ​នៅ​ក្នុង​មែកធាង DOM ទេ ។"

#: knutresource.cpp:258 knutresource.cpp:330
msgid "Unable to write item."
msgstr "មិនអាច​សរសេរ​ធាតុ​បាន​ទេ ។"

#: knutresource.cpp:273
msgid "Modified item not found in DOM tree."
msgstr "ធាតុ​ដែលបានកែប្រែ​រក​មិនឃើញ​នៅ​ក្នុង​មែកធាង DOM ទេ ។"

#: knutresource.cpp:289
msgid "Deleted item not found in DOM tree."
msgstr "ធាតុ​ដែល​បានលុប​រក​មិនឃើញ​នៅ​ក្នុង​មែកធាង DOM នោះ​ទេ ។"
