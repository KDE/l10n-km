#: data/kdenlive.notifyrc:3
msgctxt "Comment"
msgid "Kdenlive"
msgstr "Kdenlive"

#: data/kdenlive.notifyrc:43
msgctxt "Name"
msgid "Rendering finished"
msgstr "បាន​បញ្ចប់​ការ​បង្ហាញ"

#: data/kdenlive.notifyrc:79
msgctxt "Comment"
msgid "Rendering is over"
msgstr "ការ​បង្ហាញ​បាន​ចប់"

#: data/kdenlive.notifyrc:118
msgctxt "Name"
msgid "Rendering started"
msgstr "ការ​បង្ហាញ​បាន​ចាប់ផ្ដើម"

#: data/kdenlive.notifyrc:154
msgctxt "Comment"
msgid "Rendering was started"
msgstr "ការ​បង្ហាញ​ត្រូវ​បាន​ចាប់ផ្ដើម"

#: data/kdenlive.notifyrc:193
msgctxt "Name"
msgid "Frame captured"
msgstr "បាន​ចាប់​យក​ស៊ុម"

#: data/kdenlive.notifyrc:229
msgctxt "Comment"
msgid "A frame was captured to disk"
msgstr "ស៊ុម​ត្រូវ​បាន​ចាប់​យក​ទៅកាន់​ថាស"

#: data/kdenlive.notifyrc:269
msgctxt "Name"
msgid "Ready to capture"
msgstr "រួចរាល់​ដើម្បី​ចាប់​យក"

#: data/kdenlive.notifyrc:309
msgctxt "Name"
msgid "Error"
msgstr "កំហុស"

#: data/kdenlive.notifyrc:348
msgctxt "Comment"
msgid "An error occurred in Kdenlive"
msgstr "មាន​កំហុស​បាន​កើតឡើង​នៅ​ក្នុង Kdenlive"

#: data/org.kde.kdenlive.desktop:3
msgctxt "Name"
msgid "Kdenlive"
msgstr "Kdenlive"

#: data/org.kde.kdenlive.desktop:42
msgctxt "GenericName"
msgid "Video Editor"
msgstr "កម្មវិធី​កែសម្រួល​វីដេអូ"

#: data/org.kde.kdenlive.desktop:79
msgctxt "Comment"
msgid "Nonlinear video editor for KDE"
msgstr "កម្មវិធី​កែសម្រួល​វីដេអូ​មិន​លីនេអ៊ែរ​សម្រាប់ KDE"

#: thumbnailer/mltpreview.desktop:3
msgctxt "Name"
msgid "MLT Playlist"
msgstr "បញ្ជី​ចាក់ MLT"

