#: configdialog.cpp:58 configdialog.ui:14
msgid "Open-Xchange Configuration"
msgstr "កា​រកំណត់​រចនាសម្ព័ន្ធ Open-Xchange"

#: configdialog.cpp:63
msgid "Enter the http or https URL to your Open-Xchange installation here."
msgstr "បញ្ចូល URL http ឬ https នៅ​ក្នុង​ការ​ដំឡើង Open-Xchange របស់​អ្នក​នៅ​ទីនេះ ។"

#: configdialog.cpp:64
msgid "Enter the username of your Open-Xchange account here."
msgstr "បញ្ចូល​ឈ្មោះ​អ្នកប្រើ​របស់​គណនី Open-Xchange របស់​អ្នក​នៅ​ទីនេះ ។"

#: configdialog.cpp:65
msgid "Enter the password of your Open-Xchange account here."
msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់​​របស់​គណនី​ Open-Xchange របស់​អ្នក​នៅ​ទីនេះ ។"

