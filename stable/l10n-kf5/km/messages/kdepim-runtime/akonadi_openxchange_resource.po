#. i18n: ectx: whatsthis, entry (Password), group (General)
#: configdialog.ui:121 configdialog.ui:124 openxchangeresource.kcfg:21
#: openxchangeresource.kcfg:22
msgid "The password that is used to log into the Open-Xchange server"
msgstr "ពាក្យ​សម្ងាត់​ដែល​ត្រូវ​បានប្រើ​ ដើម្បី​ចូល​ក្នុង​ម៉ាស៊ីន​បម្រើ Open-Xchange"

#. i18n: ectx: property (text), widget (QPushButton, checkConnectionButton)
#: configdialog.ui:137
msgid "Test Connection..."
msgstr "សាកល្បង​ការ​តភ្ជាប់..."

#: openxchangeresource.cpp:289
msgid "Private Folder"
msgstr "ថត​ឯកជន"

#: openxchangeresource.cpp:297
msgid "Public Folder"
msgstr "ថត​សាធារណៈ"

#: openxchangeresource.cpp:305
msgid "Shared Folder"
msgstr "ថត​រួម"

#: openxchangeresource.cpp:313
msgid "System Folder"
msgstr "ថត​ប្រព័ន្ធ"

#: openxchangeresource.cpp:640
msgid "Unable to connect to server"
msgstr "មិនអាច​តភ្ជាប់​ទៅកាន់ម៉ាស៊ីន​បម្រើបាន​ទេ"

#: openxchangeresource.cpp:827
msgid ""
"The object was edited by another participant in the meantime. Please check."
msgstr "វត្ថុ​ត្រូវ​បានកែសម្រួល​ដោយ​អ្នក​ចូលរួម​ផ្សេង​នៅ​​ពេលនោះ ។ សូម​ពិនិត្យ​មើល ។"

#: openxchangeresource.cpp:828
msgid ""
"Object not found. Maybe it was deleted by another participant in the "
"meantime."
msgstr "រក​មិន​ឃើញ​វត្ថុ ។ ប្រហែល​ជា​វា​ត្រូវបាន​លុប​ដោយ​អ្នក​ចូលរួម​ផ្សេង​នៅ​ពេល​នោះ ។"

#: openxchangeresource.cpp:829
msgid "You don't have the permission to perform this action on this object."
msgstr "អ្នក​មិនមាន​សិទ្ធិ​ ដើម្បី​អនុវត្ត​សកម្មភាព​នេះ​នៅ​លើ​វត្ថុ​នេះ​ទេ ។"

#: openxchangeresource.cpp:830
msgid ""
"A conflict detected. Please check if there are other objects in conflict "
"with this one."
msgstr "រក​ឃើញវត្ថុ​​​​ស្ទួន​គ្នា ។ សូម​ពិនិត្យ​មើល ប្រសិន​បើ​មាន​វត្ថុ​ផ្សេង​ស្ទួន​ជា​មួយ​វត្ថុ​មួយ​នេះ ។"

#: openxchangeresource.cpp:831
msgid ""
"A mandatory data field is missing. Please check. Otherwise contact your "
"administrator."
msgstr "បាត់​វាល​ទិន្នន័យ​ដែល​ចាំបាច់​ ។ សូម​ពិនិត្យ​មើល ។ បើ​មិន​ដូច្នេះ​ទេ ទាក់ទង​អ្នកគ្រប់គ្រង​របស់​អ្នក ។"

#: openxchangeresource.cpp:832
msgid ""
"An appointment conflict detected.\n"
"Please check if there are other appointments in conflict with this one."
msgstr ""
"រក​ឃើញ​ការ​ណាត់​ជួប​ស្ទួន​គ្នា ។\n"
"សូម​ពិនិត្យ​មើល ប្រសិន​បើ​​មាន​ការ​ណាត់​ផ្សេង​ស្ទួន​ជា​មួយ​នឹង​ការ​ណាត់​នេះ ។"

#: openxchangeresource.cpp:833
msgid "Internal server error. Please contact your administrator."
msgstr "កំហុស​ម៉ាស៊ីន​បម្រើ​ខាង​ក្នុង ។ សូម​ទាក់ទង​អ្នក​គ្រប់គ្រង​របស់​អ្នក ។"

#. i18n: ectx: label, entry (BaseUrl), group (General)
#: openxchangeresource.kcfg:10
msgid "Server URL"
msgstr "URL ម៉ាស៊ីន​បម្រើ"

