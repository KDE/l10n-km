msgstr ""
"កំណត់​អាទិភាព​ឲ្យ​ការងារ​ត្រូវ​ធ្វើ​របស់​អ្នក ។ ម៉ឺនុយ​ទម្លាក់ចុះ​នេះ ផ្ដល់​ឲ្យ​អ្នក​នូវ​អាទិភាព ពី​មួយ​ទៅ​ប្រាំ មួយ​គឺ​"
"ខ្ពស់​បំផុត ។ ពី​ដំបូង ការងារ​ត្រូវ​ធ្វើ​គឺ​ត្រូវ​បាន​កំណត់​ទៅ​អាទិភាព​​ប្រាំ (មធ្យម) ។"

#. Tag: title
#: index.docbook:1984
#, no-c-format
msgid "Required Fields"
msgstr "វាល​ដែល​ទាមទារ"

#. Tag: para
#: index.docbook:1986
#, no-c-format
msgid ""
"This is an overview of what fields are required and what fields can be empty "
"when entering events and to-dos:"
msgstr ""
"នេះ​គឺ​ជា​ទិដ្ឋភាព​ទូទៅ​នៃ​វាល​ដែល​ទាមទារ និង​វាល​ដែល​អាច​ទទេ​បាន នៅពេល​ដែល​បញ្ចូល​ព្រឹត្តិការណ៍ និង​ការងារ​"
"ត្រូវ​ធ្វើ ៖"

#. Tag: para
#: index.docbook:1990
#, fuzzy, no-c-format
#| msgid ""
#| "In the <guilabel>General</guilabel> Tab, you should at least fill the "
#| "<guilabel>Title</guilabel> field and the description (the large "
#| "rectangle), even though neither is mandatory. If you check the "
#| "<guilabel>Reminder</guilabel> check box, you should also specify the "
#| "time, and either the sound to be played or the program to be run."
msgid ""
"In the <guilabel>General</guilabel> Tab, you should at least fill the "
"<guilabel>Title</guilabel> field and the description (the large rectangle), "
"even though neither is mandatory. If you set a <guilabel>Reminder</"
"guilabel>, you should also specify the time, and either the sound to be "
"played or the program to be run."
msgstr ""
"នៅ​ក្នុង​ផ្ទាំង <guilabel>ទូទៅ</guilabel> អ្នក​ត្រូវ​បំពេញ​វាល <guilabel>ចំណង​ជើង</guilabel> "
"និង​សេចក្ដី​ពណ៌នា (ចតុកោណ​កែង​ធំ) ទោះ​បី​ជា​មិន​ចាំបាច់​ក៏ដោយ ។ ប្រសិន​បើ​អ្នក​ធីក​ប្រអប់​ធីក <guilabel>អ្នក​"
"រំលឹក</guilabel> អ្នក​ក៏​គួរតែ​បញ្ជាក់​ពេលវេលា និង​សំឡេង​ដែល​ត្រូវ​ចាក់ ឬ​​កម្មវិធី​ដែល​ត្រូវ​រត់​ផង ។"

#. Tag: para
#: index.docbook:1995
#, no-c-format
msgid "The <guilabel>Attendees</guilabel> tab may be left completely empty."
msgstr "ផ្ទាំង <guilabel>អ្នក​ចូលរួម</guilabel> អាច​ទុក​ឲ្យ​ទទេ​​បាន ។"

#. Tag: para
#: index.docbook:1997
#, fuzzy, no-c-format
#| msgid ""
#| "The <guilabel>Recurrence</guilabel> tab must only be filled if you "
#| "checked the <guilabel>Enable Recurrence</guilabel> check box."
msgid ""
"The <guilabel>Recurrence</guilabel> tab must only be filled if you select a "
"daily, weekly, monthly or yearly repeat."
msgstr ""
"ផ្ទាំង <guilabel>ការ​កើតឡើង​ដដែលៗ</guilabel> ត្រូវ​តែ​បំពេញ ប្រសិន​បើ​អ្នក​បាន​ធីក​ប្រអប់​ធីក "
"<guilabel>អនុញ្ញាត​ការ​កើតឡើង​ដដែលៗ</guilabel> ។"

#. Tag: para
#: index.docbook:2000
#, fuzzy, no-c-format
#| msgid ""
#| "The <guilabel>Attachments</guilabel> tab may be left completely empty."
msgid ""
"The <guilabel>Attachments</guilabel> dialog may be left completely empty."
msgstr "ផ្ទាំង <guilabel>ឯកសារ​ភ្ជាប់</guilabel> អាច​ទុក​ឲ្យ​ទទេ​បាន ។"

#. Tag: title
#: index.docbook:2007 index.docbook:2997
#, no-c-format
msgid "Group Scheduling"
msgstr "ការ​កំណត់​ពេលវេលា​ក្រុម"

#. Tag: para
#: index.docbook:2009
#, no-c-format
msgid ""
"The group schedule functionality of &korganizer; allows you to organize "
"appointments, meetings and shared to-do items, request responses from "
"attendees and publish items. If you are being invited to an event or to-do, "
"you can reply to it, stating if you will be able to attend, or send a "
"counter proposal, with different arrangements, like a different time or "
"location. You can also publish your free/busy schedule, to let people know "
"when you are available, and request the same information from others."
msgstr ""
"មុខងារ​កំណត់​ពេលវេលា​ក្រុម​របស់ &korganizer; អនុញ្ញាត​ឲ្យ​អ្នក​រៀបចំ​ការ​ណាត់​ជួប ការ​ប្រជុំ និង​ធាតុ​ការងារ​"
"ត្រូវ​ធ្វើ​ដែល​បាន​ចែក​រំលែក ស្នើ​ចម្លើយតប​ពី​អ្នក​ចូលរួម និង​បោះពុម្ព​ផ្សាយ​ធាតុ ។ ប្រសិន​បើ​អ្នក​​ត្រូវ​បាន​អញ្ជើញ​"
"ឲ្យ​ចូលរួម​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ អ្នក​​អាច​ឆ្លើយតប​ទៅ​វា​ ប្រសិន​បើ​អ្នក​នឹង​ចូលរួម​នឹង​អាច​ចូលរួម ឬ​ផ្ញើ​"
"សំណើ​រាប់ ដែល​មាន​ការ​រៀបចំ​ផ្សេងៗ ដូចជា​ពេលវេលា​ផ្សេងគ្នា ឬ​ទីតាំង​ផ្សេងគ្នា ។ អ្នក​ក៏​អាច​ផ្សាយ​តារាង​"
"ពេលវេលា​ទំនេរ/រវល់​របស់​អ្នក​បានដែរ ដើម្បី​ឲ្យ​មនុស្ស​ដឹង​នៅពេល​ដែលអ្នក​ទំនេរ និង​ស្នើ​ព័ត៌មាន​​ដូចគ្នា​ពី​អ្នក​"
"ដទៃ ។"

#. Tag: para
#: index.docbook:2017
#, fuzzy, no-c-format
#| msgid ""
#| "Currently, &korganizer; schedules events and to-dos using email to "
#| "transport the data, in a standards based scheme, the IMIP-protocol for "
#| "group scheduling. Being a standard, IMIP is a used by many other clients "
#| "too. For example &Microsoft;<application>Outlook</application>, Lotus "
#| "<application>Notes</application> and Novell <application>Evolution</"
#| "application>. This means that you can share events with other users using "
#| "one of these clients. &korganizer; is integrated with &kmail; for "
#| "receiving, processing, and sending events, event responses, updates, "
#| "cancellations, &etc; For instance, when you get an invitation in &kmail;, "
#| "and decide to accept it, by clicking the the <guilabel>accept</guilabel> "
#| "link in the mail body, the event is added to your calendar, and a "
#| "response to the event's organizer is sent automatically."
msgid ""
"Currently, &korganizer; schedules events and to-dos using email to transport "
"the data, in a standards based scheme, the IMIP-protocol for group "
"scheduling. Being a standard, IMIP is a used by many other clients too. For "
"example &Microsoft;<application>Outlook</application>, Lotus "
"<application>Notes</application> and Novell <application>Evolution</"
"application>. This means that you can share events with other users using "
"one of these clients. &korganizer; is integrated with &kmail; for receiving, "
"processing, and sending events, event responses, updates, cancellations, "
"&etc; For instance, when you get an invitation in &kmail;, and decide to "
"accept it, by clicking the <guilabel>accept</guilabel> link in the mail "
"body, the event is added to your calendar, and a response to the event's "
"organizer is sent automatically."
msgstr ""
"បច្ចុប្បន្ន &korganizer; កំណត់​ពេលវេលា​ព្រឹត្តិការណ៍ និង​ការងារ​ត្រូវធ្វើ ដោយប្រើ​អ៊ីមែល​ដើម្បី​បញ្ជូន​"
"ទិន្នន័យ ក្នុង​គ្រោងការណ៍​មូលដ្ឋាន​ស្តង់ដារ ពិធីការ IMIP សម្រាប់​ការ​កំណត់​ពេវេលា​ក្រុម ។ ជា​ស្តង់ដារ "
"IMIP គឺ​ត្រូវ​បាន​ប្រើ​ដោយ​កម្មវិធី​ជាច្រើន​ផងដែរ ។ ឧទាហរណ៍ ម៉ៃក្រូសូហ្វ <application>Outlook</"
"application>, Lotus <application>Notes</application> និង "
"<application>Evolution</application> របស់​ណូវែល ។ មានន័យ​ថា អ្នក​អាច​ចែករំលែក​ព្រឹត្តិការណ៍​"
"ជាមួយ​អ្នក​ប្រើ​ដទៃ​ទៀត ដោយ​ប្រើ​កម្មវិធី​ទាំង​នេះ ។ &korganizer; ត្រូវ​បាន​រួម​បញ្ចូល​ជាមួយ &kmail; "
"សម្រាប់​ការ​ទទួល ដំណើរការ និង​ផ្ញើ​ព្រឹត្តិការណ៍ ចម្លើយ​តប​ព្រឹត្តិការណ៍ ភាពទាន់សម័យ ការបោះបង់​ចោល ។ល។ "
"ឧទាហរណ៍ នៅពេល​ដែល​អ្នក​ទទួល​បាន​ការអញ្ជើញ​នៅ​ក្នុង &kmail; ហើយ​សម្រេច​ព្រមទទួល​វា ដោយ​ចុច​លើ​តំណ "
"<guilabel>ព្រមទទួល</guilabel> នៅ​ក្នុង​តួសារ នោះ​ព្រឹត្តិការណ៍​នឹងត្រូវ​បាន​បន្ថែម​ទៅ​កាន់​ប្រតិទិន​របស់​"
"អ្នក ហើយ​ចម្លើយតប​ទៅកាន់​អ្នក​រៀបចំ​ព្រឹត្តិការណ៍ គឺ​ត្រូវបាន​ផ្ញើ​ដោយ​ស្វ័យ​ប្រវត្តិ ។"

#. Tag: para
#: index.docbook:2035
#, no-c-format
msgid ""
"If you check the <guilabel>Use Groupware Communication</guilabel> box in the "
"<link linkend=\"config-main-groupscheduling\">&korganizer; group scheduling "
"configuration</link>, &korganizer; will handle the group scheduling "
"communication for you. In other words, you will seldom need to use the "
"<guimenu>Schedule</guimenu> menu directly to perform the scheduling actions. "
"For instance, if you <link linkend=\"entering-data-events\">create an event "
"or to-do</link> with attendees, &korganizer; will ask you if you want to "
"send the invitations to the attendees, so you will not need to use the "
"<menuchoice> <guimenu>Schedule</guimenu><guimenuitem>Send Invitation to "
"Attendees</guimenuitem> </menuchoice> menu item later. Also, if you change "
"your status as an attendee for an event you were invited to, it will ask you "
"if you want to send your updated status to the event's organizer, so you "
"will not need to use the <menuchoice> <guimenu>Schedule</"
"guimenu><guimenuitem>Send Status Update</guimenuitem> </menuchoice> menu "
"item later."
msgstr ""
"ប្រសិន​បើ​អ្នក​ធីក​ប្រអប់ <guilabel>ប្រើ​ទំនាក់​ទំនង Groupware</guilabel> ក្នុង <link linkend="
"\"config-main-groupscheduling\">ការ​កំណត់​រចនា​សម្ព័ន្ធ​កំណត់​ពេលវេលា​ក្រុម​របស់ &korganizer;"
"</link> នោះ &korganizer; នឹង​ដោះស្រាយ​ទំនាក់ទំនង​ការ​កំណត់​ពេលវេលា​ក្រុម​សម្រាប់​អ្នក ។ ម្យ៉ាងទៀត "
"អ្នក​នឹង​កម្រ​ប្រើ​ម៉ឺនុយ <guimenu>តារាង​ពេលវេលា</guimenu> ដោយផ្ទាល់​ណាស់​ដើម្បីធ្វើ​សកម្មភាព​កំណត់​"
"ពេលវេលា ។ ឧទាហរណ៍ ប្រសិន​បើ​អ្នក <link linkend=\"entering-data-events\">បង្កើត​"
"ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ</link>​ជាមួយ​អ្នក​ចូល​រួម នោះ &korganizer; នឹង​សួរអ្នក ថាតើ​អ្នក​ចង់​"
"ផ្ញើ​ការ​អញ្ជើញ​ដល់​អ្នក​ចូល​រួម ឬ​អត់ ដូច្នេះ​អ្នក​នឹង​មិនត្រូវ​ការ​ប្រើ​ធាតុ​ម៉ឺនុយ <menuchoice> "
"<guimenu>កាលវិភាគ</guimenu><guimenuitem>ផ្ញើ​លិខិត​អញ្ជើញ​ទៅ​អ្នក​ចូល​រួម</guimenuitem> </"
"menuchoice> នៅពេល​ក្រោយ​ទៀត​ទេ ។ ប្រសិន​បើ​អ្នក​ផ្លាស់ប្ដូរ​ស្ថានភាព​របស់​អ្នក​ជា​អ្នក​ចូល​រួម​សម្រាប់​"
"ព្រឹត្តិការណ៍ដែល​អ្នក​ត្រូវបាន​អញ្ជើញ​នោះ វា​នឹង​សួរអ្នក ថាតើ​អ្នក​ចង់​ផ្ញើ​ស្ថានភាព​ដែល​បាន​ធ្វើ​ឲ្យ​ទាន់សម័យ​ទៅ​"
"អ្នក​រៀបចំ​ព្រឹត្តិការណ៍ ឬ​អត់ ដូច្នេះ​អ្នក​នឹង​មិន​ត្រូវ​ការ​ប្រើ​ធាតុ​ម៉ឺនុយ <menuchoice> "
"<guimenu>កាលវិភាគ</guimenu><guimenuitem>ផ្ញើ​ភាព​ទាន់សម័យ​នៃ​ស្ថានភាព</guimenuitem> </"
"menuchoice> នៅ​ពេល​ក្រោយ​ទៀត​ទេ ។"

#. Tag: title
#: index.docbook:2053
#, no-c-format
msgid "Publishing an Event, To-do or Journal Entry"
msgstr "ការ​បោះពុម្ព​ផ្សាយ​ព្រឹត្តិការណ៍ ការងារ​ត្រូវ​ធ្វើ ឬ​ធាតុ​ទិនានុប្បវត្តិ"

#. Tag: para
#: index.docbook:2055
#, no-c-format
msgid ""
"If you simply want to send an event, to-do or journal entry, choose the "
"<menuchoice><guimenu>Schedule</guimenu><guimenuitem>Publish Item "
"Information...</guimenuitem></menuchoice> menu item, when the item is "
"selected. Then a dialog appears, asking you the email addresses which will "
"receive the event or to-do. The item will be sent by email, in the iCalendar "
"format."
msgstr ""
"ប្រសិន​បើ​អ្នក​ចង់​ផ្ញើ​ព្រឹត្តិការណ៍ ការងារ​ត្រូវ​ធ្វើ ឬ​ធាតុ​ទិនានុប្បវត្តិ សូម​ជ្រើស​ធាតុ​ម៉ឺនុយ "
"<menuchoice><guimenu>កាលវិភាគ</guimenu><guimenuitem>បោះពុម្ព​ផ្សាយ​ព័ត៌មាន​អំពី​ធាតុ...</"
"guimenuitem></menuchoice> នៅពេល​ដែល​ធាតុ​ត្រូវ​បាន​ជ្រើស ។ បន្ទាប់​មក ប្រអប់​នឹង​លេចឡើង ដោយ​សួរ "
"អាសយដ្ឋាន​អ៊ីមែល ដែល​នឹង​ត្រូវ​ទទួល​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ ។ ធាតុ​នឹង​ត្រូវ​បាន​ផ្ញើ​ដោយ​អ៊ីមែល ជា​"
"ទ្រង់ទ្រាយ iCalendar ។"

#. Tag: para
#: index.docbook:2062
#, no-c-format
msgid ""
"Please note that you can use this action to email any item to anyone, not "
"just to the item's attendees. In fact, you can publish an item with no "
"attendees at all, as publishing does not request an answer from the "
"attendees."
msgstr ""
"សូម​ចំណាំថា អ្នក​អាច​ប្រើ​​អំពើ​នេះ ដើម្បី​ផ្ញើ​អ៊ីមែល​ធាតុ​ណាមួយ​ទៅ​កាន់​នរណា​ម្នាក់ មិនមែន​ផ្ញើ​ទៅ​តែ​អ្នក​ចូល​រួម​"
"របស់​ធាតុ​តែ​ប៉ុណ្ណោះ​ទេ ។ តាម​ការ​ពិត អ្នក​អាច​បោះពុម្ព​ផ្សាយ​ធាតុ​មួយ​ដោយ​គ្មាន​អ្នក​ចូល​រួម​អ្វី​ទាំងអស់ ព្រោះ​ការ​"
"បោះពុម្ពផ្សាយ​មិន​ស្នើ​ចម្លើយ​តប​ពី​អ្នក​ចូល​រួម​ឡើយ ។"

#. Tag: para
#: index.docbook:2067
#, no-c-format
msgid ""
"An example: you are playing in a band and, from time to time, you give live "
"concerts. To notify your fans about the concerts, you maintain a mailing "
"list. If you use &korganizer; to organize your concert dates, you can just "
"choose the <menuchoice><guimenu>Schedule</guimenu> <guimenuitem>Publish Item "
"Information...</guimenuitem></menuchoice> menu item, put in the address of "
"the mailing list and the event gets sent. Mailing list subscribers who use "
"&korganizer; get the concert date automatically inserted in their calendar."
msgstr ""
"ឧទាហរណ៍ ៖ អ្នក​សម្តែង​ក្នុង​​ក្រុម​ភ្លេង​ ហើយ​​យូរៗទៅ​អ្នករស់​នៅ​ក្នុងការប្រជុំដន្ត្រី ។ ដើម្បីជូន​ដំណឹង​"
"ដល់អ្នកគាំទ្រ​ អ្នកត្រូវ​តែ​រក្សាទុកបញ្ជី​សំបុត្រ ។ បើ​អ្នក​ប្រើ​ Korganizer ដើម្បី​របៀប​ចំ​កាលបរិច្ឆេទ​"
"ការប្រជុំដន្ត្រី​របស់​អ្នក​ អ្នកគ្រាន់​តែ​​ជ្រើស​ធាតុ​ម៉ឺនុយ​ <menuchoice><guimenu>កាលវិភាគ​</guimenu> "
"<guimenuitem>បោះពុម្ពផ្សាយ​ព័ត៌មាន​អំពី​ធាតុ​...</guimenuitem></menuchoice> ដាក់​ក្នុ​"
"ងអាសយដ្ឋាន​នៃ​បញ្ចី​សំបុត្រ​\n"
"និង​ព្រឹត្តិការណ៍​ដែល​បានផ្ញើ ។ បញ្ជី​សំបុត្រ​​អ្នកជាវ​ដែល​ប្រើ​ Korganizer ដើម្បីទទួល​បាន​កាលបរិច្ឆេទ​​"
"ការប្រគុំដន្ត្រី​​ដែលបាន​បញ្ចូល​ក្នុង​ប្រតិទិន​របស់ពួកគេ​ដោយ​ស្វ័យប្រវត្តិ ។"

#. Tag: para
#: index.docbook:2078
#, no-c-format
msgid ""
"Publishing an event as described above will only inform the receiver about "
"the event, but not give her the option to ask for attendance. Use "
"<menuchoice><guimenu>Schedule</guimenu><guimenuitem>Send as iCalendar...</"
"guimenuitem></menuchoice> if you want to provide that option instead."
msgstr ""

#. Tag: title
#: index.docbook:2088
#, no-c-format
msgid "Acting as Organizer in Group Scheduling"
msgstr "ដើរតួ​ជា​អ្នក​រៀបចំ​ក្នុង​ការ​កំណត់​ពេលវេលា​ក្រុម"

#. Tag: para
#: index.docbook:2090
#, fuzzy, no-c-format
#| msgid ""
#| "When you create <link linkend=\"entering-data-events\">an event</link> or "
#| "<link linkend=\"entering-data-to-do\">a to-do</link>, and <link linkend="
#| "\"entering-data-events-attendees\">add attendees to it</link>, you are "
#| "acting as the event organizer. To add attendees, use the <link linkend="
#| "\"entering-data-events-attendees\"> attendee tab</link>, in the "
#| "<guilabel>Edit Event</guilabel>, or <guilabel>Edit To-do</guilabel> "
#| "dialog. In the <link linkend=\"agenda-view\">agenda view</link>, a little "
#| "icon <inlinemediaobject> <imageobject> <imagedata fileref=\"organizer.png"
#| "\" format=\"PNG\"/> </imageobject> <textobject> <phrase>Organizer Icon</"
#| "phrase> </textobject> </inlinemediaobject> is placed in the event, if you "
#| "are the organizer of a group scheduling event."
msgid ""
"When you create <link linkend=\"entering-data-events\">an event</link> or "
"<link linkend=\"entering-data-to-do\">a to-do</link>, and <link linkend="
"\"entering-data-events-attendees\">add attendees to it</link>, you are "
"acting as the event organizer. To add attendees, use the <link linkend="
"\"entering-data-events-attendees\"> attendee tab</link>, in the "
"<guilabel>Edit Event</guilabel>, or <guilabel>Edit To-do</guilabel> dialog. "
"In the <link linkend=\"agenda-view\">Agenda view</link>, a little icon "
"<inlinemediaobject> <imageobject> <imagedata fileref=\"organizer.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>Organizer Icon</phrase> "
"</textobject> </inlinemediaobject> is placed in the event, if you are the "
"organizer of a group scheduling event."
msgstr ""
"នៅពេល​ដែល​អ្នក​បង្កើត <link linkend=\"entering-data-events\">ព្រឹត្តិការណ៍​មួយ</link> ឬ​"
"<link linkend=\"entering-data-to-do\">ការងារ​ត្រូវ​ធ្វើ</link> និង​<link linkend="
"\"entering-data-events-attendees\">បន្ថែម​អ្នក​ចូលរួម​ទៅ​កាន់​វា</link> អ្នក​កំពុង​ដើរ​តួជា​អ្នក​"
"រៀបចំ​ព្រឹត្តិការណ៍ ។ ដើម្បី​បន្ថែម​អ្នក​ចូល​រួម ត្រូវ​ប្រើ​ប្រអប់ <link linkend=\"entering-data-"
"events-attendees\">ផ្ទាំង​អ្នក​ចូល​រួម</link> នៅ​ក្នុង <guilabel>កែសម្រួល​ព្រឹត្តិការណ៍</"
"guilabel> ឬ<guilabel>កែសម្រួល​ការងារ​ត្រូវ​ធ្វើ</guilabel> ។ ក្នុង​<link linkend="
"\"agenda-view\">ទិដ្ឋភាព​របៀប​វារៈ</link> រូបតំណាង​តូច <inlinemediaobject> "
"<imageobject> <imagedata fileref=\"organizer.png\" format=\"PNG\"/> </"
"imageobject> <textobject> <phrase>រូបតំណាង​អ្នក​រៀបចំ</phrase> </textobject> </"
"inlinemediaobject> គឺ​ស្ថិត​នៅ​ក្នុង​ព្រឹត្តិការណ៍ ប្រសិន​បើ​អ្នក​ជា​អ្នក​រៀបចំ​ព្រឹត្តិការណ៍​ការកំណត់​ពេលវេលា​"
"ក្រុម ។"

#. Tag: para
#: index.docbook:2109
#, no-c-format
msgid ""
"The organizer is responsible for sending the invitations, collecting the "
"attendees responses, and for keeping the data of the event or to-do up to "
"date for all people involved."
msgstr ""
"អ្នក​រៀបចំ ទទួល​ខុស​ត្រូវ​ចំពោះ​ការ​ផ្ញើ​លិខិត​អញ្ជើញ ប្រមូល​ចម្លើយ​តប​អ្នក​ចូល​រួម និង​រក្សាទុក​ទិន្នន័យ​នៃ​"
"ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ​ឲ្យ​ទាន់សម័យ​សម្រាប់​មនុស្ស​ទាំងអស់​ដែល​ទាក់ទង ។"

#. Tag: title
#: index.docbook:2114
#, no-c-format
msgid "Sending Invitations and Processing Responses"
msgstr "ការ​ផ្ញើ​លិខិត​អញ្ជើញ និង​ចម្លើយ​តប​ចូល​ដំណើរការ"

#. Tag: para
#: index.docbook:2116
#, fuzzy, no-c-format
#| msgid ""
#| "To organize an event or to-do, <link linkend=\"entering-data-events"
#| "\">create it</link> in &korganizer; and add all people that should attend "
#| "using the attendees tab. &korganizer; can send invitations to the "
#| "attendees, either automatically (depending on <link linkend=\"config-main-"
#| "groupscheduling\">&korganizer; group scheduling configuration</link>), or "
#| "by selecting the event or to-do and choosing the "
#| "<menuchoice><guimenu>Schedule</guimenu><guimenuitem>Send Invitation to "
#| "Attendees</guimenuitem></menuchoice> menu item. The attendees get an "
#| "email containing all the relevant information for the event or to-do. "
#| "They can respond to the meeting proposal by accepting or rejecting it or "
#| "by making a counter proposal. All this information is sent to you by "
#| "email again and, if you have configured &kmail; appropriately, the "
#| "attendees responses are automatically inserted in your calendar."
msgid ""
"To organize an event or to-do, <link linkend=\"entering-data-events\">create "
"it</link> in &korganizer; and add all the people that should attend using "
"the attendees tab. &korganizer; can send invitations to the attendees, "
"either automatically (depending on <link linkend=\"config-main-"
"groupscheduling\">&korganizer; group scheduling configuration</link>), or by "
"selecting the event or to-do and choosing the <menuchoice><guimenu>Schedule</"
"guimenu><guimenuitem>Send Invitation to Attendees</guimenuitem></menuchoice> "
"menu item. The attendees get an email containing all the relevant "
"information for the event or to-do. They can respond to the meeting proposal "
"by accepting or rejecting it or by making a counter proposal. They can also "
"delegate or forward the invitation. All this information is sent to you by "
"email again and, if you have configured &kmail; appropriately, the attendees "
"responses are automatically inserted in your calendar. If there are "
"additional attendees willing to participate (e.g. by accepting a forwarded "
"invitation) you will be asked to accept the new attendees."
msgstr ""
"ដើម្បី​រៀបចំ​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ គឺត្រូវ<link linkend=\"entering-data-events"
"\">បង្កើត​វា</link> នៅ​ក្នុង &korganizer; ហើយ​បន្ថែម​មនុស្ស​ទាំងអស់​ដែល​គួរ​ចូលរួម​ដោយប្រើ​ផ្ទាំង​អ្នក​"
"ចូល​រួម ។ &korganizer; អាច​ផ្ញើ​លិខិត​អញ្ជើញ​ទៅ​អ្នក​ចូល​រួម ដោយ​ស្វ័យ​ប្រវត្តិ (អាស្រ័យ​លើ <link "
"linkend=\"config-main-groupscheduling\">ការកំណត់​រចនា​សម្ព័ន្ធ​កំណត់​ពេលវេលាក្រុម​របស់ "
"&korganizer;</link>) ឬ​ដោយ​ជ្រើស​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវធ្វើ និង​ជ្រើស​ធាតុ​ម៉ឺនុយ "
"<menuchoice><guimenu>កាលវិភាគ</guimenu><guimenuitem>ផ្ញើ​លិខិត​អញ្ជើញ​ទៅ​អ្នក​ចូល​រួម</"
"guimenuitem></menuchoice> ។ អ្នក​ចូលរួម​ទទួល​អ៊ីមែល​ដែល​មាន​ព័ត៌មាន​ទាក់ទង​ទាំងអស់​សម្រាប់​ព្រឹត្តិការណ៍ "
"ឬ​ការងារ​ត្រូវ​ធ្វើ ។ ពួកគេ​អាច​ឆ្លើយតប​ទៅកាន់​សំណើ​ប្រជុំ ដោយ​យល់ព្រម​ទទួល ឬ​បដិសេធ ឬ​ដោយ​បង្កើត​សំណើ​"
"រាប់ ។ ព័ត៌មាន​ទាំងអស់​នេះ​គឺ​ត្រូវ​បាន​ផ្ញើ​ទៅ​ឲ្យ​អ្នក​តាមរយៈ​អ៊ីមែល ហើយ​ប្រសិន​បើ​អ្នក​​បាន​កំណត់​រចនា​សម្ព័ន្ធ "
"&kmail; ត្រឹមត្រូវ នោះ​ចម្លើយតប​អ្នក​ចូល​រួម​នឹង​ត្រូវ​បាន​បញ្ចូល​ទៅ​ក្នុង​ប្រតិទិន​ដោយ​ស្វ័យ​ប្រវត្តិ ។"

#. Tag: title
#: index.docbook:2138
#, no-c-format
msgid "Cancelling an Event or To-do"
msgstr "ការ​លុប​ចោល​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ​​"

#. Tag: para
#: index.docbook:2140
#, no-c-format
msgid ""
"To cancel an event or to-do you have to be the organizer. If you checked the "
"<guilabel>Use Groupware Communication</guilabel> box in the <link linkend="
"\"config-main-groupscheduling\">&korganizer; group scheduling configuration</"
"link>, just delete the item, and &korganizer; will ask you to send the "
"cancellation. If not, simply select the item, and choose the "
"<menuchoice><guimenu>Schedule</guimenu> <guimenuitem>Send Cancellation to "
"Attendees</guimenuitem></menuchoice> menu item."
msgstr ""
"ដើម្បី​លុបព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ​ចោល​ អ្នក​ត្រូវ​តែ​ជា​​អ្នក​រៀបចំ ។ ប្រសិន​បើ​អ្នក​បាន​ធីក​ប្រអប់ "
"<guilabel>ប្រើ​ទំនាក់​ទំនង Groupware</guilabel> នៅក្នុង <link linkend=\"config-main-"
"groupscheduling\">ការកំណត់​រចនា​សម្ព័ន្ធ​កំណត់​ពេលវេលា​ក្រុម &korganizer;</link> គឺ​គ្រាន់តែ​លុប​"
"ធាតុ ហើយ &korganizer; នឹង​ស្នើ​ឲ្យ​អ្នក​ផ្ញើ​ការ​លុបចោល ។ បើ​មិន​ដូច្នោះ​ទេ គឺគ្រាន់​តែ​ជ្រើស​ធាតុ ហើយ​"
"ជ្រើស​ធាតុ​ម៉ឺនុយ <menuchoice><guimenu>កាលវិភាគ</guimenu> <guimenuitem>ផ្ញើ​ការ​លុប​ចោល​ទៅ​"
"អ្នក​ចូល​រួម</guimenuitem></menuchoice> ។"

#. Tag: para
#: index.docbook:2149
#, no-c-format
msgid ""
"This action will send a cancel-message to all attendees, so they can remove "
"the item from their calendars too."
msgstr ""
"អំពើ​នេះ នឹង​ផ្ញើ​សារ​លុប​ចោល​ទៅ​កាន់​អ្នក​ចូល​រួម​ទាំងអស់ ដូច្នេះ​ពួក​គេ​ក៏​អាច​យក​ធាតុ​ចេញ​ពី​ប្រតិទិន​របស់​គេ​បាន​ផង​"
"ដែរ ។"

#. Tag: title
#: index.docbook:2156
#, no-c-format
msgid "Acting as the Attendee"
msgstr "ដើរតួ​ជា​អ្នក​ចូល​រួម"

#. Tag: para
#: index.docbook:2158
#, fuzzy, no-c-format
#| msgid ""
#| "When you get an email with an invitation and accept it, the event or to-"
#| "do is added to your calendar. If it is an event, a little icon "
#| "<inlinemediaobject> <imageobject> <imagedata fileref=\"groupevent.png\" "
#| "format=\"PNG\"/> </imageobject> <textobject> <phrase>Attendee Icon</"
#| "phrase> </textobject> </inlinemediaobject> is placed in the event in the "
#| "<link linkend=\"agenda-view\">agenda view</link>."
msgid ""
"When you get an email with an invitation and accept it, the event or to-do "
"is added to your calendar. If it is an event, a little icon "
"<inlinemediaobject> <imageobject> <imagedata fileref=\"groupevent.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>Attendee Icon</phrase> "
"</textobject> </inlinemediaobject> is placed in the event in the <link "
"linkend=\"agenda-view\">Agenda view</link>."
msgstr ""
"នៅពេល​ដែល​អ្នក​ទទួល​អ៊ីមែល​ដែល​មាន​ការអញ្ជើញ ហើយ​អ្នក​ព្រមទទួល​វា នោះ​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ​ត្រូវ​"
"បាន​បន្ថែម​ទៅកាន់​ប្រតិទិន​របស់​អ្នក ។ ប្រសិន​បើ​វា​ជា​ព្រឹត្តិ​ជា​ព្រឹត្តិការណ៍ រូបតំណាង​តូច "
"<inlinemediaobject> <imageobject> <imagedata fileref=\"groupevent.png\" "
"format=\"PNG\"/> </imageobject> <textobject> <phrase>រូបតំណាង​អ្នក​ចូល​រួម</phrase> "
"</textobject> </inlinemediaobject> គឺ​ស្ថិត​នៅ​ក្នុង​ព្រឹត្តិការណ៍​ក្នុង <link linkend="
"\"agenda-view\">ទិដ្ឋភាព​របៀប​វារៈ</link> ។"

#. Tag: title
#: index.docbook:2172
#, no-c-format
msgid "Answering an Invitation"
msgstr "ការ​ឆ្លើយតប​ការ​អញ្ជើញ"

#. Tag: para
#: index.docbook:2174
#, fuzzy, no-c-format
#| msgid ""
#| "If you have an invitation in your &kmail; inbox you can either press "
#| "<guibutton>Reject</guibutton> to ignore the request, or press "
#| "<guibutton>Accept</guibutton> or <guibutton>Accept Cond.</guibutton>. The "
#| "last two actions will insert the item to your calendar. In any case, "
#| "&kmail; will send your response to the organizer automatically."
msgid ""
"If you have an invitation in your &kmail; inbox you can either press "
"<guibutton>Reject</guibutton> to ignore the request, or press "
"<guibutton>Accept</guibutton> or <guibutton>Accept Cond.</guibutton>. The "
"last two actions will insert the item into your calendar. In any case, "
"&kmail; will send your response to the organizer automatically."
msgstr ""
"ប្រសិន​បើ​អ្នក​មាន​លិខិត​អញ្ជើញ​នៅក្នុង​ប្រអប់​ទទួល​រប់ស &kmail; របស់​អ្នក នោះ​អ្នកអាចសង្កត់ "
"<guibutton>បដិសេធ</guibutton> ដើម្បី​មិនអើពើ​សំណើ ឬ​សង្កត់ <guibutton>ព្រមទទួល</"
"guibutton> ឬ <guibutton>យល់ព្រម​នឹង​លក្ខខណ្ឌ</guibutton> ។ អំពើ​ពីរ​ចុងក្រោយ នឹង​បញ្ចូល​ធាតុ​"
"ទៅកាន់​ប្រតិទិន​របស់​អ្នក ។ ក្នុង​ករណី​ណាមួយ &kmail; នឹង​ផ្ញើ​ចម្លើយតប​របស់​អ្នក​ទៅកាន់​អ្នក​រៀប​ចំ​ដោយ​ស្វ័យ​"
"ប្រវត្តិ ។"

#. Tag: para
#: index.docbook:2180
#, no-c-format
msgid ""
"You can also <guibutton>Delegate</guibutton> or <guibutton>Forward</"
"guibutton> the invitation. When delegating, you can suggest another person "
"as your proxy. Using <guibutton>Forward</guibutton> you can forward the "
"invitation to one or more people not yet invited. When the receiver of the "
"delegation or forward accepts the invitation, the organizer will be asked to "
"approve the new attendee."
msgstr ""

#. Tag: para
#: index.docbook:2187
#, no-c-format
msgid ""
"If for any reason you changed your mind, edit your status in the item's "
"<link linkend=\"entering-data-events-attendees\">attendee tab</link>. If you "
"checked the <guilabel>Use Groupware Communication</guilabel> box in the "
"<link linkend=\"config-main-groupscheduling\">&korganizer; group scheduling "
"configuration</link>, &korganizer; will ask you to send an email updating "
"your attendee status. If not, choose the <menuchoice> <guimenu>Schedule</"
"guimenu><guimenuitem>Send Status Update</guimenuitem> </menuchoice> menu "
"item to send your status update."
msgstr ""
"ប្រសិន​បើ​អ្នក​ប្ដូរ​ចិត្ត​​ដោយ​ហេតុផល​ណាមួយ​នោះ គឺ​ត្រូវ​កែសម្រួល​ស្ថានភាព​របស់​អ្នក​នៅក្នុង​<link linkend="
"\"entering-data-events-attendees\">ផ្ទាំង​អ្នក​ចូល​រួម</link>​របស់​ធាតុ ។ ប្រសិន​បើ​អ្នក​បាន​"
"ធីកប្រអប់ <guilabel>ទំនាក់​ទំនង Groupware</guilabel> នៅក្នុង <link linkend=\"config-"
"main-groupscheduling\">ការកំណត់​រចនាសម្ព័ន្ធ​កំណត់​ពេលវេលា​ក្រុម​របស់ &korganizer;</link> "
"នោះ &korganizer; នឹង​ស្នើ​ឲ្យ​អ្នកផ្ញើ​អ៊ីមែល​ ដើម្បី​ធ្វើ​ឲ្យ​ស្ថានភាព​អ្នក​ចូល​រួម​ទាន់សម័យ ។ ប្រសិន​បើ​មិន​"
"ដូច្នោះ​ទេ ជ្រើស​ធាតុ​ម៉ឺនុយ <menuchoice> <guimenu>កាលវិភាគ</guimenu><guimenuitem>ផ្ញើ​ភាព​"
"ទាន់សម័យ​នៃ​ស្ថានភាព</guimenuitem> </menuchoice> ដើម្បី​ផ្ញើ​ភាព​ទាន់សម័យ​នៃ​ស្ថានភាព​របស់​អ្នក ។"

#. Tag: title
#: index.docbook:2199
#, no-c-format
msgid "Sending an Alternative Proposal"
msgstr "ការ​ផ្ញើ​សំណើ​ជំនួស​"

#. Tag: para
#: index.docbook:2202
#, no-c-format
msgid ""
"If you are not satisfied with some of the characteristics of the event or to-"
"do you got invited to, and want to send a counter proposal to the organizer "
"(for instance an alternative location or time), just edit the item and send "
"it back as your proposal, by selecting the item and choosing the "
"<menuchoice> <guimenu>Schedule</guimenu><guimenuitem>Request Change</"
"guimenuitem> </menuchoice> menu item."
msgstr ""
"ប្រសិន​បើ​អ្នក​មិនពេញចិត្ត​នឹង​លក្ខណៈ​មួយ​ចំនួន​របស់​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ​ដែល​​អ្នក​ត្រូវ​បាន​អញ្ជើញ​ឲ្យ​ចូល​រួម​"
"នោះ ហើយ​ចង់​ផ្ញើ​សំណើ​រាប់​ទៅ​កាន់​អ្នក​រៀបចំ (ឧទាហរណ៍ ទីតាំង ឬ​ពេលវេលា​ជំនួស) គឺ​គ្រាន់តែ​កែសម្រួល​ធាតុ និង​"
"ផ្ញើ​វា​ត្រឡប់​ជា​សំណើ​របស់​អ្នក ដោយ​ជ្រើស​ធាតុ ហើយ​ជ្រើស​ធាតុ​ម៉ឺនុយ <menuchoice> <guimenu>កាលវិភាគ</"
"guimenu><guimenuitem>ស្នើសុំ​ភាព​ផ្លាស់ប្ដូរ</guimenuitem> </menuchoice> ។"

#. Tag: para
#: index.docbook:2209
#, no-c-format
msgid ""
"The organizer of the event will get your proposal by email, and will be able "
"to accept it or decline."
msgstr "អ្នក​រៀបចំ នឹង​ទទួល​បាន​សំណើ​របស់​អ្នក​តាមរយៈ​អ៊ីមែល ហើយ​និង​អាច​ទទួល​យក​វា ឬ​ក៏​បដិសេធ ។"

#. Tag: title
#: index.docbook:2215
#, no-c-format
msgid "Requesting the Latest Version of an Event or To-do"
msgstr "ការ​ស្នើ​កំណែ​ចុងក្រោយ​បំផុត​របស់​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ"

#. Tag: para
#: index.docbook:2217
#, no-c-format
msgid ""
"To request the latest version of an event or to-do, select the item, and "
"choose the <menuchoice><guimenu>Schedule</guimenu> <guimenuitem>Request "
"Update</guimenuitem></menuchoice> menu item. The organizer should then send "
"you back the latest version of the item."
msgstr ""
"ដើម្បី​ស្នើសុំ​កំណែ​ចុងក្រោយ​បំផុត​​របស់​ព្រឹត្តិការណ៍ ​ឬ​ការងារ​ត្រូវ​ធ្វើ គឺ​ត្រូវ​ជ្រើស​ធាតុ ហើយ​ជ្រើស​យក​ធាតុ​ម៉ឺនុយ "
"<menuchoice><guimenu>កាលវិភាគ</guimenu> <guimenuitem>ស្នើសុំ​ភាព​ទាន់សម័យ</"
"guimenuitem></menuchoice> ។ បន្ទាប់មក​អ្នក​រៀបចំ​​នឹង​ផ្ញើ​កំណែ​ចុងក្រោយ​បំផុត​របស់​ធាតុ​ត្រឡប់​ទៅ​ឲ្យ​អ្នក​"
"វិញ ។"

#. Tag: title
#: index.docbook:2226
#, no-c-format
msgid "Free Busy information"
msgstr "ព័ត៌មាន​ទំនេរ រវល់"

#. Tag: para
#: index.docbook:2228 index.docbook:3086
#, no-c-format
msgid ""
"The free/busy information represents an availability schedule. By presenting "
"the intervals when one already has previous commitments, others can avoid "
"arranging appointments for these periods. Note that only the times are "
"published, not the events, reasons or attendees."
msgstr ""
"ព័ត៌មាន​ទំនេរ​/​រវល់​គឺ​តំណាង​ឲ្យ​តារាង​ពេលវេលា​ដែល​មាន ។ ដោយ​បង្ហាញ​ចន្លោះពេល​នៅពេល​ដែល​មាន​ការ​សន្យា​ពី​"
"មុន​រួចហើយ ចន្លោះ​ពេល​ផ្សេងទៀត​អាច​ជៀសវាង​ការ​រៀបចំ​ការ​ណាត់​ជួប​សម្រប់​កំឡុង​ពេល​ទាំងនេះ ។ ចំណាំ​ថា​មាន​តែ​"
"ពេលវេលា​ប៉ុណ្ណោះ​ដែល​ត្រូវ​បាន​បោះពុម្ព​ផ្សាយ មិនមែន​ព្រឹត្តិការណ៍ ហេតុផល ឬ​អ្នក​ចូលរួម​ឡើយ ។"

#. Tag: para
#: index.docbook:2233 index.docbook:3091
#, no-c-format
msgid ""
"&korganizer; supports publishing and retrieving free/busy information, "
"either manually or automatically."
msgstr ""
"&korganizer; គាំទ្រ​ការ​បោះពុម្ព​ផ្សាយ និង​ប្រមូលយក​ព័ត៌មាន​​ទំនេរ​/​រវល់​ដោយដៃ ឬ​ដោយ​ស្វ័យ​ប្រវត្តិ ។"

#. Tag: para
#: index.docbook:2236
#, fuzzy, no-c-format
#| msgid ""
#| "To email your free/busy information, choose the <guimenu>Schedule</"
#| "guimenu> <guimenuitem>Mail Free Busy Information...</guimenuitem> menu "
#| "item. Enter the email addresses you want to send the information to in "
#| "the dialog and press <guilabel>OK</guilabel>."
msgid ""
"To email your free/busy information, choose the "
"<menuchoice><guimenu>Schedule</guimenu> <guimenuitem>Mail Free Busy "
"Information...</guimenuitem></menuchoice> menu item. Enter the email "
"addresses you want to send the information to in the dialog and press "
"<guilabel>OK</guilabel>."
msgstr ""
"ដើម្បី​ផ្ញើ​អ៊ីមែល​ព័ត៌មាន​ទំនេរ​/​រវល់​របស់​អ្នក គឺ​ត្រូវ​ជ្រើស​ធាតុ​ម៉ឺនុយ <guimenu>កាលវិភាគ</guimenu> "
"<guimenuitem>អ៊ីមែល​ព័ត៌មាន​ទំនេរ​/​រវល់...</guimenuitem> ។ បញ្ចូល​អាសយដ្ឋាន​អ៊ីមែល​ដែល​អ្នក​ចង់​ផ្ញើ​"
"ព័ត៌មាន​ទៅ​ក្នុង​ប្រអប់ ហើយ​សង្កត់ <guilabel>យល់ព្រម</guilabel> ។"

#. Tag: para
#: index.docbook:2241
#, fuzzy, no-c-format
#| msgid ""
#| "Groupware servers usually have a standard location for uploading your "
#| "free busy information, so that other users can access your data, and you "
#| "can access other user's free busy schedule. You can configure "
#| "&korganizer; to upload and download free busy information automatically, "
#| "using the <link linkend=\"config-main-views\">Free Busy preferences</"
#| "link>, in the &korganizer; <guilabel>Configure</guilabel> dialog."
msgid ""
"Groupware servers usually have a standard location for uploading your free "
"busy information, so that other users can access your data, and you can "
"access other user's free busy schedule. You can configure &korganizer; to "
"upload and download free busy information automatically, using the <link "
"linkend=\"config-main-free-busy\">Free Busy preferences</link>, in the "
"&korganizer; <guilabel>Configure</guilabel> dialog."
msgstr ""
"ម៉ាស៊ីន​បម្រើ Groupware ជាទូទៅ​មាន​ទីតាំង​ស្តង់ដារ​សម្រាប់​ផ្ទុកឡើង​នូវ​ព័ត៌មាន​ទំនេរ​/​រវល់​របស់​អ្នក ដូច្នេះ​"
"អ្នក​ប្រើ​ផ្សេងទៀត​អាច​ចូល​ដំណើរការ​ទិន្នន័យ​របស់​អ្នក ហើយ​អ្នក​អាច​ចូល​ដំណើរការ​កាលវិភាគ​ទំនេរ​/​រវល់​របស់​អ្នក​"
"ប្រើ​ផ្សេង​ទៀត​បាន​ដែរ ។ អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ &korganizer; ដើម្បី​ផ្ទុក​ឡើង និង​ទាញយក​ព័ត៌មាន​"
"ទំនេរ​/​រវល់​ដោយ​ស្វ័យ​ប្រវត្តិ ដោយ​ប្រើ <link linkend=\"config-main-views\">ចំណង់​ចំណូលចិត្ត​ទំនេរ​/​"
"រវល់</link> នៅ​ក្នុង​ប្រអប់ <guilabel>កំណត់​រចនា​សម្ព័ន្ធ</guilabel> របស់ &korganizer; ។"

#. Tag: para
#: index.docbook:2248
#, no-c-format
msgid ""
"To upload your free/busy information to the server set in &korganizer; "
"preferences, choose the <menuchoice><guimenu>Schedule</guimenu> "
"<guimenuitem>Upload Free Busy Information</guimenuitem></menuchoice> menu "
"item."
msgstr ""
"ដើម្បី​ផ្ទុក​ឡើង​នូវ​ព័ត៌មាន​ទំនេរ​/​រវល់​ទៅកាន់​ម៉ាស៊ីន​បម្រើ គឺ​ត្រូវ​កំណត់​នៅ​ក្នុង​ចំណង់ចំណូលចិត្ត &korganizer; ហើយ​"
"ជ្រើស​ធាតុ​ម៉ឺនុយ <menuchoice><guimenu>កាលវិភាគ</guimenu> <guimenuitem>ផ្ទុក​ព័ត៌មាន​ទំនេរ​/​"
"រវល់​ឡើង</guimenuitem></menuchoice> ។"

#. Tag: title
#: index.docbook:2256
#, no-c-format
msgid "Examples"
msgstr "ឧទាហរណ៍"

#. Tag: title
#: index.docbook:2259
#, no-c-format
msgid "Entering a New Group Event"
msgstr "ការ​បញ្ចូល​ព្រឹត្តិការណ៍​ក្រុម​ថ្មី"

#. Tag: para
#: index.docbook:2261
#, no-c-format
msgid ""
"In this example, you'll enter an event. You need to arrange a meeting on "
"<emphasis>the next Monday</emphasis> regarding launch of your new Product. "
"Your boss <emphasis>Joan Holden</emphasis> will be the event chairwoman "
"<emphasis>owner</emphasis>, and you, Jack Smith, will be the event "
"<emphasis>organizer</emphasis>. There will be two more <emphasis>attendees</"
"emphasis> (participants): <emphasis>Peter Krzinski</emphasis> and "
"<emphasis>Kirsten Friese</emphasis>. Joan gave you the program of the "
"meeting. The appointment will start at <emphasis>12 noon</emphasis> and end "
"at <emphasis>1 pm</emphasis>. The same appointment should be scheduled "
"<emphasis>(recurred)</emphasis> each Monday."
msgstr ""
"ក្នុង​ឧទាហរណ៍​នេះ អ្នក​នឹង​ត្រូវ​បញ្ចូល​ព្រឹត្តិការណ៍ ។ អ្នក​ត្រូវ​រៀបចំ​ការប្រជុំ​មួយ​នៅ​ <emphasis>ថ្ងៃ​ច័ន្ទ​"
"ក្រោយ</emphasis> ដែល​ទាក់ទង​នឹង​ការ​ចាប់ផ្ដើម​ផលិតផល​ថ្មី​របស់​អ្នក ។ ចៅហ្វាយ​របស់​អ្នក​ឈ្មោះ "
"<emphasis>ធារី</emphasis> ​ជា​​ប្រធាន​រៀបចំ​ព្រឹត្តិការណ៍ ហើយ​អ្នក​​ជា​<emphasis>អ្នក​រៀបចំ</"
"emphasis>​ព្រឹត្តិការណ៍ ។ មាន​<emphasis>អ្នក​ចូល​រួម</emphasis>​ពីរ​នាក់​បន្ថែម​ទៀត ៖ "
"<emphasis>តារា</emphasis> និង <emphasis>រដ្ឋា</emphasis> ។ ធារី បាន​ឲ្យ​កម្មវិធី​ប្រជុំ​ទៅ​"
"អ្នក ។ ការ​ណាត់​ជួប​នឹង​ចាប់​ផ្ដើម​នៅ​<emphasis>ម៉ោង ១២ ថ្ងៃត្រង់</emphasis> និង​បញ្ចប់​នៅ​"
"<emphasis>ម៉ោង ១ រសៀល</emphasis> ។ ការណាត់​ជួប​ដដែល​នោះ នឹង​ត្រូវ​កំណត់​ <emphasis>(កើតឡើង​"
"ដដែលៗ)</emphasis> នៅ​រៀងរាល់​ថ្ងៃ​ច័ន្ទ ។"

#. Tag: para
#: index.docbook:2274
#, no-c-format
msgid "Using the Date Navigator, go to the next Monday."
msgstr "ការប្រើ​កម្មវិធី​រុករក​កាលបរិច្ឆេទ ទៅកាន់​ថ្ងៃ ច័ន្ទ ក្រោយ ។"

#. Tag: para
#: index.docbook:2276
#, no-c-format
msgid ""
"Choose the <menuchoice><guimenu>Actions</guimenu><guimenuitem>New Event...</"
"guimenuitem></menuchoice>, or select the area between <emphasis>12 noon</"
"emphasis> and end at<emphasis>1 pm</emphasis>, and start typing the event "
"title."
msgstr ""
"ជ្រើស <menuchoice><guimenu>អំពើ</guimenu><guimenuitem>ព្រឹត្តិការណ៍​ថ្មី...</"
"guimenuitem></menuchoice> ឬ​ជ្រើស​ផ្ទៃ​នៅ​រវាង <emphasis>ម៉ោង ១២ ថ្ងៃ​ត្រង់</emphasis> "
"និង​បញ្ចប់​នៅ<emphasis>​ម៉ោង ១ រសៀល</emphasis> ហើយ​ចាប់​ផ្ដើម​វាយ​បញ្ចូល​ចំណង​ជើង​របស់​ព្រឹត្តិការណ៍ ។"

#. Tag: para
#: index.docbook:2281
#, no-c-format
msgid ""
"Enter a suitable title. It's important to choose the right brief "
"description, because this is the only field that can be searched. We suggest "
"that you enter <userinput>Product launch event</userinput>."
msgstr ""
