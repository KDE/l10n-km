#. Tag: title
#: index.docbook:3249
#, no-c-format
msgid "Toolbars Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​របារ​ឧបករណ៍"

#. Tag: para
#: index.docbook:3251
#, fuzzy, no-c-format
#| msgid ""
#| "&korganizer; has three toolbars: a Main toolbar (with <guiicon>New Event</"
#| "guiicon>, <guiicon>New To-do</guiicon>, <guiicon>Print</guiicon>, "
#| "<guiicon>Undo</guiicon>, <guiicon>Redo</guiicon>, <guiicon>Cut</guiicon>, "
#| "<guiicon>Copy</guiicon>, <guiicon>Paste</guiicon>, <guiicon>Find</"
#| "guiicon>, <guiicon>Go Backward</guiicon>, <guiicon>Go Forward</guiicon> "
#| "and <guiicon>Goto Today</guiicon> buttons), a <guiicon>Views</guiicon> "
#| "toolbar (for selecting between <guiicon>Whats Next view</guiicon>, "
#| "<guiicon>List view</guiicon>, <guiicon>Day view</guiicon>, <guiicon>Work "
#| "Week view</guiicon>, <guiicon>Week view</guiicon>, <guiicon>Next X Day "
#| "view</guiicon>, <guiicon>Month view</guiicon>, <guiicon>To-do List view</"
#| "guiicon> and <guiicon>Journal view</guiicon> buttons), a Schedule toolbar "
#| "(with <guiicon>Publish Item Information</guiicon>, <guiicon>Send "
#| "Invitations to Attendees</guiicon>, <guiicon>Send Status Update</guiicon> "
#| "and <guiicon>Open Address Book</guiicon> buttons) and a Filters toolbar, "
#| "which allows you to choose a filter for the &korganizer; views. You can "
#| "customize these toolbars in various ways: you can add new icons, change "
#| "the icon size, change toolbar position and add text description to the "
#| "icons."
msgid ""
"&korganizer; has four toolbars: a Main toolbar (with <guiicon>New Event</"
"guiicon>, <guiicon>New To-do</guiicon>, <guiicon>New Journal</guiicon>, "
"<guiicon>Back</guiicon>, <guiicon>Forward</guiicon>, <guiicon>Today</"
"guiicon>, <guiicon>Day</guiicon> and <guiicon>Week</guiicon> buttons), a "
"<guiicon>Views</guiicon> toolbar (for selecting between <guiicon>Agenda</"
"guiicon>, <guiicon>Month View</guiicon>, <guiicon>Timeline</guiicon>, "
"<guiicon>To-do List</guiicon> and <guiicon>Journal</guiicon> views), a "
"Schedule toolbar (with <guiicon>Publish Item Information</guiicon>, "
"<guiicon>Send Invitations to Attendees</guiicon>, <guiicon>Send Status "
"Update</guiicon> and <guiicon>Address Book</guiicon> buttons) and a Filters "
"toolbar, which allows you to choose a filter for the &korganizer; views and "
"manage the view filters as well. You can customize these toolbars in various "
"ways: you can add new icons, change the icon size, change toolbar position "
"and add text description to the icons."
msgstr ""
"&korganizer; មាន​របារ​ឧបករណ៍​ចំនួន បី គឺ ៖ របារ​ឧបករណ៍​មេ (មាន​ប៊ូតុង <guiicon>ព្រឹត្តិការណ៍​ថ្មី</"
"guiicon> <guiicon>ការងារ​ត្រូវ​ធ្វើ​ថ្មី</guiicon> <guiicon>បោះពុម្ព</guiicon> "
"<guiicon>មិនធ្វើ​វិញ</guiicon> <guiicon>ធ្វើ​វិញ</guiicon> <guiicon>កាត់</guiicon> "
"<guiicon>ចម្លង</guiicon> <guiicon>បិទភ្ជាប់</guiicon> <guiicon>ស្វែងរក</guiicon> "
"<guiicon>ទៅ​ក្រោយ</guiicon> <guiicon>ទៅមុខ</guiicon> និង <guiicon>ទៅថ្ងៃ​នេះ</"
"guiicon>) របារ​ឧបករណ៍ <guiicon>ទិដ្ឋភាព</guiicon>  (សម្រាប់​ការ​ជ្រើសរើស​រវាង​ប៊ូតុង "
"<guiicon>បន្តបន្ទាប់</guiicon> <guiicon>បញ្ចី</guiicon>, <guiicon>ថ្ងៃ</guiicon>, "
"<guiicon>សប្ដាហ៍​ធ្វើការ</guiicon> <guiicon>សប្ដាហ៍</guiicon> <guiicon>X ថ្ងៃ​បន្ទាប់</"
"guiicon> <guiicon>ខែ</guiicon> <guiicon>បញ្ជីការងារ​ត្រូវ​ធ្វើ</guiicon> និង "
"<guiicon>ធាតុ​ទិនានុប្បវត្តិ</guiicon>​) របារ​ឧបករណ៍ កាលវិភាគ (មាន​ប៊ូតុង "
"<guiicon>បោះពុម្ពផ្សាយ​ព័ត៌មាន​ធាតុ</guiicon> <guiicon>ផ្ញើ​លិខិត​អញ្ជើញ​ទៅ​អ្នក​ចូលរួម</"
"guiicon> <guiicon>ផ្ញើ​ភាព​ទាន់សម័យ​នៃ​ស្ថានភាព</guiicon> និង <guiicon>បើក​សៀវភៅ​"
"អាសយដ្ឋាន</guiicon>) និង​​របារ​ឧបករណ៍​តម្រង ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​តម្រង​សម្រាប់​ទិដ្ឋភាព "
"&korganizer; ។ អ្នក​អាច​ប្ដូរ​របារ​ឧបករណ៍​ទាំងនេះ​តាម​បំណង​បាន តាម​របៀប​ផ្សេងគ្នា ៖ អ្នក​អាច​បន្ថែម​"
"រូបតំណាង​ថ្មី ផ្លាស់ប្ដូរ​ទំហំ​រូបតំណាង ផ្លាស់ប្ដូរ​ទីតាំង​របស់​របារ​ឧបករណ៍ និង​បន្ថែម​សេចក្ដី​ពណ៌នា​អត្ថបទ​ទៅ​ឲ្យ​"
"រូបតំណាង​បាន ។"

#. Tag: para
#: index.docbook:3267
#, no-c-format
msgid "There are two ways to change the position of the toolbars:"
msgstr "មាន​វិធី​ពីរយ៉ាង​ក្នុង​ការ​ផ្លាស់ប្ដូរ​ទីតាំង​របស់​របារ​ឧបករណ៍ ៖"

#. Tag: para
#: index.docbook:3269
#, no-c-format
msgid ""
"You can right click the toolbar to bring up the <guimenu>Toolbar Menu</"
"guimenu>. The icon size and text position can also be adjusted from this "
"menu."
msgstr ""
"អ្នក​អាច​ចុច​កណ្ដុរ​ខាងស្ដាំ​លើ​របារ​ឧបករណ៍ ដើម្បី​ឲ្យ​បង្ហាញ <guimenu>ម៉ឺនុយ​របារ​ឧបករណ៍</guimenu> ។ "
"ទំហំ​របស់​រូប​តំណាង និង​ទីតាំង​អត្ថបទ​ក៏​អាច​ត្រូវ​បាន​លៃតម្រូវ​ពី​ម៉ឺនុយ​នេះ​បាន​ដែរ ។"

#. Tag: para
#: index.docbook:3273
#, fuzzy, no-c-format
#| msgid ""
#| "You can simply drag the toolbar by the handle on the left border of each "
#| "toolbar, and drop it whenever you wish. Also look at other easy <link "
#| "linkend=\"other-features-drag-and-drop\">drag-and-drop operations</link>."
msgid ""
"If a toolbar is unlocked, you can simply drag the toolbar by the handle on "
"the left border of each toolbar, and drop it whenever you wish. Also look at "
"other easy <link linkend=\"other-features-drag-and-drop\">drag-and-drop "
"operations</link>."
msgstr ""
"អ្នក​អាច​​អូស​របារ​ឧបករណ៍​តាម​ធម្មតា​បាន ដោយ​ចុច​ទាញ​នៅ​ជ្រុង​ខាងឆ្វេង​នៃ​របារ​ឧបរណ៍​នីមួយៗ ហើយ​ចាប់ផ្ដើម​អូស​"
"វា​នៅពេល​ដែល​អ្នក​ចង់​អូស ។ ត្រូវ​មើល​<link linkend=\"other-features-drag-and-drop"
"\">ប្រតិបត្តិការ​អូស ហើយ​ទម្លាក់</link>​ងាយៗ​ផ្សេង​ទៀត ។"

#. Tag: para
#: index.docbook:3280
#, no-c-format
msgid "The toolbars are configured in two places:"
msgstr "របារ​ឧបករណ៍​គឺ​ត្រូវ​បាន​កំណត់​រចនា​សម្ព័ន្ធ​ក្នុង​ទីតាំង​ពីរ ៖"

#. Tag: para
#: index.docbook:3282
#, fuzzy, no-c-format
#| msgid ""
#| "The tool set is configured in the <menuchoice><guimenu> Settings</"
#| "guimenu><guimenuitem>Configure Toolbars....</guimenuitem></menuchoice> "
#| "menu item."
msgid ""
"The tool set is configured in the <menuchoice><guimenu> Settings</"
"guimenu><guimenuitem>Configure Toolbars...</guimenuitem></menuchoice> menu "
"item."
msgstr ""
"សំណុំ​របារ​ឧបករណ៍ ត្រូវ​បាន​កំណត់​រចនា​សម្ព័ន្ធ​នៅ​ក្នុង​ធាតុ​ម៉ឺនុយ <menuchoice><guimenu>ការ​កំណត់</"
"guimenu><guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ​របារ​ឧបករណ៍....</guimenuitem></menuchoice> ។"

#. Tag: para
#: index.docbook:3286
#, no-c-format
msgid ""
"The graphic style (icon size, text position, &etc;) is adjusted through the "
"<guimenu>Toolbar Context Menu</guimenu>. Right click the toolbar to access "
"this menu."
msgstr ""
"រចនាប័ទ្ម​ក្រាហ្វិក (ទំហំ​រូបតំណាង ទីតាំង​អត្ថបទ ។ល។) គឺ​ត្រូវបាន​លៃតម្រូវ​តាម <guimenu>ម៉ឺនុយ​បរិបទ​របស់​"
"របារ​ឧបករណ៍</guimenu> ។ ចុច​កណ្ដុរ​ខាងស្ដាំ​លើ​របារ​ឧបករណ៍ ដើម្បី​ដំណើរការ​ម៉ឺនុយ​នេះ ។"

#. Tag: title
#: index.docbook:3294
#, no-c-format
msgid "Configure Toolbars Dialog"
msgstr "កំណត់​រចនា​សម្ព័ន្ធ​ប្រអប់​របារ​ឧបករណ៍"

#. Tag: para
#: index.docbook:3296
#, no-c-format
msgid ""
"This dialog allows you to customize the selection of tools on the toolbar. "
"Open it choosing the <menuchoice><guimenu>Settings</guimenu><guimenuitem> "
"Configure Toolbars...</guimenuitem></menuchoice> menu item."
msgstr ""
"ប្រអប់​នេះ​អនុញ្ញា​ឲ្យ​អ្នក​ប្ដូរ​ជម្រើស​នៃ​ឧបករណ៍​នៅលើ​របារ​ឧបករណ៍​តាម​បំណង ។ អ្នក​អាច​បើក​វា​ដោយ​ជ្រើស​ធាតុ​"
"ម៉ឺនុយ <menuchoice><guimenu>ការ​កំណត់</guimenu><guimenuitem> កំណត់​រចនា​សម្ព័ន្ធ​របារ​"
"ឧបករណ៍...</guimenuitem></menuchoice> ។"

#. Tag: title
#: index.docbook:3301
#, no-c-format
msgid "Choosing the toolbar"
msgstr "ការ​ជ្រើស​រើស​របារ​ឧបករណ៍"

#. Tag: para
#: index.docbook:3303
#, no-c-format
msgid ""
"First you need to choose the toolbar that you want to modify. All actions "
"apply to the toolbar that is selected from the drop down menu at the top of "
"the window."
msgstr ""
"ដំបូង អ្នក​ត្រូវ​ជ្រើស​របារ​ឧបករណ៍​​ដែល​អ្នក​ចង់​កែប្រែ ។ អំពើ​ទាំងអស់​នឹង​អនុវត្ត​ចំពោះ​របារ​ឧបករណ៍ ដែល​បាន​"
"ជ្រើស​ពី​ម៉ឺនុយ​ធ្លាក់​ចុះ​នៅ​កំពូល​បង្អួច ។"

#. Tag: title
#: index.docbook:3309
#, no-c-format
msgid "Available Actions"
msgstr "អំពើ​ដែលមាន​​"

#. Tag: para
#: index.docbook:3311
#, fuzzy, no-c-format
#| msgid ""
#| "There are two rectangles below the toolbar title: <guilabel>Available "
#| "actions</guilabel> and <guilabel>Current actions</guilabel>. Using the "
#| "left and right arrows (located between the rectangles) you can add icons "
#| "from the Available actions group to the <guilabel>Current actions</"
#| "guilabel> group. The toolbar will have every icon that is in the "
#| "<guilabel>Current action</guilabel> box. The up and down arrows allow you "
#| "reposition an icon."
msgid ""
"There are two rectangles below the toolbar title: <guilabel>Available "
"actions</guilabel> and <guilabel>Current actions</guilabel>. Using the left "
"and right arrows (located between the rectangles) you can move icons from "
"the <guilabel>Available actions</guilabel> group to the <guilabel>Current "
"actions</guilabel> group. The toolbar will have every icon that is in the "
"<guilabel>Current actions</guilabel> box. The up and down arrows allow you "
"to reposition an icon."
msgstr ""
"មាន​ប្រអប់​រាង​ចតុកោណ​ពីរ​នៅ​ពីក្រោម​ចំណង​ជើង​របារ​ឧបករណ៍ ៖ <guilabel>អំពើ​ដែល​មាន</guilabel> និង "
"<guilabel>អំពើ​បច្ចុប្បន្ន</guilabel> ។ ដោយ​ប្រើ​ព្រួញ​ឆ្វេង និង​ស្ដាំ (នៅ​ពីក្រោម​ប្រអប់​ចតុកោណ) អ្នក​"
"អាច​បន្ថែម​រូបតំណាង​ពី​ក្រុម​អំពើ​ដែល​មាន​ទៅ​ក្រុម <guilabel>អំពើ​បច្ចុប្បន្ន</guilabel> ។ របារ​ឧបករណ៍​"
"នឹង​មាន​រូបតំណាង​ទាំងអស់​ដែល​នៅ​ក្នុង​ប្រអប់ <guilabel>អំពើ​បច្ចុប្បន្ន</guilabel> ។ ព្រួញ​ឡើងលើ​"
"ចុះក្រោម អនុញ្ញាត​ឲ្យ​អ្នកដាក់​រូបតំណាង​បាន ។"

#. Tag: para
#: index.docbook:3318
#, no-c-format
msgid ""
"The buttons below the <guilabel>Current actions</guilabel> list allows you "
"to change the icon and the text of a button. In the <guilabel>Change Text</"
"guilabel> dialog you can select <guilabel>Hide text when toolbar shows text "
"alongside icons</guilabel> to save space in this mode so that all buttons "
"are visible."
msgstr ""

#. Tag: para
#: index.docbook:3323
#, no-c-format
msgid ""
"Remember that less icons may be better, because the screen is less busy and "
"therefore it is easier to find the toolbar buttons you actually use. For "
"instance if you always cut and paste with the keyboard hotkeys, you do not "
"need the <guiicon>Cut</guiicon>, <guiicon>Copy</guiicon> and <guiicon>Paste</"
"guiicon> icons."
msgstr ""
"ត្រូវ​ចងចាំថា Remember that less icons may be better, because the screen is less "
"busy and therefore it is easier to find the toolbar buttons you actually "
"use. For instance if you always cut and paste with the keyboard hotkeys, you "
"do not need the <guiicon>Cut</guiicon>, <guiicon>Copy</guiicon> and "
"<guiicon>Paste</guiicon> icons."

#. Tag: title
#: index.docbook:3333
#, no-c-format
msgid "Toolbar Context Menu"
msgstr "ម៉ឺនុយ​បរិបទ​របស់​របារ​ឧបករណ៍​"

#. Tag: para
#: index.docbook:3335
#, no-c-format
msgid ""
"This menu allows you to change the look of the toolbars. <mousebutton>Right</"
"mousebutton> click the toolbar to access this menu."
msgstr ""
"ម៉ឺនុយ​នេះ អនុញ្ញាត​ឲ្យ​អ្នក​ផ្លាស់ប្ដូរ​រូបរាង​​របស់​របារ​ឧបករណ៍ ។ ចុច​កណ្ដុរ<mousebutton>ខាងស្ដាំ</"
"mousebutton>​លើ​របារ​ឧបករណ៍ ដើម្បី​ចូល​ដំណើរការ​ម៉ឺនុយ​នេះ ។"

#. Tag: title
#: index.docbook:3340
#, fuzzy, no-c-format
#| msgid "Show Time As:"
msgid "Show Text"
msgstr "បង្ហាញ​ពេលវេលា​ជា ៖"

#. Tag: para
