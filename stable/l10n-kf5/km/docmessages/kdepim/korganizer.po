#, no-c-format
msgid "Main features of &korganizer;:"
msgstr "លក្ខណៈ​ពិសេស​របស់ &korganizer; ៖"

#. Tag: para
#: index.docbook:159
#, no-c-format
msgid "Create To-dos, schedule events, and write journal entries."
msgstr "បង្កើត​ភារកិច្ច​ដែលត្រូវ​ធ្វើ ព្រឹត្តិការណ៍​តារាង​ពេលវេលា និង​សរសេរ​ធាតុ​​ទិនានុប្បវត្តិ ។"

#. Tag: para
#: index.docbook:160
#, no-c-format
msgid ""
"Organize your events and to-dos by grouping the related items in categories."
