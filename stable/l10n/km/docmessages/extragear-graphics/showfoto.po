#. Tag: title
#: index.docbook:2634
#, no-c-format
msgid "Compilation and Installation"
msgstr "ការ​ចងក្រង និង​ការ​ដំឡើង"

#. Tag: para
#: index.docbook:2636
#, no-c-format
msgid ""
"In order to compile and install &showfoto; on your system, type the following "
"in the basedirectorys of the <emphasis>libkipi</emphasis> and <emphasis>"
"digikam</emphasis> module distributions:"
msgstr ""
"ដើម្បី​ចងក្រង និង​ដំឡើង Showfoto នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក វាយ​ខាង​ក្រោម​ក្នុង basedirectorys នៃ <emphasis>libkipi</emphasis> និង​ការ​ចែកចាយ​ម៉ូឌុល <emphasis>"
"digikam</emphasis> ៖"

#. Tag: screen
#: index.docbook:2639
#, no-c-format
msgid ""
"<prompt>%</prompt> <userinput>export WANT_AUTOCONF_2_5=1</userinput>\n"
"    <prompt>%</prompt> <userinput>export "
"KDEDIR=KDE_installation_dir_on_your_system</userinput>\n"
"    <prompt>%</prompt> <userinput>export \n"
"    "
"PKG_CONFIG_PATH=$PKG_CONFIG_PATH:/path/to/installation/lib/pkgconfig</userinput>    "
"\n"
"    <prompt>%</prompt> <userinput>make -f Makefile.cvs</userinput>\n"
"    <prompt>%</prompt> <userinput>./configure</userinput>\n"
"    <prompt>%</prompt> <userinput>make</userinput>\n"
"    <prompt>%</prompt> <userinput>su</userinput>\n"
"    <prompt>%</prompt> <userinput>make install</userinput>"
msgstr ""
"<prompt>%</prompt> <userinput>export WANT_AUTOCONF_2_5=1</userinput>\n"
"    <prompt>%</prompt> <userinput>export "
"KDEDIR=KDE_installation_dir_on_your_system</userinput>\n"
"    <prompt>%</prompt> <userinput>export \n"
"    "
"PKG_CONFIG_PATH=$PKG_CONFIG_PATH:/path/to/installation/lib/pkgconfig</userinput>    "
"\n"
"    <prompt>%</prompt> <userinput>make -f Makefile.cvs</userinput>\n"
"    <prompt>%</prompt> <userinput>./configure</userinput>\n"
"    <prompt>%</prompt> <userinput>make</userinput>\n"
"    <prompt>%</prompt> <userinput>su</userinput>\n"
"    <prompt>%</prompt> <userinput>make install</userinput>"

#. Tag: title
#: index.docbook:2643
#, no-c-format
msgid "Important Notices"
msgstr "ការ​ចំណាំ​សំខាន់"

#. Tag: para
#: index.docbook:2645
#, no-c-format
msgid ""
"Stage 3 is required if you are installing libkexif in a non-standard location, "
"and you must let pkg-config know about their paths."
msgstr "ដំណាក់​កាល 3 ត្រូវ​បាន​ទាមទារ បើ​អ្នក​កំពុង​ដំឡើង libkexif ក្នុង​ទីតាំង​ដែល​មិន​មែន​ជា​ស្តង់ដារ ហើយ​អ្នក​ត្រូវ​តែ​អនុញ្ញាត pkg-config ស្គាល់​អំពី​ផ្លូវ​របស់​វា ។"

#. Tag: para
#: index.docbook:2649
#, no-c-format
msgid ""
"More specific compilation and installation options can be passed to the "
"<emphasis>configure</emphasis> script. Use <userinput>"
"./configure --help</userinput> on the command line to view these options."
msgstr ""
"ជម្រើស​ការ​ចងក្រង និង​ការ​ដំឡើង​ជាក់លាក់​អាច​ត្រូវ​បាន​បញ្ជូន​ទៅ​ស្គ្រីប "
"<emphasis>កំណត់​រចនា​សម្ព័ន្ធ</emphasis> ។ ប្រើ <userinput>"
"./configure --help</userinput> នៅ​លើ​បន្ទាត់​ពាក្យ​បញ្ជា​ដើម្បី​មើល​ជម្រើស​ទាំងនេះ ។"

#. Tag: para
#: index.docbook:2653
#, no-c-format
msgid ""
"Use <emphasis>--enable-debug=full</emphasis> option with <emphasis>"
"configure</emphasis> script for to provide a full informations bug report."
msgstr ""
"ប្រើ​ជម្រើស <emphasis>--enable-debug=full</emphasis> ជាមួយ​ស្គ្រីប <emphasis>"
"កំណត់​រចនាស​ម្ព័ន្ធ</emphasis> សម្រាប់​ផ្ដល់​ព័ត៌មាន​ពេញលេញ​នូវ​របាយការណ៍​បំបាត់​កំហុស ។"

#. Tag: para
#: index.docbook:2657
#, no-c-format
msgid ""
"Because &showfoto; depends on <emphasis>libkexif</emphasis>"
", you must build or install this library before you build &showfoto;."
msgstr ""
"ពីព្រោះ Showfoto ផ្អែក​លើ <emphasis>libkexif</emphasis>"
" អ្នក​ត្រូវ​តែ​សង់ ឬ​ដំឡើង​បណ្ណាល័យ​នេះ​មុន​អ្នក​សង់ Showfoto ។"

#. Tag: para
#: index.docbook:2663
#, no-c-format
msgid ""
"Since &showfoto; uses autoconf and automake you should not have trouble "
"compiling it. If you run into problems please report them to <email>"
"digikam-users@kde.org</email>."
msgstr ""
"ពីព្រោះ Showfoto ប្រើ autoconf និង automake អ្នក​មិន​គួរ​មាន​បញ្ហា​ចងក្រង​វា​ទេ ។ បើ​អ្នក​មាន​បញ្ហា សូម​រាយការណ៍​ពួក​វា​ទៅ <email>"
"digikam-users@kde.org</email> ។"
