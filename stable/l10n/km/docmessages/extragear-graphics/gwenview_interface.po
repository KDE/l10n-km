#. Tag: title
#: interface.docbook:2
#, no-c-format
msgid "The interface"
msgstr "ចំណុច​ប្រទាក់"

#. Tag: title
#: interface.docbook:4
#, no-c-format
msgid "Browse and View modes"
msgstr "របៀប​រុករក និង​មើល"

#. Tag: para
#: interface.docbook:6
#, no-c-format
msgid "By default, &kappname; opens in Browse mode."
msgstr "ដោយ​លំនាំ​ដើម Kappname បើក​របៀប​រុករក ។"

#. Tag: para
#: interface.docbook:8
#, no-c-format
msgid ""
"In this mode you can easily navigate through your files and folders. As you can "
"see on the screenshot, the preview window shows the current image as well as "
"any embedded image comment."
msgstr "ក្នុង​របៀប​នេះ​អ្នក​អាច​រុករក​យ៉ាង​ងាយ​ស្រួល​តាម​រយៈ​ឯកសារ​របស់​អ្នក និង​ថត ។ ដូច​ដែល​អ្នក​បាន​ឃើញ​នៅ​លើ​រូបថត​អេក្រង់ បង្អួច​មើល​ជាមុន​បង្ហាញ​រូបភាព​បច្ចុប្បន្ន​រួម​ទាំង​មតិយោបល់​រូបភាព​ដែល​បាន​បង្កប់​ណា​មួយ ។"

#. Tag: screeninfo
#: interface.docbook:13
#, no-c-format
msgid "Browse Mode Screenshot"
msgstr "រូបថត​អេក្រង់​របៀប​រុករក"

#. Tag: para
#: interface.docbook:22
#, no-c-format
msgid ""
"From the Browse mode, unchecking <menuchoice> <shortcut> "
"<keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></keycombo> </shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Browse</guimenuitem> </menuchoice> "
"will put you in View mode, where the image takes all the space of the window."
msgstr ""
"ពី​របៀប​រុករក ដោះ​ធីក <menuchoice> <shortcut> "
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>ត្រឡប់</keycap></keycombo> </shortcut> "
"<guimenu>មើល</guimenu> <guimenuitem>រុករក</guimenuitem> </menuchoice> "
"នឹង​ដាក់​អ្នក​ក្នុង​របៀប​មើល ដែល​រូបភាព​យក​ទំហំ​ទាំងអស់​នៃ​បង្អួច ។"

#. Tag: screeninfo
#: interface.docbook:35
#, no-c-format
msgid "View Mode Screenshot"
msgstr "រូបថត​អេក្រង់​របៀប​មើល"

#. Tag: para
#: interface.docbook:43
#, no-c-format
msgid ""
"You can start directly in View mode by starting &kappname; with an image as an "
"argument."
msgstr "អ្នក​អាច​ចាប់ផ្ដើម​ដោយ​ផ្ទាល់​ក្នុង​របៀប​មើល​ដោយ​ចាប់ផ្ដើម Kappname ជាមួយ​រូបភាព​ជា​អាគុយម៉ង់ ។"

