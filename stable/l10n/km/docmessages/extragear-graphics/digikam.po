#: index.docbook:1519
#, no-c-format
msgid "<entry>-</entry>"
msgstr ""

#. Tag: entry
#: index.docbook:1519
#, no-c-format
msgid "<entry>8</entry>"
msgstr ""

#. Tag: entry
#: index.docbook:1521 index.docbook:1523
#, no-c-format
msgid "<entry>*</entry>"
msgstr ""

