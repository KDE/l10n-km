#. Tag: title
#: index.docbook:5182
#, no-c-format
msgid "Installation"
msgstr ""

#. Tag: title
#: index.docbook:5185
#, no-c-format
msgid "How to Obtain &digikam;"
msgstr ""

#. Tag: para
#: index.docbook:5187
#, no-c-format
msgid ""
"The website for &digikam; is at <ulink url=\"http://www.digikam.org\">"
"http://www.digikam.org</ulink>. Please check it regularly to get the latest "
"news about &digikam;. &digikam; can be obtained in binary and source format "
"from <ulink url=\"http://sourceforge.net/project/showfiles.php?group_id=42641\">"
"http://sourceforge.net/project/showfiles.php?group_id=42641</ulink>."
msgstr ""

#. Tag: para
#: index.docbook:5191
#, no-c-format
msgid ""
"Also you can checkout the <emphasis>digikam</emphasis> and <emphasis>"
"kipi</emphasis> source code modules from &kde; Extragear SVN repository like "
"this:"
msgstr ""

#. Tag: screen
#: index.docbook:5195
#, no-c-format
msgid ""
"<prompt>%</prompt> <userinput>svn co -N "
"svn://anonsvn.kde.org/home/kde/trunk/extragear/graphics</userinput>\n"
"    <prompt>%</prompt> <userinput>cd graphics</userinput>\n"
"    <prompt>%</prompt> <userinput>svn up digikam</userinput>\n"
"    <prompt>%</prompt> <userinput>svn co "
"svn://anonsvn.kde.org/home/kde/branches/KDE/3.5/kde-common/admin</userinput>"
msgstr ""

#. Tag: para
#: index.docbook:5199
#, no-c-format
msgid ""
"The last SVN snapshoots can be downloaded at this &URL; <ulink "
"url=\"ftp://ftp.kde.org/pub/kde/unstable/snapshots/\"> "
"ftp://ftp.kde.org/pub/kde/unstable/snapshots/</ulink>."
msgstr ""

