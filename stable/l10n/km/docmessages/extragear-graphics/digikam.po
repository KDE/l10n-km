msgstr ""

#. Tag: para
#: index.docbook:5215
#, no-c-format
msgid "gphoto2 2.x"
msgstr ""

#. Tag: para
#: index.docbook:5216
#, no-c-format
msgid "imlib2 >= 1.2.0"
msgstr ""

#. Tag: para
#: index.docbook:5217
#, no-c-format
msgid "libgdbm >= 1.8.0"
msgstr ""

#. Tag: para
#: index.docbook:5218
#, no-c-format
msgid "libkipi >= 0.1"
msgstr ""

#. Tag: para
#: index.docbook:5219
#, no-c-format
msgid "libkexif >= 0.1"
msgstr ""

#. Tag: para
#: index.docbook:5220
#, no-c-format
msgid "libtiff >= 3.5.x"
