#: index.docbook:1398
#, no-c-format
msgid "Colors"
msgstr "ពណ៌"

#. Tag: para
#: index.docbook:1399
#, no-c-format
msgid ""
"The colors sidebar has two sub tabs <guilabel>Color and ICC Profile</guilabel>"
