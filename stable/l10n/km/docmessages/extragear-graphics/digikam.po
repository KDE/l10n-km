#, no-c-format
msgid "sidebar Metadata GPS info"
msgstr "របារចំហៀង​ព័ត៌មាន​ទិន្នន័យមេតា​របស់​ GPS "

#. Tag: screeninfo
#: index.docbook:1389
#, no-c-format
msgid "sidebar Metadata info"
msgstr "របារចំហៀង​ព័ត៌មាន​ទិន្នន័យមេតា"

