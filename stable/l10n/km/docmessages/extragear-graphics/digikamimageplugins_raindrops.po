#: raindrops.docbook:55
#, no-c-format
msgid "The plugin in action"
msgstr ""

#. Tag: para
#: raindrops.docbook:57
#, no-c-format
msgid ""
"This is an example of the raindrops filter. The original image (1) shows a "
"quiet sunset, the transformed image (2) indicates a sunset after a "
"thunderstorm. Default values have been used for this example."
msgstr ""

