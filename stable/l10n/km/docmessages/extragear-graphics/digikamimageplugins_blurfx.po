#. Tag: para
#: blurfx.docbook:19
#, no-c-format
msgid ""
"The digiKam image plugin <emphasis>Blur FX</emphasis> "
"is a series of blurring effects for digital still images."
msgstr ""

#. Tag: keyword
#: blurfx.docbook:25
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr ""

#. Tag: keyword
#: blurfx.docbook:26
#, no-c-format
msgid "Digikam"
msgstr ""

#. Tag: title
#: blurfx.docbook:31
#, no-c-format
msgid "Introduction"
msgstr ""

#. Tag: para
#: blurfx.docbook:33
#, no-c-format
msgid ""
"With this plugin, you can transform an ordinary photograph into a work of art "
"suitable for framing using blurring operations. It use algorithms copyrighted "
"by Pieter Voloshyn."
msgstr ""

#. Tag: title
#: blurfx.docbook:38
#, no-c-format
msgid "Using the plugin"
msgstr ""

#. Tag: para
#: blurfx.docbook:40
#, no-c-format
msgid "These are the blurring effects available:"
msgstr ""

#. Tag: entry
#: blurfx.docbook:50
#, no-c-format
msgid "Type"
msgstr ""

#. Tag: entry
#: blurfx.docbook:51
#, no-c-format
msgid "Preview"
msgstr ""

#. Tag: entry
#: blurfx.docbook:58
#, no-c-format
msgid ""
"<guilabel>Zoom Blur</guilabel>: blurs the image along radial lines starting "
"from a specified center point. This simulates the blur of a zooming camera, "
"thereby giving the photograph a dynamic expression as often seen in sport "
"photography."
msgstr ""

#. Tag: entry
#: blurfx.docbook:68
#, no-c-format
msgid ""
"<guilabel>Radial Blur</guilabel>: blurs the image by roating the pixels around "
"the specified center point. This simulates the blur of a rotating camera."
msgstr ""

#. Tag: entry
#: blurfx.docbook:78
#, no-c-format
msgid ""
"<guilabel>Far Blur</guilabel>: blurs the image to simulates the effect of an "
"unfocused camera lens. The subject seems to recede into the background."
msgstr ""

#. Tag: entry
#: blurfx.docbook:88
#, no-c-format
msgid ""
"<guilabel>Motion Blur</guilabel>: blurs the image by swishing the pixels "
"horizontally. This simulates the blur of a linearly moving camera, i.e. like a "
"shot taken from a car or train."
msgstr ""

#. Tag: entry
#: blurfx.docbook:98
#, no-c-format
msgid ""
"<guilabel>Focus Blur</guilabel>: blurs the image corners to reproduce the "
"astigmatism distortion of a lens."
msgstr ""

#. Tag: entry
#: blurfx.docbook:108
#, no-c-format
msgid ""
"<guilabel>Softener Blur</guilabel>: blurs the image softly in the darker tones "
"and strongly in the high lights. This gives photographes a dreamy and glossy "
"soft focus effect (Hamilton effect). It's ideal for creating romantic "
"portraits, glamour photography, or addding a warm and subtle glow."
msgstr ""

#. Tag: entry
#: blurfx.docbook:118
#, no-c-format
msgid ""
"<guilabel>Shake Blur</guilabel>: blurs the image by randomly moving the pixels "
"simulating the blur of an arbitrarily moving camera."
msgstr ""

#. Tag: entry
#: blurfx.docbook:128
#, no-c-format
msgid ""
"<guilabel>Smart Blur</guilabel>: finds the edges of color in photograph and "
"blurs them without muddying the rest of the image."
msgstr ""

#. Tag: entry
#: blurfx.docbook:138
#, no-c-format
msgid ""
"<guilabel>Frost Glass</guilabel>: blurs the image by simulating randomly "
"dispersing light filtering through hoarse frosted glass."
msgstr ""

#. Tag: entry
#: blurfx.docbook:148
#, no-c-format
msgid ""
"<guilabel>Mosaic</guilabel>: blurs the image by dividing the photograph into "
"rectangular cells and then recreates it by filling those cells with average "
"pixel value."
msgstr ""

#. Tag: para
#: blurfx.docbook:163
#, no-c-format
msgid ""
"Some effects can take long time to run and cause high CPU load. You can always "
"abort an effect by pressing the <guilabel>Abort</guilabel> "
"button during preview rendering."
msgstr ""

