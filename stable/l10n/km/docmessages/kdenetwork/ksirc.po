#. Tag: para
#: index.docbook:59
#, no-c-format
msgid "This documentation describes &ksirc; 1.2.1, the &kde; &irc; client."
msgstr ""

#. Tag: keyword
#: index.docbook:64
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#. Tag: keyword
#: index.docbook:65
#, no-c-format
msgid "KSirc"
msgstr "KSirc"

#. Tag: keyword
