#. Tag: title
#: index.docbook:839
#, no-c-format
msgid "Sending Bold, Underline, Reverse, and Color"
msgstr "ផ្ញើ ដិត គូស​បន្ទាត់​ពី​ក្រោម បញ្ច្រាស និង​ពណ៌"

#. Tag: para
#: index.docbook:841
#, no-c-format
msgid "You can use the following key combinations to insert control codes in text:"
msgstr ""
"អ្នក​អាច​ប្រើ​ការ​បន្សំ​គ្រាប់​ចុច​ខាង​ក្រោម​ដើម្បី​បញ្ចូល​កូដ​បញ្ជា​ក្នុង​អត្ថប"
"ទ ៖"

#. Tag: para
#: index.docbook:846
#, no-c-format
msgid "<keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo> for bold text"
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>B</keycap></keycombo> "
"សម្រាប់​អត្ថបទ​ដិត"

#. Tag: para
#: index.docbook:850
#, no-c-format
msgid ""
"<keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> "
"for underlined text"
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>U</keycap></keycombo> "
"សម្រាប់​អត្ថបទ​គូស​ពី​ក្រោម"

#. Tag: para
#: index.docbook:854
#, no-c-format
msgid "<keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> for reverse text"
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>R</keycap></keycombo> "
"សម្រាប់​បញ្ច្រាស​អត្ថបទ"

#. Tag: para
#: index.docbook:858
#, no-c-format
msgid "<keycombo action=\"simul\">&Ctrl;<keycap>K</keycap></keycombo> for colored text"
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>K</keycap></keycombo> "
"សម្រាប់​អត្ថបទ​ដែល​ដាក់​ពណ៌"

#. Tag: para
#: index.docbook:862
#, no-c-format
msgid "<keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> for plain text"
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>O</keycap></keycombo> "
"សម្រាប់​អត្ថបទ​ធម្មតា"

#. Tag: title
#: index.docbook:870
#, no-c-format
msgid "Examples"
msgstr "ឧទាហរណ៍"

#. Tag: para
#: index.docbook:872
#, no-c-format
msgid "To underline a single word in a sentence:"
msgstr "ដើម្បី​គូស​បន្ទាត់​ក្រោម​ពាក្យ​តែ​មួយ​ក្នុង​អត្ថបទ ៖"

#. Tag: para
#: index.docbook:876
#, no-c-format
msgid "Type <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo>"
msgstr "វាយ <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>U</keycap></keycombo>"

#. Tag: para
#: index.docbook:880
#, no-c-format
msgid "Type in the word"
msgstr "វាយ​ក្នុង​ពាក្យ"

#. Tag: para
#: index.docbook:883
#, no-c-format
msgid "Type <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> again"
msgstr ""
"វាយ <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>U</keycap></keycombo> "
"ម្ដង​ទៀត"

#. Tag: para
#: index.docbook:888
#, no-c-format
msgid ""
"Only the text that is enclosed by the start and end codes will be affected. You "
"can use this method with all of the other control codes."
msgstr ""
"មាន​តែ​អត្ថបទ​ដែល​ត្រូវ​បាន​ភ្ជាប់​ដោយ​កូដ​ចាប់ផ្ដើម "
"និង​កូដ​បញ្ចប់​នឹង​ត្រូវ​បាន​ប៉ះពាល់ ។ "
"អ្នក​អាច​ប្រើ​វិធី​សាស្ត្រ​នេះ​ជាមួយ​កូដ​បញ្ជា​ផ្សេង​ទៀត ។"

#. Tag: para
#: index.docbook:892
#, no-c-format
msgid ""
"The <keycombo action=\"simul\">&Ctrl;<keycap>K</keycap></keycombo> "
"control code is slightly different because it allows you to specify a color "
"number. To color a single word in a sentence:"
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>K</keycap></keycombo> "
"កូដ​បញ្ជា​ខុស​គ្នា​បន្តិច ព្រោះ​វា​អនុញ្ញាត​ឲ្យ​អ្នក​បញ្ជាក់​លេង​ពណ៌ ។ "
"ដើម្បី​ដាក់​ពណ៌​ពាក្យ​តែ​មួយ​ក្នុង​ឃ្លា ៖"

#. Tag: para
#: index.docbook:898
#, no-c-format
msgid "Type <keycombo action=\"simul\">&Ctrl;<keycap>K</keycap></keycombo>"
msgstr "វាយ <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>K</keycap></keycombo>"

#. Tag: para
#: index.docbook:902
#, no-c-format
msgid "Type a number between 0 and 15"
msgstr "វាយ​លេខ​រវាង 0 និង 15"

#. Tag: para
#: index.docbook:905
#, no-c-format
msgid "Type the word"
msgstr "វាយ​ពាក្យ"

#. Tag: para
#: index.docbook:908
#, no-c-format
msgid "Type <keycombo action=\"simul\">&Ctrl;<keycap>K</keycap></keycombo> again"
msgstr ""
"វាយ <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>K</keycap></keycombo> "
"ម្ដង​ទៀត"

#. Tag: para
#: index.docbook:913
#, no-c-format
msgid ""
"If you also want to change the background color of a word, you would need to "
"type two numbers separated by a comma instead of just one number. The first "
"number is the text color, the second number is the background color. The colors "
"range from 0 to 15, the index is in the previous section."
msgstr ""
"បើ​អ្នក​ចង់​ផ្លាស់ប្ដូរ​ពណ៌​ផ្ទៃ​ខាងក្រោយ​នៃ​ពាក្យ "
"អ្នក​គួរ​តែ​វាយ​លេខ​ពីរ​ដែល​បំបែក​ដោយ​សញ្ញា​ក្បៀស​ជំនួស​ឲ្យ​លេខ​តែ​មួយ ។ "
"លេខ​ដំបូង​គឺ​ជា​ពណ៌​អត្ថបទ លេខ​ទីពីរ​គឺ​ជា​ពណ៌​ផ្ទៃ​ខាងក្រោយ ។ "
"ពណ៌​ដែល​មាន​លំដាប់​ពី 0 ទៅ 15 លិបិក្រម​គឺ​នៅ​ផ្នែក​មុន ។"

#. Tag: para
#: index.docbook:919
#, no-c-format
msgid ""
"You can enclose text in multiple control codes, so for example you could have a "
"bold, underlined, and colored word."
msgstr ""
"អ្នក​អាច​ភ្ជាប់​អត្ថបទ​ក្នុង​កូដ​បញ្ជា​ច្រើន ឧទាហរណ៍ អ្នក​អាច​ដាក់​ពណ៌ "
"ធ្វើ​ឲ្យ​ដិត និង​គូស​បន្ទាត់​ពី​ក្រោម​ពាក្យ ។"

#. Tag: title
#: index.docbook:926
#, no-c-format
msgid "Filters"
msgstr "តម្រង"

#. Tag: title
#: index.docbook:929
#, no-c-format
msgid "Filter Rules and How to Make them"
msgstr "ច្បាប់​តម្រង និង​របៀប​ធ្វើ​ពួក​វា"

#. Tag: para
#: index.docbook:931
#, no-c-format
msgid ""
"If you just can't figure it out, wait. I want to build a nice <quote>"
"filter builder</quote> where you can just click your way through it. Though, it "
"might be a while."
msgstr ""
"បើ​អ្នក​មិន​អាច​រក​ឃើញ​ពួក​វា សូម​ចាំ​បន្តិច ។ ខ្ញុំ​ចង់​ស្ថាបនា <quote>"
"ឧបករណ៍​ស្ថាបនា​តម្រង</quote> ស្រស់​ស្អាត "
"ដែល​អ្នក​អាច​ចុចផ្លូវ​របស់​អ្នក​តាម​វាយ ។ តែ​វា​ត្រូវ​ចំណាយ​ពេល​បន្តិច ។"

#. Tag: para
#: index.docbook:935
#, no-c-format
msgid ""
"The filter tries to find the <quote>match</quote> string then use the <quote>"
"From</quote> and <quote>To</quote> as a substitution. The match, from and to "
"are all <application>Perl</application> regex expressions. Rules are evaluated "
"in descending order. The top rule is evaluated first, then the second from the "
"top, &etc; All strings are evaluated as:"
msgstr ""
"តម្រង​ព្យាយាម​រក​ខ្សែ​អក្សរ <quote>ផ្គូផ្គង</quote> បន្ទាប់​ប្រើ <quote>"
"ពី</quote> និង <quote>ទៅ</quote> ជា​ការ​ជំនួស ។ ការ​ផ្គូផ្គង ពី និង​ទៅ "
"គឺ​ជា​កន្សោម <application>Perl</application> regex ទាំងអស់ ។ "
"ច្បាប់​ត្រូវ​បាន​វាយ​តម្លៃ​ក្នុង​លំដាប់​ចុះ ។ "
"ច្បាប់​កំពូល​ត្រូវ​បាន​វាយ​តម្លៃ​មុន បន្ទាប់​ទី​ពីរ​ពី​កំពូល ។ល។ "
"ខ្សែ​អក្សរ​ទាំងអស់​ត្រូវ​បាន​វាយ​តម្លៃ​ជា ៖"

#. Tag: para
#: index.docbook:942
#, no-c-format
msgid ""
"<varname>$<replaceable>name</replaceable></varname> is expanded to the "
"environment variable <varname><replaceable>name</replaceable></varname>"
". This is done immediately when you insert the rule, and will not change after "
"that time. Therefore it's probably of limited value."
msgstr ""
"<varname>$<replaceable>name</replaceable></varname> "
"ត្រូវ​បាន​បន្ថែម​ទៅ​អថេរ​បរិស្ថាន <varname><replaceable>name</replaceable>"
"</varname> ។ នេះ​ត្រូវ​បាន​ធ្វើ​ភ្លាមៗ​ពេល​អ្នក​បញ្ចូល​ច្បាប់ "
"ហើយ​នឹង​មិន​ផ្លាស់ប្ដូរ​បន្ទាប់​ពី​ពេល​នោះ ។ លើស​ពី​នេះ "
"វា​ប្រហែល​ជា​តម្លៃ​ដែល​បាន​កំណត់ ។"

#. Tag: para
#: index.docbook:948
#, no-c-format
msgid ""
"<varname>$$<replaceable>name</replaceable></varname> "
"is substituted with the <acronym>Perl</acronym> <varname>$<replaceable>"
"name</replaceable></varname> variable during the match. This can be substrings "
"such as <varname>$1</varname>, <varname>$2</varname> "
"in the substitution, or normal variables available under <application>"
"sirc</application> (such as <varname>$nick</varname>, <varname>"
"$channel</varname>, &etc;)."
msgstr ""
"<varname>$$<replaceable>name</replaceable></varname> "
"ត្រូវ​បាន​ជំនួស​ដោយ​អថេរ <acronym>Perl</acronym> <varname>$<replaceable>"
"name</replaceable></varname> កំឡុង​ពេល​ផ្គូផ្គង ។ "
"នេះ​អាច​ជា​ខ្សែ​អក្សរ​រង​ដូចជា <varname>$1</varname>, <varname>$2</varname> "
"ក្នុង​ការ​ជំនួស ឬ​អថេរ​ធម្មតា​ដែល​មាន​នៅ​ក្រោម <application>sirc</application> "
"(ដូចជា <varname>$nick</varname>, <varname>$channel</varname> ។ល។) ។"

#. Tag: para
#: index.docbook:956
#, no-c-format
msgid ""
"<varname>&tilde;<replaceable>name</replaceable>&tilde;</varname> <emphasis>"
"prepended once and only once</emphasis> to the line will send the line of text "
"to the window called <replaceable>name</replaceable>"
". If the window does not exist it will go to the last window which had focus. "
"There are several special windows, all prefixed by a single <literal>!</literal>"
":"
msgstr ""
"<varname>&tilde;<replaceable>name</replaceable>&tilde;</varname> <emphasis>"
"បាន​បន្ថែម​ខាង​ដើម​ម្ដង និង​តែ​ម្ដង</emphasis> "
"ទៅ​បន្ទាត់​នឹង​ផ្ញើ​បន្ទាត់​នៃ​អត្ថបទ​ទៅ​បង្អួច​ដែល​ហៅ​ថា <replaceable>"
"name</replaceable> ។ បើ​បង្អួច​មិន​មាន "
"វា​នឹង​ទៅ​បង្អួច​ចុង​ក្រោយ​ដែល​បាន​ផ្ដោត ។ មាន​បង្អួច​ពិសេស​ជា​ច្រើន "
"ទាំងអស់​ត្រូវ​បាន​បន្ថែម​ពី​មុខ​ដោយ <literal>!</literal> មួយ ៖"

#. Tag: varname
#: index.docbook:965
#, no-c-format
msgid "!default"
msgstr "!default"

#. Tag: para
#: index.docbook:967
#, no-c-format
msgid "The current default window. Guaranteed to exist."
msgstr "បង្អួច​លំនាំ​ដើម​បច្ចុប្បន្ន ។ ធានា​ឲ្យ​មាន ។"

#. Tag: varname
#: index.docbook:971
#, no-c-format
msgid "!all"
msgstr "!all"

#. Tag: para
#: index.docbook:973
#, no-c-format
msgid ""
"Send to every window. This might not show up on all windows, depending on how "
"the text is parsed. For example, channel windows won't show a <command>"
"/part</command> or <command>/quit</command> unless the nickname is on the "
"channel."
msgstr ""
"ផ្ញើ​ទៅ​គ្រប់​បង្អួច​ទាំងអស់ ។ នេះ​ប្រហែល​ជា​មិន​បង្ហាញ​លើ​បង្អួច​ទាំងអស់ "
"ដោយ​ផ្អែក​លើ​របៀប​ដែល​អត្ថបទ​ត្រូវ​បាន​ញែក ។ ឧទាហរណ៍ បង្អួច​ប៉ុស្តិ៍​មិន​បង្ហាញ "
"<command>/part</command> ឬ <command>/quit</command> "
"ទាល់តែ​សម្មិតិ​នាម​នៅ​លើ​ប៉ុស្តិ៍ ។"

#. Tag: varname
#: index.docbook:979
#, no-c-format
msgid "!discard"
msgstr "!discard"

#. Tag: para
#: index.docbook:981
#, no-c-format
msgid "discards the text."
msgstr "បោះបង់​អត្ថបទ ។"

#. Tag: para
#: index.docbook:987
#, no-c-format
msgid ""
"The rest of the expression is dealt with as normal <acronym>Perl</acronym> "
"regex. A good understanding of the <command>perlre</command> "
"man page will definitely help, but a basic understanding of regex is most "
"certainly required."
msgstr ""
"កន្សោម​ទាំងអស់​ត្រូវ​បាន​ដោះស្រាយ​ជា <acronym>Perl</acronym> "
"regex ធម្មតា ។ ការ​យល់​ដល់​ល្អ​នៃ​ទំព័រ​ man <command>perlre</command> "
"នឹង​ជួយ​ទាំងស្រុង ប៉ុន្តែ​ការ​យល់​មូលដ្ឋាន​នៃ regex "
"គឺ​ត្រូវ​បាន​ទាមទារ​យ៉ាង​ប្រាកដ ។"

#. Tag: title
#: index.docbook:996
#, no-c-format
msgid "Examples:"
msgstr "ឧទាហរណ៍ ៖"

#. Tag: para
#: index.docbook:999
#, no-c-format
msgid "Want to convert all boren from boren to BoreN"
msgstr "ចង់​បម្លែង boren ទាំងអស់​ពី boren ទៅ BoreN"

#. Tag: screen
#: index.docbook:1001
#, no-c-format
msgid ""
"Match: .*\n"
"From: boren\n"
"To: BoreN"
msgstr ""
"Match: .*\n"
"From: boren\n"
"To: BoreN"

#. Tag: para
#: index.docbook:1003
#, no-c-format
msgid "Pretty straight forward, match anything, then substitute boren with BoreN."
msgstr "ងាយ​ស្រួល​បំផុត ផ្គូផ្គង​អ្វី​ទាំងអស់ បន្ទាប់​ជំនួស boren ជាមួយ BoreN ។"

#. Tag: para
#: index.docbook:1008
#, no-c-format
msgid ""
"You want to match everything with boren in it and send to the window called "
"<quote>boren</quote>"
msgstr ""
"អ្នក​ចង់​ផ្គូផ្គង​អ្វី​ទាំងអស់​ជាមួយ boren នៅ​ក្នុង​វា "
"និង​ផ្ញើ​ទៅ​បង្អួច​ដែល​ហៅ​ថា <quote>boren</quote>"

#. Tag: screen
#: index.docbook:1011
#, no-c-format
msgid ""
"Match: boren\n"
"From: &circ;\n"
"To: &tilde;boren&tilde;"
msgstr ""
"Match: boren\n"
"From: &circ;\n"
"To: &tilde;boren&tilde;"

#. Tag: para
#: index.docbook:1013
#, no-c-format
msgid ""
"Looks for <quote>boren</quote> if found, substitutes the beginning of the "
"string (&circ;) with &tilde;boren&tilde;."
msgstr ""
"រក​មើល <quote>boren</quote> បើ​ឃើញ ជំនួស​ការ​ចាប់ផ្ដើម​នៃ​ខ្សែ​អក្សរ (&circ;) "
"ជាមួយ &tilde;boren&tilde; ។"

#. Tag: para
#: index.docbook:1019
#, no-c-format
msgid ""
"Though the previous example works, if the string already has <literal>"
"&tilde;somewindow&tilde;</literal> on it, you'll now have two <literal>"
"&tilde;boren&tilde;&tilde;somewindow&tilde;...</literal> "
"So you can do this instead."
msgstr ""
"ទោះបី​ជា​ឧទាហរណ៍​មុន​ធ្វើការ បើ​ខ្សែ​អក្សរ​មាន​រួច​ហើយ <literal>"
"&tilde;somewindow&tilde;</literal> នៅ​លើ​វា អ្នក​នឹង​មាន <literal>"
"&tilde;boren&tilde;&tilde;somewindow&tilde;...</literal> "
"ពី​ឥឡូវ​នេះ ដូច្នេះ​អ្នក​អាច​ធ្វើ​នេះ​ជំនួស ។"

#. Tag: screen
#: index.docbook:1024
#, no-c-format
msgid ""
"Match: boren\n"
"From: ^(?:&tilde;\\S+&tilde;)\n"
"To: &tilde;boren&tilde;"
msgstr ""
"Match: boren\n"
"From: ^(?:&tilde;\\S+&tilde;)\n"
"To: &tilde;boren&tilde;"

#. Tag: para
#: index.docbook:1026
#, no-c-format
msgid ""
"Ok, the from line is a little bit more complicated. It means: match 0 or 1 "
"copies of <literal>&tilde;\\S+&tilde;</literal>. Which is 1 tilde, one or more "
"non-whitespaces, and then another tilde. The paranoid might do <literal>"
"(*:&tilde;\\S+&tilde;)</literal>, which means: match 0 or more channel "
"directives in case prior rules are broken."
msgstr ""
"យល់ព្រម ពី​បន្ទាត់​គឺ​សាំញ៉ាំ​បន្តិច ។ វា​មាន​ន័យ​ថា ០ ឬ ១ ច្បាប់​ចម្លង "
"<literal>&tilde;\\S+&tilde;</literal> ។ ដែល​ជា ១ tilde មួយ "
"ឬ​ច្រើន​ដែល​មិន​មែន​ជា​ដក​ឃ្លា ហើយ​បន្ទាប់ tilde មួយ​ផ្សេង​ទៀត ។ "
"ការ​ឆូត​ប្រហែល​ធ្វើ <literal>(*:&tilde;\\S+&tilde;)</literal> "
"ដែល​មាន​ន័យ​ថា ផ្គូផ្គង​សេចក្ដី​បង្គាប់ ០ "
"ឬ​ប៉ុស្តិ៍​ច្រើន​ក្នុង​ករណី​ច្បាប់​​អាទិភាព​ត្រូវ​បាន​ខូច ។"

#. Tag: para
#: index.docbook:1036
#, no-c-format
msgid ""
"Server kill messages tend to be long, ugly, annoying, &etc; A basic message on "
"dalnet looks like:"
msgstr ""
"សារ​ពិឃាដ​ម៉ាស៊ីន​បម្រើ​ដូច​ជា​វែង​ពេក អាក្រក់ រំខាន ។ល។ សារ​មូលដ្ឋាន​នៅ​លើ "
"dalnet ដូច​ជា ៖"

#. Tag: screen
#: index.docbook:1039
#, no-c-format
msgid ""
"*** Notice -- Received KILL message for\n"
"BOBO!ANDY@line82-basel.datacomm.ch from NickServ\n"
"Path: empire.ny.us.dal.net[209.51.168.14]!trapdoor.ca.us.dal.net\n"
"[206.86.127.252]!caris.ca.us.dal.net[208.1.222.221]\n"
"!services.dal.net[2008.1.222.222]!services.dal.net\n"
"(NickServ Enforcement)"
msgstr ""
"*** ចំណាំ -- បាន​ទទួល​សារ KILL ចំពោះ\n"
"BOBO!ANDY@line82-basel.datacomm.ch ពី NickServ\n"
"Path: empire.ny.us.dal.net[209.51.168.14]!trapdoor.ca.us.dal.net\n"
"[206.86.127.252]!caris.ca.us.dal.net[208.1.222.221]\n"
"!services.dal.net[2008.1.222.222]!services.dal.net\n"
"(NickServ Enforcement)"

#. Tag: para
#: index.docbook:1041
#, no-c-format
msgid ""
"When you're <literal>+s</literal> you get tons of them; you don't want all of "
"them flying across your screen. I'm going to make 3 rules to deal with them one "
"bit at a time. You could do it in less rules, but it'll show you the basic rule "
"structure, in nice steps, and how to use multiple rules to parse a message. The "
"first step is to remove the Path: portion of the message:"
msgstr ""
"ពេល​ដែល​អ្នក​ជា <literal>+s</literal> អ្នក​ទទួល​បាន​ពួក​វា​ច្រើន "
"អ្នក​មិន​ចង់​ឲ្យ​ពួក​វា​ហោះ​កាត់​អេក្រង់​របស់​អ្នក ។ "
"ខ្ញុំ​នឹង​បង្កើត​ច្បាប់​បី​ដើម្បី​ដោះស្រាយ​ជាមួយ​ពួក​វា​នៅ​ពេល​មួយ ។ "
"អ្នក​អាច​ធ្វើ​វា​ក្នុង​ច្បាប់​តិច "
"ប៉ុន្តែ​វា​បង្ហាញ​អ្នក​នូវ​រចនា​សម្ព័ន្ធ​ច្បាប់​មូលដ្ឋាន ក្នុង​ជំហាន​ដែល​ល្អ "
"និង​របៀប​ប្រើ​ច្បាប់​ច្រើន​ដើម្បី​ញែក​សារ ។ ជំហាន​ដំបូង​គឺ​ត្រូវ​យក​ផ្លូវ​ចេញ ៖ "
" ចំណែក​នៃ​សារ ៖"

#. Tag: screen
#: index.docbook:1048
#, no-c-format
msgid ""
"Match: ^\\*\\*\\*.* KILL message for.*\n"
"From:  Path: \\S+\n"
"To: ."
msgstr ""
"Match: ^\\*\\*\\*.* KILL message for.*\n"
"From:  Path: \\S+\n"
"To: ."

#. Tag: para
#: index.docbook:1051
#, no-c-format
msgid ""
"Match looks for the message starting with <literal>***</literal>, the <literal>"
"*</literal>'s have to be quoted with <literal>\\</literal> "
"since by themselves they mean 0 or more of the prior character. <literal>"
".*</literal> means: match anything until you find <literal> "
"KILL message for</literal>. This allows us to avoid typing in <literal>"
"-- Received...</literal> &etc; The trailing <literal>.*</literal> "
"means: match anything to the end of the line. (not needed, I think)"
msgstr ""
"ការ​ផ្គូផ្គង​រក​មើល​សារ​ដែល​ចាប់ផ្ដើម​ជាមួយ <literal>***</literal> <literal>"
"*</literal> ត្រូវ​តែ​បាន​ស្រង់​ជាមួយ <literal>\\</literal> "
"ដោយ​ខ្លួន​ពួក​វា ពួក​វា​មាន​ន័យ​ថា ០ ឬ​ច្រើន​ជាង​នេះ​នៃ​តួ​អក្សរ​ដំបូង ។ "
"<literal>.*</literal> មាន​ន័យ​ថា ៖ ផ្គូផ្គង​អ្វី​ទាំងអស់​ទាល់​តែ​អ្នក​ឃើញ "
"<literal> ពិឃាដ​សារ​សម្រាប់</literal> ។ នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​ចៀសវៀង​វាយ​ក្នុង "
"<literal>-- Received...</literal>  ។ល។ កន្ទុយ <literal>.*</literal> "
"មាន​ន័យ​ថា ៖ ផ្គូផ្គង​អ្វី​ដល់​ចុង​បញ្ចប់​នៃ​បន្ទាត់ ។ "
"(បើ​តាម​ខ្ញុំ​គិត​មិន​ចាំ​បាច់​ទេ)"

#. Tag: para
#: index.docbook:1060
#, no-c-format
msgid ""
"The From line means: substitute \" Path: \" and any non-whitespace characters "
"with the To. To is a <literal>\".\"</literal> therefore the entire path turns "
"into a single period."
msgstr ""
"ពី​បន្ទាត់ មាន​ន័យ​ថា ៖ ជំនួស \" Path: \" និង​តួ​អក្សរ​ដែល​មិន​មែន​ដក​ឃ្លា "
"ជាមួយ​ទៅ ។ ទៅ​គឺ​ជា <literal>\".\"</literal> "
"ប៉ុន្តែ​ផ្លូវ​ទាំងមូល​ត្រឡប់​ទៅ​ជា​ចំណុច​មួយ ។"

#. Tag: para
#: index.docbook:1064
#, no-c-format
msgid "The message now looks like:"
msgstr "សារ​ឥឡូវ​នេះ​ដូច​ជា ៖"

#. Tag: screen
#: index.docbook:1066
#, no-c-format
msgid ""
"*** Notice -- Received KILL message for BOBO!ANDY@line82-basel.datacomm.ch\n"
"from NickServ. (NickServ Enforcement)"
msgstr ""
"*** ចំណាំ -- បាន​ទទួល​សារ KILL សម្រាប់ BOBO!ANDY@line82-basel.datacomm.ch\n"
"ពី NickServ ។ (NickServ Enforcement)"

#. Tag: para
#: index.docbook:1068
#, no-c-format
msgid "Notice the new <literal>\".\"</literal> after <literal>NickServ</literal>?"
msgstr "ចំណាំ <literal>\".\"</literal> ថ្មី​បន្ទាប់​ពី <literal>NickServ</literal>?"

#. Tag: para
#: index.docbook:1073
#, no-c-format
msgid ""
"Ok, the message is a lot cleaner, but KILLs from nickserv aren't really that "
"important, so let's forward them to the <literal>!discard</literal> window."
msgstr ""
"យល់​ព្រម សារ​ស្អាត​ជា​ច្រើន ប៉ុន្តែ KILL ពី nickserv មិន​សំខាន់ត​ទេ "
"ដូច្នេះ​សូម​បញ្ជូន​វា​ទៅ​បង្អួច <literal>!discard</literal> ។"

#. Tag: screen
#: index.docbook:1077
#, no-c-format
msgid ""
"Match: ^\\*\\*\\*.*KILL message.*\\(NickServ Enforcement\\)\n"
"From: ^(?:&tilde;\\S+&tilde;)\n"
"To:  &tilde;!discard&tilde;"
msgstr ""
"Match: ^\\*\\*\\*.*KILL message.*\\(NickServ Enforcement\\)\n"
"From: ^(?:&tilde;\\S+&tilde;)\n"
"To:  &tilde;!discard&tilde;"

#. Tag: para
#: index.docbook:1079
#, no-c-format
msgid ""
"Match rule searches for the KILL message and makes sure it's from NickServ. "
"Notice the <literal>\\(</literal> and <literal>\\)</literal> "
"are both used in regex, therefore we have to quote them. This is very similar "
"to what we said two examples before."
msgstr ""
"ច្បាប់​ផ្គូផ្គង​ស្វែងរក​សម្រាប់​សារ ពិឃាដ និង​ធ្វើ​ឲ្យ​ប្រាកដ​ថា វា​មក​ពី "
"NickServ ។ ចំណាំ <literal>\\(</literal> and <literal>\\)</literal> "
"ទាំងពីរ​ត្រូវ​បាន​ប្រើ​ក្នុង regex មិន​ដូច្នេះ យើង​ត្រូវ​តែ​ស្រង់​ពួក​វា ។ "
"នេះ​ស្រដៀង​ទៅ​អ្វី​ដែល​យើង​និយាយ​ពី​ឧទាហរណ៍​ពីរ​មុន ។"

#. Tag: para
#: index.docbook:1086
#, no-c-format
msgid ""
"We've now filtered out all the nickserv kills, but the message is still pretty "
"hard to read by simply glancing at it. So let's reorder it to something like:"
msgstr ""
"យើង​បាន​ត្រង nickserv ពិឃាដ​ទាំងអស់ "
"ប៉ុន្តែ​សារ​នៅ​តែ​ពិបាក​អាន​ដោយ​គ្រាន់​តែ​សម្លឹង​ធម្មតា ។ ដូច្នេះ "
"សូម​តម្រៀប​វា​ឡើង​វិញ​ដូច​ជា ៖"

#. Tag: screen
#: index.docbook:1090
#, no-c-format
msgid ""
"*** [KILL] <replaceable>KILLER</replaceable>; killed <replaceable>"
"KILLED</replaceable>; (<replaceable>REASON</replaceable>)"
msgstr ""
"*** [KILL] <replaceable>KILLER</replaceable>; killed <replaceable>"
"KILLED</replaceable>; (<replaceable>REASON</replaceable>)"

#. Tag: screen
#: index.docbook:1092
#, no-c-format
msgid ""
"Match: \\*\\*\\*.*KILL message\n"
"From: \\*\\*\\*.*for (.*?) from (.*?)\\. \\((.*?)\\).*\n"
"To: *** [KILL] $$2 killed $$1 ($$3)"
msgstr ""
"Match: \\*\\*\\*.*KILL message\n"
"From: \\*\\*\\*.*for (.*?) from (.*?)\\. \\((.*?)\\).*\n"
"To: *** [KILL] $$2 killed $$1 ($$3)"

#. Tag: para
#: index.docbook:1094
#, no-c-format
msgid ""
"Ok, the match looks for <literal>***<replaceable>something</replaceable> "
"KILL message</literal>. We can't use <literal>&circ;</literal> "
"since we may have just appended <literal>&tilde;&lt;window&gt;&tilde;</literal>"
"."
msgstr ""
"យល់​ព្រម ការ​ផ្គូផ្គង​រក​មើល <literal>***<replaceable>អ្វី​ខ្លះ</replaceable> "
"សារKILL</literal> ។ យើង​មិន​អាច​ប្រើ <literal>Circ</literal> "
"ពីព្រោះ​យើង​អាច​គ្រាន់​តែ​បន្ថែម​ខាង​ចុង "
"<literal>&tilde;&lt;window&gt;&tilde;</literal>."

#. Tag: para
#: index.docbook:1099
#, no-c-format
msgid ""
"The from line gets a little more interesting. The <literal>"
"\"for (.*?) \"</literal> looks for the word \"for\" then some text. <literal>"
".*?</literal> means: match zero or more of anything except newline, but isn't "
"greedy. The rule is to stop when the first terminating condition is found, not "
"the last. In other words it matches anything until a space is encountered. The "
"surrounding <literal>()</literal> means: save the contents. Each () saves the "
"matched data in <literal>$&num;</literal> where <literal>&num;</literal> "
"starts at 1 for the first substring, &etc; In this case, <varname>$1</varname> "
"gets the nick/user-info of the person killed. <varname>$2</varname> "
"is then filled with the name of the killer. Between the <literal>()</literal> "
"we have the reason for the kill. Here the <literal>(</literal> and <literal>"
"\\(</literal> get a little confusing. Remember <literal>\\(</literal> "
"matches the actual character <literal>'('</literal>."
msgstr ""
"ពី​បន្ទាត់​ធ្វើ​ឲ្យ​កាន់​តែ​ចាប់​អារម្មណ៍ ។ <literal>\"for (.*?) \"</literal> "
"រក​មើល​ពាក្យ \"for\" បន្ទាប់​អត្ថបទ​ខ្លះ ។ <literal>.*?</literal> "
"មាន​ន័យ​ថា ៖ ផ្គូផ្គង សូន្យ ឬ​ច្រើន​នៃ​អ្វី​ច្រើន​លើក​លែង​តែ​បន្ទាត់​ថ្មី "
"ប៉ុន្តែ​មិន​ច្រើន​ពេក​ទេ ។ ច្បាប់​ត្រូវ​បាន​បញ្ឈប់ "
"ពេល​លក្ខខណ្ឌ​បញ្ចប់​ដំបូង​ត្រូវ​​បាន​រក​ឃើញ មិន​មែន​ចុង​ក្រោយ ។ ម្យ៉ាង​វិញ​ទៀត "
"វា​ផ្គូផ្គង​អ្វី​ទាំងអស់​ទាល់តែ​ដក​ឃ្លា​ត្រូវ​បាន​ជួប​ប្រទះ ។ ការ​ព័ទ្ធ​ជុំវិញ "
"<literal>()</literal> មាន​ន័យ​ថា ៖ រក្សា​ទុក​មាតិកា ។ () នីមួយៗ "
"រក្សា​ទុក​ទិន្នន័យ​ដែល​ផ្គូផ្គង​ក្នុង <literal>$&num;</literal> ដែល <literal>"
"&num;</literal> ចាប់ផ្ដើម​នៅ ១ សម្រាប់​ខ្សែ​អក្សរ​រង​ដំបូង ។ល។ ក្នុង​ករណី​នេះ "
"<varname>$1</varname> យក nick/user-info នៃ​មនុស្ស​ដែល​បាន​ពិឃាដ ។ <varname>"
"$2</varname> ត្រូវ​បាន​បំពេញ​បន្ទាប់​ជាមួយ​ឈ្មោះ​របស់​ឃាដករ ។ រវាង <literal>"
"()</literal> យើង​មាន​ហេតុ​ផល​សម្រាប់​ពិឃាដ ។ <literal>(</literal> និង <literal>"
"\\(</literal> ធ្វើ​ឲ្យ​ច្រឡំ​បន្តិច ។ ចងចាំ​ថា <literal>\\(</literal> "
"ផ្គូផ្គង​តួ​អក្សរ​ពិត <literal>'('</literal> ។"

#. Tag: para
#: index.docbook:1116
#, no-c-format
msgid "How to colorize your life."
msgstr "របៀប​ដាក់​ពណ៌​ឲ្យ​ជីវិត​របស់​អ្នក ។"

#. Tag: para
#: index.docbook:1118
#, no-c-format
msgid ""
"Ok, you want to add some color to &ksirc;. See the <link linkend=\"sectcolors\">"
"Colors section</link> for color info, but here's a filter rule to highlight the "
"nickname between <literal>&lt;NICK&gt;</literal> on each line:"
msgstr ""
"យល់​ព្រម អ្នក​ចង់​បន្ថែម​ពណ៌​ទៅ Ksirc ។ សូម​មើល <link linkend=\"sectcolors\">"
"ផ្នែក​ពណ៌</link> សម្រាប់​ព័ត៌មាន​ពណ៌ "
"ប៉ុន្តែ​នេះ​គឺ​ជា​ច្បាប់​តម្រង​ដើម្បី​បន្លេច​សម្មិតិ​នាម​រវាង <literal>"
"&lt;NICK&gt;</literal> នៅ​លើ​បន្ទាត់​នីមួយៗ ៖"

#. Tag: screen
#: index.docbook:1123
#, no-c-format
msgid ""
"Match: ^(?:&tilde;\\S+&tilde;)&lt;\\S+&gt;\n"
"From: &lt;(\\S+)&gt;\n"
"To: &lt;&tilde;4$$1&tilde;c&gt;"
msgstr ""
"Match: ^(?:&tilde;\\S+&tilde;)&lt;\\S+&gt;\n"
"From: &lt;(\\S+)&gt;\n"
"To: &lt;&tilde;4$$1&tilde;c&gt;"

#. Tag: para
#: index.docbook:1125
#, no-c-format
msgid ""
"Takes the nickname and adds color &num;4 between the two <literal>"
"&lt;&gt;</literal>. <literal>&tilde;c</literal> clears the color."
msgstr ""
"យក​សម្មិតិ​នាម និង​បង្ថែម​ពណ៌ &num;4 រវាង <literal>&lt;&gt;</literal> "
"ទាំង​ពីរ ។ <literal>&tilde;c</literal> ជម្រះ​ពណ៌ ។"

#. Tag: title
#: index.docbook:1135
