msgstr "<action>រមូរ​ទៅ​មុខ</action> កាត់​ឯកសារ ។"

#. Tag: title
#: index.docbook:482
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu>ការ​កំណត់</guimenu>"

#. Tag: menuchoice
#: index.docbook:487
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>M</keycap></keycombo>"
"</shortcut> <guimenu>Settings</guimenu> <guimenuitem>"
"Show/Hide Menubar</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា(Ctrl)<keycap>M</keycap></keycombo>"
"</shortcut> <guimenu>ការ​កំណត់</guimenu> <guimenuitem>"
"បង្ហាញ/លាក់​របារ​ម៉ឺនុយ</guimenuitem>"

#. Tag: action
#: index.docbook:492
#, no-c-format
msgid "Toggles the menubar on/off."
msgstr "បិទ​បើក​របារ​ម៉ឺនុយ ។"

#. Tag: menuchoice
#: index.docbook:496
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Toolbar</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>បង្ហាញ/លាក់​របារ​ឧបករណ៍</guimenuitem>"

#. Tag: para
#: index.docbook:500
#, no-c-format
msgid "<action>Toggle the Toolbar display</action> on and off."
msgstr "<action>បិទ​បើក​ការ​បង្ហាញ​របារ​ឧបករណ៍</action> ។"

#. Tag: menuchoice
#: index.docbook:504
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> "
"<guimenuitem>បង្ហាញ/លាក់​របារ​ស្ថានភាព</guimenuitem>"

#. Tag: para
#: index.docbook:508
#, no-c-format
msgid "<action>Toggle the Status bar display</action> on and off."
msgstr "<action>បិទ​បើក​ការ​បង្ហាញ​របារ​ស្ថានភាព</action> ។"

#. Tag: menuchoice
#: index.docbook:512
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift; <keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>Settings</guimenu> <guimenuitem>"
"Full Screen Mode</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា(Ctrl)ប្ដូរ(Shift) <keycap>F</keycap>"
"</keycombo></shortcut> <guimenu>ការ​កំណត់</guimenu> <guimenuitem>"
"របៀប​ពេញ​អេក្រង់</guimenuitem>"

#. Tag: menuchoice
#: index.docbook:529
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> "
"<guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ​ផ្លូវកាត់...</guimenuitem>"

#. Tag: para
#: index.docbook:533
#, no-c-format
msgid ""
"<action>Opens a dialog for changing the shortcuts.</action> "
"Using this option you can change the standard key shortcut for &kghostview;'s "
"commands or create new ones."
msgstr ""
"<action>បើក​ប្រអប់​សម្រាប់​ផ្លាស់ប្ដូរ​ផ្លូវកាត់ ។</action> "
"ដោយ​ប្រើ​ជម្រើស​នេះ​អ្នក​អាច​ផ្លាស់ប្ដូរ​ផ្លូវកាត់​គ្រាប់​ចុច​ស្ដង់ដារ​សម្រាប់​ព"
"ាក្យ​បញ្ជា​របស់ Kghostview ឬ​បង្កើត​ថ្មី​មួយ ។"

#. Tag: menuchoice
#: index.docbook:539
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> "
"<guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ​របារ​ឧបករណ៍...</guimenuitem>"

#. Tag: para
#: index.docbook:543
#, no-c-format
msgid ""
"<action>Opens a dialog for configuring the toolbar.</action> "
"You can add and remove toolbuttons for &kghostview;'s commands with this "
"option."
msgstr ""
"<action>បើក​ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​របារ​ឧបករណ៍ ។</action> "
"អ្នក​អាច​បន្ថែម និង​យក​ចេញ​ប៊ូតុង​ឧបករណ៍​សម្រាប់​ពាក្យ​បញ្ជា​របស់ Kghostview "
"ជាមួយ​ជម្រើស​នេះ ។"

#. Tag: menuchoice
#: index.docbook:549
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Scrollbars</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>បង្ហាញ/លាក់​របារ​រមូរ</guimenuitem>"

#. Tag: para
#: index.docbook:553
#, no-c-format
msgid ""
"<action>Toggle the horizontal and vertical scrollbars</action> on and off."
msgstr "<action>បិទ​បើក​របារ​រមូរ​ផ្ដេក និង​បញ្ឈរ</action> ។"

#. Tag: menuchoice
#: index.docbook:557
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Page List</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>បង្ហាញ​បញ្ជី​ទំព័រ</guimenuitem>"

#. Tag: para
#: index.docbook:561
#, no-c-format
msgid "<action>Toggle the Page List</action> on and off."
msgstr "<action>បិទ​បើក​បញ្ជី​ទំព័រ</action> ។"

#. Tag: menuchoice
#: index.docbook:565
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Page Labels</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>បង្ហាញ​ស្លាក​ទំព័រ</guimenuitem>"

#. Tag: para
#: index.docbook:569
#, no-c-format
msgid ""
"If this is selected the <action>name (if any) of the current page is displayed "
"in the Status Bar</action>."
msgstr ""
"បើ​ជ្រើស​នេះ <action>ឈ្មោះ (បើ​ជ្រើន) "
"នៃ​ទំព័រ​បច្ចុប្បន្ន​ត្រូវ​បាន​បង្ហាញ​ក្នុង​របារ​ស្ថានភាព</action> ។"

#. Tag: menuchoice
#: index.docbook:574
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Watch File</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>ឯកសារ​ឃ្លាំ​មើល</guimenuitem>"

#. Tag: para
#: index.docbook:578
#, no-c-format
msgid ""
"If this is selected the display will <action>automatically update</action> "
"if the document file changes."
msgstr ""
"បើ​ជ្រើស​នេះ ការ​បង្ហាញ​នឹង <action>ធ្វើ​ឲ្យ​ទាន់​សម័យ​ស្វ័យ​ប្រវត្តិ</action> "
"បើ​ឯកសារ​ផ្លាស់ប្ដូរ ។"

#. Tag: menuchoice
#: index.docbook:583
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>No Flicker</guimenuitem>"
msgstr "<guimenu>ការ​កំណត់</guimenu> <guimenuitem>មិន​ភ្លឹបភ្លែត</guimenuitem>"

#. Tag: para
#: index.docbook:587
#, no-c-format
msgid ""
"If this is selected the display will start showing objects instantly as they "
"are rendered, otherwise the whole page is rendered off-screen and then "
"displayed."
msgstr ""
"បើ​ជ្រើស​នេះ "
"ការ​បង្ហាញ​នឹង​ចាប់ផ្ដើម​បង្ហាញ​វត្ថុ​ដោយ​ភ្លាមៗ​ពេល​ដែល​ពួក​វា​បង្ហាញ "
"មិន​ដូចនោះ ទំព័រ​ទាំងមូល​ត្រូវ​បាន​បង្ហាញ​លាក់ និង​បន្ទាប់​បង្ហាញ ។"

#. Tag: menuchoice
#: index.docbook:593
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kghostview;...</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ "
"Kghostview...</guimenuitem>"

#. Tag: para
#: index.docbook:597
#, no-c-format
msgid ""
"Brings up the &kghostview; <link linkend=\"config-dialog\"><action>"
"configuration dialog</action> box</link>."
msgstr ""
"នាំ​យក​ប្រអប់ <link linkend=\"config-dialog\"><action>"
"ការ​កំណត់​រចនា​សម្ព័ន្ធ</action> Kghostview</link> ។"

#. Tag: title
#: index.docbook:606
#, no-c-format
msgid "The <guimenu>Help</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu>ជំនួយ</guimenu>"

#. Tag: sect1
#: index.docbook:606
#, no-c-format
msgid "&help.menu.documentation;"
msgstr "&help.menu.documentation;"

#. Tag: title
#: index.docbook:614
#, no-c-format
msgid "Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ"

#. Tag: para
#: index.docbook:616
#, no-c-format
msgid ""
"The configuration dialog box is accessed with the <menuchoice><guimenu>"
"Settings</guimenu><guimenuitem>Configure &kghostview;...</guimenuitem>"
"</menuchoice> option. It has two pages; <guilabel>General</guilabel> "
"and <guilabel>Ghostscript Configuration</guilabel>"
msgstr ""
"ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ត្រូវ​បាន​ចូល​ដំណើរ​ការ​ជាមួយ​ជម្រើស <menuchoice>"
"<guimenu>ការ​កំណត់</guimenu><guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ "
"Kghostview...</guimenuitem></menuchoice> ។ វា​មាន​ពីរ​ទំព័រ <guilabel>"
"ទូទៅ</guilabel> និង <guilabel>ការ​កំណត់​រចនា​សម្ព័ន្ធ Ghostscript</guilabel>"

#. Tag: title
#: index.docbook:625
#, no-c-format
msgid "General Settings"
msgstr "ការ​កំណត់​ទូទៅ"

#. Tag: para
#: index.docbook:627
#, no-c-format
msgid ""
"You can select <guilabel>Enable anti-aliasing of fonts and images</guilabel> "
"to get smoothly rendered text, but note that anti-aliasing is memory intensive "
"and slower than straightforward rendering of fonts. Early versions of "
"<application>Ghostscript</application> could not perform anti-aliasing."
msgstr ""
"អ្នក​អាច​ជ្រើស <guilabel>បើក​ប្រឆាំង​ឈ្មោះ​ក្លែងក្លាយ​នៃ​ពុម្ព​អក្សរ "
"និង​រូបភាព</guilabel> ដើម្បី​ទទួល​បាន​អត្ថបទ​ដែល​បង្ហាញ​យ៉ាង​ល្អ "
"ប៉ុន្តែ​ចំណាំ​ថា ការ​ប្រឆាំង​ឈ្មោះ​ក្លែងក្លាយ​គឺ​ត្រូវការ​សតិ​ច្រើន "
"និង​យឺត​ជាង​ការ​បង្ហាញ​ពុម្ព​អក្សរ​តែ​ម្ដង ។ កំណែ​ដំបូង​នៃ <application>"
"Ghostscript</application> មិន​អាច​ដំណើរ​ការ​ប្រឆាំង​ឈ្មោះ​ក្លែងក្លាយ​ទេ ។"

#. Tag: para
#: index.docbook:635
#, no-c-format
msgid ""
"Select <guilabel>Use platform fonts</guilabel> if you wish to use your native "
"system fonts rather than those that come with <application>"
"Ghostscript</application>."
msgstr ""
"ជ្រើស <guilabel>ប្រើ​ពុម្ព​អក្សរ​វេទិកា</guilabel> "
"បើ​អ្នក​ចង់​ប្រើ​ពុម្ព​អក្សរ​ប្រព័ន្ធ​ដើម​ជាជាង​ទាំងនោះ​ដែល​មក​ជាមួយ "
"<application>Ghostscript</application> ។"

#. Tag: para
#: index.docbook:641
#, no-c-format
msgid ""
"Turn <guilabel>Show Ghostscript messages in a separate box</guilabel> "
"on if you want to be informed of any output or error messages generated by the "
"<application>Ghostscript</application> interpreter."
msgstr ""
"បើក <guilabel>បង្ហាញ​សារ Ghostscript ក្នុង​ប្រអប់​ដាច់​ពី​គ្នា</guilabel> "
"បើ​អ្នក​ចង់​ឲ្យ​ជូន​ដំណឹង​ពី​ទិន្នផល "
"ឬ​សារ​កំហុស​ដែល​បង្កើត​ដោយ​អ្នក​បកប្រែ<application>Ghostscript</application> ។"

#. Tag: para
#: index.docbook:647
#, no-c-format
msgid ""
"You can choose whether &kghostview; uses a <guilabel>Monochrome</guilabel>"
", <guilabel>Grayscale</guilabel> or <guilabel>Color</guilabel> <guilabel>"
"Palette</guilabel> for the display."
msgstr ""
"អ្នក​អាច​ជ្រើស​ថា​តើ Kghostview ប្រើ <guilabel>Monochrome</guilabel> <guilabel>"
"មាត្រាដ្ឋាន​ប្រផេះ</guilabel> ឬ <guilabel>ពណ៌</guilabel> <guilabel>"
"ក្ដារ​លាយ</guilabel> សម្រាប់​ការ​បង្ហាញ ។"

#. Tag: title
#: index.docbook:656
#, no-c-format
msgid "<application>Ghostscript</application> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ <application>Ghostscript</application>"

#. Tag: para
#: index.docbook:658
#, no-c-format
msgid ""
"In this dialog box page you can set the name of the <application>"
"Ghostscript</application> <guilabel>Interpreter:</guilabel> "
"executable and the <guilabel>Non-antialiasing arguments:</guilabel> "
"and the <guilabel>Antialiasing arguments:</guilabel> "
"passed to it. The default settings should be suitable for most systems."
msgstr ""
"ក្នុង​ទំព័រ​ប្រអប់​នេះ អ្នក​អាច​កំណត់​ឈ្មោះ​នៃ <application>"
"Ghostscript</application> <guilabel>អ្នក​បកប្រែ ៖</guilabel> "
"អាច​ប្រតិបត្ត​បាន និង "
"<guilabel>អាគុយម៉ង់​ដែល​មិន​ប្រឆាំង​ឈ្មោះ​ក្លែងក្លាយ ៖</guilabel> និង <guilabel>"
"អាគុយម៉ង់​ប្រឆាំង​ឈ្មោះ​ក្លែងក្លាយ</guilabel> បាន​បញ្ជូន​បន្ត​ទៅ​វា ។ "
"ការ​កំណត់​លំនាំ​ដើម​គួរ​តែ​សម​សម្រាប់​ប្រព័ន្ធ​ភាគ​ច្រើន ។"

