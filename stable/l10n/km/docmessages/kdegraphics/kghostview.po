#. Tag: para
#: index.docbook:241
#, no-c-format
msgid "<action>Toggle the page marked flag</action> for the current page."
msgstr "<action>បិទ​បើក​ទំព័រ​ដែល​មាន​ទង់​សម្គាល់</action> សម្រាប់​ទំព័រ​បច្ចុប្បន្ន ។"

#. Tag: menuchoice
#: index.docbook:246
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Mark All Pages</guimenuitem>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guimenuitem>សម្គាល់​ទំព័រ​ទាំងអស់</guimenuitem>"

#. Tag: para
