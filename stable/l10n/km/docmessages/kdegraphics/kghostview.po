msgstr "<action>ទៅ​កាន់​ទំព័រ​ចុង​ក្រោយ</action> នៃ​ឯកសារ ។"

#. Tag: menuchoice
#: index.docbook:452
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Go to Page</guimenuitem>"
msgstr "<guimenu>មើល</guimenu> <guimenuitem>ទៅ​កាន់​ទំព័រ</guimenuitem>"

#. Tag: para
#: index.docbook:456
#, no-c-format
msgid "<action>Go to a selected page</action> of the document."
msgstr "<action>ទៅ​កាន់​ទំព័រ​ដែល​បាន​ជ្រើស</action> នៃ​ឯកសារ ។"

#. Tag: menuchoice
#: index.docbook:460
#, no-c-format
msgid ""
"<shortcut><keycap>PageUp</keycap></shortcut> <guimenu>View</guimenu> "
