msgstr ""

#. Tag: para
#: index.docbook:271
#, no-c-format
msgid ""
"<action>Set the page marked flag</action> for all odd numbered pages in the "
"document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:276
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Toggle Page Marks</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:280
#, no-c-format
msgid "<action>Toggle the page marked flags</action> for all pages in the document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:285
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Remove Page Marks</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:289
#, no-c-format
msgid "<action>Clear the page marked flags</action> for all pages in the document."
msgstr ""

#. Tag: title
#: index.docbook:298
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:303
#, no-c-format
