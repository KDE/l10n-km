#, no-c-format
msgid "Adjusts the gamma factor."
msgstr ""

#. Tag: menuchoice
#: index.docbook:293
#, no-c-format
msgid "<guimenu>Effects</guimenu> <guimenuitem>Blend Color...</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:297
#, no-c-format
msgid "Blends the image to selected color and opacity"
msgstr ""

#. Tag: menuchoice
#: index.docbook:301
#, no-c-format
msgid ""
"<guimenu>Effects</guimenu> <guimenuitem>Change Intensity "
"(Brightness)...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:305
#, no-c-format
msgid ""
"<action>Changes the brightness of the image.</action> "
"Enter the new brightness in percent (with respect to the <emphasis>"
"initial</emphasis> value)."
msgstr ""

#. Tag: title
#: index.docbook:314
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:318
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>+</keycap></keycombo>"
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom In</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:323
#, no-c-format
msgid ""
"<action>Enlarges the image by ten percent</action>. Notice that this refers to "
"the <emphasis>current</emphasis> size of the picture."
msgstr ""

#. Tag: menuchoice
#: index.docbook:329
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Zoom...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:333
#, no-c-format
msgid ""
"Opens a list to <action>choose the zoom factor</action>"
". This value is given in percent and always refers to the <emphasis>"
"initial</emphasis> size of the picture."
msgstr ""

#. Tag: menuchoice
#: index.docbook:339
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>-</keycap></keycombo>"
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom Out</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:344
#, no-c-format
msgid ""
"<action>Reduces the image size by ten percent</action>"
". Again this refers to the <emphasis>current</emphasis> size of the image."
msgstr ""

#. Tag: menuchoice
#: index.docbook:350
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Fit Image to Window</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:353
#, no-c-format
msgid ""
"<action>Maximizes the image size</action>. The image is scaled to the window "
"size, keeping the aspect ratio."
msgstr ""

#. Tag: title
#: index.docbook:362
#, no-c-format
msgid "The <guimenu>Go</guimenu> Menu"
msgstr ""

#. Tag: para
#: index.docbook:364
#, no-c-format
msgid ""
"This item is only displayed in the menubar, if you choose the application "
"plugin presenter in &kview;s configure dialog"
msgstr ""

#. Tag: menuchoice
#: index.docbook:369
#, no-c-format
msgid "<guimenu>Go</guimenu> <guimenuitem>Image List...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:373
#, no-c-format
msgid ""
"<action>Displays a list of the currently loaded images.</action> "
"You can flip through the images by either double-clicking on them or using the "
"<guibutton>Previous</guibutton> and <guibutton>Next</guibutton> "
"buttons. <guibutton>Shuffle</guibutton> rearranges the images in a random "
"order. Pressing <guibutton>Start Slideshow</guibutton> "
"will start the slideshow with the current settings for the interval. In "
"addition, you can save and load your image list using the corresponding "
"buttons. <guilabel>Slideshow interval:</guilabel> Here you can change the "
"interval between the different slides for the slideshow."
msgstr ""

#. Tag: menuchoice
