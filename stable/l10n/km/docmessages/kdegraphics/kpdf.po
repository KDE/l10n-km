"</shortcut> <guimenu>Settings</guimenu> <guimenuitem>"
"Show/Hide Menubar</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:578
#, no-c-format
msgid ""
"<action>Toggle the Menubar display</action> on and off. Once hidden it can be "
"made visible using the &RMB; menu."
msgstr ""

#. Tag: menuchoice
#: index.docbook:584
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:590
#, no-c-format
msgid "<action>Toggle the Toolbar display</action> on and off."
msgstr ""

#. Tag: menuchoice
#: index.docbook:595
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo>"
"</shortcut> <guimenu>Settings</guimenu> <guimenuitem>"
"Show/Hide Navigation Panel</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:602
#, no-c-format
msgid "<action>Toggle the navigation panel</action> on and off."
msgstr ""

#. Tag: menuchoice
#: index.docbook:607
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>Settings</guimenu> <guimenuitem>"
"Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:614
#, no-c-format
msgid ""
"<action>Enables the full screen mode</action>. Note that full screen mode is "
"different from <link linkend=\"presentationMode\">presentation mode</link> "
"insofar as the only peculiarity of full screen mode is that it hides the window "
"decorations, the menubar and the toolbar."
msgstr ""

#. Tag: menuchoice
#: index.docbook:623
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:629
#, no-c-format
msgid ""
"Opens a window that lets you <action>configure the keyboard shortcuts</action> "
"for many menu commands."
msgstr ""

#. Tag: menuchoice
#: index.docbook:635
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:641
#, no-c-format
msgid "Opens a window that lets you choose which icons are visible in the toolbar."
msgstr ""

#. Tag: menuchoice
#: index.docbook:647
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &kpdf;...</guimenuitem>"
