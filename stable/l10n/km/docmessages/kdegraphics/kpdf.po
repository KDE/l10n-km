#. Tag: title
#: index.docbook:667
#, no-c-format
msgid "Configuring &kpdf;"
msgstr ""

#. Tag: title
#: index.docbook:669
#, no-c-format
msgid "Overview"
msgstr ""

#. Tag: para
#: index.docbook:670
#, no-c-format
msgid ""
"You can configure &kpdf; by choosing <menuchoice><guimenu>Settings</guimenu> "
"<guimenuitem>Configure &kpdf;...</guimenuitem></menuchoice>"
". The configuration dialogue is split into four sections. This chapter "
"describes the available options in detail."
msgstr ""

