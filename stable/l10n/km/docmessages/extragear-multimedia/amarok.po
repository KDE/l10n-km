msgid "<entry>no</entry>"
msgstr "<entry> គ្មាន​ </entry>"

#. Tag: entry
#: index.docbook:294
#, no-c-format
msgid ""
"Enables debug symbols. Choose from <quote>yes</quote>, <quote>no</quote>"
", and <quote>full</quote>. Please use the <quote>full</quote> "
"option if you intend to help with &amarok; development."
msgstr ""
"បើកនិមិត្តសញ្ញា​បំបាត់កំហុស ។ ជ្រើស​ពី <quote> ចាស ឬ​បាទ </quote> <quote> ទេ </quote>"
"និង  <quote> ពេញ </quote> ។​ សូម​ប្រើជម្រើស​  <quote> ពេញ​ </quote> "
"បើ​អ្នកតាំងចិត្ត​ជួយ​ការអភិវឌ្ឍន៍​ amarok ។​"

