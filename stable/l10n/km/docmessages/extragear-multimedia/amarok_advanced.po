#: advanced.docbook:207
#, no-c-format
msgid "dcop amarok collection"
msgstr "សម្រាំង dcop amarok "

#. Tag: entry
#: advanced.docbook:214 advanced.docbook:280 advanced.docbook:580
#: advanced.docbook:681
#, no-c-format
msgid "DCOP Call"
msgstr "ហៅ DCOP "

#. Tag: entry
#: advanced.docbook:221
#, no-c-format
msgid "query"
msgstr "សំណួរ​"

#. Tag: entry
#: advanced.docbook:222
#, no-c-format
msgid ""
"The <quote>query</quote> call allows you to send direct database queries to "
"&amarok;'s collection."
msgstr ""
"ហៅ​ <quote> សំណរ <quote> "
"អនុញ្ញាត​ឲ្យ​អ្នក​ផ្ញើ​សំណួរមូលដ្ឋាន​ទិន្នន័យ​ផ្ទាល់​ទៅ​កាន់​សម្រាំង​&របស់ "
"marok; ។​"

#. Tag: entry
#: advanced.docbook:226
#, no-c-format
msgid "scanCollection"
msgstr "scanCollection"

#. Tag: entry
#: advanced.docbook:227
#, no-c-format
msgid ""
"The <quote>scanCollection</quote> call performs a manual scan of your "
"collection."
msgstr ""
"ការហៅ​ <quote> scanCollection </quote> "
"ដំណើរការ​វិភាគ​សៀវភៅដៃ​នៃ​សម្រាំង​របស់​អ្នក​ ។​"

#. Tag: entry
#: advanced.docbook:231
#, no-c-format
msgid "scanCollectionChanges"
msgstr "scanCollectionChanges"

#. Tag: entry
#: advanced.docbook:232
#, no-c-format
msgid ""
"The <quote>scanCollectionChanges</quote> call performs a manual scan for "
"changes to your collection."
msgstr ""
"ការហៅ​ <quote> scanCollectionChanges </quote> "
"ដំណើរការ​វិភាគ​សៀវភៅដៃ​សម្រាប់​ផ្លាស់ប្តូរសម្រាំង​របស់​អ្នក ។​"

#. Tag: entry
#: advanced.docbook:236
#, no-c-format
msgid "similarArtists"
msgstr "similarArtists"

#. Tag: entry
#: advanced.docbook:237
#, no-c-format
msgid ""
"The <quote>similarArtists</quote> call returns the similar artists of the "
"current track. Results are limited to an integer value of <quote>artists</quote>"
"."
msgstr ""
"ការហៅ​ <quote> similarArtists </quote> "
"ត្រឡប់​សិល្បករដែល​​ស្រដៀងគ្នា​នៃ​បទ​បច្ចុប្បន្ន​ ។ "
"លទ្ធផល​ត្រូវ​បានកំណត់​តម្លៃ​ជា​ចំនួន​គត់​នៃ​ <quote> សិល្បករ​ </quote>."

#. Tag: entry
#: advanced.docbook:241
#, no-c-format
msgid "totalAlbums"
msgstr "totalAlbums"

#. Tag: entry
#: advanced.docbook:242
#, no-c-format
msgid ""
"The <quote>totalAlbums</quote> call returns the total number of albums in your "
"collection."
msgstr ""
"ការហៅ  <quote> totalAlbums </quote> "
"ត្រឡប់​ចំនូន​សរុប​នៃ​អាល់ប៊ុម​ក្នុង​សម្រាំង​របស់អ្នក ។​"

#. Tag: entry
#: advanced.docbook:246
#, no-c-format
msgid "totalArtists"
msgstr "totalArtists"

#. Tag: entry
#: advanced.docbook:247
#, no-c-format
msgid ""
"The <quote>totalArtists</quote> call returns the total number of artists in "
