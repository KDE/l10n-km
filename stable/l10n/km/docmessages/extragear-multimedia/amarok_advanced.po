#, no-c-format
msgid "listRunningScripts"
msgstr ""

#. Tag: entry
#: advanced.docbook:689
#, no-c-format
msgid ""
"The <quote>listRunningScripts</quote> call will list all running &amarok; "
"scripts."
msgstr ""

#. Tag: entry
#: advanced.docbook:693
#, no-c-format
msgid "runScript"
msgstr ""

#. Tag: entry
#: advanced.docbook:694
#, no-c-format
msgid ""
"The <quote>runScript</quote> call will start an &amarok; script specified by "
"it's name."
msgstr ""

#. Tag: entry
#: advanced.docbook:698
#, no-c-format
msgid "stopScript"
msgstr ""

#. Tag: entry
#: advanced.docbook:699
#, no-c-format
msgid ""
"The <quote>stopScript</quote> call will stop an &amarok; script specified by "
"it's name."
msgstr ""

#. Tag: entry
#: advanced.docbook:703
#, no-c-format
msgid "addCustomMenuItem"
msgstr ""

#. Tag: entry
#: advanced.docbook:704
#, no-c-format
msgid ""
"The <quote>addCustomMenuItem</quote> call adds a menu item to the playlist "
"context menu. This call takes two QStrings, the first for the submenu title, "
"the second for the item's title in the submenu. Both QStrings are returned in "
"the script manager notification system."
msgstr ""

#. Tag: entry
#: advanced.docbook:708
#, no-c-format
msgid "removeCustomMenuItem"
msgstr ""

#. Tag: entry
#: advanced.docbook:709
#, no-c-format
msgid ""
"The <quote>removeCustomMenuItem</quote> call removes menu items added to the "
"playlist context menu using the addCustomMenuItem call. This call uses the same "
"QStrings as addCustomMenuItem."
msgstr ""

