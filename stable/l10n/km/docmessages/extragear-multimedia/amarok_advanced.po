#. Tag: entry
#: advanced.docbook:221
#, no-c-format
msgid "query"
msgstr ""

#. Tag: entry
#: advanced.docbook:222
#, no-c-format
msgid ""
"The <quote>query</quote> call allows you to send direct database queries to "
"&amarok;'s collection."
msgstr ""

#. Tag: entry
#: advanced.docbook:226
#, no-c-format
msgid "scanCollection"
msgstr ""

#. Tag: entry
#: advanced.docbook:227
#, no-c-format
msgid ""
"The <quote>scanCollection</quote> call performs a manual scan of your "
"collection."
msgstr ""

#. Tag: entry
#: advanced.docbook:231
#, no-c-format
msgid "scanCollectionChanges"
msgstr ""

#. Tag: entry
#: advanced.docbook:232
#, no-c-format
msgid ""
"The <quote>scanCollectionChanges</quote> call performs a manual scan for "
"changes to your collection."
msgstr ""

