#: advanced.docbook:236
#, no-c-format
msgid "similarArtists"
msgstr ""

#. Tag: entry
#: advanced.docbook:237
#, no-c-format
msgid ""
"The <quote>similarArtists</quote> call returns the similar artists of the "
"current track. Results are limited to an integer value of <quote>artists</quote>"
"."
msgstr ""

