#: advanced.docbook:241
#, no-c-format
msgid "totalAlbums"
msgstr ""

#. Tag: entry
#: advanced.docbook:242
#, no-c-format
msgid ""
"The <quote>totalAlbums</quote> call returns the total number of albums in your "
"collection."
msgstr ""

#. Tag: entry
#: advanced.docbook:246
#, no-c-format
msgid "totalArtists"
msgstr ""

#. Tag: entry
#: advanced.docbook:247
#, no-c-format
msgid ""
"The <quote>totalArtists</quote> call returns the total number of artists in "
"your collection."
msgstr ""

