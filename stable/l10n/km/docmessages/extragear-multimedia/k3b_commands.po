#. Tag: title
#: commands.docbook:7
#, no-c-format
msgid "The Menu Entries"
msgstr "ធាតុ​ម៉ឺនុយ​"

#. Tag: title
#: commands.docbook:10
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ឯកសារ</guimenu> "

#. Tag: menuchoice
#: commands.docbook:15
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap> </keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New Project</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>N</keycap> "
"</keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>គម្រោងថ្មី</guimenuitem>"

#. Tag: para
#: commands.docbook:25
#, no-c-format
msgid ""
"<action>Creates a new project.</action> You have to choose the project type "
"(Audio CD, Data DVD, ...)."
msgstr "<action>បង្កើត​គម្រោង​ថ្មី​</action> "
"អ្នក​បាន​ជ្រើស​ប្រភេទ​គម្រោង​(ស៊ីឌីអូឌីយ៉ូ ឌីវីឌី​ទិន្នន័យ...) ។​"

#. Tag: menuchoice
#: commands.docbook:33
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap> </keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>O</keycap> "
"</keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>បើក​...</guimenuitem>"

#. Tag: para
#: commands.docbook:43
#, no-c-format
msgid ""
"<action>Opens an existing project</action> which can be selected with KDE's "
"Open File dialog."
msgstr "<action>ប្រើគម្រោង​មាន​រួចហើយ​</action>ដែល​អាច​ជ្រើស​ជាមួយ​ប្រអប់​បើក​​​"
"ឯកសារ​របស់​ KDE បាន​។​"

#. Tag: menuchoice
#: commands.docbook:51
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap> </keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>R</keycap> "
"</keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>បើក​ថ្មីៗនេះ</guimenuitem>"

#. Tag: para
#: commands.docbook:61
#, no-c-format
msgid ""
"This is a shortcut to <action>re-open recently opened projects</action>"
". The sub-menu belonging to this item contains a list of these projects, "
"clicking on a specific file will open it again."
msgstr "នេះជា​ផ្លូវ​កាត់​សម្រាប់​<action>បើក​គម្រោង​ដែល​បាន​បើក​ថ្មីៗនេះ​ម្តង​ទៀត​</"
"action> ។ \n"
""
"ម៉ឺនុយ​រងជាកម្មសិទ្ធ​សម្រាប់​ធាតុ​នេះ​ដែល​មាន​បញ្ជី​នៃ​គម្រោង៿៿៿៿៿៿៿ទាំងនេះ​"
" ចុច​លើឯកសារ​ជាក់លាក់​មួយ​នឹង​បើក​វា​ម្តង​ទៀត​ ។​"

#. Tag: menuchoice
#: commands.docbook:71
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap> </keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>S</keycap> "
"</keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>រក្សាទុក​</guimenuitem>"

#. Tag: para
#: commands.docbook:81
#, no-c-format
msgid ""
"<action>Saves the current project.</action> If there has already been a save of "
"the document then this will overwrite the previously saved file without asking "
"for the user's consent. If it is the first save of a new document the Save As "
"dialog will be invoked."
msgstr "<action>រក្សាគម្រោង​បច្ចុប្បន្ន​ទុក​​ ។</action> "
"បើ​ឯកសារ​បាន​រក្សាទុក​រួចរាល់ហើយ​ "
"បន្ទាប់មក​ការរក្សាទុក​នេះ​នឹង​សរសេរជាន់ពីលើ​ឯកសារ​ដែល​បានរក្សាទុក​ពីមុន​ "
"ដោយ​ពុំចាំបាច់ស្នើរការយល់ព្រម​របស់អ្នកប្រើ​ ។ "
"បើ​វា​ជា​ឯកសារ​ថ្មី​ហើយ​រក្សាទុកជា​លើក​​ដំបូង​គេ​ "
"ប្រអប់​រករក្សាទុកជា​នឹង​ត្រូវ​បានហៅ​យក​មក​ប្រើ​​។​"

#. Tag: menuchoice
#: commands.docbook:92
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>រក្សាទុកជា...</guimenuitem>"

#. Tag: para
#: commands.docbook:98
#, no-c-format
msgid ""
"<action>Saves the current project with a new file name.</action> "
"KDE's Save As dialog appears to specify name and directory of the new project "
"file."
msgstr "<action>រក្សាគម្រោង​បច្ចុប្បន្ន​ទុក​ជាមួយ​ឈ្មោះ​ឯកសារ​ថ្មី​មួយ ។</action> "
""
"ប្រអប់​រក្សាទុកជា​របស់​ ​KDE លេចឡើង​ដើម្បី​បញ្ជាក់​ឈ្មោះ "
"និង​ថត​នៃ​ឯកសារ​គម្រោង​ថ្មី ។"

#. Tag: menuchoice
#: commands.docbook:107
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap> </keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>C</keycap> "
"</keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>បិទ​</guimenuitem>"

#. Tag: para
#: commands.docbook:117
#, no-c-format
msgid ""
"<action>Closes the current project.</action> If a project has been modified but "
"not yet saved then &k3b; will ask what to do. You can choose to save or discard "
"the changes, and you also have the opportunity to cancel closing and keep the "
"project open."
msgstr "<action>បិទ​គម្រោង​បច្ចុប្បន្ន​ ។</action> បើ​គម្រោង​ត្រូវ​បាន​កែប្រែ​ "
"ប៉ុន្តែ​មិនទាន់​បាន​រក្សាទុក​ K3b នឹង​\n"
"ស្នើរអ្វី​ដែល​ត្រូវ​ធ្វើ ។​ អ្នកអាច​ជ្រើស​ដើម្បីរក្សាទុក​ "
"ឬ​បោះបង់ចោល​ការផ្លាស់ប្តូរ​ ហើយ​អ្នកក៏​អាច​មាន​\n"
"ឱកាសបោះបង់ចោល​ និង​​រក្សាបើក​គម្រោង​នៅ​ដដែល​ ។​"

#. Tag: menuchoice
#: commands.docbook:129
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap> </keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>Q</keycap> "
"</keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>បោះបង់​</guimenuitem>"

#. Tag: para
#: commands.docbook:139
#, no-c-format
msgid ""
"<action>Quits &k3b;</action> after closing all of its open projects. For every "
"unsaved project &k3b; will ask what to do, just like it does when <menuchoice> "
"<guimenu>File</guimenu> <guimenuitem>Close</guimenuitem> </menuchoice> "
"is selected."
msgstr "<action>បោះបង់​"
" "
""
"K3b</action> បន្ទាប់​ពី​បិទ​គម្រោង​បើករបស់​វា​ទាំងអស់​ ។ "
"ចំពោះ​គម្រោង​និមួយៗ​ដែល​មិនទាន់​បាន​រក្សាទុក​​ K3b "
"នឹង​ស្នើរ​អ្វី​ដែល​ត្រូវ​ធ្វើ ។ "
"ដូចជា​វា​ធ្វើការ​ពេល​វាបាន​ជ្រើស​<menuchoice> <guimenu>​ឯកសារ​</guimenu> "
"<guimenuitem>បិទ</guimenuitem> </menuchoice> ។"

#. Tag: title
#: commands.docbook:156
#, no-c-format
msgid "The <guimenu>Project</guimenu> Menu"
msgstr "ម៉ឺនុយ<guimenu>គម្រោង</guimenu>"

#. Tag: menuchoice
#: commands.docbook:161
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Add Files...</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>បន្ថែម​ឯកសារ​...</guimenuitem>"

#. Tag: para
#: commands.docbook:167
#, no-c-format
msgid ""
"When this item is selected, the appearing dialog <action>"
"lets you choose one or more files to be added to the project.</action> "
"This has the same effect as dragging files directly from the Contents View into "
"the Project View. If the current project is a data disc project, the added "
"files will appear in the disc's root directory."
msgstr "ពេល​ជ្រើស​ធាតុ​នេះ​ "
"មាន​ប្រអប់​មួយ​កំពុង​លេចឡើង<action>អនុញ្ញាត​ឲ្យ​អ្នកជ្រើសឯកសារ​មួយ "
"ឬច្រើន​ដែល​បាន​បន្ថែម​ទៅ​ក្នុង​គម្រោង​ ។ </action> "
"ការបន្ថែម​នេះ​មាន​ប្រសិទ្ធភាព​ដូច​ការអូស​ឯកសារ​ដោយ​\n"
""
"ផ្ទាល់​ពី​ទិដ្ឋភាព​មាតិកា​​នៅ​ក្នុង​ទិដ្ឋភាព​គម្រោង​ ។ "
"បើ​គម្រោង​បច្ចុប្បន្ន​ជា​គម្រោង​ឌីស​ទិន្នន័យ​ "
"ឯកសារ​ដែល​ត្រូវ​បាន​បន្ថែម​នឹង​លេច​ឡើង​ក្នុង​ថត​ root របស់​ឌីស ។​"

#. Tag: menuchoice
#: commands.docbook:179
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Clear Project</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>ជម្រះ​ជម្រើស​</guimenuitem>"

#. Tag: para
#: commands.docbook:185
#, no-c-format
msgid ""
"<action>Removes all files and directories from the current project.</action> "
"The project itself remains open."
msgstr "<action>យក​ឯកសារ​ និង​ថត​ទាំងអស់​ចេញ​ពី​គម្រោង​ ។</action> "
"បើក​គម្រោងដោយ​ខ្លួន​វា​ ។​"

#. Tag: menuchoice
#: commands.docbook:194
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap> </keycombo> "
"</shortcut> <guimenu>Project</guimenu> <guimenuitem>Burn...</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>B</keycap> "
"</keycombo> </shortcut> <guimenu>គម្រោង​</guimenu> "
"<guimenuitem>ដុត​...</guimenuitem>"

#. Tag: para
#: commands.docbook:204
#, no-c-format
msgid ""
"<action>Opens the Burn dialog</action> which is in fact the same as the "
"Properties dialog. The only difference is that there is an additional Burn "
"button which causes &k3b; to burn a disc from project data. The Burn dialog "
"won't open if the project does not contain any files."
msgstr "<action>បើក​ប្រអប់​ដុត​</action> វា​ពិត​ជាដូច​ប្រអប់​លក្ខណៈសម្បត្តិ​ ។ "
"មាន​តែ​ភាព​ខុសគ្នា​នៃ​ការបន្ថែម​\n"
"ប៊ូតុង​ដុត​ដែល​បណ្តាល​ឲ្យ​​ K3b ដុត​ឌីស​ពី​គម្រោង​ទិន្នន័យ ។ "
""
"ប្រអប់​ដុត​នឹង​មិន​បាន​បើក​ បើ​គម្រោង​មិន​\n"
"ទាន់​មាន​ឯកសារ​​ ។​"

#. Tag: menuchoice
#: commands.docbook:215
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap> </keycombo> "
"</shortcut> <guimenu>Project</guimenu> <guimenuitem>Properties...</guimenuitem>"
msgstr "<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>P</keycap> "
"</keycombo> "
""
"</shortcut> <guimenu>គម្រោង​</guimenu> "
"<guimenuitem>លក្ខណៈសម្បត្តិ​...</guimenuitem>"

#. Tag: para
#: commands.docbook:225
#, no-c-format
msgid ""
"<action>Opens the Properties dialog.</action> Here you can specify a lot of "
"options concerning the project. Every project type has got a different set of "
"options, most of them can be explained by using What's This (accessible by "
"right-mouse-clicking)."
msgstr "<action>បើក​ប្រអប់​លក្ខណៈសម្បត្តិ​​ ។</action> "
""
"ទីនេះ​អ្នកអាច​បញ្ជាក់​ជម្រើសគម្រោ​ង​ដែលទាក់ទង​ជាច្រើន​ ។ "
"ប្រភេទ​គម្រោង​និមួយៗ​មាន​ការកំណត់​ជម្រើស​ខុសៗគ្នា "
"ហើយ​ពួកវា​ភាគច្រើន​អាច​ពន្យល់​តាម​\n"
"ការប្រើ​ នេះ​ជា​អ្វី (អាច​ចូល​ដំណើរការ​ តាម​ការចុច​កណ្តុ​រ​ស្តាំ) ។​"

#. Tag: menuchoice
#: commands.docbook:236
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Import Session</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>នាំចូល​សម័យ</guimenuitem>"

#. Tag: para
#: commands.docbook:242
#, no-c-format
msgid ""
"This Item only appears if a Data CD/DVD or Video DVD project is active. It "
"causes K3b to <action>import the file entries from the previous session to the "
"current project</action>. You can use this when compiling files for "
"multi-session discs. Hence that data from the previous session is always "
"included, even if you don't choose to make use of this command. It just helps "
"to know what's on the disc already."
msgstr "ធាតុ​នេះ​បានតែ​លេចឡើង បើគម្រោង​​ស៊ីឌី ឬ ឌីវីឌី​ទិន្នន័យ "
""
"ឬវីដេអូ​សកម្ម​ ។ វា​ធ្វើ​​ឲ្យ​ K3b \n"
"<action>នាំចូល​ធាតុ​ឯកសារ​ពី​សម័យ​មុន​ទៅ​កាន់​គម្រោង​បច្ចុប្បន្ន​</action> "
"។​ អ្នកអាច​ប្រើ​ការនេះ​ពេល​\n"
"កំពុងចងក្រង​ឯកសារ​សម្រាប់​ពហុ​សម័យ​ឌីស​​ ។ "
"ហេតុ​នេះ​ហើយ​ទិន្នន័យ​ដែល​បាន​មក​ពី​សម័យ​មុន​ត្រូវ​\n"
"បាន​រូមបញ្ចូល​ជា​និច្ច​ "
"ប្រសិន​បើ​អ្នក​មិន​ទាន់បាន​ជ្រើស​ប្រើ​ពាក្យ​បញ្ជា​នេះ ។ "
"វា​គ្រាន់​តែ​ជួយ​អ្នក​ដើម្បី​ស្គាល់​អ្វី​ដែល​មាន​នៅ​លើ​ឌីស​រួចហើយ​ ។​"

#. Tag: menuchoice
#: commands.docbook:255
#, no-c-format
msgid ""
"<guimenu>Project</guimenu> <guimenuitem>Clear Imported Session</guimenuitem>"
msgstr ""
"<guimenu>គម្រោង​</guimenu> "
"<guimenuitem>ជម្រះ​សម័យ​ដែល​បាន​នាំចូល</guimenuitem>"

#. Tag: para
#: commands.docbook:261
#, no-c-format
msgid ""
"This Item only appears if a Data CD/DVD or Video DVD project is active. It "
"causes K3b to <action>remove the file entries from the current project that "
"were imported</action> by <menuchoice> <guimenu>Project</guimenu> <guimenuitem>"
"Import Session</guimenuitem> </menuchoice> while keeping all of the other data "
"in the project. Hence that making use of this command doesn't actually remove "
"anything from the disc that will be burned, it just hides these files again."
msgstr "ធាតុ​នេះ​បានតែ​លេចឡើង បើគម្រោង​​ស៊ីឌី ឬ ឌីវីឌី​ទិន្នន័យ "
"ឬវីដេអូ​សកម្ម​ ។ វា​ធ្វើ​ឲ្យ​ K3b <action>យក​ធាតុ​ឯកសារ​ចេញ​ពី​គម្រ"
"ោង​បច្ចុប្បន្ន​​ដែល​ត្រូវ​បាន​នាំចូល​</action> តាម​ <menuchoice> <guimenu>\n"
"គម្រោង​</guimenu> <guimenuitem>នាំចូល​សម័យ​</guimenuitem> </menuchoice> "
"ខណៈពេល​កំពុង​\n"
"រក្សាទុក​ទិន្នន័យផ្សេងទៀត​ទាំងអស់ក្នុង​គម្រោង​ ។ ហេតុដូចនេះ​ ការប្រើ​ពាក្យបញ"
"្ជា​នេះ​ពិត​ជា​មិន​អាច​យក​អ្វី​ចេញ​ពី​ឌីស​ដែល​ត្រូវ​បាន​ដុត​ឡើយ "
"វា​គ្រាន់​តែលាក់​ឯកសារ​ទាំងនេះ​ម្តង​ទៀត ។"

#. Tag: menuchoice
#: commands.docbook:277
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Edit Boot Images</guimenuitem>"
msgstr ""
"<guimenu>គម្រោង​</guimenu> "
"<guimenuitem>កែសម្រួល​រូបភាព​ចាប់​ផ្តើម​ឡើង</guimenuitem>"

#. Tag: para
#: commands.docbook:283
#, no-c-format
msgid ""
"This Item only appears if a Data CD/DVD or Video DVD project is active. <action>"
"Here you can specify boot images</action> in order to create bootable CDs or "
"DVDs. A boot image can be a direct copy of a floppy or hard disk (for example, "
"created by the dd shell command) as well as another disc's boot image. In any "
"case it's a single file containing a complete, bootable system that is burned "
"as a normal file. In order to let the computer know that the disc contains a "
"boot image, the burning application creates a boot catalog file whose name can "
"be determined in the dialog window."
msgstr "ធាតុ​នេះ​បានតែ​លេចឡើង បើគម្រោង​​ស៊ីឌី ឬ ឌីវីឌី​ទិន្នន័យ "
"ឬវីដេអូ​សកម្ម​ ។ "
""
"<action> ទីនេះ​អ្នកអាច​បញ្ជាក់\n"
"រូបភាព​ចាប់ផ្តើម​</action> "
"ក្នុងគោល​បំណង​បង្កើតតារាង​ចាប់ផ្តើម​ស៊ីឌី ឬ​ឌីវីឌី​ ។\n"
"រូបភាព​ចាប់ផ្តើមឡើង​អាច​ចម្លង​ដោយ​ផ្ទាល់​ទៅកាន់​ថត​ ឬ​ថាសរឹង\n"
"(ឧទាហរណ៍​ បង្កើត​សែល​ពាក្យបញ្ជា dd) "
"ក៏​ដូច​រូបភាព​ចាប់ផ្តើម​ឡើង​របស់ឌីស​ផ្សេងទៀត​ដែរ។ \n"
""
"មាន​ច្រើន​ករណី​ ឯកសារ​មួយ​មាន​​ប្រព័ន្ធ​តារាងចាប់ផ្តើម​ទាំងស្រុង​ដែលត្រូវ​"
"បាន​ដុត​ជា​ឯកសារ​ធម្មតា​។\n"
"ក្នុង​គោល​បំណង​អនុញ្ញាត​ឲ្យ​កុំព្យូទ័រ​ស្គាល់​ឌីស​ដែល​មាន​រូបភាព​ចាប់ផ្តើម​​"
" ការដុត​កម្មវិធី​បង្កើត​ឯកសារ​\n"
"កាតាឡុក​ ហើយ​ឈ្មោះ​អាចបញ្ជាក់​ក្នុង​ប្រអប់​បង្អួច​ ។​"

#. Tag: title
#: commands.docbook:303
#, no-c-format
msgid "The <guimenu>Plugin</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>កម្មវិធីជំនួយ</guimenu>"

#. Tag: menuchoice
#: commands.docbook:308
#, no-c-format
msgid ""
"<guimenu>Plugins</guimenu> <guimenuitem>Rename Audio Files...</guimenuitem>"
msgstr ""
"<guimenu>កម្មវិធី​ជំនួយ</guimenu> "
"<guimenuitem>ប្តូរ​ឈ្មោះ​ឯកសារ​អូឌីយ៉ូ...</guimenuitem>"

#. Tag: para
#: commands.docbook:314
#, no-c-format
msgid ""
"Allows you to <action>rename audio files</action> in a data project using their "
"meta information. The new file names are defined by patterns containing "
"information like title or artist name."
msgstr "អនុញ្ញាត​ឲ្យ​អ្នក​ <action>ប្តូរ​ឈ្មោះ​ឯកសារអូឌីយ៉ូ​</action> "
"ក្នុង​គម្រោង​ទិន្នន័យ​ប្រើ​ព័ត៌មាន​មេតា​របស់​ពួក​គេ​ ។ "
"ឈ្មោះ​ឯកសារ​ថ្មី​ត្រូវ​បាន​កំណត់​តាម​លំនាំ​ដែលមាន​ព័ត៌មាន​ដូចជា​ ចំណងជើង "
"ឬ​ឈ្មោះ​សិល្បករ​​ ។​"

#. Tag: title
#: commands.docbook:328
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ឧបករណ៍</guimenu>"

#. Tag: menuchoice
#: commands.docbook:333
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>CD</guisubmenu>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guisubmenu>ស៊ីឌី</guisubmenu>"

#. Tag: para
#: commands.docbook:339
#, no-c-format
msgid "Contains a number of tools to handle CDs:"
msgstr "ឧបករណ៍​មាន​ចំនួន​ច្រើន​សម្រាប់​ដោះស្រាយ​ស៊ីឌី ។​"

#. Tag: menuchoice
#: commands.docbook:346
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>CD</guisubmenu> <guimenuitem>"
"Copy CD...</guimenuitem>"
msgstr "<guimenu></guimenu> <guisubmenu>ស៊ីឌី</guisubmenu> "
"<guimenuitem>ចម្លង​ស៊ីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:353
#, no-c-format
msgid ""
"<action>Opens the CD Copy dialog.</action> Without the need of a project file, "
"it provides the ability to copy a CD's content to another disc. Alternatively, "
"you can choose only to create an image of the source CD which can be burned "
"anytime. There is also an option to clone the CD instead of normal copying, "
"which should be preferred when copying CDs with defective sectors or Video CDs."
msgstr "<action>បើក​ប្រអប់ចម្លង​ស៊ីឌី​ ។​</action> "
"ដោយ​ពុំចាំបាច់​ត្រូ​វ​ការ​ឯកសារ​គម្រោង​ វា​ផ្តល់​នូវសមត្ថភាព​\n"
"សម្រាប់​ចម្លង​មាតិកា​របស់ស៊ីឌី​ទៅ​កាន់​ឌីស​ផ្សេងទៀត ។ "
"អ្នកអាច​ជ្រើស​បាន​តែការ​បង្កើត​រូបភាព​នៃ​ស៊ីឌី​\n"
""
"ប្រភពដែល​អាច​ដុត​ពេល​ណា​ក៏​បាន​ដែរ​ ។ មានជម្រើស​សម្រាប់ក្លូន​​ស៊ីឌី​ជំនួស​កា"
"រចម្លង​ធម្មតា​ត្រូវ​បាន​ទទួល​បាន​ការគាំទ្រ​​ពេល​កំពុង​ចម្លង​ស៊ីឌី​ដែល​មានភាគ"
"​មិន​ពេញលេញ​ ឬ​ស៊ីឌីវីដេអូ ។​"

#. Tag: menuchoice
#: commands.docbook:367
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>CD</guisubmenu> <guimenuitem>"
"Erase CD-RW...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guisubmenu>ស៊ីឌី</guisubmenu> "
"<guimenuitem>លុប​ស៊ីឌី-អាន\n"
"សរសេរ​...</guimenuitem>"

#. Tag: para
#: commands.docbook:374
#, no-c-format
msgid ""
"<action>Opens the Erase CD-RW dialog.</action> With its help you can clear the "
"contents of a CD-RW, or part of it."
msgstr ""
""
"<action>បើក​ប្រអប់​លុបស៊ីឌី​-អានសរសេរ​​ ។</action> "
"ជាមួយ​ជំនួយ​របស់វា​អ្នកអាច​ជម្រះ​មាតិកា​នៃ​ស៊ីឌី​-អានសរសេរ​ "
"ឬ​ផ្នែក​មួយ​នៃ​វា​ ។​"

#. Tag: menuchoice
#: commands.docbook:383
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>CD</guisubmenu> <guimenuitem>"
"Burn CD Image...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guisubmenu>ស៊ីឌី</guisubmenu> "
"<guimenuitem>ដុតរូបភាព​ស៊ីឌី​...</guimenuitem>"

#. Tag: para
#: commands.docbook:390
#, no-c-format
msgid ""
"<action>Burns a previously created CD image.</action> "
"The Burn CD Image dialog asks to select an <literal role=\"extension\">"
"*.iso</literal>, <literal role=\"extension\">*.cue</literal> "
"or <literal role=\"extension\">*.toc</literal> file as data source that you can "
"instantly burn by pressing the Start button. (Nero <literal role=\"extension\">"
"*.nrg</literal> files are currently not supported, so you have to make use of "
"other tools like <ulink "
"url=\"http://gregory.kokanosky.free.fr/v4/linux/nrg2iso.en.html\"> <application>"
"Nrg2Iso</application></ulink>.)"
msgstr "<action>ដុតរូបភាព​ស៊ីឌី​ដែល​បានបង្កើត​ពីមុនមក​​"
" "
"។</action> ប្រអប់​ដុត​រូបភាព​ស៊ីឌី​ស្នើ​ឲ្យ​ជ្រើសឯកសារ<literal "
"role=\"extension\">*.iso</literal>, <literal role=\"extension\">*.cue</literal> "
"ឬ <literal role=\"extension\">*.toc</literal> "
""
"ជា​ប្រភព​ទិន្នន័យ​ដែល​អ្នក​អាចដុត​ភ្លាម​ៗ​តាម​ការចុច​ប៊ូតុង​ចាប់ផ្តើម​ ។ \n"
"ឯកសារ (Nero <literal role=\"extension\">*.nrg</literal> "
"បច្ចុប្បន្ន​មិន​ត្រូវ​បាន​គាំទ្រ​ ដូច្នេះអ្នក​អាច​ប្រើ\n"
"​ឧបករណ៍​ផ្សេងទៀតដូចជា​​ <ulink "
"url=\"http://gregory.kokanosky.free.fr/v4/linux/nrg2iso.en.html\"> "
"<application>Nrg2Iso</application></ulink>.)"

#. Tag: menuchoice
#: commands.docbook:417
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>DVD</guisubmenu>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guisubmenu>ឌីវីឌី</guisubmenu>"

#. Tag: para
#: commands.docbook:423
#, no-c-format
msgid "Contains a number of tools to handle DVDs:"
msgstr "ឧបករណ៍​មាន​ចំនួន​ច្រើន​សម្រាប់​ដោះស្រាយ​ឌីវីឌី ៖"

#. Tag: menuchoice
#: commands.docbook:430
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>DVD</guisubmenu> <guimenuitem>"
"Copy DVD...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guisubmenu>ឌីវីឌី</guisubmenu> <guimenuitem>\n"
"ចម្លង​ឌីវីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:437
#, no-c-format
msgid ""
"<action>Opens the DVD Copy dialog.</action> Without the need of a project file, "
"it provides the ability to copy a DVD's content to another disc. Alternatively, "
"you can choose only to create an image of the source DVD which can be burned "
"anytime. Currently, video transcoding within the DVD Copy dialog is not yet "
"supported, so the destination disc has to be large enough to contain all of the "
"source disc's (video) data in its original form."
msgstr "<action>បើក​ប្រអប់​ចម្លង​ឌីវីឌី​ ។</action> ដោយ​មិន​ត្រូវ​ការ​ឯកសារ​គម្រោង​ "
"វា​ផ្តល់​នូវ​សមត្ថភាព​ចម្លង​\n"
"មាតិការបស់ឌីវីឌី​ទៅ​កាន់ឌីស​ផ្សេងទៀត​ ។ "
"អ្នកអាច​ជ្រើស​តែ​បង្កើត​រូបភាព​នៃ​ប្រភព​ឌីវីឌី​ដែល​អាច​ដុត​ពេលណា​ក៏​បាន​ ។ "
"បច្ចុប្បន្ននេះ "
""
"ការផ្ទេរ​កូដ​ក្នុង​ប្រអប់​ចម្លង​ឌីវីឌីមិន​ទាន់​គាំទ្រ​នូវឡើយ​ទេ​ "
"ដូច្នេះទិសដៅ​​ឌីស​មានទំហំ​គ្រប់គ្រាន់​សម្រាប់​ទិន្នន័យ​(វីដេអូ​) "
"ឌីសប្រភព​ទាំងអស់​ក្នុងសំណុំបែបបទ​ដើម​របស់វា​​ ។​"

#. Tag: menuchoice
#: commands.docbook:452
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>DVD</guisubmenu> <guimenuitem>"
"Format DVD-RW/DVD+RW...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guisubmenu>ឌីវីឌី​</guisubmenu> "
""
"<guimenuitem>ទ្រង់ទ្រាយ​ ឌីវីឌី​-\n"
"អានសរសេរ​ "
"ឬឌីវីឌី​+អានសរសេរ...</guimenuitem>"

#. Tag: para
#: commands.docbook:459
#, no-c-format
msgid ""
"<action>Opens the DVD Formatting dialog.</action> With its help you can format "
"a DVD-R(W) or DVD+R(W), which causes the disc's contents to be deleted. &k3b; "
"gives the choice between 2 writing modes."
msgstr "<action>បើក​ប្រអប់​ការធ្វើទ្រង់ទ្រាយ​ឌីវីឌី ។</action> "
"ជាមួយជំនួយ​របស់វា​អ្នកអាច​​​ធ្វើទ្រង់ទ្រាយ​ ឌីវីឌី-អាន(សរសេរ) ឬ "
""
"ឌីវីឌី+អាន(សរសេរ) ជាហេតុ​បណ្តាល​ឲ្យ​មាតិកា​របស់ឌីស​ត្រូវ​បានលុប​ ។ K3b "
"ផ្តល់នូវ​ជម្រើស​ពីរ​រវាង​រៀប​ការសរសេរ​​ ។​"

#. Tag: menuchoice
#: commands.docbook:469
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>CD</guisubmenu> <guimenuitem>"
"Burn DVD ISO Image...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guisubmenu>ស៊ីឌី</guisubmenu> "
""
"<guimenuitem>ដុតរូបភាព​ ISO \n"
"របស់ឌីវីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:476
#, no-c-format
msgid ""
"<action>Burns a previously created DVD image.</action> "
"The Burn Iso9660 Image dialog asks to select an <literal role=\"extension\">"
"*.iso</literal> file as data source that you can instantly burn by pressing the "
"Start button."
msgstr "<action>ដុត​រូបភាព​ឌីវីឌី​ដែល​បាន​បង្កើត​ពីមុនមក​ ។</action> ប្រអប់​ដុត​ "
"Iso9660 Image ស្នើ​ឲ្យ​ជ្រើស​ \n"
"ឯកសារ​<literal role=\"extension\">*.iso</literal> "
"ជា​ប្រភពទិន្នន័យ​ដែល​អ្នកអាច​ដុត​ភ្លាមៗ​តាម​ការចុច​ប៊ូតុង​ចាប់ផ្តើម​ ។​"

#. Tag: menuchoice
#: commands.docbook:496
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Encode Video...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guimenuitem>អ៊ិនកូដ​វីដេអូ...</guimenuitem>"

#. Tag: para
#: commands.docbook:502
#, no-c-format
msgid ""
"<action>A DVD video that has been ripped before can be encoded</action> "
"with a little help from the Encoding Video dialog. This dialog box normally "
"opens after ripping the DVD from within the Content View, but can also be used "
"standalone. It contains information about the ripped DVD video, encoding "
"options and even video resizing and cropping abilities."
msgstr "<action>ឌីវីឌីវីដេអូ​ដែលអ្នក​បាន​បម្លែង​ពីមុន អាច​អ៊ិនកូដ​បាន​ </action> "
"ដែលមាន​ជំនួយ​ចំណង​ជើង​ពី\n"
"​ប្រអប់​ការអ៊ិនកូដ​វីដេអូ ។​ "
"ប្រអប់​នេះ​បើក​ធម្មតា​បន្ទាប់​ពី​ការបម្លែង​ឌីវីឌី​ ពី​ទិដ្ឋភាព​មាតិកា​ "
"ប៉ុន្តែ​វា​ក៏​អាច​ត្រូ​វ​\n"
"បាន​ប្រើឈរតែឯង​ផងដែរ​។ "
"វា​មាន​ព័ត៌មាន​និយាយ​អំពី​ឌីវីឌី​វីដេអូ​ដែល​បាន​បម្លែង​ \n"
""
"ជម្រើស​ការអ៊ិនកូដ​ ហើយ​កំពុង​ប្តូរ​ទំហំ​វីដេអូ​ឡើងវិញ និង​សមត្ថភាព​ច្រឹប​​។"

#. Tag: title
#: commands.docbook:518
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ការកំណត់​</guimenu>"

#. Tag: menuchoice
#: commands.docbook:523
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Toolbars</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> <guimenuitem>របារឧបករណ៍​</guimenuitem>"

#. Tag: para
#: commands.docbook:529
#, no-c-format
msgid ""
"<action>Pops up a list of &k3b;'s toolbars.</action> "
"If a toolbar entry is checked, it means that the toolbar is currently visible."
msgstr "<action>បញ្ជី​នៃ​របារឧបករណ៍​របស់​ K3b លេចឡើង​ ។</action> "
"បើ​ធាតុ​របារឧបករណ៍​ត្រូវ​បានធីក​ វាមាន\n"
"ន័យ​ថារបារឧបករណ៍​បច្ចុប្បន្នអាច​មើលឃើញ ។​"

#. Tag: menuchoice
#: commands.docbook:538
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> <guimenuitem>បង្ហាញ "
"ឬ​លាក់​របារស្ថានភាព</guimenuitem>"

#. Tag: para
#: commands.docbook:544
#, no-c-format
msgid ""
"This enables you to <action>show or hide the small bar at the bottom of the "
"main window</action> containing various information about &k3b;'s status and "
"activities."
msgstr "ការនេះអនុញ្ញាត​ឲ្យ​អ្នក​<action>បង្ហាញ "
""
"ឬ​លាក់​របារ​តូច​នៅ​បាត​នៃ​បង្អួច​មេ​</action> "
"មានព័ត៌មានខុសៗគ្នា​អំពី​ស្ថានភាព និង​សកម្មភាព​របស់​ K3b ។"

#. Tag: menuchoice
#: commands.docbook:553
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show Project View</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> "
"<guimenuitem>បង្ហាញទិដ្ឋភាព​គម្រោង​</guimenuitem>"

#. Tag: para
#: commands.docbook:559
#, no-c-format
msgid ""
"<action>Toggles the visibility of the Project View.</action> "
"This contains information about the structure of the disc that you are "
"preparing to burn. Each project type has got a slightly different view, but "
"they all feature drag and drop functionality and a bar at the bottom that shows "
"how much space on the CD/DVD is already occupied and how much will be left."
msgstr "<action>បិទបើក​ទិដ្ឋភាព​គម្រោង​ដែល​អាច​មើលឃើញ​ ។</action> "
"មានព័ត៌មាន​​អំពីរចនាសម្ព័ន្ធ​នៃ​ឌីស​នេះ​ដែល​អ្នក​កំពុង​រៀបចំដុត ។ "
"រាល់ប្រភេទ​គម្រោ​ង​និមួយៗ​មាន​ទិដ្ឋភាពខុសគ្នា​បន្តិចបន្តួច ប៉ុន្តែ​\n"
"លក្ខណៈពិសេស​​ពួកវា​ទាំងអស់​អាច​អូស​ ហើយទម្លាក់​​មុខងារ​ "
""
"និង​របារ​នៅ​បាត​បង្ហាញ​ ថាតើ​ស៊ីឌី ឬ​ឌីវីឌី​មាន​ទំហំ​ប៉ុន្មានដែល​នៅ​សល់​ "
"និងទំហំ​ប៉ុន្មាន​ដែល​ត្រូវ​ចំណាយ ។​"

#. Tag: menuchoice
#: commands.docbook:572
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Directories</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> <guimenuitem>បង្ហាញ​ថត​</guimenuitem>"

#. Tag: para
#: commands.docbook:578
#, no-c-format
msgid ""
"<action>Toggles the visibility of the Directory View.</action> "
"This enables you to select directories and disc drives. When selected, their "
"contents will appear in the Contents view. Disc drives have also got a context "
"menu providing functions like Disk Info, (un)mounting the drive or ejecting the "
"medium."
msgstr "<action>បិទបើកទិដ្ឋភាព​​ថត​ដែល​អាច​មើល​ឃើញ</action> "
"ការអនុញ្ញាត​នេះ​អ្នកអាច​ជ្រើស​ថត​ និង​ដ្រាយ​\n"
"របស់ឌីស ។ នៅ​ពេល​ដែល​បានជ្រើស​ "
""
"មាតិការបស់​ពួកវា​នឹង​លេចឡើង​ក្នុង​ទិដ្ឋភាព​មាតិកា​។ "
"ដ្យាយ​ឌីស​​ក៏​អាច​ទៅ​កាន់​ម៉ឺនុយ​បរិបទផ្តល់​នូវ​មុខងារ ដូចជា​ព័ត៌មាន​ឌីស "
"កុំម៉ោន​ដ្រាយ ឬច្រាន​វា​ចោល​ ។​"

#. Tag: menuchoice
#: commands.docbook:589
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Contents</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> <guimenuitem>បង្ហាញ​មាតិកា​</guimenuitem>"

#. Tag: para
#: commands.docbook:595
#, no-c-format
msgid ""
"<action>Toggles the visibility of the Contents View.</action> "
"This enables you to select files that can be dragged into the Project View in "
"order to add them to the project. The Contents View also acts as an interface "
"to rip audio CDs and video discs when a disc drive containing an appropriate "
"CD/DVD is selected in the Directory View."
msgstr "<action>បិទបើក​ទិដ្ឋភាព​មាតិកា​ដែល​អាច​មើល​ឃើញ​ ។</action> "
"ការនេះ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​ឯកសារ​\n"
"ដែល​បានអូស​ទៅ​ក្នុង​ទិដ្ឋភាព​គម្រោង​ក្នុង​គោល​បំណង​បន្ថែម​ពួក​វា​ទៅ​ក្នុង​គម"
"្រោង​ ។ \n"
""
"ទិដ្ឋភាព​មាតិកា​ក៏​អាច​ជា​ចំណុច​ប្រទាក់​សម្រាប់​បម្លែង​ស៊ីឌីអូឌីយ៉ូ "
"និង​ឌីស​វីដេអូ ពេល​ដ្រាយរបស់​​ឌី​មាន​ស៊ីឌី​ ឬ "
"ឌីវីឌី​ដែលបានជ្រើស​ក្នុង​ទិដ្ឋភាព​ថត​ ។​"

#. Tag: menuchoice
#: commands.docbook:607
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show Document Header</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> <guimenuitem>បង្ហាញ​ក្បាល់ឯកសារ</guimenuitem>"

#. Tag: para
#: commands.docbook:613
#, no-c-format
msgid ""
"<action>Toggles the visibility of the document header</action> "
"belonging to the Project View. This is a small bar that is only visible if the "
"Project View contains any open projects. The document header has no "
"functionality, yet it's nice eye candy and improves clarity by separating the "
"Project View from the other views."
msgstr "<action>បិទបើក​ក្បាលឯកសារ​ដែល​អាច​មើល​ឃើញ</action> "
"ជា​ម្ចាស់​ទិដ្ឋភាពគម្រោង​​ ។ \n"
"នេះ​ជា​របារតូចមួយ​ដែល​អាច​បាន​តែ​មើល​ "
"បើ​ទិដ្ឋភាព​គម្រោង​បាន​បើក​គម្រោង​មួយទៀត​។ \n"
""
"ក្បាល​ឯកសារ​មិនទាន់​មាន​មុខងារ​នូវ​ឡើយ​ទេ វាមានលក្ខណៈត្រជាក់ភ្នែក​ និង​ធ្វើ​"
"ឲ្យ​មាន​ពន្លឺកាន់តែប្រសើរឡើង​​តាម​ការបំបែក​ទិដ្ឋភាព​គម្រោង​ទទួល​បានមក​ពី​ទិដ"
"្ឋភាពផ្សេងទៀត ។​"

#. Tag: menuchoice
#: commands.docbook:625
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> "
"<guimenuitem>កំណត់រចនាសម្ព័ន្ធ​ផ្លូវ​កាត់​...</guimenuitem>"

#. Tag: para
#: commands.docbook:631
#, no-c-format
msgid ""
"This command <action>opens a dialog box where the key bindings for &k3b;'s menu "
"commands may be changed</action>. After selecting one of the available commands "
"from the upper part of the dialog, the shortcut for this action can be changed "
"in the lower part."
msgstr "ពាក្យ​បញ្ជា​នេះ​<action>បើក​ប្រអប់​ទីតាំង​ការចង​គ្រាប់ចុចសម្រាប់​បញ្ជា​ម៉ឺនុ"
""
"យ​របស់​ K3b ពាក្យបញ្ជា​\n"
"​ប្រហែល​ជាត្រូវ​ផ្លាស់ប្តូរ​</action> ។ "
"បន្ទាប់​ពី​ជ្រើស​ពាក្យបញ្ជា​ពី​ផ្នែកខាងលើ​នៃ​ប្រអប់ "
"ហើយ​ផ្លូវកាត់​សម្រាប់អំពើរ​នេះ​"
"អាចផ្លាស់ប្តូរ​ក្នុង​ផ្នែក​ដែលទាបជាង​ ។​"

#. Tag: menuchoice
#: commands.docbook:642
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> "
"<guimenuitem>កំណត់​រចនាសម្ព័ន្ធ​របារឧបករណ៍...</guimenuitem>"

#. Tag: para
#: commands.docbook:648
#, no-c-format
msgid ""
"This command <action>opens a dialog box where the toolbars can be "
"customized</action>. The drop down box on top of the dialog determines which "
"toolbar can be edited at the moment. The Available Actions list on the left "
"contains all commands that can be added to the toolbar, the Current Actions "
"list on the right shows the ones that are already there. Items can be added by "
"selecting the appropriate command out of the Available Actions list and "
"pressing the right button to move it to the Current Actions list. Removing an "
"item works the other way round. The up and down buttons change the commands's "
"position within the toolbar."
msgstr "ពាក្យបញ្ជា​នេះ "
"<action>បើក​ប្រអប់​ទីតាំង​របារឧបករណ៍​អាច​ប្តូរ​តាម​បំណង​</action> ។\n"
"ប្រអប់ធ្លាក់​ចុះ​នៃ​ប្រអប់​របារ​ឧបករណ៍ជាក់លាក់​​អាច​កែសម្រួល​នាពេលឥឡូវ​នេ"
"ះ ។ \n"
"បញ្ជីអំពើរអាចរក​បាន​នៅ​ផ្នែកខាង​ឆ្វេង​មាន​ពាក្យបញ្ជាទាំងអស់​ដែល​ត្រូវ​បាន​បន"
"្ថែម​ទៅ​កាន់​របារឧបករណ៍ \n"
"បញ្ជីអំពើរ​បច្ចុប្បន្ន​នៅ​ផ្នែក​ខាងស្តាំ​បង្ហាញ​ពាក្យបញ្ជា​មួយ​ដែល​មានរួចហើយ"
"​នៅទី​នេះ។\n"
"បណ្តាធាតុ​ជាច្រើន​អាច​បន្ថែម​តាម​ការជ្រើស​ពាក្យ​បញ្ជា​ដែល​នៅ​ក្រៅ​បញ្ជី​អំពើ"
"​ ហើយ​ចុច​ប៊ូតុង​កណ្តុរ​ស្តាំ​លើ​បញ្ជី​អំពើរ​បច្ចុប្បន្ន​ ។ "
""
"យក​ធាតុការងារ​ចេញតាម​វិធី​ផ្សេងៗ ។ ប្រើ​ប៊ូតុងលើ​ "
"ក្រោម​ផ្លាស់ប្តូរ​ទីតាំង​របស់​ពាក្យ\n"
"បញ្ជា​ក្នុង​របារឧបករណ៍ ។​"

#. Tag: menuchoice
#: commands.docbook:666
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &k3b;...</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> <guimenuitem>កំណត់រចនាសម្ព័ន្ធ "
"K3b...</guimenuitem>"

#. Tag: para
#: commands.docbook:672
#, no-c-format
msgid ""
"<action>Opens the Options dialog</action> where general program settings can be "
"configured. Although most of &k3b;'s functionality should work out of the box, "
"this dialog allows to customize and fine-tune the program."
msgstr "<action>បើក​ប្រអប់​ជម្រើស​</action> "
"ការកំណត់​ទីតាំង​កម្មវិធីទូទៅ​អាច​ត្រូវ​បាន​កំណត់រចនាសម្ព័ន្ធ​ ។ \n"
"ទោះបីជា​មុខងារ​របស់​ K3b ជាច្រើន​គូរតែ​ធ្វើការ​ក្រៅប្រអប់ "
""
"ប្រអប់នេះអនុញ្ញាត​ឲ្យ​ប្តូរ​កម្មវិធី​តាម​បំណង​ \n"
"ហើយ​ធ្វើ​ឲ្យ​ប្រសើរ​ ។​"

#. Tag: menuchoice
#: commands.docbook:683
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>&k3b; Setup...</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> <guimenuitem> ការរៀបចំ K3b...</guimenuitem>"

#. Tag: para
#: commands.docbook:689
#, no-c-format
msgid ""
"This <action>opens &k3bsetup;</action> which helps setting the right "
"permissions needed by &k3b; in order to burn CDs and DVDs. Linux' user rights "
"management permits program execution and access to disc drives if no "
"permissions have been granted by the administrator. &k3bsetup; cannot set "
"permissions without administrator privileges, so you have to enter the root "
"password when starting up."
msgstr ""
"បើក​ការរៀបចំ​ <action>K3b</action> ជួយ​ការកំណត់សិទ្ធ​ដែល​ត្រូវការ​ដោយ​ K3b "
"ក្នុង​គោល​បំណង​ដុត​\n"
"ស៊ីឌី និង​ឌីវីឌី​ ។ "
"ការគ្រប់គ្រង​សិទ្ធ​អ្នក​ប្រើ​របស់លីនុយ​អនុញ្ញាត​ឲ្យ​ប្រត្តិបតិ "
""
"និង​​ចូល​ដំណើរការ​កម្មវិធី​ទៅ​កាន់​ដ្រាយឌីស​ "
"បើ​គ្មាន​សិទ្ធ​ត្រូវ​បានផ្តល់​ឲ្យ​ដោយអ្នក​គ្រប់គ្រង​ជាន់ខ្ពស់ ។ ការ​រៀបចំ​ "
"K3b មិនអាច​កំណត់​សិទ្ធ​ដោយ​គ្មាន​សិទ្ធ​ជា​អ្នកគ្រប់គ្រង​ជាន់ខ្ពស់ឡើង "
"ដូច្នេះអ្នក​អាច​បញ្ជូល​ពាក្យសម្ងាត់​ root ពេល​កំពុង​ចាប់ផ្តើម​​។​"

