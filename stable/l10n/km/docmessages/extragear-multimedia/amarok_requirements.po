#. Tag: title
#: requirements.docbook:2
#, no-c-format
msgid "Requirements"
msgstr "តម្រូវការ​"

#. Tag: para
#: requirements.docbook:4
#, no-c-format
msgid ""
"&amarok; requires the installation of some software packages. The required "
"packages are listed below along with several other packages to enhance your "
"&amarok; experience."
msgstr ""
"amarok ត្រូវការ​ការដំឡើង​កញ្ចប់​កម្មវិធី​មួយ​ចំនួន​ ។ "
"កញ្ចប់​ដែល​ទាមទា​ត្រូវ​បានរាយបញ្ជី​​ជាមួយ​កញ្ចប់​ផ្សេងទៀត​ដើម្បី​ពង្រីក​បទពិសោធន៍​"
"amarok  របស់អ្នកដូចខាងក្រោម​នេះ ។"

#. Tag: title
#: requirements.docbook:8
#, no-c-format
msgid "Required:"
msgstr "ទាមទា ៖"

#. Tag: ulink
#: requirements.docbook:9
#, no-c-format
msgid "KDELIBS 3.3"
msgstr "KDELIBS ៣.៣"

#. Tag: ulink
#: requirements.docbook:10
#, no-c-format
msgid "TagLib 1.4"
msgstr "TagLib ១.៤"

#. Tag: title
#: requirements.docbook:14
#, no-c-format
msgid "Recommended:"
msgstr "ផ្ដល់​អនុសាសន៍"

#. Tag: ulink
#: requirements.docbook:15
#, no-c-format
msgid "GStreamer-0.8.6 and Gst-Plugins-0.8.6"
msgstr "GStreamer-០.៨.៦ និង​ កម្មវិធី​ជំនួយ Gst- ០.៨.៦"

#. Tag: title
#: requirements.docbook:19
#, no-c-format
msgid "Optional:"
msgstr "ស្រេចចិត្ត​ ៖"

#. Tag: ulink
#: requirements.docbook:20
#, no-c-format
msgid "aRts 1.3"
msgstr "aRts ១.៣"

#. Tag: ulink
#: requirements.docbook:21
#, no-c-format
msgid "K3B 0.11"
msgstr "K3B ០.១១"

#. Tag: ulink
#: requirements.docbook:22
#, no-c-format
msgid "KDE-Base 3.3 (needed for Konqueror Sidebar)"
msgstr "KDE-Base ៣.៣ (ត្រូវការ​របារចំហៀង សម្រាប់​ Konqueror )"

#. Tag: ulink
#: requirements.docbook:23
#, no-c-format
msgid "KDEMULTIMEDIA 3.3"
msgstr "KDEMULTIMEDIA ៣.៣"

#. Tag: ulink
#: requirements.docbook:24
#, no-c-format
msgid "libtunepimp 0.3"
msgstr "libtunepimp ០.៣"

#. Tag: ulink
#: requirements.docbook:25
#, no-c-format
msgid "Libvisual 0.2.0 and Libvisual plugins"
msgstr "Libvisual ០.២.០ និង​កម្មវិធីជំនួយ  Libvisual "

#. Tag: ulink
#: requirements.docbook:26
#, no-c-format
msgid "MAS 0.6.3"
msgstr "MAS ០.៦.៣"

#. Tag: ulink
#: requirements.docbook:27
#, no-c-format
msgid "MySQL 4"
msgstr "MySQL ៤"

#. Tag: ulink
#: requirements.docbook:28
#, no-c-format
msgid "NMM 0.7.0"
msgstr "NMM ០.៧.០"

#. Tag: para
#: requirements.docbook:29
#, no-c-format
msgid "OpenGL accelerated X-Server"
msgstr "OpenGL បង្កើន​ល្បឿន​ X-Server"

#. Tag: ulink
#: requirements.docbook:30
#, no-c-format
msgid "ProjectM 0.96"
msgstr "ProjectM ០.៩៦"

#. Tag: ulink
#: requirements.docbook:31
#, no-c-format
msgid "Real Player 10"
msgstr "Real Player ១០​"

#. Tag: ulink
#: requirements.docbook:32
#, no-c-format
msgid "SDL 1.2"
msgstr "SDL ១.២"

#. Tag: ulink
#: requirements.docbook:33
#, no-c-format
msgid "xine 1.0.0"
msgstr "xine ១.០.០"

#. Tag: ulink
#: requirements.docbook:34
#, no-c-format
msgid "XMMS 1.2 and XMMS visualization plugins"
msgstr "XMMS ១.២ និង​កម្មវិធី​ជំនួយរូបភាព​មើលឃើញ​ XMMS "

#. Tag: para
#: requirements.docbook:37
#, no-c-format
msgid ""
"If you obtain these dependencies via a packaging system, you must also install "
"the devel versions of these packages!"
msgstr ""
"បើ​អ្នកទទួល​បាន​ឯករាជ្យទាំងនេះ​​តាមរយៈប្រព័ន្ធកញ្ចប់​ អ្នកត្រូវតែ​ដំឡើង​កំណែនៃកញ្ចប់​"
" devel ​ទាំងនេះ ។​"

