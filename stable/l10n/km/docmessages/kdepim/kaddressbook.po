msgstr ""
"ទំនាក់ទំនង​នឹង​ត្រូវ​បាន​ទុក​ជា​ទ្រង់ទ្រាយ vCard ដូចដែល​បាន​បញ្ជាក់​នៅ​ក្នុង "
"RFC 2426 ។"

#. Tag: guilabel
#: index.docbook:186
#, no-c-format
msgid "binary"
msgstr "គោល​ពីរ"

#. Tag: para
#: index.docbook:187
#, no-c-format
msgid ""
"the contacts will be stored in a binary format &mdash; this increases "
"performance during loading and saving, but it is not portable like the vCard "
"format."
msgstr ""
"ទំនាក់​ទំនង​នឹង​ត្រូវ​បាន​ទុក​ជា​ទ្រង់ទ្រាយ​គោលពីរ — "
"វា​បង្កើន​សមត្ថភាព​នៅ​កំឡុងពេល​ផ្ទុក និង​រក្សាទុក "
"ប៉ុន្តែ​វា​មិន​អាច​ចល័ត​បាន​ដូច​ទ្រង់ទ្រាយ vCard ទេ ។"

#. Tag: para
#: index.docbook:193
#, no-c-format
msgid ""
"&kaddressbook; needs a standard resource, where all contacts should be saved if "
"no other resource is specified; for this reason, after starting &kaddressbook; "
"the first time, there is already a resource available. If you want to use "
"another resource as the standard resource, use the <guibutton>"
"Use as Standard</guibutton> button to select it. You must have both read and "
"write access to the new standard resource, otherwise you won't be able to "
"select it."
msgstr ""
"&kaddressbook; ត្រូវការ​ធនធាន​ស្តង់ដារ "
"ដែល​ទំនាក់ទំនង​ទាំងអស់​គួរតែ​ត្រូវ​បាន​រក្សាទុក "
"នៅពេល​ដែល​គ្មាន​ធនធាន​ផ្សេងទៀត​ត្រូវ​បាន​បញ្ជាក់ ។ ចំពោះ​ហេតុផល​នេះ "
"បន្ទាប់​ពី​ចាប់ផ្ដើម &kaddressbook; លើក​ដំបូង​មក គឺ​មាន​ធនធាន​មួយ​រួចទៅ​ហើយ ។ "
"ប្រសិន​បើ​អ្នក​ចង់​ប្រើ​ធនធាន​ផ្សេងទៀត​ជា​ធនធាន​ស្តង់ដារ គឺ​ត្រូវ​ប្រើ​ប៊ូតុង "
"<guibutton>ប្រើ​ជា​ស្តង់ដារ</guibutton> ដើម្បី​ជ្រើស​វា ។ "
"អ្នក​ត្រូវ​តែ​មាន​សិទ្ធិ​ចូល​ដំណើរការ​ទាំង​អាន និង​សរសេរ​ទៅ​កាន់​ធនធាន​ស្តង់ដារ "
"បើ​មិន​ដូច្នោះ​ទេ អ្នក​នឹង​មិន​អាច​ជ្រើស​វា​បាន​ទេ ។"

#. Tag: title
#: index.docbook:204
#, no-c-format
msgid "Managing Contacts"
msgstr "ការ​គ្រប់គ្រង​ទំនាក់ទំនង​"

#. Tag: para
#: index.docbook:205
#, no-c-format
msgid ""
"To create or edit contacts, &kaddressbook; offers a dialog where you can input "
"all the data that can be stored in a vCard."
msgstr ""
"ដើម្បី​បង្កើត ឬ​កែសម្រួល​ទំនាក់ទំនង &kaddressbook; "
"ផ្ដល់​នូវ​ប្រអប់​មួយ​ដែល​អ្នក​អាច​បញ្ចូល​ទិន្នន័យ​ទាំងអស់​ដែល​អាច​ត្រូវបាន​ទុក​​"
"នៅ​ក្នុង vCard ។"

#. Tag: screeninfo
#: index.docbook:210
#, no-c-format
msgid "The Contact Dialog"
msgstr "ប្រអប់​ទំនាក់​ទំនង"

#. Tag: phrase
#: index.docbook:213
#, no-c-format
msgid "<phrase>The Contact Dialog.</phrase>"
msgstr "<phrase>ប្រអប់​ទំនាក់​ទំនង ។</phrase>"

#. Tag: para
#: index.docbook:214
#, no-c-format
msgid "<para>The Contact Dialog.</para>"
msgstr "<para>ប្រអប់​ទំនាក់ទំនង ។</para>"

#. Tag: title
#: index.docbook:219
#, no-c-format
msgid "Automatic Name Parsing"
msgstr "ការ​ញែក​ឈ្មោះ​ដោយ​ស្វ័យ​ប្រវត្តិ"

#. Tag: para
#: index.docbook:220
#, no-c-format
msgid ""
"&kaddressbook; tries to provide an easy name input by automatic name parsing; "
"for this to work properly it is sometimes necessary to add custom name "
"prefixes, suffixes or inclusions in the <link "
"linkend=\"preferences-address-book-contact\">configure dialog</link>"
". Nevertheless, no algorithm is perfect, so the name you enter may be parsed "
"incorrectly; in this case, you can disable the automatic name parsing in the "
"name edit dialog, which is available by clicking the <guibutton>"
"Name...</guibutton> button in the contact dialog. If you wish to disable the "
"name parsing for all new contacts you can disable automatic name parsing "
"globally in the <link linkend=\"preferences-address-book-general\">"
"configure dialog</link>."
msgstr ""
"&kaddressbook; ព្យាយាម​ផ្ដល់​នូវ​ការ​បញ្ចូល​ឈ្មោះ​ងាយស្រួល​ "
"ដោយ​ការ​ញែក​ឈ្មោះ​ដោយ​ស្វ័យ​ប្រវត្តិ ។ ដើម្បី​ឲ្យ​ដំណើរការ​ត្រឹមត្រូវ "
"ពេលខ្លះ​វា​ចាំបាច់​ត្រូវ​បន្ថែម​បុព្វបទ​ឈ្មោះ បច្ច័យ ឬ​រាប់បញ្ចូល​នៅ​ក្នុង "
"<link "
"linkend=\"preferences-address-book-contact\">ប្រអប់​កំណត់​រចនា​សម្ព័ន្ធ</link>"
" ។ ទោះ​ជាយ៉ាងណា​ក៏​ដោយ គ្មាន​ក្បួនដោះស្រាយ​ណា​ដែល​ល្អ​ឥតខ្ចោះ​នោះទេ "
"ដូច្នេះ​ឈ្មោះ​ដែល​អ្នក​បញ្ចូល​អាច​ត្រូវ​បាន​បិទ​ភ្ជាប់​ដោយ​ត្រឹមត្រូវ ។ "
"ក្នុង​ករណី​នេះ "
"អ្នក​អាច​បិទ​ការ​ញែក​ឈ្មោះ​ដោយ​ស្វ័យ​ប្រវត្តិ​ក្នុង​ប្រអប់​កែសម្រួល​ឈ្មោះ "
"ដែល​អាច​មាន​ដោយ​ចុច​លើ​ប៊ូតុង <guibutton>ឈ្មោះ...</guibutton> "
"នៅ​ក្នុង​ប្រអប់​ទំនាក់ទំនង ។ "
"ប្រសិន​បើ​អ្នក​ចង់​បិទ​ការ​ញែកឈ្មោះ​សម្រាប់​ទំនាក់ទំនង​ថ្មី​ដែល​អ្នក​អាច​បិទ​ការ"
"​ញែកឈ្មោះ​ដោយ​ស្វ័យ​ប្រវត្តិ​ជា​សកល​នៅ​ក្នុង <link "
"linkend=\"preferences-address-book-general\">ប្រអប់​កំណត់​រចនា​សម្ព័ន្ធ</link>"
" ។"

#. Tag: title
#: index.docbook:233
#, no-c-format
msgid "Formatted Name"
msgstr "ឈ្មោះ​ដែល​បាន​ធ្វើ​ទ្រង់ទ្រាយ"

#. Tag: para
#: index.docbook:234
#, no-c-format
msgid ""
"The formatted name of a contact is used by other programs to represent it. "
"&kaddressbook; offers three predefined types of formatted names:"
msgstr ""
"ឈ្មោះ​ដែល​បាន​ធ្វើ​ទ្រង់ទ្រាយ​របស់​ទំនាក់ទំនង​គឺ​​ត្រូវ​បាន​ប្រើ​ដោយ​កម្មវិធី​ផ្"
"សេងទៀត​ដើម្បី​តំណាង​ឲ្យ​វា ។ &kaddressbook; "
"ផ្ដល់​នូវ​ឈ្មោះ​ដែល​បាន​ធ្វើ​ទ្រង់ទ្រាយ​ដែល​បាន​កំណត់​ជាមុន​ចំនួន​បី​ប្រភេទ ៖"

#. Tag: guilabel
#: index.docbook:241
#, no-c-format
msgid "SimpleName"
msgstr "ឈ្មោះ​ធម្មតា​"

#. Tag: para
#: index.docbook:242
#, no-c-format
msgid "&lt;given name&gt; &lt;family name&gt;;"
msgstr "&lt;នាម​ខ្លួន&gt; &lt;នាម​ត្រកូល&gt;;"

#. Tag: guilabel
#: index.docbook:246
#, no-c-format
msgid "FullName"
msgstr "ឈ្មោះ​ពេញ​"

#. Tag: para
#: index.docbook:247
#, no-c-format
msgid ""
"&lt;prefix&gt; &lt;given name&gt; &lt;additional name&gt; &lt;family name&gt; "
"&lt;suffix&gt;;"
msgstr ""
"&lt;បុព្វបទ&gt; &lt;នាម​ខ្លួន&gt; &lt;ឈ្មោះ​បន្ថែម&gt; &lt;នាម​ត្រកូល&gt; "
"&lt;បច្ច័យ&gt; ។"

#. Tag: guilabel
#: index.docbook:252
#, no-c-format
msgid "ReverseName"
msgstr "ឈ្មោះ​បញ្ច្រាស"

#. Tag: para
#: index.docbook:253
#, no-c-format
msgid "&lt;family name&gt;, &lt;given name&gt;."
msgstr "&lt;នាម​ត្រកូល&gt;, &lt;នាម​ខ្លួន&gt; ។"

#. Tag: para
#: index.docbook:257
#, no-c-format
msgid ""
"If none of the above types fit your needs you can select the <guilabel>"
"Custom</guilabel> name type, where you can add your own formatted name &mdash; "
"this configuration can be done in the name edit dialog. To specify a default "
"formatted name type for new contacts, use the <link "
"linkend=\"preferences-address-book-contact\">configure dialog</link>."
msgstr ""
"ប្រសិន​បើ​ប្រភេទ​ខាងលើ​មិន​ត្រូវ​នឹង​តម្រូវការ​របស់​អ្នក​ទេ "
"អ្នក​អាច​ជ្រើស​ប្រភេទ​ឈ្មោះ <guilabel>ប្ដូរ​តាម​បំណង</guilabel> "
"ដែល​អ្នក​អាច​បន្ថែម​ឈ្មោះ​ដែល​បាន​ធ្វើ​ទ្រង់ទ្រាយ​ផ្ទាល់ខ្លួន​របស់​អ្នក — "
"ការ​កំណត់​រចនា​សម្ព័ន្ធ​នេះ​អាច​ត្រូវ​បាន​ធ្វើ​រួចរាល់​នៅ​ក្នុង​ប្រអប់​កែសម្រួល​"
"ឈ្មោះ ។ "
"ដើម្បី​បញ្ជាក់​ប្រភេទ​ឈ្មោះ​ដែល​បាន​ធ្វើ​ទ្រង់ទ្រាយ​លំនាំដើម​សម្រាប់​ទំនាក់ទំនង​"
"ថ្មី គឺ​ប្រើ <link linkend=\"preferences-address-book-contact\">"
"ប្រអប់​កំណត់​រចនា​សម្ព័ន្ធ</link> ។"

#. Tag: title
#: index.docbook:266
#, no-c-format
msgid "Instant Messaging"
msgstr "ការ​ផ្ញើ​សារ​បន្ទាន់​"

#. Tag: para
#: index.docbook:267
#, no-c-format
msgid ""
"The <guilabel>IM Address</guilabel> text box holds the preferred Instant "
"Messaging Address for this contact. To add, view and edit additional IM "
"Addresses, click the <guilabel>Edit IM Addresses...</guilabel> "
"button. The Edit IM Addresses Dialog appears."
msgstr ""
"ប្រអប់​អត្ថបទ <guilabel>អាសយដ្ឋាន IM</guilabel> "
"ផ្ទុក​អាសយដ្ឋាន​សារ​បន្ទាន់​​សំណព្វ​សម្រាប់​ទំនាក់ទំនង​នេះ ។ ដើម្បី​បន្ថែម មើល "
"និង​កែសម្រួល​អាសយដ្ឋាន IM បន្ថែម គឺ​ត្រូវ​ចុច​លើ​ប៊ូតុង <guilabel>"
"កែសម្រួល​អាសយដ្ឋាន IM...</guilabel> ។ ប្រអប់​កែសម្រួល​អាសយដ្ឋាន IM នឹង​លេចឡើង ។"

#. Tag: screeninfo
#: index.docbook:271
#, no-c-format
msgid "The Edit IM Addresses Dialog"
msgstr "ប្រអប់​កែសម្រួល​អាសយដ្ឋាន IM"

#. Tag: phrase
#: index.docbook:274
#, no-c-format
msgid "<phrase>The Edit IM Addresses Dialog.</phrase>"
msgstr "<phrase>ប្រអប់​កែសម្រួល​អាសយដ្ឋាន IM ។</phrase>"

#. Tag: para
#: index.docbook:275
#, no-c-format
msgid "<para>The Edit IM Addresses Dialog.</para>"
msgstr "<para>ប្រអប់​កែសម្រួល​អាសយដ្ឋាន IM ។</para>"

#. Tag: para
#: index.docbook:279
#, no-c-format
msgid ""
"A contact can have multiple instant messaging addresses associated with it. "
"Other applications, such as <application>Kopete</application> and <application>"
"Konversation</application>, store their information here. It is recommended "
"that you add, edit and delete instant messaging addresses in <application>"
"Kopete</application> or <application>Konversation</application> "
"rather than here, since they can assist you better in adding the address, "
"adding the user to a group, and so on. If you are not interested in whether "
"they are picked up in another application, and just want to store the instant "
"messaging address with the contact, then it is fine to add and edit it here."
msgstr ""
"ទំនាក់ទំនង​អាច​មាន​អាសយដ្ឋាន​សារ​បន្ទាន់​ច្រើន​ដែល​ទាក់ទង​នឹង​វា ។ "
"កម្មវិធី​ផ្សេងទៀត ដូចជា <application>Kopete</application> និង <application>"
"Konversation</application> ទុក​ព័ត៌មាន​របស់​ពួកវា​នៅ​ទីនេះ ។ "
"វា​ត្រូវ​បាន​ផ្ដល់​អនុសាសន៍​ថា អ្នក​បន្ថែម កែសម្រួល "
"និង​លុប​អាសយដ្ឋាន​សារ​បន្ទាន់​នៅ​ក្នុង <application>Kopete</application> "
"ឬ <application>Konversation</application> ប្រសើរ​ជាង​នៅ​ទីនេះ "
"គឺ​ចាប់តាំង​ពី​ពួកវា​អាច​ជួយអ្នក​​ក្នុងការ​បន្ថែម​អាសយដ្ឋាន "
"បន្ថែម​អ្នកប្រើ​ទៅកាន់​ក្រុម និង​បន្ត​បន្ទាប់ទៀត ។ "
"ប្រសិន​បើ​អ្នក​មិន​ចាប់អារម្មណ៍​​ក្នុងការ​ដែល​ពួកវា​ត្រូវ​បាន​ជ្រើស​នៅ​ក្នុង​កម្"
"មវិធី​ផ្សេង ហើយ​គ្រាន់តែ​ចង់​ទុក​អាសយដ្ឋាន​សារ​បន្ទាន់​ជាមួយ​ទំនាក់ទំនង "
"បន្ទាប់មក​​គឺ​គ្មាន​បញ្ហា​ទេ​ដែល​បន្ថែម និង​កែសម្រួល​វា​នៅ​ទីនេះ ។"

#. Tag: para
#: index.docbook:282
#, no-c-format
msgid ""
"For more information on adding new Instant Messaging Addresses, see <ulink "
"url=\"help:/kopete/getting-started.html#creating-accounts\"><application>"
"Kopete</application>'s handbook</ulink> and <ulink "
"url=\"help:/konversation/linkaddressbook.html\"><application>"
"Konversation</application>'s handbook</ulink>."
msgstr ""
"ចំពោះ​ព័ត៌មាន​បន្ថែម​អំពី​ការ​បន្ថែម​អាសយដ្ឋាន​សារ​បន្ទាន់​ថ្មី សូម​មើល <ulink "
"url=\"help:/kopete/getting-started.html#creating-accounts\">"
"សៀវភៅ​ដៃ​របស់<application> Kopete</application></ulink> "
"និង <ulink url=\"help:/konversation/linkaddressbook.html\">"
"សៀវភៅ​ដៃ​របស់ <application>Konversation</application></ulink> ។"

#. Tag: title
#: index.docbook:290
#, no-c-format
msgid "Crypto Settings tab"
msgstr "ផ្ទាំង​ការ​កំណត់ Crypto"

#. Tag: para
#: index.docbook:291
#, no-c-format
msgid ""
"In this tab, you can define preferences with regards to cryptography for a "
"contact. At the time of this writing, only <application>KMail</application> "
"will make use of these preferences when composing messages. This mechanism "
"replaces the barely editable per-recipient crypto preferences of earlier "
"<application>KMail</application> releases."
msgstr ""

#. Tag: guilabel
#: index.docbook:302
#, no-c-format
msgid "Allowed Protocols"
msgstr "ពិធីការ​ដែល​បាន​អនុញ្ញាត"

#. Tag: para
#: index.docbook:305
#, no-c-format
msgid ""
"Here, you can restrict the cryptographic message formats that can be used for "
"this contact. See the section on <ulink "
"url=\"/kmail/the-composer-window.html#cryptographic-message-formats\">"
"Cryptographic Message Formats</ulink> in <ulink url=\"/kmail/\"><application>"
"KMail</application>'s handbook</ulink> for a discussion of the different "
"available formats."
msgstr ""
"នៅទីនេះ អ្នក​អាច​ដាក់​កម្រិត​ទ្រង់ទ្រាយ​សារ​គ្រីប "
"ដេល​អាច​ត្រូវ​បាន​ប្រើ​សម្រាប់​ទំនាក់ទំនង​នេះ ។ សូមមើល​ផ្នែក​នៅលើ <ulink "
"url=\"/kmail/the-composer-window.html#cryptographic-message-formats\">"
"ទ្រង់ទ្រាយ​សារ​គ្រីប</ulink> នៅ​ក្នុង​ <ulink url=\"/kmail/\">"
"សៀវភៅ​ដៃ​របស់ <application>KMail</application></ulink> "
"សម្រាប់​ការ​ពិភាក្សា​នៃ​ទ្រង់ទ្រាយ​ដែល​មាន​ផ្សេងគ្នា ។"

#. Tag: term
#: index.docbook:318
#, no-c-format
msgid ""
"<guilabel>Preferred OpenPGP encryption key</guilabel>, <guilabel>"
"Preferred S/MIME encryption certificate</guilabel>"
msgstr ""
"<guilabel>គ្រាប់ចុច​ការ​គ្រីប OpenPGP សំណព្វ</guilabel> <guilabel>"
"វិញ្ញា​បនបត្រ​ការ​គ្រីប S/MIME សំណព្វ</guilabel>"

#. Tag: para
#: index.docbook:323
#, no-c-format
msgid ""
"Here, you can assign a preferred OpenPGP key and/or S/MIME certificate to be "
"used when encrypting to this contact. Otherwise, the local keyring and local "
"certificate box are searched for matching keys and certificates."
msgstr ""

#. Tag: guilabel
#: index.docbook:334
#, no-c-format
msgid "Message Preference"
msgstr "ចំណង់​ចំណូល​ចិត្ត​សារ"

#. Tag: para
#: index.docbook:337
#, no-c-format
msgid ""
"Here, you can select from a set of directives for user interaction both when "
"signing and when encrypting."
msgstr ""
"នៅទីនេះ អ្នក​អាច​ជ្រើស​ពី​សំណុំ​នៃ​សេចក្ដី​​បង្គាប់​សម្រាប់​អន្តរសកម្ម​ "
"ទាំង​នៅពេល​ចុះហត្ថលេខា និង​នៅពេល​អ៊ិនគ្រីប ។"

#. Tag: guilabel
#: index.docbook:344
#, no-c-format
msgid "&lt;none&gt;"
msgstr "&lt;គ្មាន&gt;"

#. Tag: para
#: index.docbook:347
#, no-c-format
msgid ""
"No preference, use whatever mode <application>KMail</application> defaults to."
msgstr ""
"គ្មាន​ចំណង់ចំណូល​ចិត្ត ប្រើ​របៀប​អ្វី​ក៏ដោយ ដើម្បី​កំណត់ <application>"
"KMail</application> លំនាំដើម ។"

#. Tag: term
#: index.docbook:354
#, no-c-format
msgid "<guilabel>Never Sign</guilabel>, <guilabel>Never Encrypt</guilabel>"
msgstr ""
"<guilabel>កុំ​ចុះហត្ថលេខា</guilabel> <guilabel>កុំ​អ៊ិនគ្រីប</guilabel>"

#. Tag: para
#: index.docbook:358
#, no-c-format
msgid ""
"Never sign (encrypt) messages to this contact. Don't ask for confirmation "
"(except in the case of conflicts with preferences of other contacts)."
msgstr ""
"កុំ​ចុះហត្ថលេខា (អ៊ិនគ្រីប) សារ​ទៅ​ទំនាក់​ទំនាង​នេះ ។ កុំ​សួររក​ការ​អះអាង "
"(លើកលែង​តែ​ក្នុង​ករណី​ដែល​មាន​ការ​ប៉ះទង្គិច​ជាមួយ​ចំណង់​ចំណូល​ចិត្ត​របស់​ទំនាក់ទ"
"ំនង​ផ្សេងទៀត) ។"

#. Tag: term
#: index.docbook:367
#, no-c-format
msgid "<guilabel>Always Sign</guilabel>, <guilabel>Always Encrypt</guilabel>"
msgstr ""
"<guilabel>ចុះហត្ថលេខា​ជានិច្ច</guilabel> <guilabel>អ៊ិនគ្រីប​ជានិច្ច</guilabel>"

#. Tag: para
#: index.docbook:372
#, no-c-format
msgid ""
"Always sign (encrypt) messages to the contact. Don't ask for confirmation "
"(except in the case of conflicts with preferences of other contacts)."
msgstr ""
"ចុះហត្ថលេខា (អ៊ីនគ្រីប) សារ​ទៅ​ទំនាក់ទំនង ។ កុំសួរ​រក​ការ​អះអាង "
"(លើកលែងតែ​ក្នុង​ករណី​ដែល​ប៉ះទង្គិច​ជាមួយ​ចំណង់​ចំណូលចិត្ត​របស់​ទំនាក់ទំនង​ផ្សេងទ"
"ៀត) ។"

#. Tag: term
#: index.docbook:381
#, no-c-format
msgid ""
"<guilabel>Always Sign If Possible</guilabel>, <guilabel>"
"Always Encrypt If Possible</guilabel>"
msgstr ""
"<guilabel>ចុះហត្ថលេខា​ជានិច្ច​បើ​អាច​ធ្វើបាន</guilabel>, <guilabel>"
"អ៊ិនគ្រីប​ជានិច្ច​បើ​អាច​ធ្វើបាន</guilabel>"

#. Tag: para
#: index.docbook:386
#, fuzzy, no-c-format
msgid ""
"Always sign (encrypt) messages to this contact when it would be possible to do "
"so. Don't ask if it isn't possible. Situations in which signing might not be "
"possible include other recipients having signing preferences of \"Never\". "
"Situations in which encryption might not be possible include missing "
"keys/certificates for this or other recievers."
msgstr ""
"ចុះហត្ថលេខា (អ៊ិនគ្រីប​) សារជានិច្ច​សម្រាប់​ទំនាក់ទំនង​នេះ​ "
"ពេល​វា​​អាច​ធ្វើ​ដូច្នេះ​បាន​។ \n"
"ស្ថានភាព​ការចុះហត្ថលេខា​មិនអាច​ធ្វើ​បាន​ទេ​ "
"រូមទាំង​អ្នកទទួល​ផ្សេងទៀតដែលកំពុង​មាន​​ការចុះហត្ថលេខា​ចំណូលចិត្ត​ \"មិនដែល​\" ។ "
"ស្ថានភាព​ការអ៊ិនគ្រីនឹង​មិន​អាច​រូមបញ្ចូល​ទាំង​កំហុស​គ្រាប់ចុច​ "
"ឬ​វិញ្ញាបនបត្រ​សម្រាប់​អ្នកទទួល​ផ្សេងទៀត​ឡើយ ។​"

#. Tag: guilabel
#: index.docbook:400
#, no-c-format
msgid "<guilabel>Ask</guilabel>"
msgstr "<guilabel>សួរ</guilabel>"

#. Tag: para
#: index.docbook:403
#, no-c-format
msgid "Always ask whether to sign (encrypt)."
msgstr ""

#. Tag: title
#: index.docbook:417
#, no-c-format
msgid "Using Views"
msgstr ""

#. Tag: para
#: index.docbook:418
#, no-c-format
msgid ""
"In this version, &kaddressbook; offers different views, which can represent the "
"contacts in different ways:"
msgstr ""
"នៅ​ក្នុង​កំណែ​នេះ &kaddressbook; នឹង​ផ្ដល់​ទិដ្ឋភាព​ផ្សេង "
"ដែល​អាច​តាង​ឲ្យ​ទំនាក់ទំនង​ក្នុង​វិធី​ផ្សេង ៖"

#. Tag: guilabel
#: index.docbook:425
#, no-c-format
msgid "Table View"
msgstr "ទិដ្ឋភាព​តារាង"

#. Tag: para
#: index.docbook:426
#, no-c-format
msgid ""
"All contacts are listed in a table; they can be sorted by clicking at the "
"column header of the table. The columns of the table depend on the fields which "
"were selected in the view configuration dialog."
msgstr ""
"ទំនាក់​ទំនង​ទាំងអស់​ត្រូវ​បាន​រាយ​នៅ​ក្នុង​តារាង ។ "
"ពួកវា​អាច​ត្រូវ​បាន​ទុក​ដោយ​ចុច​នៅ​បឋមកថា​ជួរឈរ​របស់​តារាង ។ "
"ជួរឈរ​របស់​តារាង​គឺ​អាស្រ័យ​លើ​វាល​ដែល​បាន​ជ្រើស​នៅ​ក្នុង​ប្រអប់​កំណត់​រចនា​សម្ព"
"័ន្ធ​ទិដ្ឋភាព ។"

#. Tag: guilabel
#: index.docbook:433
#, no-c-format
msgid "Icon View"
msgstr "ទិដ្ឋភាព​រូបតំណាង​"

#. Tag: para
#: index.docbook:434
#, no-c-format
msgid ""
"The contacts are listed as icons in a view. If the contact contains a photo or "
"logo, then it is used in the view; otherwise, an default icon is used."
msgstr ""
"ទំនាក់ទំនង​គឺ​ត្រូវ​បាន​រាយ​ជា​រូបតំណាង​នៅ​ក្នុង​ទិដ្ឋភាព ។ "
"ប្រសិន​បើ​ទំនាក់ទំនង​មាន​រូបតំណាង ឬ​រូបថត "
"ពេល​នោះ​វា​នឹង​ត្រូវ​បាន​ប្រើ​នៅ​ក្នុង​ទិដ្ឋភាព ។ បើ​មិន​ដូច្នេះ​ទេ "
"វា​នឹង​ប្រើ​រូបតំណាង​លំនាំដើម ។"

#. Tag: guilabel
#: index.docbook:440
#, no-c-format
msgid "Card View"
msgstr "ទិដ្ឋភាព​កាត​"

#. Tag: para
#: index.docbook:441
#, no-c-format
msgid ""
"All contacts are presented in form of cards. The titles of these cards are the "
"formatted names; the body of each card depends on what fields were selected in "
"the view configuration dialog."
msgstr ""
"ទំនាក់ទំនង​ទាំងអស់​គឺ​ត្រូវ​បាន​បង្ហាញ​ជា​សំណុំ​បែបបទ​របស់​កាត ។ "
"ចំណង​ជើង​នៃ​កាត​ទាំងនេះ គឺ​ជា​ឈ្មោះ​ដែល​បាន​ធ្វើ​ទ្រង់ទ្រាយ ។ "
"តួ​នៃ​កាត​នីមួយៗ​គឺ​អាស្រ័យ​លើ​អ្វី​ដែល​បាន​ជ្រើស​នៅ​ក្នុង​ប្រអប់​​ការ​កំណត់​រចន"
"ា​សម្ព័ន្ធ​ទិដ្ឋភាព ។"

#. Tag: screeninfo
#: index.docbook:448
#, no-c-format
msgid "The View Configuration Dialog"
msgstr "ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទិដ្ឋភាព"

#. Tag: phrase
#: index.docbook:451
#, no-c-format
msgid "<phrase>The View Configuration Dialog.</phrase>"
msgstr "<phrase>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទិដ្ឋភាព ។</phrase>"

#. Tag: para
#: index.docbook:452
#, no-c-format
msgid "<para>The View Configuration Dialog.</para>"
msgstr "<para>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទិដ្ឋភាព ។</para>"

#. Tag: para
#: index.docbook:456
#, fuzzy, no-c-format
msgid ""
"The <guilabel>Selected Fields</guilabel> page offers you the possibility of "
"selecting which of the stored details of a contact should be shown in the view. "
"In the <guilabel>Default Filter</guilabel> page you can setup what <link "
"linkend=\"using-filters\">filter</link> should be used by the view."
msgstr ""
"ទំព័រ​<guilabel>វាល​ដែល​បាន​ជ្រើស​</guilabel> "
"ផ្តល់​ឲ្យ​អ្នកនូវលទ្ធភាព​នៃ​ការជ្រើសទំនាក់ទំនង​​លម្អិត​ដែលបាន​តម្រៀប​បានបង្ហាញ​ក"
"្នុង​ទិដ្ឋភាពមើល​ ។ ក្នុង​ទំព័រ​<guilabel>តម្រង​លំនាំដើម​</guilabel> "
"អ្នកអាច​រៀប​ចំ​<link linkend=\"using-filters\">filter</link> "
"អ្វី​ដែលគួរ​ប្រើ​ដោយ​ទិដ្ឋភាពមើ​ល ។​"

#. Tag: title
#: index.docbook:463
#, no-c-format
msgid "Using Filters"
msgstr "ការ​ប្រើប្រាស់​តម្រង"

#. Tag: para
#: index.docbook:464
#, fuzzy, no-c-format
msgid ""
"You can setup filters in &kaddressbook; which depend on the categories a "
"contact belongs to. For example, you can create a filter that matches all "
"contacts which belong to the categories 'Family' and 'Friends'; you can also "
"create a filter that matches all contacts which do not these categories. To "
"manage filters, use the filter configuration dialog:"
msgstr ""
"អ្នកអាច​រៀបចំ​តម្រង​​ក្នុង​ Kaddressbook ពឹង​ផ្នែក​លើ​ប្រភេទ​ទំនាក់ទំនង​​ ។​ "
"ឧទាហរណ៍​ អ្នកអាច​បង្កើត​\n"
"តម្រង​​ដែល​ផ្គូផ្គង​​ទៅ​ទំនាក់ទំនង​ទាំងអស់​ជា​ម្ចាស់​នៃ​ប្រភេទ 'គ្រួសារ​' និង​ "
"'មិត្តភ័ក្ត​' អ្នក​ក៏​អាច​បង្កើត​តម្រង​\n"
"ផ្គូផ្គង​ទំនាក់ទំនង​ទាំងអស់​ដែល​មិន​មែនជា​ប្រភេទ ។ ដើម្បី​គ្រប់គ្រង​តម្រង​ "
"ប្រើ​ប្រអប់​ការកំណត់​រចនាសម្ព័ន្ធ​តម្រង​​ ៖"

#. Tag: screeninfo
#: index.docbook:473
#, no-c-format
msgid "The Filter Configuration Dialog"
msgstr "ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​តម្រង"

#. Tag: phrase
#: index.docbook:476
#, no-c-format
msgid "<phrase>The Filter Configuration Dialog.</phrase>"
msgstr "<phrase>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​តម្រង ។</phrase>"

#. Tag: para
#: index.docbook:477
#, no-c-format
msgid "<para>The Filter Configuration Dialog.</para>"
msgstr "<para>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​តម្រង ។</para>"

#. Tag: para
#: index.docbook:481
#, no-c-format
msgid ""
"Filters can be used in views to reduce the number of contacts shown. In the "
"<link linkend=\"using-filters\">view configuration dialog</link> "
"you can specify what filter should be used by a view by default."
msgstr ""
"តម្រង​អាច​ត្រូវ​បាន​ប្រើ​នៅ​ក្នុង​ទិដ្ឋភាព "
"ដើម្បី​កាត់​បន្ថយ​ចំនួន​ទំនាក់ទំនង​ដែល​បង្ហាញ ។ នៅ​ក្នុង <link "
"linkend=\"using-filters\">ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទិដ្ឋភាព</link> "
"អ្នក​អាច​បញ្ជាក់​តម្រង​អ្វី​ដែល​គួរតែ​ត្រូវ​បាន​ប្រើ​ដោយ​ទិដ្ឋភាព​តាម​លំនាំដើម​ន"
"ោះ ។"

#. Tag: title
#: index.docbook:489
#, no-c-format
msgid "Using Extensions"
msgstr "ការ​ប្រើប្រាស់​ផ្នែក​បន្ថែម"

#. Tag: para
#: index.docbook:490
#, fuzzy, no-c-format
msgid ""
"Extensions are implemented as plugins in &kaddressbook;, so 3rd-party "
"developers can provide more of them. At the moment we already have three "
"extensions:"
msgstr ""
"ផ្នែក​បន្ថែម​ត្រូវ​បានប្រត្តិបត​​ជា​កម្មវិធីជំនួយ​ Kaddressbook "
"ដូច្នេះ​អ្នកអភិវឌ្ឍន​ 3rd-party អាច​ផ្តល់​ផ្នែក​\n"
"បន្ថែម​បាន​ច្រើន​នៃ​ពួក​វា​​ ។ ខណៈនេះ​យើង​មាន​ផ្នែក​បន្ថែម​ឯកសារ​ចំនួន​បី ៖"

#. Tag: guilabel
#: index.docbook:498
#, no-c-format
msgid "Contact Editor"
msgstr "កម្មវិធី​និពន្ធ​ទំនាក់ទំនង"

#. Tag: para
#: index.docbook:499
#, no-c-format
msgid ""
"Similar to the the contact editing dialog, but designed to allow contacts to be "
"edited quickly."
msgstr ""
"ស្រដៀង​នឹង​​ប្រអប់​ការកែសម្រួល​ទំនាក់ទំនង​ "
"ប៉ុន្តែ​បាន​រចនាឡើងដើម្បី​អនុញ្ញាត​ឲ្យ​ទំនាក់ទំនង​​អាច​កែ\n"
"ស្រួល​បាន​យ៉ាង​លឿន​ ។"

#. Tag: guilabel
#: index.docbook:504
#, no-c-format
msgid "Location of Contact"
msgstr "ទីតាំង​នៃ​ទំនាក់ទំនង​"

#. Tag: para
#: index.docbook:505
#, no-c-format
msgid ""
"This extension takes the postal address of a contact and loads a map service "
"from the internet (like www.map24.de) with these data; the result is shown in a "
"<acronym>HTML</acronym> view."
msgstr ""
"ផ្នែក​បន្ថែមនេះ​វា​យ​ក​អាសយដ្ឋានប្រៃសនីយ៍​​នៃ​ទំនាក់ទំនង​ "
"ហើយ​ផ្ទុកសេវា​ផ្គូផ្គង​ពី​អ៊ីធឺណិត​\n"
" (ដូចជា​ www.map24.de) ជាមួយ​ទិន្នន័យ​ទាំងនេះ "
"លទ្ធផល​ត្រូវ​បាន​បង្ហាញ​ក្នុង​ទិដ្ឋភាព <acronym>HTML</acronym> ។​"

#. Tag: guilabel
#: index.docbook:511
#, no-c-format
msgid "Distribution List Manager"
msgstr "កម្មវិធី​គ្រប់គ្រងបញ្ជី​ការចែកចាយ​"

#. Tag: para
#: index.docbook:512
#, no-c-format
msgid ""
"This extension provides easy management of the distribution lists: just create "
"a new list and select a contact in the view; then, after clicking <guibutton>"
"Add contact</guibutton>, the selected contact is part of the distribution list. "
"A simpler way is to drag a contact from the view and drop it over the "
"distribution list manager. See <link linkend=\"settings-menu\"> "
"Settings Menu</link> about how to add an extension."
msgstr ""
"ផ្នែក​បន្ថែម​នេះ​ផ្តល់​នូវ​ការគ្រប់គ្រង​នៃ​​ការចែកចាយ​បញ្ជី​យ៉ាងងាយស្រួល​ ៖ "
"គ្រាន់​តែ​បង្កើត​​បញ្ជី ហើយ​ជ្រើស​ទំនាក់ទំនង​ថ្មី​មួយ​ក្នុង​ទិដ្ឋផាព​ "
"បន្ទាប់មក​ចុច​ <guibutton>បន្ថែម​ទំនាក់ទំនង​​</guibutton> "
"ទំនាក់ទំនង​ដែល​បាន​ជ្រើស​ជា​ផ្នែ​ក​មួ​យ​នៃ​ការបែកចែកបញ្ជី ។ "
"វិធី​ដែលងាយ​គឺ​អូស​ទំនាក់ទំនង​​ពី​ទិដ្ឋភាព​ "
"ហើយ​ទម្លាក់​វា​ទៅ​ក្នុង​កម្មវិធី​គ្រប់គ្រង​ការចែកចាយ​បញ្ជី​ ។ មើល​See <link "
"linkend=\"settings-menu\"> ការកំណត់​ម៉ឺនុយ</link> "
"អំពី​របៀប​​បន្ថែម​ផ្នែក​បន្ថែម​​ ។​"

#. Tag: screeninfo
#: index.docbook:522
#, no-c-format
msgid ""
"<screeninfo>The main window with distribution list extension.</screeninfo>"
msgstr ""
"<screeninfo>បង្អួច​មេ​ដែលមាន​​ការចែកចាយ​បញ្ជី​ផ្នែក​បន្ថែម​ ។​</screeninfo>"

#. Tag: phrase
#: index.docbook:525
#, no-c-format
msgid "<phrase>The main window with distribution list extension.</phrase>"
msgstr "<phrase>បង្អួច​មេ​ដែលមាន​​ការចែកចាយ​បញ្ជី​ផ្នែក​បន្ថែម​ ។</phrase>"

#. Tag: para
#: index.docbook:526
#, no-c-format
msgid "<para>The main window with distribution list extension.</para>"
msgstr "<para>បង្អួច​មេ​ដែលមាន​​ការចែកចាយ​បញ្ជី​ផ្នែក​បន្ថែម​ ។</para>"

#. Tag: title
#: index.docbook:532
#, no-c-format
msgid "Import and Export"
msgstr "នាំចូល​ និង​នាំចេញ​"

#. Tag: para
#: index.docbook:533
#, no-c-format
msgid ""
"With the new import/export framework &kaddressbook; offers a dialog where you "
"can select which contacts are to be exported."
msgstr ""
"ជាមួយ​គ្រោងការណ៍​ថ្មី​នាំចេញ ឬ​នាំចូល​ Kaddressbook "
"ផ្តល់​នូវ​ទីតាំង​ប្រអប់អ្នកអាច​ជ្រើស​​ទំនាក់ទំនង​​​ត្រូវ​បាន​នាំចេញ ។​"

#. Tag: screeninfo
#: index.docbook:537
#, no-c-format
msgid "<screeninfo>The export selection dialog.</screeninfo>"
msgstr "<screeninfo>ប្រអប់​ការជ្រើស​នាំចេញ ។</screeninfo>"

#. Tag: phrase
#: index.docbook:540
#, no-c-format
msgid "<phrase>The export selection dialog.</phrase>"
msgstr "<phrase>ប្រអប់​ការជ្រើស​នាំចេញ ។</phrase>"

#. Tag: para
#: index.docbook:541
#, no-c-format
msgid "<para>The export selection dialog.</para>"
msgstr "<para>ប្រអប់​ការជ្រើស​នាំចេញ ។</para>"

#. Tag: para
#: index.docbook:545
#, no-c-format
msgid "The following import and export plugins are available at the moment:"
msgstr ""
"កម្មវិធី​ជំនួយ​នាំចេញ​ និង​នាំចូល​ដូច​ខាងក្រោម​នេះ​អាច​រក​បាន​ឥឡូ​វ​នេះ ៖"

#. Tag: para
#: index.docbook:551
#, no-c-format
msgid ""
"the vCard format is standardized format (RFC 2426) that is supported by most "
"addressbook applications &mdash; &kaddressbook; can import and export versions "
"2.1 and 3.0;"
msgstr ""
"ទ្រង់ទ្រាយ​ vCard ប្រើ​ជា​ទ្រង់ទ្រាយ​ស្តង់ដារ​ (RFC 2426) "
"ដែល​ត្រូវ​បាន​គាំទ្រ​ដោយ​​កម្មវិធី​សៀវភៅ​\n"
"អាសយដ្ឋាន​  mdash Kaddressbook ជា​ច្រើន​អាច​នាំចូល និង​នាំចេញ​​កំណែ​ ២.១ និង "
"៣.០ "

#. Tag: guilabel
#: index.docbook:557
#, no-c-format
msgid "Mobile Phone"
msgstr "ទូរស័ព្ទ​ចល័ត​"

#. Tag: para
#: index.docbook:558
#, no-c-format
msgid ""
"this plugin can import contacts from Nokia mobile phones via the gnokii "
"library;"
msgstr ""
"កម្មវិធី​ជំនួយ​នេះ​អាច​នាំចូល​ទំនាក់ទំនង​ពី​ទូរស័ព្ទ​ចល័តណូគៀ​តាមរយៈ​បណ្ណាល័យ​ "
"gnokii "

#. Tag: guilabel
#: index.docbook:563
#, no-c-format
msgid "Eudora Addressbook"
msgstr "សៀវភៅ​អាសយដ្ឋាន​ Eudora "

#. Tag: para
#: index.docbook:564
#, no-c-format
msgid ""
"with this plugin you can import your contacts from the Eudora mail client;"
msgstr ""
"ជាមួយ​កម្មវិធី​ជំនួយ​​អ្នកអាច​​នាំចូល​​ទំនាក់ទំនង​របស់អ្នក​ពី​កម្មវិធី​អ៊ីម៉ែល​ "
"Eudora "

#. Tag: guilabel
#: index.docbook:569
#, no-c-format
msgid "<guilabel>CSV</guilabel>"
msgstr "<guilabel>CSV</guilabel>"

#. Tag: para
#: index.docbook:570
#, no-c-format
msgid ""
"CSV (comma separated value) is a format that is used by many (addressbook) "
"applications &mdash; you can import and export your contacts with this format;"
msgstr ""
"CSV (តម្លៃ​ត្រូវ​បាន​បំបែក​ដោយ​សញ្ញា​ចល្លភាគ​) "
"ជា​ទ្រង់ទ្រាយ​​ដែល​ប្រើ​​ដោយ​កម្មវិធី​ (សៀវភៅអាសយដ្ឋាន​)  &mdash "
"អ្នកអាច​នាំចូល​ និង​នាំចេញ​ទំនាក់ទំនង​របស់​អ្នក​​ជាមួយទ្រង់ទ្រាយ​នេះ "

#. Tag: guilabel
#: index.docbook:576
#, no-c-format
msgid "KDE2"
msgstr "KDE2"

#. Tag: para
#: index.docbook:577
#, no-c-format
msgid "to import your old addressbook data from KDE 2.X you can use this item;"
msgstr ""
"ដើម្បី​នាំចូល​ទិន្នន័យ​​សៀវភៅ​អាសយដ្ឋាន​ចាស់ៗ​របស់អ្នក​ពី​ KDE ២.X "
"អ្នកអាច​ប្រើ​ធាតុ​នេះ "

#. Tag: guilabel
#: index.docbook:582
#, no-c-format
msgid "LDIF"
msgstr "LDIF"

#. Tag: para
#: index.docbook:583
#, no-c-format
msgid ""
"LDIF is a plain-text representation of LDAP data, used by Netscape and Mozilla "
"to store their addressbook data &mdash; &kaddressbook; supports import and "
"export of this format;"
msgstr ""
"LDIF ជា​ការតំណាង​ឲ្យ​អត្ថបទ​ធម្មតា​នៃ​ទិន្នន័យ​ LDAP ត្រូវ​បានប្រើ​ដោយ​ "
"Netscape និង​ Mozilla សម្រាប់​\n"
"ផ្ទុកទិន្នន័យសៀវភៅ​​អាសយដ្ឋាន​​របស់​ពួក​គេ​ &mdash; kaddressbook គាំទ្រ​នាំចូល "
"និង​នាំចេញ​​នៃ​\n"
"ទ្រង់ទ្រាយ​នេះ  "

#. Tag: guilabel
#: index.docbook:590
#, no-c-format
msgid "<guilabel>PAB</guilabel>"
msgstr "<guilabel>PAB</guilabel>"

#. Tag: para
#: index.docbook:591
#, no-c-format
msgid ""
"PAB is the MS Exchange Personal Address Book format, used by MS Outlook and MS "
"Outlook Express to store their contact data &mdash; &kaddressbook; supports the "
"import of this format;"
msgstr ""
"PAB ជា​ទ្រង់ទ្រាយ​សៀវភៅ​អាសយដ្ឋាន MS Exchange ផ្ទាល់​ខ្លួន​ត្រូវ​បាន​ប្រើដោយ​ "
"MS Outlook និង​ MS Outlook Express ដើម្បីផ្ទុក​ទិន្នន័យ​ &mdash; Kaddressbook "
"គាំទ្រ​នាំចូល​នៃ​ទ្រង់ទ្រាយ​នេះ "

#. Tag: guilabel
#: index.docbook:598
#, no-c-format
msgid "Opera"
msgstr "Opera"

#. Tag: para
#: index.docbook:599
#, no-c-format
msgid ""
"use this plugin to import the contact database of the Opera web browser;"
msgstr ""
"ប្រើ​កម្មវិធី​ជំនួយ​នេះ​ដើម្បី​នាំចូល​ទំនាក់ទំនង​មូលដ្ឋាន​ទិន្នន័យ​​នៃ​កម្មវិធីរ"
"ុករក​បណ្តាញ​ Opera "

#. Tag: guilabel
#: index.docbook:604
#, no-c-format
msgid "Bookmarks"
msgstr "ចំណាំ​"

#. Tag: para
#: index.docbook:605
#, no-c-format
msgid ""
"this is a pseudo export plugin that makes the web URLs of your contacts "
"available in the bookmark menu of konqueror."
msgstr ""
"នេះ​ជា​កម្មវិធី​ជំនួយនាំចេញ​ដែល​ធ្វើ​ឲ្យ​​បណ្តាញ URLs "
"នៃ​ទំនាក់ទំនង​​ដែល​អាច​រក​បាន​ក្នុង​ម៉ឺនុយ​ចំណាំ​នៃ​ konqueror ។​"

#. Tag: title
#: index.docbook:612
#, no-c-format
msgid "LDAP queries"
msgstr "សំណួរ LDAP "

#. Tag: para
#: index.docbook:613
#, no-c-format
msgid ""
"Address information from LDAP servers can be imported into &kaddressbook;'s "
"local addressbook by using the LDAP search dialog."
msgstr ""
"ព័ត៌មាន​អាសយដ្ឋាន​​បានមកពី​ម៉ាស៊ីន​បម្រើ​ LDAP "
"អាច​ត្រូវ​បាននាំចូលមូលដ្ឋាន​​សៀវភៅ​អាសយដ្ឋាន​របស់​ Kaddressbook "
"ដោយ​ប្រើ​ប្រអប់​ស្វែងរក​ LDAP ។​"

#. Tag: para
#: index.docbook:617
#, no-c-format
msgid ""
"To configure (a number of) LDAP servers, use the <link "
"linkend=\"preferences-ldap-lookup\">configuration dialog.</link>"
msgstr ""
"ដើម្បី​កំណត់​(ចំនួននៃ​) ម៉ាស៊ីនបម្រើ​ LDAP ប្រើ​<link "
"linkend=\"preferences-ldap-lookup\"> \n"
"ប្រអប់​ការកំណត់​រចនាសម្ព័ន្ធ​ ។</link>"

#. Tag: para
#: index.docbook:621
#, no-c-format
msgid ""
"On the main toolbar in &kaddressbook; a button with a picture of a magnifying "
"glass over a book is available: use this button to open the LDAP search dialog. "
"The dialog itself is pretty straight forward; just type in parts of a name, "
"email address or phone number and press the <guibutton>Search</guibutton> "
"button."
msgstr ""
"នៅ​លើ​ប៊ូតុង​របារឧបករណ៍មេ​ក្នុង​ Kaddressbook "
"ដែល​មានរូបភាព​នៃកែវ​ពង្រីក​​លើ​សៀវភៅ ៖\n"
"ប្រើ​ប៊ូតុង​នេះ​ដើម្បី​បើក​ប្រអប់ស្វែងរក​ LDAP ។ "
"ប្រអប់​របស់​វាសញ្ញា​បញ្ចូន​ដ៏ស្រស់ស្អាត​ គ្រាន់តែ​វាយ​ក្នុង​\n"
"ផ្នែកមួយ​នៃ​ឈ្មោះ អាសយដ្ឋាន​អ៊ីម៉ែល​ ឬលេខទូរស័ព្ទ​ ហើយ​ចុច​​ប៊ូតុង​<guibutton>"
"ស្វែងរក​</guibutton> ។​"

#. Tag: para
#: index.docbook:628
#, no-c-format
msgid ""
"When the results display in the listbox it is possible to select one or more "
"address(es); you can then use the <guibutton>Add Selected</guibutton> "
"to import the selected address(es) to the local addressbook, or click the "
"<guibutton>Send email to Contact</guibutton> to invoke a mail program to write "
"an email to the selected recipients."
msgstr ""
"នៅ​ពេល​ដែល​លទ្ធផល​បង្ហាញ​ក្នុងប្រអប់បញ្ជី​ វា​អាច​ជ្រើស​យក​អាសយដ្ឋាន​​មួយ "
"ឬ​ច្រើន​ បន្ទាបើ​មក​ប្រើ​ <guibutton>ជ្រើស​បន្ថែម​</guibutton> "
"ដើម្បី​នាំចូល​អាសយដ្ឋាន​ដែល​បានជ្រើស​ទៅកាន់​សៀវភៅ\n"
"អាសយដ្ឋាន​ ឬ​ចុច​ <guibutton>ផ្ញើរ​អ៊ីម៉ែល​ទៅ​កាន់ទំនាក់ទំនង​</guibutton> "
"សម្រាប់​ហៅ​កម្មវិធី​អ៊ីម៉ែ​ល​មកសរសេរ​ទៅ​កាន់អ្នកទទួល​ដែល​បានជ្រើស​ ។​"

#. Tag: para
#: index.docbook:634
#, no-c-format
msgid ""
"The <guibutton>Recursive search</guibutton> checkbox is enabled by default; "
"this will make the LDAP query consider all objects below the base DN of each "
"server. If you only want to consider objects one level below the base uncheck "
"this checkbox; if in doubt, leave it checked."
msgstr ""
"ប្រអប់ធីក <guibutton>ស្វែងរក​ឡើងវិញ​</guibutton> តាម​លំនាំដើម​ "
"ការនេះ​នឹង​បង្កើត​​សំណួរ LDAP \n"
"​នៃវត្ថុគោល​ម៉ាស៊ីន​បម្រើ​​ DN ទាំងអស់​ដូចខាងក្រោម​ ។ "
"បើ​អ្នក​ចង់​បាន​តែ​គោល​កម្រិត​វត្ថុ​មួយ​ កុំធីក​\n"
"ប្រអប់​ធីក​នេះ បើ​សង្ស័យ​កុំ​ធីកវា​ ។​"

#. Tag: title
#: index.docbook:644
#, no-c-format
msgid "Preferences"
msgstr "ចំណូល​ចិត្ត"

#. Tag: para
#: index.docbook:646
#, no-c-format
msgid ""
"You can modify many aspects of &kaddressbook;'s behavior in the preferences "
"dialog; the dialog can be opened via <menuchoice><guimenu>Settings</guimenu>"
"<guimenuitem>Configure KAddressBook</guimenuitem></menuchoice> "
"or using the toolbar icon."
msgstr ""
"អ្នកអាច​កែប្រែ​​ទ្រង់ទ្រាយ​នៃ​ឥរិយាបទ​របស់ Kaddressbook "
"ក្នុង​ប្រអប់​ចំណូល​ចិត្ត​ ប្រអប់​បាន​បើក​តាមរយៈ  <menuchoice><guimenu>"
"ការកំណត់​</guimenu><guimenuitem>កំណត់រចនាសម្ព័ន្ធ​ KAddressBook</guimenuitem>"
"</menuchoice> ឬ​ប្រើ​រូបតំណាង​របារឧបករណ៍ ។​"

#. Tag: screeninfo
#: index.docbook:652
#, no-c-format
msgid "Configuring &kaddressbook;"
msgstr "កំណត់រចនាសម្ព័ន្ធ Kaddressbook "

#. Tag: phrase
#: index.docbook:655
#, no-c-format
msgid "<phrase>The preferences dialog.</phrase>"
msgstr "<phrase>ប្រអប់​ចំណូល​ចិត្ត​ ។</phrase>"

#. Tag: para
#: index.docbook:656
#, no-c-format
msgid "<para>The preferences dialog.</para>"
msgstr "<para>ប្រអប់​ចំណូល​ចិត្ត​ ។</para>"

#. Tag: title
#: index.docbook:661
#, no-c-format
msgid "The <guilabel>Address Book</guilabel> Page"
msgstr "ទំព័រ​<guilabel>សៀវភៅអាសយដ្ឋាន​</guilabel> "

#. Tag: title
#: index.docbook:664
#, no-c-format
msgid "The <guilabel>General</guilabel> Tab"
msgstr "ផ្ទាំង​ <guilabel>ទូទៅ​</guilabel>"

#. Tag: guilabel
#: index.docbook:668
#, no-c-format
msgid "Honor KDE single click"
msgstr "ចុច ​Honor KDE តែម្តង​"

#. Tag: para
#: index.docbook:669
#, no-c-format
msgid ""
"If checked, &kaddressbook; pays attention to the KDE single-click option."
msgstr ""
"បើ​បាន​ចុច​​ Kaddressbook យក​ចិត្ត​ទុកដាក់​ចំពោះ​ជម្រើស​ចុច​ KDE តែម្តង​​។​"

#. Tag: guilabel
#: index.docbook:674
#, no-c-format
msgid "Automatic Name Parsing for new addresses"
msgstr "កំពុង​ញែកឈ្មោះ​​អាសយដ្ឋាន​ថ្មី​ដោយ​ស្វ័យប្រវត្តិ​ "

#. Tag: para
#: index.docbook:675
#, no-c-format
msgid ""
"If checked, the <link linkend=\"managing-contacts-automatic-nameparsing\">"
"automatic name parsing</link> feature is used for new addresses."
msgstr ""
"បើបាន​ធីក​ <link linkend=\"managing-contacts-automatic-nameparsing\">"
"ញែក​ឈ្មោះ​ដោយ​ស្វ័យប្រវត្តិ​</link> "
"លក្ខណៈពិសេសនេះ​ត្រូវ​បានប្រើ​សម្រាប់​អាសយដ្ឋាន​ថ្មី ។​"

#. Tag: guilabel
#: index.docbook:680
#, no-c-format
msgid "Script-Hooks"
msgstr "ស្គ្រីប​-Hooks"

#. Tag: para
#: index.docbook:681
#, no-c-format
msgid ""
"Here you can specify the commands which are to be executed whenever you click "
"at a phone number or fax number link in the details page."
msgstr ""
"ទីនេះ​អ្នកអាច​បញ្ជាក់​ពាក្យបញ្ជា​ដែលត្រូវ​បាន​ប្រត្តិបត​ "
"ពេល​អ្នក​ចុច​លើ​លេខទូរស័ព្ទ​ ឬ​លេខ​ម៉ាស៊ីនទូរសារ​\n"
"ក្នុង​ទំព័រ​លម្អិត​ ។​"

#. Tag: guilabel
#: index.docbook:687
#, no-c-format
msgid "Extensions"
msgstr "ផ្នែក​បន្ថែម​ "

#. Tag: para
#: index.docbook:688
#, no-c-format
msgid ""
"In this list view you can enable and disable extensions individually and "
"configure their settings."
msgstr ""
"នៅក្នុង​ទិដ្ឋភាព​បញ្ជី​អ្នកអាច​បិទ ឬ​បើក​​ផ្នែក​បន្ថែម​ផ្ទាល់ខ្លួន​ "
"និង​ការកំណត់រចនាសម្ព័ន្ធ​របស់​ពួក​គេ​ ។​"

#. Tag: title
#: index.docbook:695
#, no-c-format
msgid "The <guilabel>Contact</guilabel> Tab"
msgstr "ផ្ទាំង​<guilabel>ទំនាក់ទំនង​</guilabel>"

#. Tag: para
#: index.docbook:696
#, no-c-format
msgid ""
"&kaddressbook; can automatically parse a name into its parts; to make sure this "
"works in many cases you can add, here, additional name parts, like prefixes, "
"suffixes and inclusions."
msgstr ""
"Kaddressbook អាច​ញែក​ឈ្មោះ​ជា​ផ្នែក​ៗ​របស់វា​ដោយស្វ័យប្រវត្តិ​ "
"ដើម្បីឲ្យ​ប្រាកដ​ថា​​ការងារ​នេះ​មាន​ច្រើន​\n"
"ករណី​ដែល​អ្នកអាច​បន្ថែម​ ការបន្ថែម​ផ្នែក​នៃ​ឈ្មោះ​ ដូចជា​ បុព្វបទ បច្ច័យ "
"និង​ការបន្ថែម​​។​"

#. Tag: guilabel
#: index.docbook:703
#, no-c-format
msgid "Prefixes"
msgstr "បុព្វបទ​"

#. Tag: para
#: index.docbook:704
#, no-c-format
msgid "Here you can manage name prefixes, like 'Prof.' or 'Dr.'."
msgstr "ទីនេះអ្នកអាច​គ្រប់គ្រង​ឈ្មោះ​​បុព្វបទ​ ដូច​ជា​ 'Prof.' ឬ 'Dr.' ។​"

#. Tag: guilabel
#: index.docbook:709
#, no-c-format
msgid "Inclusions"
msgstr "ការបន្ថែម​"

#. Tag: para
#: index.docbook:710
#, no-c-format
msgid ""
"Here you can manage name inclusions, like 'van' or 'von', which are often part "
"of Dutch or German names."
msgstr ""
"ទីនេះអ្នកអាច​គ្រប់គ្រង​ឈ្មោះ​បន្ថែម​ដូចជា​  'van' ឬ 'von' "
"ញឹក​ញាប់​ជា​ផ្នែក​នៃ​អាឡឺម៉ង់​ ឬ​ឈ្មោះ​អាឡឺម៉ង់ ។​"

#. Tag: guilabel
#: index.docbook:715
#, no-c-format
msgid "Suffixes"
msgstr "បច្ច័យ​"

#. Tag: para
#: index.docbook:716
#, no-c-format
msgid "Here you can manage name suffixes like 'Sr.' or 'Jr.'."
msgstr "ទីនេះ​អ្នកអាច​គ្រប់គ្រង​ឈ្មោះបច្ច័យ​ដូចជា​ 'Sr.' ឬ 'Jr.' ។​"

#. Tag: guilabel
#: index.docbook:721
#, no-c-format
msgid "Default Formatted Name"
msgstr "លំនាំដើម​ឈ្មោះ​ដែលបានធ្វើ​ទ្រង់ទ្រាយ​ "

#. Tag: para
#: index.docbook:722
#, no-c-format
msgid ""
"Here you can select the default type of formatted names to be used for new "
"contacts."
msgstr ""
"ទីនេះអ្នកអាច​ជ្រើស​ប្រភេទ​នៃ​ឈ្មោះលំនាំ​ដើម​​ដែល​បានធ្វើ​ទ្រង់ទ្រាយ​ "
"ដើម្បី​ប្រើ​សម្រាប់​ទំនាក់ទំនង​ថ្មី ។​"

#. Tag: title
#: index.docbook:730
#, no-c-format
msgid "The <guilabel>LDAP Lookup</guilabel> Page"
msgstr "ទំព័រ​ <guilabel>រក​មើល LDAP </guilabel> "

#. Tag: para
#: index.docbook:732
#, no-c-format
msgid ""
"On this page you can configure the LDAP servers that should be used for <link "
"linkend=\"ldap-queries\">ldap queries</link> in &kaddressbook;."
msgstr ""
"នៅ​លើ​ទំព័រ​នេះ​អ្នកអាច​កំណត់រចនាសម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ​​ LDAP "
"ដែល​គួរតែ​ត្រូវ​បានប្រើសម្រាប់​ <link linkend=\"ldap-queries\">"
"សំណួរ ldap </link> ក្នុង​ Kaddressbook ។​"

#. Tag: para
#: index.docbook:735
#, no-c-format
msgid "Use <guibutton>Add Host...</guibutton> to add and setup a new server."
msgstr ""
"ប្រើ​<guibutton>បន្ថែមម៉ាស៊ីន...</guibutton> ដើម្បី​បន្ថែម​ "
"និង​រៀប​ចំ​ម៉ាស៊ីន​បម្រើថ្មី ។​"

#. Tag: screeninfo
#: index.docbook:737
#, no-c-format
msgid "Configuring LDAP Lookup for Kolab"
msgstr "ការកំណត់​រចនាសម្ព័ន្ធ LDAP រក​មើល​ Kolab"

#. Tag: phrase
#: index.docbook:740
#, no-c-format
msgid "Example of LDAP Lookup configuration (Kolab)."
msgstr "ឧទាហរណ៍​ នៃការកំណត់រចនាសម្ព័ន្ធ​ LDAP Lookup (Kolab) ។​"

#. Tag: para
#: index.docbook:741
#, no-c-format
msgid "The Add Host dialog - Example of LDAP Lookup configuration (Kolab)."
msgstr ""
"ប្រអប់​បន្ថែម​ម៉ាស៊ីន​- ឧទាហរណ៍​ នៃ​ការកំណត់រចនាសម្ព័ន្ធ  LDAP Lookup (Kolab) "
"។​"

#. Tag: para
#: index.docbook:744
#, no-c-format
msgid ""
"You can include and exclude servers from the search by selecting or deselecting "
"their check boxes. In the server list. Press <guibutton>OK</guibutton> "
"to close the dialog."
msgstr ""
"អ្នកអាច​បញ្ចូល​ ឬបដិសេធ​ម៉ាស៊ីនបម្រើ​ពី​ការស្វែងរក​តាម​ការជ្រើស​ "
"ឬ​មិនជ្រើស​​ប្រអប់ធីក​របស់​ពួកវា​ ។\n"
"នៅ​ក្នុង​បញ្ជី​ម៉ាស៊ីនបម្រើ ។ ចុច​<guibutton>យល់ព្រម​</guibutton> "
"ដើម្បីបិទ​ប្រអប់ ។​"

#. Tag: para
#: index.docbook:747
#, no-c-format
msgid ""
"You may configure the search order by moving up or down the servers in the "
"list. This can be done using the corresponding arrows on the right side of the "
"dialog."
msgstr ""
"អ្នក​អាច​កំណត់រចនាសម្ព័ន្ធ​ស្វែងរក​លំដាប់​តាម​ការផ្លាស់ទី​ម៉ាស៊ីន​បម្រើ​ឡើង​លើ​ "
"ចុះក្រោម​ក្នុង​បញ្ជី ។ \n"
"ការនេះអាច​ធ្វើ​រួច​ប្រើ​ព្រួញ​ឆ្លើយតប​​នៅ​ផ្នែក​ខាងស្តាំ​នៃ​ប្រអប់ ។"

#. Tag: title
#: index.docbook:753
#, no-c-format
msgid "Command References"
msgstr "សេចក្តីយោ​ង​ពាក្យបញ្ជា​"

#. Tag: title
#: index.docbook:756
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu>ឯកសារ</guimenu> "

#. Tag: menuchoice
#: index.docbook:760
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New Contact</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>ឯកសារ​</guimenu> "
"<guimenuitem>ទំនាក់ទំនង​ថ្មី​</guimenuitem>"

#. Tag: para
#: index.docbook:767
#, no-c-format
msgid "<action>Opens the contact editor for adding a new contact</action>."
msgstr ""
"<action>បើក​កម្មវិធី​និពន្ធ​ទំនាក់ទំនង​​សម្រាប់បន្ថែម​ទំនាក់ទំនង​ថ្មី </action> "
"។​"

#. Tag: menuchoice
#: index.docbook:771
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Edit Contact</guimenuitem>"
msgstr ""
"<guimenu>ឯកសារ</guimenu> <guimenuitem>កែសម្រួលទំនាក់ទំនង​</guimenuitem>"

#. Tag: para
#: index.docbook:775
#, no-c-format
msgid ""
"<action>Opens the contact editor for editing the currently-selected "
"contact</action>."
msgstr ""
"<action>បើក​កម្មវិធី​ទំនាក់ទំនង​សម្រាប់​ការកែស្រួល​​ទំនាក់ទំនង​បច្ចុប្បន្ន​ដែលបា"
"នជ្រើស​​</action> ។​"

#. Tag: menuchoice
#: index.docbook:780
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា (Ctrl) <keycap>S</keycap></keycombo> "
