#: index.docbook:1000
#, no-c-format
msgid "<action>Refreshes the current view</action>."
msgstr "<action>ធ្វើ​ឲ្យ​ទិដ្ឋភាព​បច្ចុប្បន្ន​ស្រស់</action> ។"

#. Tag: title
#: index.docbook:1006
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "ម៉ឺនុយ<guimenu>ឧបករណ៍</guimenu>"

#. Tag: para
#: index.docbook:1007
#, no-c-format
msgid "This menu provides tools for acting on the contact database."
msgstr ""
"ម៉ឺនុយនេះ​ផ្តល់នូវ​ឧបករណ៍​ជា​ច្រើន​សម្រាប់​អំពើ​នៅ​លើ​​មូលដ្ឋាន​ទិន្នន័យ​ទំនាក់​"
"ទំនង​ ។​"

#. Tag: menuchoice
#: index.docbook:1011
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Lookup Addresses in Directory</guisubmenu>"
