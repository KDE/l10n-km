"<shortcut> <keycombo action=\"simul\"><keycap>លុប</keycap></keycombo> "
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>"
"លុប​ទំនាក់ទំនង​</guimenuitem>"

#. Tag: para
#: index.docbook:917
#, no-c-format
msgid "<action>Deletes the currently-selected contacts</action>."
msgstr "<action>លុប​ទំនាក់ទំនង​បច្ចុប្បន្ន​ដែល​បានជ្រើស​</action> ។​"

#. Tag: menuchoice
#: index.docbook:921
#, no-c-format
