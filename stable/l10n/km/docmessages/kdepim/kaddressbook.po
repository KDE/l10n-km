msgstr ""

#. Tag: guilabel
#: index.docbook:582
#, no-c-format
msgid "LDIF"
msgstr ""

#. Tag: para
#: index.docbook:583
#, no-c-format
msgid ""
"LDIF is a plain-text representation of LDAP data, used by Netscape and Mozilla "
"to store their addressbook data &mdash; &kaddressbook; supports import and "
"export of this format;"
msgstr ""

#. Tag: guilabel
#: index.docbook:590
#, no-c-format
msgid "<guilabel>PAB</guilabel>"
msgstr ""

#. Tag: para
#: index.docbook:591
#, no-c-format
msgid ""
"PAB is the MS Exchange Personal Address Book format, used by MS Outlook and MS "
"Outlook Express to store their contact data &mdash; &kaddressbook; supports the "
"import of this format;"
msgstr ""

#. Tag: guilabel
#: index.docbook:598
#, no-c-format
msgid "Opera"
msgstr ""

#. Tag: para
#: index.docbook:599
#, no-c-format
msgid ""
