msgstr ""
"<guimenu>ឯកសារ​</guimenu> <guimenuitem>ផ្ញើអ៊ីមែល​ទៅ​ទំនាក់ទំនង​</guimenuitem>"

#. Tag: para
#: index.docbook:822
#, no-c-format
msgid ""
"<action>Opens the preferred mail program with the currently-selected contacts "
