#: index.docbook:893
#, no-c-format
msgid ""
"<action>Copies the currently-selected contacts to the clipboard</action>."
msgstr ""
"<action>ចម្លង​ទំនាក់ទំនង​ដែល​បានជ្រើស​បច្ចុប្បន្ន​​ទៅ​ក្តារតម្រៀតខ្ទាស់​</action"
"> ។​"

#. Tag: menuchoice
#: index.docbook:898
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>V</keycap></keycombo> "
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>បិទភ្ជាប់​</guimenuitem>"

#. Tag: para
#: index.docbook:905
#, no-c-format
msgid ""
"<action>Paste the clipboard contents into the address book (if it is in a valid "
"format)</action>."
msgstr ""
"<action>បិទភ្ជាប់​មាតិកា​ក្តារតម្រៀត​ខ្ទាស់​ទៅក្នុង​សៀវភៅ​អាសយដ្ឋាន​ "
"(បើ​វា​មានទ្រង់ទ្រាយ​\n"
"ត្រឹមត្រូវ)</action> ។​"

#. Tag: menuchoice
#: index.docbook:910
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>Delete</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Delete Contact</guimenuitem>"
