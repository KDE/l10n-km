msgstr ""
"<action>បើក​ <link linkend=\"using-views\">ប្រអបើ</link> "
"សម្រាប់បង្កើត​​ទិដ្ឋភាពថ្មី</action> ។​"

#. Tag: menuchoice
#: index.docbook:979
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Modify View...</guimenuitem>"
msgstr "<guimenu>មើល​</guimenu> <guimenuitem>កែប្រែទិដ្ឋភាព...</guimenuitem>"

#. Tag: para
#: index.docbook:983
#, no-c-format
msgid ""
"<action>Opens a <link linkend=\"using-views\">dialog</link> "
"where you can modify the settings of the current view</action>."
msgstr ""
"<action>បើក​ទីតាំង​<link linkend=\"using-views\">ប្រអប់​</link> "
"អ្នកអាច​កែប្រែ​ការកំណត់​នៃ​ទិដ្ឋភាព​\n"
"បច្ចុប្បន្ន​បាន​</action> ។​"

#. Tag: menuchoice
#: index.docbook:988
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Delete View</guimenuitem>"
msgstr "<guimenu>មើល​</guimenu> <guimenuitem>លុបទិដ្ឋភាព</guimenuitem>"

#. Tag: para
#: index.docbook:992
#, no-c-format
msgid "<action>Deletes the current view</action>."
msgstr "<action>លុប​ទិដ្ឋភាពបច្ចុប្បន្ន​</action> ។​"

#. Tag: menuchoice
#: index.docbook:996
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Refresh View</guimenuitem>"
msgstr ""
"<guimenu>មើល​</guimenu> <guimenuitem>ធ្វើ​ឲ្យ​ទិដ្ឋភាពស្រស់</guimenuitem>"

