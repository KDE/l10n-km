#. Tag: parameter
#: index.docbook:3431
#, no-c-format
msgid "fromID"
msgstr "fromID"

#. Tag: para
#: index.docbook:3433
#, no-c-format
msgid ""
"The &kmail; identity to use as the sender of the email. If empty, the sender's "
"email address will be that configured in &kalarm;'s <link "
"linkend=\"preferences-email\">Email preferences</link>."
msgstr ""
"អត្តសញ្ញាណ​ Kmail ប្រើ​ជា​​អ្នក​ផ្ញើ​អ៊ីមែល ។ បើ​វាទទេ "
"អាសយដ្ឋាន​អ៊ីមែល​របស់អ្នកផ្ញើ​នឹង​ត្រូវ​បាន​កំណត់រចនាសម្ព័ន្ធ​ក្នុង​<link "
"linkend=\"preferences-email\">ចំណូល​ចិត្ត​អ៊ីមែល​</link> ​របស់ Kalarm ។​"

#. Tag: parameter
#: index.docbook:3441
#, no-c-format
msgid "addresses"
msgstr "អាសយដ្ឋាន​ "

#. Tag: para
#: index.docbook:3443
#, no-c-format
msgid "A comma separated list of recipients' email addresses."
msgstr "បញ្ជីសញ្ញាក្បៀស​នៃ​អាសយដ្ឋាន​អ៊ីមែល​របស់អ្នកទទួល ។"

#. Tag: parameter
#: index.docbook:3448
#, no-c-format
msgid "subject"
msgstr "ប្រធាន​បទ"

#. Tag: para
#: index.docbook:3450
#, no-c-format
msgid "Specifies the subject line of the email."
msgstr "បញ្ជាក់​ពី​បន្ទាត់ប្រធាន​បទនៃ​អ៊ីមែល ។"

#. Tag: para
#: index.docbook:3457
#, no-c-format
msgid "Specifies the email message body."
msgstr "បញ្ជាក់​តួ​សារអ៊ីមែល ។"

#. Tag: parameter
#: index.docbook:3462
#, no-c-format
msgid "attachments"
msgstr "ឯកសារ​ភ្ជាប់​​"

#. Tag: para
#: index.docbook:3464
#, no-c-format
msgid ""
"A comma-separated list of paths or &URL;s of files to send as email "
"attachments."
msgstr ""
"បញ្ជី​សញ្ញាក្បៀស​នៃ​ផ្លូវ ឬ​ URL "
"របស់​ឯកសារប្រើសម្រាប់​ផ្ញើឯកសារ​ភ្ជាប់តាមអ៊ីមែល ។​"

#. Tag: para
#: index.docbook:3472
#, no-c-format
msgid ""
"Specifies the scheduled date, or date and time, at which the email should be "
"sent. For a date-only alarm, the string should be in the format <quote>"
"YYYY-MM-DD</quote> (as returned by "
"<methodname>QDate::toString(Qt::ISODate)</methodname>"
"). For an alarm with a date and time, the string should be in the format <quote>"
"YYYY-MM-DDTHH:MM[:SS]</quote> (as returned by <methodname>"
"QDateTime::toString(Qt::ISODate)</methodname>) or <quote>HH:MM[:SS]</quote> "
"(as returned by <methodname>QTime::toString(Qt::ISODate)</methodname>"
"). If no date is specified, today's date is used. Note that any seconds value "
"is ignored."
msgstr ""
"បញ្ជាក់​កាលបរិច្ឆេទ ឬកាលបរិច្ឆេទ និងពេលវេលា​ដែលបាន​កំណត់ពេល​ "
"ដែល​អ៊ីមែល​គួរតែ​ផ្ញើ ។ សម្រាប់​ការជូនដំណឹង​ដែលមាន​តែ​កាលបរិច្ឆេទ "
"ខ្សែអក្សរ​ត្រូវ​មានទ្រង់ទ្រាយ​ជា​ <quote>YYYY-MM-DD</quote> "
"(ត្រឡប់តាម​<methodname>QDate::toString(Qt::ISODate)</methodname>"
") ។ សម្រាប់​ការជូន​ដំណឹង​ដែល​មាន​កាលបរិច្ឆេទ "
"និងពេលវេលា​ខ្សែអក្សរ​ត្រូវ​មានទ្រង់ទ្រាយ​ជា​<quote>YYYY-MM-DDTHH:MM[:SS]</quote> "
"(ត្រឡប់តាម​ <methodname>QDateTime::toString(Qt::ISODate)</methodname>) ឬ <quote>"
"HH:MM[:SS]</quote> (ត្រឡប់តាម​ "
"<methodname>QTime::toString(Qt::ISODate)</methodname>"
") ។ បើ​កាលបរិច្ឆេទមិន​ទាន់បាន​កំណត់​ទេ "
"កាលបរិច្ឆេទ​ថ្ងៃ​នេះ​ត្រូ​វ​បាន​គេយកទៅ​ប្រើ ។ "
"ចំណាំថា​តំម្លៃ​គិតជា​វិនាទី​គឺមិនអើពើ​ឡើយ ។"

#. Tag: para
#: index.docbook:3499
#, fuzzy, no-c-format
msgid ""
"Specifies the logical OR of the desired alarm flags. The flag bits are those "
"defined in class <classname>KAlarmIface</classname> in <filename>"
"kalarmiface.h</filename>. Note that not all flag bits are applicable to email "
"alarms."
msgstr ""
"បញ្ជាក់​ចំនួន​តក្ត​​ OR នៃ​ទង់​ជូន​ដំណឹង​ដែល​អ្នកចង់​បាន​​ ។ "
"ប៊ីត​ទង់​បាន​កំណត់​ក្នុង​ថ្នាក់ <classname>KAlarmIface</classname> "
"ក្នុង​ <filename>kalarmiface.h</filename> ។ "
"ចំណាំថា​ប៊ីតទង់ទាំងអស់​មិនអាច​រក​បាន​សម្រាប់អ៊ីមែល​ជូន​ដំណឹង ។ "

#. Tag: para
#: index.docbook:3582
#, no-c-format
msgid ""
"<function>scheduleEmail()</function> is a &DCOP; call to schedule the specified "
"email for sending at the specified date and time. Apart from specifying the "
"email header and contents and omitting the message color, font and audio file "
"parameters, its usage is identical to <link linkend=\"scheduleMessage-descrip\">"
"<function>scheduleMessage</function></link> - see the description of that "
"function for further details."
msgstr ""
"<function>scheduleEmail()</function> ជា​​ DCOP "
"សម្រាប់​ហៅ​ការកំណត់ពេល​អ៊ីមែល​ដែល​បាន​កំណត់​​សម្រាប់ផ្ញើ​ពេល​បាន​បញ្ជាក់​ការបរិច"
"្ឆេទ និង​ពេលវេលា​ ។​ ជាផ្នែក​មួយ​ដែល​បាន​មក​ពី​ការបញ្ជាក់​បឋមកថាអ៊ីមែល​ "
"និង​មាតិកា​ហើ​យ​និង​ការលុប​ពណ៌​សារ​ ប៉ារ៉ាម៉ែត្រពុម្ពអក្សរ​ "
"និ​ងឯកសារ​អូឌីយ៉ូ​ការប្រើ​ប្រាស់​របស់​វា​ដូច​ទៅ​នឹង​ <link "
"linkend=\"scheduleMessage-descrip\"><function>scheduleMessage</function></link> "
"-  សូម​មើល​ការពិពណ៌នា​នៃ​មុខងារ​លម្អិត​បន្ថែម​ ។"

