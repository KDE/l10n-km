msgstr ""
"បើក​ប្រអប់​ <link linkend=\"folders-properties-window\">លក្ខណៈសម្បត្តិ​ថ​ត</link> "
"អនុញ្ញាត​ឲ្យ​អ្នក​បង្កើត​ថត​ថ្មី ។​"

#. Tag: menuchoice
#: menus.docbook:624
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Mark All Messages as Read</guimenuitem>"
msgstr "<guimenu>ថត​</guimenu> <guimenuitem>សម្គាល់​សារទាំងអស់ថា​អាន​រួច </guimenuitem>"

