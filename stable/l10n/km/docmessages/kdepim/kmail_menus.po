msgstr "លុប​សារ​ទាំងអស់ជានិច្ច​ ។ ការនេះ​អាច​រក​បាន​បើ​បាន​ជ្រើស​ថត​បច្ចុប្បន្ន​ជា​ថត​ធុង​សំរាម​ ។"

#. Tag: menuchoice
#: menus.docbook:720
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Delete Folder</guimenuitem>"
msgstr "<guimenu>ថត</guimenu> <guimenuitem>លុបថត​</guimenuitem>"

#. Tag: para
#: menus.docbook:726
#, no-c-format
msgid "Removes the selected folder and all its contents, including subfolders."
msgstr "យក​ថត​​ និង​មាតិការរបស់វា​ដែលបានជ្រើសចេញ រួមទាំង​ថត​រង​​ ។"

#. Tag: para
#: menus.docbook:727
#, no-c-format
msgid ""
"Note that there is no way to access the contents of a folder after it has been "
"removed."
msgstr "ចំណាំថា មិន​អាច​ចូល​ដំណើរការ​មាតិកា​ថត​បន្ទាប់ពី​វា​បាន​យកវា​​ចេញឡើយ​ ។ "

#. Tag: menuchoice
#: menus.docbook:734
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Prefer HTML to Plain Text</guimenuitem>"
msgstr "<guimenu>ថត​</guimenu> <guimenuitem>ចូលចិត្តិ​ HTML ជាង​អត្ថបទធម្មតា​</guimenuitem>"

#. Tag: para
#: menus.docbook:740
#, no-c-format
#, fuzzy
msgid ""
"If enabled then &html; messages in this folders will be shown using &html; "
"rendering. For security reasons, we recommend to only activate this for folders "
"which only contain trusted messages."
msgstr ""
"បើ​បើក​សារ​ html នៅក្នុង​ថត​នេះ​វា​នឹង​បង្ហាញ​​ការប្រើ​ html"
"។ មូលហេតុ​សុវត្ថិភាព យើង​ផ្តល់អនុសាសន៍​បានតែ​ថត​ដែល​សកម្ម​ហើយ​មាន​សារ​ពិតប្រាកដ​ ។"

#. Tag: menuchoice
#: menus.docbook:748
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Thread Messages</guimenuitem>"
msgstr "<guimenu>ថត​</guimenu> <guimenuitem>ខ្សែស្រឡាយសារ​ </guimenuitem>"

#. Tag: para
#: menus.docbook:754
#, no-c-format
#, fuzzy
msgid ""
"If enabled then the messages in the message list are shown in a tree-like list, "
"with replies showing up directly under the message they reply to."
msgstr "បើបើក​សារ​នៅក្នុង​បញ្ជី​សារ​បាន​បង្ហាញ​ជា​បញ្ជី​មែកធាង​ ដែល​ឆ្លើយតប​ការបង្ហាញ​សារ​ដោយ​ផ្ទាល់​ដែលពួកគេ​ឆ្លើយតប​ទៅកាន់​។"

#. Tag: menuchoice
#: menus.docbook:762
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Thread Messages also by "
"Subject</guimenuitem>"
msgstr "<guimenu>ថត</guimenu> <guimenuitem>ក្រងសារ​តាម​ប្រធាន​បទ​</guimenuitem>"

#. Tag: para
#: menus.docbook:768
#, no-c-format
msgid ""
"If enabled then the messages are not only grouped according to special "
"information included in the messages but also according to their subject, &ie; "
"messages with the same subject are considered as being related. If many "
"messages are threaded below unrelated messages then you might want to disable "
