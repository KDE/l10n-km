"បង្ហាញ​អេក្រង់ស្វាគមន៍​ ដែលរាយ​បញ្ជី​ពីភាពខុសគ្នា​សំខាន់​រវាង កំណែ"
"Kmail និង​កំណែ​ពីមុន​របស់អ្នក "

#. Tag: menuchoice
#: menus.docbook:1440
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Tip of the Day</guimenuitem>"
msgstr "<guimenu>ជំនួយ​</guimenu> <guimenuitem>ព័ត៌មានជំនួយសម្រាប់ថ្ងៃនេះ</guimenuitem>"

#. Tag: para
#: menus.docbook:1446
#, no-c-format
msgid "This displays a dialog with useful hints for using &kmail;."
msgstr "បង្ហាញ​ប្រអប់ប្រអប់ដែល​មាន​ពាក្យណែនាំ​ពីការប្រើ​  Kmail ។​"

#. Tag: title
#: menus.docbook:1456
#, no-c-format
msgid "The Composer Window"
msgstr "បង្អួច​កម្មវិធីតែង​ "

#. Tag: menuchoice
#: menus.docbook:1465
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo>"
"</shortcut> <guimenu>Message</guimenu> <guimenuitem>New Composer</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>N</keycap></keycombo>"
"</shortcut> <guimenu>សារ​</guimenu> <guimenuitem>កម្មវិធី​តែង​ថ្មី</guimenuitem>"

#. Tag: para
#: menus.docbook:1472
#, no-c-format
msgid "Opens up a new composer window."
msgstr "បើក​បង្អួច​កម្មវិធីតែងថ្មី​ឡើង ។ "

#. Tag: menuchoice
#: menus.docbook:1478
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>New Main Window</guimenuitem>"
msgstr "<guimenu>សារ</guimenu> <guimenuitem>បង្អួច​មេ​ថ្មី​</guimenuitem>"

#. Tag: menuchoice
#: menus.docbook:1490
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></keycombo>"
"</shortcut> <guimenu>Message</guimenu> <guimenuitem>Send Now</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>ត្រឡប់​</keycap></keycombo>"
"</shortcut> <guimenu>សារ</guimenu> <guimenuitem>ផ្ញើឥឡូវ</guimenuitem>"

#. Tag: para
#: menus.docbook:1497
#, no-c-format
msgid ""
"Sends the message immediately. If you use SMTP to send your messages and the "
"SMTP server is not reachable, the message will be put into the outbox and you "
"will get an error message. You can then later send the messages in the outbox "
"using <menuchoice><guimenu>File</guimenu><guimenuitem>"
"Send Queued Messages</guimenuitem></menuchoice>."
msgstr ""
"ផ្ញើសារ​ភ្លាមៗ​ ។ បើ​អ្នកប្រើ  SMTP សម្រាប់ផ្ញើ​ ហើយ​ម៉ាស៊ីនបម្រើ SMTP មិនអាច​ទៅ​ដល់ទេ សារ​នឹង​ដាក់​ក្នុង​ប្រអប់ចេញ​ ហើយ​អ្នក​នឹង​ទទួលបាន​សារ​កំហុស​មួយ​ ។ អ្នកអាច​ផ្ញើសារ​នៅ​ក្នុង​ប្រអប់ចេញ​ពេលក្រោយ​​ដោយ​ប្រើ​ <menuchoice><guimenu>ឯកសារ​</guimenu><guimenuitem>"
"ផ្ញើសារជាជូរ</guimenuitem></menuchoice> ។​"

#. Tag: menuchoice
#: menus.docbook:1507
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Later</guimenuitem>"
msgstr "<guimenu>សារ​</guimenu> <guimenuitem>ផ្ញើពេលក្រោយ​</guimenuitem>"

#. Tag: para
#: menus.docbook:1513
#, no-c-format
msgid ""
"Queues the message in the outbox for sending it later using <menuchoice>"
"<guimenu>File</guimenu><guimenuitem>Send Queued Messages</guimenuitem>"
"</menuchoice>."
msgstr ""
"រៀបសារជាជួរ​នៅក្នុង​ប្រអប់ចេញ​សម្រាប់​ផ្ញើវា​ចេញ​ពេលក្រោយ​ដោយ​ប្រើ <menuchoice>"
"<guimenu>ឯកសារ​</guimenu><guimenuitem>ផ្ញើសារជាជួរ​</guimenuitem>"
"</menuchoice>."

#. Tag: menuchoice
#: menus.docbook:1522
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Save in Drafts Folder</guimenuitem>"
msgstr "<guimenu>សារ</guimenu> <guimenuitem>រក្សាទុក​ក្នុង​ថត​សេចក្តីព្រាង​</guimenuitem>"

#. Tag: para
#: menus.docbook:1528
#, no-c-format
msgid ""
"Save the message in the <guilabel>drafts</guilabel> folder so you can later "
"edit and send it."
msgstr "រក្សាទុកសារ​នៅក្នុង​ថត​ <guilabel>សេចក្តីព្រាង​</guilabel> ដូច្នេះអ្នកអាច​កែសម្រួល​ ហើយ​ផ្ញើវា​ពេល​ក្រោយ​ ។​"

#. Tag: menuchoice
#: menus.docbook:1535
#, no-c-format
msgid "<guimenu>Messages</guimenu> <guimenuitem>Insert File...</guimenuitem>"
msgstr "<guimenu>សារ</guimenu> <guimenuitem>បញ្ចូល​​ឯកសារ​...</guimenuitem>"

#. Tag: para
#: menus.docbook:1541
#, no-c-format
msgid "Inserts a text file into the message text, starting at the cursor position."
msgstr "បញ្ចូល​ឯកសារ​អត្ថបទ​នៅក្នុង​អត្ថបទសារ​ ពេលចាប់ផ្តើម​ទីតាំង​ទស្សទ្រនិច្ចន៍ ។"

#. Tag: menuchoice
#: menus.docbook:1548
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo>"
"</shortcut> <guimenu>Message</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>P</keycap></keycombo>"
"</shortcut> <guimenu>សារ</guimenu> <guimenuitem>បោះពុម្ព...</guimenuitem>"

#. Tag: para
#: menus.docbook:1555
#, no-c-format
msgid "Prints the current text."
msgstr "បោះពុម្ព​អត្ថបទ​បច្ចុប្បន្ន​ ។"

#. Tag: menuchoice
#: menus.docbook:1561
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo>"
"</shortcut> <guimenu>Message</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl) <keycap>W</keycap></keycombo>"
"</shortcut> <guimenu>សារ</guimenu> <guimenuitem>បិទ</guimenuitem>"

#. Tag: para
#: menus.docbook:1568
#, no-c-format
msgid "Closes this composer window."
msgstr "បិទ​បង្អួច​កម្មវិធី​តែង​ ។​"

#. Tag: para
#: menus.docbook:1591
#, no-c-format
msgid "Undo your steps in editing the current message."
msgstr "មិនធ្វើ​ជំហាន​កែសម្រួល​សារ​បច្ចុប្បន្ន​វិញ ។ "

#. Tag: menuchoice
#: menus.docbook:1597
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr "<shortcut><keycombo action=\"simul\">បញ្ជា + ប្តូរ​(Ctrl+Shift) <keycap>Z</keycap></keycombo></shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>ធ្វើវិញ</guimenuitem>"

#. Tag: para
#: menus.docbook:1604
#, no-c-format
msgid "Redo your steps in editing the current message."
msgstr "ធ្វើវិញជំហាន​ក្នុង​ការកែសម្រួល​សារ​បច្ចុប្បន្ន​របស់អ្នក​ ។​"

#. Tag: menuchoice
#: menus.docbook:1610
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>X</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>កាត់​</guimenuitem>"

#. Tag: para
#: menus.docbook:1617
#, no-c-format
msgid ""
"Cutting text works as with most editors: the selected text is removed and put "
"into the clipboard. Note that you can also select text and drag it to a new "
"position."
msgstr ""
"ការងារ​​កាត់អត្ថបទ​ជា​មួ​យ​កម្មវិធីនិពន្ធ​ ៖ អត្ថបទ​ដែលបានជ្រើស​ត្រូវ​បានយកចេញ​ ហើយ​ដាក់វា​នៅក្នុង​"
"ក្តារតម្រៀតខ្ទាស់ ។ ចំណាំថា​អ្នកក៏អាច​ជ្រើស​អត្ថបទ​ ហើយ​ទម្លាក់​ទៅក្នុង​ទីតាំង​ថ្មីផង​ដែរ ។"

#. Tag: menuchoice
#: menus.docbook:1625
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>C</keycap></keycombo> "
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>ចម្លង​</guimenuitem>"

#. Tag: para
#: menus.docbook:1633
#, no-c-format
msgid ""
"Copying text works as with most editors: the selected text is copied to the "
"clipboard. Note that you can also select text while holding the &Ctrl; key, and "
"drag it to a new position to copy it."
msgstr "ការងារ​ចម្លង​អត្ថបទ​​ជាមួយ​កម្មវិធី​និពន្ធ​​ ៖ អត្ថបទ​ដែលបានជ្រើស​ត្រូវ​បាន​ចម្ល​ងទៅកាន់​ក្តារតម្រៀតខ្ទាស់​ ។ ចំណាំថា​អ្នក​ក៏អាច​ជ្រើសអត្ថបទ​ពេល​ចុច​គ្រាប់ចុច​ បញ្ជា (Ctrl) ហើយ​ទម្លាក់វា​ក្នុង​ទីតាំង​ថ្មី​ដើម្បី​ចម្លង​វា​។ "

#. Tag: menuchoice
#: menus.docbook:1641
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>V</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>បិទភ្ជាប់​</guimenuitem>"

#. Tag: para
#: menus.docbook:1648
#, no-c-format
msgid ""
"Pasting works the same as with most editors: the text from the clipboard is "
"pasted at the current cursor position."
msgstr ""
"ការងារ​​បិទភ្ជាប់ជាមួយ​កម្មវិធីនិពន្ធ​ ៖ អត្ថបទ​បានមកពី​ក្តារតម្រៀត​ខ្ទាស់​ដែលបានបិទភ្ជាប់​​​នៅទីតាំង​"
"ទស្សទ្រនិច្ច​បច្ចុប្បន្ន ។"

#. Tag: menuchoice
#: menus.docbook:1655
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>ជ្រើស​ទាំងអស់</guimenuitem>"

#. Tag: para
#: menus.docbook:1662
#, no-c-format
msgid "Selects all of the text in your message."
