#. Tag: menuchoice
#: menus.docbook:545
#, no-c-format
msgid ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>Go</guimenu> <guimenuitem>"
"Previous Unread Message</guimenuitem>"
msgstr ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>ទៅ​</guimenu> <guimenuitem>"
"សារ​មិនទាន់អាន​មុន​ </guimenuitem>"

#. Tag: para
#: menus.docbook:552
#, no-c-format
msgid ""
"Selects the previous unread message in the message list. If there is no unread "
"message above the currently selected message then the behavior depends on the "
"value of the <xref linkend=\"configure-misc-folders-go-unread\"/> option."
msgstr ""
"ជ្រើស​សារ​មិនទាន់អាន​មុន​ក្នុង​បញ្ជី​សារ​ ។ បើគ្មាន​សារ​មិនទាន់អាន​ខាងលើ​ជ្រើស​សារ​បច្ចុប្បន្ន​ ហើយ​ឥរិយាបទ​ពឹងផ្អែក​លើ​តម្លៃ​ជម្រើស​"
" <xref linkend=\"configure-misc-folders-go-unread\"/> ។ "

#. Tag: menuchoice
#: menus.docbook:561
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>+</keycap></keycombo>"
"</shortcut> <guimenu>Go</guimenu> <guimenuitem>Next Unread Folder</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>+</keycap></keycombo>"
"</shortcut> <guimenu>ទៅ​</guimenu> <guimenuitem>ថត​មិនទាន់​អាន​បន្ទាប់​</guimenuitem>"

#. Tag: para
#: menus.docbook:568
#, no-c-format
msgid "Jumps to the the next folder with unread messages."
msgstr "លោត​ទៅ​ថត​បន្ទាប់​ដែល​មានថត​មិនទាន់​អាន​ ។"

#. Tag: menuchoice
#: menus.docbook:574
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>-</keycap></keycombo>"
"</shortcut> <guimenu>Go</guimenu> <guimenuitem>Previous Unread "
"Folder</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>-</keycap></keycombo>"
"</shortcut> <guimenu>ទៅ</guimenu> <guimenuitem>ថតមិនទាន់អាន​មុន​</guimenuitem>"

#. Tag: para
#: menus.docbook:581
#, no-c-format
msgid "Jumps to the the previous folder with unread messages."
msgstr "លោតទៅ​ថត​មុន​ដែលមាន​សារ​មិនទាន់អាន​ ។"

#. Tag: menuchoice
#: menus.docbook:587
#, no-c-format
msgid ""
"<shortcut><keycap>Space</keycap></shortcut> <guimenu>Go</guimenu> <guimenuitem>"
"Next Unread Text</guimenuitem>"
msgstr "<shortcut><keycap>ចន្លោះមើល​មិនឃើញ​</keycap></shortcut> <guimenu>ទៅ</guimenu> <guimenuitem>អត្ថបទមិនទាន់អានបន្ទាប់ </guimenuitem>"

#. Tag: para
#: menus.docbook:594
#, no-c-format
msgid ""
"Scrolls down if you are not yet at the bottom of a message, otherwise jumps to "
"the next unread message."
msgstr "រមូរចុះ​បើ​អ្នក​មិន​ទាន់​ទៅដល់​បាតសារ​  មិនដូច្នេះទេ​វា​លោត​ទៅ​សារ​មិនទាន់អាន​បន្ទាប់ ។"

#. Tag: title
#: menus.docbook:605
#, no-c-format
msgid "<guimenu>Folder</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ថត</guimenu>"

#. Tag: menuchoice
#: menus.docbook:611
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>New Folder...</guimenuitem>"
msgstr "<guimenu>ថត</guimenu> <guimenuitem>ថតថ្មី...</guimenuitem>"

#. Tag: para
#: menus.docbook:617
#, no-c-format
msgid ""
"Opens the <link linkend=\"folders-properties-window\">Folder Properties</link> "
