msgstr ""
"លុប​សារ​ចាស់ៗ​ពី​ថត​បច្ចុប្បន្ន​ ឬផ្លាស់ទីពួកវា​ទៅថត​ផ្សេងទៀត​ អាស្រ័យលើ​ក្បួន​ក្នុងប្រអប់​​"
" <guilabel>លក្ខណៈសម្បត្តិ​</guilabel> របស់ថត​"
"(លំនាំដើម​មិន​លុប​ ឬផ្លាស់ទី​សារ​ចាស់ៗ​ឡើយ​)​ ។ ជាធម្មតា​ Kmail នឹង​ធ្វើដូចនេះ​ដោយ​ស្វ័យប្រវត្តិ​"
"ក្រោម​កាលៈទេសៈជាក់ស្តែង​ដែលអ្នកចង់​ធ្វើ​ឲ្យ​ថត​ផុត​កំណត់​ដោយ​ដៃ ។ "

#. Tag: menuchoice
#: menus.docbook:665
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>*</keycap></keycombo>"
"</shortcut> <guimenu>Folder</guimenu> <guimenuitem>Remove Duplicate "
"Messages</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl) <keycap>*</keycap></keycombo>"
"</shortcut> <guimenu>ថត​</guimenu> <guimenuitem>យក​សារ​ស្ទួន​គ្នា​ចេញ </guimenuitem>"

#. Tag: para
#: menus.docbook:672
#, no-c-format
msgid "Searches the folder for duplicate messages and deletes the duplicates."
msgstr "ស្វែងរក​ថតសារ​ស្ទួន​ ហើយ​លុប​សារ​ស្ទួន​ចេញ ។"

#. Tag: menuchoice
#: menus.docbook:679
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>Folder</guimenu> <guimenuitem>"
"Check Mail in This Folder</guimenuitem>"
msgstr ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>ថត​</guimenu> <guimenuitem>"
"មើល​សំបុត្រ​នៅក្នុង​ថត​នេះ </guimenuitem>"

#. Tag: para
#: menus.docbook:686
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder. This is only "
"available for &imap; folders."
msgstr ""
"មើល​សំបុត្រ​ពេល​សំបុត្រ​ថ្មីមក​ដល់​ក្នុង​ថត​បច្ចុប្បន្ន​ដែល​បានជ្រើស​ ។ "
"វា​អាច​រក​បាន​តែថត​ IMAP ។​"

#. Tag: menuchoice
#: menus.docbook:693
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Move All Messages to Trash</guimenuitem>"
msgstr "<guimenu>ថត​</guimenu> <guimenuitem>ផ្លាស់ទី​សារ​ទាំងអស់​ទៅ​ធុងសំរាម​</guimenuitem>"

#. Tag: para
#: menus.docbook:699
#, no-c-format
msgid ""
"Moves all of the messages in the selected folder into the trash folder. This is "
