#. Tag: title
#: menus.docbook:32
#, no-c-format
msgid "Menu Entries"
msgstr "ធាតុ​ម៉ឺនុយ​"

#. Tag: para
#: menus.docbook:34
#, no-c-format
msgid ""
"Each menu item is discussed below. When there is a keyboard shortcut that "
"performs a menu item function, the default shortcut is listed with the menu "
"item."
msgstr ""
"ធាតុ​ម៉ឺនុយនីមួយៗបាន​លើក​យក​មក​ពិភ្សា​ដូចខាងក្រោយ​នេះ ។ ពេល​មុខងារ​ធាតុ​ម៉ឺនុយ​បង្ហាញ​ផ្លូវ​កាត់ "
"​ក្តារចុច​ ផ្លូវកាត់​លំនាំដើម​បានរាយ​បញ្ជី​​ធាតុ​ម៉ឺនុយដែល​មាន ។ "

#. Tag: title
#: menus.docbook:38
#, no-c-format
msgid "The Main Window"
msgstr "បង្អួចមេ​"

#. Tag: title
#: menus.docbook:41
#, no-c-format
msgid "<guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ​ <guimenu>ឯកសារ​</guimenu> "

#. Tag: menuchoice
#: menus.docbook:46
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>បង្អួច​ថ្មី</guimenuitem>"

#. Tag: para
#: menus.docbook:52 menus.docbook:1484
#, no-c-format
msgid "Creates a new main window."
msgstr "បង្កើត​បង្អួច​មេថ្មី "

#. Tag: menuchoice
#: menus.docbook:58
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl) <keycap>O</keycap></keycombo>"
"</shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>បើក​...</guimenuitem>"

#. Tag: para
#: menus.docbook:65
#, no-c-format
msgid "Allows you to open files which contain email messages."
msgstr "អនុញ្ញាត​ឲ្យអ្នក​បើក​ឯកសារ​ដែលមាន​សារអ៊ីមែល ។​"

#. Tag: menuchoice
#: menus.docbook:71
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>S</keycap></keycombo>"
"</shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>រក្សាទុកជា​...</guimenuitem>"

#. Tag: para
#: menus.docbook:78
#, no-c-format
msgid ""
"Saves the currently displayed message to a text file, including all the headers "
"and attachments."
msgstr "រក្សាទុក​សារ​ដែលបានបង្ហាញបច្ចុប្បន្ន​ទៅជា​ឯកសារ​អត្ថបទ​ រួម​បញ្ចូលទាំង​ឯកសារ​ភ្ជាប់​ និង​បឋមកថា​ ។"

#. Tag: menuchoice
#: menus.docbook:85
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា​ (Ctrl)<keycap>P</keycap></keycombo>"
"</shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>បោះពុម្ព​...</guimenuitem>"

#. Tag: para
#: menus.docbook:92
#, no-c-format
msgid "Display a dialog that lets you prints the currently displayed message."
msgstr "បង្ហាញ​ប្រអប់​ដែលអនុញ្ញាត​ឲ្យ​អ្នក​​បោះពុម្ព​សារ​ដែលបានបង្ហាញ​បច្ចុប្បន្ន ។"

#. Tag: menuchoice
#: menus.docbook:98
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Compact All Folders</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>បង្រួម​ថត​ទាំងអស់</guimenuitem>"

#. Tag: para
#: menus.docbook:103
#, no-c-format
msgid ""
"Will compact all folders, &ie; it will really move and delete the messages on "
"disk according to how you have moved and deleted them in &kmail;."
msgstr "បង្រួម​ថត​ទាំងអស់​ ឧទាហរណ៍ វា​នឹង​ផ្លាស់ទី​ ហើយ​លុប​សារ​នៅលើ​ឌីសអស្រ័យលើ​​ថាតើ​អ្នក​បានផ្លាស់ទី​ ឬ​លុប​ពួកវា​ក្នុង​ Kmail យ៉ាងដូចម្តេច ។"

#. Tag: menuchoice
#: menus.docbook:110
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Expire All Folders</guimenuitem>"
msgstr "<guimenu>​ឯកសារ</guimenu> <guimenuitem>ធ្វើឲ្យថត​ទាំងអស់ផុត​កំណត់</guimenuitem>"

#. Tag: para
#: menus.docbook:115
#, no-c-format
msgid ""
"Delete old messages from all folders, according to the rules in each folder's "
"<link linkend=\"folders-properties-window\">Properties dialog</link> "
"(the default is not to delete old messages at all)."
msgstr ""
"លុប​សារ​ចាស់ៗ​ពី​ថត​ទាំងអស់​ អាស្រ័យលើ​ក្បួន​ក្នុង​ប្រអប់​"
"<link linkend=\"folders-properties-window\">លក្ខណៈ​សម្បត្តិ</link> របស់​ថត​នីមួយៗ​"
"(បើ​តាម​លំនាំដើម​វាមិនលុប​ថត​ចាស់ៗ​ចោល​ទេ) ។"

#. Tag: menuchoice
#: menus.docbook:123
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Refresh Local &imap; Cache</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>ធ្វើ​ឲ្យ​ឃ្លាំង​សម្ងាត់​ IMAP ស្រស់​</guimenuitem>"

#. Tag: para
#: menus.docbook:128
#, no-c-format
msgid ""
"This will remove all changes that you have done locally to your IMAP folders "
"and redownload everything from the server. Use this if the local cache was "
"corrupted."
msgstr ""
"ការនេះ​នឹង​លុប​ការផ្លាស់ប្តូរ​ដែល​អ្នក​បានធ្វើរួច​ទាំងអស់ចេញ​ពី​ថត​មូល​ដ្ឋាន​ IMAP របស់អ្នក​ ហើយ​ទាញ "
"យក​អ្វីៗគ្រប់យ៉ាង​ពី​ម៉ាស៊ីន​បម្រើ​ឡើងវិញ ។ ប្រើ​វិធីសាស្ត្រ​នេះ​បើ​ឃ្លាំងសម្ងាត់​មូលដ្ឋាន​​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ខូច ។"

#. Tag: menuchoice
#: menus.docbook:136
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Empty All Trash Folders</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>សម្អាត​ថត​ធុង​សំរាម​ទាំងអស់</guimenuitem>"

#. Tag: para
#: menus.docbook:141
#, no-c-format
msgid ""
"Use this to empty all trash folders, &ie; the local trash folder and all trash "
"folders that you might have on &imap; servers."
msgstr "ប្រើ​វា​ដើម្បី​លុប​ថត​ធុង​សំរាម​ទាំងអស់ ឧទាហរណ៍ មូលដ្ឋាន​ថត​ធុងសំរាម​ និង​ថត​ធុង​សំរាម​ទាំងអស់​ដែលអ្នក​មាន​នៅលើ​ម៉ាស៊ីន​បម្រើ​​ IMAP ។​"

#. Tag: menuchoice
#: menus.docbook:148
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Check Mail</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>L</keycap></keycombo>"
"</shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>ពិនិត្យ​សំបុត្រ​</guimenuitem>"

#. Tag: para
#: menus.docbook:154
#, no-c-format
msgid ""
"Checks for new messages in all your accounts, except those that have <guilabel>"
"Exclude from &quot;Check Mail&quot;</guilabel> enabled."
msgstr ""
"ធីក​សារ​ថ្មី​នៅក្នុង​គណនី​របស់អ្នក លើកលែង​តែ​ពួកវា​ទាំងអស់​នោះបានបដិសេធបើក​​ពី <guilabel>"
" ពិនិត្យ​សំបុត្រ​</guilabel> "

#. Tag: menuchoice
#: menus.docbook:161
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Check Mail In</guisubmenu>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guisubmenu>ពិនិត្រ​សំបុត្រ​នៅក្នុង​</guisubmenu>"

#. Tag: para
#: menus.docbook:167
#, no-c-format
msgid "Submenu that lets you check for new messages from a particular account."
msgstr "ម៉ឺនុយ​រង​អនុញ្ញាត​ឲ្យ​អ្នកពិនិត្យ​សារថ្មី ពី​គណនី​ដែល​ត្រឹមត្រូវ ។"

#. Tag: menuchoice
#: menus.docbook:173
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Send Queued Messages</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>ផ្ញើសារ​ជាជួរ​តាម​រយៈ</guimenuitem>"

#. Tag: para
#: menus.docbook:178
#, no-c-format
msgid "Sends the messages that are in your outbox."
msgstr "ផ្ញើសារ​ដែល​មាននៅ​ក្នុង​ប្រអប់​ចេញ​របស់អ្នក ។"

#. Tag: menuchoice
#: menus.docbook:184
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo>"
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>Q</keycap></keycombo>"
"</shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>ចេញ</guimenuitem>"

#. Tag: para
#: menus.docbook:191
#, no-c-format
msgid ""
"Closes the current main window or exits &kmail; if there is only this one "
"window."
msgstr "បិទ​បង្អួច​មេ​បច្ចុប្បន្ន​របស់ Kmail ដែល​មានរួចហើយ​បើ​មាន​តែ​បង្អួច​មួយ ។​"

#. Tag: title
#: menus.docbook:202 menus.docbook:1578
#, no-c-format
msgid "<guimenu>Edit</guimenu> Menu"
msgstr "ម៉ឺនុយ<guimenu>កែសម្រួល</guimenu>"

#. Tag: menuchoice
#: menus.docbook:208 menus.docbook:1584
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>មិនធ្វើវិញ​</guimenuitem>"

#. Tag: para
#: menus.docbook:215
#, no-c-format
msgid ""
"Revokes your last move or delete action. Note that you cannot undo a deletion "
"in the trash."
msgstr ""
"ដកហូត​អំពើ​ផ្លាស់ទី ឬ​លុប​ចុង​ក្រោយ​ឡើង​វិញ  ។ ចំណាំថា​អ្នកមិន​អាច​ធ្វើ​ការលុប​វិញ​ក្នុង​ធុងសំរាម​បាន​"
"ឡើយ ។"

#. Tag: menuchoice
#: menus.docbook:222
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl) <keycap>C</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>ចម្លង​</guimenuitem>"

#. Tag: para
#: menus.docbook:229
#, no-c-format
msgid "Copies selected text to the clipboard."
msgstr "ចម្លង​អត្ថបទ​ដែលបានជ្រើស​​ទៅកាន់ក្តារតម្រៀតខ្ទាស់ ។"

#. Tag: menuchoice
#: menus.docbook:235
#, no-c-format
msgid ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>Edit</guimenu> <guimenuitem>"
"Edit Message</guimenuitem>"
msgstr ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>"
"កែសម្រួល​សារ​</guimenuitem>"

#. Tag: para
#: menus.docbook:242
#, no-c-format
msgid ""
"Edits the selected message if it is editable. Only messages in the <guilabel>"
"outbox</guilabel> and <guilabel>drafts</guilabel> folder can be edited."
msgstr ""
"កែសម្រួល​សារ​ដែល​បាន​ជ្រើស​ បើ​វា​អាច​កែសម្រួល​បាន​ ។ មាន​តែ​សារ​នៅក្នុង​ <guilabel>ថត​"
"ប្រអប់ចេញ​</guilabel> និង​ <guilabel>សេចក្តីព្រាង​</guilabel> ទេ​ដែល​អាច​កែសម្រួល​បាន​ ។"

#. Tag: menuchoice
#: menus.docbook:249
#, no-c-format
msgid ""
"<shortcut><keycap>Delete</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Move to Trash</guimenuitem>"
msgstr ""
"<shortcut><keycap>លុប​</keycap></shortcut> <guimenu>កែសម្រួល​</guimenu> "
"<guimenuitem>ផ្លាស់ទីទៅធុង​សំរាម​</guimenuitem>"

#. Tag: para
#: menus.docbook:256
#, no-c-format
msgid ""
"Moves the selected messages to the trash folder. If the selected messages are "
"already in the trash folder, they will really be deleted."
msgstr "ផ្លាស់ទី​សារ​ដែល​បានជ្រើស​ទៅ​ថត​ធុង​សំរាម​ ។ បើ​បានជ្រើស​សារ​នៅក្នុង​ថត​ធុង​សំរាម​ ពួកវា​ពិត​ជា​ត្រូវ​បាន​លុប​ ។"

#. Tag: menuchoice
#: menus.docbook:263
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>Delete</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Delete</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">ប្តូរ (Shift)<keycap>លុប</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>លុប</guimenuitem>"

#. Tag: para
#: menus.docbook:270
#, no-c-format
msgid ""
"Deletes the selected messages. There is no way to recover the messages once "
"they are deleted with this command."
msgstr ""
"លុប​សារ​ដែល​បានជ្រើស​ ។ គ្មាន​វិធីណា​ដែលអាចយក​សារ​ដែល​ពួក​គេ​បាន​លុប​ដោយ​ពាក្យ​បញ្ជា​នេះវិញ​"
"បាន​​ឡើយ។ "

#. Tag: menuchoice
#: menus.docbook:277
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find in "
"Message...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>រកនៅ​ក្នុង​សារ...</guimenuitem>"

#. Tag: para
#: menus.docbook:284
#, no-c-format
msgid "Lets you search for a string in the currently displayed message."
msgstr "អនុញ្ញាត​ឲ្យ​អ្នក​ស្វែងរក​ខ្សែអក្សរ​សារ​ដែល​បាន​បង្ហាញ​បច្ចុប្បន្ន​ ។"

#. Tag: menuchoice
#: menus.docbook:290
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All "
"Messages</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>ជ្រើស​សារទាំងអស់​</guimenuitem>"

#. Tag: para
#: menus.docbook:297
#, no-c-format
msgid "Selects all messages in the current folder."
msgstr "ជ្រើសសារ​ទាំងអស់​នៅក្នុង​ថត​បច្ចុប្បន្ន​ ។​"

#. Tag: menuchoice
#: menus.docbook:303
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select Message "
"Text</guimenuitem>"
msgstr "<shortcut><keycombo action=\"simul\">បញ្ជា+ប្តូរ​(Ctrl+Shift) <keycap>A</keycap></keycombo></shortcut> <guimenu>កែសម្រួល​</guimenu> <guimenuitem>ជ្រើស​អត្ថបទ​ទាំងអស់</guimenuitem>"

#. Tag: para
#: menus.docbook:310
#, no-c-format
msgid "Selects the text of the currently displayed message."
msgstr "ជ្រើស​អត្ថបទទាំងអស់​នៃ​សារ​ដែលបាន​បង្ហាញ​បច្ចុប្បន្ន​ ។"

#. Tag: title
#: menus.docbook:320 menus.docbook:1759
#, no-c-format
msgid "<guimenu>View</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>មើល​</guimenu>"

#. Tag: menuchoice
#: menus.docbook:326
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Headers</guimenuitem>"
msgstr "<guimenu>មើល​</guimenu> <guimenuitem>បឋមកថា​</guimenuitem>"

#. Tag: para
#: menus.docbook:332
#, no-c-format
msgid ""
"Changes the format of the message header in the <guilabel>"
"Message pane</guilabel>."
msgstr "ផ្លាស់ប្តូរ​ទ្រង់ទ្រាយ​នៃ​បឋមកថា​សារ​នៅក្នុង​ <guilabel>បន្ទះ​សារ​</guilabel> ។"

#. Tag: menuchoice
#: menus.docbook:338
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Attachments</guimenuitem>"
msgstr "<guimenu>មើល​</guimenu> <guimenuitem>ឯកសារ​ភ្ជាប់​</guimenuitem>"

#. Tag: para
#: menus.docbook:344
#, no-c-format
#, fuzzy
msgid ""
"Changes the way attachments appear in the <guilabel>Message pane</guilabel> "
"(independent of the MIME Tree). With <guimenuitem>As Icons</guimenuitem> "
"all attachments appear as icons at the bottom of the message. <guimenuitem>"
"Smart</guimenuitem> will show attachments as icons, unless the message suggests "
"that they should be displayed inline. You can suggest that certain attachments "
"should be shown inline in your own messages when you select <guilabel>"
"Suggest automatic display</guilabel> in the attachment's properties dialog. "
"<guimenuitem>Inline</guimenuitem> shows the contents of the attachments at the "
"bottom of the message. Attachments that cannot be displayed, &eg; compressed "
"files, will still be shown as an icon. <guimenuitem>Hide</guimenuitem> "
"will not show attachments."
msgstr ""
"ផ្លាស់ប្តូរ​វិធី​លេចឡើង​ឯកសារ​ភ្ជាប់​នៅក្នុង​ <guilabel>បន្ទះសារ​</guilabel> "
"(មែកធាង​ឯករាជ្យ​នៃ​ MIME ) ។ <guimenuitem>រូបតំណាង​</guimenuitem> "
"ឯកសារ​ភ្ជាប់​លេចឡើង​ទាំងអស់​​ជា​រូបតំណាង​នៅបាត​នៃ​សារ​។ <guimenuitem>"
"វា​នឹង​</guimenuitem> បង្ហាញ​ឯកសារ​ភ្ជាប់ជា​រូបតំណាង​ លុះត្រាតែសារ​ផ្តល់យោបល់​​ថា​ពួក​វា​គួរ​តែ​"
"បង្ហាញក្នុង​តួ​ ។ អ្នក​អា​ច​ផ្តល់យោបល់​ថាឯកសារ​ភ្ជាប់​គួរតែ​បង្ហាញ​ជាតួ​នៅក្នុង​ថត​ផ្ទាល់​របស់អ្នក ពេលអ្នកជ្រើស​ <guilabel>បង្ហាញ​ផ្តល់យោបល់​ស្វ័យប្រវត្តិ​ </guilabel> នៅក្នុង​ប្រអប់​លក្ខណៈសម្បត្តិ​របស់ "
"ឯកសារភ្ជាប់ ។ បង្ហាញមាតិកា​ <guimenuitem>ក្នុង​តួ​ួ​</guimenuitem>នៃ​ឯកសារ​ភ្ជាប់​បាត​សារ​ ។."
"ឯកសារភ្ជាប់​​មិន​អាច​បង្ហាញ​ ឧទាហរណ៍​ ឯកសារ​ដែល​បានបង្ហាប់​ នៅ​តែ​បង្ហាញ​រូបតំណាង​ ។. <guimenuitemលាក់​e</guimenuitem>មិន​បង្ហាញ​ឯកសារ​ភ្ជាប់ ។."

#. Tag: menuchoice
#: menus.docbook:362
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Unread Column</guimenuitem>"
msgstr "<guimenu>មើល​</guimenu> <guimenuitem>ជួរឈរ​ដែល​មិនទាន់អាន​</guimenuitem>"

#. Tag: para
#: menus.docbook:368
#, no-c-format
msgid ""
"Allows you to specify whether the number of unread messages should be shown in "
"parentheses next to the folder name (<guilabel>View After Folder Name</guilabel>"
") or in a separate column (<guilabel>View in Separate Column</guilabel>)"
msgstr ""
"អនុញ្ញាត​ឲ្យអ្នក​បញ្ជាក់​ចំនួន​នៃ​សារ​ដែល​មិនទាន់​អានបង្ហាញ​ក្នុង​វង់ក្រចក​បន្ទាប់​ឈ្មោះ​ថត​"
" (<guilabel>មើលឈ្មោះថត​បន្ទាប់​</guilabel>) ឬ​ ក្នុងជួរឈរ​ដាក់ដោយ​ឡែក​"
"(<guilabel>មើល​ក្នុង​ជួរឈរ​ដាក់ដោយ​ឡែក​</guilabel>)"

#. Tag: menuchoice
#: menus.docbook:377
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Total Column</guimenuitem>"
msgstr "<guimenu>មើល​</guimenu> <guimenuitem>ជួរឈរ​សរុប​</guimenuitem>"

#. Tag: para
#: menus.docbook:383
#, no-c-format
msgid ""
"Display a column in the list of folders which shows the number of messages per "
"folder."
msgstr "បង្ហាញ​ជួរឈរ​ក្នុង​​បញ្ជី​ថត​ដែលបង្ហាញ​ចំនួន​សារ​ក្នុង​ថត​មុន​ ​។ "

#. Tag: menuchoice
#: menus.docbook:390
#, no-c-format
msgid ""
"<shortcut><keycap>.</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>"
"Expand Thread</guimenuitem>"
msgstr ""
"<shortcut><keycap>.</keycap></shortcut> <guimenu>មើល​</guimenu> <guimenuitem>"
"ពង្រីក​ខ្សែស្រឡាយ​</guimenuitem>"

#. Tag: para
#: menus.docbook:397
#, no-c-format
msgid ""
"If <menuchoice><guimenu>Folder</guimenu><guimenuitem>"
"Thread Messages</guimenuitem> </menuchoice> is activated, this will display the "
"thread of the current message, &ie; all messages that are replies to the "
"current message."
msgstr ""
"បើធ្វើ​ឲ្យ​​ <menuchoice><guimenu>ថត</guimenu><guimenuitem>"
"សារ​ខ្សែស្រឡាយ​</guimenuitem> </menuchoice> សកម្ម​ ការនេះ​នឹង​បង្ហាញ​ខ្សែស្រឡាយ​សារ​បច្ចុប្បន្ន​​ឧទារហណ៍​ សារ​ទាំងអស់​ឆ្លើយតប​ទៅនឹង​សារ​បច្ចុប្បន្ន ។"

#. Tag: menuchoice
#: menus.docbook:405
#, no-c-format
msgid ""
"<shortcut><keycap>,</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>"
"Collapse Thread</guimenuitem>"
msgstr ""
"<shortcut><keycap>,</keycap></shortcut> <guimenu>មើល​</guimenu> <guimenuitem>"
"វេញខ្សែស្រឡាយ</guimenuitem>"

#. Tag: para
#: menus.docbook:412
#, no-c-format
msgid ""
"If <menuchoice><guimenu>Folder</guimenu><guimenuitem>"
"Thread Messages</guimenuitem> </menuchoice> is activated, this will hide the "
"thread of the current message, &ie; it will hide all messages that are replies "
"to the current message."
msgstr ""
"បើ​ធ្វើ​ឲ្យ​ <menuchoice><guimenu>ថត</guimenu><guimenuitem>"
"សារខ្សែស្រឡាយ​</guimenuitem> </menuchoice> សកម្ម ការនេះ​នឹង​លាក់​ខ្សែស្រឡាយ​សារ​បច្ចុប្បន្ន​  "
"ឧទាហរណ៍​ វា​នឹង​លាក់សារ​ទាំងអស់​ដែលឆ្លើយតប​ទៅ​សារ​បច្ចុប្បន្ន ។"

#. Tag: menuchoice
#: menus.docbook:420
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>.</keycap></keycombo>"
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Expand All "
"Threads</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>.</keycap></keycombo>"
"</shortcut> <guimenu>មើល​</guimenu> <guimenuitem>ពង្រីកខ្សែស្រឡាយ​ទាំងអស់ </guimenuitem>"

#. Tag: para
#: menus.docbook:427
#, no-c-format
msgid "Expands all threads in the current folder."
msgstr "ពង្រីក​ខ្សែស្រឡាយ​ទាំងអស់ក្នុង​ថត​បច្ចុប្បន្ន ។​"

#. Tag: menuchoice
#: menus.docbook:433
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>,</keycap></keycombo>"
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Collapse All "
"Threads</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា (Ctrl)<keycap>,</keycap></keycombo>"
"</shortcut> <guimenu>មើល​</guimenu> <guimenuitem>វេញ​ខ្សែស្រឡាយ​ទាំងអស់</guimenuitem>"

#. Tag: para
#: menus.docbook:440
#, no-c-format
msgid "Collapses all threads in the current folder."
msgstr "វេញ​ខ្សែស្រឡាយ​ទាំងអស់​ក្នុង​ថត​បច្ចុប្បន្ន ។"

#. Tag: menuchoice
#: menus.docbook:446
#, no-c-format
msgid ""
"<shortcut><keycap>V</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>"
"View Source</guimenuitem>"
msgstr ""
"<shortcut><keycap>V</keycap></shortcut> <guimenu>មើល​</guimenu> <guimenuitem>"
"ប្រភព​</guimenuitem>"

#. Tag: para
#: menus.docbook:453
#, no-c-format
msgid ""
"Shows the message and its complete headers in plain text format in a new "
"window. This can be useful to find out the origin of a mail. You should know "
"that it is easy to fake the <literal>From:</literal> "
"header of a mail, but one can still find out which mail servers have been used "
"to send the message by looking at the <literal>Received:</literal> "
"lines in the header."
msgstr ""
"បង្ហាញ​សារ​ និង​បឋមកថា​ទាំងស្រុង​របស់វា​ជាទ្រង់ទ្រាយ​អត្ថបទ​ធម្មតា​​ក្នុង​បង្អួច​ថ្មី ។ អត្ថប្រយោជន៍​នេះ "
"ដើម្បី​រក​ឲ្យឃើញ​សារ​ដើម​ ។ អ្នក​គួរតែ​ដឹង​ថា​វា​ងាយស្រួលន្លំ​"
" <literal>ពី៖</literal> បឋមកថា​សំបុត្រ ប៉ុន្តែអ្នកនៅតែអាច​រក​ឃើញ​​ម៉ាស៊ីន​បម្រើសំបុត្រ​​ដែ​ល​បាន​ប្រើ​"
"​សម្រាប់ផ្ញើ​សារ​តាម​ការរក​មើល​បន្ទាប់​<literal>អ្នកទទួល​ ៖</literal> ក្នុង​បឋមកថា​​ ។​"

#. Tag: menuchoice
#: menus.docbook:463
#, no-c-format
msgid ""
"<shortcut><keycap>X</keycap></shortcut> <guimenu>View</guimenu> <guimenuitem>"
"Use Fixed Font</guimenuitem>"
msgstr ""
"<shortcut><keycap>X</keycap></shortcut> <guimenu>មើល​</guimenu> <guimenuitem>"
"ប្រើ​ពុម្ពអក្សរ​ថេរ​​ </guimenuitem>"

#. Tag: para
#: menus.docbook:470
#, no-c-format
msgid ""
"Uses a fixed width (monospaced) font to display the messages in the current "
"folder. The font to be used can be configured in the <guilabel>"
"Appearance</guilabel> section of &kmail;'s configuration dialog."
msgstr ""
"ប្រើទទឹងពុម្ពអក្សរ​ថេ​ (monospaced) ដើម្បី​បង្ហាញ​សារ​ក្នុង​ថត​បច្ចុប្បន្ន ។ ​ពុម្ពអក្សរ​ដែល​ប្រើអាច​កំណត់ "
"រចនាសម្ព័ន្ធ​ក្នុង​ភាគ​<guilabel>រូបរាង​</guilabel> នៃ​ប្រអប់​ការកំណត់រចនាសម្ព័ន្ធ​របស់ Kmail ។"

#. Tag: menuchoice
#: menus.docbook:479
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Set Encoding</guisubmenu>"
msgstr "<guimenu>មើល​</guimenu> <guisubmenu>កំណត់អ៊ិនកូដឌីង​</guisubmenu>"

#. Tag: para
#: menus.docbook:485
#, no-c-format
msgid ""
"Lets you choose the character encoding to be used in the Message Pane. The "
"default, <guilabel>Auto</guilabel>, should work in almost all cases."
msgstr ""
"អនុញ្ញាត​ឲ្យអ្នក​ជ្រើស​តួអក្សរ​អ៊ិនកូដឌីង​ប្រើ​ក្នុង​បន្ទះសារ​ ។ "
"លំនាំដើម​ <guilabel>ស្វ័យប្រវត្តិ​</guilabel> ធ្វើការ​ស្ទើរតែគ្រប់ករណីទាំងអស់ ។​"

#. Tag: title
#: menus.docbook:496
#, no-c-format
msgid "<guimenu>Go</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ទៅ</guimenu> "

#. Tag: menuchoice
#: menus.docbook:502
#, no-c-format
msgid ""
"<shortcut><keycap>N</keycap></shortcut> <guimenu>Go</guimenu> <guimenuitem>"
"Next Message</guimenuitem>"
msgstr ""
"<shortcut><keycap>N</keycap></shortcut> <guimenu>ទៅ​</guimenu> <guimenuitem>"
"សារ​បន្ទាប់​</guimenuitem>"

#. Tag: para
#: menus.docbook:509
#, no-c-format
msgid ""
"Selects the next message in the message list. The keyboard shortcut <keycap>"
"Right Arrow</keycap> also performs this action."
msgstr ""
"ជ្រើស​សារ​បន្ទាប់នៅក្នុង​បញ្ជីសារ​ ។ ផ្លូវកាត់​ក្តារចុច​ <keycap>"
"ព្រួញ​ខាងស្តាំ​</keycap> ក៏បង្ហាញ​អំពើ​នេះដែរ ។​"

#. Tag: menuchoice
#: menus.docbook:516
#, no-c-format
msgid ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>Go</guimenu> <guimenuitem>"
"Next Unread Message</guimenuitem>"
msgstr ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>ទៅ​</guimenu> <guimenuitem>"
