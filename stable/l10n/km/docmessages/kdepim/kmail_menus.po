"ឥរិយាបទ​ពឹងផ្អែក​លើ​តម្លៃ​ជម្រើស​<xref linkend=\"configure-misc-folders-go-unread\"/> ។ "

#. Tag: menuchoice
#: menus.docbook:532
#, no-c-format
msgid ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Go</guimenu> <guimenuitem>"
"Previous Message</guimenuitem>"
msgstr ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>ទៅ​</guimenu> <guimenuitem>"
"សារមុន​</guimenuitem>"

