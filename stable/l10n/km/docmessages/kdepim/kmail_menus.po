msgstr ""
"ផ្លាស់ទីសារ​ទាំងអស់​នៃ​ថត​ដែល​បានជ្រើស ក្នុង​ថត​ធុងសំរាម​ ។ "
"ការនេះ​អាច​រក​បាន​ បើ​ថត​បច្ចុប្បន្ន​បាន​ជ្រើស​​មិននៅក្នុង​ថត​ធុង​សំរាម​ទេ ។​"

#. Tag: menuchoice
#: menus.docbook:707
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Empty Trash</guimenuitem>"
msgstr "<guimenu>ថត</guimenu> <guimenuitem>ធុង​សំរាម​ទទេ</guimenuitem>"

#. Tag: para
#: menus.docbook:713
#, no-c-format
msgid ""
"Permanently deletes all messages. This is only available if the currently "
