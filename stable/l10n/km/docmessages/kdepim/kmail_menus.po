#: menus.docbook:630
#, no-c-format
msgid "Sets the status of all new and unread messages in the current folder to read."
msgstr "កំណត់​ស្ថានភាព​នៃ​សារថ្មី និង​សារ​មិនទាន់អានទាំងអស់​ក្នុង​ថត​បច្ចុប្បន្ន​សម្រាប់អាន​​។"

#. Tag: menuchoice
#: menus.docbook:636
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Compact</guimenuitem>"
msgstr "<guimenu>ថត​</guimenu> <guimenuitem>បង្រួម​</guimenuitem>"

#. Tag: para
#: menus.docbook:642
#, no-c-format
#, fuzzy
msgid ""
"Compacts the folder file to reduce its disk space usage. Usually &kmail; "
"compacts all folders automatically, but under certain circumstances you might "
"want to compact a folder manually."
msgstr ""
"បង្រួមឯកសារ​ថត​ដើម្បី​កាត់បន្ថយ​ការប្រើទំហំឌីស​របស់វា ។ ជាធម្មតា Kmail បង្រួម​ថត​ទាំង​អស់ដោយ​"
"ស្វ័យប្រវត្តិ​ ប៉ុន្តែក្រោម​កាលៈទេសៈមួយ​ពិតប្រាកដ​​ដែលអ្នកចង់បង្រួម​ថត​ដោយ​ដៃ ។ "

#. Tag: menuchoice
#: menus.docbook:650
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Expire</guimenuitem>"
msgstr "<guimenu>ថត​</guimenu> <guimenuitem>ផុតកំណត់​</guimenuitem>"

#. Tag: para
#: menus.docbook:656
#, no-c-format
#, fuzzy
msgid ""
