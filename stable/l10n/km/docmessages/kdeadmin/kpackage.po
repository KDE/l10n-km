#: index.docbook:1204
#, no-c-format
msgid "For dealing with Redhat packages you need:"
msgstr "សម្រាប់​ដោះស្រាយ​ជាមួយ​កញ្ចប់ Redhat អ្នក​ត្រូវការ ៖"

#. Tag: command
#: index.docbook:1208
#, no-c-format
msgid "<command>rpm</command>"
msgstr "<command>rpm</command>"

#. Tag: para
#: index.docbook:1211
#, no-c-format
msgid ""
"For &kpackage; to work correctly with <acronym>RPM</acronym> "
"packages the <acronym>RPM</acronym> database must be initialized. If typing "
"<userinput><command>rpm</command> <option>-qa</option></userinput> "
"gives an error about <computeroutput>unable to open....</computeroutput> "
"then try <userinput><command>rpm</command> <option>--rebuilddb</option>"
"</userinput>."
msgstr ""
"សម្រាប់ Kpackage ធ្វើការ​ត្រឹមត្រូវ​ជាមួយ​កញ្ចប់ <acronym>RPM</acronym> "
"មូលដ្ឋាន​ទិន្នន័យ <acronym>RPM</acronym> ត្រូវ​តែ​បាន​ចាប់ផ្ដើម ។ បើ​វាយ "
"<userinput><command>rpm</command> <option>-qa</option></userinput> "
"ផ្ដល់​កំហុស​អំពី <computeroutput>មិន​អាច​បើក....</computeroutput> "
"បន្ទាប់​ព្យាយាម <userinput><command>rpm</command> <option>--rebuilddb</option>"
"</userinput> ។"

