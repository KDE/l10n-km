#, no-c-format
msgid "Drag and Drop"
msgstr "អូស និង​ទម្លាក់"

#. Tag: para
#: index.docbook:748
#, no-c-format
msgid ""
"&kpackage; makes use of the &kde; Drag and Drop protocol. This means that you "
"can drag and drop packages onto &kpackage; to open them. Dropping a file onto "
"the <guilabel>Find File</guilabel> dialog will find the package that contains "
"the file."
msgstr "Kpackage ប្រើ​ពិធីការ​អូស និង​ទម្លាក់ KDE ។ នេះ​មាន​ន័យ​ថា អ្នក​អាច​អូស និង​ទម្លាក់​កញ្ចប់​លើ Kpackage ដើម្បី​បើក​ពួក​វា ។ ទម្លាក់​ឯកសារ​ទៅ​លើ ប្រអប់ <guilabel>រក​ឯកសារ</guilabel> នឹង​រក​កញ្ចប់​ដែល​មាន​ឯកសារ ។"

