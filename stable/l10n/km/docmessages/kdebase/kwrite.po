#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword> KDE </keyword>"

#. Tag: keyword
#: index.docbook:52
#, no-c-format
msgid "KWrite"
msgstr "KWrite"

#. Tag: keyword
#: index.docbook:53
#, no-c-format
msgid "text"
msgstr "អត្ថបទ​"

#. Tag: keyword
#: index.docbook:54
