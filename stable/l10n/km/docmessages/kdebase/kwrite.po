msgstr "<keycap>F6</keycap>"

#. Tag: para
#: index.docbook:469
#, no-c-format
msgid "Show/Hide Icon Border"
msgstr "បង្ហាញ ឬ​លាក់​ស៊ុម​រូបតំណាង "

#. Tag: keycap
#: index.docbook:473
#, no-c-format
msgid "<keycap>F7</keycap>"
msgstr "<keycap>F7</keycap>"

#. Tag: para
#: index.docbook:474
#, no-c-format
msgid "Switch to Command Line"
msgstr "ប្តូរ​ទៅ​ជា​បន្ទាត់​ពាក្យ​បញ្ជា"

#. Tag: keycap
#: index.docbook:478
#, no-c-format
msgid "<keycap>F9</keycap>"
msgstr "<keycap>F9</keycap>"

#. Tag: para
#: index.docbook:479
#, no-c-format
msgid "Show/Hide Folding Markers"
msgstr "បង្ហាញ ឬ​លាក់​កម្មវិធី​សម្គាល់​បញ្ចូលគ្នា "

#. Tag: keycap
#: index.docbook:483
#, no-c-format
msgid "<keycap>F10</keycap>"
msgstr "<keycap>F10</keycap>"

#. Tag: para
#: index.docbook:484
#, no-c-format
msgid "Dynamic Word Wrap"
msgstr "ការរុំ​ថាមវន្ត"

#. Tag: keycap
#: index.docbook:488
#, no-c-format
msgid "<keycap>F11</keycap>"
msgstr "<keycap>F11</keycap>"

#. Tag: para
#: index.docbook:489
#, no-c-format
msgid "Show/Hide Line Numbers"
msgstr "បង្ហាញ ឬ​លាក់​លេខ​បន្ទាត់​​"

#. Tag: title
#: index.docbook:498
#, no-c-format
msgid "The Menu Entries"
msgstr "ម៉ឺនុយ​ធាតុ​"

#. Tag: title
#: index.docbook:501
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu> ឯកសារ </guimenu>"

#. Tag: menuchoice
#: index.docbook:507
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>N</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> ថ្មី </guimenuitem>"

#. Tag: para
#: index.docbook:514
#, no-c-format
msgid ""
"This starts a new Document in the editor. If there is a current document with "
"unsaved changes the user is given a chance to save it."
msgstr ""
"នេះជា​ការចាប់ផ្តើម​ឯកសារ​ថ្មី​ក្នុង​កម្មវិធី​និពន្ធ​ ។ "
"បើ​មានឯកសារ​បច្ចុប្បន្ន​​ដែល​មិនទាន់​បាន​រក្សាទុក​ផ្លាស់ប្តូរ​អ្នក​ប្រើ​ដែល​បាន​"
"ផ្តល់​ឲ្យរក្សាវា​ទុក ។​"

#. Tag: menuchoice
#: index.docbook:523
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>O</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បើក ...</guimenuitem>"

#. Tag: para
#: index.docbook:574
#, no-c-format
msgid ""
"Displays a standard &kde; <guilabel>Open File</guilabel> "
"dialog. Use the file view to select the file you want to open, and click on "
"<guibutton>Open</guibutton> to open it. You can find more information about the "
"&kde; <guilabel>Open File</guilabel> dialog in the &kde; User Guide."
msgstr ""
"បង្ហាញ​ប្រអប់​ <guilabel> ឯកសារ​បើក​ </guilabel> ស្តង់ដា​ Kde "
"។ប្រើ​ទិដ្ឋភាពឯកសារ​ដើម្បី​ជ្រើស​ឯកសារ​ដែល​អ្នក​ចង់​បើក​ ហើយ​ចុច​លើ​<guibutton> "
"បើក </guibutton> ដើម្បី​បើក​វា​ ។ អ្នកអាច​រក​ព័ត៌មាន​បាន​ច្រើន​ពី​ប្រអប់​ Kde "
"<guilabel> ឯកសារ​បើក </guilabel> ក្នុងមគ្គុទ្ទេសក៍អ្នកប្រើ​ក្នុង​ Kde ។"

#. Tag: menuchoice
#: index.docbook:585
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr "<guimenu> ឯកសារ </guimenu> <guisubmenu> បើក​បច្ចុប្បន្ន​ </guisubmenu>"

#. Tag: para
#: index.docbook:591
#, no-c-format
msgid ""
"This is a shortcut to open recently saved documents. Clicking on this item "
"opens a list to the side of the menu with several of the most recently saved "
"files. Clicking on a specific file will open it in &kwrite; - if the file still "
"resides at the same location."
msgstr ""
"នេះ​ជា​ផ្លូវ​កាត់​ដើម្បី​បើក​ឯកសារ​បច្ចុប្បន្ន​ដែលបាន​រក្សាទុក ។ "
"ចុច​លើ​ធាតុ​នេះ​បើក​បញ្ជី​ផ្នែក​មួយ​នៃ​ម៉ឺនុយ​ជាមួយ​ឯកសារ​បច្ចុប្បន្ន​ជាច្រើន​ដែ"
"ល​បាន​រក្សាទុក​ ។​ ចុច​លើ​ឯកសារ​ដែល​បាន ​បញ្ជាក់​នឹង​បើក​វា​ក្នុង​ Kwrite - "
"បើ​ឯកសារ​នៅទីតាំង​ដូចគ្នា ។​"

#. Tag: menuchoice
#: index.docbook:603
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>S</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> រក្សាទុក </guimenuitem>"

#. Tag: para
#: index.docbook:612
#, no-c-format
msgid ""
"This saves the current document. If there has already been a save of the "
"document then this will overwrite the previously saved file without asking for "
"the user's consent. If it is the first save of a new document the save as "
"dialog (described below) will be invoked."
msgstr ""
"ឯកសារ​នេះ​បច្ចុប្បន្ន​រក្សាទុក ។ បើ​ឯកសារ​បាន​រក្សាទុក​រួចហើយ​ "
"បន្ទាប់​មក​​វា​នឹង​សរសេរ​ជាន់ពីលើ​ឯកសារ​ដែល​បាន​រក្សាទុក​ពីមុន​ "
"ដោយ​ពុំចាំបាច់សួរការយល់ព្រម​របស់​អ្នក​ប្រើ​ "
"។បើ​វា​រក្សាទុក​ឯកសារ​ថ្មី​ជា​លើក​ដំបូង​ ក្នុង​ប្រអប់​រក្សាទុកជា​ "
"(​បាន​ពិពណ៌នា​ដូច​ខាងក្រោម​) នឹង​ត្រូវ​បានហៅ ។​"

#. Tag: menuchoice
#: index.docbook:623
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu> ឯកសារ </guimenu> <guimenuitem> រក្សាទុក​ជា​...</guimenuitem>"

#. Tag: para
#: index.docbook:629
#, no-c-format
msgid ""
"This allows a document to be saved with a new file name. This is done by means "
"of the file dialog box described above in the <link linkend=\"open\">Open</link> "
"section of this help file."
msgstr ""
"ឯកសារ​នេះអនុញ្ញាត​ឲ្យ​អ្នក​​រក្សាទុក​ជា​មួយ​ឈ្មោះ​ឯកសារ​ថ្មី ។ "
"ឯកសារ​នេះ​បាន​ធ្វើ​រួច​តាម​ប្រអប់​ឯកសារ​ដែល​បាន​ណែនាំ​ខាងលើ​ក្នុង​ភាគ​ <link "
"linkend=\"open\"> បើក </link> នៃ​ឯកសារ​ជំនួយ​នេះ ។​"

#. Tag: menuchoice
#: index.docbook:639
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </shortcut> "
"<guimenu> ឯកសារ </guimenu> <guimenuitem> ផ្ទុក​ឡើង​វិញ </guimenuitem>"

#. Tag: para
#: index.docbook:648
#, no-c-format
msgid ""
"Reloads the active file from disk. This command is useful if another program or "
"process has changed the file while you have it open in &kwrite;."
msgstr ""
"ផ្ទុក​ឯកសារ​សកម្ម​ពី​ឌីស​ ។ ពាក្យ​បញ្ជា​នេះ​មាន​ប្រយោជន៍​​បើ​កម្មវិធី​ផ្សេងទៀត​ "
"ឬ​ដំណើរការ​ត្រូវ​បាន​ផ្លាស់ប្តូរ​ឯកសារ​ខណៈពេល​ដែល​អ្នក​បាន​បើក​វា​ក្នុង​ Kwrite "
"។​"

#. Tag: menuchoice
#: index.docbook:657
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>P</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បោះពុម្ព ...</guimenuitem>"

#. Tag: para
#: index.docbook:666
#, no-c-format
msgid ""
"Opens a simple print dialog allowing the user to specify what, where, and how "
"to print."
msgstr ""
"បើក​ប្រអប់​បោះពុម្ព​គំរូ​ដែល​អនុញ្ញាត​ឲ្យ​អ្នកប្រើ​​បញ្ជាក់​ទីតាំង "
"អ្វីដែល​ត្រូវ​បោះពុម្ព​ ហើយ​បោះពុម្ព​ដោយ​របៀបណា ។​"

#. Tag: menuchoice
#: index.docbook:675
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export as HTML...</guimenuitem>"
msgstr ""
"<guimenu> ឯកសារ </guimenu> <guimenuitem> នាំចេញ​ជា​ HTML...</guimenuitem>"

#. Tag: para
#: index.docbook:681
#, no-c-format
msgid ""
"Export your file in HTML format so your document can be viewed as a web page."
msgstr ""
"ឯកសារ​របស់​អ្នក​នាំចេញ​ជា​ទ្រង់ទ្រាយ​  HTML "
"ដូច្នេះ​ឯកសារ​របស់​អ្នក​អាច​ត្រូវ​បាន​មើល​លើ​ទំព័រ​បណ្តាញ ។"

#. Tag: menuchoice
#: index.docbook:689
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>W</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បិទ </guimenuitem>"

#. Tag: para
#: index.docbook:698
#, no-c-format
msgid ""
"Close the active file with this command. If you have made unsaved changes, you "
"will be prompted to save the file before &kwrite; closes it."
msgstr ""
"បិទ​ឯកសារ​សកម្ម​ជាមួយ​ពាក្យ​បញ្ជា​នេះ ។ បើ​អ្នក​មិន​បាន​ផ្លាសប្តូរ​រក្សាទុក​  "
"អ្នកនឹង​ត្រូវ​បាន ​បញ្ចូល​​ដើម្បី​រក្សាឯកសារទុក​មុន​ Kwrite បិទ​វា ។"

#. Tag: menuchoice
#: index.docbook:707
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បោះបង់ </guimenuitem>"

#. Tag: para
#: index.docbook:716
#, no-c-format
msgid ""
"This will close the editor window, if you have more than one instance of "
"&kwrite; running, through the <guimenuitem>New View</guimenuitem> "
"or <guimenuitem>New Window</guimenuitem> menu items, those instances will not "
"be closed."
msgstr ""
"ការនេះ​វា​នឹង​បិទ​បង្អួច​កម្មវិធី​និពន្ធ​ "
"បើ​អ្នក​មាន​បង្អួច​ច្រើន​ដើម្បី​ជំនួស​Kwrite កំពុង​រត់​កាត់តាម​ <guimenuitem> "
"ទិដ្ឋភាព​ថ្មី </guimenuitem> ឬម៉ឺនុយ​ធាតុ​ <guimenuitem> "
"បង្អួច​ថ្មី </guimenuitem> វត្ថុ​ទាំងនោះ​នឹង​មិន​ត្រូវ​បាន​បិទ​ ។​"

#. Tag: title
#: index.docbook:730
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr "ម៉ឺនុយ​  <guimenu> កែសម្រួល </guimenu>"

#. Tag: menuchoice
#: index.docbook:734
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា <keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"មិនធ្វើ​វិញ </guimenuitem>"

#. Tag: para
#: index.docbook:740
#, no-c-format
msgid ""
"This is used to eliminate or reverse the most recent user action or operation."
msgstr ""
"ការនេះ​ត្រូវ​បាន​ប្រើ​ដើម្បីបំបាត់​ ឬ​ដាក់​បញ្ច្រាស់​អ្នកប្រើ​សកម្ម​ "
"ឬ​ប្រត្តិបតិការណ៍ ។​"

#. Tag: menuchoice
#: index.docbook:752
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu><guimenuitem> "
"ធ្វើ​ឡើង​វិញ  </guimenuitem>"

#. Tag: para
#: index.docbook:757
#, no-c-format
msgid "This will reverse the most recent change (if any) made using Undo"
msgstr ""
"បញ្ជា​នេះ​នឹង​ត្រូវ​បញ្ច្រាស់​ការផ្លាស់ប្តូរ​ថ្មីៗ​មួយ​ចំនួន (បើ​មាន​ច្រើន​) "
"ដោយ​ប្រើ​មិនធ្វើ​វិញ"

#. Tag: menuchoice
#: index.docbook:762
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា <keycap>X</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល​ </guimenu><guimenuitem> កាត់ </guimenuitem>"

#. Tag: para
#: index.docbook:767
#, no-c-format
msgid ""
"This command deletes the current selection and places it on the clipboard. The "
"clipboard is a feature of &kde; that works invisibly to provide a way to "
"transfer data between applications."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ​លុប​ការជ្រើស​បច្ចុប្បន្ន​ "
"ហើយ​យក​វា​ទៅ​ដាក់​នៅ​លើ​ក្តារតម្រៀត​ខ្ទាស់​ ។ "
"ក្តារតម្រៀតខ្ទាស់​ជា​លក្ខណៈពិសេស​របស់​ Kde "
"ដែលធ្វើការ​មិនអាច​មើល​ឃើញ​ដើម្បី​ផ្តល់​នូវ​វិធី​ផ្ទេរ​ទិន្នន័យ​រវាង​កម្មវិធី ។​"

#. Tag: menuchoice
#: index.docbook:775
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា <keycap>C</keycap></keycombo>"
"</shortcut> <guimenu>​ កែសម្រួល​ </guimenu><guimenuitem> ចម្លង​​ </guimenuitem>"

#. Tag: para
#: index.docbook:780
#, no-c-format
msgid ""
"This copies the currently selected text to the clipboard so that it may be "
"pasted elsewhere. The clipboard is a feature of &kde; that works invisibly to "
"provide a way to transfer data between applications."
msgstr ""
"បច្ចុប្បន្ន​ច្បាប់​ចម្លង​នេះ​ត្រូវ​បាន​ជ្រើស​អត្ថបទ​ទៅ​កាន់​ក្តារ​តម្រៀត​ខ្ទាស់​"
"​ ដូច្នេះ​វា​ប្រហែល​ជា​ត្រូវ​បាន​បិទ​ភ្ជាប់​ទៅ​កន្លែង​ណាមួយ ។ "
"ក្តារតម្រៀតខ្ទាស់​ជា​លក្ខណៈពិសេស​របស់ Kde "
"ដែល​ធ្វើ​ការ​មិន​អាច​មើល​ឃើញ​​ដើម្បី​ផ្តល់​នូវ​វិធី​ផ្ទេរ​ទិន្នន័យ​រវាង​កម្មវិធី"
"​ជាច្រើន​ ។​"

#. Tag: menuchoice
#: index.docbook:787
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Copy as HTML</guimenuitem>"
msgstr ""
"<guimenu> កែសម្រួល </guimenu><guimenuitem> ចម្លង​ជា​  HTML</guimenuitem>"

#. Tag: para
#: index.docbook:791
#, no-c-format
msgid "This copies the currently selected text to the clipboard as HTML."
msgstr ""
"បច្ចុប្បន្ននេះ​ច្បាប់​ចម្លង​ត្រូវ​បាន​ជ្រើស​អត្ថបទ​ទៅ​កាន់ក្តារតម្រៀត​ខ្ទាស់​ជា​"
" HTML ។​"

#. Tag: menuchoice
#: index.docbook:796
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា <keycap>V</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu><guimenuitem> បិទ​ភ្ជាប់ </guimenuitem>"

#. Tag: para
#: index.docbook:801
#, no-c-format
msgid ""
"This will insert the contents of the clipboard at the cursor position. The "
"clipboard is feature of &kde; that works invisibly to provide a way to transfer "
"data between applications."
msgstr ""
"បញ្ជា​នេះ​នឹង​បញ្ចូល​មាតិកា​នៃ​ក្តារតម្រៀតខ្ទាស់​នៅទីតាំង​ទស្សន៍ទ្រនិច​ ។ "
"ក្តារ​តម្រៀត​ខ្ទាស់​ជា​លក្ខណៈពិសេស​របស់​​ Kde "
"ដែល​ធ្វើការ​មិន​អាច​មើល​ឃើញ​ដើម្បី​ផ្តល់​នូវ​វិធី​ផ្ទេរ​ទិន្នន័យ​រវាង​កម្មវិធី​ជ"
"ាច្រើន​​ ។​"

#. Tag: menuchoice
#: index.docbook:808
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Select All</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>A</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu><guimenuitem> "
"ជ្រើស​ទាំងអស់ </guimenuitem>"

#. Tag: para
#: index.docbook:813
#, no-c-format
msgid ""
"This will select the entire document. This could be very useful for copying the "
"entire file to another application."
msgstr ""
"បញ្ជា​នេះ​នឹង​ជ្រើសធាតុឯកសារ​ ។ "
"ហើយ​វា​ជា​អត្ថប្រយោជន៍​សម្រាប់​ការចម្លង​ធាតុ​ឯកសារ​ទៅ​កាន់​កម្មវិធី​ផ្សេង​ទៀត​ "
"។​"

#. Tag: menuchoice
#: index.docbook:819
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Deselect</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>A</keycap></keycombo> "
"</shortcut> <guimenu> កែស្រួល </guimenu><guimenuitem> ដោះជ្រើស </guimenuitem>"

#. Tag: para
#: index.docbook:825
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr "ដោះជ្រើស​អត្ថបទ​ដែល​បាន​ជ្រើស​ក្នុង​កម្មវិធី​និពន្ធ​បើ​មាន​ ។​"

#. Tag: menuchoice
#: index.docbook:830
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>B</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Bloc Selection "
"Mode</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>B</keycap></keycombo> "
"</shortcut> <guimenu> កែសម្រួល </guimenu><guimenuitem> "
"របៀប​ការជ្រើស​ Bloc  </guimenuitem>"

#. Tag: para
#: index.docbook:837
#, no-c-format
msgid ""
"Toggles Selection Mode. When the Selection Mode is “BLOCK”, you can make "
"vertical selections, ie select column 5 to 10 in lines 9 to 15. The status bar "
"shows the current state of the Selection Mode, either “NORM” or “BLK”."
msgstr ""
"របៀប​បិទ​បើក​ការជ្រើស​ ។ ពេល​របៀប​ការជ្រើស​ជា​  “BLOCK” "
"អ្នក​អាច​បង្កើត​ការជ្រើស​បញ្ឈរ ឧទាហរណ៍ ជួរឈរ​ទី ៥ ទៅ​ទី​១០ ក្នុង​បន្ទាត់​៩ "
"ទៅ​១៥ ។ របារ​ស្ថានភាព បង្ហាញរបៀប​ការ ជ្រើស​​បច្ចុប្បន្ន​ “NORM” ឬ “BLK” ។​"

#. Tag: menuchoice
#: index.docbook:845
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>Insert</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Overwrite Mode</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"><keycap> បញ្ចូល </keycap></keycombo> "
"</shortcut> <guimenu> កែស្រួល </guimenu><guimenuitem> "
"របៀប​សរសេរ​ជាន់ពីលើ​  </guimenuitem>"

#. Tag: para
#: index.docbook:852
#, no-c-format
msgid ""
"Toggles the Insert/Overwrite modes. When the mode is \"INS\", you insert "
"characters where the cursor is. When the mode is \"OVR\", writing characters "
"will replace the current characters if your cursor is positioned before any "
"character. The status bar shows the current state of the Overwrite Mode, either "
"“INS” or “OVR”."
msgstr ""
"​របៀប​បិទបើក​ បញ្ចូល​ ឬ​សរសរជាន់ពីលើ​​ ។ ពេល​របៀប​ជា​ \"INS\" "
"អ្នក​អាច​បញ្ចូល​តួអក្សរ​ជា​ច្រើ​ន​ដែល​ទស្សន៍ទ្រនិច​ឋិត​នៅ ។ ពេល​របៀប​ជា​  "
"\"OVR\" ការសរសេរ​តួអក្សរ​​ជាច្រើន​ នឹង​ត្រូវ​បាន​ជំនួស​ដោយ​តួអក្សរ​បច្ចុប្បន្ន​ "
"បើ​ទស្សន៍ទ្រនិច​របស់​អ្នកដែល​មាន​ទីតាំង​មុន​តួអក្សរ​ "
"។របារស្ថាន​ភាព​បង្ហាញ​របៀស​សរសេរជាន់​ពីលើ​បច្ចុប្បន្ន​ជា“INS” ឬ “OVR” ។​"

#. Tag: menuchoice
#: index.docbook:861
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Find</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា <keycap>F</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu><guimenuitem> រក​ </guimenuitem>"

#. Tag: para
#: index.docbook:866
#, no-c-format
msgid ""
"This opens the find dialog which is used to specify the <guilabel>"
"Text to Find</guilabel> in the document. There is small text box for entering "
"the search pattern which also doubles as a dropdown box. Clicking on the "
"dropdown arrow at the side of the box makes available other recent search "
"patterns. Other parameters are included to make the search more efficient. "
"Selecting <guilabel>Case Sensitive</guilabel> will limit finds to entries that "
"match the case (upper or lower) of each of the characters in the search "
"pattern. <guilabel>Find Backwards</guilabel> directs the search to proceed in "
"an upwardly direction. The <guilabel>Selected Text</guilabel> "
"option keeps the search within currently selected text. Checking <guilabel>"
"Whole Words Only</guilabel> prevents the search from stopping on words that "
"contain the searched for pattern. The <guilabel>Search from Cursor</guilabel> "
"option begins the search from the current position of the cursor within the "
"document rather than from the beginning."
msgstr ""
"បើក​ប្រអប់​រក​នេះ​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​បញ្ជាក់​ <guilabel>"
"អត្ថបទ​ដើម្បី​រក​ </guilabel> ក្នុង​ឯកសារ ។ "
"មាន​ប្រអប់​អត្ថបទ​តូច​សម្រាប់​បញ្ចូល​លំនាំ "
"ស្វែងរក​ដែល​អាច​ចុច​ទ្វេរ​ដង​លើប្រអប់​ធ្លាក់ចុះ​ ។  "
"ចុច​លើ​ព្រួញ​ធ្លាក់​ចុះ​នៅ​ចំហៀង​នៃ​ប្រអប់​ "
"ដែល​អាច​រក​បាន​តាម​លំនាំ​ស្វែងរក​បច្ចុប្បន្ន​ផ្សេងទៀត "
"។​ប៉ារ៉ាម៉ែត្រ​ផ្សេងទៀត​ត្រូវ​បាន​រួមបញ្ចូល​ដើម្បី​បង្កើត​ការស្វែងរក​ជាច្រើន​ដែល"
"​មាន​ប្រសិទ្ធ​ភាព​ការជ្រើស​ <guilabel> ប្រកាន់តួអក្សរ​តូចធំ </guilabel> "
"នឹង​កំណត់​ព្រំដែន​រក​ធាតុ​ដែល​បាន​ផ្គូផ្គង​អក្សរតូច​ ឬ​ធំ (តួអក្សរធំ ឬ​តូច) "
"នៃ​តួអក្សរ​នីមួយៗ​ក្នុង​លំនាំស្វែងរក​ ។ <guilabel> ត្រឡប់​ទៅវិញ </guilabel> "
"ស្វែងរក​ដោយ​ផ្ទាល់​ដើម្បីធ្វើ​បន្ត​ក្នុង​ទិសដៅទៅ​ខាងលើ​ ។ ជ្រើស​ <guilabel> "
"អត្ថបទ​ដែល​បាន​ជ្រើស​ </guilabel> "
"រក្សា​ស្វែងរក​ក្នុង​អត្ថបទ​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន​ ។ ធីកបាន​តែ​​ <guilabel>"
"ពាក្យ​ទាំងមូល​ "
"</guilabel>ការពារ​ស្វែងរក​​ពី​ការបញ្ឈប់​ពាក្យ​​ដែល​បាន​ស្វែងរក​តាម​លំនាំ។ "
"ជ្រើស​ <guilabel> ស្វែងរក​ពី​ទស្សន៍ទ្រនិច​ </guilabel> "
"​ចាប់ផ្តើម​ស្វែងរក​ពី​ទីតាំង​បច្ចុប្បន្ន​​នៃ​ទស្សទ្រនិច្ច​ក្នុង​ឯកសារ​ប្រសើរជាង​"
"ការចាប់​ផ្តើម​ដំបូង​ ។"

#. Tag: menuchoice
#: index.docbook:884
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></shortcut> "
"<guimenu>Edit</guimenu><guimenuitem>Find Next</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></shortcut> "
"<guimenu> កែសម្រួល </guimenu><guimenuitem> រក​បន្ទាប់​​ </guimenuitem>"

#. Tag: para
#: index.docbook:888
#, no-c-format
msgid ""
"This repeats the last find operation, if any, without calling the find dialog "
"box."
msgstr ""
"ធ្វើ​ការប្រត្តិបតិ​រក​ចុង​ក្រោយ​នេះ​ម្ត​ង​ទៀត​ បើមាន​ច្រើន "
"ដោយ​ពុំចាំបាច់​ហៅ​ប្រអប់​រក​ឡើយ​។"

#. Tag: menuchoice
#: index.docbook:896
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> ប្តូរ <keycap>F3</keycap></keycombo> "
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"រក​ពី​មុន​  </guimenuitem>"

#. Tag: para
#: index.docbook:905
#, no-c-format
msgid ""
"This repeats the last find operation, if any, without calling the find dialog "
"box, and searching backwards instead of forwards through the document."
msgstr ""
"ធ្វើ​ការប្រត្តិបតិ​រក​ចុងក្រោយ​នេះម្តង​ទៀត "
"បើ​មាន​ច្រើន​ពុំចាំបាច់​ហៅ​ប្រអប់​រក​ "
"ហើយ​ការជ្រើស​រើស​​​ត្រឡប់ក្រោយ​វិញ​ជំនួសឲ្យ​ការ​បញ្ចូន​បន្ត​តាម​ឯកសារ​ ។​"

#. Tag: menuchoice
#: index.docbook:914
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu><guimenuitem>Replace...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា <keycap>R</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu><guimenuitem> ជំនួស​ ...</guimenuitem>"

#. Tag: para
#: index.docbook:919
#, no-c-format
msgid ""
"This command opens the replace dialog box. The replace dialog is almost "
"identical to the above-mentioned find dialog. In addition to the features in "
"the find dialog it contains a <guilabel>Replace With:</guilabel> "
"text entry/dropdown box. Using this dialog the user can specify both the text "
"to be found and text with which to replace it. The additional <guilabel>"
"Prompt On Replace</guilabel> option allows the user to have &kwrite; ask for "
"confirmation before each replacement."
msgstr ""
"ពាក្យបញ្ជា​នេះ​បើក​ប្រអប់​ជំនួស​ ។ ប្រអប់​ជំនួសស្ទើរតែ​ដូចគ្នា​បេះបិទ​ "
"ទៅ​និង​ប្រអប់​រក​ខាង​លើ​ដែល​បាន​រៀបរាប់ ។ "
"ដើម្បី​បន្ថែម​លក្ខណៈពិសេស​ក្នុង​ប្រអប់​រក​វា​​ <guilabel> ជំនួស​ដោយ ៖</guilabel> "
"ធាតុ​អត្ថបទ ឬ​ប្រអប់​ធ្លាក់ចុះ ។ "
"ប្រើ​ប្រអប់​នេះ​​អ្នកប្រើ​​អាច​បញ្ជាក់​ទាំង​អត្ថបទ​ដែលបាន​រក​ឃើញ "
"និង​អត្ថបទ​ដែល​បាន​ជំនួស ។ ជម្រើស​​បន្ថែម​  <guilabel> "
"ប្រអប់​បញ្ចូល​ជំនួស​ </guilabel> អនុញ្ញាត​ឲ្យ​អ្នកប្រើ​ Kwrite "
"ស្នើរ​ការអះអាង​មុន​នឹង​ធ្វើការ​ជំនួស​នីមួយៗ ។​"

#. Tag: menuchoice
#: index.docbook:932
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to line</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>G</keycap></keycombo> "
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"ត្រឡប់​ទៅ​បន្ទាត់  </guimenuitem>"

#. Tag: para
#: index.docbook:939
#, no-c-format
msgid ""
"This opens the goto line dialog box which is used to have the cursor jump to a "
"particular line (specified by number) in the document. The line number may be "
"entered directly into the text box or graphically by clicking on the up or down "
"arrow spin controls at the side of the text box. The little up arrow will "
"increase the line number and the down arrow decrease it. There is also a slide "
"control to the right of the text box which allows the user to move the goto "
"point in the document in an analog manner."
msgstr ""
"បើ​កប្រអប់​ត្រឡប់​ទៅ​បន្ទាត់​នេះ​​ដែល​ត្រូវ​បាន​ប្រើ​​ទស្សន៍ទ្រនិច​ដើម្បី​លោត​ទៅ"
"​បន្ទាត់​ពិសេស​មួយ​ (បន្ទាត់​ដែល​បាន​បញ្ជាក់​ដោយ​លេខ)ក្នុង​ឯកសារ ។ "
"​លេខ​បន្ទាត់​ប្រហែល​ជា​ត្រូវ​បាន​បញ្ចូល​​ដោយ​ផ្ទាល់​ទៅ​ក្នុង​ប្រអស់​អត្ថបទ​ "
"ឬ​ក្រាហ្វិក​តាម​ការ​ចុច​​ព្រួញ​ឡើងលើ ឬ​ចុះក្រោម​ "
"ត្រួតពិនិត្យ​រង្វិល​នៅ​ផ្នែក​ចំហៀង​នៃ​ប្រអប់​អត្ថបទ ។ "
"ចំណង​ជើង​ព្រួញ​ឡើង​លើ​បង្កើន​លេខ​បន្ទាត់​ "
"ហើយ​ព្រួញ​ចុះក្រោម​បន្ថយ​លេខ​បន្ទាត់​។ "
"ពេលខ្លះ​វា​ក៏​បំបែក​ការត្រួតពិនិត្យ​ទៅ​ខាង​ស្តាំ​នៃ​ប្រអប់​អត្ថបទ​ដែល​អនុញ្ញាត​ឲ"
"្យ​អ្នកប្រើ​ផ្លាស់ទី​ត្រឡប់ទៅ​កាន់​ចំណុច​ក្នុង​​ឯកសារ​តាម​រៀប​អាណាឡូក​ ។nner."

#. Tag: title
#: index.docbook:955
#, no-c-format
msgid "The <guimenu>View</guimenu> menu"
msgstr "ម៉ឺនុយ <guimenu> មើល </guimenu> "

#. Tag: para
#: index.docbook:957
#, no-c-format
msgid ""
"The <guimenu>View</guimenu> menu allows you to manage settings specific to the "
"active editor, and to manage frames."
msgstr ""
"ម៉ឺនុយ​  <guimenu> មើល​ </guimenu> "
"អនុញ្ញាត​ឲ្យ​អ្នក​គ្រប់គ្រង​ការកំណត់យ៉ាង​​ជាក់លាក់​នូវកម្មវិធី​និពន្ធ​សកម្ម​oនិង"
"​ការគ្រប់គ្រង​ស៊ុម​ ។​es."

#. Tag: menuchoice
#: index.docbook:965
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr "<guimenu> មើល </guimenu> <guimenuitem> បង្អួច​ថ្មី </guimenuitem>"

#. Tag: para
#: index.docbook:971
#, no-c-format
msgid "Opens a new window with the same text."
msgstr "បើ​បង្អួច​ថ្មី​​ដែល​មាន​អត្ថបទ​ដូចគ្នា ។​"

#. Tag: menuchoice
#: index.docbook:978
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F7</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Switch to Command Line</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F7</keycap></keycombo></shortcut> "
"<guimenu> មើល​ </guimenu> <guimenuitem> ប្តូរ​ទៅ​កាន់​បន្ទាត់​ពាក្យ​បញ្ជា "
"</guimenuitem>"

#. Tag: para
#: index.docbook:986
#, no-c-format
msgid ""
"Displays the Katepart command line at the bottom of the window. In the command "
"line, type \"help\" to get help and \"help list\" to get a list of commands."
msgstr ""
"បង្ហាញ​បន្ទាត់​ពាក្យ​បញ្ជា​ Katepart នៅ​បាត​របស់​បង្អួច ។ "
"ក្នុង​បន្ទាត់ពាក្យ​បញ្ជា​វាយ​ \"help\" ដើម្បីទទួល​បាន​ជំនួយ ហើយ​វាយ​ \"help "
"list\" ទទួល​បាន​បញ្ចី​របស់​ពាក្យ​បញ្ជា ។​"

#. Tag: menuchoice
#: index.docbook:995
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Schema</guimenuitem>"
msgstr "<guimenu> មើល​ </guimenu> <guimenuitem> គ្រោង​ការណ៍ </guimenuitem>"

#. Tag: para
#: index.docbook:1001
#, no-c-format
msgid "Select a font schema."
msgstr "ជ្រើស​គ្រោងការណ៍​ពុម្ពអក្សរ ។​"

#. Tag: menuchoice
#: index.docbook:1008
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Dynamic Word Wrap</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap></keycombo></shortcut> "
"<guimenu> មើល </guimenu> <guimenuitem> ការរុំពាក្យថាមវន្ត </guimenuitem>"

#. Tag: para
#: index.docbook:1015
#, no-c-format
msgid "The text lines will be wrapped at the view border on the screen."
msgstr "បន្ទាត់​អត្ថបទនឹង​ត្រូវ​បាន​រុំ​ស៊ុមមើល​លើ​អេក្រង់ ។​"

#. Tag: menuchoice
#: index.docbook:1023
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Dynamic Word Wrap Indicators</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap></keycombo></shortcut> "
"<guimenu> មើល </guimenu> <guimenuitem> ទ្រនិច​បង្ហាញការរុំពាក្យថាមវន្ត "
"</guimenuitem>"

#. Tag: para
#: index.docbook:1030
#, no-c-format
msgid ""
"Choose when and how the dynamic word wrap indicators should be displayed. This "
"is only available if the <guilabel>Dynamic Word Wrap</guilabel> "
"option is checked."
msgstr ""
"ជ្រើស​ពេលណា​ "
"និ​ងរបៀប​យទ្រនិច​បង្ហាញការរុំពាក្យថាមវន្ត​ត្រូវ​បាន​បង្ហាញ​យ៉ាង​ដូចម្តេច ។ "
"ការនេះ​អាច​រក​បានតែ​ បើ​ជម្រើស​ <guilabel> ការ​រុំពាក្យថាមវន្ត </guilabel> "
"ត្រូវ​បាន​ជ្រើស ។​"

#. Tag: menuchoice
#: index.docbook:1039
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Show Static Word Wrap Marker</guimenuitem>"
msgstr ""
"<guimenu> មើល </guimenu> <guimenuitem> បង្ហាញការរុំពាក្យសម្គាល់​ឋិតិវន្ត  "
"</guimenuitem>"

#. Tag: para
#: index.docbook:1045 index.docbook:2204
#, no-c-format
msgid ""
"If this option is checked, a vertical line will be drawn at the word wrap "
"column as defined in the <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>"
"Configure Editor...</guimenuitem></menuchoice> in the Editing tab. Please note "
"that the word wrap marker is only drawn if you use a fixed pitch font."
msgstr ""
"បើជម្រើស​នេះ​ត្រូវ​បានជ្រើស​ "
"បន្ទាត់​បញ្ឈរ​នឹង​ត្រូវ​បាន​គូស​​នៅ​ជួរឈរ​ការរុំពាក្យ​​ដែល​បាន​កំណត់​ក្នុង "
"<menuchoice> <guimenu> ការកំណត់​ </guimenu> <guimenuitem>"
"កំណត់​រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ​...</guimenuitem></menuchoice> "
"ក្នុង​ថេប​ការកែសម្រួល​ "
"។​សូម​ចំណាំ​ថា​កម្មវិធី​សម្គាល់​ការរុំពាក្យ​​បាន​តែ​គូស​បើ​អ្នក​ប្រើពុម្ពអក្សរ​ជ"
"ម្រេ​ដែល​បាន ជួសជុល ។"

#. Tag: menuchoice
#: index.docbook:1057
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Show Icon Border</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></shortcut> "
"<guimenu> មើល </guimenu> <guimenuitem> បង្ហាញ​ស៊ុម​រូបតំណាង​  </guimenuitem>"

#. Tag: para
#: index.docbook:1064
#, no-c-format
msgid ""
"This is a toggle item. Setting it on checked will make the side of the active "
"editor, and vice versa."
msgstr ""
"នេះ​ជា​ធាតុ​បិទ​បើក ។ ការកំណត់​វា​ត្រូវ​បានធីក​ "
"នឹង​បង្កើត​ផ្នែក​មួយ​នៃ​កម្មវិធី​និពន្ធ​សកម្ម​ និង​អនុ versa ។​"

#. Tag: menuchoice
#: index.docbook:1072
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Show Line Numbers</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></shortcut> "
"<guimenu> មើល </guimenu> <guimenuitem> បង្ហាញលេខ​បន្ទាត់​  </guimenuitem>"

#. Tag: para
#: index.docbook:1079
#, no-c-format
msgid ""
"This is a toggle Item. Setting it on checked will make a pane displaying the "
"line numbers of the document visible in the left border of the active editor, "
"and vice versa."
msgstr ""
"នេះ​ជា​ធាតុ​បិទបើក​ ។ ការកំណត់​វា​ដែល​បានធីក​ "
"នឹ​ង​បង្កើតការបង្ហាញ​ស្លាបព្រិលលេខ​​បន្ទាត់​របស់​ឯកសារ​ដែល​អាច​មើល​ឃើញ​ក្នុង​ស៊ុ"
"ម​ខាង​ឆ្វេង​របស់​កម្មវិធី​និពន្ធ​សកម្ម​និ​ង អនុ versa ។​"

#. Tag: menuchoice
#: index.docbook:1088
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Show Scrollbar Marks</guisubmenu>"
msgstr ""
"<guimenu> មើល </guimenu> <guisubmenu> បង្ហាញ​របាររមូរ​សម្គាល់  </guisubmenu>"

#. Tag: para
#: index.docbook:1094
#, no-c-format
msgid ""
"If this option is checked, the view will show marks on the vertical scrollbar."
msgstr ""
"បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស​ "
"ទិដ្ឋភាព​ទូទៅ​នឹង​បង្ហាញ​សម្គាល់​លើ​របាររមូរ​បញ្ឈរ ។​"

#. Tag: menuchoice
#: index.docbook:1102
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap></keycombo></shortcut> "
"<guimenuitem>Hide Folding Markers</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap></keycombo></shortcut> "
"<guimenuitem> លាក់​កម្មវិធី​សម្គាល់​បញ្ចូល​គ្នា </guimenuitem>"

#. Tag: para
#: index.docbook:1108
#, no-c-format
msgid "If this option is checked, the marks for code folding will be hidden."
msgstr "បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ធីក សម្គាល់​ការបញ្ចូល​កូដ​នឹង​ត្រូវ​បាន​លាក់ ។"

#. Tag: guimenuitem
#: index.docbook:1117
#, no-c-format
msgid "<guimenuitem>Code Folding</guimenuitem>"
msgstr "<guimenuitem> ការបញ្ចូល​កូដ​ចូលគ្នា </guimenuitem>"

#. Tag: menuchoice
#: index.docbook:1123
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>"
"Shift</keycap><keycap>-</keycap></keycombo></shortcut> <guimenuitem>"
"Collapse Toplevel</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap> បញ្ជា​ </keycap> <keycap>"
"ប្តូរ </keycap><keycap>-</keycap></keycombo></shortcut> <guimenuitem> "
"វេញ​កម្រិត​កំពូល​ </guimenuitem>"

#. Tag: para
#: index.docbook:1127
#, no-c-format
msgid "Collapse all toplevel regions in the document."
msgstr "វេញ​តំបន់​កម្រិត​កំពូលទាំងអស់​ក្នុង​ឯកសារ​ ។​"

#. Tag: menuchoice
#: index.docbook:1130
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>"
"Shift</keycap><keycap>+</keycap></keycombo></shortcut> <guimenuitem>"
"Expand Toplevel</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap> បញ្ជា </keycap> <keycap>"
"ប្តូរ </keycap><keycap>+</keycap></keycombo></shortcut> <guimenuitem>"
"ពង្រីក​កម្រិត​កំពូល </guimenuitem>"

#. Tag: para
#: index.docbook:1134
#, no-c-format
msgid "Expand all toplevel regions in the document."
msgstr "ពង្រីក​តំបន់​កម្រិត​កំពូល​ទាំងអស់​ក្នុង​ឯកសារ​ ។​"

#. Tag: menuchoice
#: index.docbook:1137
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>-</keycap>"
"</keycombo></shortcut> <guimenuitem>Collapse One Local Level</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap> បញ្ជា </keycap> <keycap>-</keycap>"
"</keycombo></shortcut> <guimenuitem> វេញ​កម្រិត​មូលដ្ឋាន​មួយ </guimenuitem>"

#. Tag: para
#: index.docbook:1141
#, no-c-format
msgid "Collapse the region closest to the cursor."
msgstr "វេញ​តំបន់ខ្លូសសិត​ទៅ​កាន់​ទស្សន៍ទ្រនិច ។​"

#. Tag: menuchoice
#: index.docbook:1144
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>+</keycap>"
"</keycombo></shortcut> <guimenuitem>Expand One Local Level</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap> បញ្ជា </keycap> <keycap>+</keycap>"
"</keycombo></shortcut> <guimenuitem> ពង្រីក​កម្រិត​មូលដ្ឋាន​មួយ </guimenuitem>"

#. Tag: para
#: index.docbook:1148
#, no-c-format
msgid "Expand the region closest to the cursor."
msgstr "ពង្រីក​តំបន់ខ្លូសសិត​ទៅ​កាន់​ទស្សន៍ទ្រនិច ។​"

#. Tag: title
#: index.docbook:1159
#, no-c-format
msgid "The <guimenu>Bookmarks</guimenu> Menu"
msgstr "ម៉ឺនុយ  <guimenu> ចំណាំ </guimenu> "

#. Tag: menuchoice
#: index.docbook:1164
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo> "
"</shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Set Bookmark</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>B</keycap></keycombo> "
"</shortcut> <guimenu> ចំណាំ </guimenu> <guimenuitem> កំណត់​ចំណាំ </guimenuitem>"

#. Tag: para
#: index.docbook:1173
#, no-c-format
msgid ""
"Sets or removes a bookmark in the current line of the active document. (If it's "
"there, it is removed, otherwise one is set)."
msgstr ""
"កំណត់​ ឬ​យក​ចេញ​ចំណាំ​ក្នុង​បន្ទាត់​បច្ចុប្បន្ន​​របស់​ឯកសារ​សកម្ម ។ "
"(បើ​វាមាន​នៅទៅ​នេះ វា​ត្រូវ​បាន​យក​ចេញ ក្រៅពីនេះ​ត្រូវ​កំណត់​មួយ)។​"

#. Tag: menuchoice
#: index.docbook:1182
#, no-c-format
msgid ""
"<guimenu>Bookmarks</guimenu> <guimenuitem>Clear All Bookmarks</guimenuitem>"
msgstr ""
"<guimenu> ចំណាំ </guimenu> <guimenuitem> ជម្រះ​ចំណាំ​ទាំងអស់  </guimenuitem>"

#. Tag: para
#: index.docbook:1188
#, no-c-format
msgid ""
"This command will remove all the markers from the document as well as the list "
"of markers which is appended at the bottom of this menu item."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ​នឹង​យក​ចេញ​កម្មវិធី​សម្គាល់​ទាំងអស់​ចេញ​ពី​ឯកសារ​ក៏​ដូច​ជា​បញ្ជី"
"​របស់​កម្មវិធី​សម្គាល់​ផងដែរ ដែល​បានបន្ថែម​នៅ​បាត​នៃ​ធាតុ​ម៉ឺនុយ ។​"

#. Tag: menuchoice
#: index.docbook:1196
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Alt</keycap> <keycap>"
"Page Up</keycap></keycombo></shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>"
"Previous</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap> ជំនួស </keycap> <keycap>"
"ទំព័រ​លើ​ </keycap></keycombo></shortcut> <guimenu> ចំណាំ </guimenu>"
"<guimenuitem>ពី​មុន​ </guimenuitem>"

#. Tag: para
#: index.docbook:1200
#, no-c-format
msgid ""
"This will move the cursor to beginning of the first above line with a bookmark. "
"The menuitem text will include the line number and the first piece of text on "
"the line. This item is only available when there is a bookmark in a line above "
"the cursor."
msgstr ""
"បញ្ជា​នេះ​នឹង​ផ្លាស់ទី​ទស្សន៍ទ្រនិច​ដើម្បី​ចាប់ផ្តើម​​បន្ទាត់​ដំបូង​ខាងលើ​ដែល​មា"
"ន​ចំណាំ ។​អត្ថបទ​ធាតុ​ម៉ឺនុយ​រួមទាំង​លេខ​បន្ទាត់​ "
"និង​ផ្នែក​មួយ​នៃ​បន្ទាត់​ដំបូង​នៅ​លើ​បន្ទាត់ "
"។ធាតុ​នេះ​បាន​តែ​អាច​រក​បាន​ពេល​មាន​ចំណាំ​ក្នុង​ទស្សន៍ទ្រនិច​ខាងលើ​ ។​    "

#. Tag: menuchoice
#: index.docbook:1207
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Alt</keycap> <keycap>"
"Page Down</keycap></keycombo></shortcut> <guimenu>Bookmarks</guimenu>"
"<guimenuitem>Next</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap> ជំនួស </keycap> <keycap>"
"ទំព័រ​ចុះក្រោម </keycap></keycombo></shortcut> <guimenu> ចំណាំ </guimenu>"
"<guimenuitem> បន្ទាប់ </guimenuitem>"

#. Tag: para
#: index.docbook:1210
#, no-c-format
msgid ""
"This will move the cursor to beginning of the next line with a bookmark. The "
"menuitem text will include the line number and the first piece of text on the "
"line. This item is only available when there is a bookmark in a line below the "
"cursor."
msgstr ""
"ការ​នេះ​នឹង​ផ្លាស់ទី​ទស្សន៍ទ្រនិច​ដើម្បីចាប់ផ្តើម​បន្ទាត់​បន្ទាប់​ដែល​មាន​ចំណាំ​"
" ។ អត្ថបទ​ធាតុ​ម៉ឺនុយ​រួម​ទាំង​លេខ​បន្ទាត់​ និង​អត្ថបទ​មួ​យ​ផ្នែក​លើ​បន្ទាត់​ "
"។​ធាតុ​នេះ​បាន​តែ​អាច​រក​បាន​​ពេល​មាន​ចំណាំ​ក្នុង​បន្ទាត់​ខាងក្រោម​ទស្សន៍ទ្រនិច "
"។​"

#. Tag: para
#: index.docbook:1218
#, no-c-format
msgid ""
"At the bottom of this menu, a list of markers appears if any markers are "
"available for this window."
msgstr ""
"នៅ​បាត​ម៉ឺនុយ​នេះ​ បញ្ជី​កម្មវិធី​សម្គាល់​​លេចឡើង​ "
"បើ​កម្មវិធី​សម្គាល់​អាច​រក​បាន​​សម្រាប់​បង្អួច​នេះ ។"

#. Tag: title
#: index.docbook:1226
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu> ឧបករណ៍ </guimenu>"

#. Tag: menuchoice
#: index.docbook:1230
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Read Only Mode</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> របៀប​បានតែ​អាន  </guimenuitem>"

#. Tag: para
#: index.docbook:1234
#, no-c-format
msgid ""
"Set the current document to Read Only mode. This prevents any text addition and "
"any changes in the document formatting."
msgstr ""
"កំណត់​ឯកសារ​បច្ចុប្បន្ន​តាម​របៀបបាន​​តែ​អាន​ ។ ​ការពារ​ការបន្ថែម​អត្ថបទ​នេះ​ "
"ហើយ​ផ្លាស់ប្តូរ​ក្នុង​ការទ្រង់ទ្រាយ​ឯកសារ ។​"

#. Tag: menuchoice
#: index.docbook:1240
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Filletype</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ប្រភេទ​ឯកសារ </guimenuitem>"

#. Tag: para
#: index.docbook:1244
#, no-c-format
msgid ""
"Choose the filetype scheme you prefer for the active document. This overwrites "
"the global filetype mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem></menuchoice> "
"in the Filetypes tab for your current document only."
msgstr ""
"ជ្រើស​គ្រោងការណ៍​ប្រភេទ​ឯកសារ​ដែល​អ្នកចូលចិត្ត​ជាង​ឯកសារ​សកម្ម ។ "
"សរសេរជាន់​ពីលើ​របៀប​ប្រភេទ​ឯកសារ​សកល​កំណត់​ក្នុង​ <menuchoice> <guimenu> "
"ការកំណត់​ </guimenu> <guimenuitem> កំណត់​រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ​​ "
"...</guimenuitem></menuchoice> "
"ក្នុង​ថេប​ប្រភេទ​ឯកសារ​បានតែ​ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក ។​"

#. Tag: menuchoice
#: index.docbook:1254
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Highlighting</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ការបន្លិច </guimenuitem>"

#. Tag: para
#: index.docbook:1258
#, no-c-format
msgid ""
"Choose the Highlighting scheme you prefer for the active document. This "
"overwrites the global highlighting mode set in <menuchoice> <guimenu>"
"Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> "
"for your current document only."
msgstr ""
"ជ្រើស​គ្រោងកាណ៍​បន្លិច​ដែល​អ្នកចូល​ចិត្ត​ជាង​ឯកសារ​សកម្ម​ ។ "
"សរសេរជាន់​ពីលើ​ជា​របៀប​​ការបន្លិច​សកល​កំណត់​ក្នុង​ <menuchoice> <guimenu>"
"ការកំណត់​ </guimenu> <guimenuitem> កំណត់​រចនាសម្ព័ន្ធ​កម្មវិធិ​និពន្ធ  "
"...</guimenuitem></menuchoice> បាន​តែ​ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក ។​"

#. Tag: menuchoice
#: index.docbook:1267
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Indentation</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ការចូលបន្ទាត់ </guimenuitem>"

#. Tag: para
#: index.docbook:1271
#, no-c-format
msgid ""
"Choose the style of indentation you want for your active document. This "
"overwrites the global indentation mode set in <menuchoice> <guimenu>"
"Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> "
"for your current document only."
msgstr ""
"ជ្រើស​រចនាប័ទ្ម​ដែល​អ្នក​ចង់​ឲ្យ​ឯកសារ​សកម្ម​របស់​អ្នក​ចូល​បន្ទាត់​ ។ "
"សរសេរជាន់ពីលើ​របៀប​ការចូល​បន្ទាត់​សកល​កំណត់​ក្នុង​ <menuchoice> <guimenu>"
"ការកំណត់ </guimenu> <guimenuitem> កំណត់​រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ  "
"...</guimenuitem></menuchoice> បាន​តែ​ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក​ ។​"

#. Tag: menuchoice
#: index.docbook:1280
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Encoding</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ការអ៊ិនកូដ </guimenuitem>"

#. Tag: para
#: index.docbook:1284
#, no-c-format
msgid ""
"You can overwrite the default encoding set in <menuchoice> <guimenu>"
"Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> "
"in the <guilabel>Open/Save</guilabel> tab to set a different encoding for your "
"current document. The encoding you set here will be only valid for your current "
"document."
msgstr ""
"លំនាំដើម​អ្នកអាច​សរសេរ​ជាន់ពីលើ​ការអ៊ិនកូដ​កំណត់​ក្នុង​ <menuchoice> <guimenu>"
"ការកំណត់​​ </guimenu> <guimenuitem> កំណត់​រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ "
"...</guimenuitem></menuchoice> ក្នុង​ថេប  <guilabel> បើក ឬ​រក្សាទុក </guilabel> "
"ដើម្បី​កំណត់​ការអ៊ិនកូដ​ខុសៗគ្នា​​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក​ ។​ "
"ការអ៊ិនកូដ​ដែល​អ្នកកំណត់​នៅទីនេះ​​ត្រឹមត្រូវ​សម្រាប់​តែ​ឯកសារ​បច្ចុប្បន្ន​របស់​អ"
"្នក ។​"

#. Tag: menuchoice
#: index.docbook:1294
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>End of Line</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ចុង​បន្ទាត់ </guimenuitem>"

#. Tag: para
#: index.docbook:1298
#, no-c-format
msgid ""
"Choose your prefered end of line mode for your active document. This overwrites "
"the global end of line mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem></menuchoice> "
"for your current document only."
msgstr ""
"ជ្រើស​របៀប​ចុង​បន្ទាត់ដែល​អ្នកចូលចិត្ត​​សម្រាប់​ឯកសារ​សកម្ម​របស់​អ្នក​ ។ "
"សរសេរ​ជាន់​ពីលើចុង​បន្ទាត់​សកល​កំណត់​ក្នុង​ <menuchoice> <guimenu> "
"ការកំណត់​</guimenu> <guimenuitem> ការកំណត់​រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ "
"...</guimenuitem></menuchoice> បាន​តែ​ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក​ ។​"

#. Tag: menuchoice
#: index.docbook:1307
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu><guimenuitem> អក្ខរាវិរុទ្ធ...</guimenuitem>"

#. Tag: para
#: index.docbook:1311
#, no-c-format
msgid ""
"<action>This initiates the spellchecking program - a program designed to help "
"the user catch and correct any spelling errors.</action> "
"Clicking on this entry will start the checker and bring up the speller dialog "
"box through which the user can control the process. There are four settings "
"lined up vertically in the center of the dialog with their corresponding labels "
"just to the left. Starting at the top they are:"
msgstr ""
"<action> ការចាប់​ផ្តើម​កម្មវិធីពិនិត្យ​​អក្ខរាវិរុទ្ធ "
"កម្មវិធី​នេះ​ត្រូវ​បាន​រចនា​​ដើម្បី​ជួយ​អ្នក​ប្រើ​ក្នុង​ការ​ចាប់ "
"ហើយ​កែកំហុស​អក្ខរាវិរុទ្ធ​ ។ </action> កំពុង​ចុច​លើ​ធាតុ​នេះវា​ "
"នឹង​ចាប់​ផ្តើម​ពិនិត្យ​ហើយ "
"​បង្ហាញ​ប្រអប់​អក្ខរាវិរុទ្ធ​តាម​អ្វី​ដែ​ល​អ្នកប្រើ​អាច​គ្រប់គ្រង​ដំណើរការ ។ "
"មានការកំណត់​​បន្ទាត់​បញ្ឈរ​បួន​​ក្នុង​ប្រអប់​កណ្តាល​ដែល​មាន​ឆ្លើយតប​នឹង​ស្លាក​​ន"
"ៅ​ខាងឆ្វេង ។​កំពុង​ចាប់​ផ្តើមនៅ​កំពូល​ពួក​វា​គឺ ៖"

#. Tag: guilabel
#: index.docbook:1320
#, no-c-format
msgid "Unknown word:"
msgstr "ពាក្យ​ដែល​មិន​ស្គាល់ ៖"

#. Tag: para
#: index.docbook:1321
#, no-c-format
msgid ""
"Here, the spellchecker indicates the word currently under consideration. This "
"happens when the checker encounters a word not in its dictionary - a file "
"containing a list of correctly spelled words against which it compares each "
"word in the editor."
msgstr ""
"នេះជា​កម្មវិធី​ពិនិត្យ​​អក្ខរាវិរុទ្ធពាក្យ​បច្ចុប្បន្នក្រោម​ការពិចារណា​ "
"។​ការនេះ​កើតឡើង​ពេល​ជួបប្រទះ​កម្មវិធី​ពិនិត្យ​ពាក្យ​ដែល​មិន​ស្ថិត​ក្នុង​វចនានុក្"
"រម​ឯកសារ​មាន​បញ្ជីពិនិត្យ​អក្ខរាវិរុទ្ធ​ពាក្យ​​ប្រធៀប​ពាក្យ​នីមួយៗ​ក្នុង​កម្មវិធ"
"ី​និពន្ធ​ ។​"

#. Tag: guilabel
#: index.docbook:1327
#, no-c-format
msgid "Replace with:"
msgstr "ជំនួស​ជាមួយ ៖"

#. Tag: para
#: index.docbook:1328
#, no-c-format
msgid ""
"If the checker has any similar words in its dictionary the first one will be "
"listed here. The user can accept the suggestion, type in his or her own "
"correction, or choose a different suggestion from the next box."
msgstr ""
"បើ​កម្មវិធី​ពិនិត្យ​អក្ខរាវិរុទ្ធ​មាន​ពាក្យ​ស្រដៀងគ្នា​ច្រើន​នៅ​ក្នុង​វចនានុក្រម"
"​របស់​វា​ ជាដំបូង​វានឹង​រាយ​ជា​បញ្ជី​នៃ​ពាក្យ​នៅ​ទី​នេះ ។ "
"អ្នក​ប្រើ​អាច​យល់ព្រម​យោបល​ វាយ​កែពាក្យ​ផ្ទាល់​ខ្លួន​របស់​គាត់​ ឬ​នាង​ "
"ឬ​ជ្រើស​ការផ្តល់យោបល​ខុសៗគ្នា​ពី​ប្រអប់​បន្ទាប់ ។​"

#. Tag: guilabel
#: index.docbook:1334
#, no-c-format
msgid "Suggested Words:"
msgstr "ពាក្យ​ដែល​បាន​ផ្តល់យោបល​ ៖"

#. Tag: para
#: index.docbook:1335
#, no-c-format
msgid ""
"The checker may list here a number of possible replacements for the word under "
"consideration. Clicking on any one of the suggestions will cause that word to "
"be entered in the <guilabel>Replacement:</guilabel> box, above."
msgstr ""
"កម្មវិធី​ពិនិត្យ​ប្រហែលជា​រាយបញ្ជី​ចំនួន​នៃ​ការជំនួស​ពាក្យ​នៅទៅទី​នេះ​ក្រោម​ការ​"
"ពិនិត្យ​យ៉ាង​ត្រឹមត្រូវ​ ។ ចុច​លើ​ការផ្តល់យោបល់​មួយ "
"នឹង​បណ្តាល​ឲ្យ​ពាក្យ​ត្រូវ​បាន​បញ្ចូល​ក្នុង​ប្រអប់​ <guilabel> "
"ជំនួស ៖</guilabel> ខាងលើ​ ។​"

#. Tag: guilabel
#: index.docbook:1341
#, no-c-format
msgid "Language:"
msgstr "ភាសា ៖​"

#. Tag: para
#: index.docbook:1342
#, no-c-format
msgid ""
"If you have installed multiple dictionaries, here you can select which "
"dictionary/language should be used."
msgstr ""
"បើ​អ្នក​បាន​ដំឡើង​វចនាក្រម​ច្រើន អ្នកអាចជ្រើស​​វចនានុក្រម​ "
"ឬ​ភាសា​ដែល​ត្រូវ​ប្រើ​នៅទីនេះ ។"

#. Tag: para
#: index.docbook:1347
#, no-c-format
msgid ""
"On the right side of the dialog box are 5 buttons that allow the user to "
"control the spellcheck process. They are:"
msgstr ""
"នៅ​ផ្នែក​ខាង​ស្តាំ​នៃ​ប្រអប់​ "
"មាន​ប៊ូតុង​ចំនួន​ប្រាំ​ដែល​អនុញ្ញាត​ឲ្យ​អ្នកប្រើ​ពិនិត្យ​ដំណើរការ​ពិនិត្យ​អក្ខរា"
"វិរុទ្ធ​ ពួក​វា​ទាំងនោះ​គឺ ៖"

#. Tag: guibutton
#: index.docbook:1352
#, no-c-format
msgid "Add to Dictionary"
msgstr "បន្ថែម​ទៅ​ក្នុង​វចនានុក្រម​"

#. Tag: para
#: index.docbook:1353
#, no-c-format
msgid ""
"Pressing this button adds the word in the <guilabel>Misspelled Word:</guilabel> "
"box to the checker's dictionary. This means that in the future the checker will "
"always consider this word to be correctly spelled."
msgstr ""
"ចុច​ប៊ូតុង​នេះ​បន្ថែម​ពាក្យ​ជាច្រើន​ទៅ​ក្នុង​ប្រអប់​ <guilabel> "
"អក្ខរាវិរុទ្ធ​ពាក្យ​ខុស​ ៖</guilabel> ​ដើម្បី​ពិនិត្យ​ក្នុង​វចនានុក្រម​ "
"។.ការនេះ​មានន័យ​ថា​កម្មវិធី​ពិនិត្យអក្ខរាវិរុទ្ធ​​នឹង "
"​ពិនិត្យកែ​​អក្ខរាវិរុទ្ធ​ពាក្យ​នេះ ។​."

#. Tag: guibutton
#: index.docbook:1359
#, no-c-format
msgid "<guibutton>Replace</guibutton>"
msgstr "<guibutton> ជំនួស </guibutton>"

#. Tag: para
#: index.docbook:1360
#, no-c-format
msgid ""
"This button has the checker replace the word under consideration in the "
"document with the word in the <guilabel>Replacement:</guilabel> box."
msgstr ""
"ប៊ូតុង​នេះ​មានកម្មវិធី​ពិនិត្យ​អក្ខរាវិរុទ្ធ​ជំនួស​ពាក្យ​ក្រោម​ការត្រួតពិនិត្យ​យ"
"៉ាងត្រឹមត្រូវ​ក្នុង​ឯកសារ​ដែលមាន​ពាក្យ​ក្នុង​ប្រអប់​ <guilabel> "
"ការជំនួស ៖</guilabel> ។​"

#. Tag: guibutton
#: index.docbook:1365
#, no-c-format
msgid "Replace All"
msgstr "ជំនួស​ទាំងអស់​"

#. Tag: para
#: index.docbook:1366
#, no-c-format
msgid ""
"This button causes the checker to replace not only the current <guilabel>"
"Unknown word:</guilabel> but to automatically make the same substitution for "
"any other occurrences of this <guilabel>Misspelled Word:</guilabel> "
"in the document."
msgstr ""
"ប៊ូតុង​នេះ​នឹង​ពិនិត្យ​​មិន​ត្រឹមតែ​ <guilabel> "
"ពាក្យ​ដែល​មិន​ស្គាល់បច្ចុប្បន្ន​ ៖</guilabel> "
"ថែមទាំង​បង្កើតការជំនួស​សម្រាប់ការកើតឡើង​មួយ​ចំនួន​ដូចគ្នា​នៃ​ <guilabel> "
"អក្ខរាវិរុទ្ធ​ខុសពាក្យ ៖</guilabel> ក្នុង​ឯកសារ ។​"

#. Tag: guibutton
#: index.docbook:1372
#, no-c-format
msgid "Ignore"
msgstr "មិន​អើពើរ​"

#. Tag: para
#: index.docbook:1373
#, no-c-format
msgid ""
"Activating this button will have the checker move on without making any "
"changes."
msgstr ""
"ប៊ូតុង​ធ្វើ​ឲ្យ​សកម្ម​នេះ​ "
"នឹង​ពិនិត្យ​​ការផ្លាស់ទី​ដោយ​ពុំចាំបាច់​ធ្វើការ​ផ្លាស់ប្តូរ ។​"

#. Tag: guibutton
#: index.docbook:1377
#, no-c-format
msgid "Ignore All"
msgstr "មិនអើពើរ​ទាំងអស់ "

#. Tag: para
#: index.docbook:1378
#, no-c-format
msgid ""
"This button tells the checker to do nothing with the current <guilabel>"
"Unknown word:</guilabel> and to pass over any other instances of the same word."
msgstr ""
"ប៊ូតុង​នេះ​ប្រាប់​ទៅកម្មវិធី​ពិនិត្យ​​ដើម្បី​កុំ​ធ្វើ​អ្វី​ទាំងអស់​​ជាមួយ​ "
"<guilabel>ពាក្យ​ដែល​មិនស្គាល់ ៖</guilabel> "
"ហើយបោះបង់ចោល​នូវ​ការជំនួស​ពាក្យ​ដូច​គ្នា​មួយ​ចំនួន ។​"

#. Tag: para
#: index.docbook:1380
#, no-c-format
msgid ""
"This only applies to the current spellcheck run. If the checker is run again "
"later it will stop on this same word."
msgstr ""
"ការអនុវត្ត​នេះ​​សម្រាប់​តែ​រត់ការពិនិត្យ​អក្ខរាវិរុទ្ធ​បច្ចុប្បន្ន​ ។ "
"បើកម្មវិធីពិនិត្យ​រត់​ពេលក្រោយ​ម្តង​ទៀត​វា​នឹង​បញ្ឈប់​ពាក្យ​ដែល​ដូចគ្នាភ្លាម​ "
"។​"

#. Tag: para
#: index.docbook:1397
#, no-c-format
msgid ""
"Three more buttons are located horizontally along the bottom of the spellcheck "
"dialog. They are:"
msgstr ""
"មាន​ប៊ូតុង​បីទៀត​ដែល​មានទីតាំង​ផ្តេក​បណ្តោយ​តាម​ប្រអប់ពិនិត្យ​អក្ខរាវិរុទ្ធ​នៅ​ខ"
"ាងក្រោម​ប្រអប់​ ពួកវា​គឺ ៖"

#. Tag: guibutton
#: index.docbook:1402
#, no-c-format
msgid "<guibutton>Help</guibutton>"
msgstr "<guibutton> ជំនួយ​</guibutton>"

#. Tag: para
#: index.docbook:1403
#, no-c-format
msgid ""
"This invokes the &kde; help system starting at the &kwrite; help pages (this "
"document)."
msgstr ""
"ការហៅ​ប្រព័ន្ធ​ជំនួយ​របស់​ Kde នេះ​កំពុង​ចាប់​ផ្តើម​​ទំព័រ​ជំនួយ​ Kwrite "
"ជាច្រើន​  (ឯកសារ​នេះ)។​"

#. Tag: guibutton
#: index.docbook:1408
#, no-c-format
msgid "Finished"
msgstr "បានបញ្ចប់​"

#. Tag: para
#: index.docbook:1409
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""
"ប៊ូតុង​នេះ​បញ្ចប់​ដំណើរការ​ពិនិត្យ​អក្ខរាវិរុទ្ធ​ ហើយ​ត្រឡប់​ទៅ​កាន់​ឯកសារ​វិញ "
"។​"

#. Tag: guibutton
#: index.docbook:1414
#, no-c-format
msgid "Cancel"
msgstr "បោះបង់ចោល "

#. Tag: para
#: index.docbook:1415
#, no-c-format
msgid ""
"This button cancels the spellcheck process, all modifications are reverted, and "
"you will return to your document."
msgstr ""
"ប៊ូតុង​នេះ បោះបង់ចោល​ដំណើរការ​ពិនិត្យអក្ខរាវិរុទ្ថ​ "
"ការកែប្រែ​ទាំងអស់​ត្រូវ​បាន​ត្រឡប់ទៅ​ដើម​វិញ​ "
"ហើយ​អ្នក​នឹង​ត្រឡប់​ទៅ​កាន់​ឯកសារ​របស់​អ្នក​វិញ ។​"

#. Tag: menuchoice
#: index.docbook:1425
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> អក្ខរាវិរុទ្ធ​  (ពីទស្សន៍ "
"ទ្រនិច)...</guimenuitem>"

#. Tag: para
#: index.docbook:1429
#, no-c-format
msgid ""
"This initiates the spellchecking program but it starts where your cursor is "
"instead of at the beginning of the document."
msgstr ""
"នេះជា​ការចាប់ផ្តើម​កម្មវិធី​ពិនិត្យ​អក្ខរាវិរុទ្ធ​ថ្មី​មួយ "
"ប៉ុន្តែ​វា​ចាប់ផ្តើម​​នៅទីតាំង​ដែលទស្សន៍ទ្រនិច​ជំនួស​ការចាប់ផ្តើម​របស់​ឯកសារ​ "
"។​"

#. Tag: menuchoice
#: index.docbook:1435
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"ការជ្រើស​ពិនិត្យ​អក្ខរាវិរុទ្ធ​...</guimenuitem>"

#. Tag: para
#: index.docbook:1439
#, no-c-format
msgid "Spellchecks the current selection."
msgstr "ការជ្រើស​ពិនិត្យ​អក្ខរាវិរុទ្ធ​បច្ចុប្បន្ន​ ។​"

#. Tag: menuchoice
#: index.docbook:1444
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu><guimenuitem>Indent</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​ <keycap>I</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu><guimenuitem> ចូលបន្ទាត់​ </guimenuitem>"

#. Tag: para
#: index.docbook:1450
#, no-c-format
msgid ""
"This increases the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"pref-indent\"> indentation settings</link>."
msgstr ""
"បង្កើន​ការចូលបន្ទាត់​របស់កថាខណ្ឌ​នេះ​​ម្តង​មួយ​ជំហាន​ៗ ។ "
"ទំហំ​របស់ជំហាន​អាស្រ័យ​លើ​ <link linkend=\"pref-indent\"> "
"ការកំណត់​ការចូល​បន្ទាត់ </link> ។"

#. Tag: menuchoice
#: index.docbook:1457
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>I</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu><guimenuitem>Unindent</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>I</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu><guimenuitem> "
"មិន​ចូល​បន្ទាត់​ </guimenuitem>"

#. Tag: para
#: index.docbook:1464
#, no-c-format
msgid ""
"This reduces the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"pref-indent\"> indentation settings</link>."
msgstr ""
"បង្រួម​ការចូលបន្ទាត់​របស់​កថាខណ្ឌ​នេះ​ម្តងមួយជំហាន​ៗ ។ "
"ទំហំ​ជំហាន​នេះ​ពឹងផ្នែក​លើ​ <link linkend=\"pref-indent\"> "
"ការកំណត់​ចូ​លបន្ទាត់ </link> ។​"

#. Tag: menuchoice
#: index.docbook:1472
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu><guimenuitem> ជម្រះ​​ការចូលបន្ទាត់ </guimenuitem>"

#. Tag: para
#: index.docbook:1475
#, no-c-format
msgid ""
"This cleans the indentation for the current selection or for the line the "
"cursor is currently in. Cleaning the indentation ensures that all your selected "
"text follows the indentation mode you choose."
msgstr ""
"ជម្រះការចូលបន្ទាត់​របស់​ការជ្រើស​បច្ចុប្បន្ន​ "
"ឬ​សម្រាប់ទស្សន៍ទ្រនិច​បន្ទាត់​បច្ចុប្បន្ន​ ។ "
"កំពុង​ជម្រះ​ការចូល​បន្ទាត់​ដែលធានា​គ្រប់​អត្ថបទ​ដែល​បាន​ជ្រើស​ទាំងអស់​ធ្វើ​តាម​រ"
"បៀប​ការចូល​បន្ទាត់​ដែល​អ្នកបានជ្រើស ។​"

#. Tag: menuchoice
#: index.docbook:1482
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> តម្រឹម </guimenuitem>"

#. Tag: para
#: index.docbook:1487
#, no-c-format
msgid ""
"Causes a realign of the current line or selected lines using the indentation "
"mode and indentation settings in the doucment."
msgstr ""
"ការតម្រៀត​បន្ទាត់​បច្ចុប្បន្ន​ "
"ឬ​បន្ទាត់​ដែល​បាន​ជ្រើស​ប្រើ​របៀប​ការចូល​បន្ទាត់​ការកំណត់​ក្នុង​ឯកសារ​ ។​"

#. Tag: menuchoice
#: index.docbook:1493
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>D</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"សេចក្តីអធិប្បាយ </guimenuitem>"

#. Tag: para
#: index.docbook:1500
#, no-c-format
msgid ""
"This adds one space to the beginning of the line where the text cursor is "
"located or to the beginning of any selected lines."
msgstr ""
"បន្ថែម​ចន្លោះ​មួយ​នេះ​ដើម្បី​ចាប់ផ្តើម​បន្ទាត់ទីតាំងណា​ដែលទស្សន៍ទ្រនិច​អត្ថបទឋិត"
"​នៅ​ ឬ​ចាប់ផ្តើម​​បន្ទាត់​មួយ​ចំនួន​ដែល​បានជ្រើស​ ។​"

#. Tag: menuchoice
#: index.docbook:1507
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>D</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"មិនមែនជា​សេចក្តីអធិប្បាយ​</guimenuitem>"

#. Tag: para
#: index.docbook:1514
#, no-c-format
msgid ""
"This removes one space (if any exist) from the beginning of the line where the "
"text cursor is located or from the beginning of any selected lines."
msgstr ""
"យក​ចន្លោះ​មួយ​នេះ​ចេញ​ (បើ​វា​មាន​រួចហើយ) "
"ពីការ​ចាប់ផ្តើម​បន្ទាត់ទីតាំងណា​ដែលទស្សន៍ទ្រ និច​អត្ថបទឋិត​នៅ​ "
"ឬ​ចាប់ផ្តើម​​បន្ទាត់​មួយ​ចំនួន​ដែល​បានជ្រើស​ ។​"

#. Tag: menuchoice
#: index.docbook:1520
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>U</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> អក្សរធំ </guimenuitem>"

#. Tag: para
#: index.docbook:1527
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""
"ដាក់​អត្ថបទ​ដែលបានជ្រើស​ ឬ​បន្ទាប់​ពី​តួអក្សរ​ទស្សន៍ទ្រនិច​ស្ថិត​ជា​អក្សរ​ធំ ។​"

#. Tag: menuchoice
#: index.docbook:1532
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>U</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> អក្សរ​តូច </guimenuitem>"

#. Tag: para
#: index.docbook:1539
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""
"ដាក់​អត្ថបទ​ដែល​បានជ្រើស​ ឬ​​បន្ទាប់​ពី​តួអក្សរ​ទស្សន៍ទ្រនិច​ស្ថិត​ជា​អក្សរ​តូច "
"។​"

#. Tag: menuchoice
#: index.docbook:1544
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> ជំនួស​ បញ្ជា <keycap>U</keycap>"
"</keycombo> </shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"អក្សរ​ធំ </guimenuitem>"

#. Tag: para
#: index.docbook:1551
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr "អត្ថបទ​តួអក្សរ​ធំ​ត្រូវ​បានជ្រើស​ ឬ​ពាក្យ​បច្ចុប្បន្ន​ ។​"

#. Tag: menuchoice
#: index.docbook:1556
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>J</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> តបន្ទាត់ </guimenuitem>"

#. Tag: para
#: index.docbook:1563
#, no-c-format
msgid ""
"Joins the selected lines, or the current line and the line below with one white "
"space character as a separator. Leading/trailing white space on joined lines is "
"removed in the affected ends."
msgstr ""
"ត​បន្ទាត់​ដែល​បានជ្រើស​ ឬ​បន្ទាត់​បច្ចុប្បន្ន​ "
"ហើយ​បន្ទាត់​ខាងក្រោម​​​ដែល​បានដកឃ្លា​បំបែក ​ដោ​យ​តួអក្សរ​ ។ ដកឃ្លា​ពីមុខ​មុខ "
"ឬពី​​នៅ​ក្រសម្រាប់​បន្ទាត់​ដែល​បាន​ត​ត្រូវ​បាន​យកចេញ​iដែល​មានឥទ្ធិពល​លើ​ចុង​បន្ទ"
"ាត់ ។​​ds."

#. Tag: menuchoice
#: index.docbook:1569
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Wrap Document</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ឯកសារ​រុំពាក្យ  </guimenuitem>"

#. Tag: para
#: index.docbook:1573
#, no-c-format
msgid ""
"Apply static word wrapping on all the document. That means that a new line of "
"text will automatically start when the current line exceeds the length "
"specified by the Wrap words at: option in the Editing tab in <menuchoice> "
"<guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem>"
"</menuchoice>"
msgstr ""
"អនុវត្ត​ការរុំពាក្យ​ឋិតិវន្តនៅ​លើ​ឯកសារ​ទាំងអស់ ។ "
"មានន័យ​ថា​បន្ទាត់ថ្មី​របស់​អត្ថបទ​ "
"នឹង​ចាប់​ផ្តើម​ដោយ​ស្វ័យប្រវត្តិ​ពេល​ប្រវែង​បន្ទាត់​​បច្ចុប្បន្ន​ដែល​បាន​កំណត់​ម"
"ាន​ចំនួនលើ​ តាម​ការរុំ ពាក្យ​ ៖ ជម្រើស​ក្នុង​ថេប​ការកែសម្រួល​ក្នុង​  "
"<menuchoice> <guimenu> ការកំណត់ </guimenu><guimenuitem> "
"កំណត់រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ ...</guimenuitem></menuchoice>"

#. Tag: title
#: index.docbook:1587
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu> ការកំណត់ </guimenu> "

#. Tag: menuchoice
#: index.docbook:1591
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់ </guimenu> <guimenuitem> បង្ហាញ​របារ​ឧបករណ៍  </guimenuitem>"

#. Tag: para
#: index.docbook:1597
#, no-c-format
msgid ""
"When checked, this displays a movable toolbar containing buttons used to "
"initiate frequently used commands. When unchecked the toolbar is hidden."
msgstr ""
"ពេលបានធីក បង្ហាញ​របារឧបករណ៍​ដែល​អាច​ផ្លាស់ទី​ប៊ូតុង​នេះ​ "
"ត្រូវ​បានប្រើ​​សម្រាប់​ចាប់ផ្តើម​ប្រើ​ពាក្យ​បញ្ជា​រារឿយៗ ។ "
"ពេល​មិនទាន់ធីក​របារឧបករណ៍បាន​​លាក់​ ។"

#. Tag: menuchoice
#: index.docbook:1605
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់ </guimenu><guimenuitem> បង្ហាញ​ររបារស្ថានភាព </guimenuitem>"

#. Tag: para
#: index.docbook:1609
#, no-c-format
msgid ""
"When checked, this displays a small bar at the bottom of the editor containing "
"information about the status of the current document. When unchecked the "
"statusbar is hidden."
msgstr ""
"ពេល​បានធីក "
"របារតូច​នេះ​បង្ហាញ​នៅ​បាត​របស់​កម្មវិធី​និពន្ធ​មាន​ព័ត៌មាន​អំពី​ស្ថានភាព​របស់​ឯក"
"សារ​បច្ចុប្បន្ន​ ។ ពេលមិន​បានធីក​របារស្ថានភាព​បាន​លាក់ ។​"

#. Tag: menuchoice
#: index.docbook:1616
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Path</guimenuitem>"
msgstr "<guimenu> ការកំណត់ </guimenu><guimenuitem> បង្ហាញ​ផ្លូវ </guimenuitem>"

#. Tag: para
#: index.docbook:1620
#, no-c-format
msgid ""
"When selected, this displays in the titlebar the path (its location in the file "
"system) of the current document. When unchecked the path is hidden."
msgstr ""
"ពេល​ដែលបានជ្រើស​ បង្ហាញ​ផ្លូវ​ក្នុង​របារចំណងជើង​នេះ​ "
"(ទីតាំង​របស់វា​ក្នុង​ប្រព័ន្ធ​ឯកសារ ) របស់​ឯកសារ​បច្ចុប្បន្ន ។ "
"ពេល​មិនបានធីក​ផ្លូវ​បានលាក់​ ។​"

#. Tag: menuchoice
#: index.docbook:1626
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់​​ </guimenu> <guimenuitem> កំណត់រចនាសម្ព័ន្ធ​កម្មវិធីនិពន្ធ "
"...</guimenuitem>"

#. Tag: para
#: index.docbook:1632
#, no-c-format
msgid ""
"This menu item opens a dialog whereby several different <link "
"linkend=\"pref-dialog\">settings</link> may be adjusted."
msgstr ""
"បើប្រអប់​ធាតុ​ម៉ឺនុយ​នេះ  <link linkend=\"pref-dialog\"> ការកំណត់ </link> "
"ដែលខុសគ្នា​មួយ​ចំនួន​ត្រូវ​បាន​លៃតម្រូវ ។​"

#. Tag: menuchoice
#: index.docbook:1640
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Choose Editor...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់ </guimenu> <guimenuitem> ជ្រើស​កម្មវិធី​និពន្ធ "
"...</guimenuitem>"

#. Tag: para
#: index.docbook:1646
#, no-c-format
msgid ""
"Choose the default text editing component that you wish to use in &kwrite;. You "
"can choose <guilabel>System Default</guilabel>, <guilabel>"
"Embedded Advanced Text Editor</guilabel> or <guilabel>"
"&Qt; Designer Based Text Editor</guilabel> (note that the &Qt; Designer Based "
"Text Editor is only available if you have KDevelop installed on your system). "
"If you choose <guilabel>System Default</guilabel>, &kwrite; will honor your "
"changes in &kcontrolcenter;. All other choices will override that setting."
msgstr ""
"ជ្រើស​សមាសភាគ​កែសម្រួល​អត្ថបទ​លំនាំដើម​ ដែលអ្នកចង់​ប្រើ​ក្នុង​ Kwrite ។ "
"អ្នកអាច​ជ្រើស​  <guilabel> លំនាំដើម​ប្រព័ន្ធ </guilabel>, <guilabel> "
"កម្មវិធី​និពន្ធ​អត្ថបទ​កម្រិត​ខ្ពស់​ដែល​បានបង្កប់​ </guilabel> ឬ <guilabel> "
"កម្មវិធី​និពន្ធ​អត្ថបទដែល​មានមូលដ្ឋាន​កម្មវិធី​រចនា​ Qt </guilabel> "
"(ចំណាំថា កម្មវិធី​និពន្ធ​មូលដ្ឋាន​កម្មវិធី​រចនា​ អាច​បាន​តែ​រក​បាន​បើ​អ្នក "
"បានដំឡើង​ KDevelop លើ​ប្រព័ន្ធ​របស់​អ្នក) ។ បើ​អ្នកជ្រើស​ <guilabel> "
"លំនាំដើម​ប្រព័ន្ធ </guilabel> Kwrite នឹង​ផ្លាស់ប្តូរក្នុង​ Kcontrolcenter ។ "
"ជម្រើស​ផ្សេងទៀត​មួយ​ចំនួន​ នឹង​ត្រូវ​បាន​បដិសេធ​ការកំណត់ ។​"

#. Tag: menuchoice
#: index.docbook:1659
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់​​ </guimenu><guimenuitem> កំណត់រចនាសម្ព័ន្ធ​ផ្លូវ កាត់  "
"...</guimenuitem>"

#. Tag: para
#: index.docbook:1663
#, fuzzy, no-c-format
msgid ""
"This command opens a dialog box whereby the <link linkend=\"keybindings\">"
"shortcuts</link> may be changed. A display window at the top of the dialog box "
"shows the list of commands (actions) that can have keyboard shortcuts. Below "
"the display are three radio buttons. The user may choose between No Key, "
"Default Key, and Custom Key. (Note that a set of radio buttons only allows the "
"selection of one of the offered items - in the way that buttons on a car radio "
"only offer the selection of one preset station. Also, the Default Key selection "
"is only available for those commands that actually have a 'default' shortcut.) "
"Selecting the Custom Key option activates the three check boxes and key button "
"at the bottom of the dialog. The user may then select a key combination for the "
"command in question by means of the check boxes and key button. For example, "
"with the About &kde; command selected in the display window, the user could "
"select &Ctrl; and <keycap>Alt</keycap>, click on the key button, and then press "
"the <keycap>K</keycap> key on the keyboard. This would mean that anytime he or "
"she held down the &Ctrl; and <keycap>Alt</keycap> buttons and pressed <keycap>"
"K</keycap> (while using &kwrite;) the About &kde; display box would be called."
msgstr ""
"បើ​ប្រអប់​ពាក្យ​បញ្ជា​នេះ​  ហេតុ​នេះ​ហើយ​ <link linkend=\"keybindings\"> "
"ផ្លូវកាត់​ </link> ប្រហែល​ជា​ត្រូវ​បាន​ផ្លាស់ប្តូរ ។ "
"បង្ហាញ​បង្អួច​នៅ​កំពូល​នៃ​ប្រអប់​ បង្ហាញ​បញ្ជី​ពាក្យបញ្ជា​ (អំពើ) "
"ហើយ​មាន​ផ្លូវកាត់​ក្តារចុច​ ។  បង្ហាញ​ប៊ូតុង​មូលចំនួន បី​ដូចខាងក្រោម​នេះ ។ "
"អ្នកប្រើ​ប្រហែល​ជា​ជ្រើស​គ្មាន​គ្រាប់ចុច​ គ្រាប់ចុច​លំនាំដើម​ "
"និង​គ្រាប់ចុច​ផ្ទាល់ខ្លួន​ ។ "
"(ចំណាំថា​បាន​តែ​កំណត់​ប៊ូតុង​មូល​​អនុញ្ញាត​ឲ្យ​ការជ្រើស​យក​ធាតុ​មួយ​ដែល​បានផ្តល់"
"​ឲ្យ​ - in the way that buttons on a car radio only offer the selection of one "
"preset station. Also, the Default Key selection is only available for those "
"commands that actually have a 'default' shortcut.) Selecting the Custom Key "
"option activates the three check boxes and key button at the bottom of the "
"dialog. The user may then select a key combination for the command in question "
"by means of the check boxes and key button. For example, with the About &kde; "
"command selected in the display window, the user could select &Ctrl; and "
"<keycap>Alt</keycap>, click on the key button, and then press the <keycap>"
"K</keycap> key on the keyboard. This would mean that anytime he or she held "
"down the &Ctrl; and <keycap>Alt</keycap> buttons and pressed <keycap>K</keycap> "
"(while using &kwrite;) the About &kde; display box would be called."

#. Tag: menuchoice
#: index.docbook:1684
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់ </guimenu><guimenuitem> កំណត់រចនាសម្ព័ន្ធ​របារឧបករណ៍ "
"...</guimenuitem>"

#. Tag: para
#: index.docbook:1687
#, no-c-format
msgid ""
"This will open the dialog whereby the toolbar configuration may be changed. The "
"user can choose which shortcut buttons should appear on the toolbar. A display "
"window on the left lists the commands available to placed on the toolbar. A "
"display on the right lists those commands already on the toolbar. A set of four "
"arrow buttons between the two displays manipulates the selections. The right "
"pointing arrow places any command selected in the left pane onto the right "
"pane, <abbrev>i.e.</abbrev>, it is added to the toolbar. The left arrow does "
"just the opposite, removing any action selected in the right window from the "
"toolbar. The up and down pointing arrows change the position of an action "
"selected in the right window which changes the position of its button in the "
"toolbar."
msgstr ""
"ការកំណត់​នេះ​ នឹង​បើ​ប្រអប់​ការកំណត់​រចនាសម្ព័ន្ធ​របារឧបករណ៍​ប្រហែល​ជាត្រូវ​បាន "
"​ផ្លាស់ប្តូរ ។ អ្នកប្រើ​អាច​ជ្រើស​ប៊ូតុង​ផ្លូវកាត់​មួយណា​ដែលគួរតែ​លេចឡើង​នៅ​លើ "
"​របារឧបករណ៍ ។  "
"បង្ហាញ​បង្អួច​នៅ​ខាងឆ្វេង​បញ្ជីពាក្យ​បញ្ជា​ដែល​អាច​យក​វា​ទៅ​ដាក់​នៅ​លើ "
"​របារឧបករណ៍ ។ "
"បង្ហាញ​បញ្ជី​ពាក្យ​បញ្ជា​ទាំងនោះ​នៅ​ផ្នែក​ខាងស្តាំ​លើ​របារឧបករណ៍​ដែល​មាន​រួចហើយ "
"។  កំណត់​ប៊ូតុង​ព្រួញ​ចំនួន​បួន​រវាង​ការជ្រើស​​រៀបចំបង្ហាញ​ ។ "
"កំពុង​ចង្អុល​ព្រួញ​ខាងស្តាំ​ហើយ​ដាក់​ពាក្យ​បញ្ជា​មួយ​ចំនួន​ដែល​ត្រូវ​ជ្រើស​ក្នុង"
"​បន្ទះ​ខាងឆ្វេង​ផ្នែក​ខាងស្តាំ​បន្ទះ​ <abbrev> ឧទាហរណ៍ </abbrev> "
"វា​ត្រូវ​បាន​បន្ថែម​ទៅ​កាន់​របារឧបករណ៍។ "
"ព្រួញ​ខាងឆ្វេងផ្ទុយ​និង​ការយកចេញ​សកម្មភាព​ដែល​បាន​ជ្រើស​ក្នុង​បង្អួច​ខាងស្តាំ​ពី"
"​របារឧបករណ៍ ។ ព្រួញចង្អុរឡើងលើ​ "
"និង​ចុះក្រោម​ផ្លាស់ប្តូរ​ទីតាំង​របស់សកម្មភាព​ដែល​បាន​ជ្រើស​ក្នុង​បង្អួច​ខាងស្តាំ"
"​ដែល​ផ្លាស់ប្តូរ​ទីតាំង​ប៊ូតុង​របស់​វា​ក្នុង​របារឧបករណ៍ ។"

