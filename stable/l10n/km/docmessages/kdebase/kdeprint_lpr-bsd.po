#. Tag: title
#: lpr-bsd.docbook:2
#, no-c-format
msgid "<acronym>LPR</acronym> (<acronym>BSD</acronym>)"
msgstr "<acronym>LPR</acronym> (<acronym>BSD</acronym>)"

#. Tag: para
#: lpr-bsd.docbook:4
#, no-c-format
msgid ""
"Plain (old?) <acronym>LPR</acronym> support. An <acronym>LPRng</acronym> "
"module is in development, and hopefully available for 2.3 release."
msgstr ""
"អត្ថបទ​ធម្មតា​ (អត្ថបទចាស់ៗឬ?) គាំទ្រ​<acronym>LPR</acronym> ។  <acronym>LPRng</acronym> "
"ម៉ូឌុល​ជា​ការអភិវឌ្ឍ ហើយ​សង្ឃឹម​ថា​អាច​រក​បាន​ផ្សាយចេញ  ២.៣ ។​"

#. Tag: title
#: lpr-bsd.docbook:9
#, no-c-format
msgid "Overview of Provided Features"
msgstr "ទិដ្ឋភាព​ទូទៅ​នៃលក្ខណៈពិសេស​ដែលបានផ្តល់​ឲ្យ​"

#. Tag: para
#: lpr-bsd.docbook:13
#, no-c-format
msgid ""
"Printer management: basic support to add/remove/configure a printer, compatible "
"with &RedHat;-6.x systems (<command>printtool</command> "
"+ rhs-printfilers packages)."
msgstr "ការគ្រប់គ្រង​ម៉ាស៊ីន​បោះពុម្ព ៖ មូលដ្ឋានគាំទ្រ​ការកំណត់​រចនាសម្ព័ន្ធ​បន្ថែម​ យកចេញត្រូវគ្នា​ជាមួយ​ប្រព័ន្ធ​ RedHat -៦.x  (<command>printtool</command> + កញ្ចប់ rhs-printfilers ) ។​"

#. Tag: para
#: lpr-bsd.docbook:18
#, no-c-format
msgid "Job management: not supported"
msgstr "ការគ្រប់គ្រង​ការងារ​ ៖ មិនត្រូវ​បានគាំទ្រ​"

#. Tag: para
#: lpr-bsd.docbook:21
#, no-c-format
msgid "Print options: basic control"
msgstr "ជ្រើស​បោះពុម្ព ៖ មូលដ្ឋាន​វត្ថុបញ្ជា"

