#. Tag: cmdsynopsis
#: man-appletproxy.1.docbook:29
#, no-c-format
msgid ""
"<command>appletproxy</command> <arg choice=\"req\">desktopfile</arg> "
"<arg choice=\"opt\">--configfile <replaceable>file</replaceable></arg> "
"<arg choice=\"opt\">--callbackid <replaceable>id</replaceable></arg> "
"<arg choice=\"opt\">KDE Generic Options</arg> <arg choice=\"opt\">"
"Qt Generic Options</arg>"
msgstr ""
"<command>appletproxy</command> <arg choice=\"req\"> "
"ឯកសារ​ផ្ទៃតុ​</arg> "
"<arg choice=\"opt\">--ឯកសារ​ប៉ទង្គិច​ <replaceable>ឯកសារ​</replaceable></arg> "
"<arg choice=\"opt\">--callbackid <replaceable>id</replaceable></arg> "
"<arg choice=\"opt\"> ជម្រើស​ប្រភេទ KDE </arg> <arg choice=\"opt\">"
"ជម្រើស​ប្រភេទ Qt </arg>"

#. Tag: title
#: man-appletproxy.1.docbook:40
#, no-c-format
msgid "Description"
msgstr "ការពិពណ៌នា"

#. Tag: para
#: man-appletproxy.1.docbook:41
#, no-c-format
msgid ""
"<application>appletproxy</application> is a small application that allows you "
"to run a &kicker; (&kde; panel) applet outside of &kicker; itself. The applet "
"will appear in it's own window, making this a convenient way to debug panel "
"applets."
msgstr ""
"<application>appletproxy</application> ជា​កម្មវិធី​តូច​មួយ​ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​រត់​ &kicker; ( បន្ទះ &kde; ) អាប់ភ្លេត​នៅ​ក្រៅ​ &kicker; ។ អាប់ភ្លេត​ នឹង​លេច​ឡើង​ក្នុ​ង​បង្អួច​ផ្ទាល់​ខ្លួន​របស់​វា​"
" បង្កើត​វិធី​យ៉ាង​ងាស្រួល​ដើម្បីបំបាត់​កំហុស​បន្ទះ​អាប់ភ្លេត​ ។​"

