#. Tag: cmdsynopsis
#: man-appletproxy.1.docbook:29
#, no-c-format
msgid ""
"<command>appletproxy</command> <arg choice=\"req\">desktopfile</arg> "
"<arg choice=\"opt\">--configfile <replaceable>file</replaceable></arg> "
"<arg choice=\"opt\">--callbackid <replaceable>id</replaceable></arg> "
"<arg choice=\"opt\">KDE Generic Options</arg> <arg choice=\"opt\">"
"Qt Generic Options</arg>"
msgstr ""
"<command>ប្រូកស៊ី​អាប់ភ្លេត</command> <arg choice=\"req\">ឯកសារ​ផ្ទៃតុ</arg> "
"ឯកសារ<arg choice=\"opt\">--configfile <replaceable></replaceable></arg> "
"លេខសម្គាល់<arg choice=\"opt\">--callbackid <replaceable></replaceable></arg> "
"<arg choice=\"opt\">ជម្រើស​ទូទៅ​របស់ KDE​</arg> <arg choice=\"opt\">"
"ជម្រើស​ទូទៅ​របស់ Qt​</arg>"

#. Tag: title
#: man-appletproxy.1.docbook:40
#, no-c-format
msgid "Description"
msgstr "សេចក្ដី​ពិពណ៌នា"

#. Tag: para
#: man-appletproxy.1.docbook:41
#, no-c-format
msgid ""
"<application>appletproxy</application> is a small application that allows you "
"to run a &kicker; (&kde; panel) applet outside of &kicker; itself. The applet "
"will appear in it's own window, making this a convenient way to debug panel "
"applets."
msgstr ""
"<application>ប្រូកស៊ី​អាប់ភ្លេត</application> "
"គឺ​ជា​កម្មវិធី​តូច​មួយ​ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​រត់ Kicker (បន្ទះ​របស់ Kde) "
"អាប់ភ្លេត​ខាង​ក្រៅ​របស់​ Kicker ខ្លួន​វា​ផ្ទាល់ ។ "
"អាប់ភ្លេត​នឹង​បង្ហាញ​នៅ​ក្នុង​បង្អួច​ផ្ទាល់​របស់​វា "
"ធ្វើ​ឲ្យ​វា​ជា​វិធី​ងាយស្រួល​ដើម្បី​បំបាត់​កំហុស​អាប់ភ្លេត​បន្ទះ ។"

