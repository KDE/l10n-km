#. Tag: title
#: menus.docbook:8 menus.docbook:283
#, no-c-format
msgid "Menu Entries"
msgstr "ធាតុម៉ឺនុយ​"

#. Tag: title
#: menus.docbook:11
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ​ <guimenu> ឯកសារ </guimenu>"

#. Tag: menuchoice
#: menus.docbook:17
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​ <keycap>N</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> ថ្មី </guimenuitem>"

#. Tag: para
#: menus.docbook:26
#, no-c-format
msgid ""
"This command <action>starts a new document</action> in the editing window. In "
"the <guibutton>Documents</guibutton> list on the left the new file is named "
"<emphasis>Untitled</emphasis>."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ​ <action> ចាប់​ផ្តើម​ឯកសារ​ថ្មី </action> "
"ក្នុង​បង្អួច​ការកែសម្រួល​ ។​នៅ​ក្នុង​បញ្ជី​ <guibutton> ឯកសារ​ </guibutton> "
"នៅ​ផ្នែក​ខាង​ឆ្វេង​​ឯកសារ​ថ្មី​ត្រូវ​បាន​ដាក់ឈ្មោះ​ថា​ <emphasis> "
"មិនទាន់​មានចំណង​ជើង​ </emphasis> ។​"

#. Tag: menuchoice
#: menus.docbook:37
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​<keycap>O</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ​ </guimenu> <guimenuitem> បើក​...</guimenuitem>"

#. Tag: para
#: menus.docbook:46
#, no-c-format
msgid ""
"Launches &kde;'s open file dialog box to let you open one or more files."
msgstr ""
"បើក​ដំណើរការ​​ប្រអប់​បើក​ឯកសារ​របស់​ kde ដើម្បី​អនុញ្ញាត​ឲ្យ​អ្នក​បើក​ឯកសារ​មួយ "
"ឬ​ច្រើន​ ។​"

#. Tag: menuchoice
#: menus.docbook:55
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr ""
"<guimenu> ឯកសារ </guimenu> <guimenuitem> បើក​បច្ចុប្បន្ន​</guimenuitem>"

#. Tag: para
#: menus.docbook:61
#, no-c-format
msgid ""
"This command allows you to <action>open a file</action> "
"from a submenu that contains a list of recently edited files."
msgstr ""
"ពាក្យ​បញ្ជា​នេះអនុញ្ញាត​ឲ្យ​អ្នក​ <action> បើក​ឯកសារ​ </action> "
"ពី​ម៉ឺនុយ​រង​បានរាយ​បញ្ជី​​ក្នុង​ឯកសារដែល​បានកែសម្រួល ​បច្ចុប្បន្ន​ ។ "

#. Tag: menuchoice
#: menus.docbook:71
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open With</guimenuitem>"
msgstr "<guimenu> ឯកសារ </guimenu> <guimenuitem> បើកជាមួយ​</guimenuitem>"

#. Tag: para
#: menus.docbook:77
#, no-c-format
msgid ""
"This submenu presents a list of applications known to handle the mime type of "
"your current document. Activating an entry will open the current document with "
"that application."
msgstr ""
"ម៉ឺនុយ​រង​នេះ​បង្ហាញ​បញ្ជី​នៃ​កម្មវិធី​ជាច្រើន​ដែល​បាន​ស្គាល់​ដើម្បី​ដោះស្រាយ​ប្"
"រភេទ​ mime នៃ​ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក​ ។  "
"ធាតុ​ដែល​សកម្ម​នឹង​បើក​ឯកសារ​បច្ចុប្បន្ន​ដែល​មាន​ឯកសារ​​។​"

#. Tag: para
#: menus.docbook:81
#, no-c-format
msgid ""
"In addition, a entry <guimenuitem>Other...</guimenuitem> "
"command launches the open with dialog box that allows you to <action>"
"select another application to open the active file</action>"
". Your file will still be open in &kate;."
msgstr ""
"លើស​ពីនេះ​ទៀត​ បើ​កដំណើរការ​ពាក្យ​បញ្ជា​ធាតុ <guimenuitem> "
"ផ្សេងទៀត​...</guimenuitem> បើ​ក​ជា​មួយ​ប្រអប់​ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​ <action> "
"ជ្រើស​កម្មវិធី​ផ្សេងទៀត​​ដើម្បី​បើក​ឯកសារ​អំពើ​ </action>"
" ។ ឯកសារ​របស់​អ្នកនឹង​នូវ​តែ​បើ​ក​ក្នុង​ kate ​។"

#. Tag: menuchoice
#: menus.docbook:91
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​<keycap>S</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ​ </guimenu> <guimenuitem> រក្សាទុក </guimenuitem>"

#. Tag: para
#: menus.docbook:100
#, no-c-format
msgid ""
"This command <action>saves your file</action>. Use it often. If the file is "
"<emphasis>Untitled</emphasis> then <guimenuitem>Save</guimenuitem> "
"becomes <guimenuitem>Save As</guimenuitem>."
msgstr ""
"បញ្ជា​នេះ​ <action> រក្សា​ទុក​ឯកសារ​របស់​អ្នក </action>"
" ។​បើ​វា​ជា​ញឹកញាប់​ ។​ បើ​ឯកសារ​<emphasis> មិន​ទាន់​ដាក់​ចំណង​ជើង​ </emphasis> "
"បន្ទាប់​មក​ <guimenuitem> រក្សាទុក​​</guimenuitem> ទៅជា​ <guimenuitem> "
"រក្សាទុកជា​ </guimenuitem>​។​"

#. Tag: menuchoice
#: menus.docbook:112
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu> ឯកសារ​ </guimenu> <guimenuitem> រក្សាទុកជា​...</guimenuitem>"

#. Tag: para
#: menus.docbook:118
#, no-c-format
msgid ""
"<action>Name and rename files</action> with this command. It launches the save "
"file dialog box. This dialog works just as the open file dialog box does. You "
"can use it to navigate through your file system, preview existing files, or "
"filter your file view with file masks."
msgstr ""
"<action> ឈ្មោះ ​និង​ប្តូរ​ឈ្មោះ​ឯកសារ​ </action> ជា​មួយ​ពាក្យ​បញ្ជា​នេះ  ។ "
"វា​បើក​បង្ហាញ​​ប្រអប់​រក្សា​ឯកសារ​ទុក​ ។ "
"ប្រអប់​នេះធ្វើ​ការ​គ្រាន់​តែ​បើក​ប្រអប់​​ឯកសារ​។ "
"អ្នកអាច​ប្រើ​វា​ដើម្បី​រុករក​តាម​ប្រព័ន្ធ​ឯកសារ​របស់​អ្នក​មើលឯកសារ​ដែល​មានរួច​ជា"
"​មុន​ ឯ​តម្រង​មើល​ឯកសារ​របស់​អ្នក​ជា​មួយ​ឯកសារ​សម្គាល់​ ។​"

#. Tag: para
#: menus.docbook:126
#, no-c-format
msgid ""
"Type the name you want to give the file you are saving in the Location combo "
"box and press the <guibutton>OK</guibutton> button."
msgstr ""
"វាយ​ឈ្មោះ​ដែល​អ្នក​ចង់​ផ្តល់​នូវ​ឯកសារ​ដែល​អ្នកកំពុង​រក្សាទុក​ក្នុង​ទីតាំង​ប្រអប"
"់​បន្សំ​ ហើយ​ចុ​ច​ប៊ូតុង​ <guibutton> យល់ព្រម​</guibutton> ។"

#. Tag: menuchoice
#: menus.docbook:137
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​<keycap>L</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> "
"រក្សាទុក​ទាំងអស់ </guimenuitem>"

#. Tag: para
#: menus.docbook:146
#, no-c-format
msgid "This command <action>saves all modified open files</action>."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ  <action> រក្សាទុក​ឯកសារ​បើក​ដែល​បាន​កែប្រែ​ទាំងអស់ </action> ។"

#. Tag: menuchoice
#: menus.docbook:155
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </shortcut> "
"<guimenu> ឯកសារ​ </guimenu> <guimenuitem> ផ្ទុកឡើង​វិញ​ </guimenuitem>"

#. Tag: para
#: menus.docbook:164
#, no-c-format
msgid ""
"<action>Reloads the active file</action>. This command is useful if another "
"program or process has changed the file while you have it open in &kate;"
msgstr ""
"<action> ផ្ទុកឯកសារ​សកម្មឡើង​វិញ </action> ។ ពាក្យ​បញ្ជា​នេះត្រូវ​បាន​ប្រើ​ "
"បើ​កម្មវិធី "
"ឬ​ដំណើរការ​ដ៏ទៃទៀត​ត្រូវ​បានផ្លាស់ប្តូរ​ឯកសារ​ខណៈពេល​ដែល​អ្នកបានបើក​វា​ក្នុង​ "
"kate​។​"

#. Tag: menuchoice
#: menus.docbook:175
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​ <keycap>P</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បោះពុម្ព ...</guimenuitem>"

#. Tag: para
#: menus.docbook:184
#, no-c-format
msgid "<action>Print the active file</action>."
msgstr "<action> បោះពុម្ព​ឯកសារ​ដែលសកម្ម​ </action>​។​"

#. Tag: menuchoice
#: menus.docbook:192
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export as HTML...</guimenuitem>"
msgstr ""
"<guimenu> ឯកសារ </guimenu> <guimenuitem> នាំចេញ​ជា​ HTML...</guimenuitem>"

#. Tag: para
#: menus.docbook:198
#, no-c-format
msgid ""
"Export your file in HTML format so your document can be viewed as a web page."
msgstr ""
"នាំចេញ​ឯកសារ​របស់​អ្នក​ជា​ទ្រង់ទ្រាយ​ HTML "
"ដូច្នេះ​ឯកសារ​របស់​អ្នក​ត្រូវ​បាន​មើល​លើ​ទំព័រ​បណ្តាញ ។"

#. Tag: menuchoice
#: menus.docbook:207
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Mail...</guimenuitem>"
msgstr "<guimenu> ឯកសារ​ </guimenu> <guimenuitem> សំបុត្រ​...</guimenuitem>"

#. Tag: para
#: menus.docbook:213
#, no-c-format
msgid "Open your mail client and attach the file in the mail."
msgstr ""
"បើ​​សំបុត្រ​ម៉ាស៊ីន​ភ្ញៀវ​ និង​ឯកសារ​ភ្ជាប់​របស់​អ្នក​ក្នុង​សំបុត្រ​​។​"

#. Tag: menuchoice
#: menus.docbook:222
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​​<keycap>W</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បិទ​​ </guimenuitem>"

#. Tag: para
#: menus.docbook:231
#, no-c-format
msgid ""
"<action>Close the active file</action> with this command. If you have made "
"unsaved changes, you will be prompted to save the file before &kate; closes it."
msgstr ""
"<action> បិទ​ឯកសារ​សកម្ម </action> ជាមួយ​ពាក្យ​បញ្ជា​នេះ ។ "
"បើ​អ្នកបាន​បង្កើត​ការផ្លាស់ប្តូរ​ដែ​ល​មិនទាន់​រក្សាទុក​អ្នក​នឹងរក្សាទុកឯកសារ​ទាន"
"់ពេល​មុន​ពេល​ kate បិទវា​ ។"

#. Tag: menuchoice
#: menus.docbook:242
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr "<guimenu> ឯកសា </guimenu> <guimenuitem> បិទទាំងអស់​</guimenuitem>"

#. Tag: para
#: menus.docbook:248
#, no-c-format
msgid ""
"This command <action>closes all the files you have open</action> in &kate;."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ​ <action> បិទ​ឯកសារ​ទាំងអស់​ដែល​អ្នកបើក​ </action> "
"ក្នុង​ kate ។​"

#. Tag: menuchoice
#: menus.docbook:258
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​<keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu> ឯកសារ​ </guimenu> <guimenuitem> បោះបង់ </guimenuitem>"

#. Tag: para
#: menus.docbook:267
#, no-c-format
msgid ""
"This command <action>closes &kate;</action> and any files you were editing. If "
"you have made unsaved changes to any of the files you were editing, you will be "
"prompted to save them."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ​ប្រើស្រាប់​ <action> បិទ​ kate </action> "
"និង​ឯកសារ​មួយ​ចំនួន​ទៀត​ដែល​អ្នក​បាន​កំពុង​កែសម្រួល​ ។​បើ​អ្នកបានបង្កើត​ការផ្លាស"
"់ប្តូរ​ដែល​មិនទាន់​បាន​រក្សាទុក​​ទៅ​កាន់​ឯកសារ​មួយ​ចំនួន​ដែល​បាន​កំពុង​កែសម្រួល​"
" អ្នក​ នឹង​ទទួល​បាន​ប្រអប់​បញ្ចូល​មួយ​សម្រាប់​រក្សាទុក​ពួក​វា​​។​"

#. Tag: title
#: menus.docbook:278
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr "ម៉ឺនុយ​  <guimenu> កែសម្រួល </guimenu>"

#. Tag: para
#: menus.docbook:279
#, no-c-format
msgid ""
"The <guimenu>Edit</guimenu> menu contains a host of commands, all to work with "
"the currently active document."
msgstr ""
"ម៉ឺនុយ​ <guimenu> កែសម្រួល </guimenu> "
"មាន​ពាក្យ​បញ្ជា​ម៉ាស៊ីន​ទាំងអស់​ធ្វើ​ការជាមួយ​ឯកសារ​សកម្ម​បច្ចុប្បន្ន​ ។​"

#. Tag: menuchoice
#: menus.docbook:287
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"មិនធ្វើ​វិញ </guimenuitem>"

#. Tag: para
#: menus.docbook:294
#, no-c-format
msgid "Undo the last editing command (typing, copying, cutting etc.)"
msgstr ""
"មិនធ្វើ​វិញ​នូវ​ការកែសម្រួល​ពាក្យ​បញ្ជា​ចុង​ក្រោយ​ (វាយ​, ចម្លង​, កាត់​ ។ល។)"

#. Tag: para
#: menus.docbook:295
#, no-c-format
msgid ""
"If grouped undo is enabled, this may undo several editing commands of the same "
"type, like typing in characters."
msgstr ""
"បើ​មិនធ្វើ​វិញ​បានដាក់​ជាក្រុម​ត្រូវ​បាន​អនុញ្ញាត​ "
"នេះ​ប្រហែល​ជា​​ពាក្យ​បញ្ជា​ការកែសម្រួល​មិនធ្វើ​វិញ​មួយ​ចំនួន​មាន​ប្រភេទ​ដូចគ្នា​"
"​ដូចជា​ការវាយ​តួអក្សរ​ ។"

#. Tag: menuchoice
#: menus.docbook:302
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>Z</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"ធ្វើ​ឡើង​វិញ </guimenuitem>"

#. Tag: para
#: menus.docbook:309
#, no-c-format
msgid "Redo the last undo step."
msgstr "ធ្វើ​ឡើង​វិញ​នូវ​ជំហាន​មិនធ្វើ​វិញ​ចុង​ក្រោយ​ ។"

#. Tag: menuchoice
#: menus.docbook:316
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>X</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> កាត់​ </guimenuitem>"

#. Tag: para
#: menus.docbook:323
#, no-c-format
msgid ""
"Removes selected text if any, and places a copy of the removed text in the "
"clipboard."
msgstr ""
"យកអត្ថបទ​ដែល​បានជ្រើស​ចេញ​បើ​មាន​ច្រើន "
"ហើយ​ចម្លង​អត្ថបទ​ដែល​បាន​យកចេញ​ទៅ​ក្នុង​ក្តារតម្បៀតខ្ទាស់​ ។​"

#. Tag: menuchoice
#: menus.docbook:330
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>C</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល​ </guimenu> <guimenuitem> ចម្លង​ </guimenuitem>"

#. Tag: para
#: menus.docbook:337
#, no-c-format
msgid "Copies selected text, if any, to the clipboard."
msgstr ""
"ចម្លង​អត្ថបទ​ដែល​បានជ្រើស​ ទៅ​ក្នុង​ក្តារតម្បៀតខ្ទាស់ ​បើ​មាន​ច្រើន​ ។​"

#. Tag: menuchoice
#: menus.docbook:344
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Copy as HTML</guimenuitem>"
msgstr ""
"<guimenu> កែសម្រួល </guimenu> <guimenuitem> ចម្លង​ជា​ HTML</guimenuitem>"

#. Tag: para
#: menus.docbook:350
#, no-c-format
msgid "Copies selected text with the syntax highlight as HTML text."
msgstr ""
"ចម្លង​អត្ថបទ​ដែល​បានជ្រើស​​ជាមួយ​​ការបន្លិច​វាក្យស័ព្ទ​វា​អត្ថបទ  HTML ។"

#. Tag: menuchoice
#: menus.docbook:357
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>V</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"បិទភ្ជាប់​ </guimenuitem>"

#. Tag: para
#: menus.docbook:364
#, no-c-format
msgid ""
"Copies the first item in the clipboard into the editor at cursor position."
msgstr ""
"ចម្លង​ធាតុ​ដំបូង​​ទៅ​ក្នុង​ក្តារតម្បៀតខ្ទាស់​នៅ​ក្នុង​កម្មវិធី​និពន្ធ​​តាម​ទីតាំ"
"​ងទស្សន៍ទ្រនិច ។"

#. Tag: para
#: menus.docbook:365
#, no-c-format
msgid ""
"If Overwrite Selection is enabled, the pasted text will overwrite the "
"selection, if any."
msgstr ""
"បើ​ការជ្រើស​ជាន់ពីលើ​ត្រូវ​បាន​អនុញ្ញាត​ "
"អត្ថបទ​ដែល​បាន​បិទ​ភ្ជាប់នឹង​សរសេរជាន់ពីលើ​ការជ្រើស​ បើ​វា​មាន​ច្រើន ។"

#. Tag: menuchoice
#: menus.docbook:372
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>A</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"ជ្រើស​ទាំងអស់ </guimenuitem>"

#. Tag: para
#: menus.docbook:379
#, no-c-format
msgid "Selects all text in the editor."
msgstr "ជ្រើស​អត្ថបទ​ទាំងអស់​នៅ​ក្នុង​កម្មវិធិនិពន្ធ ។"

#. Tag: menuchoice
#: menus.docbook:386
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Deselect</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">​បញ្ជា ប្តូរ​<keycap>A</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem>​ ដកជ្រើស​ </guimenuitem>"

#. Tag: para
#: menus.docbook:393
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr "ដក​ជ្រើស​អត្ថបទ​ដែល​បានជ្រើស​ក្នុង​កម្មវិធី​និពន្ធ​ បើ​មាន​ច្រើន​ ។​"

#. Tag: menuchoice
#: menus.docbook:400
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Shift</keycap> <keycap>"
"B</keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>"
"Block Selection Mode</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap> ប្តូរ​</keycap> <keycap>"
"B</keycap></keycombo></shortcut> <guimenu> កែសម្រួល​ </guimenu> <guimenuitem>"
"ប្លុក​របៀប​ការជ្រើស​ </guimenuitem>"

#. Tag: para
#: menus.docbook:408
#, no-c-format
msgid ""
"Toggles Selection Mode. When the Selection Mode is <quote>BLOCK</quote>"
", you can make vertical selections, ie select column 5 to 10 in lines 9 to 15."
msgstr ""
"បិទបើក​របៀប​ការជ្រើស ។ នៅ​ពេល​ដែល​របៀប​ការជ្រើស​ត្រូវ ​បាន​ <quote> "
"ប្លុក </quote> អ្នកអាច​បង្កើត​ការជ្រើសបញ្ឈរ​ ឧទាហរណ៍ ជួរឈរ​ ៥ ទៅ​ ១០​បន្ទាត់ ៩ "
"ទៅ​ ១៥ ។​"

#. Tag: para
#: menus.docbook:410
#, no-c-format
msgid ""
"The status bar shows the current state of the Selection Mode, either <quote>"
"NORM</quote> or <quote>BLK</quote>."
msgstr ""
"របារស្ថានភាព​បង្ហាញ​របៀប​ការជ្រើស​ស្ថានភាព​បច្ចុប្បន្ន <quote>NORM</quote> "
"ឬ <quote>BLK</quote>."

#. Tag: menuchoice
#: menus.docbook:417
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>F</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> រក​...</guimenuitem>"

#. Tag: para
#: menus.docbook:424
#, no-c-format
msgid ""
"Launch the Find Dialog to allow you to search for text in the edited document."
msgstr ""
"បើដំណើរការ​ប្រអប់​រក​អនុញ្ញាត​ឲ្យ​អ្នក​ស្វែងរក​អត្ថបទ​ក្នុង​ឯកសារដែល​បាន​កែសម្រួ"
"ល ។ "

#. Tag: menuchoice
#: menus.docbook:431
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Find Next</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></shortcut> "
"<guimenu> កែសម្រួល </guimenu> <guimenuitem> រក​បន្ទាប់​</guimenuitem>"

#. Tag: para
#: menus.docbook:438
#, no-c-format
msgid ""
"Go to the nearest downwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""
"ត្រឡប់​ទៅ​ផ្គួផ្គង​អត្ថបទ​ ឬ​កន្សោម​ត្រឹមត្រូវ​ទៅ​ខាងក្រោមដែល​បានដាក់​ការវិភាគ​ "
"ការចាប់ផ្តើម​ពី​ទីតាំង​ទស្សន៍និច ។​"

#. Tag: menuchoice
#: menus.docbook:445
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> ប្តូរ <keycap>F3</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល </guimenu> <guimenuitem> "
"រក​ពី​មុន​ </guimenuitem>"

#. Tag: para
#: menus.docbook:452
#, no-c-format
msgid ""
"Go to the nearest upwards match of the last text or regular expression searched "
"for, starting from cursor position"
msgstr ""
"ត្រឡប់​ទៅ​ផ្គួផ្គង​អត្ថបទ​ ឬ​កន្សោម​ត្រឹមត្រូវ​ទៅ​ខាងក្រោមដែល​បានដាក់​ការវិភាគ​ "
"ការចាប់ផ្តើម​ពី​ទីតាំង​ទស្សន៍និច ។​"

#. Tag: menuchoice
#: menus.docbook:459
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>R</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល​ </guimenu> <guimenuitem> "
"ជំនួស​ ...</guimenuitem>"

#. Tag: para
#: menus.docbook:466
#, no-c-format
msgid ""
"Launch the Replace Dialog to replace one or more instances of a defined text "
"with something else."
msgstr ""
"បើក​ដំណើរការ​ប្រអប់​ជំនួស​ដើម្បី​ជំនួស​អត្ថបទ​ដែល​បាន​កំណត់​មួយ​ "
"ឬ​ច្រើន​ជា​មួយ​អ្វី​មួយ​ផ្សេងទៀត​ ។"

#. Tag: menuchoice
#: menus.docbook:473
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo>"
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to line...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>G</keycap></keycombo>"
"</shortcut> <guimenu> កែសម្រួល​ </guimenu> <guimenuitem> "
"ត្រឡប់​ទៅ​បន្ទាត់ ...</guimenuitem>"

#. Tag: para
#: menus.docbook:480
#, no-c-format
msgid ""
"Launches the Go To Line Dialog, allowing you to enter the number of a line to "
"find in the document"
msgstr ""
"បើក​ដំណើរការ​​ប្រអប់​ត្រឡប់ទៅ​បន្ទាត់​ កំពុង​អនុញ្ញាត​ឲ្យ​អ្នក "
"បញ្ចូលចំនួន​បន្ទាត់​ដើម្បិ​រក​ក្នុងឯកសារ​ "

#. Tag: title
#: menus.docbook:490
#, no-c-format
msgid "The <guimenu>Document</guimenu> Menu"
msgstr "ម៉ឺនុយ  <guimenu> ឯកសារ </guimenu> "

#. Tag: para
#: menus.docbook:491
#, no-c-format
msgid ""
"The Document menu provides a menu entry for each open document. Clicking one of "
"these will bring the requested document to focus. If you have multiple frames, "
"an editor for that document will be displayed in the currently active frame."
msgstr ""
"ម៉ឺនុយ​ឯកសារ​ដែល​ផ្តល់​ឲ្យ​ធាតុ​ម៉ឺនុយ​សម្រាប់​បើក​ឯកសារ​នីមួយៗ ។ "
"ចុច​លើ​ធាតុ​មួយ​នៃ​ធាតុ​ទាំងអស់​នោះ​ "
"នឹង​យក​ឯកសារ​ដែល​បាន​ស្នើដើម្បី​ប្រមូល​ផ្តុំ​។ បើ​អ្នក​មាន​ស៊ុមច្រើន​ "
"កម្មវិធី​និពន្ធ​សម្រាប់​ឯកសារ​ទាំងនោះ​ "
"នឹង​ត្រូវ​បានបង្ហាញ​​ក្នុង​ស៊ុម​សកម្ម​បច្ចុប្បន្ន​ ។"

#. Tag: para
#: menus.docbook:495
#, no-c-format
msgid "In addition, commands to browse your open documents are provided:"
msgstr ""
"លើសពីនេះទៀត "
"ពាក្យ​បញ្ជា​ដើម្បី​រក​មើល​ឯកសារ​បើក​របស់​អ្នក​ដែលត្រូវ​បាន​ផ្តល់​ឲ្យ​ ៖​"

#. Tag: title
#: menus.docbook:497
#, no-c-format
msgid "Menu items"
msgstr "ធាតុ​ម៉ឺនុយ​ "

#. Tag: menuchoice
#: menus.docbook:502
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>Left</keycap></keycombo>"
"</shortcut> <guimenu>Document</guimenu> <guimenuitem>Back</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> ឆ្លាស់​ <keycap> ឆ្វេង </keycap>"
"</keycombo></shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> "
"ត្រឡប់​ក្រោយ </guimenuitem>"

#. Tag: para
#: menus.docbook:509
#, no-c-format
msgid ""
"This will bring the previous document in the stack in focus. If you have "
"multiple frames, an editor for the document will be displayed in the currently "
"active frame."
msgstr ""
"ម៉ឺនុយ​នេះ​ នឹង​នាំមកនូវ​ឯកសារ​ពីមុន​នៅ​ក្នុង​ការប្រមូល​ផ្តុំ​ជង់​ ។ "
"បើ​អ្នក​មាន​ស៊ុម​ច្រើន​ "
"កម្មវិធី​និពន្ធ​ឯកសារ​នឹង​បង្ហាញ​ក្នុង​ស៊ុម​សកម្មបច្ចុប្បន្ន​ ។"

#. Tag: para
#: menus.docbook:511
#, no-c-format
msgid ""
"The order is the order in which documents were opened, rather than a logical "
"history. This behavior may change in future versions of &kate;."
msgstr ""
"បញ្ជា​នេះ​ត្រូវ​បានបញ្ជា​ក្នុង​ឯកសារ​ទាំងឡាយ​ណា​ដែល​បាន​បើក​  "
"ជាសជាង​ប្រវត្តិដែល​សម​ ។ ឥរិយាបទ​នេះ​ប្រហែល​ជា​ផ្លាស់ប្តូ​ក្នុង​កំណែ​របស់​ kate "
"នាពេលបច្ចុប្បន្ន​​ ។"

#. Tag: menuchoice
#: menus.docbook:520
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>Right</keycap></keycombo>"
"</shortcut> <guimenu>Document</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> ជំនួស​<keycap> ស្តាំ​</keycap></keycombo>"
"</shortcut> <guimenu> ឯកសារ </guimenu> <guimenuitem> បញ្ចូន​បន្ត </guimenuitem>"

#. Tag: para
#: menus.docbook:527
#, no-c-format
msgid ""
"This will bring the next document in the stack in focus. If you have multiple "
"frames, an editor for the document will be displayed in the currently active "
"frame."
msgstr ""
"ម៉ឺនុយ​នេះ​ នឹង​នាំមកនូវ​ឯកសារ​ពីមុន​នៅ​ក្នុង​ការប្រមូល​ផ្តុំ​ជង់​ ។ "
"បើ​អ្នក​មាន​ស៊ុម​ច្រើន​ "
"កម្មវិធី​និពន្ធ​ឯកសារ​នឹង​បង្ហាញ​ក្នុង​ស៊ុម​សកម្មបច្ចុប្បន្ន​ ។"

#. Tag: para
#: menus.docbook:530
#, no-c-format
msgid ""
"The order is the order in which the documents were opened, rather than a "
"logical history. This behavior may change in future versions of &kate;."
msgstr ""
"បញ្ជា​នេះ​ត្រូវ​បានបញ្ជា​ក្នុង​ឯកសារ​ទាំងឡាយ​ណា​ដែល​បាន​បើក​  "
"ជាសជាង​ប្រវត្តិដែល​សម​ ។ ឥរិយាបទ​នេះ​ប្រហែល​ជា​ផ្លាស់ប្តូ​ក្នុង​កំណែ​របស់​ kate "
"នាពេលបច្ចុប្បន្ន​​ ។"

#. Tag: title
#: menus.docbook:540
#, no-c-format
msgid "The <guimenu>View</guimenu> menu"
msgstr "ម៉ឺនុយ​ <guimenu> មើល </guimenu> "

#. Tag: para
#: menus.docbook:542
#, no-c-format
msgid ""
"The <guimenu>View</guimenu> menu allows you to manage settings specific to the "
"active editor, and to manage frames."
msgstr ""
"ម៉ឺនុយ <guimenu> មើល </guimenu> "
"អនុញ្ញាត​ឲ្យ​អ្នក​គ្រប់គ្រង​ការកំណត់​កម្មវិធី​និពន្ធ​សកម្ម​ជាក់លាក់​ "
"និង​គ្រប់គ្រង​ស៊ុម​​ ។​"

#. Tag: title
#: menus.docbook:546 menus.docbook:698
#, no-c-format
msgid "Menu Items"
msgstr "ធាតុ​ម៉ឺនុយ​"

#. Tag: menuchoice
#: menus.docbook:549
#, no-c-format
msgid ""
"<shortcut><keycap>F7</keycap></shortcut> <guimenu>View</guimenu><guimenuitem>"
"Switch to Command Line</guimenuitem>"
msgstr ""
"<shortcut><keycap>F7</keycap></shortcut> <guimenu> មើល </guimenu><guimenuitem>"
"ប្តូរ​បន្ទាត់​ពាក្យ​បញ្ជា </guimenuitem>"

#. Tag: para
#: menus.docbook:552
#, no-c-format
msgid ""
"This command will toggle the display of the <link "
"linkend=\"advanced-editing-tools-commandline\">built in command line</link>."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ​ នឹង​បិទបើក​បង្ហាញ​បន្ទាត់​ពាក្យ​បញ្ជា​ <link "
"linkend=\"advanced-editing-tools-commandline\"> នៅ​ខាងក្នុង​</link> ។​"

#. Tag: menuchoice
#: menus.docbook:558
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Schema</guisubmenu>"
msgstr "<guimenu> មើល​ </guimenu><guisubmenu> គ្រោងការណ៍​</guisubmenu>"

#. Tag: para
#: menus.docbook:560
#, no-c-format
msgid ""
"This menu lists the available schemas. You can change the schema for the "
"current view here, to change the default schema you need to use the <link "
"linkend=\"config-dialog-editor-colors\">config dialog</link>"
msgstr ""
"គ្រោងការណ៍​បញ្ជី​ម៉ឺនុយ​នេះ​អាច​រក​បាន​ ។ "
"អ្នកអាច​ផ្លាស់ប្តូរ​គ្រោងការណ៍​សម្រាប់​ទិដ្ឋភាព​បច្ចុប្បន្ន​នៅទី​នេះ "
"ដើម្បី​ផ្លាស់ប្តូរ​​គ្រោងការន៍​លំនាំដើម​ដែលអ្នកត្រូវ​ការ​ប្រើ​ <link "
"linkend=\"config-dialog-editor-colors\"> ប្រអប់​កំណត់​រចនាសម្ព័ន្ធ  </link>"

#. Tag: menuchoice
#: menus.docbook:567
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap> </keycombo></shortcut> "
"<guimenu>View</guimenu><guimenuitem>Dynamic Word Wrap</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap> </keycombo></shortcut> "
"<guimenu> មើល </guimenu><guimenuitem> ការរុំពាក្យ ឋានវន្ត​ </guimenuitem>"

#. Tag: para
#: menus.docbook:571
#, no-c-format
msgid ""
"Toggles dynamic word wrap in the current view. Dynamic word wrap makes all the "
"text in a view visible without the need for horizontal scrolling by rendering "
"one actual line on more visual lines as needed."
msgstr ""
"បិទបើក​ការរុំពាក្យ​ឋាមវន្ត​ក្នុង​ទិដ្ឋភាព​បច្ចុប្បន្ន​​។ "
"ការរុំពាក្យ​ឋានវន្ត​បង្កើត​អត្ថបទទាំងអស់​ក្នុង​ទិដ្ឋភាព​ដែល​អាច​មើលឃើញ​ "
"ដោយ​មិន​ត្រូវ​ការ​រមូរ​ផ្តេក​តាម​ការបង្ហាញ "
"​បន្ទាត់​មួយ​លើ​បន្ទាត់និមិត្ម​ដែលបាន​ត្រូវ​ការ ។​"

#. Tag: menuchoice
#: menus.docbook:578
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show/Hide Static Word Wrap "
"Marker</guimenuitem>"
msgstr ""
"<guimenu> មើល </guimenu><guimenuitem> បង្ហាញ "
"ឬ​លាក់​ការកម្មវិធី​សម្គាល់​ការរុំពាក្យឋិតិវន្ត</guimenuitem>"

#. Tag: para
#: menus.docbook:580
#, no-c-format
msgid ""
"Toggles the display of a vertical line indicating the position of the wrap "
"width as configured in the <link linkend=\"config-dialog-editor-wrap-words-at\">"
"config dialog</link>. This feature requires that you use a true fixed-width "
"font."
msgstr ""
"បិទបើក​ការបង្ហាញ​បន្ទាត់​បញ្ឈរ​ចង្អុល​ទីតាំង​របស់​ទទឹង​រមូរ​ត្រូវ​បានកំណត់រចនាសម"
"្ព័ន្ធ​ក្នុង​ <link linkend=\"config-dialog-editor-wrap-words-at\">"
"ប្រអប់​កំណត់​រចនាសម្ព័ន្ធ​ </link>​។ "
"លក្ខណៈពិសេស​នេះទានទា​​ឲ្យ​ង្នក​ប្រើ​ទទឹង​ពុម្ពអក្សរ​ដែល​បានជួសជុល​ ។"

#. Tag: menuchoice
#: menus.docbook:590
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Show/Hide Icon Border</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></shortcut> "
"<guimenu> មើល </guimenu> <guimenuitem> បង្ហាញ​ ឬ​លាក់​ស៊ុម​រូបតំណាង​ "
"</guimenuitem>"

#. Tag: para
#: menus.docbook:597
#, no-c-format
msgid ""
"This is a toggle item. Setting it on checked will make the Icon Border visible "
"in the left side of the active editor, and vice versa."
msgstr ""
"នេះ​ជា​ការបិទ​បើក​ធាតុ​​។ "
"ធីក​ការកំណត់​វា​នឹង​បង្កើត​ស៊ុម​រូបតំណាង​ដែល​អាច​មើល​ឃើញ​ក្នុង​ផ្នែក​ខាង​ឆ្វេង​ន"
"ៃ​កម្មវិធី​​និពន្ធ​សកម្ម​ ។"

#. Tag: menuchoice
#: menus.docbook:605
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Show/Hide Line Numbers</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></shortcut> "
"<guimenu> មើល </guimenu> <guimenuitem> បង្ហាញ ឬ​លាក់​ចំនួនបន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:612
#, no-c-format
msgid ""
"This is a toggle Item. Setting it on checked will make a pane displaying the "
"line numbers of the document visible in the left border of the active editor, "
"and vice versa."
msgstr ""
"នេះ​ជា​ការបិទ​បើក​ធាតុ​​។​ ធីក​ការកំណត់​វា​នឹង​បង្កើត​បន្ទះ​ការ "
"បង្ហាញ​ចំនួនបន្ទាត់​ឯកសារ​ដែលអាច​មើល​ឃើញ​ក្នុង​ស៊ុម​ខាង​ឆ្វេងស៊ុម​នៃ​កម្មវិធីនិព"
"ន្ធ​សកម្ម​​។​"

#. Tag: menuchoice
#: menus.docbook:619
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show/Hide Scrollbar Marks</guimenuitem>"
msgstr ""
"<guimenu> មើល </guimenu><guimenuitem> បង្ហាញ ឬ​លាក់​កម្មវិធី​សម្គាល់​របារមូរ​ "
"</guimenuitem>"

#. Tag: para
#: menus.docbook:621
#, no-c-format
msgid ""
"Toggles the visualization of bookmarks (and other marks) on the vertical "
"scrollbar. When enabled, marks are represented by a thin line in the mark color "
"at the scrollbar, middleclicking on the lines will scroll the view to a "
"position near the mark."
msgstr ""
"បិទបើកការមើល​ឃើញ​របស់​ចំណា​ (និង​សញ្ញា​សម្គាល់​ផ្សេងទៀត​) នៅ​លើ​របាររមូរ​បញ្ឈរ​ "
"។ នៅ​ពេល​អនុញ្ញាត​ សញ្ញា "
"​សម្គាល់​​ត្រូវ​បានជំនួស​ដោយ​បន្ទាត់ស្តើង​មួយ​ក្នុង​សញ្ញា​សម្គាល់ពណ៌នៅ​ក្នុង​​រប"
"ាររមូរ  ចុច​កណ្តាល​បន្ទាត់​វា​ នឹង​រមូរ​មើល​ទៅទីតាំង​ដែលជិត​សញ្ញា​សម្គាល់​​។​"

#. Tag: menuchoice
#: menus.docbook:628
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap> </keycombo></shortcut> "
"<guimenu>View</guimenu><guimenuitem>Show/Hide Folding Markers</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap> </keycombo></shortcut> "
"<guimenu> មើល </guimenu><guimenuitem> បង្ហាញ​ ឬ​លាក់​កម្មវិធី​សម្គាល់​ថត​ "
"</guimenuitem>"

#. Tag: para
#: menus.docbook:632
#, no-c-format
msgid ""
"Toggles the display of the folding marker pane in the left side of the view. "
"See <link linkend=\"advanced-editing-tools-code-folding\">"
"Using Code Folding</link>."
msgstr ""
"បិទបើកការបង្ហាញ​របស់​ការបញ្ចូល​គ្នា​នៃ​បន្ទះកម្មវិធី​សម្គាល់​​ក្នុង​ផ្នែក​ខាង​ឆ្"
"វេង​នៃ​ទិដ្ឋភាពទូទៅ​ ។ មើល​​ <link "
"linkend=\"advanced-editing-tools-code-folding\">ការប្រើ​ការលាយ​បញ្ចូល​កូដ​ចូល​គ្"
"នា </link> ។​"

#. Tag: guimenuitem
#: menus.docbook:641
#, no-c-format
msgid "Code Folding"
msgstr "ការលាយ​បញ្ចូលកូដ​ចូលគ្នា"

#. Tag: menuchoice
#: menus.docbook:648
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>Shift</keycap><keycap>"
"-</keycap></keycombo></shortcut> <guimenuitem>Collapse Toplevel</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​  <keycap> ប្តូរ </keycap><keycap>"
"-</keycap></keycombo></shortcut> <guimenuitem> វេញ​កម្រិត​កំពូល​ </guimenuitem>"

#. Tag: para
#: menus.docbook:652
#, no-c-format
msgid "Collapse all toplevel regions in the document."
msgstr "វេញតំបន់​កម្រិត​កំពូល​ទាំងអស់​ក្នុង​ឯកសារ​ ។"

#. Tag: menuchoice
#: menus.docbook:655
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>Shift</keycap><keycap>"
"+</keycap></keycombo></shortcut> <guimenuitem>Expand Toplevel</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap> ប្តូរ​ </keycap><keycap>"
"+</keycap></keycombo></shortcut> <guimenuitem> ពង្រីក​កម្រិតកំពូល​ "
"</guimenuitem>"

#. Tag: para
#: menus.docbook:659
#, no-c-format
msgid "Expand all toplevel regions in the document."
msgstr "ពង្រីក​តំបន់​កម្រិត​កំពូលទាំងអស់នៅក្នុង​ឯកសារ ។"

#. Tag: menuchoice
#: menus.docbook:662
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>-</keycap></keycombo>"
"</shortcut> <guimenuitem>Collapse One Local Level</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>-</keycap></keycombo>"
"</shortcut> <guimenuitem> វេញ​កម្រិត​មូលដ្ឋាន​  </guimenuitem>"

#. Tag: para
#: menus.docbook:666
#, no-c-format
msgid "Collapse the region closest to the cursor."
msgstr "វេញ​តំបន់​ដែលនៅ​ជិត​ទស្សន៍ទ្រនិច​ជាង​គេ​ ។​"

#. Tag: menuchoice
#: menus.docbook:669
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>+</keycap></keycombo>"
"</shortcut> <guimenuitem>Expand One Local Level</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​ <keycap>+</keycap></keycombo>"
"</shortcut> <guimenuitem> ពង្រីក​កម្រិត​មូលដ្ឋាន​  </guimenuitem>"

#. Tag: para
#: menus.docbook:673
#, no-c-format
msgid "Expand the region closest to the cursor."
msgstr "ពង្រីក​តំបន់​ដែល​នៅ​ជិត​ទស្សន៍និច​ជាង​គេ​បំផុត​ ។"

#. Tag: title
#: menus.docbook:685
#, no-c-format
msgid "The <guimenu>Bookmarks</guimenu> Menu"
msgstr "ម៉ឺនុយ​ <guimenu> ចំណាំ​ </guimenu> "

#. Tag: para
#: menus.docbook:687
#, no-c-format
msgid ""
"The <guimenu>Bookmarks</guimenu> menu allows you to work with the bookmarks in "
"the currently active document."
msgstr ""
"ម៉ឺនុយ​ <guimenu> ចំណាំ </guimenu> "
"អនុញ្ញាត​ឲ្យ​អ្នក​ធ្វើ​ការជាមួយ​​ចំណាំ​ក្នុង​ឯកសារ​សកម្ម​បច្ចុប្បន្ន . "

#. Tag: para
#: menus.docbook:690
#, no-c-format
msgid ""
"Below the entries described here, one entry for each bookmark in the active "
"document will be available. The text will be the first few words of the marked "
"line. Choose an item to move the cursor to the start of that line. The editor "
"will scroll as necessary to make that line visible."
msgstr ""
"ធាតុ​ខាងក្រោម​​នេះ​បាន​ពិពណ៌នា​នៅ​ទី​នេះសម្រាប់ចំណាំ​និមួយៗ​ក្នុង​ឯកសារ​សកម្ម​​ "
"នឹង​អាច​រក​បាន​។ អត្ថបទ​ នឹង​បាន ដាក់​បន្ទាត់​សញ្ញា​សម្គាល់​ពាក្យ​ដំបូង​ ។ "
"ជ្រើស​ធាតុ​ដើម្បី​ផ្លាស់ទី​​ទស្សន៍និច​ដើម្បីចាប់​ផ្តើម​បន្ទាត់ ។ "
"កម្មវិធី​និពន្ធ​ "
"នឹង​អនុញ្ញាត​ឲ្យ​រមូរ​ជាចាំបាច់​ដើម្បី​បង្កើត​​បន្ទាត់​ដែលអាច​មើល​ឃើញ ។"

#. Tag: menuchoice
#: menus.docbook:703
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo>"
"</shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>"
"Set/Clear Bookmark</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> បញ្ជា​<keycap>B</keycap></keycombo>"
"</shortcut> <guimenu> ចំណាំ </guimenu> <guimenuitem>"
"កំណត់ ឬ​ជម្រះ​ចំណាំ </guimenuitem>"

#. Tag: para
#: menus.docbook:710
#, no-c-format
msgid ""
"Sets or removes a bookmark in the current line of the active document. (If it's "
"there, it is removed, otherwise one is set.)"
msgstr ""
"កំណត់​ ឬ​យកចេញ​ចំណាំ​ក្នុង​បន្ទាត់​បច្ចុប្បន្ន​នៃ​ឯកសារ​សកម្ម​ ។​ "
"(បើវា​នៅទី​នេះ  វា​ត្រូវ​បានយក​ចេញ​ If it's there, it is removed, "
"ហើយ​ផ្សេងទៀត​ត្រូវ​បាន​កំណត់ ។)"

#. Tag: menuchoice
#: menus.docbook:718
#, no-c-format
msgid ""
"<guimenu>Bookmarks</guimenu> <guimenuitem>Clear All Bookmarks</guimenuitem>"
msgstr ""
"<guimenu> ចំណាំ​ </guimenu> <guimenuitem> ជម្រះ​ចំណាំ ទាំងអស់ </guimenuitem>"

#. Tag: para
#: menus.docbook:724
#, no-c-format
msgid "Clears (removes) all bookmarks in the active document."
msgstr "ជម្រះ​ (យកចេញ) ចំណាំទាំងអស់​ក្នុង​ឯកសារ​សកម្ម​ ។​"

#. Tag: menuchoice
#: menus.docbook:729
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>Page Up</keycap></keycombo>"
"</shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Previous</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> ជំនួស​  <keycap> ទំព័រ​លើ </keycap>"
"</keycombo></shortcut><guimenu> ចំណាំ </guimenu><guimenuitem> "
"ពី​មុន </guimenuitem>"

#. Tag: para
#: menus.docbook:733
#, no-c-format
msgid ""
"This will move the cursor to beginning of the first above line with a bookmark. "
"The menuitem text will include the line number and the first piece of text on "
"the line. This item is only available when there is a bookmark in a line above "
"the cursor."
msgstr ""
"វា​នឹង​ផ្លាស់ទី​ទស្សន៍ទ្រនិច​ដើម្បី​ចាប់​ផ្តើម​បន្ទាត់​ខាងលើ​ដំបូង​​ជាមួយ​ចំណាំ​"
"នេះ ។ អត្ថបទ​ធាតុ​ម៉ឺនុយ​​រួមទាំង​ចំនួន​បន្ទាត់​ "
"និង​ផ្នែក​មួយ​នៃ​អត្ថបទ​ដំបូង​គេ​លើ​បន្ទាត់​។ "
"ធាតុនេះ​បាន​តែ​អាច​រក​បាននៅ​​ពេល​មាន​ចំណាំ​ដែល​មាន​ទស្សន៍ទ្រនិច​នៅពី​លើ​ ។​"

#. Tag: menuchoice
#: menus.docbook:740
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>Page Down</keycap></keycombo>"
"</shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Next</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> ជំនួស <keycap> ទំព័រ​ចុំក្រោម​ </keycap>"
"</keycombo></shortcut> <guimenu> ចំណាំ​ </guimenu><guimenuitem> "
"បន្ទាប់ </guimenuitem>"

#. Tag: para
#: menus.docbook:743
#, no-c-format
msgid ""
"This will move the cursor to beginning of the next line with a bookmark. The "
"menuitem text will include the line number and the first piece of text on the "
"line. This item is only available when there is a bookmark in a line below the "
"cursor."
msgstr ""
"វា​នឹង​ផ្លាស់ទី​ទស្សន៍ទ្រនិច​ដើម្បី​ចាប់​ផ្តើម​បន្ទាត់​ខាងលើ​ដំបូង​​ជាមួយ​ចំណាំ​"
"នេះ ។ អត្ថបទ​ធាតុ​ម៉ឺនុយ​​រួមទាំង​ចំនួន​បន្ទាត់​ "
"និង​ផ្នែក​មួយ​នៃ​អត្ថបទ​ដំបូង​គេ​លើ​បន្ទាត់​។ "
"ធាតុនេះ​បាន​តែ​អាច​រក​បាននៅ​​ពេល​មាន​ចំណាំ​ដែល​មាន​ទស្សន៍ទ្រនិច​នៅខាង ក្រោម​  ។"

#. Tag: title
#: menus.docbook:755
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "ម៉ឺនុយ  <guimenu> ឧបករណ៍ </guimenu>"

#. Tag: menuchoice
#: menus.docbook:760
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Pipe to Console</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍​</guimenu><guimenuitem> បង្ហូរ​ទៅ​កុងសូល​</guimenuitem>"

#. Tag: para
#: menus.docbook:762
#, no-c-format
msgid ""
"Feed the currently selected text ito the built in terminal emulator. No newline "
"is added after the text."
msgstr ""
"អត្ថបទ​ដែលបានជ្រើស​មតិព័ត៌មានបច្ចុប្បន្ន​ ito សាងសង់ក្នុង "
"ស្ថានីយ​វត្ថុ​ត្រាប់តាម​ ។"

#. Tag: menuchoice
#: menus.docbook:767
#, no-c-format
msgid "<guimenu>Tools</guimenu><guisubmenu>External Tools</guisubmenu>"
msgstr "<guimenu> ឧបករណ៍ </guimenu><guisubmenu> ឧបករណ៍​ខាងក្រៅ​ </guisubmenu>"

#. Tag: para
#: menus.docbook:769
#, no-c-format
msgid ""
"This submenu contains all the <link linkend=\"kate-mdi-tools-externaltools\">"
"external tools</link>you have configured."
msgstr ""
"ម៉ឺនុយ​រង​នេះ​មាន​ឧបករណ៍​ខាងក្រៅ​ទាំងអស់​ <link "
"linkend=\"kate-mdi-tools-externaltools\"></link> ដែល​អ្នកបាន​កំណត់​រចនាសម្ព័ន្ធ "
"។"

#. Tag: menuchoice
#: menus.docbook:775
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Read Only Mode</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍​ </guimenu> <guimenuitem> របៀប​បានតែ​អាន​ </guimenuitem>"

#. Tag: para
#: menus.docbook:779
#, no-c-format
msgid ""
"Set the current document to Read Only mode. This prevents any text addition and "
"any changes in the document formatting."
msgstr ""
"កំណត់​ឯកសារ​បច្ចុប្បន្ន​​ទៅ​ជា​រៀប​បានតែ​អាន​ ។ ការការពារ​​បន្ថែមអត្ថបទ​នេះ "
"និង​ការផ្លាស់ប្តូរ​ឯកសារ​កំពុង​ធ្វើ ទ្រង់ទ្រាយ​ ។​"

#. Tag: menuchoice
#: menus.docbook:785
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Filletype</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ប្រភេទ​ឯកសារ </guimenuitem>"

#. Tag: para
#: menus.docbook:789
#, no-c-format
msgid ""
"Choose the filetype scheme you prefer for the active document. This overwrites "
"the global <link linkend=\"config-dialog-editor-filetypes\">filetype</link> "
"mode set in <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>"
"Configure Editor...</guimenuitem></menuchoice> in the Filetypes tab for your "
"current document only."
msgstr ""
"ជ្រើស​គ្រោងការណ៍​ប្រភេទ​ឯកសារ​​អ្នកចូល​ចិត្ត​ជាង​សម្រាប់​ធ្វើ​ឲ្យ​ឯកសារ​សកម្ម​ ។"
" សរសេរជាន់ពីលើ​របៀប​ <link linkend=\"config-dialog-editor-filetypes\"> "
"ប្រភេទ​ឯកសារ​</link> កំណត់​ក្នុង  <menuchoice> <guimenu> ការកំណត់​ </guimenu> "
"<guimenuitem> កំណត់រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ​...</guimenuitem></menuchoice> "
"ក្នុង​ថេប​ប្រភេទ​ឯកសារ​បានតែ​ឯកសារ​បច្ចុប្បន្ន​ ។"

#. Tag: menuchoice
#: menus.docbook:798
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Highlighting</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ការបន្លិច​ </guimenuitem>"

#. Tag: para
#: menus.docbook:802
#, no-c-format
msgid ""
"Choose the Highlighting scheme you prefer for the active document. This "
"overwrites the global highlighting mode set in <menuchoice> <guimenu>"
"Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </menuchoice> "
"for your current document only."
msgstr ""
"ជ្រើស​គ្រោងការណ៍​ការបន្លិច​ ដែលអ្នកចូលចិត្ត​ធ្វើ​ឲ្យ​ឯកសារ​សកម្ម​ ។ "
"សរសេរ​ជាន់​ពីលើ​របៀប​ការបន្លិច​សកល​កំណត់​ក្នុង​ <menuchoice> <guimenu> "
"ការកំណត់ </guimenu> <guimenuitem> កំណត់រចនាសម្ព័ន្ធ​កម្មវិធី ​និពន្ធ​ "
"...</guimenuitem> </menuchoice> បានតែ​ឯកសារ​របស់​អ្នក ។"

#. Tag: menuchoice
#: menus.docbook:810
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Indentation</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem>  ការចូល​បន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:814
#, no-c-format
msgid ""
"Choose the <link linkend=\"kate-part-autoindent\">style of indentation</link> "
"you want for your active document. This overwrites the global indentation mode "
"set in <menuchoice> <guimenu>Settings</guimenu> <guimenuitem>"
"Configure Editor...</guimenuitem> </menuchoice> for your current document only."
msgstr ""
"ជ្រើស​រចនាប័ទ្ម​ <link linkend=\"kate-part-autoindent\"> "
"នៃ​ការចូល​បន្ទាត់ </link> អ្នកចង់​ឲ្យ​ឯកសាររបស់​អ្នកសកម្ម​​។ "
"សរសេរជាន់ពី​លើ​នេះ​របៀប​ការចូល​បន្ទាត់​សកល​ កំណត់​ក្នុង​ <menuchoice> <guimenu> "
"ការកំណត់ </guimenu> "
"<guimenuitem>កំណត់​រចនាសម្ព័ន្ធ​កម្មិវធី​និពន្ធ​...</guimenuitem> </menuchoice> "
"បាន​តែ​សម្រាប់​ឯកសារ​របស់​អ្នកបច្ចុប្បន្ន​ ​។"

#. Tag: menuchoice
#: menus.docbook:823
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Encoding</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ការអ៊ិនកូដ​</guimenuitem>"

#. Tag: para
#: menus.docbook:827
#, no-c-format
msgid ""
"You can overwrite the default encoding set in <menuchoice> <guimenu>"
"Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> "
"in the <guilabel>Open/Save</guilabel> tab to set a different encoding for your "
"current document. The encoding you set here will be only valid for your current "
"document."
msgstr ""
"អ្នកអាច​សរសេរជាន់​ពីលើ​ការអ៊ិនកូដ​លំនាំដើម​កំណត់​ក្នុង​ <menuchoice> <guimenu>"
"ការកំណត់ </guimenu> <guimenuitem> កំណត់រចនា សម្ព័ន្ធ​កម្មវិធី​និពន្ធ "
"...</guimenuitem></menuchoice> ក្នុង​ថេប​  <guilabel> "
"បើក​ ឬ​រក្សាទុក​ </guilabel> "
"ដើម្បីកំណត់​ការអ៊ិនកូដ​ខុសៗគ្នាសម្រាប់​ឯកសារ​បច្ចុប្បន្នរបស់​អ្នក​។ "
"ការអ៊ិនកូដ​អ្នក​អាច​កំណត់​នៅទីនេះ​ "
"បាន​តែឯកសារ​របស់​អ្នក​ដែល​ត្រឹមត្រូវ​ប៉ុណ្ណោះ ។ent."

#. Tag: menuchoice
#: menus.docbook:837
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>End of Line</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ចុង​បន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:841
#, no-c-format
msgid ""
"Choose your prefered end of line mode for your active document. This overwrites "
"the global end of line mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem> </menuchoice> "
"for your current document only."
msgstr ""
"ជ្រើស​របៀប​ចុង​បន្ទាត់​ដែល​អ្នកចូល​ចិត្ត​សម្រាប់​ឯកសារ​សកម្ម​របស់​អ្នក ។ "
"សរសេរជាន់​ពីលើ​របៀប​​ចុង​បន្ទាត់​សកល​នេះ​ កំណត់​ក្នុង​ <menuchoice> <guimenu> "
"ការកំណត់​​</guimenu> <guimenuitem> កំណត់រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ​  "
"...</guimenuitem> </menuchoice> បាន​តែ ឯកសារ​បច្ចុប្បន្ន​របស់​អ្នក​ ។"

#. Tag: menuchoice
#: menus.docbook:849
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍ </guimenu><guimenuitem> អក្ខរាវិរុទ្ធ...</guimenuitem>"

#. Tag: para
#: menus.docbook:853
#, no-c-format
msgid ""
"<action>This initiates the spellchecking program - a program designed to help "
"the user catch and correct any spelling errors.</action> "
"Clicking on this entry will start the checker and bring up the speller dialog "
"box through which the user can control the process. There are four settings "
"lined up vertically in the center of the dialog with their corresponding labels "
"just to the left. Starting at the top they are:"
msgstr ""
"<action> នេះជា​កម្មវិធី​ពិនិត្យ​អក្ខរាវិរុទ្ធ​ចាប់ផ្តើមថ្មីមួយ "
"-កម្មវិធី​នេះ​ត្រូវ​បាន​រចនាឡើង​ដើម្បី​ជួយ​អ្នក​ប្រើ​ចាប់​យក​កំហុស​អក្ខរាវិរុទ្ធ"
"​  ។ </action> ចុច​លើធាតុ​នេះ​វា​ នឹង​ចាប់ផ្តើម​ពិនិត្យ​ "
"ហើយ​បើក​ប្រអប់​កម្មវិធី​អក្ខរាវិរុទ្ធដែល​អ្នកប្រើអាច​គ្រប់គ្រង​ដំណើរការ​វា​បាន​ "
" ។ "
"មាន​ការកំណត់​ចំនួន​បួន​តម្រៀបបញ្ឈរ​ក្នុង​ប្រអប់​កណ្តាល​ដែល​មានការឆ្លើយឆ្លង​ស្លាក"
"​របស់​ពួក​វា​ទៅ​ខាងឆ្វេង ។ កំពុង​ចាប់ផ្តើម​កំពូល​ពួក​វា​គឺ ៖"

#. Tag: guilabel
#: menus.docbook:862
#, no-c-format
msgid "Unknown word:"
msgstr "ពាក្យ​មិនស្គាល់ ៖"

#. Tag: para
#: menus.docbook:863
#, no-c-format
msgid ""
"Here, the spellchecker indicates the word currently under consideration. This "
"happens when the checker encounters a word not in its dictionary - a file "
"containing a list of correctly spelled words against which it compares each "
"word in the editor."
msgstr ""
"ទីនេះជា​​កម្មវិធី​រ​ពិនិត្យ​អក្ខរាវិរុទ្ធ បង្ហាញ​ប្រាប់​ពាក្យ "
"ក្រោម​ការពិចារណា​បច្ចុប្បន្ន​ ។ "
"វា​កើត​ឡើង​នៅ​ពេល​ដែលជួប​ប្រទះកម្មវិធី​ត្រួតពិនិត្យ​ពាក្យ​ដែលគ្មាន​នៅ​ក្នុង​វចនា"
"នុក្រម​របស់​វា​- "
"មាន​បញ្ជី​ឯកសារ​ត្រឹមត្រូវ​នៃ​ពាក្យ​ដែល​បានប្រកប​ត្រឹមត្រូវ​ដែល​វា​ប្រៀបធៀប​ពាក្"
"យនីមួយៗ​ក្នុ​ង​កម្មវិធី​និពន្ធ​ ។"

#. Tag: guilabel
#: menus.docbook:869
#, no-c-format
msgid "Replace with:"
msgstr "ជំនួស​ជា​មួយ​ ៖"

#. Tag: para
#: menus.docbook:870
#, no-c-format
msgid ""
"If the checker has any similar words in its dictionary the first one will be "
"listed here. The user can accept the suggestion, type in his or her own "
"correction, or choose a different suggestion from the next box."
msgstr ""
"បើ​កម្មវិធី​ពិនិត្យ​មាន​ពាក្យ​ដែលស្រដៀង​គ្នា​ក្នុង​វចនានុក្រម​របស់​វាមុនគេ​នៅ​ក្"
"នុង​បញ្ជី​នេះ។ អ្នកប្រើអាច​យល់​ព្រម​យោបល​នេះ​ វាយ​ពាក្យ​របស់​គាត់ "
"ឬ​នាង​ឲ្យ​ត្រឹមត្រូវ​ ឬ​ជ្រើស​ការផ្តល់ យោបលខុសៗគ្នា​ពី​ប្រអប់​បន្ទាត់​ ។"

#. Tag: guilabel
#: menus.docbook:876
#, no-c-format
msgid "Suggested Words:"
msgstr "ពាក្យ​ដែលបានផ្តល់​យោបល ៖​"

#. Tag: para
#: menus.docbook:877
#, no-c-format
msgid ""
"The checker may list here a number of possible replacements for the word under "
"consideration. Clicking on any one of the suggestions will cause that word to "
"be entered in the <guilabel>Replacement:</guilabel> box, above."
msgstr ""
"កម្មវិធី​ពិនិត្យ​ប្រហែលជា​រាយ​បញ្ជីចំនួន​ដែលអាច​ជំនួស​ដោយ​ពាក្យ​នៅ​ទី​នេះ ។  "
"ចុច​យក​មួយ​នៃ​ការផ្តល់យោបល​ដោយ​សារតែ​វា​បាន​បញ្ចូល​ក្នុងប្រអប់​​ <guilabel> "
"ជំនួស​ ៖</guilabel> ខាងលើ​​។"

#. Tag: guilabel
#: menus.docbook:883
#, no-c-format
msgid "Language:"
msgstr "ភាសា ៖​"

#. Tag: para
#: menus.docbook:884
#, no-c-format
msgid ""
"If you have installed multiple dictionaries, here you can select which "
"dictionary/language should be used."
msgstr ""
"បើ​អ្នក​បានដំឡើង​វចនានុក្រម​ច្រើន​ "
"អ្នក​អាចជ្រើស​​នៅទី​នេះ​នូវ​ភាសា​វចនានុក្រម​ណាមួយ​ត្រូវ​បានប្រើ ។"

#. Tag: para
#: menus.docbook:889
#, no-c-format
msgid ""
"On the right side of the dialog box are 5 buttons that allow the user to "
"control the spellcheck process. They are:"
msgstr ""
"នៅ​ផ្នែក​ខាងស្តាំ​នៃប្រអប់​មាន​ប៊ូតុង​ "
"៥​ដែល​អនុញ្ញាត​ឲ្យ​អ្នកប្រើ​ដើម្បី​ដំណើរកម្មវិធី រ​ពិនិត្យ​អក្ខរាវិរុទ្ធ​  ។ "
"ពួកវា​ទាំង​នោះគឺ ៖"

#. Tag: guibutton
#: menus.docbook:894
#, no-c-format
msgid "Add to Dictionary"
msgstr "បន្ថែម​អក្ខរាវិរុទ្ធ​"

#. Tag: para
#: menus.docbook:895
#, no-c-format
msgid ""
"Pressing this button adds the word in the <guilabel>Misspelled Word:</guilabel> "
"box to the checker's dictionary. This means that in the future the checker will "
"always consider this word to be correctly spelled."
msgstr ""
"ចុច​ប៊ូតុង​នេះ​បន្ថែមពាក្យ​នៅ​ក្នុង​ប្រអប់​ <guilabel> "
"ពាក្យ​ដែល​ប្រកប​ខុស  ៖​ </guilabel> ទៅ​ក្នុង​វចនានុក្រម​របស់​កម្មវិធី​ពិនិត្យ ។ "
"នេះ​មា​ន​ន័យ​ថា​កម្មវិធី​ពិនិត្យ​នាពេល​អនាគត់​តែងតែស្វែងរក​មើក​ពាក្យ​នេះ​ដើម្បី​"
"ប្រកប​ឲ្យ​បាន​ត្រឹមត្រូវ​ ។​"

#. Tag: guibutton
#: menus.docbook:901
#, no-c-format
msgid "Replace"
msgstr "ជំនួស​"

#. Tag: para
#: menus.docbook:902
#, no-c-format
msgid ""
"This button has the checker replace the word under consideration in the "
"document with the word in the <guilabel>Replacement:</guilabel> box."
msgstr ""
"ប៊ូតុង​នេះ​កម្មវិធី​ពិនិត្យ​ជំនួស​ពាក្យ​ក្រោម​ការពិចារណា​ក្នុង​ ឯកសារជាមួយ​ពាក្យ"
"​ក្នុង​ប្រអប់  <guilabel> ជំនួស ៖</guilabel> ។"

#. Tag: guibutton
#: menus.docbook:907
#, no-c-format
msgid "Replace All"
msgstr "ជំនួស​ទាំងអស់"

#. Tag: para
#: menus.docbook:908
#, no-c-format
msgid ""
"This button causes the checker to replace not only the current <guilabel>"
"Unknown word:</guilabel> but to automatically make the same substitution for "
"any other occurrences of this <guilabel>Misspelled Word:</guilabel> "
"in the document."
msgstr ""
"ប៊ូតុង​កម្មវិធី​ពិនិត្យ​នេះ​ដើម្បី​ជំនួសមិន​ត្រឹមតែ​ <guilabel> "
"ពាក្យ​ដែលមិនស្គាល់ ៖ </guilabel> ថែមទាំង​បង្កើតការជំនួស​ដែល "
"ដូច​គ្នាពេល​ជួបប្រទះ​​ <guilabel> ពាក្យ​ដែល​ប្រកប​ខុស​ ៖ </guilabel> "
"ក្នុង​ឯកសារ ។"

#. Tag: guibutton
#: menus.docbook:914
#, no-c-format
msgid "Ignore"
msgstr "មិនអើពើ​"

#. Tag: para
#: menus.docbook:915
#, no-c-format
msgid ""
"Activating this button will have the checker move on without making any "
"changes."
msgstr ""
"ប៊ូតុង​នេះធ្វើ​ឲ្យ​សកម្ម​ "
"នឹង​មាន​កម្មវិធី​ពិនិត្យ​ផ្លាស់ទី​ដោយ​គ្មានការផ្លាស់ប្តូរ​ ។"

#. Tag: guibutton
#: menus.docbook:919
#, no-c-format
msgid "Ignore All"
msgstr "មិនអើពើ​ទាំងអស់ "

#. Tag: para
#: menus.docbook:920
#, no-c-format
msgid ""
"This button tells the checker to do nothing with the current <guilabel>"
"Unknown word:</guilabel> and to pass over any other instances of the same word."
msgstr ""
"ប៊ូតុង​នេះ​ប្រាប់កម្មវិធី​ពិនិត្យ​មិនធ្វើ​អ្វីទាំងអស់​ជាមួយ​ <guilabel> "
"ពាក្យ​ដែលមិនស្គាល់ ៖ </guilabel> ហើយ​រំលង​ដើម្បីជំនួស​ពាក្យ​ដែល​ដូចគ្នា​ ។"

#. Tag: para
#: menus.docbook:922
#, no-c-format
msgid ""
"This only applies to the current spellcheck run. If the checker is run again "
"later it will stop on this same word."
msgstr ""
"ការនេះ​បានតែ​អនុវត្ត​រត់ពិនិត្យ​​អក្ខរាវិរុទ្ធ ។បើ​កម្មវិធី​ពិនិត្យ​បាន​រត់​ពេលក"
"្រោយ​ម្តងទៀត​ វា​នឹង​បញ្ឈប់​ពាក្យ​ដែល​ដូចគ្នា ។"

#. Tag: para
#: menus.docbook:928
#, no-c-format
msgid ""
"Three more buttons are located horizontally along the bottom of the spellcheck "
"dialog. They are:"
msgstr ""
"មាន​ប៊ូតុង​បី​ទៀត​ត្រូវ​បានរកឃើញ​នៅ​បាត​ផ្កេក​នៃ​ប្រអប់​ពិនិត្យ ​អក្ខរាវិរុទ្ធ "
" ។ ពួកវាទាំងអស់នោះ​គឺ ៖​"

#. Tag: guibutton
#: menus.docbook:933
#, no-c-format
msgid "Help"
msgstr "ជំនួយ​"

#. Tag: para
#: menus.docbook:934
#, no-c-format
msgid ""
"This invokes the &kde; help system starting at the &kate; help pages (this "
"document)."
msgstr ""
"ការហៅ Kde នេះ​ជួយ​ឲ្យ​ការចាប់ផ្តើម​ប្រព័ន្ធ​ជួយ​ទំព័រ​ kate   (ឯកសារ​នេះ) ។​"

#. Tag: guibutton
#: menus.docbook:939
#, no-c-format
msgid "Finished"
msgstr "បាន​បញ្ចប់​"

#. Tag: para
#: menus.docbook:940
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""
"ប៊ូតុង​នេះ​បញ្ចប់​ដំណើរការ​ការពិនិត្យ​អក្ខរាវិរុទ្ធ "
"ហើយ​ត្រឡប់​ទៅ​កាន់​ឯកសារ​ ។​"

#. Tag: guibutton
#: menus.docbook:945
#, no-c-format
msgid "Cancel"
msgstr "បោះបង់​ចោល​"

#. Tag: para
#: menus.docbook:946
#, no-c-format
msgid ""
"This button cancels the spellcheck process, all modifications are reverted, and "
"you will return to your document."
msgstr ""
"ប៊ូតុង​នេះ​បោះបង់ចោល​ដំណើរ​​ការពិនិត្យអក្ខរាវិរុទ្ធ​ "
"ការកែប្រែទាំងអស់​ត្រូវ​បានបញ្ច្រាស់​ ហើយ​អ្នកនឹង​ត្រឡប់​ទី​កាន់​ឯកសារ​របស់​អ្នក "
"។"

#. Tag: menuchoice
#: menus.docbook:956
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> អក្ខរាវិរុទ្ធ (ពីទស្សទ្រនិច្ច "
")...</guimenuitem>"

#. Tag: para
#: menus.docbook:960
#, no-c-format
msgid ""
"This initiates the spellchecking program but it starts where your cursor is "
"instead of at the beginning of the document."
msgstr ""
"នេះជា​កម្មវិធី​ការចាប់ផ្តើម​ការពិនិត្យ​អក្ខរាវិរុទ្ធ​ថ្មី​ "
"ប៉ុន្តែ​វា​ចាប់ផ្តើម​នៅទីតាំង​ដែល​ទស្សន៍និច​របស់អ្នក​ជំនួស​ការចាប់ផ្តើម​នៃ​ឯកសារ"
"​ ។ "

#. Tag: menuchoice
#: menus.docbook:966
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""
"<guimenu>ឧបករណ៍​</guimenu> <guimenuitem> "
"ការជ្រើស​ពិនិត្យ​អក្ខរាវិរិទ្ធ​...</guimenuitem>"

#. Tag: para
#: menus.docbook:970
#, no-c-format
msgid "Spellchecks the current selection."
msgstr "ការជ្រើស​ពិនិត្យ​អក្ខរាវិរុទ្ធ​បច្ចុប្បន្ន​​។​"

#. Tag: menuchoice
#: menus.docbook:975
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu><guimenuitem>Indent</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​<keycap>I</keycap></keycombo> "
"</shortcut> <guimenu>ឧបករណ៍ </guimenu><guimenuitem> ចូល​បន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:981
#, no-c-format
msgid ""
"This increases the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"config-dialog-editor-indent\">"
"indentation settings</link>."
msgstr ""
"ការបង្កើន​​ការចូល​បន្ទាត់របស់​​កថាខណ្ឌម្តងមួយៗ​នេះ ។ ទំហំ​របស់ជំហាន​ពឹងផ្នែកលើ​ "
" <link linkend=\"config-dialog-editor-indent\">ការកំណត់​ការចូល​បន្ទាត់ </link>"
" ។​"

#. Tag: menuchoice
#: menus.docbook:988
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>I</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu><guimenuitem>Unindent</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា​ ប្តូរ <keycap>I</keycap>"
"</keycombo> </shortcut> <guimenu> ឧបករណ៍​</guimenu><guimenuitem> "
"មិនចូលបន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:995
#, no-c-format
msgid ""
"This reduces the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"config-dialog-editor-indent\">"
"indentation settings</link>."
msgstr ""
"កាត់​បន្ថយ​ការចូល​បន្ទាត់​របស់កថាខណ្ឌ​តាម​មួយ​ជំហាន​ ។​ទំហំ​ជំហានពឹងផ្នែកលើ​  "
"<link linkend=\"config-dialog-editor-indent\">ការកំណត់​ការចូល​បន្ទាត់ </link>"
" ។​"

#. Tag: menuchoice
#: menus.docbook:1003
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu><guimenuitem> ជម្រះ​ការចូល​បន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:1006
#, no-c-format
msgid ""
"This cleans the indentation for the current selection or for the line the "
"cursor is currently in. Cleaning the indentation ensures that all your selected "
"text follows the indentation mode you choose."
msgstr ""
"ការជម្រះ​ការចូល​បន្ទាត់​នេះ​សម្រាប់​ជ្រើស​បច្ចុប្បន្ន​ "
"ឬ​សម្រាប់​ទស្សន៍ទ្រនិច​បន្ទាត់​បច្ចុប្បន្ន​ផង​ដែរ ។ "
"កំពុង​ជម្រះ​ការចូល​បន្ទាត់ឲ្យ​ច្បាស់​ថា​អត្ថបទ​របស់​អ្នក​ដែល ​បានជ្រើស​ "
"របៀប​ការចូល​បន្ទាត់​ដែលបានជ្រើស​ដូចតទៅ​នេះ ។"

#. Tag: menuchoice
#: menus.docbook:1013
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr "<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> តម្រឹម​</guimenuitem>"

#. Tag: para
#: menus.docbook:1018
#, no-c-format
msgid ""
"Causes a realign of the current line or selected lines using the indentation "
"mode and indentation settings in the doucment."
msgstr ""
"ដោយសារតែ​បន្ទាត់​បច្ចុប្បន្ន​រៀប​ជា​ជួរ​ ឬ​បាន​ជ្រើស​ប្រើ​របៀប​ការចូល​បន្ទាត់​ "
"និង​ការកំណត់​ការចូល​បន្ទាត់​​ក្នុងឯកសារ  ។​"

#. Tag: menuchoice
#: menus.docbook:1024
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា<keycap>D</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"សេចក្តីអធិប្បាយ​ </guimenuitem>"

#. Tag: para
#: menus.docbook:1031
#, no-c-format
msgid ""
"This adds one space to the beginning of the line where the text cursor is "
"located or to the beginning of any selected lines."
msgstr ""
"បន្ថែម​ចន្លោះ​មួយ​ដើម្បី​ចាប់ផ្តើម​បន្ទាត់​​ដែល​ទស្សទ្រនិច​អត្ថបទ​​បាន​រក​ឃើញ​​ "
"ឬ​ដើម្បី​ចាប់ផ្តើម​បន្ទាត់​ដែល​បានជ្រើស​មួយ​ចំនួ​ន ទៀត​ ។"

#. Tag: menuchoice
#: menus.docbook:1038
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា  ប្តូរ <keycap>D</keycap>"
"</keycombo> </shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"មិនមែនជា​សេចក្តីអធិប្បាយ​ </guimenuitem>"

#. Tag: para
#: menus.docbook:1045
#, no-c-format
msgid ""
"This removes one space (if any exist) from the beginning of the line where the "
"text cursor is located or from the beginning of any selected lines."
msgstr ""
"យក​​ចន្លោះ​ចេញ​ (if any exist) ពី​ការចាប់ផ្តើម​បន្ទាត់ "
"​ទស្សន៍ទ្រនិចត្រូវ​បាន​រក​ឃើញ ឬ​ពី​ការចាប់ផ្តើម​បន្ទាត់​ដែលបានជ្រើស​ ។​"

#. Tag: menuchoice
#: menus.docbook:1051
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>U</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> អក្សរធំ </guimenuitem>"

#. Tag: para
#: menus.docbook:1058
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""
"បញ្ចូល​អត្ថបទ​ដែល​បានជ្រើស​ ឬ​តួអក្សរ​បន្ទាត់​ដាក់ ទស្សន៍ទ្រនិច​លើ​​អក្សរធំ​ ។"

#. Tag: menuchoice
#: menus.docbook:1063
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា ប្តូរ <keycap>U</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> អក្សរតួច </guimenuitem>"

#. Tag: para
#: menus.docbook:1070
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""
"បញ្ចូល​អត្ថបទ​ដែល​បានជ្រើស​ ឬ​តួអក្សរ​បន្ទាត់​ដាក់ ទស្សន៍ទ្រនិច​លើ​​អក្សរតូច​ ។"

#. Tag: menuchoice
#: menus.docbook:1075
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> ជំនួស​ ប្តូរ <keycap>U</keycap>"
"</keycombo> </shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> "
"សរសេរ​ជា​អក្សរពុម្ព </guimenuitem>"

#. Tag: para
#: menus.docbook:1082
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr "សរសេរ​ជា​អក្សរពុម្ពត្រូវ​បានជ្រើស​អត្ថបទ​ ឬ​ពាក្យ​បច្ចុប្បន្ន​ ។​"

#. Tag: menuchoice
#: menus.docbook:1087
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\"> បញ្ជា <keycap>J</keycap></keycombo> "
"</shortcut> <guimenu> ឧបករណ៍ </guimenu> <guimenuitem> តបន្ទាត់ </guimenuitem>"

#. Tag: para
#: menus.docbook:1094
#, no-c-format
msgid ""
"Joins the selected lines, or the current line and the line below with one white "
"space character as a separator. Leading/trailing white space on joined lines is "
"removed in the affected ends."
msgstr ""
"តបន្ទាត់​ដែល​បានជ្រើស​ ឬ​បន្ទាត់​បច្ចុប្បន្ន​ "
"និង​បន្ទាត់​ខាងក្រោម​ជាមួយ​តួអក្សរ​ចន្លោះ​មើល​មិនឃើញ ជា​សញ្ញាបំបែក​ ។  នាំមុខ​ "
"ឬស្នាម​​ចន្លោះ​មើល​មិនឃើញ​ត្រូវ​បាន​តភ្ជាប់​បន្ទាត់​ត្រូវ​បាន​យក​ចេញ ។​"

#. Tag: menuchoice
#: menus.docbook:1100
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Wrap Document</guimenuitem>"
msgstr ""
"<guimenu> ឧបករណ៍ </guimenu> <guimenuitem> ឯកសារ ការរុំពាក្យ​ </guimenuitem>"

#. Tag: para
#: menus.docbook:1104
#, no-c-format
msgid ""
"Apply static word wrapping on all the document. That means that a new line of "
"text will automatically start when the current line exceeds the length "
"specified by the Wrap words at: option in the Editing tab in <menuchoice> "
"<guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem>"
"</menuchoice>"
msgstr ""
"អនុវត្ត​ការរុំពាក្យឋិតិវន្តលើ​ឯកសារ​ទាំងអស់ ។ មានន័យថា​បន្ទាត់​អត្ថបទ​ថ្មី "
"នឹង​ចាប់​ផ្តើម​ដោយ​ស្វ័យប្រវត្តិ​ពេលដែល​ប្រវែង​បន្ទាត់​ដែល​បាន​កំណត់ច្រើនលើសហួស​"
"តាម​ការរុំពាក្យ ៖ ជ្រើស​ក្នុង​ថេប​ការកែសម្រួល​ក្នុង​ <menuchoice> <guimenu> "
"ការកំណត់​ </guimenu><guimenuitem> "
"កំណត់រចនាសម្ព័ន្ធ​កម្មវិធី​និពន្ធ...</guimenuitem></menuchoice>"

#. Tag: title
#: menus.docbook:1118
#, no-c-format
msgid "The <guimenu>Sessions</guimenu> Menu"
msgstr "ម៉ឺនុយ​ <guimenu> សម័យ​ </guimenu> "

#. Tag: para
#: menus.docbook:1120
#, no-c-format
msgid ""
"This menu contains entries for using and managing &kate; sessions. For more "
"information, read <link linkend=\"fundamentals-using-sessions\">"
"Using Sessions</link>."
msgstr ""
"ម៉ឺនុយ​នេះ​មាន​ធាតុ​សម្រាប់​ការប្រើ​ និង​ការ​គ្រប់គញរងសម័យ​​ kate ។ "
"ព័ត៌មានបន្ថែម​ សូមអាន​ <link linkend=\"fundamentals-using-sessions\">"
"ការប្រើ​សម័យ​ </link> ។​"

#. Tag: menuchoice
#: menus.docbook:1127
#, no-c-format
msgid "<guimenu>Sessions</guimenu> <guimenuitem>New</guimenuitem>"
msgstr "<guimenu> សម័យ </guimenu> <guimenuitem> ថ្មី  </guimenuitem>"

#. Tag: para
#: menus.docbook:1129
#, no-c-format
msgid "Creates a new empty session. All currently open files will be closed."
msgstr "បង្កើត​សម័យទទេថ្មី​មួយ ។ ឯកសារ​បើកបច្ចុប្បន្នទាំងអស់​ត្រូវ​បាន​បិទ ។"

#. Tag: menuchoice
#: menus.docbook:1135
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Open...</guimenuitem>"
msgstr "<guimenu> សម័យ​ </guimenu><guimenuitem>  បើក ...</guimenuitem>"

#. Tag: para
#: menus.docbook:1137
#, no-c-format
msgid ""
"Open an existing session. The Session Chooser dialog is displayed to let you "
"choose one."
msgstr ""
"បើ​សម័យ​ដែលមានរួច​ហើយ  ។ "
"ប្រអប់​កម្មវិធី​ជ្រើស​សម័យ​​ត្រូវ​បា​ន​បង្ហាញ​ដើម្បីអនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​​យក​"
"មួយ ​។​"

#. Tag: menuchoice
#: menus.docbook:1142
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guisubmenu>Quick Open</guisubmenu>"
msgstr "<guimenu> សម័យ </guimenu><guisubmenu> បើករហ័ស​ </guisubmenu>"

#. Tag: para
#: menus.docbook:1144
#, no-c-format
msgid "This submenu lets you open an existing session."
msgstr "ម៉ឺនុយ​រង​នេះអនុញ្ញាត​ឲ្យ​អ្នក​បើក​សម័យ​ដែល​មាន​រួច​ហើយ ។"

#. Tag: menuchoice
#: menus.docbook:1149
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Save</guimenuitem>"
msgstr "<guimenu> សម័យ </guimenu><guimenuitem> រក្សាទុក </guimenuitem>"

#. Tag: para
#: menus.docbook:1151
#, no-c-format
msgid ""
"Save the current session. If the session is anonymous, you will be prompted for "
"a session name."
msgstr ""
"រក្សាទុក​សម័យ​បច្ចុប្បន្ន​ ។ បើសម័យ​​ជា​សម័យ​អនាមិក​ អ្នក​នឹ​ង​ "
"ត្រូវ​បាន​កំណត់​ឈ្មោះ​សម័យ​ ។"

#. Tag: menuchoice
#: menus.docbook:1156
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu> សម័យ </guimenu><guimenuitem> រក្សា​ទុក  ...</guimenuitem>"

#. Tag: para
#: menus.docbook:1158
#, no-c-format
msgid ""
"Save the current session under a new name. You are prompted for a name to use."
msgstr ""
"រក្សាទុក​សម័យ​បច្ចុប្បន្ន​ក្រោយម​ឈ្មោះ​ថ្មី​មួយ​ ។ "
"អ្នត្រូវ​បាន​កំណត់​ឈ្មោះ​សម្រាប់​ប្រើ​​។​"

#. Tag: menuchoice
#: menus.docbook:1163
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Manage...</guimenuitem>"
msgstr "<guimenu> សម័យ​</guimenu><guimenuitem>  គ្រប់គ្រង ...</guimenuitem>"

#. Tag: para
#: menus.docbook:1165
#, no-c-format
msgid ""
"Displays the Session Manager dialog which allows you to rename and delete "
"sessions."
msgstr ""
"បង្ហាញ​ប្រអប់​កម្មវិធី​គ្រប់គ្រង​សម័យ​ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​ប្តូរ​ឈ្មោះ​ "
"និង​លុប​សម័យ​ ។​"

#. Tag: title
#: menus.docbook:1176
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "ម៉ឺនុយ​ <guimenu> ការកំណត់ </guimenu>"

#. Tag: para
#: menus.docbook:1178
#, no-c-format
msgid ""
"The <guimenu>Settings</guimenu> menu allows you to change the properties of the "
"main window, such as showing/hiding toolbars, and provides access to the "
"configuration dialogs."
msgstr ""
"ម៉ឺនុយ​ <guimenu> ការកំណត់​</guimenu> "
"អនុញ្ញាត​ឲ្យ​អ្នក​ផ្លាស់ប្តូរលក្ខណៈសម្បត្តិ​របស់បង្អួច​មេ​ ដូចជា​​ការបង្ហាញ "
"ឬលាក់​របារឧបករណ៍ និង​ផ្តល់នូវ​ការចូល "
"ដំណើរការទៅ​កាន់​ប្រអប់​ការកំណត់រចនាសម្ព័ន្ធ​ ។​​"

#. Tag: menuchoice
#: menus.docbook:1187
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Toolbars</guisubmenu>"
msgstr "<guimenu> ការកំណត់ </guimenu> <guisubmenu> របារឧបរកណ៍ </guisubmenu>"

#. Tag: para
#: menus.docbook:1193
#, no-c-format
msgid ""
"This submenu lists the available toolbars, each item toggles the display of the "
"associated toolbar."
msgstr ""
"បញ្ជី​ម៉ឺនុយ​រង​នេះ​អាច​រក​របារឧបករណ៍បាន​ "
"បិទបើក​ធាតុ​នីមួយៗ​បង្ហាញ​របារឧបរកណ៍​ដែលបានតភ្ជាប់ ។"

#. Tag: menuchoice
#: menus.docbook:1199
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់​ </guimenu><guimenuitem> របៀប​ពេញ​អេក្រង់  </guimenuitem>"

#. Tag: para
#: menus.docbook:1201
#, no-c-format
msgid "Toggles full screen display."
msgstr "បិទបើក​បង្ហាញ​ពេញ​អេក្រង់ ។"

#. Tag: para
#: menus.docbook:1202
#, no-c-format
msgid ""
"This commmand will be moved to the Window menu in a future version of &kate;"
msgstr ""
