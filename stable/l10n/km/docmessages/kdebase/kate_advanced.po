", <parameter><replaceable>column</replaceable></parameter> ); [function]"

#. Tag: title
#: advanced.docbook:717 advanced.docbook:736 advanced.docbook:752
#: advanced.docbook:778 advanced.docbook:793 advanced.docbook:808
#: advanced.docbook:866 advanced.docbook:882 advanced.docbook:920
#: advanced.docbook:933 advanced.docbook:955 advanced.docbook:983
