#: advanced.docbook:1145
#, fuzzy, no-c-format
msgid "Parameters"
msgstr "ប៉ារ៉ាម៉ែត្រ"

#. Tag: para
#: advanced.docbook:718
#, no-c-format
msgid ""
"<parameter>uint line</parameter> The line of the position for which to find the "
"attribute."
msgstr ""
"<parameter>uint line</parameter> ទីតាំង​បន្ទាត់​សម្រាប់​ស្វែងរក​គុណលក្ខណៈ។"

#. Tag: para
#: advanced.docbook:720
#, no-c-format
msgid ""
"<parameter>uint column</parameter> The column of the position for which to find "
"the attribute."
msgstr ""
"<parameter>uint column</parameter> ទីតាំងជួរឈរសម្រាប់​ស្វែងរក​គុណលក្ខណៈ។"

#. Tag: para
#: advanced.docbook:723
#, no-c-format
msgid ""
"Returns the numeric ID of the attribute for the document position [<parameter>"
"line</parameter>,<parameter>column</parameter>]. The attribute represents the "
"visual appearance or style of the text, and is also used to calculate the "
"syntax highlight for a specific part of the text in mixed formats like HTML or "
"PHP."
msgstr ""
"ត្រឡប់ទៅកាន់​លេខសម្គាល់​គុណលក្ខណៈ​សម្រាប់​ទីតាំង​ឯកសារ​វិញ  [<parameter>"
"បន្ទាត់ </parameter>,<parameter> ជួរឈរ </parameter>]​។ "
"គុណលក្ខណៈតំណាង​ឲ្យ​រូបរាង​អាច​មើល​ឃើញ ​ឬ​រចនាប័ទ្ម​អត្ថបទ "
"ហើយ​ត្រូវ​បានប្រើសម្រាប់គណនា​ការបន្លិច​វាក្យសម្ព័ន្ធ​សម្រាប់​បញ្ជាក់​ផ្នែក​មួយនៃ"
"​អត្ថបទ​ដែល​បានលាយបញ្ចូលទ្រង់ទ្រាយ​ដូចជា​ HTML ឬPHP​។ "

#. Tag: function
#: advanced.docbook:732
#, no-c-format
msgid ""
"document.canBreakAt( <parameter>Char c</parameter>, <parameter>"
"uint attribute</parameter> ); [function]"
msgstr ""
"document.canBreakAt( <parameter>Char c</parameter>, <parameter>"
"uint attribute</parameter> ); [function]"

#. Tag: para
#: advanced.docbook:737
#, no-c-format
msgid "<parameter>c</parameter> The character to test"
msgstr "<parameter>c</parameter> តួអក្សរ​សម្រាប់សាកល្បង "

#. Tag: para
#: advanced.docbook:738
#, no-c-format
msgid ""
"<parameter>attribute</parameter> The attribute at the position of <parameter>"
"c</parameter>."
msgstr ""
"<parameter> គុណលក្ខណៈ </parameter> ទីតាំង​គុណលក្ខណៈ​ <parameter>c</parameter>"
"​​។​"

#. Tag: para
#: advanced.docbook:741
#, no-c-format
msgid ""
"Returns whether it is allowed to break the line at a character c with attribute "
"attribute. The result is decided by querying the highlight owning attribute for "
"which characters allow breaking the line."
msgstr ""
"ត្រឡប់ ទោះជា​វា​បានអនុញ្ញាត​បំបែក​បន្ទាត់តួអក្សរ c ជាមួយ​គុណលក្ខណៈក៏ដោយ​ ។ "
"លទ្ធផល​ត្រូវ​បានសម្រេច​ដោយ​ការសួរ​ការបន្លិច​គុណលក្ខណៈ​ផ្ទាល់​សម្រាប់តួអក្សរ​ដេលអ"
"នុញ្ញាត​ឲ្យ​បំបែក ​បន្ទាត់ ។"

#. Tag: function
#: advanced.docbook:748
#, no-c-format
msgid ""
"document.canComment( <parameter>uint start_attribute</parameter>, <parameter>"
"uint end_attribute</parameter> ); [function]"
msgstr ""
"document.canComment( <parameter>uint start_attribute</parameter>, <parameter>"
"uint end_attribute</parameter> ); [function]"

#. Tag: para
#: advanced.docbook:753
#, no-c-format
msgid ""
"<parameter>start_attribute</parameter> The attribute at the start of the range "
"to turn into a comment."
msgstr ""
"<parameter>start_attribute</parameter> "
"គុណលក្ខណៈ​ចាប់ផ្តើម​តម្រៀប​ដើម្បី​ដាក់​ក្នុង ​សេចក្តីអធិប្បាយ ។​"

#. Tag: para
#: advanced.docbook:755
#, no-c-format
msgid ""
"<parameter>end_attribute</parameter> The attribute at end of the range to turn "
"into a comment."
msgstr ""
"<parameter>end_attribute</parameter> "
"គុណលក្ខណៈ​ស្ថិត​នៅ​ជួរក្រោយ​គេ​បានដាក់​ចូល​ក្នុង​សេចក្តីអធិប្បាយ ។ "

#. Tag: para
#: advanced.docbook:758
#, no-c-format
msgid ""
"Returns whether start_attribute and end_attribute belongs to the same syntax "
"highlight system. If they do, it is sane."
msgstr ""
"Returns whether start_attribute and end_attribute belongs to the same syntax "
"highlight system. If they do, it is sane."

#. Tag: title
#: advanced.docbook:762
#, no-c-format
msgid "using canComment"
msgstr ""

#. Tag: programlisting
#: advanced.docbook:763
#, no-c-format
msgid ""
"if ( document.canComment( document.attribute(1,0), document.attribute(5,0) ) ) "
"{\n"
"    // 1,0 and 5,0 belongs to the same syntax highlighting system\n"
"}"
msgstr ""

