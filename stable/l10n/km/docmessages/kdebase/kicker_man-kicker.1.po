#. Tag: title
#: man-kicker.1.docbook:9
#, no-c-format
msgid "KDE User's Manual"
msgstr "សៀវភៅដៃ​របស់អ្នកប្រើ KDE"

#. Tag: author
#: man-kicker.1.docbook:10
#, no-c-format
msgid "&Lauri.Watts;&Lauri.Watts.mail;"
msgstr "&Lauri.Watts;&Lauri.Watts.mail;"

#. Tag: refentryinfo
#: man-kicker.1.docbook:10
#, no-c-format
msgid "<date>February 27, 2005</date> <productname>K Desktop Environment</productname>"
msgstr ""
"<date>២៧ កុម្ភៈ, ២០០៥</date> <productname> បរិស្ថាន​ផ្ទៃតុ​"
"របស់ K </productname>"

#. Tag: command
#: man-kicker.1.docbook:16 man-kicker.1.docbook:21
#, no-c-format
msgid "kicker"
msgstr "kicker"

#. Tag: manvolnum
#: man-kicker.1.docbook:17
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>១</manvolnum>"

#. Tag: refpurpose
#: man-kicker.1.docbook:22
#, no-c-format
msgid "&kicker; is the &kde; panel"
msgstr "&kicker; ជា​បន្ទះ​នៃ​ &kde; "

#. Tag: cmdsynopsis
#: man-kicker.1.docbook:26
#, no-c-format
msgid ""
"<command>kicker</command> <arg choice=\"opt\">KDE Generic Options</arg> "
"<arg choice=\"opt\">Qt Generic Options</arg>"
msgstr ""
"<command>kicker</command> <arg choice=\"opt\"> ជ្រើស​ប្រភេទ KDE </arg> "
"<arg choice=\"opt\"> ជ្រើស​ប្រភេទ Qt </arg>"

#. Tag: title
#: man-kicker.1.docbook:34
#, no-c-format
msgid "Description"
msgstr "ការពិពណ៌នា"

#. Tag: para
#: man-kicker.1.docbook:35
#, no-c-format
msgid ""
"&kicker; is the &kde; panel. It normally contains application starters, "
"applets, and a clock."
msgstr "&kicker; ជា​បន្ទះ​ &kde; ​។ វា​ធម្មតា​មាន​កម្មវិធី​ចាប់ផ្តើម​កម្មវិធី​អាប់ភ្លេត​ និង​នាឡិកា​ ។​"

#. Tag: title
#: man-kicker.1.docbook:41
#, no-c-format
msgid "Files"
msgstr "ឯកសារ"

#. Tag: filename
#: man-kicker.1.docbook:45
#, no-c-format
msgid "$<envar>KDEHOME</envar>/share/apps/kickerrc"
msgstr "$<envar>KDEHOME</envar>/share/apps/kickerrc"

#. Tag: para
#: man-kicker.1.docbook:47
#, no-c-format
msgid ""
"User specific configuration file. This file is not normally intended to be "
"edited directly; Most configuration items can be controlled from &kcontrol;."
msgstr ""
"អ្នក​ប្រើ​បញ្ជាក់​ការកំណត់​រចនាសម្ព័ន្ធ​ឯកសារ​​។ ឯកសារ​នេះពុំ​បានបម្រុង​​ទុក​ដើម្បី​កែសម្រួល​​ដោយ​ផ្ទាល់​ឡើយ​"
"ការកំណត់រចនាសម្ព័ន្ធ​ធាតុ​ជា​ច្រើន​​អាចត្រូវ​បាន​ត្រួតពិនិត្យ​ពី &kcontrol; ។​"

#. Tag: filename
#: man-kicker.1.docbook:54
#, no-c-format
msgid "$<envar>PREFIX</envar>/share/apps/kickerrc"
msgstr "$<envar>PREFIX</envar>/share/apps/kickerrc"

#. Tag: para
#: man-kicker.1.docbook:56
#, no-c-format
msgid ""
"Global configuration file. This file is not normally intended to be edited "
"directly; Most configuration items can be controlled from &kcontrol;. Global "
"settings may be configured by the system administrator to either set defaults, "
"or lock down options that may not be altered by the users of the system."
msgstr ""
"ការកំណត់រចនាសម្ព័ន្ធ​ឯកសារ​សកល​​។ ឯកសារ​នេះ​ពុំ​ទាន់បានបម្រុង​ទុក​ដើម្បី​កែសម្រួល​ដោយ​ផ្ទាល់"
"ការកំណត់​រចនាសម្ព័ន្ធ​ធាតុ​ជា​ច្រើន​​អាច​ត្រូវ​បាន​ត្រួតពិនិត្យ​ពី​ &kcontrol;​។ ការកំណត់​សកល​ត្រូវ​បានកំណត់​រចនាសម្ព័ន្ធ​​ដោយ​អ្នកគ្រប់គ្រង​ជាន់​ខ្ពស់​​ដើម្បី​កំណត់​លំនាំដើម ឬ​ចាក់សោ​ជម្រើស​​"
"ដែល​មិន​ត្រូវ​បានប្តូរ​ដោយ​អ្នក​ប្រើ​របស់​ប្រព័ន្ធ​​។​"

#. Tag: title
#: man-kicker.1.docbook:68
#, no-c-format
msgid "See Also"
msgstr "ឃើញ​ផងដែរ"

#. Tag: para
#: man-kicker.1.docbook:70
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/kicker\">"
"help:/kicker</ulink> (either enter this <acronym>URL</acronym> "
"into &konqueror;, or run <userinput><command>khelpcenter</command> <parameter>"
"help:/kicker</parameter></userinput>)."
msgstr ""
"ឯកសារ​អ្នកប្រើ​បានលម្អិត​បន្ថែម​ ​អាច​រក​បាន​ពី <ulink url=\"help:/kicker\">"
"help:/kicker</ulink> (បញ្ចូល​វា​ <acronym>URL</acronym> ​នេះ​ទៅ​ក្នុង​ &konqueror;, ឬ​រត់​ <userinput><command>khelpcenter</command> <parameter>"
"help:/kicker</parameter></userinput>) ។​"

#. Tag: title
#: man-kicker.1.docbook:79
