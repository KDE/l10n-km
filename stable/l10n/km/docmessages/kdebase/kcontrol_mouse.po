#. Tag: guilabel
#: index.docbook:282
#, no-c-format
msgid "Acceleration time"
msgstr "ពេល​វេលា​បង្កើន​ល្បឿន"

#. Tag: para
#: index.docbook:284
#, no-c-format
msgid ""
"This is the number of key events before the pointer reaches a maximum speed for "
"mouse key acceleration."
msgstr ""
"នេះ​គឺ​ជា​ព្រឹត្តិការណ៍​គ្រាប់​ចុច​មួយ​ចំនួន "
"មុន​ពេល​ព្រួញ​ដល់​ល្បឿន​អតិបរមា​សម្រាប់​ការ​បង្កើន​ល្បឿន​គ្រាប់​ចុច​កណ្ដុរ ។"

#. Tag: guilabel
#: index.docbook:291
#, no-c-format
msgid "Maximum speed"
msgstr "ល្បឿន​អតិបរមា"

#. Tag: para
#: index.docbook:293
#, no-c-format
msgid ""
"This is the maximum speed in pixels per key event the pointer can reach for "
