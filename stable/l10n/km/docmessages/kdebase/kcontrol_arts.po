#. Tag: keyword
#: index.docbook:24
#, no-c-format
msgid "KControl"
msgstr "KControl"

#. Tag: keyword
#: index.docbook:25
#, no-c-format
msgid "sound server"
msgstr "ម៉ាស៊ីន​បម្រើ​សំឡេង"

#. Tag: keyword
#: index.docbook:26
#, no-c-format
msgid "sound"
msgstr "សំឡេង"

#. Tag: keyword
#: index.docbook:27
#, no-c-format
