msgstr ""
"<action> កំណត់កណ្តឹង </action>: <guimenuitem> ប្រព័ន្ធ​កណ្តឹង </guimenuitem> "
"<guimenuitem>​ ការជូន​ដំណឹង​ប្រព័ន្ធ </guimenuitem>, <guimenuitem>"
"កណ្តឹងមើល​ឃើញ </guimenuitem> ឬ <guimenuitem> គ្មាន </guimenuitem> ។​"

#. Tag: menuchoice
#: index.docbook:922
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Font</guisubmenu>"
msgstr "<guimenu> ការកំណត់ </guimenu> <guisubmenu> ពុម្ពអក្សរ </guisubmenu>"

#. Tag: para
#: index.docbook:924
#, no-c-format
msgid ""
"<action>Set font size</action>: <guimenuitem>Enlarge Font</guimenuitem> "
"or <guimenuitem>Shrink Font</guimenuitem>."
msgstr ""
"<action> កំណត់​ទំហំ​ពុម្ពអក្សរ </action> ៖ <guimenuitem> "
"ពង្រីក​ពុម្ពអក្សរ </guimenuitem> ឬ <guimenuitem> បង្រួញ​ួញ​ពុម្ពអក្សរ "
"</guimenuitem> ។​"

#. Tag: para
#: index.docbook:928
#, no-c-format
msgid ""
"Use the <guimenuitem>Select...</guimenuitem> option to pick any combination of "
"font, size and style."
msgstr ""
"ប្រើ​ជម្រើស <guimenuitem>ជ្រើស​...</guimenuitem> "
"​ដើម្បី​រើស​ការបន្សំ​ពុម្ពអក្សរ ទំហំ និង​រចនាប័ទ្ម ។​"

#. Tag: menuchoice
#: index.docbook:934
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Encoding</guimenuitem>"
msgstr "<guimenu> ការកំណត់ </guimenu> <guimenuitem> ការអ៊ិនកូដ </guimenuitem>"

#. Tag: para
#: index.docbook:936
#, no-c-format
msgid "<action>Select character encoding</action>."
msgstr "<action> ជ្រើស​ការអ៊ិនកូដ​តួអក្សរ </action> ។​"

#. Tag: menuchoice
#: index.docbook:940
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Keyboard</guimenuitem>"
msgstr "<guimenu> ការកំណត់​ </guimenu> <guimenuitem> ក្តារចុច </guimenuitem>"

#. Tag: para
#: index.docbook:942
#, no-c-format
msgid "<action>Choose desired keymapping</action>."
msgstr "<action> ជ្រើស​ការផ្គូផ្គង​គ្រាប់ចុច​ដែលអ្នកចង់​បាន </action> ។​"

#. Tag: para
#: index.docbook:943
#, no-c-format
msgid ""
"The list of these keymappings is taken from <filename>"
"$KDEDIR/share/apps/konsole/*.keytab</filename>. The file <filename>"
"$KDEDIR/share/apps/konsole/README.KeyTab</filename> describes the <literal "
"role=\"extension\">*.keytab</literal> format in more detail. Add to or modify "
"these files to match your needs. The default keytab is taken from <filename>"
"$KDEDIR/share/apps/konsole/README.default.Keytab</filename>."
msgstr ""
"បញ្ជូ​នៃ​ការផ្គូផ្គង​គ្រាប់ចុច​ទាំងនេះ​ បាន​មក​ពី <filename>"
"$KDEDIR/share/apps/konsole/*.keytab</filename> ។ ឯកសារ  <filename>"
"$KDEDIR/share/apps/konsole/README.KeyTab</filename> "
"ពិពណ៌នា​ពី​ទ្រង់ទ្រាយ​ព័ត៌មានលម្អិត​បន្ថែម​​ <literal role=\"extension\">"
"*.keytab</literal> ។ បន្ថែម​ "
"ឬ​កែសម្រួល​ឯកសារ​ទាំងនេះ​ដើម្បី​ផ្គូផ្គង​តម្រូវ​ការ​របស់​អ្នក​ ។ "
"ផ្ទាំងគ្រាប់ចុច​លំនាំដើម​បាន​មក​ពី "
"<filename>$KDEDIR/share/apps/konsole/README.default.Keytab</filename> ។​"

#. Tag: menuchoice
#: index.docbook:953
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Schema</guimenuitem>"
msgstr "<guimenu> ការកំណត់ </guimenu> <guimenuitem> គ្រោងការណ៍ </guimenuitem>"

#. Tag: para
#: index.docbook:955
#, no-c-format
msgid "<action>Set colors of text and background</action>."
msgstr "<action> កំណត់​ពណ៌​អត្ថបទ​ និង​ផ្ទៃខាងក្រោយ </action> ។​"

#. Tag: para
#: index.docbook:956
#, no-c-format
msgid ""
"The list is taken from <filename>$KDEDIR/share/apps/konsole/*.schema</filename>"
". The file <filename>$KDEDIR/share/apps/konsole/README.Schema</filename> "
"describes the <literal role=\"extension\">*.schema</literal> "
"format in more detail. Add to or modify these files to match your needs. You "
"can also create custom schemas through the preferences dialog at <menuchoice>"
"<guisubmenu>Settings</guisubmenu> <guimenuitem>Configure "
"&konsole;...</guimenuitem></menuchoice>."
msgstr ""
"បញ្ជី​នេះ​បាន​មក​ពី​ <filename>$KDEDIR/share/apps/konsole/*.schema</filename>"
"។ ឯកសារ  <filename>$KDEDIR/share/apps/konsole/README.Schema</filename> "
"ពិពណ៌នា​ទ្រង់ទ្រាយ​ព័ត៌មាន​លម្អិត​ <literal role=\"extension\">"
"*.schema</literal> ។  បន្ថែម​ "
"ឬ​កែសម្រួល​ឯកសារ​ទាំង​នេះ​ដើម្បី​ផ្គូផ្គង​តម្រូវ​ការ​របស់​អ្នក​ ។ "
"អ្នក​ក៏​អាច​បង្កើត​គ្រោងការណ៍​ផ្ទាល់​ខ្លួន​តាម​ប្រអប់​ចំណូល​ចិត្ត  <menuchoice>"
"<guisubmenu> ការកំណត់ </guisubmenu> <guimenuitem> "
"កំណត់​រចនាសម្ព័ន្ធ​កុងសូល​...</guimenuitem></menuchoice>."

#. Tag: menuchoice
#: index.docbook:967
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Size</guisubmenu>"
msgstr "<guimenu> ការកំណត់​ </guimenu> <guisubmenu> ទំហំ </guisubmenu>"

#. Tag: para
#: index.docbook:969
#, no-c-format
msgid "<action>Set size of text area (given in columns x rows)</action>."
msgstr ""
"<action> កំណត់​ទំហំ​ផ្ទៃអត្ថបទ​ (ដែល​បានផ្តល់​ឲ្យ​នូវ​ជួរឈរ និង​ជួរដេក)</action> "
"។​"

#. Tag: menuchoice
#: index.docbook:974
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>History...</guimenuitem>"
msgstr "<guimenu> ការកំណត់ </guimenu> <guimenuitem> ប្រវត្តិ...</guimenuitem>"

#. Tag: para
#: index.docbook:976
#, no-c-format
msgid ""
"<action>Open a dialog where you can configure the history</action>"
". The <guilabel>Enable</guilabel> check box toggles saving of lines that have "
"scrolled off the top of the window. You can enter the <guilabel>"
"Number of lines</guilabel> to remember in the text field, or use the spinner "
"buttons to increase or decrease the number in steps of 100 lines. The "
"<guibutton>Defaults</guibutton> button will reset the history to 1000 lines. "
"Selecting <guibutton>Set Unlimited</guibutton> will cause all history to be "
"saved. Press <guibutton>OK</guibutton> to save your changes, or <guibutton>"
"Cancel</guibutton> to close the dialog without saving your settings."
msgstr ""
"<action> បើក​​ប្រអប់​ដែល​អ្នកអាច​កំណត់​រចនាសម្ព័ន្ធ​ប្រវត្តិ​ </action> "
"។បើក  <guilabel> ប្រអប់​​ធីក </guilabel> "
"បិទបើក​ការរក្សាទុក​បន្ទាត់​ដែល​បាន​រមូរ​ចេញ​ពី​កំពូល​បង្អួច ។ អ្នក​អាច​បញ្ចូល​ "
"<guilabel> ចំនួន​បន្ទាត់​ </guilabel> ដើម្បី​ចងចាំ​ក្នុង​វាល​អត្ថបទ​ "
"ឬ​ប្រើ​ប៊ូតុង​បង្កើន​បន្ថយ​សម្រាប់​បង្កើន​ ឬ​បន្ថយ​ចំនួនជំហាន​១០០​បន្ទាត់​ "
"។ប៊ូតុង​ <guibutton> លំនាំដើម​ </guibutton> នឹង​កំណត់​ប្រវត្តិ​ឡើង​វិញ​ទៅ​ជា​ "
"១០០០​បន្ទាត់​ ។​ជ្រើស​ <guibutton> កំណត់​ឥតព្រំដែន </guibutton> "
"នឹង​បណ្តាល​ឲ្យ​ប្រវត្តិ​រក្សាទុក​ ។  ចុច​ <guibutton> យល់ព្រម  </guibutton>  "
"ដើម្បី រក្សាកាផ្លាស់ប្តូរ​របស់​អ្នក​ទុក​ ឬ <guibutton> បោះបង់ចោល </guibutton> "
"ដើម្បី​បិទ​ប្រអប់​ដោយ​មិនចាំបាច់​រក្សាទុក​ការកំណត់​របស់​អ្នក ។"

#. Tag: menuchoice
#: index.docbook:990
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Save as Default</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់ </guimenu><guimenuitem> រក្សាទុកជាលំនាំដើម​ </guimenuitem>"

#. Tag: para
#: index.docbook:992
#, no-c-format
msgid "<action>Save the current settings as the new default</action>."
msgstr "<action> រក្សា​កាកំណត់​បច្ចុប្បន្ន​ជា​លំនាំថ្មី </action> ។​"

#. Tag: menuchoice
#: index.docbook:997
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Save Sessions Profile...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់​ </guimenu><guimenuitem> "
"រក្សាទុក​ទម្រង់​សម័យ​...</guimenuitem>"

#. Tag: para
#: index.docbook:998
#, no-c-format
msgid ""
"<action>Save the current set of sessions</action> under a name you choose. The "
"profile can then be used by starting &konsole; from the command-line with the "
"<parameter>--profile</parameter> and the name of the profile."
msgstr ""
"<action> រក្សាទុក​ការកំណត់​​សម័យបច្ចុប្បន្ន​ </action> "
"ក្រោម​ឈ្មោះ​អ្នកជ្រើស ។ ទម្រង់​អាច​ត្រូវ​បាន​ប្រើ​ដោយ​ចាប់​ផ្តើម​កុងសូល​ "
"ពី​បន្ទាត់​ពាក្យ​បញ្ជាដែល​មាន <parameter>-- ទម្រង់​ </parameter> "
"និង​ឈ្មោះ​ទម្រង់ ។"

#. Tag: menuchoice
#: index.docbook:1005
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Notifications...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់​​​ </guimenu><guimenuitem> "
"កំណត់​រចនាសម្ព័ន្ធ​ការជូន​ដំណឹង​...</guimenuitem>"

#. Tag: para
#: index.docbook:1007
#, no-c-format
msgid "<action>Customize notifications for &konsole;</action>."
msgstr "<action> ប្តូរ​ការជូន​ដំណឹង​របស់កុងសូល​តាមចិត្ត </action> ។​"

#. Tag: menuchoice
#: index.docbook:1012
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់ </guimenu><guimenuitem> កំណត់​រចនាសម្ព័ន្ធ...</guimenuitem>"

#. Tag: para
#: index.docbook:1014
#, no-c-format
msgid "<action>Customize keyboard shortcuts for &konsole; commands</action>."
msgstr ""
"<action> ប្តូរផ្លូវកាត់​ក្តារចុច​របស់​ពាក្យ​បញ្ជា​កុងសូលតាម​ចិត្ត </action> ។"

#. Tag: menuchoice
#: index.docbook:1019
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure &konsole;...</guimenuitem>"
msgstr ""
"<guimenu> ការកំណត់រចនាសម្ព័ន្ធ </guimenu><guimenuitem> "
"កំណត់រចនាសម្ព័ន្ធ​កុងសូល...</guimenuitem>"

#. Tag: para
#: index.docbook:1021
#, no-c-format
msgid ""
"<action>Open the &kcontrolcenter; module, allowing many additional changes to "
"&konsole;'s interface and behavior, including the creation of custom schemas "
"and modification of the available sessions</action>."
msgstr ""
"<action> បើក​ម៉ូឌុល​Kcontrolcenter "
"អនុញ្ញាត​ឲ្យ​បន្ថែម​ការផ្លាស់ប្តូរ​ទៅកាន់​ចំណុចប្រទាក់​កុងសូល​ "
"នឹង​ឥរិយាបទ​រួមទាំង​ការបង្កើត​គ្រោងការណ៍ និង​ការកែសប្រែ​សម័យ​ដែល​អាច​រក​បាន​  "
"</action> ។​"

#. Tag: title
#: index.docbook:1031
#, no-c-format
msgid "<guimenu>Help</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu> ជំនួយ​</guimenu>"

#. Tag: menuchoice
#: index.docbook:1035
#, no-c-format
msgid "<guimenu>Help</guimenu><guimenuitem>Konsole Handbook</guimenuitem>"
