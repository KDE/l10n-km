"៖ <guimenuitem>លាក់ </guimenuitem>, <guimenuitem> ឆ្វេង </guimenuitem> "
"ឬ <guimenuitem>ស្តាំ </guimenuitem> ។​"

#. Tag: menuchoice
#: index.docbook:901
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></keycombo>"
"</shortcut> <guimenu>Settings</guimenu> <guimenuitem>"
"Full Screen Mode</guimenuitem>"
msgstr ""
