msgid ""
"[Desktop Entry]<co id=\"boilerplate\"/>\n"
"Encoding=UTF-8\n"
"GenericName=IRC Client<co id=\"generic-desc\"/>\n"
"GenericName[af]=Irc Kli&euml;t\n"
"GenericName[de]=IRC Programm\n"
"...\n"
"GenericName[zu]=Umthengi we IRC<co id=\"legacy\"/>\n"
"SwallowExec=<co id=\"translated\"/>\n"
"Name=KSirc\n"
"Name[af]=Ksirc\n"
"Name[de]=KSirc\n"
"..."
msgstr ""
"[Desktop Entry]<co id=\"boilerplate\"/>\n"
"Encoding=UTF-8\n"
"GenericName=IRC Client<co id=\"generic-desc\"/>\n"
"GenericName[af]=Irc Kli&euml;t\n"
"GenericName[de]=IRC Programm\n"
"...\n"
"GenericName[zu]=Umthengi we IRC<co id=\"legacy\"/>\n"
"SwallowExec=<co id=\"translated\"/>\n"
"Name=KSirc\n"
"Name[af]=Ksirc\n"
"Name[de]=KSirc\n"
"..."

#. Tag: para
#: kde-for-admins.docbook:1248
#, no-c-format
msgid "Boiler plate"
msgstr "ចាន​ចំហុយ"

#. Tag: para
#: kde-for-admins.docbook:1250
#, no-c-format
msgid "Translated generic description, not used on desktop"
msgstr "សេចក្ដី​ពណ៌នា​ប្រភេទ​ដែល​មិន​បកប្រែ មិន​ប្រើ​នៅ​លើ​ផ្ទៃតុ"

#. Tag: para
#: kde-for-admins.docbook:1252
#, no-c-format
msgid "Legacy, can be removed"
msgstr "កេរ្តិ៍​ត្រូវ​អាច​បាន​យក​ចេញ"

#. Tag: para
#: kde-for-admins.docbook:1254
#, no-c-format
