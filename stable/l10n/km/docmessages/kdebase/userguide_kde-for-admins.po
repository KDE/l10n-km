"...\n"
"Name[zu]=Ksirc\n"
"MimeType=<co id=\"co-mimetype\"/>\n"
"Exec=ksirc %i %m<co id=\"co-exec\"/>\n"
"Icon=ksirc<co id=\"co-icon\"/>\n"
"TerminalOptions=<co id=\"co-terminaloptions\"/>\n"
"Path=<co id=\"co-path\"/>\n"
"Type=Application<co id=\"co-type\"/>\n"
"Terminal=0<co id=\"co-terminal\"/>\n"
"X-KDE-StartupNotify=true<co id=\"co-x-kde-startupnotify\"/>\n"
"X-DCOP-ServiceType=Multi<co id=\"co-x-dcop-servicetype\"/>\n"
"Categories=Qt;KDE;Network<co id=\"co-categories\"/>"
msgstr ""
"...\n"
"Name[zu]=Ksirc\n"
"MimeType=<co id=\"co-mimetype\"/>\n"
"Exec=ksirc %i %m<co id=\"co-exec\"/>\n"
"Icon=ksirc<co id=\"co-icon\"/>\n"
"TerminalOptions=<co id=\"co-terminaloptions\"/>\n"
"Path=<co id=\"co-path\"/>\n"
"Type=Application<co id=\"co-type\"/>\n"
"Terminal=0<co id=\"co-terminal\"/>\n"
"X-KDE-StartupNotify=true<co id=\"co-x-kde-startupnotify\"/>\n"
"X-DCOP-ServiceType=Multi<co id=\"co-x-dcop-servicetype\"/>\n"
"Categories=Qt;KDE;Network<co id=\"co-categories\"/>"

#. Tag: para
#: kde-for-admins.docbook:1262
#, no-c-format
msgid "Supported &MIME; types, not used on desktop"
msgstr "ប្រភេទ MIME ដែល​គាំទ្រ ដែល​មិន​ប្រើ​នៅ​លើ​ផ្ទៃតុ"

#. Tag: para
#: kde-for-admins.docbook:1265
#, no-c-format
msgid "The command line to execute"
msgstr "បន្ទាត់​ពាក្យ​បញ្ជា​សម្រាប់​ប្រតិបត្តិ"

#. Tag: para
#: kde-for-admins.docbook:1267
#, no-c-format
msgid "The icon, from icon theme or full path"
msgstr "រូប​តំណាង ពី​ស្បែក​រូប​តំណាង ឬ​ផ្លូវ​ពេញ"

#. Tag: para
#: kde-for-admins.docbook:1269
#, no-c-format
msgid "Only used if terminal is needed"
msgstr "បាន​បើ​តែ​បើ​ស្ថានីយ​ត្រូវ​ការ"

#. Tag: para
#: kde-for-admins.docbook:1272
#, no-c-format
msgid "Working directory for command"
msgstr "ធ្វើការ​ដោយ​ផ្ទាល់​សម្រាប់​ពាក្យ​បញ្ជា"

#. Tag: para
#: kde-for-admins.docbook:1274
#, no-c-format
msgid "More boiler plate"
msgstr "ចាន​ចំហុយ​បន្ថែម"

#. Tag: para
#: kde-for-admins.docbook:1276
#, no-c-format
msgid "Use true if terminal is needed, text application"
msgstr "បើ true បើ​ស្ថានីយ​ត្រូវការ កម្មវិធី​អត្ថបទ"

#. Tag: para
#: kde-for-admins.docbook:1279
#, no-c-format
msgid "Show bouncy cursor, disable if it doesn't work."
msgstr "បង្ហាញ​ទស្សន៍​ទ្រនិច​ព្រំ​ដែល បិទ​បើ​វា​មិន​ធ្វើការ ។"

#. Tag: para
#: kde-for-admins.docbook:1282
#, no-c-format
msgid "Has app started ok? Remove if it doesn't work"
msgstr "តើ​កម្មវិធី​បាន​ចាប់ផ្ដើម​យ៉ាង​ល្អ ? យក​ចេញ​បើ​វា​មិន​ធ្វើការ"

#. Tag: para
#: kde-for-admins.docbook:1285
#, no-c-format
msgid "Categories for &kde; Menu, not used on desktop"
msgstr "ប្រភេទ​សម្រាប់ KDE ម៉ឺនុយ មិន​ត្រូវ​បាន​ប្រើ​នៅ​លើ​ផ្ទៃតុ"

#. Tag: title
#: kde-for-admins.docbook:1295
#, no-c-format
msgid ""
"The <varname>Exec</varname> option in <literal role=\"extension\">"
".desktop</literal> files"
msgstr ""
"​ជម្រើស <varname>Exec</varname> នៅ​ក្នុង​ឯកសារ <literal role=\"extension\">"
".desktop</literal>"

#. Tag: para
#: kde-for-admins.docbook:1298
#, no-c-format
msgid ""
"Following the command, you can have several place holders which will be "
"replaced with the actual values when the actual program is run:"
msgstr ""
"ពាក្យ​បញ្ជា​ខាងក្រោម អ្នក​មាន​កន្លែង​ដាក់​ជាច្រើន ដែល​នឹង​ជំនួស​ជាមួយ​តម្លៃ​ពិត "
"ពេល​កម្មវិធី​ពិត​ត្រូវ​បាន​រត់ ៖"

#. Tag: term
#: kde-for-admins.docbook:1302
#, no-c-format
msgid "<term>%f</term>"
msgstr "<term>%f</term>"

#. Tag: para
#: kde-for-admins.docbook:1302
#, no-c-format
msgid ""
"A single file name; used when dropping file on icon, or with file associations."
msgstr ""
"ឈ្មោះ​ឯកសារ​តែ​មួយ ត្រូវ​បាន​ប្រើ​ពេល​ទម្លាក់​ឯកសារ​លើ​រូប​តំណាង "
"ឬ​ជាមួយ​ទំនាក់ទំនង​ឯកសារ ។"

#. Tag: term
#: kde-for-admins.docbook:1308
#, no-c-format
msgid "<term>%F</term>"
msgstr "<term>%F</term>"

#. Tag: para
#: kde-for-admins.docbook:1309
#, no-c-format
msgid ""
"A list of files; use for applications that can open several local files at "
"once."
msgstr ""
"បញ្ជី​ឯកសារ ប្រើ​សម្រាប់​កម្មវិធី​ដែល​អាច​បើក​ឯកសារ​មូលដ្ឋាន​ជាច្រើន​តែ​ម្ដង ។"

#. Tag: term
#: kde-for-admins.docbook:1315
#, no-c-format
msgid "<term>%u</term>"
msgstr "<term>%u</term>"

#. Tag: para
#: kde-for-admins.docbook:1316
#, no-c-format
msgid ""
"A single &URL;: if the app can handle &eg; &FTP; or &HTTP; &URL;s itself, "
"otherwise &kde;."
msgstr ""
"URL តែ​មួយ ៖ បើ​កម្មវិធី​អាច​គ្រប់គ្រង ឧ. FTP ឬ HTTP URL ខ្លួន​វា "
"មិន​ដូច្នោះ​ទេ KDE ។"

#. Tag: term
#: kde-for-admins.docbook:1322
#, no-c-format
msgid "<term>%U</term>"
msgstr "<term>%U</term>"

#. Tag: para
#: kde-for-admins.docbook:1323
#, no-c-format
msgid ""
"A list of &URL;s; will download the file first and pass a local file to the app "
"(!!)"
msgstr ""
"បញ្ជី URL នឹង​ទាញយក​ឯកសារ​ដំបូង និង​បញ្ជូន​ឯកសារ​មូលដ្ឋាន​ទៅ​កម្មវិធី (!!)"

#. Tag: term
#: kde-for-admins.docbook:1330
#, no-c-format
msgid "<term>%d</term>"
msgstr "<term>%d</term>"

#. Tag: para
#: kde-for-admins.docbook:1331
#, no-c-format
msgid ""
"The folder of the file to open; useful if app needs to have file in current "
"working directory."
msgstr ""
"ថត​នៃ​ឯកសារ​សម្រាប់​បើក "
"មាន​ប្រយោជន៍​បើ​កម្មវិធី​ត្រូវការ​មាន​ឯកសារ​នៅ​ក្នុង​ថត​ធ្វើការ​បច្ចុប្បន្ន ។"

#. Tag: term
#: kde-for-admins.docbook:1337
#, no-c-format
msgid "<term>%D</term>"
msgstr "<term>%D</term>"

#. Tag: para
#: kde-for-admins.docbook:1338
#, no-c-format
msgid "A list of folders, not very practical."
msgstr "បញ្ជី​ថត មិន​ធម្មតា​ទេ ។"

#. Tag: term
#: kde-for-admins.docbook:1343
#, no-c-format
msgid "<term>%i</term>"
msgstr "<term>%i</term>"

#. Tag: para
#: kde-for-admins.docbook:1344
#, no-c-format
msgid ""
"The icon; <option>--icon</option> option; &kde; app will use icon from <varname>"
"Icon</varname>= line in taskbar."
msgstr ""
