#, no-c-format
msgid "Menu entry with 3 applications:"
msgstr ""

#. Tag: filename
#: kde-for-admins.docbook:1464
#, no-c-format
msgid "/usr/share/applications/Acrobat Reader.desktop"
msgstr ""

#. Tag: filename
#: kde-for-admins.docbook:1467
#, no-c-format
msgid "/opt/kde3/share/applications/kde/kpresenter.desktop"
msgstr ""

#. Tag: filename
#: kde-for-admins.docbook:1469
#, no-c-format
msgid "/opt/kde3/share/applications/kde/kword.desktop"
msgstr ""

#. Tag: title
#: kde-for-admins.docbook:1477
#, no-c-format
msgid "Stored Where?"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1479
#, no-c-format
msgid ""
"<literal role=\"extension\">.menu</literal> files describing the menu "
"structure. The files are stored in <filename class=\"directory\">$<envar>"
"KDEDIR</envar>/etc/xdg/menus</filename> and <filename class=\"directory\">"
"/etc/xdg/menus</filename>. These store the system-wide menu structure and are "
"controlled by $<envar>XDG_CONFIG_DIRS</envar>. <filename class=\"directory\">"
"$<envar>HOME</envar>/.config/menus</filename> stores user-specific changes to "
"the menu structure and is controlled by $<envar>XDG_CONFIG_HOME</envar>"
". For more information, see <ulink "
"url=\"http://www.freedesktop.org/Standards/basedir-spec\">"
"http://www.freedesktop.org/Standards/basedir-spec</ulink>."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1490
#, no-c-format
msgid ""
"<literal role=\"extension\">.desktop</literal> files describe the applications "
"and are stored in: <filename class=\"directory\">$<envar>KDEDIR</envar>"
"/share/applications</filename>, <filename class=\"directory\">"
"/usr/share/applications</filename>, <filename class=\"directory\">"
"/usr/local/share/applications</filename>. These are the system-wide application "
"<literal role=\"extension\">.desktop</literal> files which are controlled by "
"$<envar>XDG_DATA_DIRS</envar>."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1500
#, no-c-format
msgid ""
"<filename "
"class=\"directory\">$<envar>HOME</envar>/.local/applications</filename> "
"contains user-specific <literal role=\"extension\">.desktop</literal> "
"files and user-specific changes. It is controlled by $<envar>"
"XDG_DATA_HOME</envar>. For more information, see <ulink "
"url=\"http://www.freedesktop.org/Standards/basedir-spec\">"
"http://www.freedesktop.org/Standards/basedir-spec</ulink>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1508
#, no-c-format
msgid ""
"<literal role=\"extension\">.directory</literal> files describing the sub-menus "
"are stored in: <filename class=\"directory\">$<envar>KDEDIR</envar>"
"/share/desktop-directories</filename>, <filename class=\"directory\">"
"/usr/share/desktop-directories</filename>, <filename class=\"directory\">"
"/usr/local/share/desktop-directories</filename>. These are the system-wide menu "
"<literal role=\"extension\">.directory</literal> files, controlled by $<envar>"
"XDG_DATA_DIRS</envar>. The user-specific changes are stored in <filename "
"class=\"directory\">$<envar>HOME</envar>/.local/desktop-directories</filename>"
". These are controlled by $<envar>XDG_DATA_HOME</envar>"
". For more information, see <ulink "
"url=\"http://www.freedesktop.org/Standards/basedir-spec\">"
"http://www.freedesktop.org/Standards/basedir-spec</ulink>"
msgstr ""

#. Tag: programlisting
#: kde-for-admins.docbook:1521
#, no-c-format
msgid ""
"<markup>\n"
"             &lt;Menu&gt;\n"
"                        &lt;Name&gt;Art&lt;/Name&gt;\n"
"                        "
"&lt;Directory&gt;suse-edutainment-art.directory&lt;/Directory&gt;\n"
"                        &lt;Include&gt;\n"
"                                &lt;Category&gt;X-SuSE-Art&lt;/Category&gt;\n"
"                        &lt;/Include&gt;\n"
"                &lt;/Menu&gt;\n"
"</markup>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1524
#, no-c-format
msgid ""
"<literal>Art</literal> is the internal name for this menu. <filename>"
"suse-edutainment-art.directory</filename> defines the name and icon for this "
"menu, and the menu includes all applications that have <literal>"
"X-SuSE-Art</literal> listed as a category, &eg;:"
msgstr ""

#. Tag: programlisting
#: kde-for-admins.docbook:1528
#, no-c-format
msgid "Categories=Qt;KDE;Education;X-SuSE-Art"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1530
#, no-c-format
msgid ""
"<filename>suse-edutainment-art.directory</filename> defines the name and icon "
"for this menu:"
msgstr ""

#. Tag: programlisting
#: kde-for-admins.docbook:1532
#, no-c-format
msgid ""
"[Desktop Entry]\n"
"Name=Art and Culture\n"
"Icon=kcmsystem"
msgstr ""

#. Tag: title
#: kde-for-admins.docbook:1538
#, no-c-format
msgid "Common Pitfalls"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1540
#, no-c-format
msgid ""
"Applications <emphasis>not</emphasis> in the menu do <emphasis>not</emphasis> "
"exist with regard to other applications or file associations: If you remove an "
"application from the menu, &kde; assumes you don't want to use it."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1544
#, no-c-format
msgid ""
"When applications are unwanted in the menu, either place them in <filename>"
".hidden</filename> menu or a dedicated menu with <programlisting>\n"
"NoDisplay=true\n"
"</programlisting> in the <literal role=\"extension\">.directory</literal> file"
msgstr ""

#. Tag: title
#: kde-for-admins.docbook:1551
#, no-c-format
msgid "Essential Menus"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1553
#, no-c-format
msgid ""
"<filename class=\"directory\">$<envar>KDEDIR</envar>"
"/etc/xdg/menus/applications-merged/</filename> contains <filename>"
"kde-essential.menu</filename> which includes some essential menus that are "
"normally not shown in the &kde; menu itself:"
msgstr ""

