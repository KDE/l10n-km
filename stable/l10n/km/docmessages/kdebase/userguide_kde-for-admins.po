msgstr ""
"ពេល​មាន​កម្មវិធី/វត្ថុ​ច្រើន​ជាង​មួយ មួយ​ណា​ដែល​អ្នក​គួរ​ប្រើ ? "
"យក​សេចក្ដី​យោង ?"

#. Tag: screen
#: kde-for-admins.docbook:2234
#, no-c-format
msgid ""
"<prompt>&percnt; </prompt><userinput><command>echo</command><option> "
"$KONSOLE_DCOP</option></userinput>\n"
"DCOPRef(konsole-7547,konsole)\n"
"\n"
"<prompt>&percnt; </prompt><userinput><command>dcop</command><option> "
"$KONSOLE_DCOP</option><option> newSession</option></userinput>\n"
"session-6\n"
"\n"
"<prompt>&percnt; </prompt><userinput><command>dcopstart</command><option> "
"konsole</option></userinput>\n"
"konsole-9058\n"
"\n"
"\n"
"#!/bin/sh\n"
"konsole=$(dcopstart konsole-script)\n"
"session=$(dcop $konsole konsole currentSession)\n"
"dcop $konsole $session renameSession Local\n"
"\n"
"session=$(dcop $konsole konsole newSession)\n"
"dcop $konsole $session renameSession Remote\n"
"\n"
"session=$(dcop $konsole konsole newSession)\n"
"dcop $konsole $session renameSession Code\n"
"dcop $konsole $session sendSession 'cd /my/work/directory'"
msgstr ""
"<prompt>&percnt; </prompt><userinput><command>echo</command><option> "
"$KONSOLE_DCOP</option></userinput>\n"
