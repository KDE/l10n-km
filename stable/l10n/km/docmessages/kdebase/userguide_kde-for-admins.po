msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1254
#, no-c-format
msgid "Translated name as it appears on desktop"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1258
#, no-c-format
msgid "<para>Desktop Icons</para>"
msgstr ""

#. Tag: programlisting
#: kde-for-admins.docbook:1259
#, no-c-format
msgid ""
"...\n"
"Name[zu]=Ksirc\n"
"MimeType=<co id=\"co-mimetype\"/>\n"
"Exec=ksirc %i %m<co id=\"co-exec\"/>\n"
"Icon=ksirc<co id=\"co-icon\"/>\n"
"TerminalOptions=<co id=\"co-terminaloptions\"/>\n"
"Path=<co id=\"co-path\"/>\n"
"Type=Application<co id=\"co-type\"/>\n"
"Terminal=0<co id=\"co-terminal\"/>\n"
