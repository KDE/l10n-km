"GenericName[de]=IRC Programm\n"
"...\n"
"GenericName[zu]=Umthengi we IRC<co id=\"legacy\"/>\n"
"SwallowExec=<co id=\"translated\"/>\n"
"Name=KSirc\n"
"Name[af]=Ksirc\n"
"Name[de]=KSirc\n"
"..."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:1248
#, no-c-format
