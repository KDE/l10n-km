#. Tag: para
#: ktimemon.docbook:19
#, no-c-format
msgid "&ktimemon; is a system monitor for the K Desktop Environment"
msgstr ""

#. Tag: keyword
#: ktimemon.docbook:22
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr ""

#. Tag: keyword
#: ktimemon.docbook:23
#, no-c-format
