#: mixconfig.cpp:55
msgid "Default Volumes"
msgstr "សម្លេង​លំនាំដើម"

#: mixconfig.cpp:63
msgid "Save Current Volumes"
msgstr "រក្សាទុក​សម្លេង​បច្ចុប្បន្ន"

#: mixconfig.cpp:68
msgid "Load Volumes"
msgstr "ផ្ទុក​សម្លេង"

#: mixconfig.cpp:73
msgid "Load volumes on login"
msgstr "ផ្ទុក​សម្លេង ពេល​ចូល"

#: mixconfig.cpp:78
msgid "Hardware Settings"
msgstr "ការ​កំណត់​ផ្នែករឹង"

#: mixconfig.cpp:85
msgid "Maximum number of probed devices per mixer:"
msgstr "ចំនួន​ឧបករណ៍​ស្ទង់រក​អតិបរមា​ក្នុង​មួយ  mixer ៖"

#: mixconfig.cpp:90
msgid ""
"Change this value to optimize the startup time of kmix. High values mean "
"that kmix probes for many devices per soundcard driver.\n"
"If there are more mixer sub devices in a driver than kmix detects, increase "
"this value"
msgstr ""
"ផ្លាស់ប្តូរ​តម្លៃ​នេះ ដើម្បី​ធ្វើ​ឲ្យពេលវេលា​​ចាប់ផ្ដើម​ឡើង​នៃ kmix កាន់​តែ​ប្រសើរ ។ តម្លៃ​ខ្ពស់​មាន​ន័យ​ថា kmix ស្ទង់​រក​​ឧបករណ៍​ជាច្រើន​ក្នុង​មួយ​កម្មវិធី​បញ្ជា​សម្លេង ។\n"
"បើ​មាន​ឧបករណ៍​លាយ​សម្លេង​រង​ច្រើន​ជាង​នេះ ​សូម​បង្កើន​តម្លៃនេះ"

#: mixconfig.cpp:110
msgid "Restoring default volumes"
msgstr "កំពុង​ស្ដារ​សម្លេង​លំនាំដើម"

#: mixconfig.cpp:117 mixconfig.cpp:145
msgid "The kmixctrl executable cannot be found."
msgstr "រក​មិន​ឃើញ​ឯកសារ​ប្រតិបត្តិ​ kmixctrl ។"

#: mixconfig.cpp:138
msgid "Saving default volumes"
msgstr "កំពុង​រក្សាទុក​សម្លេង​ដំនាំដើម"

