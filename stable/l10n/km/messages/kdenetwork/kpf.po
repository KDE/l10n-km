#: ConfigDialogPage.cpp:133 PropertiesDialogPlugin.cpp:403 ServerWizard.cpp:82
msgid ""
"<p>Specify the network `port' on which the server should listen for "
"connections.</p>"
msgstr ""
"<p>បណ្តាញ​ជាក់​លាក់​មួយ​ `ច្រក​' "
"ម៉ាសីុន​បម្រើ​មួយណា​ត្រូវស្តាប់​​នៃ​ការ​តភ្ជាប់  ។ </p>"

#: ConfigDialogPage.cpp:142 PropertiesDialogPlugin.cpp:412 ServerWizard.cpp:95
msgid ""
"<p>Specify the maximum amount of data (in kilobytes) that will be sent out per "
"second.</p>"
"<p>This allows you to keep some bandwidth for yourself instead of allowing "
"connections with kpf to hog your connection.</p>"
msgstr ""
"<p>ចំនួន​អតិប្បរិមាជាក់​លាក់​នៃ​ទិន្នន័យ (ក្នុង​គីឡូបៃ) ដែល​នឹង​ "
"ផ្ញើ​ចេញក្នុង​១ វិនាទី ។ </p> "
"<p>ការអនុញ្ញាត​នេះ​អ្នកត្រូវ​រក្សា​ទុក​ការផ្សាយ​មួយ​ចំនួយ "
"ដោយ​ខ្លូន​អ្នក​ផ្ទាល់ជំនួស​ការអនុញ្ញាតតភ្ជាប់​ជាមួយ kpf "
"ទៅកាន់ការតភ្ជាប់​របស់​អ្នក​</p>"

#: ConfigDialogPage.cpp:155 PropertiesDialogPlugin.cpp:425
msgid ""
"<p>Specify the maximum number of connections allowed at any one time.</p>"
msgstr ""
"<p>ចំនួន​អតិប្បរិមា​នៃ​ ការតភ្ជាប់​ បាន​អនុញ្ញាត ក្នុង​េពល​តែ​មួយ ។ </p>"

#: ConfigDialogPage.cpp:164
msgid ""
"<p>Allow serving of files which have a symbolic link in the path from / to the "
"file, or are a symbolic link themselves.</p>"
"<p><strong>Warning !</strong> This could be a security risk. Use only if you "
"understand the issues involved.</p>"
msgstr ""
"<p>អនុញ្ញាត​បម្រើ​នៃ​ ឯកសារ ណាដែលមាន​និមិត្ត​សញ្ញាតភ្ជាប់ផ្លូវ ពី/ ទៅ​កាន់​ "
"ឯកសារ ឫ ភ្ជាប់​និមិត្ត​សញ្ញាត​ដោយ​ពួក​វា​តែម្តង​ ។ </p>"
"<p><strong>ការព្រមាន!</strong> សុវត្តិភាព​មាន​ការ​ប្រថុយ​ប្រថាន ប្រើ​តែមួយ​គត់​ "
"ប្រសិន​បើ​អ្នក​យល់បញ្ហាជាប់​ទាក់​ទង </p>"

#: ConfigDialogPage.cpp:178
msgid ""
"<p>Specify the text that will be sent upon an error, such as a request for a "
"page that does not exist on this server.</p>"
msgstr ""
"<p>អត្ថបទ​ជាក់​លាក់​មួយ​ដែល​នឹង ផ្ញើកំហុស​ខាងលើ​ ដូចជា​ សំណើ "
"សំរាប់​ទំព័រដែល​មិន​មាន​នៅ​ក្នុង​ម៉ាសីុន​បម្រើ ។</p>"

