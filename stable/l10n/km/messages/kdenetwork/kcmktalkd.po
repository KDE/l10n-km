msgstr "ទទួល​សំបុត្រ​ឲ្យ​ស្មើគ្នា​ប្រសិនបើ​​មិនមានបាត់​សារ"

#: kcmktalkd/answmachpage.cpp:80
msgid "&Banner displayed on answering machine startup:"
msgstr "បដា​បានបង្ហាញ​នៅលើ​ការចាប់ផ្តើម​ម៉ាស៊ីន​ចម្លើយ ៖"

#: kcmktalkd/answmachpage.cpp:89
msgid ""
"The person you are asking to talk with is not answering.\n"
"Please leave a message to be delivered via email.\n"
"Just start typing and when you have finished, exit normally."
msgstr ""
"បុគ្គល​ដែលអ្នក​កំពុងតែ​សួរ​ឲ្យ​និយាយ​ជាមួយ​គឺ​មិន​កំពុងឆ្លើយទេ ។\n"
"សូមទុក​សារ​មួយ​ដើម្បី​បញ្ជូន​តាមរយៈ​អ៊ីមែល ។\n"
"គ្រាន់តែ​ចាប់ផ្តើម​ការវាយ​និង​នៅពេល​អ្នកបានបញ្ចប់​, ចេញ​ជាធម្មតា ។"

#: kcmktalkd/answmachpage.cpp:200 kcmktalkd/answmachpage.cpp:218
#, c-format
msgid "Message from %s"
msgstr "សារ​ពី %s"

#: kcmktalkd/answmachpage.cpp:201 kcmktalkd/answmachpage.cpp:220
#, c-format
msgid "Message left on the answering machine, by %s@%s"
msgstr "សារ​ទុក​នៅលើ​ម៉ាស៊ីន​ចម្លើយ ដោយ %s@%s"

#: kcmktalkd/forwmachpage.cpp:41
#, fuzzy
msgid "Activate &forward"
msgstr "ធ្វើឲ្យសកម្ម​បញ្ជូនបន្ត"

#: kcmktalkd/forwmachpage.cpp:46
msgid "&Destination (user or user@host):"
msgstr "ទិសដៅ (user or user@host) ៖"

#: kcmktalkd/forwmachpage.cpp:56
msgid "Forward &method:"
msgstr "វិធីសាស្ត្រ​បញ្ជូនបន្ត ៖"

#: kcmktalkd/forwmachpage.cpp:61
msgid ""
"FWA: Forward announcement only. Direct connection. Not recommended.\n"
"FWR: Forward all requests, changing info when necessary. Direct connection.\n"
"FWT: Forward all requests and handle the talk request. No direct "
"connection.\n"
"\n"
"Recommended use: FWT if you want to use it behind a firewall (and if ktalkd\n"
"can access both networks). Otherwise choose FWR.\n"
"\n"
"See Help for further explanation.\n"
msgstr ""
"FWA: បានតែ​​ការប្រកាស​បញ្ជូន​បន្ត ។ ការតភ្ជាប់​ផ្ទាល់​ ។ មិនបាន​ផ្តល់អនុសាសន៏ ។\n"
"FWR: ប្តូរ​ពត៌មាន​នៅពេល​ចាំបាច់ ។ ការតភ្ជាប់​ផ្ទាល់ ។\n"
"FWT: ប្តូរ​ពត៌មាន​នៅពេល​ចាំបាច់ និង​ដោះស្រាយ​សំណើ​និយាយ ។ គ្មានការតភ្ជាប់​ផ្ទាល់ ។\n"
"\n"
"បានផ្តល់អនុសាសន៏​ប្រើ ៖ FWT ប្រសិនបើ​អ្នក​ចង់​ប្រើវានៅក្រោយ​ជញ្ជាំងភ្លើង (ហើយ​ប្រសិនបើ ktalkd\n"
"អាច​ចូលដំណើការ​បណ្តាញ​ទាំងពីរ) ។ ម្យ៉ាងវិញទៀត​ជ្រើស FWR ។\n"
"\n"
"មើល​ជំនួយ​សម្រាប់​ការពន្យល់​បន្ថែម ។\n"

