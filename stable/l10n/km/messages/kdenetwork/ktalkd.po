#: ../kcmktalkd/answmachpage.cpp:45
msgid "&Activate answering machine"
msgstr "ធ្វើឲ្យ​ម៉ាស៊ីន​ចម្លើយ​សកម្ម"

#: ../kcmktalkd/answmachpage.cpp:50
msgid "&Mail address:"
msgstr "​អាសយដ្ឋាន​សំបុត្រ ៖"

#: ../kcmktalkd/answmachpage.cpp:57
msgid "Mail s&ubject:"
msgstr "​ប្រធានបទ​សំបុត្រ ៖"

#: ../kcmktalkd/answmachpage.cpp:60
#, c-format
msgid "Use %s for the caller name"
msgstr "​ប្រើ %s សម្រាប់​ឈ្មោះ​អ្នកហៅ"

#: ../kcmktalkd/answmachpage.cpp:66
msgid "Mail &first line:"
msgstr "​សំបុត្រ​បន្ទាត់​ដំបូង ៖"

#: ../kcmktalkd/answmachpage.cpp:70
#, c-format
msgid "Use first %s for caller name, and second %s for caller hostname"
msgstr "​ប្រើ %s ទីមួយ​សម្រាប់​ឈ្មោះ​អ្នកហៅ និង %s ទីពីរ​សម្រាប់​ឈ្មោះម៉ាស៊ីន​​របស់​អ្នកហៅ"

#: ../kcmktalkd/answmachpage.cpp:74
msgid "&Receive a mail even if no message left"
msgstr "​ទទួល​សំបុត្រ​ឲ្យ​ស្មើគ្នា​ប្រសិនបើ​​មិនមានបាត់​សារទេនោះ"

#: ../kcmktalkd/answmachpage.cpp:80
msgid "&Banner displayed on answering machine startup:"
msgstr "​បដា​បានបង្ហាញ​នៅលើ​ការចាប់ផ្តើម​ម៉ាស៊ីន​ចម្លើយ ៖"

#: ../kcmktalkd/answmachpage.cpp:89
msgid ""
"The person you are asking to talk with is not answering.\n"
"Please leave a message to be delivered via email.\n"
"Just start typing and when you have finished, exit normally."
msgstr ""
"​បុគ្គល​ដែលអ្នក​កំពុងតែ​សួរ​ឲ្យ​និយាយ​ជាមួយ​គឺ​មិន​កំពុងឆ្លើយទេ ។\n"
"សូមទុក​សារ​មួយ​ដែល​ត្រូវបានបញ្ជូន​តាមរយៈ​អ៊ីមែល ។\n"
"គ្រាន់តែ​ចាប់ផ្តើម​ការវាយ​និង​នៅពេល​ដែលអ្នក​បានបញ្ចប់ ចេញ​ជាធម្មតា ។"

#: ../kcmktalkd/answmachpage.cpp:200 ../kcmktalkd/answmachpage.cpp:218
#, c-format
msgid "Message from %s"
msgstr "​សារ​ពី %s"

#: ../kcmktalkd/answmachpage.cpp:201 ../kcmktalkd/answmachpage.cpp:220
#, c-format
msgid "Message left in the answering machine, by %s@%s"
msgstr "បានទុក​សារ​នៅក្នុង​ម៉ាស៊ីន​ចម្លើយ​ដោយ %s@%s"

#: ../kcmktalkd/forwmachpage.cpp:41
msgid "Activate &forward"
msgstr "​ធ្វើឲ្យ​សកម្ម​ទៅមុខ"

#: ../kcmktalkd/forwmachpage.cpp:46
msgid "&Destination (user or user@host):"
msgstr "​ទិសដៅ (អ្នក​ប្រើ ឬ អ្នកប្រើ@ម៉ាស៊ីន)  ៖"

#: ../kcmktalkd/forwmachpage.cpp:56
msgid "Forward &method:"
msgstr "​វិធីសាស្ត្រ​បញ្ជូនបន្ត ៖"

#: ../kcmktalkd/forwmachpage.cpp:61
msgid ""
"FWA: Forward announcement only. Direct connection. Not recommended.\n"
"FWR: Forward all requests, changing info when necessary. Direct connection.\n"
"FWT: Forward all requests and handle the talk request. No direct "
"connection.\n"
"\n"
"Recommended use: FWT if you want to use it behind a firewall (and if ktalkd\n"
"can access both networks). Otherwise choose FWR.\n"
"\n"
"See Help for further explanation.\n"
msgstr ""
"​FWA ៖ បានតែ​បញ្ជូនបន្ត​សេចក្តី​ប្រកាស ។ ការតភ្ជាប់​ផ្ទាល់ ។ មិនបាន​ផ្តល់អនុសាសន៏ ។\n"
"FWR ៖ បញ្ជូនបន្ត​សំណើ​ទាំងអស់, ប្តូរ​ពត៌មាន​នៅពេល​ចាំបាច់ ។ ការតភ្ជាប់​ផ្ទាល់ ។\n"
"FWT ៖ បញ្ជូនបន្ត​សំណើ​ទាំងអស់ និង​ដោះស្រាយ​​​សំណើ​និយាយ ។ មិនតភ្ជាប់​ផ្ទាល់ ។\n"
"\n"
"បានផ្តល់​អនុសាសន៏​ប្រើ ៖ FWT ប្រសិនបើ​អ្នក​ចង់ប្រើវា​នៅពីក្រោយ​ជញ្ជាំងភ្លើង​មួយ (ហើយ​ប្រសិនបើ ktalkd\n"
"អាច​ចូលដំណើការ​បណ្តាញ​ទាំងពីរ). ម្យ៉ាងវិញទៀត​ជ្រើស FWR ។\n"
"\n"
"មើល​ជំនួយ​សម្រាប់​ការពន្យល់​បន្ថែម ។\n"

