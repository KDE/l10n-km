#: keycapturedialog.cpp:50
msgid "Enter Key Combination"
msgstr "ការបញ្ចូល​ពាក្យ​សម្ងាត់"

#: krdc.cpp:132 krdc.cpp:155
msgid "The entered host does not have the required form."
msgstr "ម៉ាសីុន​បាន​បញ្ចូល​មិន​ត្រូវ​ការ​ពី"

#: krdc.cpp:133 krdc.cpp:156
msgid "Malformed URL or Host"
msgstr "Malformed URL ឫ​ មា៉សីុន​"

#: krdc.cpp:162
msgid "%1 - Remote Desktop Connection"
msgstr "%1 - តភ្ជាប់​ផ្ទៃតុ​ពី​ចម្ងាយ​"

#: krdc.cpp:189
msgid ""
"Here you can see the remote desktop. If the other side allows you to control "
"it, you can also move the mouse, click or enter keystrokes. If the content does "
"not fit your screen, click on the toolbar's full screen button or scale button. "
"To end the connection, just close the window."
msgstr ""
"នៅទី​នេះ​អ្នក​អាច​មើល​ឃើញ​ការភ្ជាប់​ផ្ទៃ​តុ​ពី​ចម្ងាយ "
"ប្រសិន​បើ​ផ្នែក​ផ្សែង​ទៀត​អនុញ្ញាតអ្នក​ធ្វើ​ការត្រួត​ពិនិត្យ​វា​ ។​ "
"អ្នក​ក៏អាច​ផ្លាស់ទី​កណ្តុរ​ផងដែរ ដោយ​ការចុចលគន្លឹះ ប្រសិន​បើ​មាតិកា​មិន​ "
"សំរប​សំរួល​អេក្រង់​របស់​អ្នក​ទេ ចុចលើ ប៊ូតុងរបារ​ឧបករណ៍ឲ្យ​បាន​ពេញ​អេក្រង់​ ឫ "
"ធ្វើ​មាត្រដ្ឋាន ។​button. To end the connection, just close the window."

#: krdc.cpp:222
msgid "Establishing connection..."
msgstr "កំពុង​បង្កើ​ត​ការតភ្ជាប់​..."

#: krdc.cpp:228
msgid "Authenticating..."
msgstr "បញ្ជាក់​ការពិត..."

#: krdc.cpp:233
msgid "Preparing desktop..."
msgstr "ការរៀប​ចំ​ផ្ទៃតុ..."

#: krdc.cpp:380
msgid "View Only"
msgstr "គ្រាន់​តែ​មើល​ើល​"

#: krdc.cpp:384
msgid "Always Show Local Cursor"
msgstr "ជានិច្ច​ជាកាលបង្ហាញទីតាំង​ទស្សន៍​ទ្រនិច​ "

#: krdc.cpp:469
msgid "Autohide on/off"
msgstr "លាក់​ បើល​/បិទ​ដោយ​ស្វ័យ​ប្រវត្តិ"

#: krdc.cpp:476 krdc.cpp:574 krdc.cpp:576
msgid "Fullscreen"
msgstr "េពញ​អេក្រង់​"

#: krdc.cpp:482 krdc.cpp:484 krdc.cpp:601
msgid "Advanced options"
msgstr "ជម្រើស កម្រិត ខ្ពស់ច"

#: krdc.cpp:497 krdc.cpp:585
msgid "Scale view"
msgstr "មើល​មាត្រដ្ឋាន"

#: krdc.cpp:505
msgid "Minimize"
msgstr "បង្រួម​អប្បបរមា"

#: krdc.cpp:577
msgid ""
"Switches to full screen. If the remote desktop has a different screen "
"resolution, Remote Desktop Connection will automatically switch to the nearest "
"resolution."
msgstr ""
"ប្តូរទៅ​កាន់​ពេញ​អេក្រង់​ ប្រសិន​បើ​ផ្ទៃតុ​ពី​ចម្ងាយ "
"មាន​អេក្រង់គុណភាព​បង្ហាញ​ខុសគ្នា​ ការតភ្ជាប់​ផ្ទៃតុពី​ចម្ងាយ​វា​និង "
"ប្តូរ​ដោយ​ស្វ័យ​ប្រវត្តិទៅកាន់​គុណភាបព​បង្ហាញ​ជិតបំផុង​ ។​"

#: krdc.cpp:583
msgid "Scale"
msgstr "មាត្រ​ដ្ឋាន"

#: krdc.cpp:586
msgid "This option scales the remote screen to fit your window size."
msgstr ""
"ភ្ជាប់​េអក្រង់​ពីចម្ងាយ​ដោយ​ជ្រើស​លើ​ជម្រើស​នេះ "
"ដើម្បី​សំរប​សំរួល​ទំហំ​បង្អួច​របស់​អ្នក​ ។​"

#: krdc.cpp:592
msgid "Special Keys"
msgstr "គន្លឹះ​​ពិេសស"

#: krdc.cpp:594
msgid "Enter special keys."
msgstr "បញ្ចូល​គន្លឹះ​ពិេសស ។​"

#: krdc.cpp:595
msgid ""
"This option allows you to send special key combinations like Ctrl-Alt-Del to "
"the remote host."
msgstr ""
"ជម្រើស​នេះ​អនុញ្ញាត​អ្នក​ ដើម្បី​ផ្ញើរ​បណ្តុំគន្លឹះ​ពិេសស​ូដូចជា​ Ctrl-Alt-Del "
"ដើម្បី​ភ្ជាប់​ម៉ាសីុន​ពី​ចម្ងាយ ។"

#: krdc.cpp:599
msgid "Advanced"
msgstr "កម្រិត​ខ្ពស់​"

#: main.cpp:45
msgid "Remote desktop connection"
msgstr "កាតតភ្ជាប់​ផ្ទៃតុ​ពីចម្ងាយ"

#: main.cpp:50
msgid "Start in fullscreen mode"
msgstr "របៀប​ចាប់​ផ្តើម​ធ្វើឲ្យ​េពញ​អេក្រង់​"

#: main.cpp:52
msgid "Start in regular window"
msgstr "បង្អួត​ចាប់​ផ្តើម​ទៀង​ទាត់​​"

#: main.cpp:54
msgid "Low quality mode (Tight Encoding, 8 bit color)"
msgstr "របៀប​បញ្ចុះ​គុណភាប​ (អក្សរ​សម្ងាត់​ចង្អៀតពណ៌8 បីត)"

#: main.cpp:56
msgid "Medium quality mode (Tight Encoding, lossy)"
msgstr "របៀប​កំណត់​គុណភាព​នៅ​ពាក់​កណ្តាល​ (បាត់​បង់​អក្សរ​សម្ងាត់​ចង្អៀត)"

#: main.cpp:58
msgid "High quality mode, default (Hextile Encoding)"
msgstr "របៀប​កំណត់​គុណភាព​ខ្ពស់ លំនាំ​ដើម​ (អក្សរ​សម្ងាត់​Hextile)"

#: main.cpp:60
msgid "Start VNC in scaled mode"
msgstr "ចាប់​ផ្តើុម VNC ដែល​បាន​ធ្វើ​មាត្រាដ្ឋាន​"

#: main.cpp:62
msgid "Show local cursor (VNC only)"
msgstr "បង្ហាញ​ទីតាំងទស្សន៍​ទ្រនិច​ (VNC តែប៉ុណ្ណោះ)"

#: main.cpp:64
msgid "Override VNC encoding list (e.g. 'hextile raw')"
msgstr "បដិេសដ​ VNC បញ្ចី​អក្សរ​សម្ងាត់​ (ឧទាហរណ៍. 'hextile raw')"

#: main.cpp:66
msgid "Provide the password in a file"
msgstr "ដាក់​ពាក្យសម្ងាត់​លើឯកសារ"

#: main.cpp:67
msgid "The name of the host, e.g. 'localhost:1'"
msgstr "ឈ្មោះ​ម៉ាសីុន​ ឧទាហរណ៍ 'localhost:1'"

