#: tools/k3bdeviceselectiondialog.cpp:56
msgid "Please select a device:"
msgstr "សូម​ជ្រើស​ឧបករណ៍ ៖ "

#: tools/k3bmd5job.cpp:97
#, c-format
msgid "Could not find file %1"
msgstr "មិន​អាច​រក​ឯកសារ %1 ឃើញ​ទេ"

#: tools/k3bmd5job.cpp:104
#, c-format
msgid "Could not open file %1"
msgstr "មិន​អាច​បើក​ឯកសារ %1 បាន​ទេ"

#: tools/k3bmd5job.cpp:230
#, c-format
msgid "Error while reading from file %1"
msgstr "កំហុស​ក្នុង​ខណៈ​ពេល​កំពុង​អាន​ពី​ឯកសារ %1"

#: tools/k3bstdguiitems.cpp:30
msgid "Simulate"
msgstr "ប្លែង"

#: tools/k3bstdguiitems.cpp:31
msgid ""
"<p>If this option is checked K3b will perform all writing steps with the laser "
"turned off."
"<p>This is useful, for example, to test a higher writing speed or whether your "
"system is able to write on-the-fly."
"<p><b>Caution:</b> DVD+R(W) does not support simulated writing."
msgstr ""
"<p>ប្រសិន​បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ធីក K3b "
"នឹង​ដំណើរ​ការ​ជំហាន​សសេរ​ទាំងអស់​ជាមួយ​កាំ​រស្មី​ដែល​បាន​បិទ ។"
"<p>វា​មាន​ប្រយោជន៍ ជា​ឧទាហរណ៍ "
"ដើម្បី​សាកល្បង​ល្បឿន​ការ​សសេរ​ខ្ពស់​ឬ​ថា​តើ​ប្រព័ន្ធ​របស់​អ្នក​អាច​សសេរ "
"on-the-fly."
"<p><b>ប្រុង​ប្រយ័ត្ន ៖</b> ឌីវីឌី+អាន(សសេរ) "
"មិន​គាំទ្រ​ការ​សសេរ​ដែល​បាន​ប្លែង​ទេ ។"

#: tools/k3bstdguiitems.cpp:36
msgid "Only simulate the writing process"
msgstr "គ្រាន់​តែ​ប្លែង​ដំណើរ​ការ​ការ​សសេរ"

#: tools/k3bstdguiitems.cpp:42
msgid "Disk at once"
msgstr "ថាស​នៅ​ពេល​តែ​ម្ដង"

#: tools/k3bstdguiitems.cpp:43
#, fuzzy
msgid ""
"<p>If this option is checked, K3b will write the CD in 'disk at once' mode as "
"compared to 'track at once' (TAO)."
"<p>It is always recommended to use DAO where possible."
"<p><b>Caution:</b> Track pregaps with a length other than 2 seconds are only "
"supported in DAO mode."
msgstr ""
"<p>ប្រសិន​បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ធីក K3b នឹង​សសេរ​ស៊ីឌី​នៅ​ក្នុង​របៀប "
"'ថាស​នៅ​ពេល​តែ​ម្ដង' ដូច​ដែល​បាន​ប្រៀបធៀប​ទៅ​ 'បទ​នៅ​ពេល​តែ​ម្ដង' (TAO) ."
"<p>វា​ជាធម្មតា​ត្រូវ​បាន​ផ្ដល់​អនុសាសន៍​ឲ្យ​ប្រើ DAO ដែល​អាច​ទៅ​រួច ។"
"<p><b>ប្រុងប្រយ័ត្ន ៖</b> Track pregaps with a length other than 2 seconds are "
"only supported in DAO mode."

#: tools/k3bstdguiitems.cpp:48
msgid "Write in disk at once mode"
msgstr "សសេរ​ក្នុង​ថាស​នៅ​របៀប​តែ​ម្ដង"

#: tools/k3bstdguiitems.cpp:54
msgid "Use Burnfree"
msgstr "ប្រើ​ដុត​ដោយ​សេរី"

#: tools/k3bstdguiitems.cpp:55
msgid "Enable Burnfree (or Just Link) to avoid buffer underruns"
msgstr ""
"បើក​ដុត​ដោយ​សេរី (ឬ​គ្រាន់​តែ​តភ្ជាប់​) ចៀសវៀង​ការ​អស់​សតិ​បណ្ដោះ​អាសន្ន"

#: tools/k3bstdguiitems.cpp:56
#, fuzzy
msgid ""
"<p>If this option is checked, K3b enables <em>Burnfree</em> (or <em>"
"Just Link</em>). This is a feature of the CD writer which avoids buffer "
"underruns."
"<p>Without <em>burnfree</em>, if the writer cannot get any more data a buffer "
"underrun would occurs, since the writer needs a constant stream of data to "
"write the CD."
"<p>With <em>burnfree</em> the writer can <em>mark</em> "
"the current position of the laser and get back to it when the buffer is filled "
"again;but, since this means having little data gaps on the CD, <b>"
"it is highly recommended to always choose an appropriate writing speed to "
"prevent the usage of burnfree, especially for audio CDs</b> "
"(in the worst case one would hear the gap)."
"<p><em>Burnfree</em> was formally known as <em>Burnproof</em> "
"but since it has become part of the MMC standard it was renamed."
msgstr ""
"<p>ប្រសិន​បើ​បាន​ធីក​ជម្រើស​នេះ K3b បើក <em>ដុត​ដោយ​សេរី</em> (ឬ <em>"
"គ្រាន់​តែ​តភ្ជាប់</em>) ។ "
"នេះ​គឺ​ជា​លក្ខណៈ​ពេសេស​នៃ​កម្មវិធី​សសេរ​ស៊ីឌី​ដែល​ចៀសវៀប​ការ​អស់​សតិបណ្ដោះ​អាសន្"
"ន ។"
"<p>ដោយ​គ្មាន <em>ដុត​ដោយ​សេរី</em> "
"ប្រសិន​បើ​កម្មវិធី​មិន​អាច​យក​ទិន្ន័យ​ថែម​ទៀត "
"ការ​អស់​សតិ​បណ្ដោះ​អាសន្ន​និង​កើត​ឡើង "
"ចាប់​តាំងពី​កម្មវិធី​សសេរ​ត្រូវការ​ស្ទ្រីម​ថេរ​នៃ​ទិន្ន័យ​សម្រាប់​សសេរ​ទៅ​ស៊ីឌី "
"។"
"<p>ជាមួយ <em>ដុត​ដោយ​សេរី</em> កម្មវិធី​សសេរ​អាច <em>សម្គាល់</em> "
"ទីតាំង​បច្ចុប្បន្ន​នៃ​កាំ​រស្មី​និង​យក​វា​ទៅ​វិញ​នៅ​ពេល​សតិ​បណ្ដោះ​អាសន្ន​ត្រូវ​"
"បាន​បំពេញ​ម្ដង​ទៀត ៖ ប៉ុន្តែ "
"ចាប់​តាំងពី​មធ្យោបាយ​នេះ​មាន​ចន្លោះ​ទិន្ន័យ​តិច​ទួចsince this means having "
"little data gaps on the CD, <b>it is highly recommended to always choose an "
"appropriate writing speed to prevent the usage of burnfree, especially for "
"audio CDs</b> (in the worst case one would hear the gap)."
"<p><em>Burnfree</em> was formally known as <em>Burnproof</em> "
"but since it has become part of the MMC standard it was renamed."

#: tools/k3bstdguiitems.cpp:75
msgid "Only create image"
msgstr "បង្កើត​តែ​រូបភាព"

#: tools/k3bstdguiitems.cpp:76
msgid ""
"<p>If this option is checked, K3b will only create an image and not do any "
"actual writing."
"<p>The image can later be written to a CD/DVD with most current writing "
"programs (including K3b of course)."
msgstr ""
"<p>ប្រសិន​បើ​ធីក​ជម្រើស​នេះ K3b "
"នឹង​បង្កើត​តែ​រូបភាព​និង​មិន​ធ្វើ​ការ​សសេរ​ជាក់ស្ដែង​ណា​ទេ ។"
"<p>រូបភាព​អាច​ត្រូវ​បាន​សសេរ​នៅ​ពេល​ក្រោយ​ទៅ​កាន់ ស៊ីឌី/ឌីវីឌី "
"ជាមួយ​និង​កម្មវិធី​សសេរ​ថ្មីៗ (រូម​បញ្ចូល​ទាំង K3b) ។"

#: tools/k3bstdguiitems.cpp:80
msgid "Only create an image"
msgstr "បង្កើត​តែ​រូបភាព"

#: tools/k3bstdguiitems.cpp:86
msgid "Remove image"
msgstr "យក​រូបភាព​ចេញ"

#: tools/k3bstdguiitems.cpp:87
msgid ""
"<p>If this option is checked, K3b will remove any created images after the "
"writing has finished."
"<p>Uncheck this if you want to keep the images."
msgstr ""
"<p>ប្រសិន​បើ​ធីក​ជម្រើស​នេះ K3b "
"នឹង​យក​រូបភាព​ដែល​បាន​បង្កើត​ចេញ​បន្ទាប់​ពី​ការ​សសេរ​បាន​បញ្ចប់"
"<p>កុំ​ធីក​វា​ប្រសិន​បើ​អ្នក​ចង់​រក្សា​រូបភាព ។"

#: tools/k3bstdguiitems.cpp:90
msgid "Remove images from disk when finished"
msgstr "យក​រូបភាព​ចេញ​ពី​ថាស​នៅ​ពេល​ចប់"

#: tools/k3bstdguiitems.cpp:96
#, fuzzy
msgid "On the fly"
msgstr "On the fly"

#: tools/k3bstdguiitems.cpp:97
msgid ""
"<p>If this option is checked, K3b will not create an image first but write the "
"files directly to the CD/DVD."
"<p><b>Caution:</b> Although this should work on most systems, make sure the "
"data is sent to the writer fast enough."
msgstr ""
"<p>ប្រសិន​បើ​ធីក​ជម្រើស​នេះ K3b "
"នឹង​មិន​បង្កើត​រូបភាព​ដំបូង​ទេ​ប៉ុន្តែ​សសេរ​ឯកសារ​ដោយ​ផ្ទាល់​ទៅ​កាន់  "
"ស៊ីឌី/ឌីវីឌី ។"
"<p><b>ប្រុងប្រយ័ត្ន ៖</b> ទោះបី​ជា​វា​គួរ​ធ្វើការ​នៅ​លើ​ប្រព័ន្ធ​ភាគ​ច្រើន "
"សូម​ប្រាកដ​ថា​ទិន្ន័យ​បាន​បញ្ជូន​លឿន​ល្មម​ទៅ​កាន់​ឧបករណ៍​សសេរ ។"

#: tools/k3bstdguiitems.cpp:101
msgid "<p>It is recommended to try a simulation first."
msgstr "<p>វា​ត្រូវ​បាន​ផ្ដល់​អនុសាសន៍​ឲ្យ​ព្យាយាម​ការ​ប្លែង​ជា​ដំបូង ។"

#: tools/k3bstdguiitems.cpp:102
msgid "Write files directly to CD/DVD without creating an image"
msgstr "សសេរ​ឯកសារ​ផ្ទាល់​ទៅ​កាន់ ស៊ីឌី/ឌីវីឌី ដោយ​មិន​បង្កើត​រូបភាព"

#: tools/k3bstdguiitems.cpp:108
msgid "Write CD-TEXT"
msgstr "សសេរ​អត្ថបទ​ស៊ីឌី"

#: tools/k3bstdguiitems.cpp:109
msgid "Create CD-TEXT entries"
msgstr "សសេរ​ធាតុអត្ថបទ​ស៊ីឌី"

#: tools/k3bstdguiitems.cpp:110
msgid ""
"<p>If this option is checked K3b uses some otherwise-unused space on the audio "
"CD to store additional information, like the artist or the CD title."
"<p>CD-TEXT is an extension to the audio CD standard introduced by Sony."
"<p>CD-TEXT will only be usable on CD players that support this extension "
"(mostly car CD players)."
"<p>Since a CD-TEXT-enhanced CDs will work in any CD player it is never a bad "
"idea to enable this (if you specify CD-TEXT data)."
msgstr ""
"<p>ប្រសិន​បើ​ធីក​ជម្រើស​នេះ K3b "
"ប្រើ​ទំហំ​ដែល​មិន​ប្រើ​នៅ​លើ​ស៊ីឌី​អូឌីយ៉ូ​ដើម្បី​រក្សា​ព័ត៌មាន​បន្ថែម "
"ដូចជា​សិល្បករ​ឬ​ចំណង​ជើង​ស៊ីឌី ។"
"<p>អត្ថបទ​ស៊ីឌី​គឺ​ជា​ផ្នែក​បន្ថែម​ទៅ​ខ្នាត​គម្រូ​ស៊ីឌី​អូឌីយ៉ូ​ដែល​បាន​ណែនាំ​ដោ"
"យSony ។"
"<p>អត្ថបទ​ស៊ីឌី​នឹង​អាច​ប្រើ​បាន​នៅ​លើ​កម្មវិធី​ចាក់​ចម្រៀង​ដែល​គាំទ្រ​ផ្នែកបន្ថ"
"ែម​នេះ (​ភាគ​ច្រើន​ឧបករណ៍​ចាក់​ស៊ីឌី​ក្នុង​រថយន្ដ) ។"
"<p>ចាប់តាំង​ពីរ​អត្ថបទ​ស៊ីឌី​ដែល​បាន​ធ្វើ​ឲ្យ​ប្រសើរ​នឹង​ធ្វើ​ការ​ក្នុង​កម្មវិធី"
"​ចាក់​ចម្រៀង​ជាច្រើន​វា​មិន​ដែល​ជា​គំនិត​អាក្រក់​ក្នុង​ការ​បើក​វា​ទេ "
"(ប្រសិន​បើ​អ្នក​បញ្ជាក់​ទិន្ន័យ​អត្ថបទ​ស៊ីឌី) ។"

#: tools/k3bstdguiitems.cpp:129
msgid "Set the paranoia level for reading audio CDs"
msgstr "កំណត់​កម្រិត​ឆ្គួត​សម្រាប់​អាន​ស៊ីឌី​អូឌីយ៉ូ​"

#: tools/k3bstdguiitems.cpp:130
msgid ""
"<p>Sets the correction mode for digital audio extraction."
"<ul>"
"<li>0: No checking, data is copied directly from the drive. "
"<li>1: Perform overlapped reading to avoid jitter.</li>"
"<li>2: Like 1 but with additional checks of the read audio data.</li>"
"<li>3: Like 2 but with additional scratch detection and repair.</li></ul>"
"<p><b>The extraction speed reduces from 0 to 3.</b>"
msgstr ""
"<p>កំណត់​របៀប​កែ​សម្រាប់​ការ​ដក​អូឌីយ៉ូ​ឌីជីថល ។"
"<ul>"
"<li>0 ៖ មិន​ត្រួតពិនិត្យ ទិន្ន័យ​ត្រូវ​បាន​ចម្លង​ដោយ​ផ្ទាល់​ពី​ដ្រាយ ។ "
"<li>1 ៖ ដំណើរ​ការ​ការ​អាន​ដែល​ត្រួត​ដើម្បី​ចៀសវៀង​ការ​នៅ​មិន​ស្ងៀម ។</li>"
"<li>2៖ ដូច​ទី 1 "
"ប៉ុន្តែ​ជាមួយ​ការពិនិត្យ​បន្ថែម​នៃ​ការ​អាន​ទិន្ន័យ​អូឌីយ៉ូ ។</li>"
"<li>3 ៖ ដូច​ទី 2 ប៉ុន្តែ​ជាមួយ​ការ​រក​ឃើញ​​ខ្វាច​និង​ជួសជុល ។</li></ul>"
"<p><b>ល្បឿន​ការ​ដក​កាត់​បន្ថយ​ពី 0 ទៅ 3 ។</b>"

#: tools/k3bstdguiitems.cpp:142
msgid "Start multisession CD"
msgstr "ចាប់​ផ្ដើម​ស៊ីឌី​ពហុ​សម័យ"

#: tools/k3bstdguiitems.cpp:143
msgid "Do not close the disk to allow additional sessions to be added later"
msgstr "កុំ​បិទ​ថាស​ដើម្បី​អនុញ្ញាត​សម័យ​បន្ថែម​ត្រូវ​បាន​បន្ថែម​នៅ​ពេល​ក្រោយ"

#: tools/k3bstdguiitems.cpp:144
msgid ""
"<p>If this option is checked K3b will not close the CD, and will write a "
"temporary table of contents.</p>"
"<p>This allows further sessions to be appended to the CD later.</p>"
msgstr ""
"<p>ប្រសិន​បើ​ធីក​ជម្រើស​នេះ K3b នឹង​មិន​បិទ​ស៊ីឌី​ទេ "
"និង​នឹង​សសេរ​តារាង​បណ្ដោះ​អាសន្ន​នៃ​មាតិកា ។</p>"
