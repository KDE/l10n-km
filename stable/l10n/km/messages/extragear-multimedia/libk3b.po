#: projects/k3bgrowisofshandler.cpp:166
msgid "Writing mode Incremental Streaming not available"
msgstr "របៀប​សរសេរ​​ដោយ​​មាន​ស្ទ្រីម​ដែល​បាន​បង្កើន​មិន​អាច​ប្រើបាន"

#: projects/k3bgrowisofshandler.cpp:167
msgid "Engaging DAO"
