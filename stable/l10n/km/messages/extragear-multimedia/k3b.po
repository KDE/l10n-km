msgstr ""
"<p><b>ស្តង់ដា​​របៀប​លាយ​ស៊ីឌី​ ១</b><p>K3b នឹង​សរសេរ​បទ​"
"ទិន្នន័យ​​មុន​នឹង​សរសេរ​បទ​អូឌីយ៉ូ​ ។<p>របៀប​នេះ​ត្រូវបាន​តែ​ប្រើ​សម្រាប់​ស៊ីឌី​​ ដែល​ទំនង​ជា​ត្រូវ​បាន​ចាក់​​លើ​កម្មវិធី​ចាក់ស៊ីឌី​អូឌីយ៉ូ​​ hifi ។<p><b>ការប្រយ័ត្ន​ប្រយែង​ ៖</b> វា​មិន​អាច​ដឹកនាំ​បញ្ហា​ជាមួយ​កម្មវិធី​ចាក់​ស៊ីឌី​អូឌីយ៉ូ​ hifi ចាស់ៗ​មួយ​ចំនួយ​ដែល​វា​ព្យាយាម​ចាក់​បទ​ទិន្ន័យ​ ។"

#: projects/k3bmixedburndialog.cpp:157
msgid "Last track will contain the data"
msgstr "បទ​ចុងក្រោយ​នឹង​មាន​ទិន្នន័យ​"

#: projects/k3bmixedburndialog.cpp:158
msgid ""
"<p><b>Standard mixed mode CD 2</b><p>K3b will write the data track after all "
"audio tracks.<p>This mode should only be used for CDs that are unlikely to "
"be played on a hifi audio CD player.<p><b>Caution:</b> It could lead to "
"problems with some older hifi audio CD players that try to play the data "
"track."
msgstr ""
"<p><b>ស្តង់ដា​​របៀប​លាយ​ស៊ីឌី​ ២</b><p>K3b នឹង​សរសេរ​បទ​"
"ទិន្នន័យ​​មុន​នឹង​សរសេរ​បទ​អូឌីយ៉ូ​ ។"
"<p>របៀប​នេះ​ត្រូវបាន​តែ​ប្រើ​សម្រាប់​ស៊ីឌី​​ ដែល​ទំនង​ជា​ត្រូវ​បាន​ចាក់​​លើ​កម្មវិធី​ចាក់ស៊ីឌី​អូឌីយ៉ូ​​ hifi ។<p><b>ការ​ប្រយ័ត្ន​ប្រយែង​ ៖</b> វា​មិន​អាច​ដឹកនាំ​បញ្ហា​ជាមួយ​កម្មវិធី​ចាក់​ស៊ីឌី​អូឌីយ៉ូ​ hifi ចាស់ៗ​មួយ​ចំនួយ​ដែល​វា​ព្យាយាម​ចាក់​បទ​ទិន្ន័យ​ ។"

#: projects/k3bmixedburndialog.cpp:166
msgid "The data will be written in a second session"
msgstr "ទិន្នន័យ​នឹង​ត្រូវ​បាន​សរសេរ​ក្នុង​សម័យ​ទីពីរ"

#: projects/k3bmixedburndialog.cpp:167
msgid ""
"<p><b>Blue book CD</b><p>K3b will create a multisession CD with 2 sessions. "
"The first session will contain all audio tracks and the second session will "
"contain a mode 2 form 1 data track.<p>This mode is based on the <em>Blue "
"book</em> standard (also known as <em>Extended Audio CD</em>, "
"<em>CD-Extra</em>, or <em>CD Plus</em>) and has the advantage that a hifi "
"audio CD player will only recognize the first session and ignore the second "
"session with the data track.<p>If the CD is intended to be used in a hifi "
"audio CD player this is the recommended mode.<p>Some older CD-ROMs may have "
"problems reading a blue book CD since it is a multisession CD."
msgstr ""
"<p><b>សៀវភៅ​ស៊ីឌី​ពណ៌​ខៀវ​</b><p>K3b នឹង​បង្កើត​ស៊ីឌី​សម័យ​ច្រើន​ជាមួយ​ ២ សម័យ​ ។សម័យ​ដំបូង​នឹង​មាន​គ្រាប់​បទ​អូឌីយ៉ូ​ហើយ សម័យ​ទីពីរ​និង​មាន​របៀប​២ ពី​ជុំ​ទិន្នន័យ​១  ។<p>របៀប​នេះគឺ​​ពឹង​ផ្នែក​លើ​ <em>សៀវភៅ​ខៀវ​</em> ស្តង់ដារ​ (ស្គាល់​ផងដែរ​ <em>បាន​ពង្រី​ស៊ីឌី​អីឌីយ៉ូ​</em>, "
"<em>ស៊ីឌី​ខាងក្រៅ​</em>, ឬ <em>ស៊ីឌី​បន្ថែម​</em>) ហើយ​មាន​ផល​ប្រយោជន៍​ដែល​កម្មវិធី​ចាក់​ស៊ីឌី​អូឌីយ៉ូ​ hifi នឹង​បានតែ​រៀប​ចំ​សម័យ​ដំបូង​និង មិន​អើពើ​សម័យ​ទីពីរ​ជាមួយ​ជុំ​ទិន្នន័យ​​។<p>បើ​ស៊ីឌី​ត្រូវ​បាន​បម្រុង​ប្រើ​ក្នុងកម្មវីធីចាក់​ស៊ីឌី​អូឌីយ៉ូ​​ hifi  នេះ​ជារបៀប​បាន​ផ្តល់​អនុសាសន៍​​ ។<p> "
"ស៊ីឌី-រ៉ូម​ចាស់ៗ​មួយ​ចំនួន​ប្រហែល​ជាមាន​បញ្ហា​ក្នុងការ​អាន​សៀវភៅ​ស៊ីឌី​ខៀវ  ចាប់​តាំងពី​វា​ជា​ស៊ីឌី​សម័យច្រើន​ ។"

#: projects/k3bdvdburndialog.cpp:54
msgid "DVD Project"
msgstr "គម្រោង​ឌីវីឌី "

#: projects/k3bdvdburndialog.cpp:111
msgid ""
"<p>For DVD-R(W) in sequential incremental mode and DVD+R it behaves like "
"multisession CDs.<br> <b>Caution:</b> Most DVD-ROM drives are only able to "
"read the first session and most likely even on DVD writers only the first "
"session will be mounted.</p><p>For DVD+RW and DVD-RW in restricted overwrite "
"mode K3b will utilize growisofs to <em>grow</em> the ISO9660 filesystem in "
"the first session.</p><p><b>Be aware that K3b needs to write multisession "
"DVDs on-the-fly.</b>"
msgstr ""

#: projects/k3bdvdburndialog.cpp:183
msgid ""
"It is not possible to write multisession DVDs in DAO mode.Multisession has "
"been disabled."
msgstr "វា​មិន​អាច​ទៅ​រួច​ទេ​សម្រាប់​​សរសេរសម័យ​ឌីវីឌីច្រើន​ ក្នុង​របៀប​ DAO  ។ សម័យ​ច្រើន​មិន​អាច​រក​បាន​ ។"

#: projects/k3bdvdburndialog.cpp:185
msgid "DVD multisession"
msgstr "ឌីវីឌី​សម័យ​ច្រើន​"

#: projects/k3bdvdburndialog.cpp:208
msgid ""
"K3b does only support writing multisession DVDs on-the-fly. Multisession has "
"been disabled."
msgstr ""
"K3b ពិត​ជា​​​គាំទ្រ​ការ​សរសេរ​ឌីវីឌី​​សម័យ​ច្រើលើ​ខ្យល់​ ។ "
"សម័យ​ច្រើន​ដែល​មិន​អាច​រក​បាន​ ។."

#: projects/k3bdvdburndialog.cpp:210
msgid "DVD Multisession"
msgstr "ឌីវីឌី​សម័យ​ច្រើន​"

