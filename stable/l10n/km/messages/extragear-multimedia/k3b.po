msgstr ""
"តើ​អ្នក​ចង់​បន្ថែម​ឯកសារ​ប្រព័ន្ធ​(FIFOs, រន្ធ​, ឯកសារ​ឧបករណ៍​, "
"ហើយ​ត្រូវ​បាន​បែក​បាក់ symlinks)ឬ ?"

#: projects/k3bdataurladdingdialog.cpp:387
msgid "System Files"
msgstr " ឯកសារប្រព័ន្ធ"

#: projects/k3bdatamultisessioncombobox.cpp:38
msgid "Select the Multisession Mode for the project."
msgstr "ជ្រើស​របៀប​សម័យ​ច្រើន​សម្រាប់​គម្រោង​​។"

#: projects/k3bdatamultisessioncombobox.cpp:39
msgid ""
"<p><b>Multisession Mode</b><p><b>Auto</b><br>Let K3b decide which mode to "
"use. The decision will be based on the size of the project (does it fill the "
"whole media) and the state of the inserted media (appendable or "
"not).<p><b>No Multisession</b><br>Create a single-session CD or DVD and "
"close the disk.<p><b>Start Multisession</b><br>Start a multisession CD or "
"DVD, not closing the disk to allow further sessions to be "
"apppended.<p><b>Continue Multisession</b><br>Continue an appendable data CD "
"(as for example created in <em>Start Multisession</em> mode) and add another "
"session without closing the disk to allow further sessions to be "
"apppended.<p><b>Finish Multisession</b><br>Continue an appendable data CD "
"(as for example created in <em>Start Multisession</em> mode), add another "
"session, and close the disk."
msgstr "<p><b>របៀបសម័យច្រើន</b><p><b>ស្វ័យប្រវត្តិ</b><br>ទុក​ឲ្យ K3b សម្រេច​ថា​ត្រូវ​ប្រើ​របៀប​ណា​មួយ ។ ការ​សម្រេច​ត្រូវ​បាន​ធ្វើ​ដោយ​ផ្អែក​លើ​ទំហំ​របស់​គម្រោង (ថា​តើ​វា​នឹង​ពេញ​មេឌៀ​ទាំងមូល​ឬ​ទេ) និង សភាព​របស់​មេឌៀ​ដែល​បាន​បញ្ចូល (អាច​បន្ថែម​បាន​ឬ​ក៏​អត់) ។<p><b>គ្មានសម័យច្រើន</b><br>បង្កើត​ស៊ីឌី ឬ ឌីវីឌី​សម័យ​តែ​មួយ ហើយ​បិទ​ថាស​ចោល ។<p><b>ចាប់ផ្ដើមសម័យច្រើន</b><br>ចាប់ផ្ដើម​ស៊ីឌី ឬ ឌីវីឌី​សម័យ​ច្រើន ដោយ​មិន​បិទ​ថាស​ឡើយ ដូច្នេះ​យើង​អាច​បន្ថែម​សម័យ​ទៀត​បាន ។<p><b>បន្តសម័យច្រើន</b><br>បន្ត​ស៊ីឌី​ទិន្នន័យ​ដែល​អាច​បន្ថែម​ទៀត​បាន (ឧទាហរណ៍ ស៊ីឌី​ដែល​បាន​បង្កើត​នៅ​ក្នុង​របៀប <em>ចាប់ផ្ដើមសម័យច្រើន</em>) ហើយ​បន្ថែម​សម័យ​មួយ​ទៀត ដោយ​មិន​បិទ​ថាស​ឡើយ ដូច្នេះ​យើង​អាច​បន្ថែម​សម័យ​ទៀត​បាន ។<p><b>បញ្ចប់សម័យច្រើន</b><br>បន្ត​ស៊ីឌី​ទិន្នន័យ​ដែល​អាច​បន្ថែម​ទៀត​បាន (ឧទាហរណ៍ ស៊ីឌី​ដែល​បាន​បង្កើត​នៅ​ក្នុង​របៀប <em>ចាប់ផ្ដើមសម័យច្រើន</em>) ហើយ​បន្ថែម​សម័យ​មួយ​ទៀត រួច​បិទ​ស៊ីឌី​ចោល​តែ​ម្ដង ។"

