msgstr "បន្ថែម តំណនិមិត្តសញ្ញា​ទៅ​កាន់​គម្រោង​"

#: projects/k3bdataurladdingdialog.cpp:342
msgid "Enter New Filename"
msgstr "បញ្ចូលឈ្មោះ​ឯកសារថ្មី​"

#: projects/k3bdataurladdingdialog.cpp:343
msgid "A file with that name already exists. Please enter a new name:"
msgstr "ឯកសារ​​មាន​ឈ្មោះ​រួច​ហើយយ​ ។ សូមបញ្ចូល​ឈ្មោះ​ថ្មី ៖"

#: projects/k3bdataurladdingdialog.cpp:364
