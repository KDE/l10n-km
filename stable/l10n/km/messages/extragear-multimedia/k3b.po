#: k3bwriterselectionwidget.cpp:63
msgid "Burning Device"
msgstr "ឧបករណ៍​ដុត"

#: k3bwriterselectionwidget.cpp:74
msgid "Speed:"
msgstr "ល្បឿន ៖"

#: k3bwriterselectionwidget.cpp:85
msgid "Writing app:"
msgstr "កម្មវិធី​សរសេរ ៖"

#: k3bwriterselectionwidget.cpp:115
msgid "Determine supported writing speeds"
msgstr "កំណត់​ល្បឿន​សរសេរ​ដែល​គាំទ្រ​"

#: k3bwriterselectionwidget.cpp:116
msgid ""
"<p>Normally K3b presents static list of writing speeds that is only based on "
"the maximum writing speed of the device.<p>If this button is clicked K3b "
"tries to determine the writing speeds supported with the mounted media.<p>Be "
"aware that this only works with MMC3 compliant writers."
msgstr "<p>ជាធម្មតា K3b នឹង​បង្ហាញ​បញ្ជី​ល្បឿន​សរសេរ​ថេរ​មួយ ដែល​បញ្ជី​នោះ​ត្រូវ​បាន​ផ្អែក​លើ​តែ​ល្បឿន​សរសេរ​អតិបរមា​របស់​ឧបករណ៍​ប៉ុណ្ណោះ ។<p>បើ​អ្នក​ចុច​ប៊ូតុង​នេះ K3b នឹង​ព្យាយាម​កំណត់​ល្បឿន​សរសេរ​ដែល​គាំទ្រ​ដោយ​មេឌៀ​ដែល​បាន​ម៉ោន ។<p>អ្នក​ត្រូវ​ដឹង​ថា ករណី​នេះ​ដំណើរការ​តែ​ជាមួយ​ក្បាល​អាន​ដែល​អនុលោម​តាម MMC3 ប៉ុណ្ណោះ ។"

#: k3bwriterselectionwidget.cpp:181
msgid "The DVD writer that will write the DVD"
msgstr "កម្មវិធី​ឌីវីឌី​ដែល​និង​សរសេរ​ឌីវីឌី​"

#: k3bwriterselectionwidget.cpp:182
msgid "The speed at which to write the DVD"
msgstr "ល្បឿន​ពេល​សរសេរ​ឌីវីឌី"

#: k3bwriterselectionwidget.cpp:183
msgid "The external application to actually write the DVD"
msgstr "កម្មវិធី​ខាងក្រៅ​សម្រាប់​សរសេរ​ឌីវីឌី​ពិត​"

#: k3bwriterselectionwidget.cpp:186
msgid "The CD writer that will write the CD"
msgstr "កម្មវិឌី​សរសេរ​ស៊ីឌី​ដែល​និង​សរសេរ​ស៊ីឌី​"

#: k3bwriterselectionwidget.cpp:187
msgid "The speed at which to write the CD"
msgstr "ល្បឿន​​ពេលសរសេរ​ស៊ីឌី​"

#: k3bwriterselectionwidget.cpp:188
msgid "The external application to actually write the CD"
msgstr "កម្មវិធី​ខាង​ក្រៅ​សម្រាប់​សរសេរ​ស៊ីឌី​ពិត​"

#: k3bwriterselectionwidget.cpp:198
msgid ""
"<p>Select the DVD writer that you want to use.<p>In most cases there will "
"only be one writer available which does not leave much choice."
msgstr "<p>ជ្រើស​កម្មវិធី​ឌីវីឌី​ដែល​អ្នក​ចង់​ប្រើ ។<p>ក្នុង​ករណី​ជាច្រើន​វា​ជាកម្មវិធីមួយ​​ដែល​អាចរក​បាន​ មិន​ចាកចេញ​ជម្រើស​ច្រើន​ ។"

#: k3bwriterselectionwidget.cpp:201
msgid ""
"<p>Select the speed with which you want the writer to "
"burn.<p><b>Auto</b><br>This will choose the maximum writing speed possible "
"with the used medium. This is the recommended selection for most "
"media.</p><p><b>Ignore</b><br>This will leave the speed selection to the "
"writer device. Use this if K3b is unable to set the writing speed.<p>1x "
"refers to 1385 KB/s.</p>"
msgstr ""
"<p>ជ្រើស​ល្បឿន​ដែល​អ្នក​ចង់​ដុត​កម្មវិធី​សរសេរ​<p><b>Auto</b> "
"<br>កា​រនេះ​នឹង​ជ្រើស​ល្បឿនទំនង​ជា​​ការ​សរសេរ​អតិបរមា​ជាមួយ​ឧបករណ៍​ដែល​ត្រូវ​បាន​ប្រើ  ។ នេះ​ជា​អនុសាសន៍​ការជ្រើស​សម្រាប់​មេឌៀ​ជាច្រើន​ ។"
"</p><p><b>Ignore</b><br>នេះ​នឹង​ចាកចេញ​ពី​ការ​ជ្រើស​ល្បឿន​សម្រាប់​ឧបករណ៍​កម្មវិធី​សរសេរ ។ ប្រើ​វា​នេះ​បើ​ K3b គឺ​មិន​អាច​កំណត់​ល្បឿន​ការ​សរសេរ​ ។<p>1x អាស្រ័យ​លើ​​ 1385 KB/s.</p>"

#: k3bwriterselectionwidget.cpp:212
msgid ""
"<p>Select the CD writer that you want to use.<p>In most cases there will "
"only be one writer available which does not leave much choice."
msgstr "<p>ជ្រើស​ការសរសេរ​ស៊ីឌី​ដែល​អ្នក​ចង់​ប្រើ​ ។<p>ក្នុង​ករណី​ជាច្រើន​វា​ជាកម្មវិធីមួយ​​ដែល​អាចរក​បាន​ មិន​ចាកចេញ​ជម្រើស​ច្រើន​ ។"

#: k3bwriterselectionwidget.cpp:215
msgid ""
"<p>Select the speed with which you want the writer to "
"burn.<p><b>Auto</b><br>This will choose the maximum writing speed possible "
"with the used medium. Be aware that this might not be a good choice when "
"writing an Audio-CD on-the-fly since the decoding of the audio files may "
"take too long to allow a continuous data stream.<p>1x refers to 175 "
"KB/s.<p><b>Caution:</b> Make sure your system is able to send the data fast "
"enough to prevent buffer underruns."
msgstr "<p>ជ្រើស​ល្បឿន​ដែល​អ្នក​ចង់​សរសេរ​​កម្មវិធី​សរសេរ​ដើម្បី​ដុត​ ។<p><b>Auto</b><br>កា​រនេះ​នឹង​ជ្រើស​ល្បឿនទំនង​ជា​​ការ​សរសេរ​អតិបរមា​ជាមួយ​ឧបករណ៍​ដែល​ត្រូវ​បាន​ប្រើ ។  Be aware that នេះ​ប្រហែល​ជា​មិន​មែន​ជាជម្រើស​ល្អ​ពេល​​កំពុង​សរសេរ​ស៊ីឌី​អូឌីយ៉ូ​ on-the-fly ចាប់​ផ្តើម​ឌីកូដ​នៃ​ឯកសារ​អូឌីយ៉ូ​វា​ចំណាយ​ពេល​វែង​ដើម្បី​អនុញ្ញាត​បន្ត​ស្ទ្រីម​ទិន្នន័យ​ ។<p>1x យោង​ទៅ​តាម​ 175 KB/s ។ <p><b>ការ​ប្រយ័ត្នប្រយែង​ ៖</b> សូម​ឲ្យ​ប្រាកដ​ថា​ប្រព័ន្ធ​របស់​អ្នក​គឺ​អាច​ផ្ញើ​ទិន្នន័យគ្រប់គ្រាន់​លឿន​ដើម្បី​ការ​ពារ​សតិ​បណ្តោះអាសន្ន​រត់​ខាង​ក្រោម​ ។"

#: k3bwriterselectionwidget.cpp:225
msgid ""
"<p>K3b uses the command line tools cdrecord, growisofs, and cdrdao to "
"actually write a CD or DVD.<p>Normally K3b chooses the best suited "
"application for every task automatically but in some cases it may be "
"possible that one of the applications does not work as intended with a "
"certain writer. In this case one may select the application manually."
msgstr ""
"<p>K3b ប្រើឧបករណ៍​​បន្ទាត់​បញ្ជា​ cdrecord, growisofs, and cdrdao to "
"ពិតជា​សរសេរ​ស៊ីឌី ឬ ឌីវីឌី ។ <p>ជាទូទៅ​ K3b ជ្រើស​កម្មវិធី​ល្អ​បំផុត​សម្រាប់​ការងា​នីមួយ​ដោយ​ស្វ័យប្រវត្តិ​ ប៉ុន្តែ​ករណី​ខ្លះ​វា​ប្រហែល​ទំនង​ជា​កម្មវីធីមួយ​ដែល​មិន​ធ្វើ​ការបម្រុង​ជាមួយ​​កម្មវីធី​សរសេរ​ពិត​ ។​​ក្នុង​ករណី​ទី​មួយ​ប្រហែល​ជា​ជ្រើស​កម្មវិធី​ដោយ​ដៃ ​។"

