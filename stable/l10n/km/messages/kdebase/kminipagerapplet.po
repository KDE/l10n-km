msgid ""
"_: one row or column\n"
"&1"
msgstr "&1"

#: pagerapplet.cpp:652
msgid ""
"_: two rows or columns\n"
"&2"
msgstr "&2"

#: pagerapplet.cpp:653
msgid ""
"_: three rows or columns\n"
"&3"
msgstr "&3"

#: pagerapplet.cpp:655
msgid "&Rows"
msgstr "ជួរ​ដេក"

#: pagerapplet.cpp:656
msgid "&Columns"
msgstr "ជួរ​ឈរ"

#: pagerapplet.cpp:659
msgid "&Window Thumbnails"
msgstr "រូបភាព​តូចរបស់បង្អួច"

#: pagerapplet.cpp:660
msgid "&Window Icons"
msgstr "រូប​តំណាង​បង្អួច"

#: pagerapplet.cpp:662
msgid "Text Label"
msgstr "ស្លាក​អត្ថបទ"

#: pagerapplet.cpp:663
msgid "Desktop N&umber"
msgstr "លេខ​ផ្ទៃ​តុ"

#: pagerapplet.cpp:665
msgid "Desktop N&ame"
msgstr "ឈ្មោះ​ផ្ទៃ​តុ"

#: pagerapplet.cpp:667
msgid "N&o Label"
msgstr "គ្មាន​ស្លាក"

#: pagerapplet.cpp:670
msgid "Background"
msgstr "ផ្ទៃ​ខាង​ក្រោយ"

#: pagerapplet.cpp:671
msgid "&Elegant"
msgstr "ប្រណិត"

#: pagerapplet.cpp:673
msgid "&Transparent"
msgstr "ថ្លា"

#: pagerapplet.cpp:675
msgid "&Desktop Wallpaper"
msgstr "ក្រដាស​បិទជញ្ជាំង​របស់​ផ្ទៃតុ"

#: pagerapplet.cpp:678
msgid "&Pager Options"
msgstr "ជម្រើស​ភេកយ័រ"

#: pagerapplet.cpp:681
msgid "&Configure Desktops..."
msgstr "កំណត់​រចនា​សម្ព័ន្ធ​ផ្ទៃ​តុ..."

#: pagerbutton.cpp:753
#, c-format
msgid ""
"_n: and 1 other\n"
"and %n others"
msgstr "និង %n ផ្សេងទៀត"

#: pagerbutton.cpp:761
#, c-format
msgid ""
"_n: One window:\n"
"%n windows:"
msgstr "បង្អួច %n ៖"

