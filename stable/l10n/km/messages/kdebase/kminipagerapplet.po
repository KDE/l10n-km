#: pagerapplet.cpp:637
msgid "&Launch Pager"
msgstr "បើក​ភេកយ័រ"

#: pagerapplet.cpp:640
msgid "&Rename Desktop \"%1\""
msgstr "ប្ដូរ​ឈ្មោះ​ផ្ទៃ​តុ \"%1\""

#: pagerapplet.cpp:646
msgid "Pager Layout"
msgstr "ប្លង់​ភេកយ័រ"

#: pagerapplet.cpp:650
msgid "&Automatic"
msgstr "ស្វ័យប្រវត្តិ"

