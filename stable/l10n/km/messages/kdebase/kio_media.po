msgid "media:/ URL to mount/unmount/eject/remove"
msgstr "ឧបករណ៍​ផ្ទុក ៖/ URL ដែល​ត្រូវម៉ោន/អាន់ម៉ោន/​ច្រាន​ចោល/​យកចេញ"
