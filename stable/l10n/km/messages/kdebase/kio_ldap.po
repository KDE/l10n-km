#: kio_ldap.cpp:86
msgid ""
"\n"
"Additional info: "
msgstr ""
"\n"
"ព័ត៌មាន​បន្ថែម ៖"

#: kio_ldap.cpp:159
msgid ""
"LDAP server returned the error: %1 %2\n"
"The LDAP URL was: %3"
msgstr ""
"ម៉ាស៊ីន​បម្រើ LDAP បាន​ត្រឡប់​កំហុស ៖ %1 %2\n"
"URL របស់ LDAP គឺ ៖ %3"

#: kio_ldap.cpp:520
msgid "LDAP Login"
msgstr "ការ​ចូល​ទៅ​កាន់​ LDAP"

#: kio_ldap.cpp:523
msgid "site:"
msgstr "តំបន់ ៖"

#: kio_ldap.cpp:550 kio_ldap.cpp:685
msgid "Invalid authorization information."
msgstr "ព័ត៌មាន​អំពី​ការ​អនុញ្ញាត​មិន​ត្រឹមត្រូវ ។"

#: kio_ldap.cpp:628
#, c-format
msgid "Cannot set LDAP protocol version %1"
msgstr "មិន​អាច​កំណត់​កំណែ​ពិធីការ​របស់ LDAP %1"

#: kio_ldap.cpp:645
msgid "Cannot set size limit."
msgstr "មិន​អាច​កំណត់​តម្លៃ​អតិបរមា​របស់​ទំហំ ។"

#: kio_ldap.cpp:655
msgid "Cannot set time limit."
msgstr "មិន​អាច​កំណត់​តម្លៃ​អតិបរមា​របស់​ពេលវេលា ។"

#: kio_ldap.cpp:664
msgid "SASL authentication not compiled into the ldap ioslave."
msgstr ""
"ការ​​ផ្ទៀង​ផ្ទាត់​ភាព​ត្រឹម​ត្រូវ​របស់ SASL មិន​បាន​ចង​ក្រង​ទៅ​ក្នុង ldap "
"ioslave ។"

#: kio_ldap.cpp:941 kio_ldap.cpp:1022
msgid "The LDIF parser failed."
msgstr "ឧបករណ៍​ញែក LDIF បាន​បរាជ័យ ។"

#: kio_ldap.cpp:1032
#, c-format
msgid "Invalid LDIF file in line %1."
msgstr "ឯកសារ​ LDIF មិន​ត្រឹម​ត្រូវ​នៅ​ជួរ​ទី %1 ។"
