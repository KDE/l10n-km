"តាម​លំនាំដើម​ជួរដេក​មួយ​ត្រូវ​បាន​ពិចារណា​ជា​សំណុំ​ទិន្នន័យ "
"និង​ជួរឈរ​នីមួយៗ​មាន​តម្លៃ​ផ្សេងៗ​គ្នា​នៃ​ស៊េរី​ទិន្នន័យ ។ "
"វា​កំណត់​ទិន្នន័យ​ជា​ជួរដេក​នៅ​លើ​គំនូស​តាង​របស់​អ្នក ។"

#: kchartDataConfigPage.cc:95
msgid ""
"Here you can choose to have each column hold one data set. Note that the values "
"are not really swapped but only their interpretation."
msgstr ""
"នៅទីនេះ អ្នក​អាច​ជ្រើស​ឲ្យ​មាន​ជួរឈរ​នីមួយៗ​មាន​សំណុំ​ទិន្នន័យ​មួយ ។ ចំណាំថា "
"តម្លៃ​ពិត​ជា​មិន​ប្ដូរ​ ប៉ុន្តែ​សម្រាប់ការ​បកស្រាយ​របស់​ពួក​គេ ។"

#: kchartDataEditor.cc:167
msgid "KChart Data Editor"
msgstr "កម្មវិធី​និពន្ធ​ទិន្នន័យ​របស់ KChart"

#: kchartDataEditor.cc:185
msgid "# Rows:"
msgstr "ចំនួន​ជួរដេក ៖"

#: kchartDataEditor.cc:192
msgid "# Columns:"
msgstr "ចំនួន​ជួរឈរ ៖"

#: kchartDataEditor.cc:328
msgid ""
"<p><b>Sets the number of rows in the data table.</b>"
"<br>"
"<br>Each row represents one data set.</p>"
msgstr ""
"<p><b>កំណត់​ចំនួន​ជួរដេក​នៅ​ក្នុង​តារាង​ទិន្នន័យ ។</b>"
"<br>"
"<br>ជួរដេក​នីមួយៗ​មាន​សំណុំ​ទិន្នន័យ​មួយ ។</p>"

#: kchartDataEditor.cc:330
msgid "Number of active data rows"
msgstr "ចំនួន​ជួរដេក​ទិន្នន័យ​សកម្ម"

#: kchartDataEditor.cc:335
msgid ""
"<p><b>Sets the number of columns in the data table.</b>"
"<br>"
"<br>The number of columns defines the number of data values in each data set "
"(row).</p>"
msgstr ""
"<p><b>កំណត់​ចំនួន​ជួរឈរ​នៅ​ក្នុង​តារាង​ទិន្នន័យ ។</b>"
"<br>"
"<br>ចំនួន​ជួរឈរ​កំណត់​តម្លៃ​របស់​ទិន្នន័យ​នៅ​ក្នុង​សំណុំ​ទិន្នន័យ​នីមួយៗ "
"(ជួរដេក) ។</p>"

#: kchartDataEditor.cc:337
msgid "Number of active data columns"
msgstr "ចំនួន​ជួរឈរ​ទិន្នន័យ​សកម្ម"

#: kchartDataEditor.cc:342
msgid "Chart data table."
msgstr "តារាង​ទិន្នន័យ​គំនូស​តាង ។"

#: kchartDataEditor.cc:364
msgid ""
"<p>This table contains the data for the chart."
"<br>"
"<br> Each row is one data set of values. The name of such a data set can be "
"changed in the column header (on the left) of the table. In a line diagram each "
"row is one line. In a ring diagram each row is one slice. "
"<br>"
"<br> Each column represents one value of each data set. Just like rows you can "
"also change the name of each value in the column headers (at the top) of the "
"table.  In a bar diagram the number of columns defines the number of value "
"sets.  In a ring diagram each column is one ring.</p>"
msgstr ""
"<p>តារាង​នេះ​មាន​ទិន្នន័យ​សម្រាប់​គំនូស​តាង ។"
"<br>"
"<br> ជួរដេក​នីមួយៗ​គឺ​ជា​សំណុំ​ទិន្នន័យ​របស់​តម្លៃ ។ "
"ឈ្មោះ​របស់​សំណុំ​ទិន្នន័យ​បែបនេះ​ "
"អាច​ត្រូវ​បាន​ផ្លាស់ប្ដូរ​នៅ​ក្នុង​បឋមកថា​ជួរឈរ (នៅ​ខាង​ឆ្វេង)តារាង ។ "
"នៅ​ក្នុង​ដ្យាក្រាម​បន្ទាត់ "
"ជួរដេក​នីមួយៗ​គឺ​ជា​បន្ទាត់ ។នៅ​ក្នុង​ដ្យាក្រាម​រង្វង់​ជួរដេក​នីមួយៗ​គឺ​ជា​បំណែក"
" ។"
"<br>"
"<br> ជួរឈរ​នីមួយៗ​បង្ហាញ​តម្លៃ​មួយ​របស់​សំណុំ​ទិន្នន័យ​នីមួយៗ ។ "
"គ្រាន់​តែ​ដូច​ជួរដេក​ដែល​ "
"អ្នក​អាច​ផ្លាស់ប្ដូរ​ឈ្មោះ​របស់​តម្លៃ​នីមួយៗ​នៅ​ក្នុង​បឋមកថា​ជួរឈរ (នៅ​កំពូល) "
"របស់​តារាង ។  នៅ​ក្នុង​ដ្យាក្រាម​របារ​ចំនួន​ជួរឈរ​កំណត់​ចំនួនសំណុំ​តម្លៃ ។  "
"នៅ​ក្នុង​ដ្យាក្រាម​រង្វង់​ជួរឈរ​នីមួយៗ​គឺ​ជា​​រង្វង់ ។</p>"

#: kchartDataEditor.cc:375
msgid "Insert row"
msgstr "បញ្ចូល​ជួរដេក"

#: kchartDataEditor.cc:376
msgid "Delete row"
msgstr "លុប​ជួរដេក"

#: kchartDataEditor.cc:377
msgid "Insert column"
msgstr "បញ្ចូល​ជួរឈរ"

#: kchartDataEditor.cc:378
msgid "Delete column"
msgstr "លុប​ជួរឈរ"

#: kchartDataEditor.cc:684
msgid ""
"You are about to shrink the data table and remove some values. This will lead "
"to loss of existing data in the table and/or the headers.\n"
"\n"
"This message will not be shown again if you click Continue"
msgstr ""
"អ្នក​រៀបនឹង​បង្រួម​តារាង​ទិន្នន័យ ហើយ​យក​តម្លៃ​មួយ​ចំនួន​ចេញ ។ "
"វា​នឹង​បណ្ដាល​ឲ្យ​បាត់​ទិន្នន័យ​ដែល​មាន​ស្រាប់​នៅ​ក្នុង​តារាង និង/ឬ​បឋមកថា ។\n"
"\n"
"សារ​នេះ​នឹង​មិន​ត្រូវ​បង្ហាញ​ទេ ប្រសិន​បើ​អ្នក​ចុច ​បន្ត"

#: kchartDataEditor.cc:809
msgid "Column Name"
msgstr "ឈ្មោះ​ជួរឈរ"

#: kchartDataEditor.cc:810
msgid "Type a new column name:"
msgstr "វាយ​ឈ្មោះ​ជួរឈរ​ថ្មី​មួយ ៖"

#: kchartDataEditor.cc:827
msgid "Row Name"
msgstr "ឈ្មោះ​ជួរដេក"

#: kchartDataEditor.cc:828
msgid "Type a new row name:"
msgstr "វាយ​ឈ្មោះ​ជួរដេក​ថ្មី​មួយ ៖"

