msgstr "ចំណង​ជើង Y"

#: kchartFontConfigPage.cc:128 kchartFontConfigPage.cc:151
msgid "X-Axis"
msgstr "អ័ក្ស X"

#: kchartFontConfigPage.cc:129 kchartFontConfigPage.cc:154
