msgstr "អ័ក្ស Y"

#: kchartFontConfigPage.cc:130 kchartFontConfigPage.cc:157
msgid "All Axes"
msgstr "អ័ក្ស​ទាំង​អស់"

#: kchartFontConfigPage.cc:133 kchartFontConfigPage.cc:159
msgid "Label"
msgstr "ស្លាក"

#: kchartHeaderFooterConfigPage.cc:46 kchartLegendConfigPage.cc:62
#: kchartWizardLabelsLegendPage.cc:45
msgid "Title:"
msgstr "ចំណង​ជើង ៖"

#: kchartHeaderFooterConfigPage.cc:47 kchartHeaderFooterConfigPage.cc:51
msgid ""
"Write here the title of your chart if you want one. The title will be centered "
"on top above your chart."
msgstr ""
"នៅ​ទីនេះ សរសេរ​ចំណង​ជើង​របស់​គំនូស​តាង​របស់​អ្នក​ ប្រសិន​បើ​អ្នក​ចង់​បាន​វា ។ "
"ចំណង​ជើង​នឹង​ត្រូវ​បាន​ដាក់​កណ្ដាល​នៅ​កំពូល​ខាង​លើ​គំនូស​តាង​របស់​អ្នក ។"

#: kchartHeaderFooterConfigPage.cc:55
msgid "Click on this button to choose the color for the title font."
msgstr "ចុច​លើ​ប៊ូតុង​នេះ​ ដើម្បី​ជ្រើស​ពណ៌​សម្រាប់​ពុម្ពអក្សរ​ចំណង​ជើង ។"

#: kchartHeaderFooterConfigPage.cc:59
msgid "Click on this button to choose the font family, style and size for the title."
msgstr ""
"ចុច​លើ​ប៊ូតុង​នេះ ដើម្បី​ជ្រើស​គ្រួសារ​ពុម្ពអក្សរ រចនាប័ទ្ម "
"និង​ទំហំ​សម្រាប់​ចំណង​ជើង ។"

#: kchartHeaderFooterConfigPage.cc:63
msgid "Subtitle:"
msgstr "ចំណង​ជើង​រង ៖"

#: kchartHeaderFooterConfigPage.cc:64 kchartHeaderFooterConfigPage.cc:68
#: kchartHeaderFooterConfigPage.cc:85
msgid ""
"Write here the subtitle of your chart if you want one. The subtitle will be "
"centered on top just below the title."
msgstr ""
"នៅ​ទីនេះ សសេរ​ចំណង​ជើង​រង​របស់​គំនូស​តាង​របស់​អ្នក ប្រសិន​បើ​អ្នក​ចង់​បាន​វា ។ "
"ចំណង​ជើង​រង​នឹង​ត្រូវ​បាន​ដាក់កណ្ដាល​នៅ​កំពូល​ គ្រាន់​តែ​ខាង​ក្រោម​ចំណង​ជើង ។"

#: kchartHeaderFooterConfigPage.cc:72
msgid "Click on this button to choose the color for the subtitle font."
msgstr "ចុច​លើ​ប៊ូតុង​នេះ ដើម្បី​ជ្រើស​ពណ៌​សម្រាប់​ពុម្ពអក្សរ​ចំណង​ជើង​រង ។"

#: kchartHeaderFooterConfigPage.cc:76
msgid ""
"Click on this button to choose the font family, style and size for the "
"subtitle."
msgstr ""
"ចុច​លើ​ប៊ូតុង​នេះ ដើម្បី​ជ្រើស​គ្រួសារ​ពុម្ពអក្សរ រច​នាប័ទ្ម "
"និង​ទំហំ​សម្រាប់​ចំណង​ជើង​រង ។"

#: kchartHeaderFooterConfigPage.cc:80
msgid "Footer:"
msgstr "បាតកថា ៖"

#: kchartHeaderFooterConfigPage.cc:81
msgid ""
"Write here the footer of your chart if you want one. The footer will be "
"centered at the bottom just below your chart."
msgstr ""
"នៅទីនេះ សរសេរ​បាតកថា​របស់​គំនូស​តាង​របស់​អ្នក ប្រសិន​បើអ្នក​ចង់​បាន​វា ។ "
"បាតកថា​នឹង​ត្រូវ​បាន​ដាក់​កណ្ដាល​នៅ​បាត "
"គ្រាន់​តែ​ខាង​ក្រោម​គំនូស​តាង​របស់​អ្នក ។"

#: kchartHeaderFooterConfigPage.cc:89
msgid "Click on this button to choose the color for the footer font."
msgstr "ចុច​លើ​ប៊ូតុង​នេះ ដើម្បី​ជ្រើស​ពណ៌​សម្រាប់​ពុម្ពអក្សរ​បាតកថា ។"

#: kchartHeaderFooterConfigPage.cc:93
msgid "Click on this button to choose the font family, style and size for the footer."
msgstr ""
"ចុច​លើ​ប៊ូតុង​នេះ ដើម្បី​ជ្រើស​គ្រួសារ​ពុម្ពអក្សរ រចនាប័ទ្ម "
"និង​ទំហំ​សម្រាប់​បាតកថា ។"

#: kchartLegendConfigPage.cc:55
msgid "General"
msgstr "ទូទៅ"

#: kchartLegendConfigPage.cc:63
msgid ""
"Write here the title of the legend, which is displayed at the top of the legend "
"box."
msgstr ""
"នៅ​ទីនេះ សរសេរ​ចំណង​ជើង​របស់​តាង "
"ដែល​ត្រូវ​បាន​បង្ហាញ​នៅ​កំពូល​របស់​ប្រអប់​តាង ។"

#: kchartLegendConfigPage.cc:70
msgid "Legend Position"
msgstr "ទីតាំង​តាង"

#: kchartLegendConfigPage.cc:71
msgid ""
"<qt>Choose the location of the legend on the chart by clicking a location "
"button.\n"
"Use the central button to <b>hide</b> the legend.</qt>"
msgstr ""
"<qt>ជ្រើស​ទីតាំង​របស់​តាង​នៅ​លើ​គំនូស​តាង ដោយ​ចុច​ប៊ូតុង​ទីតាំង ។\n"
"ប្រើ​ប៊ូតុង​កណ្ដាល​ដើម្បី​ <b>លាក់</b> តាង ។</qt>"

#: kchartLegendConfigPage.cc:79
msgid "Top-Left"
msgstr "កំពូល​ឆ្វេង"

#: kchartLegendConfigPage.cc:80
msgid "Top-Left-Top"
msgstr "កំពូល-ឆ្វេង-កំពូល"

#: kchartLegendConfigPage.cc:82
msgid "Top-Right-Top"
msgstr "កំពូល-ស្ដាំ-កំពូល"

#: kchartLegendConfigPage.cc:83
msgid "Top-Right"
msgstr "កំពូលស្ដាំ"

#: kchartLegendConfigPage.cc:85
msgid "Top-Left-Left"
msgstr "កំពូល-ឆ្វេង-ឆ្វេង"

#: kchartLegendConfigPage.cc:86
msgid "Top-Right-Right"
msgstr "កំពូល-ស្ដាំ-ស្ដាំ"

#: kchartLegendConfigPage.cc:89
msgid "No Legend"
msgstr "គ្មាន​តាង"

#: kchartLegendConfigPage.cc:92
msgid "Bottom-Left-Left"
msgstr "បាត-ឆ្វេង-ឆ្វេង"

#: kchartLegendConfigPage.cc:93
msgid "Bottom-Right-Right"
msgstr "បាត-ស្ដាំ-ស្ដាំ"

#: kchartLegendConfigPage.cc:95
msgid "Bottom-Left"
msgstr "បាត​ឆ្វេង"

#: kchartLegendConfigPage.cc:96
msgid "Bottom-Left-Bottom"
msgstr "បាត-ឆ្វេង-បាត"

#: kchartLegendConfigPage.cc:98
msgid "Bottom-Right-Bottom"
msgstr "បាត-ស្ដាំ-បាត"

#: kchartLegendConfigPage.cc:99
msgid "Bottom-Right"
msgstr "បាត​ស្ដាំ"

#: kchartLegendConfigPage.cc:106
msgid ""
"This Font box can be used to set different fonts for the legend title and the "
"individual entries."
msgstr ""
