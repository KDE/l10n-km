#: kfaximage.cpp:189
msgid "Unable to open file for reading."
msgstr "មិន​អាច​បើក​ឯកសារ សម្រាប់​អាន ។"

#: kfaximage.cpp:194
msgid "Unable to read file header (file too short)."
msgstr "មិន​អាច​អាន​បឋមកថា​ឯកសារ (ឯកសារ​ខ្លី​ពេក) ។"

#: kfaximage.cpp:203
msgid "This is not a TIFF FAX file."
msgstr "នេះ​មិនមែន​ជា​ឯកសារ TIFF FAX ។"

#: kfaximage.cpp:228
msgid "Invalid or incomplete TIFF file."
msgstr "ឯកសារ TIFF មិន​ត្រឹមត្រូវ ឬ មិន​ពេញលេញ ។"

#: kfaximage.cpp:329
msgid ""
"In file %1\n"
"StripsPerImage tag 273=%2,tag279=%3\n"
msgstr ""
"ក្នុង​ឯកសារ %1\n"
"StripsPerImage tag 273=%2,tag279=%3\n"

#: kfaximage.cpp:372
msgid ""
"Due to patent reasons LZW (Lempel-Ziv & Welch) compressed Fax files cannot "
"be loaded yet.\n"
msgstr "ដោយ​សារ​តែ​មូលហេតុ​ប៉ាតង់ LZW (Lempel-Ziv & Welch) ឯកសារ​ទូរសារ​ដែល​បង្ហាប់ មិន​អាច​ផ្ទុក​បាន​ឡើយ ។\n"

#: kfaximage.cpp:377
msgid "This version can only handle Fax files\n"
msgstr "កំណែ​នេះ​អាច​ដោះស្រាយ​តែ​ឯកសារ​ទូរសារ\n"

#: kfaximage.cpp:406
msgid "%1: Bad Fax File"
msgstr "%1: ឯកសារ​ទូរសារ​អាក្រក់"

#: kfaximage.cpp:472
msgid "Trying to expand too many strips."
msgstr "ព្យាយាម​ពង្រីក​បន្ទះ​ចម្រៀក​ច្រើន​ពេក ។"

#: kfaximage.cpp:498
msgid "Only the first page of the PC Research multipage file will be shown."
msgstr "មាន​តែ​ទំព័រ​ដំបូង​របស់​ឯកសារ​ពហុទំព័រ PC Research នឹង​ត្រូវ​បាន​បង្ហាញ ។"

#: kfaximage.cpp:511
msgid "No fax found in file."
msgstr "រកមិនឃើញ​ទូរសារ​ក្នុង​ឯកសារ ។"

#: kfaximage.cpp:631
msgid "Fax G3 format not yet supported."
msgstr "មិន​គាំទ្រ​ទ្រង់ទ្រាយ G3 របស់​ទូរសារ​ឡើយ ។"

