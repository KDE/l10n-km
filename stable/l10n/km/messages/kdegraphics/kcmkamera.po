msgid "Button (not supported by KControl)"
msgstr "ប៊ូតុង (មិនបាន​គាំទ្រ​ដោយ KControl​ទេ)"

#: kameraconfigdialog.cpp:216
msgid "Date (not supported by KControl)"
msgstr "កាលបរិច្ឆទ (មិនបាន​គាំទ្រ​ដោយ KControl​ទេ)"

