#: imageeffect_freerotation.cpp:59 imageeffect_freerotation.cpp:68
#: imageeffect_freerotation.cpp:291
msgid "Free Rotation"
msgstr "បង្វិល​តាម​ចិត្ត"

#: imageeffect_freerotation.cpp:70
msgid "A digiKam image plugin to process free image rotation."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​របស់ digiKam ដើម្បី​ដំណើរការ​ការ​បង្វិល​រូបភាព​តាម​ចិត្ត ។"

#: imageeffect_freerotation.cpp:77
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_freerotation.cpp:80
msgid "Free Rotation algorithm"
msgstr "ក្បួន​ដោះស្រាយ​ការ​បង្វិល​តាម​ចិត្ត"

#: imageeffect_freerotation.cpp:85
msgid ""
"<p>This is the free image operation preview. If you move the mouse cursor on "
"this preview, a vertical and horizontal dashed line will be drawn to guide "
"you in adjusting the free rotation correction. Release the left mouse button "
"to freeze the dashed line's position."
msgstr ""
"<p>នេះ​គឺ​ជា​ទិដ្ឋភាព​នៃ​ការ​បង្វិល​តាម​ចិត្ត ។ "
"បើ​អ្នក​ផ្លាស់ទី​ទស្សន៍​ទ្រនិច​កណ្ដុរ​នៅ​លើ​ទិដ្ឋភាព​នេះ "
"អ្នក​នឹង​ឃើញ​បន្ទាត់​ដាច់ៗ​បញ្ឈរ និង​ផ្ដេក "
"ដែល​វា​អាច​ជួយ​ណែនាំ​អ្នក​ក្នុង​ការ​លៃ​តម្រូវ​ការ​បង្វិល​តាម​ចិត្ត ។ "
"អ្នក​អាច​ព្រលែង​ប៊ូតុង​កណ្ដុរ​ឆ្វេង ដើម្បី​បញ្ឈប់​ទីតាំង​របស់​បន្ទាត់ចុចៗ ។"

#: imageeffect_freerotation.cpp:97
msgid "New width:"
msgstr "ទទឹង​ថ្មី ៖"

#: imageeffect_freerotation.cpp:103
msgid "New height:"
msgstr "កម្ពស់​​ថ្មី ៖"

#: imageeffect_freerotation.cpp:112
msgid "Main Angle (in degrees):"
msgstr "មុំ​ធំ (គិត​ជា​​ដឺក្រេ) ៖"

#: imageeffect_freerotation.cpp:116
msgid ""
"<p>An angle in degrees by which to rotate the image. A positive angle "
"rotates the image clockwise; a negative angle rotates it counter-clockwise."
msgstr ""
"<p>មុំ​គិត​ជាដឺក្រេ​ដើម្បី​បង្វិល​រូបភាព ។ មុំ​វិជ្ជមាន ៖ "
"បង្វិល​រូបភាព​ស្រប​ទិស​ទ្រនិច​នាឡិកា ។ មុំ​អវិជ្ជមាន ៖ "
"បង្វិល​រូបភាព​ច្រាស​ទិស​ទ្រនិច​នាឡិកា ។"

#: imageeffect_freerotation.cpp:123
msgid "Fine Angle (in degrees):"
msgstr "មុំ​ល្អិត (គិត​ជា​ដឺក្រេ)"

#: imageeffect_freerotation.cpp:127
msgid "<p>This value will be added to Main Angle value to set fine target angle."
msgstr "<p>តម្លៃ​នេះ​នឹង​ត្រូវ​បាន​បន្ថែម​ទៅ​តម្លៃ​មុំមេ ដើម្បី​កំណត់​មុំ​គោលដៅ​​ល្អិត ។"

#: imageeffect_freerotation.cpp:133
msgid "Anti-Aliasing"
msgstr "​ប្រឆាំង​រឆេត​រឆូត"

#: imageeffect_freerotation.cpp:134
msgid ""
"<p>Enable this option to process anti-aliasing filter to the rotated image. "
"To smooth the target image, it will be blurred a little."
msgstr ""
"<p>ធីក​ជម្រើស​នេះ "
"ដើម្បី​ដំណើរការ​តម្រង​ប្រឆាំង​រឆេត​រឆូត​ទៅ​កាន់​រូបភាព​ដែល​បាន​បង្វិល ។ "
"ដើម្បី​ធ្វើ​ឲ្យ​រូបភាព​គោលដៅ​រលោង វា​ប្រហែល​ជា​រាង​ព្រិល​បន្ដិច ។"

#: imageeffect_freerotation.cpp:139
msgid "Auto-crop:"
msgstr "ច្រឹប​ស្វ័យប្រវត្តិ ៖"

#: imageeffect_freerotation.cpp:141
msgid "None"
msgstr "គ្មាន​"

#: imageeffect_freerotation.cpp:142
msgid "Widest Area"
msgstr "ផ្ទៃ​ទូលាយ​បំផុត"

#: imageeffect_freerotation.cpp:143
msgid "Largest Area"
msgstr "ផ្ទៃ​ធំ​បំផុត"

#: imageeffect_freerotation.cpp:144
msgid ""
"<p>Select here the method to process image auto-cropping to remove black "
"frames around a rotated image."
msgstr ""
"<p>ជ្រើស​វិធីសាស្ត្រ​ដើម្បី​ដំណើរការ​ការ​ច្រឹប​រូបភាព​ដោយ​ស្វ័យប្រវត្តិ "
"ដើម្បី​លុប​ស៊ុម​ពណ៌​ខ្មៅ​នៅ​ជុំវិញ​រូបភាព​ដែល​បាន​បង្វិល ។"

#: imageeffect_freerotation.cpp:283 imageeffect_freerotation.cpp:284
msgid " px"
msgstr "ភីកសែល"

#: imageplugin_freerotation.cpp:42
msgid "Free Rotation..."
msgstr "បង្វិល​តាមចិត្ត..."

