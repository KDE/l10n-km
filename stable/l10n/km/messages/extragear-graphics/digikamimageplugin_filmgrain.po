#: imageeffect_filmgrain.cpp:55
msgid "Add Film Grain to Photograph"
msgstr "បន្ថែម​សាច់​ហ្វីល​ទៅ​កាន់​រូបថត"

#: imageeffect_filmgrain.cpp:61 imageeffect_filmgrain.cpp:164
msgid "Film Grain"
msgstr "សាច់​ហ្វីល"

#: imageeffect_filmgrain.cpp:63
msgid "A digiKam image plugin to apply a film grain effect to an image."
msgstr ""
"កម្មវិធីជំនួយ​រូបភាព digiKam អនុវត្ត​បែបផែន​សាច់​ហ្វីល​មួយ​ទៅកាន់​រូបភាព​មួយ ។"

#: imageeffect_filmgrain.cpp:70
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង​អ្នក​ថែទាំ"

#: imageeffect_filmgrain.cpp:79
msgid "Sensibility (ISO):"
msgstr "ការដឹង (ISO) ៖"

#: imageeffect_filmgrain.cpp:89
msgid ""
"<p>Set here the film ISO-sensitivity to use for simulating the film graininess."
msgstr ""
"<p>កំណត់​ការដឹង ISO ហ្វីល​ដើម្បី​ប្រើ​សម្រាប់​ការក្លែង​ធ្វើជា​សាច់​ហ្វីល ។"

#: imageplugin_filmgrain.cpp:42
msgid "Add Film Grain..."
msgstr "បន្ថែម​សាច់​ហ្វីល..."

