#: imageeffect_filmgrain.cpp:59 imageeffect_filmgrain.cpp:184
msgid "Film Grain"
msgstr "គ្រាប់ៗ"

#: imageeffect_filmgrain.cpp:61
msgid "A digiKam image plugin to apply a film grain effect to an image."
msgstr "កម្មវិធី​ជំនួយ digiKam ដើម្បី​អនុវត្ត​បែបផែនរូបភាពគ្រាប់ៗ ។"

#: imageeffect_filmgrain.cpp:69
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_filmgrain.cpp:72
msgid "Developer"
msgstr "អ្នកអភិវឌ្ឍន៍"

#: imageeffect_filmgrain.cpp:81
msgid "Sensitivity (ISO):"
msgstr "ភាព​ប្រែប្រួល (អាយអេសអូ) ៖"

#: imageeffect_filmgrain.cpp:91
msgid ""
"<p>Set here the film ISO-sensitivity to use for simulating the film graininess."
msgstr ""
"<p>កំណត់​វេទយិតភាព​អាយអេសអូ ដើម្បី​ប្រើ​សម្រាប់​ក្លែង​ធ្វើ​តាម​រូបភាព​គ្រាប់ៗ ។"

#: imageplugin_filmgrain.cpp:42
msgid "Add Film Grain..."
msgstr "បន្ថែមគ្រាប់ៗ..."

#: imageplugin_filmgrain.cpp:62
msgid "Add Film Grain to Photograph"
msgstr "បន្ថែម​គ្រាប់ៗ​ទៅ​កាន់​រូបថត"

