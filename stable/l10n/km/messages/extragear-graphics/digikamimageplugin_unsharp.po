#: imageeffect_unsharp.cpp:55 imageeffect_unsharp.cpp:60
#: imageeffect_unsharp.cpp:199
msgid "Unsharp Mask"
msgstr "របាំង​គ្មាន​ទ្រង់ទ្រាយ"

#: imageeffect_unsharp.cpp:62
msgid "An unsharp mask image filter plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ​តម្រង​រូបភាព​របាំង​គ្មាន​ទ្រង់ទ្រាយ​សម្រាប់ digiKam ។"

#: imageeffect_unsharp.cpp:68
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_unsharp.cpp:71
msgid "Unsharp mask algorithm author from Gimp"
msgstr "អ្នក​និពន្ធ​ក្បួន​ដោះស្រាយ​របាំង​គ្មាន​ទ្រង់ទ្រាយ​ពី Gimp"

#: imageeffect_unsharp.cpp:80
msgid "Radius:"
msgstr "កាំ ៖ "

#: imageeffect_unsharp.cpp:86
msgid ""
"<p>A radius of 0 has no effect, 10 and above determine the blur matrix radius "
"that determines how much to blur the image."
msgstr ""
"<p>កាំ​នៃ​ 0 មិន​មាន​បែបផែន  ១0 "
"និង​លើស​ពី​នេះ​កំណត់​ម៉ាទ្រីស​ព្រិល​ដែល​កំណត់​ថា​តើ​ត្រូវ​ធ្វើ​ឲ្យ​រូបភាព​ព្រិល​"
"ប៉ុន្មាន ។"

#: imageeffect_unsharp.cpp:94
msgid "Amount:"
msgstr "ចំនួន ៖"

#: imageeffect_unsharp.cpp:100
msgid ""
"<p>The value of the difference between the original and the blur image that is "
"added back into the original."
msgstr ""
"<p>តម្លៃ​នៃ​ភាព​ផ្សេង​គ្នា​រវាង​រូបភាព​ដើម​និង​រូបភាព​ព្រិល​ដែល​ត្រូវ​បាន​បន្ថែម"
"​ទៅ​រូបភាព​ដើម ។"

#: imageeffect_unsharp.cpp:107
msgid "Threshold:"
msgstr "​កម្រិត​ពន្លឺ ៖"

#: imageeffect_unsharp.cpp:112
msgid ""
"<p>The threshold, as a fraction of the maximum luminosity value, needed to "
"apply the difference amount."
msgstr ""
"<p>កម្រិត​ពន្លឺ  "
"ជា​ប្រភាគ​​តម្លៃនៃ​ភាព​ថ្លា​អតិបរមា​ត្រូវការ​ឲ្យ​អនុវត្ត​ចំនួន​ផ្សេង​គ្នា ។"

#: imageplugin_unsharp.cpp:47
msgid "Unsharp Mask..."
msgstr "របាំង​គ្មាន​ទ្រង់ទ្រាយ..."

