msgstr "<p>មុំ​កាត់​ផ្ដេក គិត​ជា​អង្សា ។"

#: imageeffect_sheartool.cpp:119
#, fuzzy
msgid "Fine horizontal angle:"
msgstr "មុំ​ផ្ដេក ៖"

#: imageeffect_sheartool.cpp:123
msgid ""
"<p>This value in degrees will be added to main horizontal angle value to set "
"fine adjustments."
msgstr ""

