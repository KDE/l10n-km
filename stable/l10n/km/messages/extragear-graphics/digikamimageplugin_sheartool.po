#: imageeffect_sheartool.cpp:64 imageeffect_sheartool.cpp:304
#: imageplugin_sheartool.cpp:62
msgid "Shear Tool"
msgstr "ឧបករណ៍​កាត់"

#: imageeffect_sheartool.cpp:66
msgid "A digiKam image plugin to shear an image."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​របស់​ digiKam ដើម្បី​កាត់​រូបភាព​មួយ ។"

#: imageeffect_sheartool.cpp:72
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_sheartool.cpp:75
msgid "Shear algorithm"
msgstr ""

#: imageeffect_sheartool.cpp:80
msgid ""
"<p>This is the shearing image operation preview. If you move the mouse cursor "
"on this preview, a vertical and horizontal dashed line will be drawn to guide "
"you in adjusting the shearing correction. Release the left mouse button to "
"freeze the dashed line's position."
msgstr ""
"<p>នេះ​គឺ​ជា​ការ​មើល​ប្រតិបត្តិ​ការ​រូបភាព​កាត់​ជាមុន ។ប្រសិន​បើ​អ្នក​ផ្លាស់​ទី​"
"ទស្សន៍​​ទ្រនិច​កណ្ដុរ​នៅ​លើ​ការ​មើល​ជា​មុននេះ បន្ទាត់​​ដាច់ៗ ​​​ផ្ដេក "
"​និង​បញ្ឈរ​មួយ​​នឹង​ត្រូវ​បាន​គូស​ដើម្បី​នាំ​ផ្លូវ​អ្នក​ក្នុង​ការ​លៃតម្រូវ​កំណែ​"
"កាត់​លែង​​ប៊ូតុង​កណ្ដុរ​​ឆ្វេង​ដើម្បី​បង្កក​ទីតាំង​របស់​​បន្ទាត់​​ដាច់ៗ ។"

#: imageeffect_sheartool.cpp:95
msgid "New width:"
msgstr "ទទឹង​ថ្មី ៖"

#: imageeffect_sheartool.cpp:96 imageeffect_sheartool.cpp:100
#: imageeffect_sheartool.cpp:296 imageeffect_sheartool.cpp:297
