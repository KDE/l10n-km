#: imageeffect_sheartool.cpp:58 imageeffect_sheartool.cpp:69
#: imageeffect_sheartool.cpp:264
msgid "Shear Tool"
msgstr "ឧបករណ៍​កាត់"

#: imageeffect_sheartool.cpp:71
msgid "A digiKam image plugin to shear an image."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​ digiKam ដើម្បី​កាត់​រូបភាព ។"

#: imageeffect_sheartool.cpp:77
#, fuzzy
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_sheartool.cpp:82
msgid ""
"<p>This is the shearing image operation preview. If you move the mouse "
"cursor on this preview, a vertical and horizontal dashed line will be drawn "
"to guide you in adjusting the shearing correction. Release the left mouse "
"button to freeze the dashed line's position."
msgstr "<p>នេះ​គឺ​ជា​ការ​មើល​ប្រតិបត្តិ​ការ​រូបភាព​កាត់​ជាមុន ។ ប្រសិន​បើ​អ្នក​រំកិល​ទស្សន៍​ទ្រនិច​កណ្ដុរ​នៅ​លើ​ទិដ្ឋភាព​ជា​មុន , បន្ទាត់​ដែល​ដាច់ៗ​ផ្ដេក​និង​បញ្ឈរ​នឹង​ត្រូវ​បាន​គូស​ដើម្បី​នាំ​ផ្លូវ​អ្នក​ក្នុង​ការ​លៃតម្រូវ​ការ​កែ​កាត់ ។ ព្រលែង​ប៊ូតុង​កណ្ដុរ​ខាងឆ្វេង​ដើម្បី​បង្កក​ទីតាំង​បន្ទាត់​ដែល​ដាច់ៗ ។"

#: imageeffect_sheartool.cpp:94
msgid "New width:"
msgstr "ទទឹង​ថ្មី ៖ "

#: imageeffect_sheartool.cpp:100
msgid "New height:"
msgstr "កំពស់​ថ្មី ៖ "

#: imageeffect_sheartool.cpp:109
msgid "Horizontal angle:"
msgstr "មុំ​បញ្ឈរ ៖ "

#: imageeffect_sheartool.cpp:114
msgid "<p>The horizontal shearing angle, in degrees."
msgstr "<p>មុំ​កាត់​បញ្ឈរ , គិត​ជា​ដឹក្រេ ។"

#: imageeffect_sheartool.cpp:118
msgid "Vertical angle:"
msgstr "មុំ​ផ្ដេក ៖ "

#: imageeffect_sheartool.cpp:123
msgid "<p>The vertical shearing angle, in degrees."
msgstr "<p>មុំ​កាត់​ផ្ដេក , គិត​ជា​ដឹក្រេ ។"

#: imageeffect_sheartool.cpp:127
#, fuzzy
msgid "Anti-Aliasing"
msgstr "ប្រឆាំង​រឆេត​រឆូត"

#: imageeffect_sheartool.cpp:128
msgid ""
"<p>Enable this option to process anti-aliasing filter to the sheared image. "
"To smooth the target image, it will be blurred a little."
msgstr ""
"<p>បើក​ជម្រើស​នេះ​ដើម្បី​ចូល​ដំណើរ​ការ​តម្រង​ការ​ប្រឆាំង​រឆេចរឆូច​ទៅ​រូបភាព​កាត់ ។"
"ដើម្បី​ធ្វើ​ឲ្យ​រូបភាព​​គោលដៅ​រាប​ស្មើ , វា​នឹង​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ព្រិល​បន្តិច ។"

