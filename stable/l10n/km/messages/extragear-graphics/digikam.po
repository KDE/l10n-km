msgid "Select &All"
msgstr "​ជ្រើស​ទាំងអស់"

#: utilities/cameragui/cameraui.cpp:402
msgid "Select N&one"
msgstr "មិន​ជ្រើស​អ្វី​ទាំងអស់"

#: utilities/cameragui/cameraui.cpp:403
msgid "&Invert Selection"
msgstr "បញ្ច្រាស​ជម្រើស"

#: utilities/cameragui/cameraui.cpp:405
msgid "Select &New Items"
msgstr "ជ្រើស​ធាតុ​ថ្មី"

#: utilities/cameragui/cameraui.cpp:407
msgid "Increase Thumbs"
msgstr "បង្កើន​ទំហំ​រូបភាពតូចៗ"

#: utilities/cameragui/cameraui.cpp:408
msgid "Decrease Thumbs"
msgstr "បន្ថយ​ទំហំ​រូបភាព​តូចៗ"

#: utilities/cameragui/cameraui.cpp:410
msgid "Toggle Lock"
msgstr "ចាក់សោ​កា​របិទបើក"

#: utilities/cameragui/cameraui.cpp:416
msgid "Download Selected"
msgstr "ទាញយក​ធាតុ​ដែល​បាន​ជ្រើស"

