msgstr ""
"<p>បើក​ជម្រើស​នេះ ដើម្បី​ប្រើ​ឈ្មោះ​ឯកសារ​រូបភាព​ដែល​បានផ្ដល់ដោយ​ម៉ាស៊ីន​ថត "
"ដោយ​គ្មាន​ការ​កែប្រែ ។"

#: utilities/cameragui/renamecustomizer.cpp:151
msgid "Change case to:"
msgstr "ប្ដូរ​​លក្ខណៈ​អក្សរ​ទៅ​ជា ៖"

#: utilities/cameragui/renamecustomizer.cpp:155
msgid "Leave as Is"
msgstr "ទុក​នៅ​ដដែល"

#: utilities/cameragui/renamecustomizer.cpp:156
msgid "Upper"
msgstr "ធំ"

#: utilities/cameragui/renamecustomizer.cpp:157
msgid "Lower"
msgstr "តូច"

#: utilities/cameragui/renamecustomizer.cpp:159
msgid "<p>Set the method to use to change the case of image filenames."
msgstr ""
"<p>កំណត់​វិធីសាស្ត្រ​ត្រូវ​ប្រើ​ដើម្បី​ផ្លាស់ប្ដូរ​ឈ្មោះ​ឯកសារ​រូបភាព ។"

#: utilities/cameragui/renamecustomizer.cpp:171
msgid "Customize"
msgstr "ប្ដូរ​តាម​បំណង"

#: utilities/cameragui/renamecustomizer.cpp:173
msgid "<p>Turn on this option to customize image filenames during download."
msgstr ""
"<p>បើក​ជម្រើស​នេះ សើម្បីប្ដូរ​ឈ្មោះ​ឯកសារ​រូបភាព​តាមបំណង​កំឡុង​ពេល​ទាញ​យក ។"

#: utilities/cameragui/renamecustomizer.cpp:185
msgid "Prefix:"
msgstr "បុព្វបទ ៖"

#: utilities/cameragui/renamecustomizer.cpp:190
msgid "<p>Set the prefix which will be prepended to image filenames."
msgstr ""
"<p>កំណត់​បុព្វបទ​ដែល​នឹង​ត្រូវ​បានបន្ថែម​ខាង​ដើម​ទៅឈ្មោះ​ឯកសារ​រូបភាព ។"

#: utilities/cameragui/renamecustomizer.cpp:193
msgid "Suffix:"
msgstr "បច្ច័យ ៖"

#: utilities/cameragui/renamecustomizer.cpp:197
msgid "<p>Set the suffix which will be postpended to image filenames."
msgstr ""
"<p>កំណត់​បច្ច័យ​ដែល​នឹង​ត្រូវ​បាន​បន្ថែម​ខាង​ចុង​ទៅ​ឈ្មោះ​ឯកសារ​រូបភាព ។"

#: utilities/cameragui/renamecustomizer.cpp:200
msgid "Add Date && Time"
msgstr "បន្ថែម​កាលបរិច្ឆេទ និង​ពេលវេលា"

#: utilities/cameragui/renamecustomizer.cpp:202
msgid "<p>Set this option to add the camera provided date and time."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ​ដើម្បី​បន្ថែម​កាលបរិច្ឆេទ និង​ពេលវេលា​ដែល​បាន​ផ្ដល់ ។"

#: utilities/cameragui/cameraui.cpp:277
#: utilities/cameragui/renamecustomizer.cpp:205
msgid "Date format:"
msgstr "ទ្រង់ទ្រាយ​កាលបរិច្ឆេទ ៖"

#: utilities/cameragui/renamecustomizer.cpp:207
msgid "Standard"
msgstr "ស្ដង់ដា"

#: utilities/cameragui/cameraui.cpp:279
#: utilities/cameragui/renamecustomizer.cpp:208
msgid "ISO"
msgstr "អាយអេសអូ"

#: utilities/cameragui/cameraui.cpp:280
#: utilities/cameragui/renamecustomizer.cpp:209
msgid "Full Text"
msgstr "អត្ថបទ​ពេញលេញ"

#: utilities/cameragui/cameraui.cpp:281
#: utilities/cameragui/renamecustomizer.cpp:210
msgid "Local Settings"
msgstr "ការ​កំណត់​មូលដ្ឋាន"

#: utilities/cameragui/renamecustomizer.cpp:211
msgid "Advanced..."
msgstr "កម្រិតខ្ពស់..."

#: utilities/cameragui/renamecustomizer.cpp:212
msgid ""
"<p>Select your preferred date format used to create new albums. The options "
"available are:</p>"
"<p><b>Standard</b>: the date format that has been used as a standard by "
"digiKam. E.g.: <i>20060824T142618</i></p><p/><b>ISO</b>"
": the date format is in accordance with ISO 8601 (YYYY-MM-DD). E.g.: <i>"
"2006-08-24T14:26:18</i></p>"
"<p><b>Full Text</b>: the date format is in a user-readable string. E.g.: <i>"
"Thu Aug 24 14:26:18 2006</i></p>"
"<p><b>Local Settings</b>: the date format depending on KDE control panel "
"settings.</p>"
"<p><b>Advanced:</b> allows to specify a custom date format.</p>"
msgstr ""
"<p>ជ្រើស​ទ្រង់ទ្រាយ​កាលបរិច្ឆេទ​ដែលអ្នក​ពេញចិត្ត​​ប្រើ​ដើម្បីបង្កើត​អាល់ប៊ុម​ថ្ម"
"ី ។ ជម្រើស​ដែល​មាន​គឺ ៖</p>"
"<p><b>ស្តង់ដា</b> ៖ ទ្រង់ត្រាយ​កាលបរិច្ឆេទ​ដែល​ត្រូវ​បាន​ប្រើ​ជា​ស្ដង់ដាដោយ "
"digiKam ។ ឧ. ៖<i>20060824T142618</i></p><p/><b>ISO</b>"
"៖ ទ្រង់ទ្រាយ​កាលបរិច្ឆេទ​ដោយ​អនុលោម​តាម ISO 8601 (YYYY-MM-DD) ។ ឧ. ៖ <i>"
"2006-08-24T14:26:18</i></p>"
"<p><b>អត្ថបទ​ពេញលេញ</b> ៖ "
"ទ្រង់ទ្រាយ​កាលបរិច្ឆេទជា​ខ្សែអក្សរ​ដែល​អ្នក​ប្រើអាច​អាន​បាន ។ ឧ. ៖ <i>"
"Thu Aug 24 14:26:18 2006</i></p>"
"<p><b>ការ​កំណត់​មូលដ្ឋាន</b> ៖ "
"ទ្រង់ទ្រាយ​កាលបរិច្ឆេទ​អាស្រ័យ​លើ​ការ​កំណត់​បន្ទះ​វត្ថុបញ្ជារបស់ KDE ។</p>"
"<p><b>កម្រិត​ខ្ពស់ ៖</b> "
"អនុញ្ញាត​ឲ្យ​បញ្ជាក់​ទ្រង់ទ្រាយ​កាលបរិច្ឆេទ​ផ្ទាល់​ខ្លួន ។</p>"

#: utilities/cameragui/renamecustomizer.cpp:232
msgid "Add Camera Name"
msgstr "បន្ថែម​ឈ្មោះ​ម៉ាស៊ីនថត"

#: utilities/cameragui/renamecustomizer.cpp:234
msgid "<p>Set this option to add the camera name."
msgstr "<p>កំណត់​ជម្រើស​នេះ ដើម្បី​បន្ថែម​ឈ្មោះ​ម៉ាស៊ីនថត ។"

#: utilities/cameragui/renamecustomizer.cpp:236
msgid "Add Sequence Number"
msgstr "បន្ថែម​លេខ​លំដាប់"

#: utilities/cameragui/renamecustomizer.cpp:238
msgid ""
"<p>Set this option to add a sequence number starting with the index set below."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ​ដើម្បី​បន្ថែម​លេខ​លំដាប់​ "
"ដែល​ចាប់ផ្ដើម​ដោយ​លិបិក្រម​កំណត់​ខាង​ក្រោម ។"

#: utilities/cameragui/renamecustomizer.cpp:241
msgid "Start Index:"
msgstr "លិបិក្រម​ចាប់ផ្ដើម ៖"

#: utilities/cameragui/renamecustomizer.cpp:244
msgid ""
"<p>Set the starting index value used to rename picture files with a sequence "
"number."
msgstr ""
"<p>កំណត់​តម្លៃ​លិបិក្រម​ចាប់ផ្ដើម "
"​បាន​ប្រើ​ដើម្បី​ប្ដូរ​ឈ្មោះ​ឯកសារ​រូបភាព​ជា​មួយ​លេខ​លំដាប់ ។"

#: utilities/cameragui/renamecustomizer.cpp:434
msgid ""
"<qt>"
"<p>Enter the format for date and time.</p>"
"<p>Use <i>dd</i> for the day, <i>MM</i> for the month, <i>yyyy</i> "
"for the year, <i>hh</i> for the hour, <i>mm</i> for the minute, <i>ss</i> "
"for the second.</p>"
"<p>Examples: <i>yyyyMMddThhmmss</i> for 20060824T142418,"
"<br><i>yyyy-MM-dd hh:mm:ss</i> for 2006-08-24 14:24:18.</p></qt>"
msgstr ""
"<qt>"
"<p>បញ្ចូល​ទ្រង់ទ្រាយ​សម្រាប់​កាលបរិច្ឆេទ និង​ពេលវេលា ។</p>"
"<p>ប្រើ <i>dd</i> សម្រាប់​ថ្ងៃ <i>MM</i> សម្រាប់​ខែ <i>yyyy</i> "
"សម្រាប់​ឆ្នាំ <i>hh</i> សម្រាប់​ម៉ោង <i>mm</i> សម្រាប់​នាទី <i>ss</i> "
"សម្រាប់​វិនាទី ។</p>"
"<p>ឧទាហរណ៍ ៖ <i>yyyyMMddThhmmss</i> សម្រាប់ 20060824T142418,"
"<br><i>yyyy-MM-dd hh:mm:ss</i> សម្រាប់ 2006-08-24 14:24:18.</p></qt>"

