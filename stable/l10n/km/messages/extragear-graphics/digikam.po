#: utilities/setup/setupgeneral.cpp:144
msgid "Show file &modification date"
msgstr "បង្ហាញ​​កាលបរិច្ឆេទ​កែប្រែ​ឯកសារ"

#: utilities/setup/setupgeneral.cpp:145
msgid ""
"<p>Set this option to show file modification date below image thumbnail."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ​ដើម្បី​បង្ហាញ​កាលបរិច្ឆេទ​កែប្រែ​ឯកសារ​ខាង​ក្រោម​រូបភាព​តូចៗ"
"​របស់​រូបភាព ។"

#: utilities/setup/setupgeneral.cpp:150
msgid "Show digiKam &comments"
msgstr "បង្ហាញ​សេចក្ដី​អធិប្បាយ​របស់ digiKam"

#: utilities/setup/setupgeneral.cpp:151
msgid "<p>Set this option to show digiKam comments below image thumbnail."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ​ដើម្បី​បង្ហាញ​សេចក្ដី​អធិប្បាយ​របស់ digiKam "
"ខាង​ក្រោម​រូបភាពតូចៗ​របស់​រូបភាព ។"

#: utilities/setup/setupgeneral.cpp:156
msgid "Show digiKam &tags"
msgstr "បង្ហាញ​ស្លាក​របស់ digiKam"

#: utilities/setup/setupgeneral.cpp:157
msgid "<p>Set this option to show digiKam tags below image thumbnail."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ ដើម្បី​បង្ហាញ​ស្លាក​របស់ digiKam "
"ខាង​ក្រោម​រូបភាព​តូចៗ​របស់​រូបភាព ។"

#: utilities/setup/setupgeneral.cpp:162
msgid "Show digiKam &rating"
msgstr "បង្ហាញ​​​​អត្រា​​របស់ digiKam"

#: utilities/setup/setupgeneral.cpp:163
msgid "<p>Set this option to show digiKam rating below image thumbnail."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ ដើម្បី​បង្ហាញ​​អត្រា​​របស់ digiKam "
"ខាង​ក្រោម​រូបភាព​តូចៗ​របស់​រូបភាព ។"

#: utilities/setup/setupgeneral.cpp:168
msgid "Show ima&ge dimensions (warning: slow)"
msgstr "បង្ហាញ​វិមាត្រ​រូបភាព​ (ព្រមាន ៖ យឺត)"

#: utilities/setup/setupgeneral.cpp:169
msgid ""
"<p>Set this option to show picture size in pixels below image thumbnail."
msgstr ""
"<p>កំណត់​ជម្រើស​នេះ​ដើម្បី​បង្ហាញ​ទំហំ​រូបភាពគិត​ជា​ភីកសែល​ខាង​ក្រោម​រូបភាពតូចៗ​"
"របស់​រូបភាព ។"

#: utilities/setup/setupgeneral.cpp:173
msgid "Click action:"
msgstr "ចុច​អំពើ ៖"

#: utilities/setup/setupgeneral.cpp:175
msgid "Show embedded preview"
msgstr "បង្ហាញ​ទិដ្ឋភាព​មើល​ជា​មុន​ដែល​បាន​បង្កប់"

#: utilities/setup/setupgeneral.cpp:176
msgid "Start image editor"
msgstr "ចាប់ផ្ដើម​កម្មវិធី​និពន្ធ​រូបភាព"

#: utilities/setup/setupgeneral.cpp:177
msgid ""
"<p>Select here the right action to do when you right click with mouse button on "
"an image thumbnail."
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​សកម្មភាព​ត្រឹមត្រូវ​ ត្រូវ​ធ្វើ​ "
"នៅ​ពេល​ដែលអ្នក​ចុច​កណ្ដុរ​ស្ដាំ​នៅ​លើរូបភាព​តូចៗ ។"

#: utilities/setup/setupgeneral.cpp:244
msgid "Sorry; cannot use home directory as albums library."
msgstr "សុំ​អភ័យទោស អ្នក​មិនអាច​ប្រើ​ថត​ផ្ទះ​ជា​បណ្ណាល័យ​អាល់ប៊ុមបានឡើយ ។"

#: utilities/setup/setupimgplugins.cpp:79
msgid "Toggle All"
msgstr "បិទ​បើក​ទាំងអស់"

#: utilities/setup/setupimgplugins.cpp:89
msgid ""
"<p>You can set here the list of plugins which must be enabled/disabled for the "
"future digiKam image editor sessions."
"<p>Note: the core image plugin cannot be disabled."
msgstr ""
"<p>អ្នកអាច​កំណត់​​បញ្ជី​កម្មវិធីជំនួយ​នៅទីនេះ ដែល​នឹង​ត្រូវ​បិទ ឬ "
"បើក​សម្រាប់​កម្មវិធីនិពន្ធ​រូបភាព​របស់ digiKam ។"
"<p>ចំណាំ ៖ អ្នក​មិន​អាច​បិទ​កម្មវិធីជំនួយ​រូបភាព​ស្នូល​បាន​ឡើយ ។"

#: utilities/setup/setupimgplugins.cpp:133
#, c-format
msgid "Plugins found: %1"
msgstr "បានរកឃើញ​កម្មវិធី​ជំនួយ ៖ %1"

#: utilities/setup/setupicc.cpp:156
msgid "Color Management Policy"
msgstr "គោលការណ៍​គ្រប់គ្រង​ពណ៌"

#: utilities/setup/setupicc.cpp:160
msgid "Enable Color Management"
msgstr "បើក​ការ​គ្រប់គ្រង​ពណ៌"

#: utilities/setup/setupicc.cpp:161
msgid ""
"<ul>"
"<li>Checked: Color Management is enabled</li>"
"<li>Unchecked: Color Management is disabled</li></ul>"
msgstr ""
"<ul>"
"<li>បាន​ពិនិត្យ​ ៖ ការ​គ្រប់គ្រង​ពណ៌​ត្រូវ​បាន​បើក​</li>"
"<li>មិន​បាន​ពិនិត្យ​ ៖ ការ​គ្រប់គ្រង​ពណ៌​ត្រូវ​បាន​បិទ</li></ul>"

#: utilities/setup/setupicc.cpp:172
msgid "Behaviour"
msgstr "ឥរិយាបថ"

#: utilities/setup/setupicc.cpp:178
msgid "Apply when open an image in Image Editor"
msgstr "អនុវត្ត​នៅពេល​បើក​រូបភាព​នៅ​ក្នុង​កម្មវិធី​និពន្ធ​រូបភាព"

#: utilities/setup/setupicc.cpp:179
msgid ""
"<p>If this option is selected, digiKam applies the Workspace default color "
"profile to an image without asking when this has no embedded profile, or the "
"embedded profile is not the same as the workspace profile.</p>"
msgstr ""
"<p>ប្រសិន​បើ​ជម្រើសនេះ​ត្រូវ​បាន​ជ្រើស digiKam "
"អនុវត្ត​ទម្រង់​ពណ៌​តំបន់​ធ្វើការ​លំនាំដើម​ទៅ​កាន់​រូបភាព​ដោយ​មិន​សួរ "
"នៅ​ពេល​វា​គ្មាន​ទម្រង់​ដែល​បាន​បង្កប់ "
"ឬ​ទម្រង់ដែល​បាន​បង្កប់​មិន​ដូច​នឹង​ទម្រង់​តំបន់​ធ្វើការ​លំនាំដើម ។</p>"

#: utilities/setup/setupicc.cpp:184
msgid "Ask when open an image in Image Editor"
msgstr "សួរ នៅ​ពេល​បើក​រូបភាព​ក្នុង​កម្មវិធីនិពន្ធ​រូបភាព"

#: utilities/setup/setupicc.cpp:185
msgid ""
"<p>If this option is selected, digiKam asks to the user before it applies the "
"Workspace default color profile to an image which has no embedded profile or, "
"if the image has an embbeded profile, this is not the same as the workspace "
"profile.</p>"
msgstr ""
"<p>ប្រសិន​បើ​ជម្រើស​នេះ​ត្រូវ​បានជ្រើស digiKam សួរ​អ្នក​ប្រើ "
"មុន​វា​អនុវត្ត​ទម្រង់​ពណ៌​លំនាំដើម​នៃ​តំបន់​ធ្វើការ​ទៅ​រូបភាព​ដែល​គ្មាន​ទម្រង់ដែ"
"ល​បាន​បង្កប់ ឬ​ប្រសិន​បើ​រូបភាព​មានទម្រង់​ដែល​បាន​បង្កប់ "
"វា​មិនដូច​នឹង​ទម្រង់​តំបន់​ធ្វើ​ការ ។</p>"

#: utilities/setup/setupicc.cpp:194
msgid "Launch Color Management plugin with RAW files"
msgstr "ចាប់ផ្ដើម​កម្មវិធី​ជំនួយ​ការ​គ្រប់គ្រង​ពណ៌​ជា​មួយ​នឹង​ឯកសារ​ដើម"

#: utilities/setup/setupicc.cpp:195
msgid ""
"Enable this option if you want to lauch the color management image plugin when "
"a RAW file is loaded in editor."
msgstr ""
"បើក​​ជម្រើស​នេះ "
"ប្រសិន​បើ​អ្នក​ចង់​ចាប់ផ្ដើម​​កម្មវិធី​ជំនួយ​រូបភាព​​គ្រប់គ្រង​ពណ៌​ "
"នៅ​ពេល​ឯកសារ​ដើម​ត្រូវ​បាន​ផ្ទុក​នៅ​ក្នុង​កម្មវិធី​និពន្ធ ។"

#: utilities/setup/setupicc.cpp:208
msgid "Color Profiles Directory"
msgstr "ថត​ទម្រង់​ពណ៌"

#: utilities/setup/setupicc.cpp:213
msgid ""
"<p>Default path to the color profiles folder. You must store all your color "
"profiles in this directory.</p>"
msgstr ""
"<p>ផ្លូវលំនាំដើម​ទៅ​ថត​ទម្រង់​ពណ៌ ​​​។ "
"អ្នក​ត្រូវ​តែ​ទុក​ទម្រង់​ពណ៌​របស់​អ្នក​ទាំង​អស់​នៅ​ក្នុង​​ថត​នេះ ។</p>"

#: utilities/setup/setupicc.cpp:220
msgid "ICC Profiles Settings"
msgstr "ការ​កំណត់​ទម្រង់ ICC"

#: utilities/setup/setupicc.cpp:225
msgid "Use color managed view (warning: slow)"
msgstr "ប្រើ​ពណ៌​ដែល​មាន​គ្រប់គ្រង​ទិដ្ឋភាព (ការ​ព្រមាន ៖ យឺត)"

#: utilities/setup/setupicc.cpp:226
msgid ""
"<p>Turn on this option if you want to use your <b>Monitor Color Profile</b> "
"to show your pictures in Image Editor window with a color correction adapted to "
"your monitor. Warning: this option can take a while to render pictures on the "
"screen, especially with a slow computer.</p>"
msgstr ""
"<p>បើក​ជម្រើសនេះ ប្រសិន​បើ​អ្នក​ចង់​ប្រើ <b>ទម្រង់​ពណ៌​ម៉ូនីទ័រ</b> "
"ដើម្បី​បង្ហាញ​រូបភាព​របស់​អ្នក​នៅ​ក្នុង​បង្អួច​កម្មវិធី​និពន្ធ​រូបភាព​ជា​មួយ​នឹង"
"​ការ​កែពណ៌​ដែល​បាន​អនុវត្ត​ទៅ​កាន់​ម៉ូនីទ័រ​របស់​អ្នក ។ ការ​ព្រមាន ៖ "
"ជម្រើស​នេះ​អាច​ចំណាយ​ពេល​មួយ​រយៈ ដើម្បី​បង្ហាញ​រូបភាព​ឡើងវិញ​នៅ​លើ​អេក្រង់ "
"ជា​ពិសេស​ជា​កុំព្យូទ័រ​ដែល​ដំណើរការ​យឺត ។</p>"

#: utilities/setup/setupicc.cpp:234
msgid "Monitor:"
msgstr "ម៉ូនីទ័រ ៖"

#: utilities/setup/setupicc.cpp:237
msgid ""
"<p>Select here the color profile for your monitor. You need to toggle on <b>"
"Use color managed view</b> option to use this profile.</p>"
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​ទម្រង់​ពណ៌​សម្រាប់ម៉ូនីទ័រ​របស់​អ្នក ។ "
"អ្នក​ត្រូវ​តែ​បិទបើក​នៅ​លើ​ជម្រើស <b>ប្រើ​​ពណ៌​បាន​គ្រប់គ្រង​ទិដ្ឋភាព</b> "
"ត្រូវ​ប្រើ​ទម្រង់​នេះ ។</p>"

#: utilities/setup/setupicc.cpp:240
msgid ""
"<p>You can use this button to get more detailed information about the selected "
"monitor profile.</p>"
msgstr ""
"<p>អ្នក​អាច​ប្រើ​ប៊ូតុង​នេះ​ដើម្បី​ទទួល​ព័ត៌មាន​លម្អិត​បន្ថែម​អំពី​ទម្រង់​ម៉ូនីទ"
"័រ​ដែល​បាន​ជ្រើស ។</p>"

#: utilities/setup/setupicc.cpp:251
msgid "Workspace:"
msgstr "ចន្លោះ​ការងារ ៖"

#: utilities/setup/setupicc.cpp:254
msgid ""
"<p>All the images will be converted to the color space of this profile, so you "
"must select a profile appropriate for edition purpose.</p>"
"<p>These color profiles are device independent.</p>"
msgstr ""
"<p>រូបភាព​ទាំងអស់​នឹង​ត្រូវ​បាន​បម្លែង​ទៅ​ជា​ចន្លោះ​ពណ៌​នៃ​ទម្រង់​នេះ "
"ដូច្នេះ​អ្នក​ត្រូវ​តែ​ជ្រើស​ទម្រង់​ដែល​សមរម្យ​សម្រាប់​កែសម្រួល ។</p>"
"<p>ទម្រង់​ពណ៌​ទាំងនេះ​គឺ​ជាឧបករណ៍​ឯករាជ្យ ។</p>"

#: utilities/setup/setupicc.cpp:258
msgid ""
"<p>You can use this button to get more detailed information about the selected "
"workspace profile.</p>"
msgstr ""
"<p>អ្នក​អាច​ប្រើ​ប៊ូតុង​នេះ​ដើម្បីទទួល​ព័ត៌មាន​លម្អិត​បន្ថែម​អំពី​ទម្រង់​ចន្លោះក"
"ារងារ​ដែល​បាន​ជ្រើស ។</p>"

#: utilities/setup/setupicc.cpp:268
msgid "Input:"
msgstr "បញ្ចូល ៖"

#: utilities/setup/setupicc.cpp:271
msgid ""
"<p>You must select the profile for your input device (usually, your camera, "
"scanner...)</p>"
msgstr ""
"<p>អ្នក​ត្រូវ​តែ​ជ្រើស​ទម្រង់​សម្រាប់ឧបករណ៍​បញ្ចូល​របស់​អ្នក (តាម​ធម្មតា "
"ម៉ាស៊ីនថត ម៉ាស៊ីន​ស្កេន​របស់​អ្នក...)</p>"

#: utilities/setup/setupicc.cpp:274
msgid ""
"<p>You can use this button to get more detailed information about the selected "
"input profile.</p>"
msgstr ""
"<p>អ្នក​អាច​ប្រើ​ប៊ូតុងនេះ​ដើម្បី​ទទួល​ព័ត៌មាន​លម្អិត​បន្ថែម​អំពី​ទម្រង់​បញ្ចូល​"
"ដែល​បាន​ជ្រើស ។</p>"

#: utilities/setup/setupicc.cpp:284
msgid "Soft proof:"
msgstr "រូបផ្ដិត​លមើល​ដ៏​ស្រទន់ ៖"

#: utilities/setup/setupicc.cpp:287
msgid ""
"<p>You must select the profile for your output device (usually, your printer). "
"This profile will be used to do a soft proof, so you will be able to preview "
"how an image will be rendered in an output device.</p>"
msgstr ""
"<p>អ្នក​ត្រូវតែ​ជ្រើស​ទម្រង់​សម្រាប់​ឧបករណ៍​​បង្ហាញ​លទ្ធផល​​របស់​អ្នក "
"(តាម​ធម្មតា ម៉ាស៊ីន​បោះពុម្ព​របស់​អ្នក) ។ "
