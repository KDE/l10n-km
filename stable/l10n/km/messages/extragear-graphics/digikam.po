msgid ""
"<p>Set here the mount path to use on your computer. This option is only "
"required if you use an <b>USB Mass Storage</b> camera.</p>"
msgstr ""
"<p>នៅ​ទីនេះ កំណត់​ផ្លូវ​ម៉ោន​ដើម្បី​ប្រើ​នៅ​លើ​កុំព្យូទ័ររបស់​អ្នក ។ "
"ជម្រើស​នេះ​ត្រូវ​ការ​តែ​នៅ​ពេល​ដែល​អ្នក​ប្រើម៉ាស៊ីនថត <b>"
"ការ​ផ្ទុក​ USB ច្រើន</b> ។</p>"

#: utilities/setup/cameraselection.cpp:180
msgid ""
"<p>To set an <b>USB Mass Storage</b> camera"
"<br>(which appears like a removable drive), please"
"<br>use <a href=\"umscamera\">%1</a> from camera list.</p>"
msgstr ""
"<p>ដើម្បី​កំណត់ <b>ឧបករណ៍​ផ្ទុក USB​</b> ម៉ាស៊ីន​ថត"
"<br>(ដែល​បង្ហាញ​ដូច​ជា​ដ្រាយ​ចល័ត) សូម​"
"<br>ប្រើ <a href=\"umscamera\">%1</a> ពី​បញ្ជី​ម៉ាស៊ីន​ថត ។</p>"

#: utilities/setup/cameraselection.cpp:186
msgid ""
"<p>To set a <b>Generic PTP USB Device</b>"
"<br>(which use Picture Transfer Protocol), please"
"<br>use <a href=\"ptpcamera\">%1</a> from camera list.</p>"
msgstr ""
"<p>ដើម្បី​កំណត់<b>ឧបករណ៍​ PTP USB ទូទៅ</b>"
"<br>(ដែល​ប្រើ​ពិធីការ​ផ្ទេរ​រូបភាព) សូម​"
"<br>ប្រើ <a href=\"ptpcamera\">%1</a> ពី​បញ្ជី​ម៉ាស៊ីនថត ។</p>"

#: utilities/setup/cameraselection.cpp:192
msgid ""
"<p>A complete list of camera settings to use is"
"<br>available at <a href='http://www.teaser.fr/~hfiguiere/linux/digicam.html'>"
"this url</a>.</p>"
msgstr ""
"<p>បញ្ជី​ពេញលេញ​របស់​ការ​កំណត់​ម៉ាស៊ីនថត ដើម្បី​ប្រើ​គឺ"
"<br>មាន​នៅ <a href='http://www.teaser.fr/~hfiguiere/linux/digicam.html'>"
"url នេះ</a> ។</p>"

