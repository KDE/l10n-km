#: libs/widgets/imageplugins/imagepannelwidget.cpp:132
msgid ""
"<p>Here you can see the original clip image which will be used for the preview "
"computation."
"<p>Click and drag the mouse cursor in the image to change the clip focus."
msgstr ""
"<p>នៅទីនេះ អ្នកអាច​មើលឃើញ​ឈុត​រូបភាព​ដើម​​ដែល​នឹង​ត្រូវ​បាន​ប្រើ "
"ដើម្បី​​​មើល​ការ​គណនា​ជា​មុន ។"
"<p>ចុច​ហើយ​អូស​ទស្សន៍​ទ្រនិច​កណ្តុរ​នៅក្នុង​រូបភាព "
"ដើម្បី​​ផ្លាស់ប្តូរ​ការផ្តោត​ទៅលើ​ឈុត ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:154
msgid "<p>Press this button to stop magnifying the image"
msgstr "<p>ចុច​ប៊ូតុង​នេះ​ដើម្បី​បញ្ជប់​ការ​ពង្រីក​រូបភាព"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:162
msgid "<p>Press this button to magnify image using 1.5:1 zoom factor."
msgstr "<p>ចុច​ប៊ូតុងនេះ​ដើម្បី​ពង្រីក​រូបភាព ដោយ​ប្រើកត្តា​ពង្រីក ១.៥៖១ ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:170
msgid "<p>Press this button to magnify image using 2:1 zoom factor."
msgstr "<p>ចុច​ប៊ូតុង​នេះ​ដើម្បី​ពង្រីក​រូបភាព​ដោយ​ប្រើ​កត្តា​ពង្រីក ២៖១ ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:178
msgid "<p>Press this button to magnify image using 2.5:1 zoom factor."
msgstr "<p>ចុច​ប៊ូតុង​នេះ​ដើម្បី​ពង្រីក​រូបភាព​ដោយ​ប្រើកត្តា​ពង្រីក ២.៥៖១ ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:186
msgid "<p>Press this button to magnify image using 3:1 zoom factor."
msgstr "<p>ចុច​ប៊ូតុង​នេះ​ដើម្បី​ពង្រីក​រូបភាព​ដោយ​ប្រើកត្តា​ពង្រីក ៣៖១ ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:206
msgid ""
"<p>If you enable this option, you will separate the preview area horizontally, "
"displaying the original and target image at the same time. The target is "
"duplicated from the original below the red dashed line."
msgstr ""
"<p>បើ​អ្នក​បើក​ជម្រើស​នេះ​ អ្នកនឹង​បំបែក​តំបន់​មើល​ជាមុន​ជា​លក្ខណៈ​ផ្ដេក "
"ដោយបង្ហាញ​រូបភាព​ដើម និង​រូបភាព​គោលដៅ​នៅ​ពេល​តែមួយ ។ "
"រូបភាព​គោលដៅ​​ត្រូវបាន​ស្ទួន​ពី​រូបភាព​ដើម នៅ​ពីក្រោម​បន្ទាត់ដាច់​ៗ​ពណ៌​ក្រហម ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:217
msgid ""
"<p>If you enable this option, you will separate the preview area vertically, "
"displaying the original and target image at the same time. The target is "
"duplicated from the original to the right of the red dashed line."
msgstr ""
"<p>បើ​អ្នក​បើក​ជម្រើស​នេះ អ្នក​នឹង​បំបែក​ផ្ទៃ​មើល​ជាមុន​បញ្ឈរ​ដាច់​ពី​គ្នា "
"ដោយ​បង្ហាញ​រូបភាព​ដើម និង​រូបភាព​គោលដៅ​ក្នុង​ពេល​តែ​មួយ ។ "
"រូបភាព​គោលដៅ​ត្រូវ​បាន​ចម្លង​មក​ពី​រូបភាព​ដើម "
"ចាប់​ពី​ផ្នែក​ខាង​ស្ដាំ​នៃ​បន្ទាត់​ចុចៗ​ពណ៌​ក្រហម ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:232
msgid ""
"<p>If you enable this option, you will separate the preview area horizontally, "
"displaying the original and target image at the same time. The original is "
"above the red dashed line, the target below it."
msgstr ""
"<p>បើ​អ្នក​បើក​ជម្រើស​នេះ អ្នក​នឹង​បំបែក​ផ្ទៃ​មើល​ជាមុន​ផ្ដេក​ដាច់​ពី​គ្នា "
"ដោយ​បង្ហាញ​រូបភាព​ដើម និង​រូបភាព​គោលដៅ​ក្នុង​ពេល​តែ​មួយ ។ "
"រូបភាព​ដើម​ស្ថិត​នៅ​ពី​លើ​បន្ទាត់​ចុចៗ​ពណ៌​ក្រហម រូបភាព​គោលដៅ​នៅ​ពី​ក្រោម ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:243
msgid ""
"<p>If you enable this option, you will separate the preview area vertically, "
"displaying the original and target image at the same time. The original is to "
"the left of the red dashed line, the target to the right of it."
msgstr ""
"<p>បើ​អ្នក​បើក​ជម្រើស​នេះ អ្នក​នឹង​បំបែក​ផ្ទៃ​មើល​ជាមុន​បញ្ឈរ​ដាច់​ពី​គ្នា "
"ដោយ​បង្ហាញ​រូបភាព​ដើម និង​រូបភាព​គោលដៅ​ក្នុង​ពេល​តែ​មួយ ។ "
"រូបភាព​ដើម​ស្ថិត​នៅ​ខាង​ឆ្វេង​បន្ទាត់​ចុចៗ​ពណ៌​ក្រហម "
"រូបភាព​គោលដៅ​ស្ថិត​នៅ​ខាង​ស្ដាំ ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:255
msgid "<p>If you enable this option, the preview area will not be separated."
msgstr ""
"<p>បើអ្នក​ជ្រើសជម្រើស​នេះ តំបន់មើល​ជាមុន​នឹងត្រូវបាន​បំបែក​ចេញ​ពី​គ្នា ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:288
msgid ""
"<p>Here you can see the original image panel which can help you to select the "
"clip preview."
"<p>Click and drag the mouse cursor in the red rectangle to change the clip "
"focus."
msgstr ""
"<p>នៅទីនេះ អ្នកអាច​មើលឃើញ​បន្ទះ​រូបភាព​ដើម​​ដែល​អាច​នឹង​ជួយ​អ្នក "
"ក្នុង​ការ​ជ្រើស​ទិដ្ឋភាព​ជាមុន​របស់​ឈុត ។"
"<p>ចុច​ហើយ​អូស​ទស្សន៍​ទ្រនិច​កណ្តុរ​នៅក្នុង​ចតុកោណកែង​ពណ៌​ក្រហម "
"ដើម្បី​​ផ្លាស់ប្តូរ​ការផ្តោត​ទៅលើ​ឈុត ។"

#: libs/widgets/imageplugins/imagepannelwidget.cpp:485
msgid "<nobr>Top left: (%1,%2)</nobr><br><nobr>Bottom right: (%3,%4)</nobr>"
msgstr ""
"<nobr>ខាង​លើ​ឆ្វេង ៖ (%1,%2)</nobr>"
"<br><nobr>ខាង​ក្រោម​ស្ដាំ ៖ (%3,%4)</nobr>"

#: libs/widgets/imageplugins/imageguidewidget.cpp:238
#: libs/widgets/imageplugins/imageguidewidget.cpp:323
#: libs/widgets/imageplugins/imageguidewidget.cpp:388
#: libs/widgets/imageplugins/imageregionwidget.cpp:243
#: libs/widgets/imageplugins/imageregionwidget.cpp:279
msgid "Original"
msgstr "​ដើម"

#: libs/widgets/imageplugins/imageguidewidget.cpp:256
#: libs/widgets/imageplugins/imageguidewidget.cpp:314
#: libs/widgets/imageplugins/imageguidewidget.cpp:379
#: libs/widgets/imageplugins/imageregionwidget.cpp:233
#: libs/widgets/imageplugins/imageregionwidget.cpp:269
msgid "Target"
msgstr "​គោល​ដៅ"

#: libs/widgets/imageplugins/imagewidget.cpp:102
msgid "<p>If you enable this option, you will see the original image."
msgstr "<p>ប្រសិន​បើ​អ្នក​ បើក​ជម្រើស​នេះ អ្នក​នឹង​ឃើញ​រូបភាព​ដើម ។"

#: libs/widgets/imageplugins/imagewidget.cpp:111
msgid ""
"<p>If you enable this option, the preview area will be separated vertically. A "
"contiguous area of the image will be shown, with one half from the original "
"image, the other half from the target image."
msgstr ""
"<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជា​មុន​នឹង​ត្រូវ​បាន​បំបែក​បញ្ឈរ ។ "
"ផ្ទៃ​ដែល​ទាក់ទង​របស់​រូបភាព​នឹង​ត្រូវ​បាន​បង្ហាញ "
"ដែល​មាន​ពាក់​កណ្ដាល​ពី​រូបភាព​ដើម ពាក់កណ្ដាល​ផ្សេង​ទៀត​ពី​រូពភាព​គោលដៅ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:123
msgid ""
"<p>If you enable this option, the preview area will be separated horizontally. "
"A contiguous area of the image will be shown, with one half from the original "
"image, the other half from the target image."
msgstr ""
"<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជា​មុន​នឹង​ត្រូវ​បាន​បំបែក​ផ្ដេក ។ "
"ផ្ទៃ​ដែល​ទាក់ទង​របស់​រូបភាព​នឹង​ត្រូវ​បាន​បង្ហាញ "
"ដែល​មាន​ពាក់កណ្ដាល​ពី​រូបភាព​ដើម ពាក់កណ្ដាល​ផ្សេង​ទៀត​ពី​រូបភាព​គោលដៅ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:135
msgid ""
"<p>If you enable this option, the preview area will be separated vertically. "
"The same part of the original and the target image will be shown side by side."
msgstr ""
"<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជាមុន​នឹង​ត្រូវ​​បាន​បំបែក​បញ្ឈរ ។ "
"ផ្នែក​ដូចគ្នា​របស់​រូបភាព​ដើម និង​គោលដៅ​នឹង​ត្រូវ​បាន​បង្ហាញ​ម្ដង​មួយ​ផ្នែកៗ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:146
msgid ""
"<p>If you enable this option, the preview area will be separated horizontally. "
"The same part of the original and the target image will be shown side by side."
msgstr ""
