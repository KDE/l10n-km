#: imageplugins/imageeffect_autocorrection.cpp:71
msgid "Auto Color Correction"
msgstr "កែខៃ​ពណ៌​ដោយ​ស្វ័យ​ប្រវត្តិ"

#: imageplugins/imageeffect_autocorrection.cpp:79
msgid ""
"<p>Here you can see the auto-color correction tool preview. You can pick color "
"on image to see the color level corresponding on histogram."
msgstr ""
"<p>នៅ​ទីនេះ​អ្នក​អាច​មើល​ទិដ្ឋភាព​មើល​ជាមុន​របស់ឧបករណ៍​កែពណ៌​ដោយ​ស្វ័យ​ប្រវត្តិ "
"។ "
"អ្នក​អាច​យក​ពណ៌​នៅលើ​រូបភាព​ដើម្បីមើល​កម្រិត​ពណ៌​ដែល​ទាក់ទង​នឹង​អ៊ីស្តូក្រាម​ ។"

#: imageplugins/imageeffect_autocorrection.cpp:100
#: imageplugins/imageeffect_bcg.cpp:93
#: imageplugins/imageeffect_bwsepia.cpp:195
#: imageplugins/imageeffect_hsl.cpp:92 imageplugins/imageeffect_rgb.cpp:90
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p>"
msgstr ""
"<p>នៅ​ទីនេះ​ ជ្រើស​ឆានែល​អ៊ីស្តូក្រាម​ត្រូវ​បង្ហាញ ៖"
"<p><b>ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។"
"<p><b>ពណ៌​ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ក្រហម ។"
"<p><b>ពណ៌​បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​បៃតង ។"
"<p><b>ពណ៌ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​​ពណ៌​ខៀវ ។"
"<p>"

#: imageplugins/imageeffect_autocorrection.cpp:110
#: imageplugins/imageeffect_bcg.cpp:103
#: imageplugins/imageeffect_bwsepia.cpp:205
#: imageplugins/imageeffect_hsl.cpp:102 imageplugins/imageeffect_rgb.cpp:100
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ "
"បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង​ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: imageplugins/imageeffect_autocorrection.cpp:142
#: imageplugins/imageeffect_bcg.cpp:135
#: imageplugins/imageeffect_bwsepia.cpp:237
#: imageplugins/imageeffect_hsl.cpp:134 imageplugins/imageeffect_rgb.cpp:132
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any settings changes."
msgstr ""
"<p>នៅ​ទីនេះ "
"អ្នក​អាច​មើល​គំនូរ​អ៊ីស្តូក្រាមរូបភាព​ទិដ្ឋភាព​មើល​ជាមុន​គោលដៅ​របស់​ឆានែល​រូបភាព"
"​ដែល​បាន​ជ្រើស ។ "
"មួយ​នេះ​ត្រូវ​បានគណនា​ម្ដងទៀត​នៅ​ការ​ផ្លាស់ប្ដូរ​ការ​កំណត់​ណា​មួយ ។"

#: imageplugins/imageeffect_autocorrection.cpp:161
#: imageplugins/imageeffect_autocorrection.cpp:366
msgid "Auto Levels"
msgstr "កម្រិត​ស្វ័យប្រវត្តិ"

#: imageplugins/imageeffect_autocorrection.cpp:162
msgid ""
"<b>Auto Levels</b>:"
"<p>This option maximizes the tonal range in the Red, Green, and Blue channels. "
"It searches the image shadow and highlight limit values and adjusts the Red, "
"Green, and Blue channels to a full histogram range.</p>"
msgstr ""
"<b>កម្រិត​ស្វ័យ​ប្រវត្តិ</b> ៖"
"<p>ជម្រើស​នេះ​ពង្រីក​ជួរ​សម្លេង​អតិបបរមា​នៅ​ក្នុង​ឆានែល​ពណ៌​ក្រហម បៃតង "
"និង​ខៀវ ។ វា​ស្វែងរក​ស្រមោល​រូបភាព និង​បន្លិច​តម្លៃ​កំណត់ "
"ហើយ​លៃតម្រូវ​ឆានែល​ពណ៌​ក្រហម បៃតង និង​ខៀវ​ទៅ​ជួរ​អ៊ីស្តូក្រាម​ពេញលេញ ។</p>"

#: imageplugins/imageeffect_autocorrection.cpp:170
#: imageplugins/imageeffect_autocorrection.cpp:370
msgid "Normalize"
msgstr "​ធ្វើ​ឲ្យ​សាមញ្ញ"

#: imageplugins/imageeffect_autocorrection.cpp:171
msgid ""
"<b>Normalize</b>:"
"<p>This option scales brightness values across the active image so that the "
"darkest point becomes black, and the brightest point becomes as bright as "
"possible without altering its hue. This is often a \"magic fix\" for images "
"that are dim or washed out.</p>"
msgstr ""
"<b>ធ្វើ​ឲ្យ​ធម្មតា</b> ៖"
"<p>ជម្រើស​ធ្វើ​មាត្រដ្ឋាន​តម្លៃ​ពន្លឺ​កាត់​តាម​រូបភាព​សកម្ម "
"ដូច្នេះ​ចំណុច​ងងឹត​បំផុត​ក្លាយ​ជា​ពណ៌​ខ្មៅ "
"ហើយ​ចំណុច​ភ្លឺ​បំផុត​ក្លាយ​ជា​​មាន​ពន្លឺ​តាមដែលអាចធ្វើ​ទៅ​តាម​ដោយ​មិនប្ដូរ​ពណ៌​ល"
"ាំៗ​របស់​វា ។ នេះ​ជា​រឿយៗ​ \"ការ​ជួសជុល​មន្តអាគម\" សម្រាប់​រូបភាព​ដែល​ស្រអាប់ "
"ឬ​រសាត់​បាត់ ។</p>"

#: imageplugins/imageeffect_autocorrection.cpp:180
#: imageplugins/imageeffect_autocorrection.cpp:374
msgid "Equalize"
msgstr "ធ្វើឲ្យ​ស្មើ"

#: imageplugins/imageeffect_autocorrection.cpp:181
msgid ""
"<b>Equalize</b>:"
"<p>This option adjusts the brightness of colors across the active image so that "
"the histogram for the value channel is as nearly as possible flat, that is, so "
"that each possible brightness value appears at about the same number of pixels "
"as each other value. Sometimes Equalize works wonderfully at enhancing the "
"contrasts in an image. Other times it gives garbage. It is a very powerful "
"operation, which can either work miracles on an image or destroy it.</p>"
msgstr ""
"<b>ធ្វើ​ឲ្យ​ស្មើគ្នា</b> ៖"
"<p>ជម្រើស​នេះ​លៃតម្រូវ​ពន្លឺ​របស់​ពណ៌​កាត់តាម​រូបភាព​សកម្ម "
"ដូច្នេះ​អ៊ីស្តូក្រាម​សម្រាប់​ឆានែល​តម្លៃ​គឺ​កាន់​តែ​សំប៉ែតមែនទែន "
"ដូច្នេះ​តម្លៃ​ពន្លឺ​នីមួយៗ​បង្ហាញ​អំពី​លេខ​ដូចគ្នា​នៃ​ភីកសែល​ជា​តម្លៃ​ដូចគ្នា ។ "
"ជួនកាល​ធ្វើ​ឲ្យ​ការ​ងារ​ស្មើគ្នា​ដ៏​អស្ចារ្យ​នៅ​ពេល​បង្កើត​កម្រិត​​កម្រិត​ពន្លឺ​"
"​នៅ​ក្នុង​រូបភាព​មួយ ។ ពេលវេលា​ផ្សេង វា​ឥតបានការ ។ "
"វា​ជា​ប្រតិបត្តិការ​ដ៏​មាន​​ឥទ្ធិពល​បំផុត "
"ដែល​អាច​ដំណើរការ​លើ​រូបភាព​ដ៏​អស្ចារ្យ ឬ​បំផ្លាញ​វា ។</p>"

#: imageplugins/imageeffect_autocorrection.cpp:193
#: imageplugins/imageeffect_autocorrection.cpp:378
msgid "Stretch Contrast"
msgstr "ទាញ​កម្រិត​ពណ៌​ឲ្យ​វែង​"

#: imageplugins/imageeffect_autocorrection.cpp:194
msgid ""
"<b>Stretch Contrast</b>:"
"<p>This option enhances the contrast and brightness of the RGB values of an "
"image by stretching the lowest and highest values to their fullest range, "
"adjusting everything in between.</p>"
msgstr ""
"<b>ទាញ​កម្រិត​ពណ៌ឲ្យ​វែង</b> ៖"
"<p>ជម្រើស​នេះ​បង្កើន​កម្រិត​ពន្លឺ និង​ភាព​ភ្លឺ​របស់​តម្លៃ RGB របស់រូបភាព​មួយ "
"ដោយ​ទាញ​តម្លៃ​ដែល​ទាបបំផុត "
"និង​ខ្ពស់​បំផុត​ទៅ​ជួរ​ពេញលេញ​បំផុត​របស់​ពួក​វាការ​លៃតម្រូវ​អ្វីៗ​នៅ​ចន្លោះ​នោះ "
"។</p>"

#: imageplugins/imageeffect_autocorrection.cpp:202
#: imageplugins/imageeffect_autocorrection.cpp:382
msgid "Auto Exposure"
msgstr "តាំងបង្ហាញដោយ​ស្វ័យ​ប្រវត្តិ"

#: imageplugins/imageeffect_autocorrection.cpp:203
msgid ""
"<b>Auto Exposure</b>:"
"<p>This option enhances the contrast and brightness of the RGB values of an "
"image to calculate optimal exposition and black level using image histogram "
"properties.</p>"
msgstr ""
"<b>ទាញ​កម្រិត​ពណ៌ឲ្យ​វែង</b> ៖"
"<p>ជម្រើស​នេះ​បង្កើន​កម្រិត​ពន្លឺ និង​ភាព​ភ្លឺ​របស់​តម្លៃ RGB របស់រូបភាព​មួយ "
"ដោយ​ទាញ​តម្លៃ​ដែល​ទាបបំផុត "
"និង​ខ្ពស់​បំផុត​ទៅ​ជួរ​ពេញលេញ​បំផុត​របស់​ពួក​វាការ​លៃតម្រូវ​អ្វីៗ​នៅ​ចន្លោះ​នោះ "
"។</p>"

#: imageplugins/imageeffect_iccproof.cpp:91 utilities/setup/setup.cpp:176
msgid "Color Management"
msgstr "កា​រគ្រប់គ្រង​ពណ៌ព​ពណ៌"

#: imageplugins/imageeffect_iccproof.cpp:106
msgid ""
"<p>Here you can see the image preview after applying a color profile</p>"
msgstr ""
"<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ទិដ្ឋភាព​មើល​ជា​មុន​របស់​រូបភាព​ "
"បន្ទាប់​ពី​អនុវត្ត​ទម្រង់ពណ៌</p>"

#: imageplugins/imageeffect_iccproof.cpp:115
msgid "Channel: "
msgstr "​ឆានែល​ ៖"

#: imageplugins/imageeffect_iccproof.cpp:122
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red channel values."
"<p><b>Green</b>: display the green channel values."
"<p><b>Blue</b>: display the blue channel values."
"<p>"
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​ឆានែល​អ៊ីស្តូក្រាម​ត្រូវ​បង្ហាញ ៖"
"<p><b>ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។"
"<p><b>ពណ៌​ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​ពណ៌​ក្រហម ។"
"<p><b>ពណ៌​បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​ពណ៌​បៃតង ។"
"<p><b>ពណ៌​ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​ពណ៌​ខៀវ ។"
"<p>"

#: imageplugins/imageeffect_iccproof.cpp:165
msgid ""
"<p>Here you can see the target preview image histogram of the selected image "
