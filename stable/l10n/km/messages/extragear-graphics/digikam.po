msgstr ""
"<p>ជ្រើស​ជម្រើស​នេះ "
"ប្រសិន​ម៉ាស៊ីនថត​របស់អ្នក​ត្រូវ​បាន​ភ្ជាប់​ទៅកុំព្យូទ័រ​ដោយ​ប្រើ​ខ្សែan "
"U ។e.</p>"

#: utilities/setup/cameraselection.cpp:139
msgid "Serial"
msgstr "សៀរៀល"

