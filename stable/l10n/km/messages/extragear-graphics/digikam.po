#: libs/dcraw/dcrawbinary.cpp:147
msgid ""
"<qt>"
"<p>Unable to find the <b>%1</b> executable:"
"<br>This program is required by %2 to support Raw file formats. You can use %3 "
"without this, but you will not be able to view or edit any Raw images. Please "
"check %4 installation on your computer."
msgstr ""
"<qt>"
"<p>មិន​អាចរក <b>%1</b> ដែល​អាច​ប្រតិបត្តិបាន ៖"
"<br>កម្មវិធី​នេះ​ទាមទារ​ដោយ %2 ដើម្បី​គាំទ្រ​ទ្រង់ទ្រាយ​ឯកសារដើម ។ "
"អ្នក​អាច​ប្រើ %3 ដោយ​គ្មាន​វា ប៉ុន្តែ​អ្នក​មិន​អាច​មើល "
"ឬ​កែសម្រួល​រូបភាព​ដើម​ណា​មួយ ។ សូម​ពិនិត្យ​មើលការ​ដំឡើង %4 "
"នៅ​ក្នុង​កុំព្យូទ័រ​របស់​អ្នក ។"

#: libs/dcraw/dcrawbinary.cpp:166
msgid ""
"<qt>"
"<p><b>%1</b> executable is not up to date:"
"<br> The version %2 of %3 have been found on your computer. This version is too "
"old to run properly with %4. You can run %5 like this, but you will not be able "
"to view or edit any images in Raw file formats. Please check %6 installation on "
"your computer."
"<p>Note: at least, dcraw version %7 is required by %8</p></qt>"
msgstr ""
"<qt>"
"<p><b>%1</b> ដែល​អាច​ប្រតិបត្តិ​បាន​មិន​ទាន់​សម័យ ៖"
"<br> រក​ឃើញ​កំណែ %2 នៃ %3 នៅ​លើ​កុំព្យូទ័រ​របស់អ្នក ។ "
"កំណែ​នេះ​ចាស់ពេក​រត់​មិន​ត្រឹមត្រូវ​ជា​មួយ %4 ។ អ្នក​អាច​រត់ %5 ដូច​នេះ "
"ប៉ុន្តែ​អ្នក​នឹង​មិន​អាច​មើល "
"ឬ​កែសម្រួល​រូបភាព​​ក្នុង​ទ្រង់ទ្រាយ​ឯកសារ​ដើមបាន​ទេ ។ សូម​ពិនិត្យ​មើល​ការ​ដំឡើង "
"%6 នៅ​ក្នុង​កុំព្យូទ័រ​របស់​អ្នក ។"
"<p>ចំណាំ ៖ យ៉ាង​ហោចណាស់ ត្រូវ​ការ dcraw កំណែ %7 ដោយ %8</p></qt>"

#: libs/dcraw/dcrawsettingswidget.cpp:110
msgid "16 bits color depth"
msgstr "ជម្រៅ​ពណ៌ ១៦​ ប៊ីត"

#: libs/dcraw/dcrawsettingswidget.cpp:111
msgid ""
"<p>If enabled, all RAW files will be decoded to 16-bit color depth using a "
"linear gamma curve. To prevent black picture rendering in the editor, it is "
"recommended to use Color Management in this mode."
"<p>If disabled, all RAW files will be decoded to 8-bit color depth with a "
"BT.709 gamma curve and a 99th-percentile white point. This mode is faster than "
"16-bit decoding."
msgstr ""
"<p>ប្រសិន​បើ​បាន​បើក ឯកសារ​ដើម​ទាំងអស់​នឹង​ត្រូវ​បាន​ឌិកូដ​ទៅ​ជា​​ជម្រៅ​ពណ៌ ១៦ "
"ប៊ីត ដោយ​ប្រើ​ខ្សែកោង​ហ្គាម៉ា​លីនេអ៊ែ ។ "
"ដើម្បី​ការពារ​ការបង្ហាញ​រូបភាព​ពណ៌ខ្មៅ​នៅ​ក្នុង​កម្មវិធី​និពន្ធ "
"វា​ត្រូវ​បាន​ផ្ដល់​អនុសាសន៍​ឲ្យ​ប្រើ​ការ​គ្រប់គ្រង​ពណ៌​នៅ​ក្នុង​របៀប​នេះ ។"
"<p>ប្រសិន​បើ​បាន​បិទ ឯកសារ​ដើម​ទាំងអស់​នឹង​ត្រូវ​បាន​ឌិកូដ​ទៅ​ជា​ជម្រៅពណ៌​ ៨ "
"ប៊ីតដែល​មាន​ខ្សែកោង​ហ្គាម៉ា BT.709 និង​ចំណុច​ពណ៌​ស​គិត​ជា​ភាគរយ​ទី ៩៩ ។ "
"របៀប​នេះ​លឿន​ជាង​ការ​ឌិកូដ​ជា ១៦ ប៊ីត ។"

#: libs/dcraw/dcrawsettingswidget.cpp:120
#, c-format
msgid "dcraw version %1"
msgstr "dcraw កំណែ %1"

#: libs/dcraw/dcrawsettingswidget.cpp:123
msgid "Visit dcraw project website"
msgstr "ទស្សនា​តំបន់​បណ្ដាញ​គម្រោង​របស់ dcraw"

#: libs/dcraw/dcrawsettingswidget.cpp:126
msgid "Interpolate RGB as four colors"
msgstr "ដាក់​ចន្លោះ RGB ជា​ពណ៌​ចំនួន ៤"

#: libs/dcraw/dcrawsettingswidget.cpp:127
msgid ""
"<p><b>Interpolate RGB as four colors</b>"
"<p>The default is to assume that all green pixels are the same. If even-row "
"green pixels are more sensitive to ultraviolet light than odd-row this "
"difference causes a mesh pattern in the output; using this option solves this "
"problem with minimal loss of detail."
"<p>To resume, this option blurs the image a little, but it eliminates false 2x2 "
"mesh patterns with VNG quality method or mazes with AHD quality method."
msgstr ""
"<p><b>កែខៃ RGB ជា​បួន​ពណ៌​</b>"
"<p>លំនាំដើម​គឺ​ត្រូវ​សន្មត់​ថា​ភីកសែល​ពណ៌​បៃតង​ទាំងអស់​គឺ​ដូចគ្នា ។ "
"ប្រសិន​បើ​ភីកសែល​​ពណ៌​បៃតងគូរ​គឺស្គាល់​​ពណ៌​ស្វាយ​ខ្ចី​ជាង​ជួរ​​សេស "
"ភាព​ខុស​គ្នា​នេះ​បណ្ដាល​ឲ្យលំនាំដើម​ប្រទាក់គ្នា​នៅ​ក្នុង​លទ្ធផល "
"ដោយ​ប្រើ​ជម្រើស​នេះ​ដោះស្រាយ​បញ្ហា​នេះ​ដោយ​បាត់បង់​សេចក្ដី​លម្អិត​អប្បបរមា ។"
"<p>ដើម្បី​បន្ត ជម្រើស​នេះ​ធ្វើ​ឲ្យ​រូបភាព​ព្រិលៗ​បន្តិច "
"ប៉ុន្តែ​វា​លុប​ភាព​មិន​ត្រឹមត្រូវ ២x២ "
"លំនាំ​ប្រទាក់គ្នា​ជា​មួយ​វិធីសាស្ត្រ​គុណភាព VNG "
"ឬ​ខ្វាត់ខ្វែង​ជា​មួយ​វិធីសាស្ត្រ​គុណភាព AHD ។"

#: libs/dcraw/dcrawsettingswidget.cpp:141
msgid "Use camera white balance"
msgstr "ប្រើ​តុល្យភាព​ពណ៌ស​របស់​ម៉ាស៊ីនថត"

#: libs/dcraw/dcrawsettingswidget.cpp:142
msgid ""
"<p><b>Use camera white balance</b>"
"<p>Use the camera's custom white-balance settings. The default is to use fixed "
"daylight values, calculated from sample images. If this can't be found, reverts "
"to the default."
msgstr ""
"<p><b>ប្រើ​តុល្យភាព​ពណ៌ស​របស់​ម៉ាស៊ីន​ថត​</b>"
"<p>ប្រើ​ការ​កំណត់​តុល្យភាព​ពណ៌ស​ផ្ទាល់ខ្លួន​របស់​ម៉ាស៊ីនថត ។ "
"តាមលំនាំដើម​គឺ​ត្រូវប្រើ​តម្លៃ​ថេរ ដែល​បាន​គណនា​ពី​រូបភាព​គំរូ ។ "
"ប្រសិន​បើ​វា​រក​មិនឃើញ ត្រឡប់​ទៅ​លំនាំដើម ។"

#: libs/dcraw/dcrawsettingswidget.cpp:151
msgid "Automatic color balance"
msgstr "តុល្យភាព​ពណ៌​ស្វ័យប្រវត្តិ"

#: libs/dcraw/dcrawsettingswidget.cpp:152
msgid ""
"<p><b>Automatic color balance</b>"
"<p>The default is to use a fixed color balance based on a white card "
"photographed in sunlight."
"<p>"
msgstr ""
"<p><b>តុល្យភាព​ពណ៌​ដោយ​ស្វ័យ​ប្រវត្តិ​</b>"
"<p>តាម​លំនាំដើម​គឺ​ត្រូវ​ប្រើ​តុល្យភាព​ពណ៌​ថេរ​ដែល​មាន​មូលដ្ឋាន​លើ​​កាត​ពណ៌​ស​ដែ"
"ល​បាន​ថត​នៅ​ពេល​ថ្ងៃ ។"
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:160
msgid "Use Super-CCD secondary sensors"
msgstr "ប្រើឧបករណ៍​ចាប់សញ្ញា​ទីពីរ​របស់​ CCD ពិសេស"

#: libs/dcraw/dcrawsettingswidget.cpp:161
msgid ""
"<p><b>Use Super CCD secondary sensors</b>"
"<p>For Fuji Super CCD SR cameras, use the secondary sensors, in effect "
"underexposing the image by four stops to reveal detail in the highlights. For "
"all other camera types this option is ignored."
"<p>"
msgstr ""
"<p><b>ប្រើ​ឧបករណ៍​ចាប់សញ្ញា​ទីពីររបស់ CCD ពិសេស​</b>"
"<p>សម្រាប់​ម៉ាស៊ីន​ថតហ្វូជី​ពិសេស CCD SR ប្រើ​ឧបករណ៍​ចាប់សញ្ញាទីពីរ "
"នៅ​ក្នុង​បែបផែន​ដែល​កំពុង​ដាក់​បង្ហាញ​​រូបភាព​ដោយ​ការ​បញ្ឈប់​ទាំង​បួន "
"និយាយា​លម្អិត​នៅ​ក្នុង​ការ​បន្លិច ។ "
"សម្រាប់​ប្រភេទ​ម៉ាស៊ីន​ថត​ផ្សេងៗ​ទៀត​ជម្រើស​នេះ​​ត្រូវ​បាន​មិន​អើពើ ។"
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:171
msgid "Highlights:"
msgstr "បន្លិច ៖"

#: libs/dcraw/dcrawsettingswidget.cpp:173
msgid "Solid white"
msgstr "ស​តាន់"

#: libs/dcraw/dcrawsettingswidget.cpp:174
msgid "Unclip"
msgstr "មិន​ច្រឹប"

#: libs/dcraw/dcrawsettingswidget.cpp:175
msgid "Reconstruct"
msgstr "ស្ថាបនា​ឡើងវិញ"

#: libs/dcraw/dcrawsettingswidget.cpp:176
msgid ""
"<p><b>Highlights</b>"
"<p>Select here the highlight clipping method:"
"<p><b>Solid white</b>: Clip all highlights to solid white"
"<p><b>Unclip</b>: Leave highlights unclipped in various shades of pink"
"<p><b>Reconstruct</b>: Reconstruct highlights using a level value."
msgstr ""
"<p><b>បន្លិច</b>"
"<p>នៅ​ទីនេះ​ ជ្រើស​​វិធីសាស្ត្រ​ច្រឹប​បន្លិច ៖"
"<p><b>ស​តាន់</b> ៖ ច្រឹប​ការ​បន្លិច​ទាំងអស់​ទៅ​ជា​ពណ៌​សតាន់"
"<p><b>មិនច្រឹប</b> ៖ "
"ទុក​ឲ្យ​ការ​បន្លិច​មិន​ត្រូវ​បានច្រឹប​ស្រមោល​ផ្សេងៗ​របស់ពណ៌​ផ្កាឈូក"
"<p><b>ស្ថាបនា​ឡើងវិញ</b> ៖ ស្ថាបនា​ការ​បន្លិច​ដោយ​ប្រើ​តម្លៃ​កម្រិត ។"

#: libs/dcraw/dcrawsettingswidget.cpp:186
msgid "Level:"
msgstr "កម្រិត ៖"

#: libs/dcraw/dcrawsettingswidget.cpp:189
msgid ""
"<p><b>Level</b>"
"<p>Specify the reconstruct highlights level of output image. Low values favor "
"whites and high values favor colors."
msgstr ""
"<p><b>កម្រិត</b>"
"<p>បញ្ជាក់​កម្រិត​បន្លិច​ស្ថាបនា​ឡើង​វិញ​របស់​រូបភាព​លទ្ធផល ។ "
"តម្លៃ​ទាប​ពេញចិត្ត​ពណ៌ស និង​តម្លៃ​ខ្ពស់​ពេញចិត្ត​ពណ៌ ។"

#: imageplugins/imageeffect_bcg.cpp:147 libs/dcraw/dcrawsettingswidget.cpp:197
msgid "Brightness:"
msgstr "​ពន្លឺ ៖"

#: libs/dcraw/dcrawsettingswidget.cpp:201
msgid ""
"<p><b>Brightness</b>"
"<p>Specify the brightness level of output image.The default value is 1.0."
"<p>"
msgstr ""
"<p><b>ពន្លឺ</b>"
"<p>បញ្ជាក់​កម្រិត​ពន្លឺ​របស់​រូបភាព​លទ្ធផល ។ តម្លៃ​លំនាំដើម​គឺ ១.០."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:209
msgid "Quality:"
msgstr "គុណភាព ៖"

#: libs/dcraw/dcrawsettingswidget.cpp:211
msgid "Bilinear interpolation"
msgstr "ការ​កែខៃ​ទ្វេរ​បន្ទាត់"

#: libs/dcraw/dcrawsettingswidget.cpp:212
msgid "VNG interpolation"
msgstr "ការ​កែខៃ VNG"

#: libs/dcraw/dcrawsettingswidget.cpp:213
msgid "AHD interpolation"
msgstr "កា​រកែខៃ AHD"

#: libs/dcraw/dcrawsettingswidget.cpp:214
msgid ""
"<p><b>Quality</b>"
"<p>Select here the demosaicing RAW images decoding interpolation method. A "
"demosaicing algorithm is a digital image process used to interpolate a complete "
"image from the partial raw data received from the color-filtered image sensor "
"internal to many digital cameras in form of a matrix of colored pixels. Also "
"known as CFA interpolation or color reconstruction, another common spelling is "
"demosaicking. There are 3 methods to demosaic RAW images:"
"<p><b>Bilinear</b>: use high-speed but low-quality bilinear interpolation "
"(default - for a slow computer). In this method, the red value of a non-red "
"pixel is computed as the average of the adjacent red pixels, and similar for "
"blue and green."
"<p><b>VNG</b>: use Variable Number of Gradients interpolation. This method "
"computes gradients near the pixel of interest and uses the lower gradients "
"(representing smoother and more similar parts of the image) to make an "
"estimate."
"<p><b>AHD</b>: use Adaptive Homogeneity-Directed interpolation. This method "
"selects the direction of interpolation so as to maximize a homogeneity metric, "
"thus typically minimizing color artifacts."
"<p>"
msgstr ""
"<p><b>គុណភាព</b>"
"<p>នៅ​ទីនេះ​ជ្រើស​​វិធីសាស្ត្រកែខៃ​ការ​​​អ៊ិនកូដ​រូបភាព​ដើម​ឌីម៉ូសាក់សីង ។ "
"ក្បួន​ឌីម៉ូសាក់សីង​គឺ​ជា​ដំណើរការ​រូបភាព​ដែល​បាន​ប្រើដើម្បីកែខៃ​រូបភាព​ពេញលេញ​ពី"
"​ទិន្នន័យ​ដើម​ឌីជីថល​ដែល​បាន​ទទួល​ពី​ឧបករណ៍​ចាប់​រូបភាព​ដែល​បាន​ត្រង​ដោយ​ពណ៌​ខាង"
"​ក្នុង​ទៅ​ម៉ាស៊ីន​ថត​ឌីជីថល​ជាច្រើន​ទៀត​ក្នុង​ទម្រង់​ម៉ាទ្រីស​របស់ភីកសែល​ដែល​មាន"
"​ពណ៌ ។ ក៏​ស្គាល់​ផង​ដែរ​ជាការ​កែខៃ CFA ឬ​ការ​ស្ថាបនា​ពណ៌ "
"កា​រប្រកប​ដ៏ធម្មតា​ផ្សេងៗ​ទៀតគឺ​ជា​ឌីម៉ូសាក់សីង ។ "
"មាន​វិធីសាស្ត្របី​ដើម្បី​ឌីម៉ូសាក់​រូបភាពដើម ៖"
"<p><b>ទ្វេរ​លីនេអ៊ែរ</b> ៖ ប្រើ​ល្បឿន​ខ្ពស់ "
"ប៉ុន្តែ​ការ​កែខៃ​ទ្វេរលីនេអ៊ែរ​គុណភាព​ទាប (លំនាំដើម - សម្រាប់កុំព្យូទ័រ​យឺត) ។ "
"ក្នុង​វិធីសាស្ត្រ​នេះ "
"តម្លៃ​ពណ៌​ក្រហមនៃ​ភីកសែល​មិនមែន​ពណ៌​ក្រហម​ត្រូវ​បាន​គណនា​ជា​មធ្យម​នៃ​ការ​លៃតម្រូ"
"វ​ភីកសែលពណ៌​ក្រហម ហើយ​ស្រដៀង​គ្នា​សម្រាប់​ពណ៌​ខៀវ និង​ពណ៌​បៃតង ។"
"<p><b>VNG</b> ៖ ប្រើ​លេខ​អថេរ​​នៃ​ការ​កែខៃ​ពណ៌​ជម្រាល ។​ "
"វិធី​នេះគណនា​ពណ៌ជម្រាល​នៅ​ជិត​ភីកសែល​នៃ​ការ​ចាប់អារម្មណ៍ "
"ហើយ​ប្រើ​ពណ៌​ជម្រាល​ទាប (ដោយ​បង្ហាញ​ផ្នែក​រលោង​ជាង និង​ដូចគ្នា​ជាង​របស់​រូបភាព) "
"ដើម្បី​ធ្វើការ​វាយតម្លៃ ។"
"<p><b>AHD</b> ៖ ប្រើ​ការ​កែខៃសមាសភាគដែល​ប្រែប្រួលដោយ​ផ្ទាល់ ។ វិធីសាស្ត្រ​នេះ​ "
"ជ្រើស​ទិស​​នៃ​ការ​កែខៃ​ ដូច្នេះ​ដូច​ទៅនឹង​ម៉ែត្រ​សមាសភាគ​អតិបរមា "
"ដូច្នេះ​ជា​ធម្មតាពណ៌​ចាស់អតិបរមា ។"
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:237
msgid "Enable noise reduction"
msgstr "បើក​ការ​កាត់​បន្ថយ​ការ​រំខាន"

#: libs/dcraw/dcrawsettingswidget.cpp:238
msgid ""
"<p><b>Enable Noise Reduction</b>"
"<p>Toggle bilateral filter to smooth noise while preserving edges. This option "
"can be use to reduce low noise. The pictures edges are preserved because it is "
"applied in CIELab color space instead of RGB."
"<p>"
msgstr ""
"<p><b>អនុញ្ញាត​ការ​កាត់បន្ថយ​ភាព​រំខាន​</b>"
"<p>បិទ​បើក​តម្រងទ្វេរ​ដើម្បីធ្វើ​ការ​រំខាន​រលូន​ខណៈពេល​បម្រុង​ទុកគែម ។ "
"ជម្រើស​នេះ​អាច​ប្រើ​ដើម្បី​កាត់បន្ថយ​ការ​រំខាន​តិច ។ "
"គែម​រូបភាព​ត្រូវ​បាន​បម្រុង​ទុក ពីព្រោះ​វា​ត្រូវ​បានអនុវត្ត​នៅ​ក្នុង​ចន្លោះ​ពណ៌ "
"CIELab ជំនួស​ឲ្យ RGB ។"
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:248
msgid "Domain:"
msgstr "ដែន ៖"

#: libs/dcraw/dcrawsettingswidget.cpp:249
msgid ""
"<p><b>Domain</b>"
"<p>Set here the noise reduction Sigma Domain in units of pixels. The default "
"value is 2.0."
"<p>"
msgstr ""
"<p><b>ដែន</b>"
"<p>នៅ​ទីនេះ​កំណត់​ដែន​សេម៉ា​កាត់បន្ថយ​ការ​រំខាន​គិត​ជា​ឯកតា​ភីកសែល ។ "
"តម្លៃ​លំនាំដើម​គឺ ២.០ ។"
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:260
msgid ""
"<p><b>Range</b>"
"<p>Set here the noise reduction Sigma Range in units of CIELab colorspace. The "
"default value is 4.0."
"<p>"
msgstr ""
"<p><b>ជួរ</b>"
"<p>នៅ​ទីនេះ​កំណត់​ជួរ​សេម៉ា​កាត់បន្ថយ​ការ​រំខាន​គិត​ជាឯកត្តា​​ចន្លោះពណ៌ "
"CIELab ។ តម្លៃ​លំនាំដើម​គឺ ៤.០ ។"
"<p>"

