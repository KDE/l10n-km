#: utilities/setup/setupplugins.cpp:59
#, c-format
msgid "Kipi version: %1"
msgstr "កំណែ Kipi ៖ %1"

#: utilities/setup/setupplugins.cpp:67
msgid "<p>A list of available Kipi plugins appears below."
msgstr ""
"<p>បញ្ជី​របស់​​កម្មវិធី​ជំនួយ​ Kipi ដែល​មាន​ទាំងអស់ នឹង​បង្ហាញ​នៅ​ខាង​ក្រោម ។"

#: utilities/setup/setupplugins.cpp:80
#, c-format
msgid ""
"_n: 1 Kipi plugin found\n"
"%n Kipi plugins found"
msgstr "បានរកឃើញ​កម្មវិធីជំនួយ Kipi ចំនួន %n"

#: utilities/setup/setupmime.cpp:49
msgid "Image Files"
msgstr "​ឯកសារ​រូបភាព"

#: utilities/setup/setupmime.cpp:52
msgid "Show only &image files with extensions:"
msgstr "បង្ហាញ​តែ​ឯកសារ​រូបភាព ដែល​មាន​កន្ទុយ ៖"

#: utilities/setup/setupmime.cpp:55
msgid ""
"<p>Here you can set the extensions of image files to be displayed in Albums "
"(such as JPEG or TIFF); when these files are double-clicked on they will be "
"opened with the digiKam Image Editor."
msgstr ""
"<p>នៅទីនេះ អ្នកអាច​កំណត់​កន្ទុយ​របស់​ឯកសារ​រូបភាព "
"ដែល​នឹង​ត្រូវ​បង្ហាញ​នៅក្នុង​អាល់ប៊ុម (ដូចជា JPEG ឬ TIFF) ។ "
"ពេល​អ្នក​ចុច​ទ្វេដង​លើ​ឯកសារ​ទាំងនេះ "
"ពួកវា​នឹង​ត្រូវបានបើក​ជាមួយ​កម្មវិធី​និពន្ធ​រូបភាព​របស់ digiKam ។"

#: utilities/setup/setupmime.cpp:64
msgid "Movie Files"
msgstr "ឯកសារ​ភាពយន្ត"

#: utilities/setup/setupmime.cpp:67
msgid "Show only &movie files with extensions:"
msgstr "បង្ហាញ​តែ​ឯកសារ​ភាពយន្ត ដែល​មាន​កន្ទុយ ៖"

