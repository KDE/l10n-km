#: libs/widgets/imageplugins/imagewidget.cpp:104
msgid ""
"<p>If you enable this option, the preview area will be separated vertically. A "
"contiguous area of the image will be shown, with one half from the original "
"image, the other half from the target image."
msgstr "<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជា​មុន​នឹង​ត្រូវ​បាន​បំបែក​បញ្ឈរ ។ ផ្ទៃ​ដែល​ទាក់ទង​របស់​រូបភាព​នឹង​ត្រូវ​បាន​បង្ហាញ ដែល​មាន​ពាក់​កណ្ដាល​ពី​រូបភាព​ដើម ពាក់កណ្ដាល​ផ្សេង​ទៀត​ពី​រូពភាព​គោលដៅ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:116
msgid ""
"<p>If you enable this option, the preview area will be separated horizontally. "
"A contiguous area of the image will be shown, with one half from the original "
"image, the other half from the target image."
msgstr ""
"<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជា​មុន​នឹង​ត្រូវ​បាន​បំបែក​ផ្ដេក ។ "
"ផ្ទៃ​ដែល​ទាក់ទង​របស់​រូបភាព​នឹង​ត្រូវ​បាន​បង្ហាញ ដែល​មាន​ពាក់កណ្ដាល​ពី​រូបភាព​ដើម ពាក់កណ្ដាល​ផ្សេង​ទៀត​ពី​រូបភាព​គោលដៅ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:128
msgid ""
"<p>If you enable this option, the preview area will be separated vertically. "
"The same part of the original and the target image will be shown side by side."
msgstr "<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជាមុន​នឹង​ត្រូវ​​បាន​បំបែក​បញ្ឈរ ។ ផ្នែក​ដូចគ្នា​របស់​រូបភាព​ដើម និង​គោលដៅ​នឹង​ត្រូវ​បាន​បង្ហាញ​ម្ដង​មួយ​ផ្នែកៗ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:139
msgid ""
"<p>If you enable this option, the preview area will be separated horizontally. "
"The same part of the original and the target image will be shown side by side."
msgstr ""
"<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ ផ្ទៃ​មើល​ជាមុន​នឹង​ត្រូវ​បាន​​បំបែក​ផ្ដេក ។ "
"ផ្នែក​ដូច​គ្នា​របស់​រូបភាព​ដើម និង​គោលដៅ​នឹង​ត្រូវ​បាន​បង្ហាញ​ម្ដង​មួយ​ផ្នែកៗ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:150
msgid "<p>If you enable this option, you will see the target image."
msgstr "<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ អ្នក​នឹង​ឃើញ​រូបភាព​គោលដៅ ។"

#: libs/widgets/imageplugins/imagewidget.cpp:159
msgid ""
"<p>If you enable this option, you will see the original image when the mouse is "
"over image area, else the target image."
msgstr "<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ អ្នក​នឹង​ឃើញ​រូបភាព​ដើម នៅ​ពេល​ដាក់​កណ្ដុរ​លើ​ផ្ទៃ​រូបភាព រូបភាព​គោលដៅ​ផ្សេងៗ​ទៀត ។"

