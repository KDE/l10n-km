"sizes and aspect ratio crop:"
"<p><b>2:3</b>: 10x15cm, 20x30cm, 30x45cm, 3.5x5\", 4x6\", 8x12\", 12x18\", "
"16x24\", 20x30\""
"<p><b>3:4</b>: 6x8cm, 15x20cm, 18x24cm, 30x40cm, 3.75x5\", 4.5x6\", 6x8\", "
"7.5x10\", 9x12\""
"<p><b>4:5</b>: 20x25cm, 40x50cm, 8x10\", 16x20\""
"<p><b>5:7</b>: 15x21cm, 30x42cm, 5x7\""
"<p><b>7:10</b>: 21x30cm, 42x60cm"
"<p>The <b>Golden Ratio</b> is 1:1.618. A composition following this rule is "
"considered visually harmonious but can be unadapted to print on standard "
"photographic paper."
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើសសមាមាត្រ​ដែលបាន​បង្ខំសម្រាប់ច្រឹប ។ "
"សមាមាត្រ​ឧបករណ៍​ច្រឹប​ប្រើ​សមាមាត្រ​ដែល​ទាក់ទង ។ នោះ​មាន​ន័យ​ថា វា​ដូចគ្នា​ "
"ប្រសិន​បើ​អ្នក​ប្រើ​សង់ទីម៉ែត្រ ឬ​អិន្ឈន៍ ហើយ​វា​មិន​បញ្ជាក់​ទំហំ​ពិត​ទេ ។"
"<p>នៅ​ខាង​ក្រោម អ្នក​អាចជ្រើស​បញ្ជី​ដែល​ទាក់ទង​នឹង​ក្រដាស​រូបថត​បុរាណ ទំហំ "
"និង​សមាមាត្រ​ច្រឹប ៖"
"<p><b>២ ៖៣</b> ៖ ១០x១៥ ស​.ម., ២០x៣០ ស.ម., ៣០x៤៥ ស.ម., ៣.៥x៥\", ៤x៦\", ៨x១២\", "
"១២x១៨\", ១៦x២៤\", ២០x៣០\""
"<p><b>៣៖៤</b> ៖ ៦x៨ ស.ម., ១៥x២០ ស.ម., ១៨x២៤ ស.ម., ៣០x៤០ ស.ម, ៣.៧៥x៥\", ៤.៥x៦\", "
"៦x៨\", ៧.៥x១០\", ៩x១២\""
"<p><b>៤៖៥</b> ៖ ២០x២៥ ស.ម., ៤០x៥០ ស.ម., ៨x១០\", ១៦x២០\""
"<p><b>៥៖៧</b> ៖ ១៥x២១ ស.ម., ៣០x៤២ ស.ម., ៥x៧\""
"<p><b>៧៖១០</b> ៖ ២១x៣០ ស.ម., ៤២x៦០ ស.ម."
"<p><b>សមាមាត្រពណ៌​មាស</b> គឺ ១៖១.៦១៨ ៖ "
"ច្បាប់​​តែង​ដូចខាង​ក្រោម​នេះ​ត្រូវ​បាន​ពិចារណាថា​អាច​មើលឃើញ​សមរម្យ "
"ប៉ុន្តែ​អាច​ត្រូវ​បាន​មិន​សម្រួល​ដើម្បីបោះពុម្ពនៅ​លើ​ក្រដា​រូបថត​ស្ដង់ដា ។"

#: imageplugins/imageeffect_ratiocrop.cpp:123
msgid "Orientation:"
msgstr "​ទិស ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:127
msgid "<p>Select here constrained aspect ratio orientation."
msgstr "<p>ជ្រើស​ទិស​សមាមាត្រ​ដែល​បាន​កម្រិត​រួច​ស្រេច នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_ratiocrop.cpp:129
msgid "Auto"
msgstr "ស្វ័យប្រវត្តិ"

#: imageplugins/imageeffect_ratiocrop.cpp:130
msgid "<p>Enable this option to automatic setting of orientation."
msgstr "<p>អនុញ្ញាត​ជម្រើស​នេះ​ទៅ​ការ​កំណត់​ស្វ័យ​ប្រវត្តិ​របស់​ទិស ។"

#: imageplugins/imageeffect_ratiocrop.cpp:140
msgid "Custom ratio:"
msgstr "សមាមាត្រ​ផ្ទាល់ខ្លួន ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:143
msgid "<p>Set here the desired custom aspect numerator value."
msgstr ""
"<p>ជ្រើស​តម្លៃ​ភាគយក​នៃ​សមាមាត្រ​ផ្ទាល់​ខ្លួន​ដែល​អ្នក​ចង់​បាន នៅ​ទីនេះ ។​"

#: imageplugins/imageeffect_ratiocrop.cpp:147
msgid "<p>Set here the desired custom aspect denominator value."
msgstr ""
"<p>ជ្រើស​តម្លៃ​ភាគបែង​នៃ​សមាមាត្រ​ផ្ទាល់​ខ្លួន​ដែល​អ្នក​ចង់​បាន នៅ​ទីនេះ ។​"

#: imageplugins/imageeffect_ratiocrop.cpp:157
#: imageplugins/imageeffect_ratiocrop.cpp:178
msgid "<p>Set here the top left selection corner position for cropping."
msgstr "<p>កំណត់​ទីតាំង​ជ្រុង​ខាង​លើ​ឆ្វេង​របស់​ជម្រើស​ដើម្បី​ច្រឹប នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_ratiocrop.cpp:158
msgid "X:"
msgstr "X ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:161
#: utilities/imageeditor/tools/imageresizedlg.cpp:92
msgid "Width:"
msgstr "​ទទឹង ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:162
msgid "<p>Set here the width selection for cropping."
msgstr "<p>កំណត់​ទទឹង​ជម្រើស​ដើម្បី​ច្រឹប នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_ratiocrop.cpp:168
msgid "<p>Set width position to center."
msgstr "<p>កំណត់ទីតាំង​ទទឹង​ទៅ​កណ្តាល ។"

#: imageplugins/imageeffect_ratiocrop.cpp:177
msgid "Y:"
msgstr "Y ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:181
#: utilities/imageeditor/tools/imageresizedlg.cpp:98
msgid "Height:"
msgstr "​កម្ពស់​ ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:182
msgid "<p>Set here the height selection for cropping."
msgstr "<p>កំណត់​កម្ពស់​ជម្រើស​ដើម្បី​ច្រឹប នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_ratiocrop.cpp:188
msgid "<p>Set height position to center."
msgstr "<p>កំណត់​ទីតាំង​កម្ពស់​​ទៅ​កណ្តាល ។"

#: imageplugins/imageeffect_ratiocrop.cpp:202
msgid "Composition guide:"
msgstr "មគ្គុទ្ទេសក៍​តាក់តែង ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:204
msgid "Rules of Thirds"
msgstr "ច្បាប់​ត្រីធា"

#: imageplugins/imageeffect_ratiocrop.cpp:205
msgid "Harmonious Triangles"
msgstr "ត្រីកោណសម័ង្ស"

#: imageplugins/imageeffect_ratiocrop.cpp:206
msgid "Golden Mean"
msgstr "មធ្យម​មាស"

#: imageplugins/imageeffect_ratiocrop.cpp:209
msgid ""
"<p>With this option, you can display guide lines which help you to compose your "
"photograph."
msgstr ""
"<p>ជាមួយ​​ជម្រើស​នេះ អ្នកអាច​បង្ហាញ​​​បន្ទាត់​ណែនាំ "
"ដែល​អាច​ជួយអ្នក​ក្នុង​ការ​តុបតែង​រូបថត​របស់​អ្នក ។"

#: imageplugins/imageeffect_ratiocrop.cpp:212
msgid "Golden sections"
msgstr "ផ្នែក​មាស"

#: imageplugins/imageeffect_ratiocrop.cpp:213
msgid "<p>Enable this option to show golden sections."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​បង្ហាញ​ផ្នែក​មាស ។"

#: imageplugins/imageeffect_ratiocrop.cpp:215
msgid "Golden spiral sections"
msgstr "ផ្នែក​វង់​មាស"

#: imageplugins/imageeffect_ratiocrop.cpp:216
msgid "<p>Enable this option to show golden spiral sections."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​បង្ហាញ​ផ្នែក​វង់​មាស ។"

#: imageplugins/imageeffect_ratiocrop.cpp:218
msgid "Golden spiral"
msgstr "វង់មាស"

#: imageplugins/imageeffect_ratiocrop.cpp:219
msgid "<p>Enable this option to show golden spiral guide."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​បង្ហាញ​មគ្គុទ្ទេសក៍​វិល​មាស ។"

#: imageplugins/imageeffect_ratiocrop.cpp:221
msgid "Golden triangles"
msgstr "ត្រីកោណ​មាស"

#: imageplugins/imageeffect_ratiocrop.cpp:222
msgid "<p>Enable this option to show golden triangles."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​បង្ហាញ​ត្រីកោណ​មាស ។"

#: imageplugins/imageeffect_ratiocrop.cpp:224
msgid "Flip horizontally"
msgstr "​ត្រឡប់​ផ្ដេក"

#: imageplugins/imageeffect_ratiocrop.cpp:225
msgid "<p>Enable this option to flip horizontally guidelines."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​ត្រឡប់​បន្ទាត់​ណែនាំ​​ផ្តេក ។"

#: imageplugins/imageeffect_ratiocrop.cpp:227
msgid "Flip vertically"
msgstr "​ត្រឡប់​បញ្ឈរ"

#: imageplugins/imageeffect_ratiocrop.cpp:228
msgid "<p>Enable this option to flip vertically guidelines."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​ត្រឡប់​​បន្ទាត់​ណែនាំ​​បញ្ឈរ ។"

#: imageplugins/imageeffect_ratiocrop.cpp:230
msgid "Color and width:"
msgstr "ពណ៌ និង​ទទឹង ៖"

#: imageplugins/imageeffect_ratiocrop.cpp:233
msgid "<p>Set here the color used to draw composition guides."
msgstr "<p>កំណត់​ពណ៌ ដែល​ប្រើ​ដើម្បី​គូរ​មគ្គុទ្ទេសក៍​តាក់តែង ។"

#: imageplugins/imageeffect_ratiocrop.cpp:234
msgid "<p>Set here the width in pixels used to draw composition guides."
msgstr "<p>កំណត់​ទទឹង​គិត​ជា​ភីកសែល ដើម្បី​គូរ​មគ្គុទ្ទេសក៍​តាក់តែង ។"

#: imageplugins/imageeffect_ratiocrop.cpp:715
msgid "Aspect Ratio Crop"
msgstr "ច្រឹប​តាម​សមាមាត្រ"

#: imageplugins/imageeffect_bwsepia.cpp:152
msgid "Convert to Black & White"
msgstr "បម្លែង​ជា​ពណ៌​សខ្មៅ"

#: imageplugins/imageeffect_bwsepia.cpp:178
msgid ""
"<p>Here you can see the black and white conversion tool preview. You can pick "
"color on image to see the color level corresponding on histogram."
msgstr ""
"<p>នៅទីនេះ អ្នក​អាច​ឃើញ​ទិដ្ឋភាព​មើល​ជាមុន​របស់​ឧបករណ៍​សន្ទនា​ពណ៌ស និង​ខ្មៅ ។ "
"អ្នក​អាច​យក​ពណ៌​នៅ​លើ​រូបភាព​ដើម្បី​មើល​កម្រិត​ពណ៌​ដែល​ទាក់ទង​នឹង​អ៊ីស្តូក្រាម ។"

#: imageplugins/imageeffect_bwsepia.cpp:261
msgid "No Black & White Filter"
msgstr "គ្មាន​តម្រង​ពណ៌​ខ្មៅ និង​ស"

#: imageplugins/imageeffect_bwsepia.cpp:262
msgid ""
"<b>No Black & White Filter</b>:"
"<p>Do not apply a black and white filter to the image.</p>"
msgstr ""
"<b>គ្មាន​តម្រង​ពណ៌ស និង​ខ្មៅ</b> ៖"
"<p>កុំបង្ហាញ​តម្រង​ពណ៌​ស និង​ខ្មៅ​ទៅ​រូបភាព ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:266
msgid "Neutral"
msgstr "ពណ៌​ស៊ីគ្នា"

#: imageplugins/imageeffect_bwsepia.cpp:267
msgid ""
"<b>Neutral Black & White</b>:"
"<p>Simulate black and white neutral film exposure.</p>"
msgstr ""
"<b>ពណ៌​ស និង​ខ្មៅ​ធម្មជាតិ</b> ៖"
"<p>ប្លែង​ហ្វីល​ធម្មជាតិ​ពណ៌​ស និង​ខ្មៅ ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:271
msgid "Green Filter"
msgstr "តម្រង​ពណ៌​បៃតង"

#: imageplugins/imageeffect_bwsepia.cpp:272
msgid ""
"<b>Black & White with Green Filter</b>:"
"<p>Simulate black and white film exposure using green filter. This provides an "
"universal asset for all scenics, especially suited for portraits photographed "
"against sky.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​តម្រង​ពណ៌​បៃតង</b> ៖"
"<p>ក្លែងធ្វើ​ពណ៌​ខ្មៅ និង​ស​នូវ​ការ​បង្ហាញ​ហ្វីល ដោយ​ប្រើ​តម្រង​ពណ៌​បៃតង ។ "
"វា​ផ្ដល់​នូវភាព​ជា​ម្ចាស់​ជា​សកល​សម្រាប់ទេសភាព​ទាំងអស់ "
"ជា​ពិសេស​សម​សម្រាប់​រូបថត​ដែល​បាន​ថត​បញ្ឈរ​ប្រឆាំង​នឹង​ផ្ទៃមេឃ ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:278
msgid "Orange Filter"
msgstr "តម្រង​ពណ៌​ទឹកក្រូច"

#: imageplugins/imageeffect_bwsepia.cpp:279
msgid ""
"<b>Black & White with Orange Filter</b>:"
"<p>Simulate black and white film exposure using orange filter. This will "
"enhances landscapes, marine scenes and aerial photography.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​តម្រង​ពណ៌​ទឹកក្រូច</b> ៖"
"<p>ក្លែងធ្វើ​ពណ៌​ខ្មៅ និង​ស​​នូវ​ការ​បង្ហាញ​ហ្វីល ដោយ​ប្រើ​តម្រង​ពណ៌​ទឹកក្រូច ។ "
"វា​នឹង​បង្កើន​ក្រដាស​ផ្ដេក ឆាក​តាម​នាវា និង​រូប​ថតខ្យល់អាកាស ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:285
msgid "Red Filter"
msgstr "តម្រង​ពណ៌​ក្រហម"

#: imageplugins/imageeffect_bwsepia.cpp:286
msgid ""
"<b>Black & White with Red Filter</b>:"
"<p>Simulate black and white film exposure using red filter. Using this one "
"creates dramatic sky effects and simulates moonlight scenes in daytime.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​តម្រង​ពណ៌​ក្រហម</b> ៖"
"<p>ក្លែងធ្វើ​ពណ៌ខ្មៅ និង​ស​នូវ​ការ​បង្ហាញ​ហ្វីល ដោយ​ប្រើ​តម្រង​ពណ៌​ក្រហម ។ "
"កា​រប្រើ​វា​ នឹង​បង្កើត​បែបផែន​ផ្ទៃមេឃគួរ​ឲ្យ​រំភើប "
"និង​ក្លែងធ្វើ​ឆាក​ពន្លឺ​ព្រះច័ន្ទ​នៅ​ពេលថ្ងៃ ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:292
msgid "Yellow Filter"
msgstr "តម្រង​ពណ៌​លឿង"

#: imageplugins/imageeffect_bwsepia.cpp:293
msgid ""
"<b>Black & White with Yellow Filter</b>:"
"<p>Simulate black and white film exposure using yellow filter. Most natural "
"tonal correction and improves contrast. Ideal for landscapes.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​តម្រង​ពណ៌​លឿង</b> ៖"
"<p>ក្លែង​ធ្វើពណ៌​ខ្មៅ និង​ស​នូវ​ការ​បង្ហាញ​ហ្វីល ដោយ​ប្រើ​តម្រង​ពណ៌​​លឿង ។ "
"ការ​កែទឹកពណ៌​ដែល​មានល្ខណៈ​ធម្មជាតិ​បំផុត និង​បង្កើន​កម្រិត​ពណ៌ ។ "
"ល្អ​បំផុត​សម្រាប់ក្រដាស​ផ្ដេក ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:298
msgid "Filters"
msgstr "តម្រង"

#: imageplugins/imageeffect_bwsepia.cpp:310
msgid "No Tone Filter"
msgstr "គ្មាន​តម្រង​សម្លេង"

#: imageplugins/imageeffect_bwsepia.cpp:311
msgid "<b>No Tone Filter</b>:<p>Do not apply a tone filter to the image.</p>"
msgstr "<b>គ្មាន​តម្រង​សម្លេង</b> ៖<p>កុំ​អនុវត្ត​តម្រង​សម្លេង​ទៅ​រូបភាព ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:315
msgid "Sepia Tone"
msgstr "ទឹកពណ៌​សូកូឡា"

#: imageplugins/imageeffect_bwsepia.cpp:316
msgid ""
"<b>Black & White with Sepia Tone</b>:"
"<p>Gives a warm highlight and mid-tone while adding a bit of coolness to the "
"shadows-very similar to the process of bleaching a print and re-developing in a "
"sepia toner.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​នឹង​ទឹកពណ៌​សូកូឡា</b> ៖"
"<p>ផ្ដល់​នូវ​ការ​បន្លិច​ដ៏​គួរ​ឲ្យ​ចាប់អារម្មណ៍ និង​ពាក់កណ្ដាល​ទឹក​ពណ៌​ "
"ខណៈ​ពេល​បន្ថែម​ភាព​ស្រទន់​បន្តិចបន្តួច​ទៅ​ឲ្យ​ស្រមោល-ដូចគ្នា​បះបិត​ដំណើរការ​នៃ​ក"
"ារធ្វើ​ឲ្យ​ការ​បោះពុម្ព​ស និង​អភិវឌ្ឍ​ទឹកពណ៌​សូកូឡា ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:322
msgid "Brown Tone"
msgstr "ទឹកពណ៌ ពណ៌​ត្នោត"

#: imageplugins/imageeffect_bwsepia.cpp:323
msgid ""
"<b>Black & White with Brown Tone</b>:"
"<p>This filter is more neutral than Sepia Tone filter.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​ទឹកពណ៌ ពណ៌​ត្នោត</b> ៖"
"<p>តម្រង​នេះ​មាន​លក្ខណៈ​ធម្មជាតិ​ជាង​តម្រង​ទឹកពណ៌​សូកូឡា ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:328
msgid "Cold Tone"
msgstr "ទឹកពណ៌​ស្រទន់​"

#: imageplugins/imageeffect_bwsepia.cpp:329
msgid ""
"<b>Black & White with Cold Tone</b>:"
"<p>Start subtle and replicate printing on a cold tone black and white paper "
"such as a bromide enlarging paper.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​ទឹក​ពណ៌​ស្រទន់</b> ៖"
"<p>ចាប់ផ្ដើមច្របល់ "
"និង​ថតចម្លង​ការ​បោះពុម្ព​នៅ​លើ​ទឹក​ពណ៌​ស្រទន់​លើ​ក្រដាស​ពណ៌​ខ្មៅ និង​ស "
"ដូច​ជាសារធាតុ​ប្រូម​ពង្រីក​ក្រដាស ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:335
msgid "Selenium Tone"
msgstr "ទឹក​ពណ៌​សេលេញ៉ូម"

#: imageplugins/imageeffect_bwsepia.cpp:336
msgid ""
"<b>Black & White with Selenium Tone</b>:"
"<p>This effect replicate traditional selenium chemical toning done in the "
"darkroom.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយនឹង​ទឹកពណ៌​សេលេញ៉ូម</b> ៖"
"<p>បែបផែន​នេះថតចម្លង​ទឹកពណ៌​គីមី​សេលេញ៉ូម​បុរាណ​នៅ​ក្នុង​បន្ទប់​ងងឹត ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:341
msgid "Platinum Tone"
msgstr "ទឹក​ពណ៌​ប្លាទីន"

#: imageplugins/imageeffect_bwsepia.cpp:342
msgid ""
"<b>Black & White with Platinum Tone</b>:"
"<p>This effect replicate traditional platinum chemical toning done in the "
"darkroom.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​ទឹកពណ៌​ប្លាទីន</b> ៖"
"<p>បែបផែន​ថត​ចម្លង​ទឹកពណ៌​គីមី​ប្លាទីន​នៅ​ក្នុង​បន្ទប់​ងងឹត ។</p>"

#: imageplugins/imageeffect_bwsepia.cpp:346
msgid "Tone"
msgstr "សម្លេង"

#: imageplugins/imageeffect_bwsepia.cpp:380
msgid "Lightness"
msgstr "ពន្លឺ ៖"

#: imageplugins/imageeffect_bwsepia.cpp:691
msgid "Convert to Black && White"
msgstr "បម្លែង​ទៅ​ជា​ពណ៌​ខ្មៅ និង​ស"

#: imageplugins/imageeffect_bwsepia.cpp:791
msgid "Black & White Settings File to Load"
msgstr "ឯកសារ​កំណត់​ពណ៌​ស និង​ខ្មៅ​ត្រូវ​ផ្ទុក"

#: imageplugins/imageeffect_bwsepia.cpp:804
msgid "\"%1\" is not a Black & White settings text file."
msgstr "\"%1\" មិន​មែន​ជា​ឯកសារ​អត្ថបទ​កំណត់​ពណ៌ស និង​ខ្មៅ ។"

#: imageplugins/imageeffect_bwsepia.cpp:855
msgid "Cannot load settings from the Black & White text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពី​ឯកសារ​អត្ថបទ​ពណ៌​ស និង​ខ្មៅ ។"

#: imageplugins/imageeffect_bwsepia.cpp:866
msgid "Black & White Settings File to Save"
msgstr "ឯកសារ​កំណត់​ពណ៌​ស និង​ខ្មៅ​ត្រូវ​រក្សាទុក"

#: imageplugins/imageeffect_bwsepia.cpp:893
msgid "Cannot save settings to the Black & White text file."
msgstr "មិន​អាច​រក្សាទុក​ការ​កំណត់​ទៅ​ជា​ឯកសារ​អត្ថបទ​ពណ៌​ស និង​ខ្មៅ ។"

#: imageplugins/imageeffect_sharpen.cpp:56
msgid "Sharpening Photograph"
msgstr "ការ​ធ្វើ​រូបថត​ឲ្យ​​ច្បាស់"

#: imageplugins/imageeffect_sharpen.cpp:63
msgid "Sharpness:"
msgstr "ភាព​ច្បាស់ ៖"

#: imageplugins/imageeffect_sharpen.cpp:68
msgid ""
"<p>A sharpness of 0 has no effect, 1 and above determine the sharpen matrix "
"radius that determines how much to sharpen the image."
msgstr ""
"<p>ភាពច្បាស់​ស្មើ 0 នឹង​មិន​មាន​អ្វី​ប្រែប្រួល​ទាំងអស់ ភាពច្បាស់​ចាប់​ពី 1 "
"ឡើង​ទៅ "
"នឹង​កំណត់​កាំ​ម៉ាទ្រីស​ភាព​ច្បាស់​ដែល​កំណត់​ចំនួន​ដែល​ត្រូវ​ធ្វើ​ឲ្យ​រូបភាព​ច្បា"
"ស់ ។"

#: imageplugins/imageeffect_sharpen.cpp:157
msgid "Sharpen"
msgstr "ធ្វើ​ឲ្យច្បាស់"

#: imageplugins/imageeffect_rgb.cpp:66 imageplugins/imageeffect_rgb.cpp:408
msgid "Color Balance"
msgstr "តុល្យភាព​ពណ៌"

#: imageplugins/imageeffect_rgb.cpp:72
msgid ""
"<p>Here you can see the image color-balance adjustments preview. You can pick "
"color on image to see the color level corresponding on histogram."
msgstr ""
"<p>នៅ​ទីនេះ "
"អ្នក​អាច​មើល​ទិដ្ឋភាព​មើល​ជា​មុន​នៃ​ការ​លៃតម្រូវ​តុល្យាភាព​ពណ៌​រូបភាព ។ "
"អ្នក​អាច​ជ្រើស​ពណ៌​នៅ​លើ​រូបភាព​ដើម្បី​មើល​កម្រិត​ពណ៌​ដែល​ទាក់ទង​នឹង​អ៊ីស្តូក្រា"
"ម ។"

#: imageplugins/imageeffect_rgb.cpp:144
msgid "Cyan"
msgstr "​ផ្ទៃមេឃ"

#: imageplugins/imageeffect_rgb.cpp:149
msgid "<p>Set here the cyan/red color adjustment of the image."
msgstr "<p>កំណត់ការលៃតម្រូវ​​ពណ៌​ផ្ទៃមេឃ/ពណ៌​ក្រហម​របស់​រូបភាព នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_rgb.cpp:161
msgid "Magenta"
msgstr "​ក្រហម​ស្វាយ"

#: imageplugins/imageeffect_rgb.cpp:166
msgid "<p>Set here the magenta/green color adjustment of the image."
msgstr ""
"<p>កំណត់​ការ​លៃ​តម្រូវ​​ពណ៌​ក្រហម​ស្វាយ/ពណ៌​បៃតង​របស់​រូបភាព នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_rgb.cpp:178
msgid "Yellow"
msgstr "​លឿង"

#: imageplugins/imageeffect_rgb.cpp:183
msgid "<p>Set here the yellow/blue color adjustment of the image."
msgstr "<p>កំណត់​ការលៃ​តម្រូវ​ពណ៌​លឿង/ពណ៌ខៀវ​របស់​រូបភាព នៅ​ទីនេះ ។"

#: imageplugins/imageeffect_redeye.cpp:90
msgid "Red-Eye Correction Tool"
msgstr "ឧបករណ៍​កែខៃ​ភ្នែក​ក្រហម"

#: imageplugins/imageeffect_redeye.cpp:91
msgid ""
"You need to select a region including the eyes to use the red-eye correction "
"tool"
msgstr ""
"អ្នក​ត្រូវ​តែ​ជ្រើស​តំបន់​មួយ​ដែល​មាន​ភ្នែក "
"ដែល​ត្រូវ​ប្រើ​ឧបករណ៍​កែខៃ​ភ្នែក​ក្រហម"

#: imageplugins/imageeffect_redeye.cpp:224
msgid "Red Eyes Correction"
msgstr "ការ​កែខៃ​ភ្នែកក្រហម"

#: imageplugins/imageeffect_redeye.cpp:231
msgid "Red Eye Correction"
msgstr "ការ​កែខៃ​ភ្នែកក្រហម"

#: imageplugins/imageeffect_redeye.cpp:237
msgid "Level of Red-Eye Correction"
msgstr "កម្រិត​​នៃការ​កែខៃ​ភ្នែក​ក្រហម"

#: imageplugins/imageeffect_redeye.cpp:241
msgid "Mild (use if other parts of the face are also selected)"
msgstr "ល្មម (ប្រើ បើ​ជ្រើស​ដោយ​ផ្នែក​ផ្សេង​ទៀត​របស់​ផ្ទៃ​មុខ)"

#: imageplugins/imageeffect_redeye.cpp:243
msgid "Aggressive (use if eye(s) have been selected exactly)"
msgstr "ខ្លាំង (ប្រើ បើ​ជ្រើស​ចំភ្នែក​ម៉ាច់ៗ)"

#: tips.cpp:3
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... that digiKam supports <b>Drag'n'Drop</b>? So you can easily move images "
"from Konqueror to digiKam or from digiKam to K3b simply by using "
"\"Drag'n'Drop\".\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... digiKam នោះ​គាំទ្រ <b>Drag'n'Drop</b>? ដូច្នេះ "
"អ្នក​អាច​ផ្លាស់ទី​រូបភាព​យ៉ាង​ងាយ​ពី Konqueror ទៅ digiKam ឬ​ពី digiKam ទៅ K3b "
"យ៉ាង​សមញ្ញា ដោយ​ប្រើ \"អូស និង​ទម្លាក់\" ។\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#: tips.cpp:19
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... that you can use nested albums in digiKam.\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... ដែល​អ្នក​អាច​ប្រើ​អាល់ប៊ុម​ខាង​ក្នុង​នៅ​ក្នុង digiKam ។\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#: tips.cpp:35
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... that you can view the <b>Exif</b>, <b>MakerNotes</b>, and <b>IPTC</b> "
"informations of a photo by using its <b>Metadata</b> sidebar tab?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... ដែល​អ្នក​អាច​មើលព័ត៌មាន <b>Exif</b>, <b>MakerNotes</b> និង​<b>IPTC</b> "
"របស់​រូបថត​ដោយ​ប្រើ​ផ្ទាំង​របារ​ចំហៀង <b>ទិន្នន័យ​មេតា</b> របស់​វា ?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#: tips.cpp:51
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... that each photo has a context menu that can be reached by clicking on it "
"with the right mouse button?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... ដែល​រូបភាព​នីមួយៗ​មានម៉ឺនុយ​បរិបទ ដែល​អាច​ត្រូវ​បាន​ចូល​ដោយ​ចុច​លើ​វា "
"ដោយ​ប្រើ​ប៊ូតុង​កណ្ដុរ​ខាង​ស្ដាំ ?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#: tips.cpp:67
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... that albums in digiKam are Folders in your Album Library? So you can easily "
"import your Photos by simply copying them to your Album Library.\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/digikam.png\">\n"
"</td>\n"
"<td>\n"
"... ដែល​អាល់ប៊ុម​នៅ​ក្នុង​ digiKam ជា​ថត​នៅ​ក្នុង​បណ្ណាល័យ​អាល់ប៊ុម​របស់​អ្នក ? "
"ដូច្នេះ​អ្នក​អាច​នាំចូល​រូបថត​របស់​អ្នក​យ៉ាង​ងាយ​ដោយ​ចម្លង​ពួកវា​ទៅ​ក្នុង​បណ្ណាល"
"័យ​អាល់ប៊ុម​របស់​អ្នក ។\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#: tips.cpp:83
msgid ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
