#: imageeffect_hotpixels.cpp:63 imageeffect_hotpixels.cpp:230
#: imageplugin_hotpixels.cpp:62
msgid "Hot Pixels Correction"
msgstr "កែខៃ​ភីកសែល​ងាប់"

#: imageeffect_hotpixels.cpp:65
msgid ""
"A digiKam image plugin for fixing dots produced by hot/stuck/dead pixels from a "
"CCD."
msgstr ""
"កម្មវិធី​ជំនួយ digiKam "
"ដើម្បី​កែខៃ​រូបភាព​ដែល​មាន​ចំណុច​តូចៗ​ដែល​បង្កើត​ដោយ​ភីកសែល​ងាប់ ឬ "
"ភីកសែល​ជាប់​ពី CCD ។"

#: imageeffect_hotpixels.cpp:72
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_hotpixels.cpp:75
msgid "Developer"
msgstr "​អ្នក​អភិវឌ្ឍន៍"

#: imageeffect_hotpixels.cpp:85
msgid "Filter:"
msgstr "​តម្រង ៖"

#: imageeffect_hotpixels.cpp:87
msgid "Average"
msgstr "​មធ្យម"

#: imageeffect_hotpixels.cpp:88
msgid "Linear"
msgstr "​លីនេអ៊ែរ"

#: imageeffect_hotpixels.cpp:89
msgid "Quadratic"
msgstr "​បួន​ជ្រុង"

#: imageeffect_hotpixels.cpp:90
msgid "Cubic"
msgstr "គូប"

#: imageeffect_hotpixels.cpp:92
msgid "Black Frame..."
msgstr "ស៊ុម​ពណ៌​ខ្មៅ..."

#: imageeffect_hotpixels.cpp:93
msgid ""
"<p>Use this button to add a new black frame file which will be used by the hot "
"pixels removal filter."
msgstr ""
"<p>ប្រើ​ប៊ូតុង​នេះ​ដើម្បី​បន្ថែម​ឯកសារ​ស៊ុម​ពណ៌​ខ្មៅ​ថ្មី "
"ដែល​នឹង​ត្រូវ​បាន​ប្រើ​ដោយ​តម្រង​ដែល​យក​ភីកសែល​ងាប់​ចេញ ។"

#: imageeffect_hotpixels.cpp:151
msgid "Select Black Frame Image"
msgstr "ជ្រើស​រូបភាព​ស៊ុម​ពណ៌​ខ្មៅ"

#: imageplugin_hotpixels.cpp:42
msgid "Hot Pixels Correction..."
msgstr "កែខៃ​ភីកសែល​ងាប់..."

