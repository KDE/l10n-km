#: imageeffect_charcoal.cpp:53 imageeffect_charcoal.cpp:58
msgid "Charcoal Drawing"
msgstr "​គំនូរធ្យូង"

#: imageeffect_charcoal.cpp:60
msgid "A charcoal drawing image effect plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ​បែបផែន​រូបភាពគំនូរ​ធ្យូង​សម្រា់ digiKam ។"

#: imageeffect_charcoal.cpp:66
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_charcoal.cpp:75
msgid "Pencil size:"
msgstr "​ទំហំ​ខ្មៅដៃ ៖"

#: imageeffect_charcoal.cpp:80
msgid "<p>Set here the charcoal pencil size used to simulate the drawing."
msgstr "​<p>កំណត់​ទំហំ​ខ្មៅ​ដៃ​ធ្យូង ដែល​ប្រើ​សម្រាប់​គូរ​​បន្លំ ។"

#: imageeffect_charcoal.cpp:87
msgid "Smooth:"
msgstr "​រលោង ៖"

#: imageeffect_charcoal.cpp:92
msgid "<p>This value controls the smoothing effect of the pencil under the canvas."
msgstr "​<p>តម្លៃ​នេះ​គ្រប់គ្រង​បែបផែន​ភាពរលោង​របស់​ខ្មៅដៃ​ នៅ​ខាង​ក្រោម​ផ្ទាំង​ក្រណាត់ ។"

#: imageeffect_charcoal.cpp:169
msgid "Charcoal"
msgstr "​ធ្យូង"

#: imageplugin_charcoal.cpp:43
msgid "Charcoal Drawing..."
msgstr "គំនូរ​ធ្យូង..."

