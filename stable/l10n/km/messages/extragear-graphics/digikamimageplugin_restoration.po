#: imageeffect_restoration.cpp:64 imageeffect_restoration.cpp:72
msgid "Photograph Restoration"
msgstr "ការ​ស្ដារ​រូបថត"

#: imageeffect_restoration.cpp:74
msgid "A digiKam image plugin to restore a photograph."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​របស់ digiKam ដើម្បី​ស្ដារ​រូបថត ។"

#: imageeffect_restoration.cpp:80
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ"

#: imageeffect_restoration.cpp:83
msgid "CImg library"
msgstr "បណ្ណាល័យ CImg"

#: imageeffect_restoration.cpp:86
msgid "Feedback and plugin polishing"
msgstr "ផ្ដល់​ជា​មតិយោបល់ និង​កែលម្អ​កម្មវិធី​ជំនួយ"

#: imageeffect_restoration.cpp:97
msgid "Preset"
msgstr "​កំណត់​​​ជាមុន"

#: imageeffect_restoration.cpp:105
msgid "Visit CImg library website"
msgstr "ទស្សនា​តំបន់​បណ្តាញ​​បណ្ណាល័យ CImg"

#: imageeffect_restoration.cpp:107
msgid "Filtering type:"
msgstr "ប្រភេទ​ការ​ត្រង ៖"

#: imageeffect_restoration.cpp:109
msgid "None"
msgstr "គ្មាន"

#: imageeffect_restoration.cpp:110
msgid "Reduce Uniform Noise"
msgstr "កាត់បន្ថយ​ការ​រំខាន​ដូចគ្នា"

#: imageeffect_restoration.cpp:111
msgid "Reduce JPEG Artefacts"
msgstr "កាត់​បន្ថយ JPEG Artefacts"

#: imageeffect_restoration.cpp:112
msgid "Reduce Texturing"
msgstr "កាត់​បន្ថយ​វាយនភាព"

#: imageeffect_restoration.cpp:113
msgid ""
"<p>Select here the filter preset to use for photograph "
"restoration:<p><b>None</b>: Most common values. Puts settings to "
"default.<p><b>Reduce Uniform Noise</b>: reduce small image artefacts like "
"sensor noise.<p><b>Reduce JPEG Artefacts</b>: reduce large image artefacts "
"like JPEG compression mosaic.<p><b>Reduce Texturing</b>: reduce image "
"artefacts like paper texture or Moire patterns of a scanned image.<p>"
msgstr ""
"<p>​នៅ​ទីនេះ ជ្រើស​តម្រង​​​កំណត់​​​ជាមុន​ដើម្បី​ប្រើ​​សម្រាប់​ស្ដារ​រូបថត ៖"
"<p><b>គ្មាន</b> ៖ តម្លៃ​​សាមញ្ញា​បំផុត ។ ដាក់​ការ​កំណត់​​ជា​លំនាំ​ដើម ។"
"<p><b>កាត់​បន្ថយ​​ភាព​​មិន​ច្បាស់​​ដូចៗ​គ្នា</b> ៖ កាត់​បន្ថយ​ artefacts​ "
"រូបភាព​តូច​ដូច​ជា​​ឧបករណ៍​ចាប់​សញ្ញា​សម្លេង ។"
"<p><b>កាត់​បន្ថយ JPEG Artefacts</b> ៖ កាត់​បន្ថយ artefacts "
"រូបភាព​ធំ​ដូចជា​មូសាអ៊ីក​បង្ហាប់ JPEG ។"
"<p><b>កាត់​បន្ថយ​វាយនភាព</b> ៖ កាត់​បន្ថយ artefacts "
"រូបភាព​ដូចជា​វាយនភាព​ក្រដាស់ ​ឬ ​លំនាំ​រស្មី​រលក​នៃ​រូបភាព​ដែល​បាន​ស្កេន "
"<p>"

#: imageeffect_restoration.cpp:129
msgid "Smoothing"
msgstr "ភាព​រលោង"

#: imageeffect_restoration.cpp:131
msgid "Detail preservation:"
msgstr "ការ​ការ​ពារ​សេចក្ដី​​លម្អិត ៖"

#: imageeffect_restoration.cpp:135
msgid ""
"<p>Preservation of details to set the sharpening level of the small features "
"in the target image. Higher values leave details sharp."
msgstr ""
"<p>ការ​ការពារ​សេចក្ដី​​​​​​លម្អិត "
"​ដើម្បី​កំណត់​​កម្រិត​ធ្វើ​ឲ្យ​​​ច្បាស់​នៃ​​លក្ខណៈ​​ពិសេស​តូច​មួយ​ក្នុង​រូបភាព​គោលដៅ ។ តម្លៃ​ខ្ពស់​ជាង​ទុក​សេចក្ដី​លម្អិត​ឲ្យ​​រឹត​តែ​​ច្បាស់ ។"

#: imageeffect_restoration.cpp:141
msgid "Anisotropy:"
msgstr "ទិស​​មិន​ស្មើ​គ្នា ៖"

#: imageeffect_restoration.cpp:145
msgid ""
"<p>Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr "<p>ឧបករណ៍​​កែប្រែ​​ទិស​មិន​ស្មើគ្នា ​(ទិស)​​ នៃ​សេចក្ដី​លម្អិត ។ ទុក​វា​ឲ្យ​តូច​សម្រាប់​ភាព​មិន​ច្បាស់ Gaussian ។"

#: imageeffect_restoration.cpp:149
msgid "Smoothing:"
msgstr "ភាព​រលោង ៖"

#: imageeffect_restoration.cpp:153
msgid ""
"<p>Total smoothing power: if Detail Factor sets the relative smoothing and "
"Gradient Factor the direction, Time Step sets the overall effect."
msgstr ""
"<p>ស្វ័យគុណ​ភាព​រលោង​​​សរុប ៖ "
"ប្រសិនបើ​កត្តាលម្អិត​កំណត់​ភាព​រលោង​​​ដែល​​ទំនាក់ទំនង និង​កត្តា​ជម្រាល​ទិស​ "
"ជំហា​នពេលវេលា​កំណត់​បែបផែន​ទាំ​ងមូល  ។"

#: imageeffect_restoration.cpp:158
msgid "Regularity:"
msgstr "ភាព​ប្រក្រតី ៖"

#: imageeffect_restoration.cpp:162
msgid ""
"<p>This value controls the smoothing regularity of the target image. Do not "
"use an high value here, or the target image will be completely blurred."
msgstr ""
"<p>តម្លៃ​នេះ​គ្រប់គ្រង​ភាព​ប្រក្រតី​នៃ​ភាព​រលោង​​របស់​រូបភាពគោលដៅ ។ "
"សូម​កុំប្រើ​តម្លៃ​ខ្ពស់​ពេក បើ​ពុំ​នោះ​ទេ "
"រូបភាព​គោលដៅ​នឹង​ក្លាយ​ទៅ​ជា​ព្រិល​មើល​លែង​កើត​ហើយ ។"

#: imageeffect_restoration.cpp:168
msgid "Iterations:"
msgstr "ធ្វើ​ឡើង​វិញ ៖"

#: imageeffect_restoration.cpp:172
msgid "<p>Sets the number of times the filter is applied on the target image."
msgstr "<p>កំណត់​ចំនួន​ពេលវេលា​ដែល​តម្រង​ត្រូវ​បាន​អនុវត្ត​លើ​រូបភាព​គោលដៅ ។"

#: imageeffect_restoration.cpp:180
msgid "Advanced Settings"
msgstr "ការ​កំណត់​កម្រិត​ខ្ពស់"

#: imageeffect_restoration.cpp:182
msgid "Angular step:"
msgstr "ជំហាន​ច្រើន​ជ្រុង ៖"

#: imageeffect_restoration.cpp:186
msgid "<p>Set here the angular integration step in degrees in analogy to anisotropy."
msgstr "<p>នៅ​ទីនេះ កំណត់​ជំហាន​រួមបញ្ចូល​គ្នា​គិត​ជា​ដឺក្រេ​រវាង​ភាព​ស្រដៀង​គ្នា និង​ទិស​មិន​ស្មើ​គ្នា ។"

#: imageeffect_restoration.cpp:190
msgid "Integral step:"
msgstr "ជំហាន​អាំងតេក្រាល ៖"

#: imageeffect_restoration.cpp:194
msgid "<p>Set here the spatial integral step. Stay below 1."
msgstr "<p>កំណត់​ជំហាន​អាំងតេក្រាល​ទំហំ ។ នៅ​ក្រោម ១ ។"

#: imageeffect_restoration.cpp:198
msgid "Gaussian:"
msgstr "ហ្គូសៀន ៖"

#: imageeffect_restoration.cpp:202
msgid "<p>Set here the precision of the Gaussian function."
msgstr "<p>កំណត់​ចំនួន​ខ្ទង់​នៃ​អនុគមន៍​ហ្គូសៀន ។"

#: imageeffect_restoration.cpp:206
msgid "Use linear interpolation"
msgstr "ប្រើ​ការ​ថែមថយ​លីនេអ៊ែរ"

#: imageeffect_restoration.cpp:207
msgid "<p>Enable this option to quench the last bit of quality (slow)."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​បង្ក្រាប​ប៊ីត​ចុងក្រោយ​របស់​គុណភាព (យឺត) ។"

#: imageeffect_restoration.cpp:210
msgid "Normalize photograph"
msgstr "ធ្វើឲ្យ​រូបថត​​សាមញ្ញ"

#: imageeffect_restoration.cpp:211
msgid "<p>Enable this option to process an output image normalization."
msgstr ""
"<p>បើក​ជម្រើស​នេះ "
"ដើម្បី​ដំណើរការ​ការ​ធ្វើ​ឲ្យ​រូបភាព​លទ្ធផល​មាន​លក្ខណៈ​សាមញ្ញ ។"

#: imageeffect_restoration.cpp:399
msgid "Restoration"
msgstr "ការ​ស្ដារ"

#: imageeffect_restoration.cpp:407
msgid "Photograph Restoration Settings File to Load"
msgstr "ឯកសារ​កំណត់​ការ​ស្ដារ​រូបថត​ត្រូវ​​ផ្ទុក"

#: imageeffect_restoration.cpp:419
msgid "\"%1\" is not a Photograph Restoration settings text file."
msgstr "\"%1\" មិនមែន​ជា​ឯកសារ​អត្ថបទ​​កំណត់​ការ​ស្ដារ​រូបថត​ទេ ។"

#: imageeffect_restoration.cpp:441
msgid "Cannot load settings from the Photograph Restoration text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពី​ឯកសារ​អត្ថបទ​​ស្ដារ​រូបថត​បាន​ទេ ។"

#: imageeffect_restoration.cpp:450
msgid "Photograph Restoration Settings File to Save"
msgstr "ឯកសារ​កំណត់​ការ​ស្ដារ​រូបថត​ត្រូវ​រក្សាទុក"

#: imageeffect_restoration.cpp:472
msgid "Cannot save settings to the Photograph Restoration text file."
msgstr "មិន​អាច​រក្សាទុក​​ការ​កំណត់​ទៅ​កាន់​​​ឯកសារ​អត្ថបទ​ស្ដារ​រូបថត​បាន​ទេ ។"

#: imageplugin_restoration.cpp:42
msgid "Restoration..."
msgstr "ការ​ស្ដារ..."

