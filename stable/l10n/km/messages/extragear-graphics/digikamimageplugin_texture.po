#: imageeffect_texture.cpp:99
msgid "<p>Set here the texture type to apply on image."
msgstr "<p>នៅ​ទីនេះ កំណត់​ប្រភេទ​វាយនភាព​ដើម្បី​អនុវត្ត​លើ​រូបភាព ។"

#: imageeffect_texture.cpp:106
msgid "Relief:"
msgstr "ក្បាច់ ៖"

#: imageeffect_texture.cpp:111
msgid "<p>Set here the relief gain used to merge texture and image."
msgstr ""
"<p>​នៅ​ទីនេះ កំណត់​ក្បាច់​​ដែល​ត្រូវ​ប្រើ​ដើម្បី​បញ្ចូល​រូបភាព​និង​វាយនភាព ។"

