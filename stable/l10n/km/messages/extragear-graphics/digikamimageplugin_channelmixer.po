#: channelmixer.cpp:83 channelmixer.cpp:91
msgid "Color Channel Mixer"
msgstr "​ឧបករណ៍​លាយ​ពណ៌​ឆានែល​"

#: channelmixer.cpp:93
msgid "An image color channel mixer plugin for digiKam."
msgstr "កម្មវិធីជំនួយ ​digiKam ឲ្យមាន​ឧបករណ៍​លាយ​ពណ៌​​ឆានែល​របស់​រូបភាព ។"

#: channelmixer.cpp:99
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: channelmixer.cpp:109
msgid "Channel:"
msgstr "ឆានែល​ ៖"

#: channelmixer.cpp:112 channelmixer.cpp:115
msgid "Red"
msgstr "ពណ៌​ក្រហម"

#: channelmixer.cpp:113
msgid "Green"
msgstr "ពណ៌​បៃតង"

#: channelmixer.cpp:114
msgid "Blue"
msgstr "ពណ៌​ខៀវ"

#: channelmixer.cpp:116
msgid ""
"<p>Select here the color channel to mix:<p><b>Red</b>: display the red "
"image-channel values.<p><b>Green</b>: display the green image-channel "
"values.<p><b>Blue</b>: display the blue image-channel values.<p>"
msgstr "<p>នៅ​ទីនេះ ជ្រើស​ឆានែល​ពណ៌​ដើម្បី​លាយ ៖<p><b>ពណ៌​ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ក្រហម ។<p><b>ពណ៌​បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​បៃតង ។<p><b>ពណ៌​ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ខៀវ ។<p>"

#: channelmixer.cpp:125
msgid ""
"<p>Select here the histogram scale.<p>If the image's maximal counts are "
"small, you can use the linear scale.<p>Logarithmic scale can be used when "
"the maximal counts are big; if it is used, all values (small and large) will "
"be visible on the graph."
msgstr "<p>នៅ​ទីនេះ ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម ។<p>ប្រសិន​បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​តូច អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។<p>មាត្រដ្ឋាន​លោការីត​អាច​ត្រូវ​បាន​ប្រើ នៅ​ពេល​អតិបរមា​ធំ ប្រសិន​បើ​វា​ត្រូវ​បាន​ប្រើ តម្លៃ​ទាំងអស់ (តូច និង​ធំ) នឹង​អាច​មើល​ឃើញ​នៅ​លើ​ក្រាហ្វិក ។"

#: channelmixer.cpp:131
msgid "<p>Linear"
msgstr "<p>លីនេអ៊ែរ"

#: channelmixer.cpp:139
msgid "<p>Logarithmic"
msgstr "<p>លោការីត"

#: channelmixer.cpp:155
msgid ""
"<p>Here you can see the target preview image histogram drawing of the "
"selected image channel. This one is re-computed at any mixer settings "
"changes."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​ឃើញ​គំនូរ​អ៊ីស្តូក្រាម​រូបភាព​មើល​ជា​មុន​របស់​ឆានែល​រូបភាព​ដែល​បាន​ជ្រើស ។ នេះ​ជា​រូបភាព​មួយ​​ដែល​ត្រូវ​បាន​គណនា​នៅ​ពេល​ផ្លាស់ប្ដូរ​ការ​កំណត់​របស់​ឧបករណ៍​លាយ​ណា​មួយ ។"

#: channelmixer.cpp:167
msgid "Red:"
msgstr "ពណ៌​ក្រហម ៖"

#: channelmixer.cpp:171
msgid "<p>Select here the red color gain in percent for the current channel."
msgstr "<p>នៅ​ទីនេះ​ ជ្រើសការ​ទទួល​ពណ៌​ក្រហម​គិត​ជា​ភាគ​រយ​សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:173
msgid "Blue:"
msgstr "ពណ៌​ខៀវ ៖"

#: channelmixer.cpp:177
msgid "<p>Select here the green color gain in percent for the current channel."
msgstr "<p>នៅ​ទីនេះ ជ្រើស​ការ​ទទួល​ពណ៌​បៃតង​គិត​ជា​ភាគរយ​សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:179
msgid "Green:"
msgstr "ពណ៌​បៃតង ៖"

#: channelmixer.cpp:183
msgid "<p>Select here the blue color gain in percent for the current channel."
msgstr "<p>នៅ​ទីនេះ ជ្រើស​ការ​ទទួល​ពណ៌​ខៀវ​គិត​ជា​ភាគ​រយ​សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:185
msgid "&Reset"
msgstr "កំណត់​ឡើងវិញ"

#: channelmixer.cpp:186
msgid "Reset color channels' gains settings from the currently selected channel."
msgstr "កំណត់​កា​រកំណត់​ទទួល​របស់​ឆានែល​ពណ៌​ពី​ឆានែល​ដែល​បានជ្រើស​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:198
msgid "Monochrome"
msgstr "មួយ​ពណ៌"

#: channelmixer.cpp:199
msgid ""
"<p>Enable this option if you want rendering of the image in monochrome mode. "
"In this mode, histogram will display only luminosity values."
msgstr ""
"<p>បើក​ជម្រើស​នេះ ប្រសិន​បើ​អ្នក​ចង់​បង្ហាញ​រូបភាព​រូបភាព​ក្នុង​របៀប​មួយ​ពណ៌ ។ "
"នៅ​ក្នុង​របៀប​នេះ អ៊ីស្តូក្រាម​នឹង​បង្ហាញ​តែ​តម្លៃ​ពន្លឺ​ប៉ុណ្ណោះ ។"

#: channelmixer.cpp:202
msgid "Preserve luminosity"
msgstr "ការពារ​ពន្លឺ"

#: channelmixer.cpp:203
msgid "<p>Enable this option is you want preserve the image luminosity."
msgstr "<p>បើក​ជម្រើស​នេះ​គឺ​អ្នក​ចង់​ការពារ​ពន្លឺ​រូបភាព ។"

#: channelmixer.cpp:205
msgid "Over exposure indicator"
msgstr "លើ​ឧបករណ៍​បង្ហាញ​ការ​ផ្សាយ​"

#: channelmixer.cpp:206
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image "
"preview will be over-colored. This will not have an effect on the final "
"rendering."
msgstr "<p>ប្រសិន​បើអ្នក​បើក​ជម្រើស ភីកសែល​ដែល​បានបង្ហញ​ពីលើ​​រូបភាព​គោលដៅ ​ទិដ្ឋភាព​មើល​ជា​មុន​នឹង​មាន​ពណ៌​នៅ​ពីលើ ។ វា​នឹង​គ្មាន​ឥទ្ធិពល​លើ​ការ​បង្ហាញចុង​បញ្ចប់​ទេ ។"

#: channelmixer.cpp:221
msgid ""
"<p>You can see here the image's color channels' gains adjustments preview. "
"You can pick color on image to see the color level corresponding on "
"histogram."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាចមើល​​ឃើញ​ទិដ្ឋភាព​លៃតម្រូវ​ជា​មុន​នៃ​​ការ​ទទួល​ពណ៌​របស់​ឆានែល​ពណ៌​របស់​រូបភាព ។ អ្នក​អាច​ជ្រើស​ពណ៌​នៅ​លើ​រូបភាព​ដើម្បី​មើល​កម្រិត​ពណ៌​ដែលទាក់ទង​នឹង​អ៊ីស្តូក្រាម ។"

#: channelmixer.cpp:493
msgid "Channel Mixer"
msgstr "ឧបករណ៍​លាយ​ឆានែល"

#: channelmixer.cpp:584
msgid "Select Gimp Gains Mixer File to Load"
msgstr "ជ្រើស​ឯកសារ​ឧបករណ៍​លាយ​ការ​ទទួល​របស់ Gimp ត្រូវ​ផ្ទុក"

#: channelmixer.cpp:656
msgid "Cannot load settings from the Gains Mixer text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពី​ឯកសារ​អត្ថបទ​ឧបករណ៍​លាយ​ការ​ទទួល​ ។"

#: channelmixer.cpp:669
msgid "Gimp Gains Mixer File to Save"
msgstr "ឯកសារ​ឧបករណ៍​លាយ​ការ​ទទួល​របស់ Gimp ​ត្រូវ​រក្សាទុក"

#: channelmixer.cpp:731
msgid "Cannot save settings to the Gains Mixer text file."
msgstr "មិនអាច​រក្សាទុក​កា​រកំណត់​ទៅ​កាន់​ឯកសារ​អត្ថបទ​ឧបករណ៍​លាយ​​ការ​ទទួល ។"

#: imageplugin_channelmixer.cpp:44
msgid "Channel Mixer..."
msgstr "ឧបករណ៍​លាយ​ឆានែល..."

