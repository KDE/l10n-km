#: channelmixer.cpp:83 channelmixer.cpp:91
msgid "Color Channel Mixer"
msgstr "​ឧបករណ៍​លាយ​ពណ៌​ឆានែល​"

#: channelmixer.cpp:93
msgid "An image color channel mixer plugin for digiKam."
msgstr "កម្មវិធីជំនួយ ​digiKam ឲ្យមាន​ឧបករណ៍លាយពណ៌​​ឆានែល​របស់​រូបភាព ។"

#: channelmixer.cpp:99
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: channelmixer.cpp:109
msgid "Channel:"
msgstr "​ឆានែល​ ៖"

#: channelmixer.cpp:112 channelmixer.cpp:115
msgid "Red"
msgstr "​ក្រហម"

#: channelmixer.cpp:113
msgid "Green"
msgstr "​បៃតង"

#: channelmixer.cpp:114
msgid "Blue"
msgstr "​ខៀវ"

#: channelmixer.cpp:116
msgid ""
"<p>Select here the color channel to mix:"
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p>"
msgstr ""
"<p>ជ្រើស​ឆានែល​ពណ៌​នៅទីនេះ ដើម្បី​លាយ ៖"
"<p><b>ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​​ពណ៌ក្រហម​របស់​រូបភាព ។"
"<p><b>បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​ពណ៌បៃតង​របស់​រូបភាព ។"
"<p><b>ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​​ពណ៌ខៀវ​របស់​រូបភាព ។"
"<p>"

#: channelmixer.cpp:125
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: channelmixer.cpp:131
msgid "<p>Linear"
msgstr "​<p>លីនេអ៊ែរ"

#: channelmixer.cpp:139
msgid "<p>Logarithmic"
msgstr "<p>លោការីត"

#: channelmixer.cpp:155
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any mixer settings changes."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ទិដ្ឋភាព​អ៊ីស្តូក្រាម​របស់​រូបភាព​គោលដៅ នៃ​ឆានែល​រូបភាព​ដែល​បាន​ជ្រើស ។ វា​នឹង​ត្រូវ​បាន​គណនា​ឡើង​វិញ រាល់​ពេល​ដែល​ផ្លាស់ប្ដូរ​ការ​កំណត់​ឧបករណ៍​លាយ ។"

#: channelmixer.cpp:167
msgid "Red:"
msgstr "​​ក្រហម ៖"

#: channelmixer.cpp:171
msgid "<p>Select here the red color gain in percent for the current channel."
msgstr "<p>ជ្រើស​លទ្ធផល​ពណ៌​ក្រហម​គិត​ជា​ភាគរយ សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:173
msgid "Blue:"
msgstr "​ខៀវ ៖"

#: channelmixer.cpp:177
msgid "<p>Select here the green color gain in percent for the current channel."
msgstr "<p>ជ្រើស​លទ្ធផល​ពណ៌​ខៀវ​គិត​ជា​ភាគរយ សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:179
msgid "Green:"
msgstr "បៃតង ៖"

#: channelmixer.cpp:183
msgid "<p>Select here the blue color gain in percent for the current channel."
msgstr "<p>ជ្រើស​លទ្ធផល​ពណ៌​បៃតង​គិត​ជា​ភាគរយ សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:185
msgid "&Reset"
msgstr "​កំណត់​ឡើង​វិញ"

#: channelmixer.cpp:186
msgid "Reset color channels' gains settings from the currently selected channel."
msgstr "កំណត់​ការ​កំណត់​លទ្ធផល​របស់​ឆានែល​ពណ៌​ពី​ឆានែល​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:198
msgid "Monochrome"
msgstr "​មួយ​ពណ៌"

#: channelmixer.cpp:199
msgid ""
"<p>Enable this option if you want rendering of the image in monochrome mode. In "
"this mode, histogram will display only luminosity values."
msgstr "<p>ធីក​ជម្រើស​នេះ​​ បើ​អ្នក​ចង់​បង្ហាញ​រូបភាព​នៅក្នុង​របៀប​មួយពណ៌ ។ ក្នុងរបៀបនេះ អ៊ីស្តូក្រាម​​នឹង​បង្ហាញ​តែតម្លៃ​ពន្លឺ​​ប៉ុណ្ណោះ ។"

#: channelmixer.cpp:202
msgid "Preserve luminosity"
msgstr "ការពារ​ពន្លឺ"

#: channelmixer.cpp:203
msgid "<p>Enable this option is you want preserve the image luminosity."
msgstr "<p>ធីក​ជម្រើស​​នេះ​ បើ​អ្នក​ចង់​ការពារ​ពន្លឺ​រូបភាព ។"

#: channelmixer.cpp:205
msgid "Over exposure indicator"
msgstr "ចង្អុល​បង្ហាញ​ការ​បង្ហាញ​លើស"

#: channelmixer.cpp:206
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr "<p>បើ​អ្នក​ធីក​ជម្រើស​នេះ ភីកសែល​ដែល​បង្ហាញ​លើស​ទិដ្ឋភាព​របស់​រូបភាព​គោលដៅ នឹង​ត្រូវ​បាន​ផាត់​ពណ៌​លើស​គេ ។ វា​នឹង​មិន​ប៉ះពាល់​ដល់​ការ​បង្ហាញ​ចុងក្រោយ​ឡើយ ។"

#: channelmixer.cpp:221
msgid ""
"<p>You can see here the image's color channels' gains adjustments preview. You "
"can pick color on image to see the color level corresponding on histogram."
msgstr "<p>អ្នកអាច​មើល​ទិដ្ឋភាព​នៃ​​ការលៃតម្រូវ​លទ្ធផល​ឆានែល​ពណ៌​របស់​រូបភាព នៅ​ទីនេះ ។ អ្នកអាច​​រើស​ពណ៌​នៅលើ​រូបភាព ដើម្បី​មើល​ទំនាក់ទំនង​កម្រិត​ពណ៌​នៅ​លើ​អ៊ីស្តូក្រាម ។"

#: channelmixer.cpp:493
msgid "Channel Mixer"
msgstr "ឧបករណ៍​លាយ​ឆានែល"

#: channelmixer.cpp:584
msgid "Select Gimp Gains Mixer File to Load"
msgstr "ជ្រើស​ឯកសារ​ឧបករណ៍លាយ​លទ្ធផល​របស់ Gimp ដើម្បី​ផ្ទុក"

#: channelmixer.cpp:656
msgid "Cannot load settings from the Gains Mixer text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពី​ឯកសារ​អត្ថបទ​ឧបករណ៍​លាយ​លទ្ធផល​បាន​ឡើយ ។"

#: channelmixer.cpp:669
msgid "Gimp Gains Mixer File to Save"
msgstr "ឯកសារ​ឧបករណ៍​លាយ​លទ្ធផល​របស់ Gimp ដែល​ត្រូវ​រក្សាទុក"

#: channelmixer.cpp:731
msgid "Cannot save settings to the Gains Mixer text file."
msgstr "មិនអាច​រក្សា​ទុក​ការកំណត់​​ទៅ​កាន់​​ឯកសារ​អត្ថបទ​ឧបករណ៍​លាយ​លទ្ធផល​បាន​ឡើយ ។"

#: imageplugin_channelmixer.cpp:44
msgid "Channel Mixer..."
msgstr "ឧបករណ៍​លាយ​ឆានែល..."

