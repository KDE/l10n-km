#: channelmixer.cpp:86 imageplugin_channelmixer.cpp:64
msgid "Color Channel Mixer"
msgstr "​ឧបករណ៍​លាយ​ពណ៌​ឆានែល​"

#: channelmixer.cpp:88
msgid "An image color channel mixer plugin for digiKam."
msgstr "កម្មវិធីជំនួយ ​digiKam ឲ្យមាន​ឧបករណ៍លាយពណ៌​​ឆានែល​របស់​រូបភាព ។"

#: channelmixer.cpp:94
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: channelmixer.cpp:102
msgid ""
"<p>You can see here the image's color channels' gains adjustments preview. You "
"can pick color on image to see the color level corresponding on histogram."
msgstr ""
"<p>អ្នកអាច​មើល​ទិដ្ឋភាព​នៃ​​ការលៃតម្រូវ​លទ្ធផល​ឆានែល​ពណ៌​របស់​រូបភាព នៅ​ទីនេះ ។ "
"អ្នកអាច​​រើស​ពណ៌​នៅលើ​រូបភាព "
"ដើម្បី​មើល​ទំនាក់ទំនង​កម្រិត​ពណ៌​នៅ​លើ​អ៊ីស្តូក្រាម ។"

#: channelmixer.cpp:112
msgid "Channel:"
msgstr "​ឆានែល​ ៖"

#: channelmixer.cpp:115 channelmixer.cpp:118
msgid "Red"
msgstr "​ក្រហម"

#: channelmixer.cpp:116
msgid "Green"
msgstr "​បៃតង"

#: channelmixer.cpp:117
msgid "Blue"
msgstr "​ខៀវ"

#: channelmixer.cpp:119
msgid ""
"<p>Select here the color channel to mix:"
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p>"
msgstr ""
"<p>ជ្រើស​ឆានែល​ពណ៌​នៅទីនេះ ដើម្បី​លាយ ៖"
"<p><b>ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​​ពណ៌ក្រហម​របស់​រូបភាព ។"
"<p><b>បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​ពណ៌បៃតង​របស់​រូបភាព ។"
"<p><b>ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​​ពណ៌ខៀវ​របស់​រូបភាព ។"
"<p>"

#: channelmixer.cpp:128
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ "
"បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: channelmixer.cpp:134
msgid "<p>Linear"
msgstr "​<p>លីនេអ៊ែរ"

#: channelmixer.cpp:142
msgid "<p>Logarithmic"
msgstr "<p>លោការីត"

#: channelmixer.cpp:158
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any mixer settings changes."
msgstr ""
"<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ទិដ្ឋភាព​អ៊ីស្តូក្រាម​របស់​រូបភាព​គោលដៅ "
"នៃ​ឆានែល​រូបភាព​ដែល​បាន​ជ្រើស ។ វា​នឹង​ត្រូវ​បាន​គណនា​ឡើង​វិញ "
"រាល់​ពេល​ដែល​ផ្លាស់ប្ដូរ​ការ​កំណត់​ឧបករណ៍​លាយ ។"

#: channelmixer.cpp:170
msgid "Red:"
msgstr "​​ក្រហម ៖"

#: channelmixer.cpp:174
msgid "<p>Select here the red color gain in percent for the current channel."
msgstr "<p>ជ្រើស​លទ្ធផល​ពណ៌​ក្រហម​គិត​ជា​ភាគរយ សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:176
msgid "Blue:"
msgstr "​ខៀវ ៖"

#: channelmixer.cpp:180
msgid "<p>Select here the green color gain in percent for the current channel."
msgstr "<p>ជ្រើស​លទ្ធផល​ពណ៌​ខៀវ​គិត​ជា​ភាគរយ សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:182
msgid "Green:"
msgstr "បៃតង ៖"

#: channelmixer.cpp:186
msgid "<p>Select here the blue color gain in percent for the current channel."
msgstr "<p>ជ្រើស​លទ្ធផល​ពណ៌​បៃតង​គិត​ជា​ភាគរយ សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:188
msgid "&Reset"
msgstr "​កំណត់​ឡើង​វិញ"

#: channelmixer.cpp:189
msgid ""
"Reset color channels' gains settings from the currently selected channel."
msgstr ""
"កំណត់​ការ​កំណត់​លទ្ធផល​របស់​ឆានែល​ពណ៌​ពី​ឆានែល​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន ។"

#: channelmixer.cpp:201
msgid "Monochrome"
msgstr "​មួយ​ពណ៌"

#: channelmixer.cpp:202
msgid ""
"<p>Enable this option if you want the image rendered in monochrome mode. In "
"this mode, the histogram will display only luminosity values."
msgstr ""
"<p>អនុញ្ញាត​​ជម្រើស​នេះ​​ "
"ប្រសិន​បើ​​អ្នក​ចង់​បង្ហាញ​រូបភាព​នៅក្នុង​របៀប​មួយពណ៌ ។ក្នុងរបៀបនេះ "
"អ៊ីស្តូក្រាម​​នឹង​បង្ហាញ​តែតម្លៃ​ពន្លឺ​​ប៉ុណ្ណោះ ។"

#: channelmixer.cpp:205
msgid "Preserve luminosity"
msgstr "ការពារ​ពន្លឺ"

#: channelmixer.cpp:206
msgid "<p>Enable this option is you want preserve the image luminosity."
msgstr "<p>ធីក​ជម្រើស​​នេះ​ បើ​អ្នក​ចង់​ការពារ​ពន្លឺ​រូបភាព ។"

#: channelmixer.cpp:464
msgid "Channel Mixer"
msgstr "ឧបករណ៍​លាយ​ឆានែល"

#: channelmixer.cpp:614
msgid "Select Gimp Gains Mixer File to Load"
msgstr "ជ្រើស​ឯកសារ​ឧបករណ៍លាយ​លទ្ធផល​របស់ Gimp ដើម្បី​ផ្ទុក"

#: channelmixer.cpp:686
msgid "Cannot load settings from the Gains Mixer text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពី​ឯកសារ​អត្ថបទ​ឧបករណ៍​លាយ​លទ្ធផល​បាន​ឡើយ ។"

#: channelmixer.cpp:699
msgid "Gimp Gains Mixer File to Save"
msgstr "ឯកសារ​ឧបករណ៍​លាយ​លទ្ធផល​របស់ Gimp ដែល​ត្រូវ​រក្សាទុក"

#: channelmixer.cpp:761
msgid "Cannot save settings to the Gains Mixer text file."
msgstr ""
"មិនអាច​រក្សា​ទុក​ការកំណត់​​ទៅ​កាន់​​ឯកសារ​អត្ថបទ​ឧបករណ៍​លាយ​លទ្ធផល​បាន​ឡើយ ។"

#: imageplugin_channelmixer.cpp:43
msgid "Channel Mixer..."
msgstr "ឧបករណ៍​លាយ​ឆានែល..."

