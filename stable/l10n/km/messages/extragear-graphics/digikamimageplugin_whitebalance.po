#: imageeffect_whitebalance.cpp:78 imageplugin_whitebalance.cpp:63
msgid "White Color Balance Correction"
msgstr "ការ​កែ​តុល្យភាព​ពណ៌​ស"

#: imageeffect_whitebalance.cpp:80
msgid "A digiKam image plugin to correct white color balance."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព digiKam ​ដើម្បី​កែ​តុល្យភាព​ពណ៌ស ។"

#: imageeffect_whitebalance.cpp:86
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ"

#: imageeffect_whitebalance.cpp:89
msgid "White color balance correction algorithm"
msgstr "ក្បួន​ដោះស្រាយ​ការ​កែ​តុល្យភាព​ពណ៌ស"

#: imageeffect_whitebalance.cpp:97
msgid ""
"<p>You can see here the image's white-balance adjustments preview. You can pick "
"color on image to see the color level corresponding on histogram."
msgstr ""
"<p>នៅ​ទីនេះ "
"អ្នក​អាច​មើល​​ការ​លៃ​តម្រូវ​តុល្យភាព​ពណ៌​ស​របស់​រូបភាព​ជាមុន ។អ្នក​អាច​យក​ពណ៌​នៅ"
"លើ​រូបភាព ​ដើម្បើ​មើល​កម្រិត​ពណ៌​ដែល​ទាក់ទង​នឹង​អ៊ីស្តូក្រាម ។"

#: imageeffect_whitebalance.cpp:109
msgid "Channel:"
msgstr "​ឆានែល​ ៖"

#: imageeffect_whitebalance.cpp:112
msgid "Luminosity"
msgstr "ពន្លឺ"

#: imageeffect_whitebalance.cpp:113
msgid "Red"
msgstr "​ក្រហម"

#: imageeffect_whitebalance.cpp:114
msgid "Green"
msgstr "​បៃតង"

#: imageeffect_whitebalance.cpp:115
msgid "Blue"
msgstr "​ខៀវ"

#: imageeffect_whitebalance.cpp:116
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p>"
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​ឆានែល​អ៊ីស្តូក្រាម​ដើម្បី​បង្ហាញ ៖"
"<p><b>ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។"
"<p><b>ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ពណ៌​ក្រហម​របស់​ឆានែល​រូបភាព ។"
"<p><b>បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ពណ៌​បៃតង​របស់​ឆានែល​រូបភាព ។"
"<p><b>ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ពណ៌​ខៀវ​របស់​ឆានែល​រូបភាព ។"
"<p>"

#: imageeffect_whitebalance.cpp:126
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ "
"បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: imageeffect_whitebalance.cpp:133
msgid "<p>Linear"
msgstr "​<p>លីនេអ៊ែរ"

#: imageeffect_whitebalance.cpp:141
msgid "<p>Logarithmic"
msgstr "​<p>លោការីត"

#: imageeffect_whitebalance.cpp:158
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any filter settings changes."
msgstr ""
"<p>នៅ​ទីនេះ "
"អ្នក​អាច​មើល​អ៊ីស្តូក្រាម​រូបភាព​គោលដៅ​​ជា​មុន​ដោយ​គូរ​​​​ឆានែល​រូបភាព​​ដែល​បាន​"
"ជ្រើស ។ "
"​វា​​ត្រូវ​បាន​គណនា​ឡើងវិញ​នៅ​ពេល​មាន​ការ​ផ្លាស់ប្ដូរ​ការ​កំណត់​​តម្រង​​ណាមួយ ។"

#: imageeffect_whitebalance.cpp:172
msgid "Exposure (EV):"
msgstr "ការ​បង្ហាញ (EV) ៖"

#: imageeffect_whitebalance.cpp:175
msgid "Auto exposure adjustments"
msgstr "លៃ​តម្រូវ​ការ​បង្ហាញ​ដោយ​ស្វ័យប្រវត្តិ"

#: imageeffect_whitebalance.cpp:176
msgid ""
"<p>With this button, you can automatically adjust Exposure and Black Point "
"values."
msgstr ""
"<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នក​អាច​លៃតម្រូវ​តម្លៃ​បង្ហាញ "
"និង​ចំណុច​ខ្មៅ​ដោយ​ស្វ័យ​ប្រវត្តិ ។"

#: imageeffect_whitebalance.cpp:181
msgid "<p>Set here the Exposure Value (EV)."
msgstr "<p>នៅ​ទីនេះ កំណត់​តម្លៃ​បង្ហាញ (EV) ។"

#: imageeffect_whitebalance.cpp:183
msgid "Black point:"
msgstr "ចំណុច​ខ្មៅ ៖"

#: imageeffect_whitebalance.cpp:187
msgid "<p>Set here the black level value."
msgstr "<p>កំណត់​តម្លៃ​កម្រិត​ពណ៌​ខ្មៅ​នៅ​ទីនេះ ។"

#: imageeffect_whitebalance.cpp:189
msgid "Shadows:"
msgstr "ស្រមោល ៖"

#: imageeffect_whitebalance.cpp:193
msgid "<p>Set here the shadows noise suppresion level."
msgstr "<p>នៅ​ទីនេះ កំណត់​កម្រិត​សង្កត់​​ភាព​មិន​ច្បាស់​នៃ​ស្រមោល ។"

#: imageeffect_whitebalance.cpp:195
msgid "Saturation:"
msgstr "តិត្ថិភាព ៖"

#: imageeffect_whitebalance.cpp:199
msgid "<p>Set here the saturation value."
msgstr "<p>កំណត់​តម្លៃ​តិត្ថិភាព​នៅ​ទីនេះ ។"

#: imageeffect_whitebalance.cpp:201
msgid "Gamma:"
msgstr "​ហ្គាម៉ា ៖"

#: imageeffect_whitebalance.cpp:205
msgid "<p>Set here the gamma correction value."
msgstr "<p>កំណត់​តម្លៃ​​កែ​របស់​ហ្គាម៉ា​នៅ​ទីនេះ  ។"

#: imageeffect_whitebalance.cpp:209
msgid "Temperature (K):"
msgstr "សីតុណ្ហភាព (K) ៖"

#: imageeffect_whitebalance.cpp:213
msgid "<p>Set here the white balance color temperature in Kelvin."
msgstr "<p>កំណត់​សីតុណ្ហភាព​តុល្យភាព​ពណ៌​ស​​​ជា​កែលវិន​នៅ​ទីនេះ ។"

#: imageeffect_whitebalance.cpp:215
msgid "Preset:"
msgstr "កំណត់​ជា​មុន ៖"

#: imageeffect_whitebalance.cpp:217
msgid "40W Lamp"
msgstr "ពន្លឺ ៤0 វ៉ាត់"

#: imageeffect_whitebalance.cpp:218
msgid "200W Lamp"
msgstr "ពន្លឺ ២00 វ៉ាត់"

#: imageeffect_whitebalance.cpp:219
msgid "Sunrise"
msgstr "ព្រះ​អាទិត្យ​រះ"

#: imageeffect_whitebalance.cpp:220
msgid "Tungsten Lamp"
msgstr "ពន្លឺ​តង់ស្តែន"

#: imageeffect_whitebalance.cpp:221
msgid "Neutral"
msgstr "ពណ៌​ស៊ីគ្នា"

#: imageeffect_whitebalance.cpp:222
msgid "Xenon Lamp"
msgstr "ពន្លឺ​​សេណុង"

#: imageeffect_whitebalance.cpp:223
msgid "Sun"
msgstr "​ព្រះ​អាទិត្យ"

#: imageeffect_whitebalance.cpp:224
msgid "Photo Flash"
msgstr "​ពន្លឺ​រូបថត"

#: imageeffect_whitebalance.cpp:225
msgid "Sky"
msgstr "​មេឃ"

#: imageeffect_whitebalance.cpp:226
msgid "None"
msgstr "​គ្មាន"

#: imageeffect_whitebalance.cpp:227
msgid ""
"<p>Select here the white balance color temperature preset to use:"
"<p><b>40W Lamp</b>: 40 Watt incandescent lamp (2680K)."
"<p><b>200W Lamp</b>: 200 Watt incandescent lamp (3000K)."
"<p><b>Sunrise</b>: sunrise or sunset light (3200K)."
"<p><b>Tungsten Lamp</b>: tungsten lamp or light at 1 hour from dusk/dawn "
"(3400K)."
"<p><b>Neutral</b>: neutral color temperature (4750K)."
"<p><b>Xenon Lamp</b>: xenon lamp or light arc (5000K)."
"<p><b>Sun</b>: sunny daylight around noon (5500K)."
"<p><b>Photo Flash</b>: electronic photo flash (5600K)."
"<p><b>Sky</b>: overcast sky light (6500K)."
"<p><b>None</b>: no preset value."
msgstr ""
"<p>ជ្រើស​ការ​កំណត់​សីតុណ្ហភាព​តុល្យភាព​ពណ៌​ស​ជា​មុន​​នៅ​ទី​នេះ ដើម្បី​ប្រើ ៖"
"<p><b>ពន្លឺ ៤0 វ៉ាត់</b> ៖ ៤0 វ៉ាត់ ពន្លឺ​​ក្ដៅ​ឡើង​​ពណ៌​ស (២៦៨០ កែល​វិន​) ។"
"<p><b>ពន្លឺ ២00 វ៉ាត់</b> ៖ ២00 វ៉ាត់ ពន្លឺ​ក្ដៅ​ឡើង​​​ពណ៌​ស (៣000 កែលវិន) ។"
"<p><b>ព្រះ​អាទិត្យ​រះ</b>៖ ពន្លឺ​ព្រះ​អាទិត្យ​រះ ​ឬ ​លិច (៣២00 កែល​វិន) ។"
"<p><b>ពន្លឺ​តង់ស្តែន</b> ៖ ពន្លឺ​តង់​ស្តែន "
"​ឬ​ពន្លឺ​​ពេល​មួយ​ម៉ោងពី​ព្រលឹម​/​ព្រលប់ (៣៤00 កែល​វិន) ។"
"<p><b>ពណ៌​ស៊ីគ្នា</b> ៖ សីតុណ្ហភាព​ពណ៌​ស៊ីគ្នា (៤៧៥0 កែលវិន) ។"
"<p><b>ពន្លឺ​​សេណុង</b> ៖ ពន្លឺ​សេណុង ​ឬ​ធ្នូ​ពន្លឺ (៥000 កែលវិន) ។"
"<p><b>ព្រះ​អាទិត្យ</b> ៖ ពន្លឺ​ព្រះ​អាទិត្យ​នៅ​ពេល​រសៀល (៥៥00 កែលវិន)​ ។"
"<p><b>ពន្លឺ​រូបថត</b> ៖ ពន្លឺ​រូបថត​អេឡិចត្រូនិក (៥៦00 កែលវិន) ។"
"<p><b>មេឃ</b> ៖ ពន្លឺ​មេឃ​ស្រទុំ (៦៥00 កែលវិន) ។"
"<p><b>គ្មាន</b> ៖ គ្មាន​តម្លៃ​កំណត់​ជា​មុន ។"

#: imageeffect_whitebalance.cpp:245
msgid "Temperature tone color picker."
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​សូរសម្លេង​សីតុណ្ហភាព ។"

#: imageeffect_whitebalance.cpp:246
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"white color balance temperature and green component."
msgstr ""
"<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នក​អាច​យក​ពណ៌​ពី​រូបភាព​ដើម "
"ដែល​បាន​ប្រើ​ដើម្បី​កំណត់​សីតុណ្ហភាព​តុល្យភាព​ពណ៌ស និង​សមាសភាគ​ពណ៌​បៃតង ។"

#: imageeffect_whitebalance.cpp:249
msgid "Green:"
msgstr "​បៃតង ៖"

#: imageeffect_whitebalance.cpp:253
msgid "<p>Set here the green component to set magenta color cast removal level."
msgstr ""
"<p>នៅ​ទីនេះ​ កំណត់​សមាសភាគ​ពណ៌​បៃតង​ "
"ដើម្បី​កំណត់​​កម្រិត​យក​ការ​ចោល​ស្រមោល​​ពណ៌​ក្រហម​ស្វាយ​ចេញ ។"

#: imageeffect_whitebalance.cpp:593
msgid "White Balance"
msgstr "តុល្យភាព​ពណ៌​ស"

#: imageeffect_whitebalance.cpp:676
msgid "White Color Balance Settings File to Load"
msgstr "ឯកសារ​ការ​កំណត់​តុល្យភាព​ពណ៌ស​ត្រូវ​ផ្ទុក"

#: imageeffect_whitebalance.cpp:689
msgid "\"%1\" is not a White Color Balance settings text file."
msgstr "\"%1\" មិន​មែន​ជា​ឯកសារ​អត្ថបទ​កំណត់​តុល្យភាព​ពណ៌ស​មួយ​ទេ ។"

#: imageeffect_whitebalance.cpp:708
msgid "Cannot load settings from the White Color Balance text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពី​ឯកសារ​អត្ថបទ​តុល្យភាព​ពណ៌ស ។"

#: imageeffect_whitebalance.cpp:718
msgid "White Color Balance Settings File to Save"
msgstr "ឯកសារ​កំណត់​តុល្យភាព​ពណ៌ស​ត្រូវ​រក្សាទុក"

#: imageeffect_whitebalance.cpp:737
msgid "Cannot save settings to the White Color Balance text file."
msgstr "មិន​អាច​រក្សាទុក​ការ​កំណត់​ទៅ​ឯកសារ​អត្ថបទ​តុល្យភាព​ពណ៌​ស ។"

#: imageplugin_whitebalance.cpp:42
msgid "White Balance..."
msgstr "តុល្យភាព​ពណ៌​ស..."

#. i18n: file digikamimageplugin_whitebalance_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "​ជួសជុល"

#. i18n: file digikamimageplugin_whitebalance_ui.rc line 9
#: rc.cpp:6
#, no-c-format
msgid "&Colors"
msgstr "ពណ៌"

