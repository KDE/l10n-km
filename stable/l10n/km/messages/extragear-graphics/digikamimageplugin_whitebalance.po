#: imageeffect_whitebalance.cpp:88 imageeffect_whitebalance.cpp:111
msgid "White Color Balance Correction"
msgstr "ការ​កែ​តុល្យភាព​ពណ៌​ស"

#: imageeffect_whitebalance.cpp:113
msgid "A digiKam image plugin to correct white color balance."
msgstr "កម្មវិធី​ជំនួយ digiKam ​ដើម្បី​កែ​តុល្យភាព​ពណ៌ស ។"

#: imageeffect_whitebalance.cpp:119
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_whitebalance.cpp:122
msgid "White color balance correction algorithm"
msgstr "ក្បួន​ដោះស្រាយ​ការ​កែ​តុល្យភាព​ពណ៌ស"

#: imageeffect_whitebalance.cpp:134
msgid "Channel:"
msgstr "​ឆានែល​ ៖"

#: imageeffect_whitebalance.cpp:137
msgid "Luminosity"
msgstr "​ភាព​មាន​ពន្លឺ"

#: imageeffect_whitebalance.cpp:138
msgid "Red"
msgstr "​ក្រហម"

#: imageeffect_whitebalance.cpp:139
msgid "Green"
msgstr "​បៃតង"

#: imageeffect_whitebalance.cpp:140
msgid "Blue"
msgstr "​ខៀវ"

#: imageeffect_whitebalance.cpp:141
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p>"
msgstr ""
"<p>ជ្រើស​ឆានែល​អ៊ីស្តូក្រាម​ដើម្បី​បង្ហាញ ៖"
"<p><b>ភាព​មាន​ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ដែល​​មាន​ពន្លឺ​នៃ​រូបភាព ។"
"<p><b>ក្រហម</b>៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ក្រហម ។"
"<p><b>បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​បៃតង"
"<p><b>ពណ៌ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ខៀវ ។"
"<p>"

#: imageeffect_whitebalance.cpp:151
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"​"
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម​នៅ​ទីនេះ ។"
"<p>ប្រសិន​បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​តូច , "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>មាត្រដ្ឋាន​ជម្រឿន​អាច​ត្រូវ​បាន​ប្រើ​នៅ​ពេល​ចំនួន​អតិបរមា​ធំ ; "
"ប្រសិន​បើ​វា​ត្រូវ​បាន​ប្រើ, តម្លៃ​ទាំងអស់ (តូច​និង​ធំ) "
"នឹង​អាច​មើល​ឃើញ​នៅ​លើ​ក្រាហ្វ ។"

#: imageeffect_whitebalance.cpp:157
msgid "<p>Linear"
msgstr "​<p>លីនេអ៊ែរ"

#: imageeffect_whitebalance.cpp:165
msgid "<p>Logarithmic"
msgstr "​<p>ជម្រឿន"

#: imageeffect_whitebalance.cpp:183
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any filter settings changes."
msgstr "<p>អ្នក​អាច​មើល​អ៊ីស្តូក្រាម​រូបភាព​គោលដៅ​​ជា​មុនដែល​បាន​ទាញ​ចេញ​ពី​ឆានែល​រូបភាព​ដែល​បាន​ជ្រើស ។ ការ​នេះ​ត្រូវ​បាន​គណនា​ឡើងវិញ​នៅ​តម្រង​កំណត់​ការ​ផ្លាស់ប្ដូរ ។"

#: imageeffect_whitebalance.cpp:197
msgid "Exposure:"
msgstr "​ការ​បង្ហាញ ៖"

#: imageeffect_whitebalance.cpp:200
msgid "Auto exposure adjustments"
msgstr "លៃ​តម្រូវ​ការ​បង្ហាញ​ដោយ​ស្វ័យប្រវត្តិ"

#: imageeffect_whitebalance.cpp:201
msgid ""
"<p>With this button, you can automatically adjust Exposure and Black Point "
"values."
msgstr "<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នក​អាច​លៃ​តម្រូវ​តម្លៃ​ការ​បង្ហាញ​និង​ចំនុច​ខ្មៅ​ដោយ​ស្វ័យប្រវត្តិ ។"

#: imageeffect_whitebalance.cpp:206
msgid "<p>Set here the Exposure Value (EV)."
msgstr "<p>កំណត់​តម្លៃ​ការ​បង្ហាញ (EV) ។"

#: imageeffect_whitebalance.cpp:208
msgid "Black point:"
msgstr "ចំណុច​ខ្មៅ ៖"

#: imageeffect_whitebalance.cpp:212
msgid "<p>Set here the black level value."
msgstr "<p>កំណត់​តម្លៃ​កម្រិត​ពណ៌​ខ្មៅ ។"

#: imageeffect_whitebalance.cpp:214
msgid "Shadows:"
msgstr "ស្រមោល ៖"

#: imageeffect_whitebalance.cpp:218
msgid "<p>Set here the shadows noise suppresion level."
msgstr "<p>កំណត់​កម្រិត​សង្កត់​​ស្រមោល​មិនច្បាស់ ។"

#: imageeffect_whitebalance.cpp:220
msgid "Saturation:"
msgstr "តិត្ថិភាព ៖"

#: imageeffect_whitebalance.cpp:224
msgid "<p>Set here the saturation value."
msgstr "<p>កំណត់​តម្លៃ​តិត្ថិភាព​ ។"

#: imageeffect_whitebalance.cpp:226
msgid "Gamma:"
msgstr "​ហ្គាម៉ា ៖"

#: imageeffect_whitebalance.cpp:230
msgid "<p>Set here the gamma correction value."
msgstr "<p>កំណត់​តម្លៃ​ការ​កែ​របស់​ហ្គាម៉ា​ ។"

#: imageeffect_whitebalance.cpp:234
msgid "Temperature:"
msgstr "សីតុណ្ហភាព ៖ "

#: imageeffect_whitebalance.cpp:238
msgid "<p>Set here the white balance color temperature in Kelvin."
msgstr "<p>កំណត់​សីតុណ្ហភាព​តុល្យភាព​ពណ៌​ស​​ក្នុង Kelvin ។"

#: imageeffect_whitebalance.cpp:240
msgid "Preset:"
msgstr "កំណត់​ជា​មុន ៖"

#: imageeffect_whitebalance.cpp:242
msgid "40W Lamp"
msgstr "ចង្កៀង ៤0W"

#: imageeffect_whitebalance.cpp:243
msgid "200W Lamp"
msgstr "ចង្កៀង ២00W"

#: imageeffect_whitebalance.cpp:244
msgid "Sunrise"
msgstr "ព្រះ​អាទិត្យ​រះ"

#: imageeffect_whitebalance.cpp:245
msgid "Tungsten Lamp"
msgstr "ចង្កៀង​តាំងស្តង់"

#: imageeffect_whitebalance.cpp:246
msgid "Neutral"
msgstr "អព្យាក្រឹត"

#: imageeffect_whitebalance.cpp:247
msgid "Xenon Lamp"
msgstr "ចង្កៀង​សេណុង"

#: imageeffect_whitebalance.cpp:248
msgid "Sun"
msgstr "​ព្រះ​អាទិត្យ"

#: imageeffect_whitebalance.cpp:249
msgid "Photo Flash"
msgstr "បញ្ចេញ​ពន្លឺ​រូបថត"

#: imageeffect_whitebalance.cpp:250
msgid "Sky"
msgstr "​មេឃ"

#: imageeffect_whitebalance.cpp:251
msgid "None"
msgstr "​គ្មាន"

#: imageeffect_whitebalance.cpp:252
msgid ""
"<p>Select here the white balance color temperature preset to use:"
"<p><b>40W Lamp</b>: 40 Watt incandescent lamp (2680K)."
"<p><b>200W Lamp</b>: 200 Watt incandescent lamp (3000K)."
"<p><b>Sunrise</b>: sunrise or sunset light (3200K)."
"<p><b>Tungsten Lamp</b>: tungsten lamp or light at 1 hour from dusk/dawn "
"(3400K)."
"<p><b>Neutral</b>: neutral color temperature (4750K)."
"<p><b>Xenon Lamp</b>: xenon lamp or light arc (5000K)."
"<p><b>Sun</b>: sunny daylight around noon (5500K)."
"<p><b>Photo Flash</b>: electronic photo flash (5600K)."
"<p><b>Sky</b>: overcast sky light (6500K)."
"<p><b>None</b>: no preset value."
msgstr ""
"<p>ជ្រើស​ការ​កំណត់​សីតុណ្ហភាព​តុល្យភាព​ពណ៌​ស​ជា​មុន​ដើម្បី​ប្រើ ៖"
"<p><b>ចង្កៀង ៤0W </b> ៖ ៤0 វ៉ាត់ ចង្កៀង​ពណ៌​ស (២៦៨០K) ។"
"<p><b>ចង្កៀង ២00W </b> ៖ ២00 វ៉ាត់ ចង្កៀង​ពណ៌​ស (៣000K)."
"<p><b>ព្រះ​អាទិត្យ​រះ</b>៖ ពន្លឺ​ព្រះ​អាទិត្យ​រះ​ឬ​លិច (៣២00K) ។"
"<p><b>ចង្កៀង​តាំងស្តង់</b> ៖  ចង្កៀង​តាំងស្តង់​ឬ​ពន្លឺ​នៅមួយ​ម៉ោងពី​ព្រលឹម​/​ព្រលប់ (៣៤00K).<p><b>អព្យាក្រឹត</b> ៖ សីតុណ្ហភាព​ពណ៌​អព្យាក្រឹត (៤៧៥0K) ។<p><b>ចង្កៀង​សេណុង</b> ៖ ចង្កៀង​សេណុង​ឬ​ធ្នូ​ពន្លឺ (៥000K) ។"
"<p><b>ព្រះ​អាទិត្យ</b> ៖ ពន្លឺ​ព្រះ​អាទិត្យ​នៅពេល​ល្ងាច (៥៥00K)."
"<p><b>ពន្លឺ​រូបថត</b> ៖ ពន្លឺ​រូបថត​អេឡិចត្រូនិច (៥៦00K)."
"<p><b>មេឃ</b> ៖ ពន្លឺ​មេឃ​ស្រទុំ (៦៥00K)."
"<p><b>គ្មាន</b> ៖ គ្មាន​តម្លៃ​កំណត់​ជា​មុន ។"

#: imageeffect_whitebalance.cpp:270
msgid "Temperature tone color picker."
msgstr "ជ្រើស​គុណភាព​នៃ​សីតុណ្ហភាពពណ៌ ។"

#: imageeffect_whitebalance.cpp:271
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"white color balance temperature and green component."
msgstr "<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​បាន​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់សីតុណ្ហភាព​តុល្យភាព​ពណ៌​និង​ធាតុ​ពណ៌​បៃតង ។"

#: imageeffect_whitebalance.cpp:274
msgid "Green:"
msgstr "​បៃតង ៖"

#: imageeffect_whitebalance.cpp:278
msgid "<p>Set here the green component to set magenta color cast removal level."
msgstr "<p>កំណត់​ធាតុ​ពណ៌​បៃតង​នៅ​ទីនេះ​ដើម្បី​កំណត់​ពណ៌​ក្រហម​ស្វាយ​ទៅ​លើ​កម្រិត​ដែល​អាច​យក​ចេញ ។"

#: imageeffect_whitebalance.cpp:280
msgid "Over exposure indicator"
msgstr "​ទ្រនិច​បង្ហាញ​​ការ​បង្ហាញ​​ច្រើន​លើស"

#: imageeffect_whitebalance.cpp:281
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr ""
"<p>ប្រសិន​បើ​អ្នកអនុញ្ញាត​​ជម្រើស​នេះ ភីកសែល​ដែល​​បាន​បង្ហាញ​ច្រើន​ហួស​ចេញ​ពី​​ការ​មើល​ជាមុន​នៃ​រូបភាព​គោលដៅ​​នឹង​ត្រូវ​បាន​ឲ្យ​ពណ៌​ជ្រុល ។ "
"ការ​នេះ​វា​មិនមែន​មាន​ការ​ប៉ះពាល់​ទៅ​លើ​ការ​បង្ហាញ​ចុង​ក្រោយ​ទេ ។"

#: imageeffect_whitebalance.cpp:315
msgid ""
"<p>You can see here the original image. You can pick color on image to select "
"the tone to adjust image's white-balance with <b>Color Picker</b> method."
msgstr "<p>អ្នក​អាច​មើល​រូបភាព​ដើម​នៅ​ទីនេះ ។ អ្នក​អាច​រើស​ពណ៌​នៅ​លើ​រូបភាព​ដើម្បី​ជ្រើស​ការ​ឲ្យ​ពណ៌​ដើម្បី​លៃ​តម្រូវ​តុល្យ​ភាព​ពណ៌​ស​របស់​រូបភាព​ជា​មួយ​និង​វិធីសាស្ត្រ <b>ជ្រើស​រើស​​ពណ៌</b> ។"

#: imageeffect_whitebalance.cpp:319
msgid ""
"<p>You can see here the image's white-balance adjustments preview. You can pick "
"color on image to see the color level corresponding on histogram."
msgstr ""
"<p>អ្នក​អាច​មើល​​ការ​លៃ​តម្រូវ​តុល្យភាព​ពណ៌​ស​របស់​រូបភាពជាមុន​​នៅ​ទីនេះ។ "
" អ្នក​អាច​រើស​ពណ៌​នៅលើ​រូបភាព​ដើម្បើ​មើល​កម្រិត​ពណ៌​ដែល​ឆ្លើយឆ្លង​នៅ​លើ "
"អ៊ីស្តូក្រាម ។"

#: imageeffect_whitebalance.cpp:696
msgid "White Balance"
msgstr "តុល្យភាព​ពណ៌​ស"

#: imageeffect_whitebalance.cpp:840
msgid "White Color Balance Settings File to Load"
msgstr "កំណត់​តុល្យភាព​ពណ៌​ស​ដើម្បី​ផ្ទុក"

#: imageeffect_whitebalance.cpp:852
msgid "\"%1\" is not a White Color Balance settings text file."
msgstr "\"%1\" វា​មិន​មែន​ជា​ការកំណត់​តុល្យភាព​ពណ៌​ស​សម្រាប់​ឯកសារ​ប្រភេទ​ជា​អត្ថបទ​ទេ ។ "

#: imageeffect_whitebalance.cpp:871
msgid "Cannot load settings from the White Color Balance text file."
msgstr "មិន​អាច​ផ្ទុក​ការ​កំណត់​ពីការ​កំណត់​តុល្យភាព​ពណ៌​ស​​សម្រាប់​ឯកសារ​អត្ថបទ​ទេ ។"

#: imageeffect_whitebalance.cpp:881
msgid "White Color Balance Settings File to Save"
msgstr "ការកំណត់ឯកសារ​​តុល្យភាព​ពណ៌​ស​ដើម្បី​រក្សាទុក"

#: imageeffect_whitebalance.cpp:900
msgid "Cannot save settings to the White Color Balance text file."
msgstr "មិន​អាច​រក្សា​ការកំណត់​ទៅ​កាន់​តុល្យភាព​ពណ៌​ស​សម្រាប់​ឯកសារ​អត្ថបទ​បាន​ទេ ។"

#: imageplugin_whitebalance.cpp:42
