#: adjustlevels.cpp:78 adjustlevels.cpp:87
msgid "Adjust Color Levels"
msgstr "លៃតម្រូវ​កម្រិត​ពណ៌"

#: adjustlevels.cpp:89
msgid "An image-histogram-levels adjustment plugin for digiKam."
msgstr ""
"កម្មវិធីជំនួយ ​digiKam​ ឲ្យមាន​​ការកែតម្រូវ​កម្រិត​អ៊ីស្តូក្រាម​រូបភាព ។"

#: adjustlevels.cpp:95
msgid "Author and maintainer"
msgstr "​​អ្នក​និពន្ធ និង អ្នក​ថែទាំ​"

#: adjustlevels.cpp:105
msgid "Channel:"
msgstr "​​ឆានែល​ ៖"

#: adjustlevels.cpp:108 adjustlevels.cpp:113
msgid "Luminosity"
msgstr "​មានពន្លឺ"

#: adjustlevels.cpp:109
msgid "Red"
msgstr "​ក្រហម"

#: adjustlevels.cpp:110
msgid "Green"
msgstr "​​បៃតង"

#: adjustlevels.cpp:111
msgid "Blue"
msgstr "​​ខៀវ"

#: adjustlevels.cpp:112
msgid "Alpha"
msgstr "​អាល់ហ្វា"

#: adjustlevels.cpp:114
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p><b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image formats, "
"such as PNG or GIF."
msgstr ""
"<p>ជ្រើស​ឆានែល​អ៊ីស្តូក្រាម​​នៅទីនេះ​ដើម្បី​​បង្ហាញ ៖"
"<p><b>មានពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។"
"<p><b>ពណ៌ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​របស់ឆានែល​រូបភាព​ពណ៌ក្រហម ។"
"<p><b>ពណ៌បៃតង</b> ៖ បង្ហាញ​តម្លៃ​របស់​ឆានែល​រូបភាព​ពណ៌បៃតង ។"
"<p><b>ពណ៌ខៀវ</b> ៖ បង្ហាញ​​តម្លៃ​​របស់​ឆានែល​រូបភាព​ពណ៌ខៀវ ។"
"<p><b>អាល់ហ្វា</b> ៖ បង្ហាញ​តម្លៃ​របស់​ឆានែល​​រូបភាព​​អាល់ហ្វា ។ "
"ឆានែលនេះ​​ទាក់ទង​​ជាមួយ​​តម្លៃ​ភាពថ្លា "
"និង​ត្រូវបាន​គាំទ្រ​ដោយ​ទ្រង់ទ្រាយ​រូបភាព​មួយ​ចំនួន​ ដូចជា PNG ឬ GIF ។"

#: adjustlevels.cpp:127
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម​នៅទីនេះ ។"
"<p>ប្រសិនបើ​​​ចំនួន​អតិបរមា​របស់​រូបភាព​​គឺ​តូច, "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>នៅពេល​ដែល​ចំនួន​អតិបរមា​របស់​វា​ធំ​វិញ​អ្នក​អាច​ប្រើ​​មាត្រដ្ឋាន​លោការីត; "
"ប្រសិនបើ​ប្រើ​វា, តម្លៃ​ទាំងអស់ (តូច និង ធំ) នឹង​ត្រូវបានមើល​ឃើញ​នៅលើ​ក្រាហ្វ ។"

#: adjustlevels.cpp:133
msgid "<p>Linear"
msgstr "​<p>លីនេអ៊ែរ"

#: adjustlevels.cpp:141
msgid "<p>Logarithmic"
msgstr "​<p>ជម្រឿន"

#: adjustlevels.cpp:162
msgid "<p>This is the histogram drawing of the selected image channel"
msgstr "<p>នេះ​គឺ​ជា​ការគូរ​អ៊ីស្តូក្រាម​របស់​ឆានែល​រូបភាព​ដែលបាន​ជ្រើស"

#: adjustlevels.cpp:172 adjustlevels.cpp:188
msgid "<p>Select here the minimal intensity input value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​បញ្ចូល​អាំងតង់​ស៊ីតេ​អប្បរមា​របស់​អ៊ីស្តូក្រាម ។"

#: adjustlevels.cpp:173 adjustlevels.cpp:189
msgid "Minimal intensity input."
msgstr "បញ្ចូល​អាំងតង់ស៊ីតេ​អប្បរមា ។"

#: adjustlevels.cpp:181 adjustlevels.cpp:199
msgid "<p>Select here the maximal intensity input value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​បញ្ចូល​អាំងតង់​ស៊ីតេ​អប្បរមា​របស់​អ៊ីស្តូក្រាម ។"

#: adjustlevels.cpp:182 adjustlevels.cpp:198
msgid "Maximal intensity input."
msgstr "បញ្ចូល​អាំងតង់ស៊ីតេ​អតិបរមា ។"

#: adjustlevels.cpp:194
msgid "Gamma input value."
msgstr "តម្លៃ​បញ្ចូល​ហ្គាម៉ា ។"

#: adjustlevels.cpp:195
msgid "<p>Select here the gamma input value."
msgstr "<p>ជ្រើ​តម្លៃ​បញ្ចូល​ហ្គាម៉ា​ ។"

#: adjustlevels.cpp:206 adjustlevels.cpp:225
msgid "<p>Select here the minimal intensity output value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​លទ្ធផល​អាំងតង់ស៊ីតេ​អប្បរមា​នៃ​អ៊ីស្តូក្រាម​ ។"

#: adjustlevels.cpp:207 adjustlevels.cpp:224
msgid "Minimal intensity output."
msgstr "លទ្ធផល​អាំងតង់ស៊ីតេ​អប្បរមា ។"

#: adjustlevels.cpp:215 adjustlevels.cpp:229
msgid "<p>Select here the maximal intensity output value of the histogram."
msgstr ""
"<p>ជ្រើស​​តម្លៃ​បញ្ចូល​អាំងតង់ស៊ីតេ​អតិបរមា​​នៃ​អ៊ីស្តូក្រាម​​នៅទីនេះ ។"

#: adjustlevels.cpp:216 adjustlevels.cpp:228
msgid "Maximal intensity output."
msgstr "លទ្ធផល​អាំងតង់ស៊ីតេ​អតិបរមា ។"

#: adjustlevels.cpp:243
msgid "All channels shadow tone color picker"
msgstr "ឧបករណ៏​ជ្រើស​ពណ៌​ដាក់ឲ្យ​ស្រមោល​នៅលើ​គ្រប់ឆានែលទាំងអស់​"

#: adjustlevels.cpp:244
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Shadow Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>ប៊ូតុង​នេះ​អាចឲ្យអ្នក​ជ្រើស​ពណ៌​ពីរូបភាព​ដើម​ដែលត្រូវបាន​ប្រើសម្រាប់​កំណត <b>"
"ដាក់ពណ៌​ស្រមោល​</b> ដាក់បញ្ចូល​កម្រិត​ទៅលើ​ឆានែល​ពណ៌ក្រហម ពណ៌បៃតង ពណ៌ខៀវ "
"និង​​ពន្លឺ ។"

#: adjustlevels.cpp:253
msgid "All channels middle tone color picker"
msgstr "ឧបករណ៏​ជ្រើស​ដាក់​ពណ៌​កណ្តាល​នៅគ្រប់​ឆានែល​ទាំងអស់"

#: adjustlevels.cpp:254
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Middle Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>ប៊ូតុង​នេះ​អាច​ឲ្យ​អ្នក​​ជ្រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវបានប្រើ​សម្រាប់​កំណ"
"ត់ <b>ដាក់ពណ៌​កណ្តាល</b> ដាក់បញ្ចូល​កម្រិត​​ទៅលើ​ឆានែល​ពណ៌​ក្រហម, ពណ៌បៃតង, "
"ពណ៌ខៀវ, និង​មានពន្លឺ ."

#: adjustlevels.cpp:263
msgid "All channels highlight tone color picker"
msgstr "ឧបករណ៏​ជ្រើស​ពណ៌​ដាក់​ពន្លិច​​នៅគ្រប់ឆានែល​ទាំងអស់"

#: adjustlevels.cpp:264
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Highlight Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>ប៊ូតុង​នេះ​អាច​ឲ្យអ្នក​ជ្រើស​ពណ៌​ពី​រូបភាព​ដើម​​ដែលត្រូវបាន​ប្រើ​សម្រាប់​កំណត"
"់ <b>ដាក់ពណ៌​ពន្លេច</b> ដាក់បញ្ចូល​ឆានែល​ពណ៌ក្រហម, ពណ៌បៃតង, ពណ៌ខៀវ, "
"និង​មានពន្លឺ ។"

#: adjustlevels.cpp:269
msgid "&Auto"
msgstr "ស្វ័យប្រវត្តិ"

#: adjustlevels.cpp:270
msgid "<p>Adjust all levels automatically."
msgstr "<p>លៃតម្រូវ​កម្រិត​ទាំងអស់​ដោយស្វ័យ​ប្រត្តិ ។"

#: adjustlevels.cpp:271
msgid "&Reset"
msgstr "​កំណត់​ឡើង​វិញ"

#: adjustlevels.cpp:272
msgid "<p>Reset levels values from the current selected channel."
msgstr "<p>កំណត់​តម្លៃ​កម្រិត​​ពី​ឆានែល​ដែលបាន​ជ្រើស​បច្ចុប្បន្ន​ឡើងវិញ ។"

#: adjustlevels.cpp:284
msgid "Over exposure indicator"
msgstr "ទ្រនិច​បង្ហាញ​​ការ​បង្ហាញ​​ច្រើន​លើស"

#: adjustlevels.cpp:285
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr ""
"<p>ប្រសិនបើ​អ្នក​បើក​ជម្រើស​នេះ​, "
"ភីកសែល​ដែលបាន​បង្ហញ​លើស​ពី​ការមើល​រូបភាព​គោលដៅ​ជាមុននោះ​នឹង​ត្រូវបាន​ដាក់ពណ៌​លើស"
" ។ នេះ​នឹងមិនមាន​ប្រសិទ្ធិភាព​លើ​ការបង្ហាញ​លើកចុងក្រោយទេ ។"

#: adjustlevels.cpp:296
msgid ""
"<p>Here you can see the original image. You can pick a color from the image "
"using the color picker tools to select shadow, middle, and highlight tones to "
"adjust the curves' points in the Red, Green, Blue, and Luminosity Channels."
msgstr ""
"<p>អ្នកអាច​មើលឃើញ​រូបភាព​ដើម​​នៅទីនេះ ។ "
"អ្នកអាច​ជ្រើស​ពណ៌​​មួយ​ពី​រូបភាព​ដោយ​ប្រើ​​ឧបករណ៏​ជ្រើស​ពណ៌​ដើម្បី​ជ្រើស​ដាក់ពណ៌"
"ស្រមោល, ដាក់ពណ៌​កណ្តាល, "
"និង​ដាក់ពណ៌​ពន្លេចដើម្បី​លៃតម្រូវ​ចំនុច​កោង​​នៅក្នុង​ឆានែល​ពណ៌ក្រហម, ពណ៌បៃតង, "
"ពណ៌ខៀវ, និង​មានពន្លឺ ។"

#: adjustlevels.cpp:302
msgid "<p>Here you can see the image's level-adjustments preview."
msgstr "<p>អ្នកអាច​មើល​​ការលៃតម្រូវ​កម្រិត​​របស់​រូបភាព​​ជាមុន​បាន​នៅទីនេះ ។"

#: adjustlevels.cpp:551
msgid "Adjust Level"
msgstr "កម្រិត​លៃតម្រូវ"

#: adjustlevels.cpp:639
msgid "Select Gimp Levels File to Load"
msgstr "ជ្រើស​ឯកសារ​កម្រិត​ Gimp ​ដើម្បី​ផ្ទុក"

#: adjustlevels.cpp:645
msgid "Cannot load from the Gimp levels text file."
msgstr "មិនអាច​ផ្ទុក​ពី​ឯកសារ​អត្ថបទ​កម្រិត​ Gimp បានទេ ។"

#: adjustlevels.cpp:660
msgid "Gimp Levels File to Save"
msgstr "ឯកសារ​កម្រិត​ Gimp ដើម្បី​រក្សាទុក"

#: adjustlevels.cpp:666
msgid "Cannot save to the Gimp levels text file."
msgstr "មិនអាច​រក្សា​​ឯកសារ​អត្ថបទ​​កម្រិត​ Gimp ទុកបានទេ ។"

#: imageplugin_adjustlevels.cpp:44
msgid "Levels Adjust..."
msgstr "លៃតម្រូវ​កម្រិត..."

#. i18n: file digikamimageplugin_adjustlevels_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "​ជួសជុល"

#. i18n: file digikamimageplugin_adjustlevels_ui.rc line 9
#: rc.cpp:6
#, no-c-format
msgid "&Colors"
msgstr "ពណ៌"
