#: adjustlevels.cpp:91 imageplugin_adjustlevels.cpp:63
msgid "Adjust Color Levels"
msgstr "លៃតម្រូវ​កម្រិត​ពណ៌"

#: adjustlevels.cpp:93
msgid "An image-histogram-levels adjustment plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ digiKam ឲ្យ​អាច​លៃតម្រូវ​កម្រិត​​អ៊ីស្តូក្រាម​របស់​រូបភាព ។"

#: adjustlevels.cpp:99
msgid "Author and maintainer"
msgstr "​​អ្នក​និពន្ធ និង អ្នក​ថែទាំ​"

#: adjustlevels.cpp:107
msgid ""
"<p>Here you can see the image's level-adjustments preview. You can pick color "
"on image to see the color level corresponding on histogram."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ទិដ្ឋភាព​តម្រូវ​កម្រិត​របស់​រូបភាព​ជាមុន ។ អ្នក​អាច​ជ្រើ​សពណ៌​នៅ​លើ​រូបភាព​ដើម្បី​មើល​កម្រិត​ពណ៌​ដែល​ទាក់ទង​នឹង​អ៊ីស្តូក្រាម ។"

#: adjustlevels.cpp:117
msgid "Channel:"
msgstr "​​ឆានែល​ ៖"

#: adjustlevels.cpp:120 adjustlevels.cpp:125
msgid "Luminosity"
msgstr "ពន្លឺ"

#: adjustlevels.cpp:121
msgid "Red"
msgstr "​ក្រហម"

#: adjustlevels.cpp:122
msgid "Green"
msgstr "​​បៃតង"

#: adjustlevels.cpp:123
msgid "Blue"
msgstr "​​ខៀវ"

#: adjustlevels.cpp:124
msgid "Alpha"
msgstr "​អាល់ហ្វា"

#: adjustlevels.cpp:126
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p><b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image formats, "
"such as PNG or TIF."
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​ឆានែល​​អ៊ីស្តូក្រាមត្រូវ​បង្ហាញ ៖"
"<p><b>ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។"
"<p><b>ពណ៌​ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ក្រហម ។"
"<p><b>ពណ៌​បៃតង</b> ៖ បង្ហាញ​តម្លស​ឆានែល​រូបភាព​ពណ៌​បៃតង ។"
"<p><b>ពណ៌​ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ខៀវ ។"
"<p><b>អាល់ហ្វា</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​អាល់ហ្វា ។ ឆានែល​ទាក់ទង​នឹង​តម្លៃ​ភាព​ថ្លា ហើយ​ត្រូវ​បាន​គាំទ្រ​ដោយ​ទ្រង់ទ្រាយ​រូបភាព​មួយ​ចំនួន ដូច​ជា "
" PNG ឬ TIF ។"

#: adjustlevels.cpp:139
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ "
"បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: adjustlevels.cpp:145
msgid "<p>Linear"
msgstr "​<p>លីនេអ៊ែរ"

#: adjustlevels.cpp:153
msgid "<p>Logarithmic"
msgstr "<p>លោការីត"

#: adjustlevels.cpp:171
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any levels settings changes."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​មើល​គោដៅ​ការ​គូរ​អ៊ីស្តូក្រាម​រូបភាព​មើល​ជាមុន​របស់​ឆានែល​រូបភាព​ដែល​បាន​ជ្រើស ។ មួយនេះ​ត្រូវ​បាន​គណនា​ឡើង​វិញ​នៅការ​ផ្លាស់ប្ដូរ​ការ​កំណត់​កម្រិត​ណា​មួយ​ ។"

#: adjustlevels.cpp:181
msgid "<p>This is the histogram drawing of the selected channel from original image"
msgstr "<p>នេះ​ជា​កា​រគូរ​អ៊ីស្តូក្រាម​របស់​ឆានែល​ដែល​បានជ្រើស​ពី​រូបភាព​ដើម"

#: adjustlevels.cpp:190 adjustlevels.cpp:206
msgid "<p>Select here the minimal intensity input value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​ចូល​នៃ​អាំងតង់​ស៊ីតេ​អប្បរមា​របស់​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"

#: adjustlevels.cpp:191 adjustlevels.cpp:207
msgid "Minimal intensity input."
msgstr "តម្លៃ​ចូល​នៃ​អាំងតង់ស៊ីតេ​អប្បបរមា ។"

#: adjustlevels.cpp:199 adjustlevels.cpp:217
msgid "<p>Select here the maximal intensity input value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​ចូល​នៃ​អាំងតង់​ស៊ីតេ​អតិបរមា​របស់​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"

#: adjustlevels.cpp:200 adjustlevels.cpp:216
msgid "Maximal intensity input."
msgstr "តម្លៃ​ចូល​នៃ​អាំងតង់ស៊ីតេ​អតិបរមា ។"

#: adjustlevels.cpp:212
msgid "Gamma input value."
msgstr "តម្លៃ​ចូល​នៃ​ហ្គាម៉ា ។"

#: adjustlevels.cpp:213
msgid "<p>Select here the gamma input value."
msgstr "<p>ជ្រើស​តម្លៃ​ចូល​នៃ​ហ្គាម៉ា នៅ​ទីនេះ ។"

#: adjustlevels.cpp:224 adjustlevels.cpp:243
msgid "<p>Select here the minimal intensity output value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​លទ្ធផល​អាំងតង់ស៊ីតេ​អប្បរមា​របស់​អ៊ីស្តូក្រាម​ នៅ​ទីនេះ ។"

#: adjustlevels.cpp:225 adjustlevels.cpp:242
msgid "Minimal intensity output."
msgstr "លទ្ធផល​អាំងតង់ស៊ីតេ​អប្បរមា ។"

#: adjustlevels.cpp:233 adjustlevels.cpp:247
msgid "<p>Select here the maximal intensity output value of the histogram."
msgstr "<p>ជ្រើស​តម្លៃ​លទ្ធផល​អាំងតង់ស៊ីតេ​អតិបរមា​របស់​អ៊ីស្តូក្រាម​ នៅ​ទីនេះ ។"

#: adjustlevels.cpp:234 adjustlevels.cpp:246
msgid "Maximal intensity output."
msgstr "លទ្ធផល​អាំងតង់ស៊ីតេ​អតិបរមា ។"

#: adjustlevels.cpp:261
msgid "All channels shadow tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌ស្រមោល​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustlevels.cpp:262
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Shadow Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>ជាមួយ​ប៊ូតុង​នេះ "
"អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​តម្លៃ​ចូល​នៃ​កម្រ"
"ិត​របស់ <b>ពណ៌​ស្រមោល</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ពន្លឺ ។"

#: adjustlevels.cpp:271
msgid "All channels middle tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌កណ្ដាល​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustlevels.cpp:272
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Middle Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>ជាមួយ​ប៊ូតុង​នេះ "
"អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​តម្លៃ​ចូល​នៃ​កម្រ"
"ិត​របស់ <b>ពណ៌​កណ្ដាល</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ពន្លឺ ។"

#: adjustlevels.cpp:281
msgid "All channels highlight tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌បន្លិច​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustlevels.cpp:282
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Highlight Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>ជាមួយ​ប៊ូតុង​នេះ "
"អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​តម្លៃ​ចូល​នៃ​កម្រ"
"ិត​របស់ <b>ពណ៌​បន្លិច</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ពន្លឺ ។"

#: adjustlevels.cpp:289
msgid "Adjust all levels automatically."
msgstr "លៃតម្រូវ​គ្រប់​កម្រិត​ដោយ​ស្វ័យ​ប្រវត្តិ ។"

#: adjustlevels.cpp:290
msgid "<p>If you press this button, all channel levels will be adjusted automatically."
msgstr "<p>ប្រសិន​បើ​អ្នក​ចុច​ប៊ូតុង​ន កម្រិត​ឆានែល​ទាំង​អស់​នឹង​ត្រូវ​បា​ន​លៃតម្រូវ​ដោយ​ស្វ័យ​ប្រវត្តិ ។"

#: adjustlevels.cpp:293
msgid "&Reset"
msgstr "​កំណត់​ឡើង​វិញ"

#: adjustlevels.cpp:295
msgid "Reset current channel levels' values."
msgstr "កំណត់​តម្លៃ​របស់កម្រិត​ឆានែល​បច្ចុប្បន្ន​ឡើង​វិញ ។"

#: adjustlevels.cpp:296
msgid ""
"<p>If you press this button, all levels' values from the current selected "
"channel will be reset to the default values."
msgstr "<p>ប្រសិន​បើ​អ្នក​ចុច​ប៊ូតុង​នេះ តម្លៃ​របស់​កម្រិត​ទាំង​អស់​ពី​ឆានែល​ដែល​បានជ្រើស​បច្ចុប្បន្ន​នឹង​ត្រូវ​បាន​កំណត់​ទៅ​តម្លៃ​លំនាំដើម​ឡើង​វិញ ។"

#: adjustlevels.cpp:310
msgid "Over exposure indicator"
msgstr "ចង្អុល​បង្ហាញ​ការ​បង្ហាញ​លើស"

#: adjustlevels.cpp:311
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr ""
"<p>បើ​អ្នក​ធីក​ជម្រើស​នេះ ភីកសែល​ដែល​បង្ហាញ​លើស​ទិដ្ឋភាព​របស់​រូបភាព​គោលដៅ "
"នឹង​ត្រូវ​បាន​ផាត់​ពណ៌​លើស​គេ ។ "
"វា​នឹង​មិន​ប៉ះពាល់​ដល់​ការ​បង្ហាញ​ចុងក្រោយ​ឡើយ ។"

#: adjustlevels.cpp:600
msgid "Adjust Level"
msgstr "កម្រិត​លៃតម្រូវ"

#: adjustlevels.cpp:696
msgid "Select Gimp Levels File to Load"
msgstr "ជ្រើស​ឯកសារ​កម្រិត​របស់ Gimp ដើម្បី​ផ្ទុក"

#: adjustlevels.cpp:702
msgid "Cannot load from the Gimp levels text file."
msgstr "មិន​អាច​ផ្ទុក​ពី​ឯកសារ​អត្ថបទ​កម្រិត​របស់​ Gimp បាន​ឡើយ ។"

#: adjustlevels.cpp:717
msgid "Gimp Levels File to Save"
msgstr "ឯកសារ​កម្រិត​របស់ Gimp ដែល​ត្រូវ​រក្សា​ទុក"

#: adjustlevels.cpp:723
msgid "Cannot save to the Gimp levels text file."
msgstr "មិន​អាច​រក្សារ​ឯកសារ​អត្ថបទ​កម្រិត​របស់ Gimp បាន​ឡើយ ។"

#: imageplugin_adjustlevels.cpp:43
msgid "Levels Adjust..."
msgstr "លៃតម្រូវ​កម្រិត..."

#. i18n: file digikamimageplugin_adjustlevels_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "​ជួសជុល"

#. i18n: file digikamimageplugin_adjustlevels_ui.rc line 9
#: rc.cpp:6
#, no-c-format
msgid "&Colors"
msgstr "ពណ៌"

