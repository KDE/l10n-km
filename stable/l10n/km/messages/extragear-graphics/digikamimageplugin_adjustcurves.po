#: adjustcurves.cpp:78 adjustcurves.cpp:87
msgid "Adjust Color Curves"
msgstr "លៃ​តម្រូវ​ខ្សែ​កោង​ពណ៌"

#: adjustcurves.cpp:89
msgid "An image-histogram-curves adjustment plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ digiKam ឲ្យ​អាច​លៃតម្រូវ​ខ្សែកោង​​អ៊ីស្តូក្រាម​របស់​រូបភាព ។"

#: adjustcurves.cpp:95
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: adjustcurves.cpp:105
msgid "Channel:"
msgstr "​ឆានែល​ ៖"

#: adjustcurves.cpp:108 adjustcurves.cpp:113
msgid "Luminosity"
msgstr "មាន​ពន្លឺ"

#: adjustcurves.cpp:109
msgid "Red"
msgstr "​ក្រហម"

#: adjustcurves.cpp:110
msgid "Green"
msgstr "​បៃតង"

#: adjustcurves.cpp:111
msgid "Blue"
msgstr "​ខៀវ"

#: adjustcurves.cpp:112
msgid "Alpha"
msgstr "​អាល់ហ្វា"

#: adjustcurves.cpp:114
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p><b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image formats, "
"such as PNG or GIF."
msgstr ""
"<p>ជ្រើសឆានែល​អ៊ីស្តូក្រាម​ដើម្បី​បង្ហាញ នៅ​ទីនេះ ៖"
"<p><b>មាន​ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​រស្មី​របស់​រូបភាព ។"
"<p><b>ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ក្រហម ។"
"<p><b>បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​បៃតង ។"
"<p><b>ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​ខៀវ ។"
"<p><b>អាល់ហ្វា</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​អាល់ហ្វា ។ "
"ឆានែល​នេះ​​ត្រូវ​គ្នា​ទៅ​នឹង​តម្លៃ​ភាពថ្លា ហើយ​ត្រូវ​បាន​គាំ​ទ្រ​ដោយ​ទ្រង់ទ្រាយ​រូបភាព​មួយ​ចំនួន​​ដូចជា ៖ PNG ឬ GIF ។"

#: adjustcurves.cpp:127
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: adjustcurves.cpp:133
msgid "<p>Linear"
msgstr "<p>លីនេអ៊ែរ"

#: adjustcurves.cpp:141
msgid "<p>Logarithmic"
msgstr "<p>លោការីត"

#: adjustcurves.cpp:156
msgid "Type:"
msgstr "​ប្រភេទ ៖"

#: adjustcurves.cpp:159 adjustcurves.cpp:161
msgid "Smooth"
msgstr "រលោង"

#: adjustcurves.cpp:160
msgid "Free"
msgstr "​សេរី"

#: adjustcurves.cpp:162
msgid ""
"<p>Select here the curve type to draw for the current channel."
"<p><b>Smooth</b>: this mode constrains the curve type to a smooth line with "
"tension."
"<p><b>Free</b>: with this mode, you can draw your curve free-hand with the "
"mouse."
msgstr ""
"<p>ជ្រើស​ប្រភេទ​ខ្សែកោង​នៅ​ទីនេះ ដើម្បី​គូស​ឆានែល​បច្ចុប្បន្ន ។"
"<p><b>រលោង</b> ៖ របៀប​នេះ​កម្រិត​ប្រភេទ​ខ្សែកោង​ទៅ​ជា​បន្ទាត់​រលោង​ណែន​ល្អ ។​"
"<p><b>សេរី</b> ៖ ជាមួយ​របៀប​នេះ អ្នក​អាច​គូស​ខ្សែកោង​ដោយ​សេរី​ដោយ​ប្រើ​កណ្ដុរ ។"

#: adjustcurves.cpp:177
msgid "<p>This is the curve drawing of the selected image histogram channel"
msgstr "<p>នេះ​គឺ​ជា​គំនូរ​ខ្សែកោង​របស់​ឆានែល​អ៊ីស្តូក្រាម​រូបភាព​ដែល​បាន​ជ្រើស"

#: adjustcurves.cpp:195
msgid "All channels shadow tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌ស្រមោល​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustcurves.cpp:196
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Shadow Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr "<p>ជាមួយ​ប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​ចំណុច​ខ្សែកោង​រលោង​របស់ <b>ពណ៌​ស្រមោល</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ឆានែល​ពន្លឺ ។"

#: adjustcurves.cpp:205
msgid "All channels middle tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌កណ្ដាល​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustcurves.cpp:206
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Middle Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr "<p>ជាមួយ​ប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​ចំណុច​ខ្សែកោង​រលោង​របស់ <b>ពណ៌​កណ្ដាល</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ឆានែល​ពន្លឺ ។"

#: adjustcurves.cpp:215
msgid "All channels highlight tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌បន្លិច​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustcurves.cpp:216
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Highlight Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr "<p>ជាមួយ​ប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​ចំណុច​ខ្សែកោង​រលោង​របស់ <b>ពណ៌​បន្លិច</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ឆានែល​ពន្លឺ ។"

#: adjustcurves.cpp:221
msgid "&Reset"
msgstr "​កំណត់​ឡើង​វិញ"

#: adjustcurves.cpp:222
msgid "<p>Reset curves' values from the current selected channel."
msgstr "<p>កំណត់​តម្លៃ​ខ្សែកោង​ឡើង​វិញ​ពី​ឆានែល​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន ។"

#: adjustcurves.cpp:233
#, fuzzy
msgid "Over exposure indicator"
msgstr "ទ្រនិច​បង្ហាញ​​ការ​បង្ហាញ​​ច្រើន​លើស"

#: adjustcurves.cpp:234
#, fuzzy
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr ""
"<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស​នេះ , "
"ភីកសែល​ដែល​​បាន​បង្ហាញ​ច្រើន​ហួស​ចេញ​ពី​​ការ​មើល​ជាមុន​នៃ​រូបភាព​គោលដៅ​​នឹង​ត្រូ"
"វ​បាន​ឲ្យ​ពណ៌​ជ្រុល ។ "
"ការ​នេះ​វា​មិនមែន​មាន​ការ​ប៉ះពាល់​ទៅ​លើ​ការ​បង្ហាញ​ចុង​ក្រោយ​ទេ ។"

#: adjustcurves.cpp:245
msgid ""
"<p>You can see here the original image. You can pick a color on the image using "
"the color picker tools to select shadow, middle, and highlight tones to adjust "
"the curves' points in the Red, Green, Blue, and Luminosity Channels."
msgstr "<p>អ្នក​អាច​មើល​រូបភាព​ដើម​នៅ​ទីនេះ ។ អ្នក​អាច​រើស​ពណ៌​នៅ​លើ​រូបភាព​ដោយ​ប្រើ​ឧបករណ៍​ជ្រើស​ពណ៌ ដើម្បី​ជ្រើស​ពណ៌ស្រមោល, ពណ៌កណ្ដាល និង ពណ៌​បន្លិច​ ដើម្បី​លៃ​តម្រូវ​ចំណុច​ខ្សែកោង​នៅ​ក្នុង​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ឆានែល​ពន្លឺ ។"

#: adjustcurves.cpp:251
msgid "<p>You can see here the image's curve-adjustments preview."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ទិដ្ឋភាព​នៃ​ការ​លៃតម្រូវ​ខ្សែកោង​របស់​រូបភាព ។"

#: adjustcurves.cpp:359
msgid "Position: x:%1  y:%2"
msgstr "ទីតាំង ៖ x ៖ %1   y ៖ %2"

#: adjustcurves.cpp:404
msgid "Adjust Curve"
msgstr "ខ្សែកោង​លៃតម្រូវ"

#: adjustcurves.cpp:497
msgid "Select Gimp Curves File to Load"
msgstr "ជ្រើស​ឯកសារ​ខ្សែកោង​របស់ Gimp ដើម្បី​ផ្ទុក"

#: adjustcurves.cpp:503
msgid "Cannot load from the Gimp curves text file."
msgstr "មិន​អាច​ផ្ទុក​ពី​ឯកសារ​អត្ថបទ​ខ្សែកោង​របស់​ Gimp បាន​ឡើយ ។"

#: adjustcurves.cpp:519
msgid "Gimp Curves File to Save"
msgstr "ឯកសារ​ខ្សែកោង​របស់ Gimp ដែល​ត្រូវ​រក្សា​ទុក"

#: adjustcurves.cpp:525
msgid "Cannot save to the Gimp curves text file."
msgstr "មិន​អាច​រក្សារ​ឯកសារ​អត្ថបទ​ខ្សែកោង​របស់ Gimp បាន​ឡើយ ។"

#: imageplugin_adjustcurves.cpp:43
msgid "Curves Adjust..."
msgstr "លៃតម្រូវ​ខ្សែកោង..."

