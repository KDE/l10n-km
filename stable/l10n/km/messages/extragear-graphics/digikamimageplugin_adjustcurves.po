#: adjustcurves.cpp:91 imageplugin_adjustcurves.cpp:63
msgid "Adjust Color Curves"
msgstr "លៃ​តម្រូវ​ខ្សែ​កោង​ពណ៌"

#: adjustcurves.cpp:93
msgid "An image-histogram-curves adjustment plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ digiKam ឲ្យ​អាច​លៃតម្រូវ​ខ្សែកោង​​អ៊ីស្តូក្រាម​របស់​រូបភាព ។"

#: adjustcurves.cpp:99
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: adjustcurves.cpp:107
msgid ""
"<p>You can see here the image's curve-adjustments preview. You can pick color "
"on image to see the color level corresponding on histogram."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ទិដ្ឋភាព​មើល​ជា​មុន​នៃ​ការ​លៃតម្រូវ​របស់​រូបភាព ។ អ្នក​អាច​ជ្រើ​សពណ៌​នៅ​លើ​រូបភាព​ដើម្បី​មើល​កម្រិត​ពណ៌​ដែល​ទាក់ទង​នឹង​អ៊ីស្តូក្រាម ។"

#: adjustcurves.cpp:117
msgid "Channel:"
msgstr "​ឆានែល​ ៖"

#: adjustcurves.cpp:120 adjustcurves.cpp:125
msgid "Luminosity"
msgstr "ពន្លឺ"

#: adjustcurves.cpp:121
msgid "Red"
msgstr "​ក្រហម"

#: adjustcurves.cpp:122
msgid "Green"
msgstr "​បៃតង"

#: adjustcurves.cpp:123
msgid "Blue"
msgstr "​ខៀវ"

#: adjustcurves.cpp:124
msgid "Alpha"
msgstr "​អាល់ហ្វា"

#: adjustcurves.cpp:126
msgid ""
"<p>Select here the histogram channel to display:"
"<p><b>Luminosity</b>: display the image's luminosity values."
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p><b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image formats, "
"such as PNG or TIF."
msgstr ""
"<p>ជ្រើសឆានែល​អ៊ីស្តូក្រាម​ដើម្បី​បង្ហាញ នៅ​ទីនេះ ៖"
"<p><b>ពន្លឺ</b> ៖ បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។"
"<p><b>ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ពណ៌​ក្រហម​របស់​ឆានែល​រូបភាព ។"
"<p><b>បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ពណ៌​បៃតង​របស់​ឆានែល​រូបភាព ។"
"<p><b>ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ពណ៌​ខៀវ​របស់​ឆានែល​រូបភាព ។"
"<p><b>អាល់ហ្វា</b> ៖ បង្ហាញ​តម្លៃ​​អាល់ហ្វា​របស់​ឆានែល​រូបភាព ។ "
"ឆានែល​នេះ​​ត្រូវ​គ្នា​ទៅ​នឹង​តម្លៃ​ភាពថ្លា "
"ហើយ​ត្រូវ​បាន​គាំ​ទ្រ​ដោយ​ទ្រង់ទ្រាយ​រូបភាព​មួយ​ចំនួន​​ដូចជា ៖ PNG ឬ GIF ។"

#: adjustcurves.cpp:136
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម នៅ​ទីនេះ ។"
"<p>បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​មាន​តម្លៃ​តូច "
"អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លីនេអ៊ែរ ។"
"<p>អ្នក​អាច​ប្រើ​មាត្រដ្ឋាន​លោការីត នៅ​ពេល​ដែល​ចំនួន​អតិបរមា​មាន​តម្លៃ​ធំ ។ "
"បើ​ប្រើ​វា អ្នក​នឹង​ឃើញ​តម្លៃ​ទាំងអស់ (តូច និង ធំ) នៅ​លើ​ក្រាហ្វ ។"

#: adjustcurves.cpp:142
msgid "<p>Linear"
msgstr "<p>លីនេអ៊ែរ"

#: adjustcurves.cpp:150
msgid "<p>Logarithmic"
msgstr "<p>លោការីត"

#: adjustcurves.cpp:173
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any curves settings changes."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​មើល​ការ​គូរ​អ៊ីស្តូក្រាម​រូបភាព​មើល​ជា​មុន​របស់​ឆានែល​រូបភាព​ដែល​បានជ្រើស ។ មួយ​នេះ​ត្រូវ​បាន​គណនា​ឡើង​វិញ​នៅ​ពេល​មាន​ការ​ផ្លាស់ប្ដូរ​ការ​កំណត់​ខ្សែកោង​ណា​មួយ ។"

#: adjustcurves.cpp:188
msgid "<p>This is the curve drawing of the selected channel from original image"
msgstr "<p>នេះ​ជា​ការ​គូរ​ខ្សែកោង​របស់​ឆានែល​ដែល​បានជ្រើស​ពី​រូបភាព​ដើម"

#: adjustcurves.cpp:205
msgid "Curve free mode"
msgstr "របៀប​ខ្សែកោង​សេរី"

#: adjustcurves.cpp:206
msgid "<p>With this button, you can draw your curve free-hand with the mouse."
msgstr "<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នកអាច​គូរ​ខ្សែកោង​ដោយ​សេរី​ដោយ​ប្រើ​កណ្ដុរ ។"

#: adjustcurves.cpp:214
msgid "Curve smooth mode"
msgstr "របៀប​ខ្សែកោង​រលោង"

#: adjustcurves.cpp:215
msgid ""
"<p>With this button, you constrains the curve type to a smooth line with "
"tension."
msgstr "<p>ជា​មួយ​ប៊ូតុងនេះ អ្នក​អាច​បង្ខំ​ប្រភេទ​ខ្សែកោង​ឲ្យជា​បន្ទាត់​​រលោង​ជា​មួយ​នឹងការ​ផ្អាក​នេះ ។"

#: adjustcurves.cpp:230
msgid "All channels shadow tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌ស្រមោល​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustcurves.cpp:231
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Shadow Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr ""
"<p>ជាមួយ​ប៊ូតុង​នេះ "
"អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​ចំណុច​ខ្សែកោង​រលោ"
"ង​របស់ <b>ពណ៌​ស្រមោល</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ពន្លឺ ។"

#: adjustcurves.cpp:240
msgid "All channels middle tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌កណ្ដាល​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustcurves.cpp:241
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Middle Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr ""
"<p>ជាមួយ​ប៊ូតុង​នេះ "
"អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​ចំណុច​ខ្សែកោង​រលោ"
"ង​របស់ <b>ពណ៌​កណ្ដាល</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ពន្លឺ ។"

#: adjustcurves.cpp:250
msgid "All channels highlight tone color picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌​ដាក់ពណ៌បន្លិច​នៅគ្រប់ឆានែលទាំងអស់"

#: adjustcurves.cpp:251
msgid ""
"<p>With this button, you can pick the color from original image used to set <b>"
"Highlight Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr ""
"<p>ជាមួយ​ប៊ូតុង​នេះ "
"អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​កំណត់​ចំណុច​ខ្សែកោង​រលោ"
"ង​របស់ <b>ពណ៌​បន្លិច</b> នៅ​លើ​ឆានែល​ពណ៌​ក្រហម, បៃតង, ខៀវ និង ពន្លឺ ។"

#: adjustcurves.cpp:258
msgid "&Reset"
msgstr "​កំណត់​ឡើង​វិញ"

#: adjustcurves.cpp:260
msgid "Reset current channel curves' values."
msgstr "កំណត់​តម្លៃ​របស់​ខ្សែកោង​ឆានែល​បច្ចុប្បន្ន​ឡើង​វិញ ។"

#: adjustcurves.cpp:261
msgid ""
"<p>If you press this button, all curves' values from the current selected "
"channel will be reset to the default values."
msgstr "<p>ប្រសិន​បើ​អ្នក​ចុច​ប៊ូតុង​នេះ តម្លៃ​របស់​ខ្សែកោង​ទាំងអស់​ពី​ឆានែល​ដែល​បានជ្រើស​បច្ចុប្បន្ន នឹង​ត្រូវ​បាន​កំណត់​ទៅ​តម្លៃ​ដើម​ឡើង​វិញ ។"

#: adjustcurves.cpp:275
msgid "Over exposure indicator"
msgstr "ចង្អុល​បង្ហាញ​ការ​បង្ហាញ​លើស"

#: adjustcurves.cpp:276
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr ""
"<p>បើ​អ្នក​ធីក​ជម្រើស​នេះ ភីកសែល​ដែល​បង្ហាញ​លើស​ទិដ្ឋភាព​របស់​រូបភាព​គោលដៅ "
"នឹង​ត្រូវ​បាន​ផាត់​ពណ៌​លើស​គេ ។ "
"វា​នឹង​មិន​ប៉ះពាល់​ដល់​ការ​បង្ហាញ​ចុងក្រោយ​ឡើយ ។"

#: adjustcurves.cpp:465
msgid "Adjust Curve"
msgstr "ខ្សែកោង​លៃតម្រូវ"

#: adjustcurves.cpp:567
msgid "Select Gimp Curves File to Load"
msgstr "ជ្រើស​ឯកសារ​ខ្សែកោង​របស់ Gimp ដើម្បី​ផ្ទុក"

#: adjustcurves.cpp:573
msgid "Cannot load from the Gimp curves text file."
msgstr "មិន​អាច​ផ្ទុក​ពី​ឯកសារ​អត្ថបទ​ខ្សែកោង​របស់​ Gimp បាន​ឡើយ ។"

#: adjustcurves.cpp:589
msgid "Gimp Curves File to Save"
msgstr "ឯកសារ​ខ្សែកោង​របស់ Gimp ដែល​ត្រូវ​រក្សា​ទុក"

#: adjustcurves.cpp:595
msgid "Cannot save to the Gimp curves text file."
msgstr "មិន​អាច​រក្សារ​ឯកសារ​អត្ថបទ​ខ្សែកោង​របស់ Gimp បាន​ឡើយ ។"

#: imageplugin_adjustcurves.cpp:43
msgid "Curves Adjust..."
msgstr "លៃតម្រូវ​ខ្សែកោង..."

#. i18n: file digikamimageplugin_adjustcurves_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "ជួសជុល"

#. i18n: file digikamimageplugin_adjustcurves_ui.rc line 9
#: rc.cpp:6
#, no-c-format
msgid "&Colors"
msgstr "​ពណ៌"

