#: adjustcurves.cpp:78 adjustcurves.cpp:87
msgid "Adjust Color Curves"
msgstr "លៃតម្រូវ​ខ្សែកោង​ពណ៌"

#: adjustcurves.cpp:89
msgid "An image-histogram-curves adjustment plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ​លៃតម្រូវ​ខ្សែកោង​អ៊ីស្តូក្រាម​រូបភាព​មួយ​សម្រាប់​ digiKam."

#: adjustcurves.cpp:95
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: adjustcurves.cpp:105
msgid "Channel:"
msgstr "ឆានែល​ ៖"

#: adjustcurves.cpp:108 adjustcurves.cpp:113
msgid "Luminosity"
msgstr "ពន្លឺ"

#: adjustcurves.cpp:109
msgid "Red"
msgstr "ពណ៌​ក្រហម"

#: adjustcurves.cpp:110
msgid "Green"
msgstr "ពណ៌​បៃតង"

#: adjustcurves.cpp:111
msgid "Blue"
msgstr "ពណ៌​ខៀវ"

#: adjustcurves.cpp:112
msgid "Alpha"
msgstr "អាល់ហ្វា"

#: adjustcurves.cpp:114
msgid ""
"<p>Select here the histogram channel to display:<p><b>Luminosity</b>: "
"display the image's luminosity values.<p><b>Red</b>: display the red "
"image-channel values.<p><b>Green</b>: display the green image-channel "
"values.<p><b>Blue</b>: display the blue image-channel "
"values.<p><b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image "
"formats, such as PNG or GIF."
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​ឆានែល​អ៊ីស្តូក្រាម​ដើម្បី​បង្ហាញ ៖<p><b>ពន្លឺ</b> ៖"
"បង្ហាញ​តម្លៃ​ពន្លឺ​របស់​រូបភាព ។<p><b>ពណ៌​ក្រហម</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​រូបភាព​ពណ៌​ក្រហម ។<p><b>ពណ៌​បៃតង</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​ពណ៌​បៃតង​ ។<p><b>ពណ៌​ខៀវ</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាពពណ៌​ខៀវ ។<p><b>អាល់ហ្វា</b> ៖ បង្ហាញ​តម្លៃ​ឆានែល​រូបភាព​អាល់ហ្វា ។ ឆានែល​នេះ​ទាក់ទង​នឹង​តម្លៃ​ភាព​ថ្លា ហើយ​ត្រូវ​បានគាំទ្រ​ដោយទ្រង់ទ្រាយ​រូបភាព​មួយ​ចំនួន ដូច​ជា PNG ឬ GIF ។"

#: adjustcurves.cpp:127
msgid ""
"<p>Select here the histogram scale.<p>If the image's maximal counts are "
"small, you can use the linear scale.<p>Logarithmic scale can be used when "
"the maximal counts are big; if it is used, all values (small and large) will "
"be visible on the graph."
msgstr "<p>នៅ​ទីនេះ ជ្រើស​មាត្រដ្ឋាន​អ៊ីស្តូក្រាម ។<p>ប្រសិន​បើ​ចំនួន​អតិបរមា​របស់​រូបភាព​តូច អ្នក​អាច​ប្រើ​មាត្រដ្ឋានលីនេអ៊ែរ ។<p>មាត្រដ្ឋានលោ​ការីត​អាច​ត្រូវ​បាន​ប្រើ នៅ​ពេល​ចំនួន​អតិបរមា​ធំ ប្រសិន​បើ​វា​ត្រូវ​បាន​ប្រើ តម្លៃ​ទាំងអស់ (តូច និង​ធំ) នឹង​អាច​មើលឃើញ​នៅ​លើ​ក្រាហ្វិក ។"

#: adjustcurves.cpp:133
msgid "<p>Linear"
msgstr "<p>លីនេអ៊ែរ"

#: adjustcurves.cpp:141
msgid "<p>Logarithmic"
msgstr "<p>លោ​ការីត"

#: adjustcurves.cpp:156
msgid "Type:"
msgstr "ប្រភេទ ៖"

#: adjustcurves.cpp:159 adjustcurves.cpp:161
msgid "Smooth"
msgstr "រលោង"

#: adjustcurves.cpp:160
msgid "Free"
msgstr "សេរី"

#: adjustcurves.cpp:162
msgid ""
"<p>Select here the curve type to draw for the current "
"channel.<p><b>Smooth</b>: this mode constrains the curve type to a smooth "
"line with tension.<p><b>Free</b>: with this mode, you can draw your curve "
"free-hand with the mouse."
msgstr "<p>នៅ​ទីនេះ ជ្រើស​ប្រភេទ​ខ្សែកោង​ដើម្បី​គូរ​សម្រាប់​ឆានែល​បច្ចុប្បន្ន ។<p><b>រលោង</b> ៖ របៀប​នេះបញ្ជា​ប្រភេទ​ខ្សែកោង​ទៅ​ជា​បន្ទាត់​រលោងដែល​តាន់ ។<p><b>សេរី</b> ៖ ជា​មួយ​របៀប​នេះ អ្នក​អាច​គូរ​ខ្សែកោង​ដោយ​សេរី​ដោយ​ប្រើកណ្ដុរ ។"

#: adjustcurves.cpp:177
msgid "<p>This is the curve drawing of the selected image histogram channel"
msgstr "<p>នេះ​ជា​ការ​គូរ​ខ្សែ​កោង​របស់​ឆានែល​អ៊ីស្តូក្រាម​រូបភាព​ដែល​បាន​ជ្រើស"

#: adjustcurves.cpp:195
msgid "All channels shadow tone color picker"
msgstr "ឆានែល​ទាំងអស់​ដាក់​ស្រមោល​កម្មវិធី​​ជ្រើស​​ពណ៌​ទឹក​ពណ៌"

#: adjustcurves.cpp:196
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"<b>Shadow Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr ""
"<p>ជា​មួ​យប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពីរូបភាព​ដើម​ដែល​បា​ន​ប្រើ​ដើម្បី​កំណត់"
"<b>ទឹកពណ៌​ស្រមោល</b> ធ្វើ​ឲ្យ​ចំណុច​ខ្សែកោង​រលោង​នៅ​លើ​ឆានែល​​ពណ៌ក្រហម បៃតង ខៀវ និង​​ពន្លឺ ។"

#: adjustcurves.cpp:205
msgid "All channels middle tone color picker"
msgstr "ឆានែល​ទាំងអស់​ដាក់​កណ្ដាល​កម្មវិធី​ជ្រើស​ពណ៌​ទឹក​ពណ៌"

#: adjustcurves.cpp:206
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"<b>Middle Tone</b> smooth curves point on Red, Green, Blue, and Luminosity "
"channels."
msgstr ""
"<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​បាន​ប្រើ ​ដើម្បី​កំណត់​ "
"<b>ទឹក​ពណ៌​កណ្ដាល</b> ធ្វើ​ឲ្យ​ចំណុច​ខ្សែកោង​រលោង​នៅ​លើ​ឆានែល​ពណ៌​ក្រហម បៃតង ខៀវ និង​ពន្លឺ ។"

#: adjustcurves.cpp:215
msgid "All channels highlight tone color picker"
msgstr "ឆានែល​ទាំងអស់​បន្លិច​កម្មវិធីជ្រើស​ពណ៌​ទឹក​ពណ៌"

#: adjustcurves.cpp:216
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"<b>Highlight Tone</b> smooth curves point on Red, Green, Blue, and "
"Luminosity channels."
msgstr ""
"<p>ជា​មួយ​ប៊ូតុង​នេះ អ្នក​អាច​រើស​ពណ៌​ពី​រូបភាព​ដើម​ដែល​បាន​ប្រើ​ដើម្បី​កំណត់"
"<b>ទឹក​ពណ៌​បន្លិច</b> ធ្វើ​ឲ្យ​ចំណុច​ខ្សែកោង​រលោង​នៅ​លើ​ឆានែល​​ពណ៌​ក្រហម បៃតង និង​ពន្លឺ ។"

#: adjustcurves.cpp:221
msgid "&Reset"
msgstr "កំណត់​ឡើងវិញ"

#: adjustcurves.cpp:222
msgid "<p>Reset curves' values from the current selected channel."
msgstr "<p>កំណត់​តម្លៃ​របស់​ខ្សែកោង​ឡើ​ងវិញ​ពី​ឆានែល​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន ។"

#: adjustcurves.cpp:233
msgid "Over exposure indicator"
msgstr "លើ​ឧបករណ៍​បង្ហាញ​ការ​ផ្សាយ​"

#: adjustcurves.cpp:234
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image "
"preview will be over-colored. This will not have an effect on the final "
"rendering."
msgstr "<p>ប្រសិន​បើ​អ្នក​បើក​ជម្រើស ​ភីកសែល​នៅលើ​កា​របង្ហាញ​ពីរូបភាព​គោលដៅ​ កា​រមើល​ជា​មុន​នឹង​មាន​ពណ៌​នៅ​ពី​លើ ។ វា​នឹង​គ្មាន​ឥទ្ធិពល​លើ​ការ​បង្ហាញ​ចុង​បញ្ចប់​ទេ ។"

#: adjustcurves.cpp:245
msgid ""
"<p>You can see here the original image. You can pick a color on the image "
"using the color picker tools to select shadow, middle, and highlight tones "
"to adjust the curves' points in the Red, Green, Blue, and Luminosity "
"Channels."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​ឃើញ​រូបភាព​ដើម ។ អ្នក​អាច​ជ្រើស​ពណ៌​នៅ​លើ​រូបភាព​ ដោយ​ប្រើ​ឧបករណ៍​​កម្មវិធី​ជ្រើស​​ពណ៌​ ដើម្បី​ជ្រើស​ទឹកពណ៌​​ស្រមោល កណ្ដាល និង​បន្លិច​​ ដើម្បី​លៃតម្រូវ​ចំណុច​របស់​ខ្សែកោង​នៅ​ក្នុង​ឆានែល​ពណ៌​ក្រហម ខៀវ និង​ពន្លឺ ។"

#: adjustcurves.cpp:251
msgid "<p>You can see here the image's curve-adjustments preview."
msgstr "<p>នៅ​ទីនេះ អ្នក​អាច​ឃើញ​ទិដ្ឋភាព​លៃតម្រូវ​ខ្សែកោង​របស់​រូបភាព ។"

#: adjustcurves.cpp:359
msgid "Position: x:%1  y:%2"
msgstr "ទីតាំង ៖ x ៖%1  y ៖%2"

#: adjustcurves.cpp:404
msgid "Adjust Curve"
msgstr "លៃតម្រូវ​ខ្សែកោង"

#: adjustcurves.cpp:497
msgid "Select Gimp Curves File to Load"
msgstr "ជ្រើស​ឯកសារ​ខ្សែកោង​របស់ Gimp ដើម្បី​ផ្ទុក"

#: adjustcurves.cpp:503
msgid "Cannot load from the Gimp curves text file."
msgstr "មិន​អាច​ផ្ទុក​ពី​ឯកសារ​អត្ថបទ​ខ្សែកោង​របស់ Gimp ។"

#: adjustcurves.cpp:519
msgid "Gimp Curves File to Save"
msgstr "ឯកសារ​ខ្សែកោង​របស់ Gimp ត្រូវ​រក្សាទុក"

#: adjustcurves.cpp:525
msgid "Cannot save to the Gimp curves text file."
msgstr "មិន​អាច​រក្សាទុក​ទៅ​កាន់​ឯកសារ​អត្ថបទ​ខ្សែកោង​របស់ Gimp ។"

#: imageplugin_adjustcurves.cpp:43
msgid "Curves Adjust..."
msgstr "កា​រលៃតម្រូវ​​ខ្សែកោង..."

