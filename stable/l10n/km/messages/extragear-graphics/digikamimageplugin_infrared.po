#: imageeffect_infrared.cpp:57
msgid "Simulate Infrared Film to Photograph"
msgstr "ក្លែង​ធ្វើ​ហ្វីល​អ៊ីនហ្វ្រារ៉េដ​ទៅ​រូបថត"

#: imageeffect_infrared.cpp:63
msgid "Infrared Film"
msgstr "ហ្វីល​អ៊ីនហ្វ្រារ៉េដ"

#: imageeffect_infrared.cpp:65
msgid "A digiKam image plugin to simulate infrared film."
msgstr "កម្មវិធី​ជំនួយរបស់​ digiKam ដើម្បី​ក្លែង​រូបភាព​ធ្វើ​ជា​ហ្វីល​អ៊ីនហ្វ្រារ៉េដ ។"

#: imageeffect_infrared.cpp:71
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_infrared.cpp:80
msgid "Sensibility (ISO):"
msgstr "ការ​យល់ដឹង (អាយអេសអូ) ៖"

#: imageeffect_infrared.cpp:90
msgid ""
"<p>Set here the ISO-sensitivity of the simulated infrared film. Increasing "
"this value will increase the portion of green color in the mix. It will also "
"increase the halo effect on the hightlights, and the film graininess (if the "
"box is checked)."
msgstr ""
"<p>កំណត់ការ​យល់​ដឹង​​អាយអេសអូ "
"ដើម្បី​ប្រើ​សម្រាប់​ក្លែង​ធ្វើ​តាម​ហ្វីល​អ៊ីនហ្វ្រារ៉េដ ។ "
"ការ​បង្កើន​តម្លៃ​នេះ​នឹង​បង្កើន​ភាគ​នៃ​ពណ៌​បៃតង​នៅ​ក្នុង​ល្បាយ ។ "
"វា​នឹង​បង្កើន​បែបផែន​បាំង​ឆ័ត្រ​ទៅ​លើ​អ្វី​ដែល​បាន​បន្លិច និង​សាច់​ហ្វីល "
"(បើ​ធីក​ប្រអប់) ។"

#: imageeffect_infrared.cpp:104
msgid "Add film grain"
msgstr "បន្ថែម​គ្រាប់​ហ្វីល"

#: imageeffect_infrared.cpp:106
msgid ""
"<p>This option is adding infrared film grain to the image depending on "
"ISO-sensitivity."
msgstr ""
"<p>ជម្រើស​នេះ​នឹង​បន្ថែម​គ្រាប់​ហ្វីល​អ៊ីនហ្វ្រារ៉េដ​ទៅ​រូបភាព "
"ដោយ​ផ្អែក​លើការ​យល់ដឹងអាយអេសអូអូ) ។"

#: imageeffect_infrared.cpp:184
msgid "Infrared"
msgstr "អ៊ីនហ្វ្រារ៉េដ"

#: imageplugin_infrared.cpp:42
msgid "Infrared Film..."
msgstr "ហ្វីល​អ៊ីនហ្វ្រារ៉េដ..."

