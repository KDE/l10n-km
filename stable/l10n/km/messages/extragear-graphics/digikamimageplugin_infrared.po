#: imageeffect_infrared.cpp:61
msgid "Infrared Film"
msgstr "ហ្វីលអ៊ីនហ្វ្រារ៉េដ"

#: imageeffect_infrared.cpp:63
msgid "A digiKam image plugin to simulate infrared film."
msgstr "កម្មវិធី​ជំនួយ​ digiKam ដើម្បី​ក្លែង​រូបភាព​ធ្វើ​ជា​ហ្វីលអ៊ីនហ្វ្រារ៉េដ ។"

#: imageeffect_infrared.cpp:70
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_infrared.cpp:73
msgid "Developer"
msgstr "អ្នកអភិវឌ្ឍន៍"

#: imageeffect_infrared.cpp:82
msgid "Sensitivity (ISO):"
msgstr "ភាព​ប្រែប្រួល (អាយអេសអូ) ៖"

#: imageeffect_infrared.cpp:92
msgid ""
"<p>Set here the ISO-sensitivity of the simulated infrared film. Increasing this "
"value will increase the portion of green color in the mix. It will also "
"increase the halo effect on the hightlights, and the film graininess (if that "
"box is checked).</p>"
"<p>Note: to simulate an <b>Ilford SFX200</b> infrared film, use a sensitivity "
"excursion of 200 to 800. A sensitivity over 800 simulates <b>Kodak HIE</b> "
"high-speed infrared film. This last one creates a more dramatic photographic "
"style.</p>"
msgstr ""
"<p>កំណត់​ភាព​ប្រែប្រួល​អាយអេសអូ​របស់​ហ្វីល​អ៊ីនហ្វ្រារ៉េដ ។ "
"ការ​បង្កើន​តម្លៃ​នេះ​នឹង​បង្កើន​ផ្នែក​ពណ៌​បៃតង​នៅក្នុង​ការ​ច្របល់ ។ "
"វា​ក៏​បង្កើន​បែបផែន​ព្រះអាទិត្យ​នៅលើ​ការ​បន្លិច និងហ្វីល​សសៃ "
"(ប្រសិន​បើ​​ប្រអប់​ត្រូវ​បាន​គូសធីក) ។</p>"
"<p>ចំណាំ ៖ ដើម្បី​ធ្វើ​ត្រាប់តាមហ្វីល​អ៊ីនហ្វ្រារ៉េដ <b>Ilford SFX200</b> "
"ប្រើ​ដំណើរ​ការ​ប្រែប្រួលពី ២០០ ទៅ ៨០០ ។ ភាព​ប្រែប្រួល​​លើស​ពី ៨០០ "
"ធ្វើ​ត្រាប់តាម <b>Kodak HIE</b> ហ្វីល​អ៊ីនហ្វ្រារ៉េដ​ដែល​មាន​ល្បឿន​លឿន ។ "
"មួយ​ចុង​ក្រោយ​នេះ​ផ្ដល់​នូវ​រចនាប័ទ្ម​រូបថតគួរ​ឲ្យ​រំភើប ។</p>"

#: imageeffect_infrared.cpp:109
msgid "Add film grain"
msgstr "បន្ថែមគ្រាប់ៗ"

#: imageeffect_infrared.cpp:111
msgid ""
"<p>This option adds infrared film grain to the image depending on "
"ISO-sensitivity."
msgstr ""
"<p>ជម្រើស​នេះ​នឹង​បន្ថែម​គ្រាប់ៗ​ហ្វីល​អ៊ីនហ្វ្រារ៉េដ​ទៅ​រូបភាព "
"ដោយ​ផ្អែក​លើ​ភាព​ប្រែប្រួល​របស់​អាយអេសអូ ។"

#: imageeffect_infrared.cpp:216
msgid "Infrared"
msgstr "អ៊ីនហ្វ្រារ៉េដ"

#: imageplugin_infrared.cpp:42
msgid "Infrared Film..."
msgstr "ហ្វីលអ៊ីនហ្វ្រារ៉េដ..."

#: imageplugin_infrared.cpp:62
msgid "Simulate Infrared Film to Photograph"
msgstr "ក្លែង​ធ្វើ​រូបថត​ឲ្យ​មាន​លក្ខណៈ​ជា​ហ្វីលអ៊ីនហ្វ្រារ៉េដ"

