#: imageeffect_raindrop.cpp:56
msgid "Add Raindrops to Photograph"
msgstr "បន្ថែម​តំណក់​ភ្លៀង​ទៅ​លើ​រូបថត"

#: imageeffect_raindrop.cpp:62
msgid "Raindrops"
msgstr "តំណក់​​ភ្លៀង"

#: imageeffect_raindrop.cpp:64
msgid "A digiKam image plugin to add raindrops to an image."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​របស់ digiKam ដើម្បី​បន្ថែម​តំណក់​ភ្លៀង​ទៅ​លើ​រូបភាព​មួយ ។"

#: imageeffect_raindrop.cpp:70
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_raindrop.cpp:73
msgid "Raindrops algorithm"
msgstr "ក្បួន​ដោះស្រាយ​តំណក់​ភ្លៀង"

#: imageeffect_raindrop.cpp:78
msgid ""
"<p>This is the preview of the Raindrop effect.<p>Note: if you have "
"previously selected an area in the editor, this will be unaffected by the "
"filter. You can use this method to disable the Raindrops effect on a human "
"face, for example."
msgstr ""
"<p>នេះ​ជា​ការ​មើល​ជាមុន​​នៃ​​បែប​ផែន​តំណក់​ភ្លៀង ។"
"<p>ចំណាំ ៖ ប្រសិន​បើ​អ្នក​បាន​ជ្រើស​​ផ្ទៃ​មួយ​ក្នុង​កម្មវិធី​និពន្ធ​ពី​មុន "
"វា​នឹង​​គ្មាន​ឥទ្ធិពល​តាម​តម្រង​ទេ ។ ជា​ឧទាហរណ៍ "
"អ្នក​អាច​ប្រើ​វិធីសាស្ត្រ​នេះ​ដើម្បី​មិន​អនុញ្ញាត​បែប​ផែន​តំណក់​ភ្លៀង​នៅ​លើ​មុខ​"
"មនុស្ស​ ។"

#: imageeffect_raindrop.cpp:88
msgid "Drop size:"
msgstr "ទំហំ​ដំណក់ ៖"

#: imageeffect_raindrop.cpp:93
msgid "<p>Set here the raindrops' size."
msgstr "<p>កំណត់​ទំហំ​​របស់​តំណក់​ទឹក​ភ្លៀង​នៅ​ទីនេះ ។"

#: imageeffect_raindrop.cpp:100
msgid "Number:"
msgstr "លេខ ៖"

#: imageeffect_raindrop.cpp:105
msgid "<p>This value controls the maximum number of raindrops."
msgstr "<p>តម្លៃ​នេះ​គ្រប់គ្រង​ចំនួន​តំណក់​ទឹកភ្លៀង​អតិបរមា ។"

#: imageeffect_raindrop.cpp:112
msgid "Fish eyes:"
msgstr "ភ្នែក​ត្រី ៖"

#: imageeffect_raindrop.cpp:117
msgid "<p>This value is the fish-eye-effect optical distortion coefficient."
msgstr "<p>តម្លៃ​នេះ​គឺ​ចំនួន​មេគុណ​បង្ខូច​​​ភ្នែក​​បែបផែន​​ភ្នែក​​ត្រី ។"

#: imageeffect_raindrop.cpp:226
msgid "RainDrop"
msgstr "តំណក់​ភ្លៀង"

#: imageplugin_raindrop.cpp:42
msgid "Raindrops..."
msgstr "តំណក់​ភ្លៀង"

