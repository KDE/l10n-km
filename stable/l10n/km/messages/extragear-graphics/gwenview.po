#: app/main.cpp:50
msgid "Fast JPEG thumbnail generation (v0.13.0)"
msgstr "ការបង្កើត​រូបភាព​តូច JPEG បាន​លឿន (v0.១៣.0)"

#: app/main.cpp:51
msgid ""
"Address bar (v0.16.0)\n"
"History support (v1.0.0)"
msgstr ""
"របារ​អាសយដ្ឋាន (v0.១៦.0)\n"
"ការ​គាំទ្រ​ប្រវត្តិ (v១.0.0)"

