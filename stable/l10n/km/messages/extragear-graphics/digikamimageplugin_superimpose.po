#: imageeffect_superimpose.cpp:72
msgid "Template Superimpose to Photograph"
msgstr "ដាក់​ពុម្ព​លើ​រូបថត"

#: imageeffect_superimpose.cpp:89
msgid "Template Superimpose"
msgstr "ដាក់​ខាង​លើ​ពុម្ព"

#: imageeffect_superimpose.cpp:91
msgid "A digiKam image plugin to superimpose a template onto a photograph."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​របស់ digiKam ដើម្បី​​ដាក់​ពុម្ព​​លើ​រូប​ថត​មួយ ។"

#: imageeffect_superimpose.cpp:97
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ"

#: imageeffect_superimpose.cpp:109
msgid "<p>This is the preview of the template superimposed onto the image."
msgstr "<p>នេះ​គឺ​ជា​ការ​មើល​ជាមុន​​នៃ​ពុម្ព​ដែល​បាន​ដាក់​លើ​រូបភាព ។"

#: imageeffect_superimpose.cpp:121
msgid "Zoom in"
msgstr "ពង្រីក"

#: imageeffect_superimpose.cpp:127
msgid "Zoom out"
msgstr "បង្រួម"

#: imageeffect_superimpose.cpp:149
msgid "Root Directory..."
msgstr "ថត Root..."

#: imageeffect_superimpose.cpp:150
msgid "<p>Set here the current templates' root directory."
msgstr "<p>នៅ​ទីនេះ កំណត់​ថត root របស់​ពុម្ព​បច្ចុប្បន្ន ។"

#: imageeffect_superimpose.cpp:222
msgid "Select Template Root Directory to Use"
msgstr "ជ្រើស​ថត Root ​ពុម្ព​ត្រូវ​ប្រើ"

#: imageeffect_superimpose.cpp:248
msgid "Super Impose"
msgstr "ដាក់​លើ"

#: imageplugin_superimpose.cpp:42
msgid "Template Superimpose..."
msgstr "ដាក់​ខាង​លើ​ពុម្ព..."

