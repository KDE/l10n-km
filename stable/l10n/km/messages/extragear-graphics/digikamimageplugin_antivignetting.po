#: imageeffect_antivignetting.cpp:59 imageeffect_antivignetting.cpp:65
#: imageeffect_antivignetting.cpp:306
msgid "Anti-Vignetting"
msgstr "ប្រឆាំង​ផ្ដោត​ចំ​កណ្ដាល"

#: imageeffect_antivignetting.cpp:67
msgid "A digiKam image plugin to reduce image vignetting."
msgstr ""
"កម្មវិធី​ជំនួយ​រូបភាព digiKam ដើម្បី​កាត់​បន្ថយ​រូបភាព​ផ្ដោត​ចំ​កណ្ដាល ។"

#: imageeffect_antivignetting.cpp:73
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_antivignetting.cpp:76
msgid "Anti Vignetting algorithm"
msgstr "ក្បួន​ដោះស្រាយ​ការ​ប្រឆាំង​ការ​ផ្ដោត​ចំ​កណ្ដាល"

#: imageeffect_antivignetting.cpp:88
msgid ""
"<p>You can see here a thumbnail preview of the anti-vignetting mask applied to "
"the image."
msgstr ""
"<p>អ្នក​អាច​មើល​ការ​មើល​រូបភាព​តូចៗ​ជាមុន​នៃ​របាំង​ប្រឆាំង​ការ​ផ្ដោត​ចំ​កណ្ដាល​​"
"ដែល​បាន​អនុវត្ត​ទៅ​លើ​រូបភាព ។"

#: imageeffect_antivignetting.cpp:94
msgid "Density:"
msgstr "ដង់ស៊ីតេ ៖ "

#: imageeffect_antivignetting.cpp:99
msgid ""
"<p>This value controls the degree of intensity attenuation by the filter at its "
"point of maximum density."
msgstr ""
"<p>តម្លៃ​នេះ​ត្រួតពិនិត្យ​អង្សារ​នៃ​ការ​បន្ថយ​អាំងតង់ស៊ីតេ​ដោយ​តម្រង​នៅ​ចំនុច​ដង"
"់ស៊ីតេ​អតិបរមា​របស់​វា ។"

#: imageeffect_antivignetting.cpp:107
msgid "Power:"
msgstr "ស្វ័យ​គុណ ៖ "

#: imageeffect_antivignetting.cpp:112
msgid ""
"<p>This value is used as the exponent controlling the fall-off in density from "
"the center of the filter to the periphery."
msgstr ""
"<p>តម្លៃ​នេះ​ត្រូវ​បាន​ប្រើ​ជា​និទស្សន្ត​ដែល​ត្រួតពិនិត្យ​ការ​ធ្លាក់​ចុះ "
"ដង់ស៊ីតេ​ពី​ចំនុច​កណ្ដាល​នៃ​តម្រង​ទៅ​ផ្ទៃ​ខាង​ក្រៅ ។"

#: imageeffect_antivignetting.cpp:120
msgid "Radius:"
msgstr "កាំ ៖ "

#: imageeffect_antivignetting.cpp:125
msgid ""
"<p>This value is the radius of the center filter. It is a multiple of the "
"half-diagonal measure of the image, at which the density of the filter falls to "
"zero."
msgstr ""
"<p>តម្លៃ​នេះ​គឺ​ជា​កាំ​តម្រង​កណ្ដាល ។ "
"វា​គឺ​ជា​ពហុគុណ​នៃ​រង្វាស់​ពាក់​កណ្ដាល​អង្កត់​ទ្រូង​នៃ​រូបភាព, "
"ដែល​ដង់ស៊ីតេ​នៃ​តម្រង​ធ្លាក់​ទៅ​ដល់​សូន្យ ។"

#: imageeffect_antivignetting.cpp:134
msgid "Brightness:"
msgstr "​ពន្លឺ ៖"

#: imageeffect_antivignetting.cpp:138
msgid "<p>Set here the brightness re-adjustment of the target image."
msgstr "<p>កំណត់​ការ​លៃ​តម្រូវ​ភាព​ភ្លឺ​ឡើងវិញ​នៃ​រូបភាព​គោលដៅ ។"

#: imageeffect_antivignetting.cpp:145
msgid "Contrast:"
msgstr "កម្រិត​ពណ៌ ៖"

#: imageeffect_antivignetting.cpp:149
msgid "<p>Set here the contrast re-adjustment of the target image."
msgstr "<p>កំណត់​ការ​លៃ​តម្រូវ​កម្រិត​ពន្លឺ​ឡើងវិញ​នៃ​រូបភាព​គោលដៅ ។"

#: imageeffect_antivignetting.cpp:156
msgid "Gamma:"
msgstr "ហ្គាម៉ា ៖"

#: imageeffect_antivignetting.cpp:160
msgid "<p>Set here the gamma re-adjustment of the target image."
msgstr "<p>កំណត់​ការ​លៃ​តម្រូវ​ហ្គាម៉ា​ឡើងវិញ​នៃ​រូបភាព​គោលដៅ ។"

#: imageplugin_antivignetting.cpp:42
msgid "Anti Vignetting..."
msgstr "ប្រឆាំង​ការ​ផ្ដោត​ចំ​កណ្ដាល..."

