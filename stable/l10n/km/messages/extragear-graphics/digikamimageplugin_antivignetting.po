#: imageeffect_antivignetting.cpp:59 imageeffect_antivignetting.cpp:310
#: imageplugin_antivignetting.cpp:62
msgid "Anti-Vignetting"
msgstr "ប្រឆាំង​​ការ​បន្ថយ​កម្រិត​ពន្លឺ"

#: imageeffect_antivignetting.cpp:61
msgid "A digiKam image plugin to reduce image vignetting."
msgstr "កម្មវិធី​ជំនួយរូបភាព digiKam ​ដើម្បី​​កាត់​បន្ថយ​កម្រិត​ពន្លឺ​រូបភាព ។"

#: imageeffect_antivignetting.cpp:67
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_antivignetting.cpp:70
msgid "Anti Vignetting algorithm"
msgstr "ក្បួន​ដោះស្រាយ​ការ​ប្រឆាំង​​ការ​បន្ថយ​កម្រិត​ពន្លឺ"

#: imageeffect_antivignetting.cpp:82
msgid ""
"<p>You can see here a thumbnail preview of the anti-vignetting mask applied to "
"the image."
msgstr ""
"<p>នៅ​ទីនេះ "
"អ្នក​អាច​មើល​ទិដ្ឋភាព​រូបភាព​តូចៗ​នៃ​របាំង​ការ​ប្រឆាំង​ការ​បន្ថយ​កម្រិត​ពន្លឺ "
"ដែល​បាន​អនុវត្ត​ទៅ​រូបភាព ។"

#: imageeffect_antivignetting.cpp:88
msgid "Density:"
msgstr "ដង់ស៊ីតេ ៖"

#: imageeffect_antivignetting.cpp:93
msgid ""
"<p>This value controls the degree of intensity attenuation by the filter at its "
"point of maximum density."
msgstr ""
"<p>តម្លៃ​នេះ​គ្រប់គ្រង​កម្រិត​នៃ​ការ​បន្ថយ​អាំងតង់ស៊ីតេដោយ​តម្រង "
"នៅ​ត្រង់​ចំណុច​ដង់ស៊ីតេ​អតិបរមា ។"

#: imageeffect_antivignetting.cpp:101
msgid "Power:"
msgstr "កម្លាំង ៖"

#: imageeffect_antivignetting.cpp:106
msgid ""
"<p>This value is used as the exponent controlling the fall-off in density from "
"the center of the filter to the periphery."
msgstr ""
"<p>តម្លៃ​នេះ​ត្រូវ​បាន​ប្រើ​ជា​និទស្សន្ត​ដែល​គ្រប់គ្រង​ការ​ធ្លាក់​ចុះ​នៅ​ក្នុង​ដ"
"ង់ស៊ីតេ ពី​ចំណុច​កណ្ដាល​នៃ​តម្រង​ទៅ​ផ្ទៃ​ខាង​ក្រៅ ។"

#: imageeffect_antivignetting.cpp:114
msgid "Radius:"
msgstr "កាំ ៖"

#: imageeffect_antivignetting.cpp:119
msgid ""
"<p>This value is the radius of the center filter. It is a multiple of the "
"half-diagonal measure of the image, at which the density of the filter falls to "
"zero."
msgstr ""
"<p>តម្លៃ​នេះ​គឺ​ជា​កាំ​របស់​តម្រង​កណ្ដាល ។ "
"វា​គឺ​ជា​ពហុគុណ​នៃ​ពាក់កណ្ដាល​អង្កត់ទ្រូង​របស់​រូបភាព "
"ដែល​ដង់ស៊ីតេ​របស់​តម្រង​ធ្លាក់​ដល់​សូន្យ​នៅ​ត្រង់ ។"

#: imageeffect_antivignetting.cpp:128
msgid "Brightness:"
msgstr "​ពន្លឺ ៖"

#: imageeffect_antivignetting.cpp:132
msgid "<p>Set here the brightness re-adjustment of the target image."
msgstr "<p>កំណត់​ការ​លៃ​តម្រូវពន្លឺ​ឡើងវិញ​របស់​រូបភាព​គោលដៅ នៅ​ទីនេះ ។"

#: imageeffect_antivignetting.cpp:139
msgid "Contrast:"
msgstr "កម្រិត​ពណ៌ ៖"

#: imageeffect_antivignetting.cpp:143
msgid "<p>Set here the contrast re-adjustment of the target image."
msgstr "<p>កំណត់​ការ​លៃ​តម្រូវ​កម្រិត​ពណ៌​ឡើងវិញ​របស់​រូបភាព​គោលដៅ នៅ​ទីនេះ ។"

#: imageeffect_antivignetting.cpp:150
msgid "Gamma:"
msgstr "ហ្គាម៉ា ៖"

#: imageeffect_antivignetting.cpp:154
msgid "<p>Set here the gamma re-adjustment of the target image."
msgstr "<p>កំណត់​ការ​លៃ​តម្រូវ​ហ្គាម៉ា​ឡើងវិញ​របស់​រូបភាព​គោលដៅ នៅ​ទីនេះ ។"

#: imageplugin_antivignetting.cpp:42
msgid "Anti Vignetting..."
msgstr "​ប្រឆាំង​ការ​បន្ថយ​កម្រិត​ពន្លឺ..."

