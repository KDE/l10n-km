msgstr "​ពហុ​ជ្រុង"

#: imageeffect_distortionfx.cpp:101
msgid "Waves Hor."
msgstr "អង្កាញ់ផ្ដេក"

#: imageeffect_distortionfx.cpp:102
msgid "Waves Vert."
msgstr "អង្កាញ់បញ្ឈរ"

#: imageeffect_distortionfx.cpp:103
