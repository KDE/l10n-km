#: imageeffect_noisereduction.cpp:66 imageeffect_noisereduction.cpp:469
#: imageplugin_noisereduction.cpp:62
msgid "Noise Reduction"
msgstr "បន្ថយ​ភាព​មិន​ច្បាស់"

#: imageeffect_noisereduction.cpp:68
msgid "A noise reduction image filter plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ​តម្រង​រូបភាព​កាត់បន្ថយ​ការ​រំខាន​សម្រាប់ digiKam ។"

#: imageeffect_noisereduction.cpp:74
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_noisereduction.cpp:77
msgid "Noise Reduction algorithm. Developer"
msgstr "ក្បួន​ដោះស្រាយ​កាត់​បន្ថយ​ការ​រំខាន ។ អ្នក​អភិវឌ្ឍន៍"

#: imageeffect_noisereduction.cpp:88
msgid "Details"
msgstr "សេចក្ដី​លម្អិត"

#: imageeffect_noisereduction.cpp:90
msgid "Radius:"
msgstr "​កាំ ៖"

#: imageeffect_noisereduction.cpp:95
msgid ""
"<p><b>Radius</b>: this control selects the gliding window size used for the "
"filter. Larger values do not increase the amount of time needed to filter each "
"pixel in the image but can cause blurring. This window moves across the image, "
"and the color in it is smoothed to remove imperfections. In any case it must be "
"about the same size as noise granularity or somewhat more. If it is set higher "
"than necessary, then it can cause unwanted blur."
msgstr ""
"<p><b>កាំ</b> ៖ វត្ថុបញ្ជា​នេះ​ជ្រើស​ទំហំ​បង្អួចមិ​ន​ស៊ី​ជម្រៅ "
"បាន​ប្រើ​សម្រាប់​តម្រង ។ "
"តម្លៃ​ធំជាង​មិន​បង្កើន​ពេលវេលា​សរុប​ដែល​ចាំបាច់​ដើម្បី​ត្រង​ភីកសែល​នីមួយៗនៅ​ក្នុ"
"ង​រូបភាព​ ប៉ុន្តែ​អាច​បណ្ដាល​ឲ្យ​មាន​ភាព​មិន​ច្បាស់ ។ "
"បង្អួច​នេះ​ផ្លាស់ទី​កាត់​រូបភាព​ និង​ពណ៌​​ដែល​វា​បាន​ធ្វើ​ឲ្យរាប់ស្មើ "
"ដើម្បី​ផ្លាស់ទីភាព​មិន​ពេញ​លក្ខណៈ​ចេញ ។ "
"នៅ​ក្នុងករណីមួយ​ចំនួន​វា​មាន​ទំហំ​ដូច​គ្នា​ ជាការ​រំខាន​គ្រាប់ៗ "
"ឬ​ជា​អ្វី​ផ្សេងៗ ។ ប្រសិន​បើ​ វា​ត្រូវ​បាន​កំណត់​ខ្ពស់​ជាង​អ្វី​ដែល​ចាំបាច់ "
"បន្ទាប់​មក​វា​បណ្ដាល​ឲ្យ​មាន​ពណ៌​ព្រាលៗ​ដែល​មិន​ចង់​បាន ។"

#: imageeffect_noisereduction.cpp:109
msgid "Threshold:"
msgstr "កម្រិត​ពន្លឺ ៖"

#: imageeffect_noisereduction.cpp:114
msgid ""
"<p><b>Threshold</b>: use the slider for coarse adjustment, and the spin control "
"for fine adjustment. This controls edge detection sensitivity. This value "
"should be set so that edges and details are clearly visible and noise is "
"smoothed out. Adjustment must be made carefully, because the gap between "
"\"noisy\", \"smooth\", and \"blur\" is very small. Adjust it as carefully as "
"you would adjust the focus of a camera."
msgstr ""
"<p><b>កម្រិត​ពន្លឺ</b> ៖ ប្រើ​គ្រាប់​រំកិល​សម្រាប់ការ​លៃតម្រូវគគ្រើម "
"និង​វត្ថុ​បញ្ជា​បង្កើន​បន្ថយ​សម្រាប់ការ​លៃតម្រូវ​ល្អិត ។ "
"វា​ត្រួតពិនិត្យ​គែម​ដែល​រក​ឃើញ​ភាព​ប្រែប្រួល ។ តម្លៃ​នេះ​គួរ​ត្រូវ​បាន​កំណត់ "
"ដូច្នេះ​គែម និង​សេចក្ដី​លម្អិត​​អាច​មើល​ឃើញ​យ៉ាង​ច្បាស់ "
"និង​ការ​រំខាន​ត្រូវ​បាន​ធ្វើ​កាត់​បន្ថយ ។ "
"ការ​លៃតម្រូវ​ត្រូវតែ​បាន​ធ្វើ​ឡើង​ដោយ​ប្រុង​ប្រយ័ត្ន ពីព្រោះ​ចន្លោះ​រវាង "
"\"ភាព​រំខាន\" \"ភាព​រលោង\" និង​ \"ព្រាល\" តូច​ណាស់ ។ "
"លៃតម្រូវ​វា​ដោយ​ប្រុង​ប្រយ័ត្ន "
"ដូច​ដែល​អ្នក​លៃតម្រូវការ​ផ្ដោតអារម្មណ៍​របស់​ម៉ាស៊ីនថត ។​"

#: imageeffect_noisereduction.cpp:127
msgid "Texture:"
msgstr "​វាយនភាព ៖"

#: imageeffect_noisereduction.cpp:132
msgid ""
"<p><b>Texture</b>: this control set the texture accuracy. This value can be "
"used, to get more or less texture accuracy. When decreased, then noise and "
"texture are blurred out, when increased then texture is amplified, but also "
"noise will increase. It has almost no effect to image edges."
msgstr ""
"<p><b>វាយនភាព</b> ៖ វា​ត្រួតពិនិត្យ​ការ​គំណត់​ភាព​សុក្រឹត្រ​របស់​វាយនភាព ។ "
"តម្លៃ​នេះ​អាច​ត្រូវ​បាន​ប្រើ ដើម្បី​ទទួល​បាន​ភាព​សុក្រឹត្រ​វាយនភាព​តិច "
"ឬ​ច្រើន ។ នៅពេល​បាន​បន្ថយ បន្ទាប់​ការ​រំខាន "
"និង​វាយនភាព​ត្រូ​វបាន​ធ្វើ​ឲ្យ​ព្រាលៗ នៅ​ពេល​បង្កើន​ "
"បន្ទាប់​មក​វាយនភាព​ត្រូវ​បានពង្រីក ប៉ុន្តែ​ការ​រំខាន​នឹង​បង្កើត​ដែរ ។ "
"វា​ស្ទើរ​តែ​គ្មាន​បែបផែន​ទៅ​គែម​របស់​រូបភាព ។"

#: imageeffect_noisereduction.cpp:142
msgid "Sharpness:"
msgstr "ភាព​ច្បាស់ ៖"

#: imageeffect_noisereduction.cpp:147
msgid ""
"<p><b>Sharpness</b>: This value improves the frequency response for the filter. "
"When it is too strong then not all noise can be removed, or spike noise may "
"appear. Set it near to maximum, if you want to remove very weak noise or "
"JPEG-artifacts, without losing detail."
msgstr ""
"<p><b>ភាព​ច្បាស់</b> ៖ តម្លៃ​នេះ​បង្កើន​ការ​ឆ្លើ​យតប​ប្រេកង់​សម្រាប់​តម្រង ។ "
"នៅ​ពេល​វា​ខ្លាំង​ពេក បន្ទាប់​មក​ការ​រំខាន​ទាំងអស់​អាច​ត្រូវ​បាន​យក​ចេញ ឬ​ "
"ការ​កាត់បន្ថយ​ភាព​រំខាន​អាច​កើត​ឡើង ។ កំណត់​វា​ឲ្យជិត​ដល់​ចំនួន​អតិបរមា "
"ប្រសិន​បើ​អ្នក​ចង់​យក​ការ​រំខាន​ខ្សោយ​​បំផុត​ចេញ ឬ​ រូបភាព JPEG "
"ដោយ​មិន​បាត់បង់​សេក្ដី​លម្អិត ។"

#: imageeffect_noisereduction.cpp:158
msgid "Edge Lookahead:"
msgstr "មើល​គែមជាមុន "

#: imageeffect_noisereduction.cpp:163
msgid ""
"<p><b>Edge</b>: This value defines the pixel distance in which the filter looks "
"ahead for Edges. When this value is increased, then spikenoise is erased. You "
"can eventually readjust the <b>Edge</b> filter, when you have changed this "
"setting. When this value is too high, the adaptive filter can no longer "
"accurately track image details, and noise can reappear or blur can occur."
msgstr ""
"<p><b>គែម</b>​ ៖ "
"តម្លៃនេះ​កំណត់​ចម្ងាយ​ភីកសែល​ដែល​តម្រង​​មើល​ជាមុន​សម្រាប់​គែម ។ នៅ​ពេល​តម្លៃ "
"នេះ​ត្រូវ​បាន​បន្ថែម បន្ទាប់​មក​ការ​កាត់បន្ថយ​ភាព​រំខាន​ត្រូវ​បាន​លុប ។ "
"អ្នក​អាចលៃតម្រូវ​​តម្រង <b>គែម</b> "
"នៅ​ពេល​អ្នក​បាន​ផ្លាស់ប្ដូរ​ការ​កំណត់នេះ ។ នៅ​ពេល​តម្លៃ​នេះ​ខ្ពស់​ពេក "
"បន្ទាប់​មក​តម្រងអាច​ប្រែប្រួល​មិន​អាច​តាមដាន​សេចក្ដីលម្អិត​របស់រូបភាព​យ៉ាង​ត្រឹម"
"ត្រូវ​ទៀត​ទេ និង​​ភាព​រំខាន​អាច​បង្ហាញ​ឡើ​ងវិញ ឬ​ភាព​ព្រាលៗ​អាច​កើត​ឡើង ។"

#: imageeffect_noisereduction.cpp:175
msgid "Erosion:"
msgstr "សំណឹក  ៖"

#: imageeffect_noisereduction.cpp:180
msgid ""
"<p><b>Erosion</b>: Use this to increase edge noise erosion and spike noise "
"erosion (noise is removed by erosion)."
msgstr ""
"<p><b>សំណឹក</b> ៖ ប្រើ​វា​ដើម្បី​បង្កើន​សំណឹក​​ការ​រំខាន​គែម "
"និង​បំបាត់​សំណឹក​ការ​រំខាន ។ (ការ​រំខាន​ត្រូវ​បាន​យកចេញ​ដោយ​សំណឹក)"

#: imageeffect_noisereduction.cpp:193
msgid "Advanced"
msgstr "កម្រិត​ខ្ពស់"

#: imageeffect_noisereduction.cpp:195
msgid "Luminance:"
msgstr "ជាប់គ្នា ៖"

#: imageeffect_noisereduction.cpp:200
msgid ""
"<p><b>Luminance</b>: this control sets the luminance tolerance of the image.We "
"recommend to use only the <b>Color</b> or <b>Luminance</b> "
"tolerance settings to make an image correction, not both at the same time. "
"These settings don't influence the main smoothing process controlled by the <b>"
"Details</b> settings."
msgstr ""
"<p><b>ជាប់គ្នា</b> ៖ "
"វា​ត្រួតពិនិត្យ​​ការ​កំណត់ភាព​ស្រដៀង​ជាប់គ្នា​របស់​រូបភាព ។ "
"យើង​​ផ្ដល់​អនុសាសន៍​ឲ្យ​ប្រើ​តែការ​កំណត់​ភាព​ស្រដៀង​គ្នា​នៃ <b>ពណ៌</b> "
"ឬ <b>ជាប់គ្នា</b> ដើម្បី​ធ្វើការ​​កែរូបភាព "
"មិនមែន​ទាំងពីរ​នៅ​ពេល​តែ​មួយនោះ​​ទេ ។ ការ​កំណត់ទាំង​​នេះ​មិន​មាន​ឥទ្ធិពល​លើ​ដំណើរការ​ធ្វើ​"
"រលោង​​​ជា​ចម្បង​ ដែល​បាន​ត្រួតពិនិត្យ​ដោយការ​កំណត់​ <b>សេចក្ដី​លម្អិត</b> ។"

#: imageeffect_noisereduction.cpp:211
msgid "Color:"
msgstr "ពណ៌ ៖"

#: imageeffect_noisereduction.cpp:216
msgid ""
"<p><b>Color</b>: this control sets the color tolerance of the image. It's "
"recommended to use only the <b>Color</b> or <b>Luminance</b> "
"tolerance settings to make an image correction, not both at the same time. "
"These settings don't influence the main smoothing process controlled by the <b>"
"Details</b> settings."
msgstr ""
"<p><b>ពណ៌</b> ៖ វា​ត្រួតពិនិត្យ​កា​រកំណត់​ភាព​ស្រដៀង​ពណ៌​របស់​រូបភាព ។ "
"វា​ត្រូវ​បាន​ផ្ដល់​អនុសាសន៍​ឲ្យ​ប្រើ​តែការ​កំណត់​ភាព​ស្រដៀង​គ្នា​នៃ <b>ពណ៌</b> "
"ឬ <b>ជាប់គ្នា</b> ដើម្បី​ធ្វើ​ការ​កែរូបភាព​ "
"មិន​មែន​ម្ដង​ទាំងពីរ​នៅ​ពេល​តែ​មួយ​នោះទេ ។ ការ​កំណត់ទាំង​​នេះ​​មិនមាន​​ឥទ្ធិពល​លើ​ដំណើរ​​ការ​រ​ធ្វើ​ឲ្យ​រលោង​​ជា​ចម្បង ដែល​បាន​ត្រួតពិនិត្យ​ដោយការ​កំណត់ <b>សេចក្ដីលម្អិត</b> ។"

#: imageeffect_noisereduction.cpp:227
msgid "Gamma:"
msgstr "ហ្គាម៉ា ៖"

#: imageeffect_noisereduction.cpp:232
msgid ""
"<p><b>Gamma</b>: this control sets the gamma tolerance of the image. This value "
"can be used to increase the tolerance values for darker areas (which commonly "
"are more noisy). This results in more blur for shadow areas."
msgstr ""
"<p><b>ហ្គាម៉ា</b> ៖ វា​ត្រួតពិនិត្យ​កា​រកំណត់​​ភាព​ស្រដៀង​ហ្គាម៉ា​របស់​រូបភាព ។ "
"តម្លៃ​នេះ​អាច​ត្រូវ​បានប្រើ​ដើម្បី​បង្កើន​តម្លៃ​ស្រដៀង​គ្នា​​សម្រាប់​ផ្ទៃ​ងងឹត "
"(ដែល​តាម​ធម្មតា​មាន​ការ​រំខាន​ច្រើន) ។ "
"លទ្ធផល​នេះ​មាន​ភាព​ព្រាលៗ​ច្រើនជាង​ផ្ទៃ​ស្រមោល ។"

#: imageeffect_noisereduction.cpp:241
msgid "Damping:"
msgstr "អ័ព្ទ ៖"

#: imageeffect_noisereduction.cpp:246
msgid ""
"<p><b>Damping</b>: this control sets the phase-jitter damping adjustment. This "
"value defines how fast the adaptive filter-radius reacts to luminance "
"variations. If increased, then edges appear smoother; if too high, then blur "
"may occur. If at minimum, then noise and phase jitter at the edges can occur. "
"It can suppress spike noise when increased, and this is the preferred method to "
"remove it."
msgstr ""
"<p><b>អាប់</b> ៖ វា​ត្រួតពិនិត្យ​ការ​កំណត់​ការ​លៃតម្រូវ​អ័ព្ទ​មិន​ល្អ ។ "
"តម្លៃ​នេះ​កំណត់​ថាតើ​កាំតម្រង​ប្រែប្រួល​លឿនយ៉ាងណា​ទៅ​ភាព​ប្រែប្រួល​នៃ​ភាព​ស្រដៀង"
"​ពណ៌ ។ ប្រសិន​បើ​បាន​បង្កើន បន្ទាប់​មក​គែម​បង្ហាញ​ភាព​រលោង​ជាង "
"ប្រសិន​បើ​ខ្ពស់​ពេក បន្ទាប់​មក​ភាព​ព្រាលៗ​អាច​កើត​ឡើង ។ "
"ប្រសិន​បើ​នៅ​តម្លៃ​អប្បបរមា បន្ទាប់​មក​ភាពរំខាន "
"និង​ភាពមិនល្អ​នៅ​គែម​អាច​កើត​ឡើង ។ វា​អាច​បង្ហាប់​ការ​កាត់បន្ថយ​ភាព​រំខាន "
"នៅ​ពេល​បានបង្កើន និង​វា​ត្រូវ​ជា​វិធីសាស្ត្រ​ពេញចិត្ត​ដើម្បី​យកវា​ចេញ ។"

