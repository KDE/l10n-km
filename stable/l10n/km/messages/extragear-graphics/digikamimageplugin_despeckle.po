#: imageeffect_despeckle.cpp:57 imageeffect_despeckle.cpp:62
#: imageeffect_despeckle.cpp:241
msgid "Noise Reduction"
msgstr "ការ​កាត់​បន្ថយ​សម្លេង"

#: imageeffect_despeckle.cpp:64
msgid "A despeckle image filter plugin for digiKam."
msgstr "កម្មវិធី​ជំនួយ​តម្រង​រូបភាព​គ្មាន​ចំនុចៗ​សម្រាប់ digiKam ។"

#: imageeffect_despeckle.cpp:70
#, fuzzy
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_despeckle.cpp:73
msgid "Despeckle algorithm author from Gimp"
msgstr "អ្នក​និពន្ធ​ក្បួន​ដោះស្រាយ​គ្មាន​ចំនុចៗ​ពី Gimp"

#: imageeffect_despeckle.cpp:83
#, fuzzy
msgid "Radius:"
msgstr "កាំ ៖ "

#: imageeffect_despeckle.cpp:88
msgid ""
"<p>A radius of 0 has no effect, 1 and above determine the blur matrix radius "
"that determines how much to blur the image."
msgstr "<p>កាំ​នៃ 0 គ្មាន​បែបផែន​ទេ , 1 និង​លើស​កំណត់​កាំ​ព្រិល​ម៉ាទ្រីស​ដែល​កំណត់​រូបភាព​ត្រូវ​ព្រិល​ប៉ុន្មាន ។"

#: imageeffect_despeckle.cpp:97
msgid "Black level:"
msgstr "កម្រិត​ខ្មៅ ៖ "

#: imageeffect_despeckle.cpp:102
msgid ""
"<p>This value controls the black levels used by the adaptive filter to "
"adjust the filter radius."
msgstr "<p>តម្លៃ​នេះ​ត្រួតពិនិត្យ​កម្រិត​ខ្មៅ​ដែល​ត្រូវ​បាន​ប្រើ​ដោយ​​តម្រង​អាច​ប្រែប្រួល​ដើម្បី​លៃ​តម្រូវ​កាំ​តម្រង ។"

#: imageeffect_despeckle.cpp:111
msgid "White level:"
msgstr "កម្រិត​ស ៖ "

#: imageeffect_despeckle.cpp:116
msgid ""
"<p>This value controls the white levels used by the adaptive filter to "
"adjust the filter radius."
msgstr "<p>តម្លៃ​នេះ​ត្រួតពិនិត្យ​កម្រិត​ស​ដែល​ត្រូវ​បាន​ប្រើ​ដោយ​តម្រង​អាច​ប្រែប្រូល​ដើម្បី​លៃ​តម្រូវ​កាំ​តម្រង ។"

#: imageeffect_despeckle.cpp:125
#, fuzzy
msgid "Adaptive"
msgstr "អាច​ប្រែប្រួល"

#: imageeffect_despeckle.cpp:126
msgid "<p>This option use an adaptive median filter type."
msgstr "<p>ជម្រើស​នេះ​ប្រើ​ប្រភេត​តម្រង​មេដ្យាន​ដែល​អាច​ប្រែប្រួល ។"

#: imageeffect_despeckle.cpp:128
#, fuzzy
msgid "Recursive"
msgstr "ហៅ​ខ្លួន​ឯង"

#: imageeffect_despeckle.cpp:129
msgid "<p>This option use a recursive median filter type."
msgstr "<p>ជម្រើស​នេះ​ប្រើ​ប្រភេទ​តម្រង​មេដ្យាន​ហៅ​ខ្លួន​ឯង ។"

#: imageplugin_despeckle.cpp:43
msgid "Noise Reduction..."
msgstr "ការ​កាត់​បន្ថយ​សម្លេង..."

