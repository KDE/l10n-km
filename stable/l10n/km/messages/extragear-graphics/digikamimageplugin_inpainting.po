#: imageeffect_inpainting.cpp:110
msgid "Inpainting Photograph Tool"
msgstr "ឧបករណ៍​គូរ​ខាងក្នុង​រូបថត"

#: imageeffect_inpainting.cpp:111
msgid "You need to select a region to inpaint to use this tool"
msgstr "អ្នក​ត្រូវ​តែ​ជ្រើស​តំបន់​មួយ ដើម្បី​គូរ​ខាង​ក្នុង​ដោយ​ប្រើ​ឧបករណ៍​នេះ"

#: imageeffect_inpainting.cpp:128 imageeffect_inpainting.cpp:147
#: imageeffect_inpainting.cpp:174
msgid "Photograph Inpainting"
msgstr "គូរ​ខាងក្នុង​រូបថត​"

#: imageeffect_inpainting.cpp:132
msgid "&Save As..."
msgstr "រក្សាទុក​ជា..."

#: imageeffect_inpainting.cpp:133
msgid "&Load..."
msgstr "ផ្ទុក..."

#: imageeffect_inpainting.cpp:137
msgid "<p>Reset all filter parameters to their default values."
msgstr "<p>កំណត់​ប៉ារ៉ាម៉ែត្រ​តម្រង​ទាំងអស់​ទៅ​តម្លៃ​លំនាំដើម​ឡើងវិញ​ ។"

#: imageeffect_inpainting.cpp:138
msgid "<p>Load all filter parameters from settings text file."
msgstr "<p>ផ្ទុក​ប៉ារ៉ាម៉ែត្រ​តម្រង​ទាំងអស់​ពី​ការ​កំណត់​ឯកសារ​អត្ថបទ ។"

#: imageeffect_inpainting.cpp:139
msgid "<p>Save all filter parameters to settings text file."
msgstr "<p>រក្សាទុក​ប៉ារ៉ាម៉ែត្រ​តម្រង​ទាំងអស់​​ទៅ​ការ​កំណត់​ឯកសារ​អត្ថបទ ។"

#: imageeffect_inpainting.cpp:149
msgid "A digiKam image plugin to inpaint a photograph."
msgstr "កម្មវិធី​ជំនួយ​រូបភាពរបស់ digiKam ដើម្បី​គូរ​ខាង​ក្នុង​រូបថត ។"

#: imageeffect_inpainting.cpp:155
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_inpainting.cpp:158
msgid "CImg library"
msgstr "បណ្ណាល័យ CImg"

#: imageeffect_inpainting.cpp:161
msgid "Feedback and plugin polishing"
msgstr "ផ្ដល់​ជា​មតិយោបល់ និង​កែលម្អ​កម្មវិធី​ជំនួយ"

#: imageeffect_inpainting.cpp:167
msgid "Plugin Handbook"
msgstr "សៀវភៅ​ដៃ​កម្មវិធី​ជំនួយ"

#: imageeffect_inpainting.cpp:184
msgid "Preset"
msgstr "​កំណត់​​​ជាមុន"

#: imageeffect_inpainting.cpp:192
msgid "Visit CImg library website"
msgstr "ទស្សនា​តំបន់​បណ្តាញ​​បណ្ណាល័យ CImg"

#: imageeffect_inpainting.cpp:194
msgid "Filtering type:"
msgstr "ប្រភេទ​​ការ​ត្រង ៖"

#: imageeffect_inpainting.cpp:197
msgid "None"
msgstr "គ្មាន"

#: imageeffect_inpainting.cpp:198
msgid "Remove Small Artefact"
msgstr "យក​ការ​ខូចខាត​តិចតួច​ចេញ"

#: imageeffect_inpainting.cpp:199
msgid "Remove Medium Artefact"
msgstr "យក​ការខូចខាត​ល្មមៗ​ចេញ"

#: imageeffect_inpainting.cpp:200
msgid "Remove Large Artefact"
msgstr "យក​ការ​ខូចខាត​ខ្លាំង​ចេញ"

#: imageeffect_inpainting.cpp:201
msgid ""
"<p>Select here the filter preset to use for photograph "
"restoration:<p><b>None</b>: Most common values. Puts settings to "
"default.<p><b>Remove Small Artefact</b>: inpaint small image artefact like "
"image glitch.<p><b>Remove Medium Artefact</b>: inpaint medium image "
"artefact.<p><b>Remove Large Artefact</b>: inpaint image artefact like "
"unwanted object.<p>"
msgstr ""
"<p>នៅ​ទីនេះ ជ្រើស​ការ​កំណត់​ជា​មុន​របស់​តម្រង "
"ដើម្បី​ប្រើ​សម្រាប់​បង្ខូច​ទ្រង់ទ្រាយ​រូបថត ៖"
"<p><b>គ្មាន</b> ៖ តម្លៃ​ទូទៅ​ភាគច្រើន ។ វា​អាច​កំណត់​ការ​កំណត់​ទៅ​ជា​លំនាំដើម ។"
"<p><b>យក​ការ​ខូចខាត​តិចតួច​ចេញ</b> ៖ កែប្រែ​ការ​ខូចខាត​តិចតួច ដូចជា "
"ភាព​ស្រអាប់​របស់​រូបភាព​ជាដើម ។"
"<p><b>យក​ការ​ខូចខាត​ល្មមៗ​ចេញ</b> ៖ កែប្រែ​ការ​ខូចខាត​ល្មមៗ ។"
"<p><b>យក​ការ​ខូចខាត​ខ្លាំង​ចេញ</b> ៖ កែប្រែ​ការ​ខូចខាត​ខ្លាំង "
"ដូចជា​វត្ថុ​ដែល​មិន​ចង់​បាន​ជាដើម ។"
"<p>"

#: imageeffect_inpainting.cpp:213
msgid "<p>This is the current percentage of the task completed."
msgstr "​<p>នេះ​គឺ​ជា​​ភាគរយ​បច្ចុប្បន្ន​នៃ​ភារកិច្ច​ដែលបាន​បញ្ចប់ ។"

#: imageeffect_inpainting.cpp:221
msgid "Smoothing"
msgstr "ភាព​រលោង"

#: imageeffect_inpainting.cpp:223
msgid "Detail preservation:"
msgstr "ការ​ការ​ពារសេចក្ដី​​លម្អិត ៖"

#: imageeffect_inpainting.cpp:228
msgid ""
"<p>Preservation of details to set the sharpening level of the small features "
"in the target image. Higher values leave details sharp."
msgstr ""
"<p>ការ​ការពារ​​​​​លម្អិត "
"​ដើម្បី​កំណត់​​កម្រិត​ធ្វើ​ឲ្យ​​​ច្បាស់​នៃ​​លក្ខណៈ​​ពិសេស​តូច​មួយ​ក្នុង​រូបភាព​គោលដៅ ។ តម្លៃ​ខ្ពស់​ជាង​ទុក​សេចក្ដី​លម្អិត​ឲ្យ​​រឹត​តែ​​ច្បាស់ ។"

#: imageeffect_inpainting.cpp:234
msgid "Anisotropy:"
msgstr "ទិស​​មិន​ស្មើ​គ្នា ៖"

#: imageeffect_inpainting.cpp:239
msgid ""
"<p>Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr "<p>ឧបករណ៍​​កែប្រែ​​ទិស​មិន​ស្មើគ្នា ​(ទិស)​​ នៃ​សេចក្ដី​លម្អិត ។ ទុក​វា​ឲ្យ​តូច​សម្រាប់​ភាព​មិន​ច្បាស់ Gaussian ។"

#: imageeffect_inpainting.cpp:243
msgid "Smoothing:"
msgstr "ភាព​រលោង ៖"

#: imageeffect_inpainting.cpp:248
msgid ""
"<p>Total smoothing power: if Detail Factor sets the relative smoothing and "
"Gradient Factor the direction, Time Step sets the overall effect."
msgstr ""
"<p>ស្វ័យគុណ​ភាព​រលូន​​សរុប ៖ "
"ប្រសិនបើ​កត្តាលម្អិត​កំណត់​ភាព​រលូន​​ដែល​​ទំនាក់ទំនង និង​កត្តា​ជម្រាល​ទិស "
"ជំហា​នពេលវេលា​កំណត់​បែបផែន​ទាំ​ងមូល ។"

#: imageeffect_inpainting.cpp:253
msgid "Regularity:"
msgstr "ភាព​ប្រក្រតី ៖"

#: imageeffect_inpainting.cpp:258
msgid ""
"<p>This value controls the smoothing regularity of the target image. Do not "
"use an high value here, else the target image will be completely blurred."
msgstr "<p>តម្លៃនេះ​ត្រួតពិនិត្យ​ភាព​ប្រក្រតី​នៃ​ភាព​រលោង​របស់​រូបភាព​គោលដៅ ។ កុំប្រើ​តម្លៃខ្ពស់​នៅ​ទីនេះ រូបភាព​គោលដៅ​ផ្សេង​​នឹង​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ព្រិល​ទាំង​ស្រុង ។"

#: imageeffect_inpainting.cpp:264
msgid "Iterations:"
msgstr "ធ្វើ​ឡើង​វិញ ៖"

#: imageeffect_inpainting.cpp:269
msgid "<p>Sets the number of times the filter is applied on the target image."
msgstr "<p>កំណត់​ចំនួន​ដង​ដែល​តម្រង​ត្រូវ​បាន​អនុវត្ត​នៅ​លើ​រូបភាព​គោលដៅ ។"

#: imageeffect_inpainting.cpp:277
msgid "Advanced Settings"
msgstr "ការ​កំណត់​កម្រិត​ខ្ពស់"

#: imageeffect_inpainting.cpp:279
msgid "Angular step:"
msgstr "ជំហាន​ច្រើន​ជ្រុង ៖"

#: imageeffect_inpainting.cpp:284
msgid "<p>Set here the angular integration step in degrees in analogy to anisotropy."
msgstr "<p>នៅ​ទីនេះ កំណត់​ជំហាន​រួមបញ្ចូល​គ្នា​គិត​ជា​អង្សា រវាង​ភាព​ស្រដៀង​គ្នា និង​ទិស​មិន​ស្មើ​គ្នា ។"

#: imageeffect_inpainting.cpp:288
msgid "Integral step:"
msgstr "ជំហាន​អាំងតេក្រាល ៖"

#: imageeffect_inpainting.cpp:293
msgid "<p>Set here the spatial integral step. Stay below 1."
msgstr "<p>កំណត់​ជំហាន​ទាំងមូល​នៃ​ទំហំ នៅ​ទីនេះ ។ តូចជាង ១ ។"

#: imageeffect_inpainting.cpp:297
msgid "Gaussian:"
msgstr "ហ្គូសៀន ៖"

#: imageeffect_inpainting.cpp:302
msgid "<p>Set here the precision of the Gaussian function."
msgstr "<p>កំណត់​ចំនួន​ខ្ទង់​នៃ​អនុគមន៍​ហ្គូសៀន ។"

#: imageeffect_inpainting.cpp:306
msgid "Use linear interpolation"
msgstr "ប្រើ​ការ​ថែមថយ​លីនេអ៊ែរ"

#: imageeffect_inpainting.cpp:307
msgid "<p>Enable this option to quench the last bit of quality (slow)."
msgstr "<p>បើក​ជម្រើស​នេះ ដើម្បី​បង្ក្រាប​ប៊ីត​ចុងក្រោយ​របស់​គុណភាព (យឺត) ។"

#: imageeffect_inpainting.cpp:310
msgid "Normalize photograph"
msgstr "ធ្វើឲ្យ​រូបថត​​សាមញ្ញ"

#: imageeffect_inpainting.cpp:311
msgid "<p>Enable this option to process an output image normalization."
msgstr ""
"<p>បើក​ជម្រើស​នេះ "
"ដើម្បី​ដំណើរការ​ការ​ធ្វើ​ឲ្យ​រូបភាព​លទ្ធផល​មាន​លក្ខណៈ​សាមញ្ញ ។"

#: imageeffect_inpainting.cpp:556
msgid "InPainting"
msgstr "គូរ​ខាងក្នុង"

#: imageeffect_inpainting.cpp:581
msgid "Photograph Inpainting Settings File to Load"
msgstr "ឯកសារ​​កំណត់​ការ​គូរ​ខាងក្នុង​រូបថត​ត្រូវ​ផ្ទុក"

#: imageeffect_inpainting.cpp:593
msgid "\"%1\" is not a Photograph Inpainting settings text file."
msgstr "\"%1\" មិនមែន​ជា​ឯកសារ​អត្ថបទ​​ការកំណត់​ការ​គូរ​ខាងក្នុង​រូបថត​ឡើយ ។"

#: imageeffect_inpainting.cpp:614
msgid "Cannot load settings from the Photograph Inpainting text file."
msgstr "មិនអាច​ផ្ទុក​ការកំណត់​​ពី​ឯកសារ​អត្ថបទ​​ការ​គូរ​ខាង​ក្នុង​រូបថត​បាន​ឡើយ ។"

#: imageeffect_inpainting.cpp:623
msgid "Photograph Inpainting Settings File to Save"
msgstr "ឯកសារ​ការ​កំណត់​ការ​គូរ​ខាង​ក្នុង​រូបថត​ត្រូវ​រក្សាទុក"

#: imageeffect_inpainting.cpp:645
msgid "Cannot save settings to the Photograph Inpainting text file."
msgstr "មិន​អាច​រក្សា​ការកំណត់​​ទៅ​កាន់​ឯកសារ​អត្ថបទ​ការ​គូរ​ខាងក្នុង​រូបថត​បាន​ឡើយ ។"

#: imageplugin_inpainting.cpp:42
msgid "Inpainting..."
msgstr "ការ​គូរ​ខាង​ក្នុង..."

#: imageplugin_inpainting.cpp:46
msgid ""
"This filter can be used to inpaint a part in a photo. Select a region to "
"inpaint to use this option."
msgstr ""
"អ្នក​អាច​ប្រើ​តម្រង​នេះ ដើម្បី​គូរ​ផ្នែក​ណា​មួយ​នៅ​ក្នុង​រូបថត ។ "
"អ្នក​ត្រូវ​ជ្រើស​តំបន់​មួយ​សិន មុន​នឹង​អាច​ប្រើ​ជម្រើស​នេះ ។"

#. i18n: file digikamimageplugin_inpainting_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "ថេរ"

