#: imageeffect_inpainting.cpp:110
msgid "Inpainting Photograph Tool"
msgstr "ឧបករណ៏​គូរ​ខាងក្នុង​រូបថត"

#: imageeffect_inpainting.cpp:111
msgid "You need to select a region to inpaint to use this tool"
msgstr ""
"អ្នក​ត្រូវ​ការ​ជ្រើស​តំបន់​មួយ​សម្រាប់​គូរ​ពី​ក្នុង​ដោយ​ប្រើ​ឧបករណ៍​នេះ"

#: imageeffect_inpainting.cpp:128 imageeffect_inpainting.cpp:147
#: imageeffect_inpainting.cpp:174
msgid "Photograph Inpainting"
msgstr "គូរ​ខាងក្នុង​រូបថត​"

#: imageeffect_inpainting.cpp:132
msgid "&Save As..."
msgstr "​រក្សាទុក​ជា..."

#: imageeffect_inpainting.cpp:133
msgid "&Load..."
msgstr "​ផ្ទុក..."

#: imageeffect_inpainting.cpp:137
msgid "<p>Reset all filter parameters to their default values."
msgstr "<p>កំណត់​ប៉ារ៉ាម៉ែត្រ​ទាំងអស់ទៅជា​តម្លៃ​ដើម​របស់​ពួក​វាឡើង​វិញ ។"

#: imageeffect_inpainting.cpp:138
msgid "<p>Load all filter parameters from settings text file."
msgstr "<p>ផ្ទុក​ប៉ារ៉ាម៉ែត្រ​តម្រង​ពី​ការ​កំណត់​ឯកសារ​អត្ថបទ ។"

#: imageeffect_inpainting.cpp:139
msgid "<p>Save all filter parameters to settings text file."
msgstr "<p>រក្សា​ប៉ារ៉ាម៉ែត្រ​តម្រង​ទាំងអស់​​ទៅកាន់​ការ​កំណត់​ឯកសារ​អត្ថបទ ។"

#: imageeffect_inpainting.cpp:149
msgid "A digiKam image plugin to inpaint a photograph."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព digiKam  សម្រាប់គូរ​ខាងក្នុង​រូបថត ។"

#: imageeffect_inpainting.cpp:155
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_inpainting.cpp:158
msgid "CImg library"
msgstr "​បណ្ណាល័យ CImg"

#: imageeffect_inpainting.cpp:161
msgid "Feedback and plugin polishing"
msgstr "មតិអ្នកប្រើ​និង​ការ​​កែ​ឆ្នៃ​កម្មវិធី​ជំនួយ​"

#: imageeffect_inpainting.cpp:167
msgid "Plugin Handbook"
msgstr "​សៀវភៅ​ដៃ​កម្មវិធី​ជំនួយ"

#: imageeffect_inpainting.cpp:184
msgid "Preset"
msgstr "​កំណត់​ជា​មុន"

#: imageeffect_inpainting.cpp:192
msgid "Visit CImg library website"
msgstr "​ទស្សនា​បណ្ដាញ​បណ្ណាល័យ CImg "

#: imageeffect_inpainting.cpp:194
msgid "Filtering type:"
msgstr "ប្រភេទ​តម្រង ៖"

#: imageeffect_inpainting.cpp:197
msgid "None"
msgstr "​គ្មាន"

#: imageeffect_inpainting.cpp:198
msgid "Remove Small Artefact"
msgstr "យក Artefact តូច​ចេញ"

#: imageeffect_inpainting.cpp:199
msgid "Remove Medium Artefact"
msgstr "យក Artefact កណ្ដាល​ចេញ"

#: imageeffect_inpainting.cpp:200
msgid "Remove Large Artefact"
msgstr "យក Artefact ធំ​ចេញ"

#: imageeffect_inpainting.cpp:201
msgid ""
"<p>Select here the filter preset to use for photograph restoration:"
"<p><b>None</b>: Most common values. Puts settings to default."
"<p><b>Remove Small Artefact</b>: inpaint small image artefact like image "
"glitch."
"<p><b>Remove Medium Artefact</b>: inpaint medium image artefact."
"<p><b>Remove Large Artefact</b>: inpaint image artefact like unwanted object."
"<p>"
msgstr ""
"<p>ជ្រើស​ការ​កំណត់​តម្រង​ជា​មុន​ដើម្បី​ប្រើ​សម្រាប់​ការ​ស្ដារ ៖"
"<p><b>គ្មាន</b> ៖ តម្លៃ​ធម្មតា​បំផុត ។ ដាក់​ការ​កំណត់​ទៅ​ជា​លំនាំ​ដើម ។"
"<p><b>យក Artefact តូច​ចេញ</b> ៖ គូរ​រូបភាព​តូច​ពី​ក្នុង artefact ដូចimage "
"glitch ។"
"<p><b>យក Artefact កណ្ដាល​ចេញ</b> ៖ គូរ​រូបភាព​កណ្ដាល​​ពី​ក្នុង artefact ។"
"<p><b>យក Artefact ធំ​ចេញ</b> ៖ គូរ​រូបភាព​ពី​ក្នុង artefact "
"ដូច​វត្ថុ​ដែល​មិនចង់​បាន ។"
"<p>"

#: imageeffect_inpainting.cpp:213
msgid "<p>This is the current percentage of the task completed."
msgstr "​<p>នេះគឺជា​​ភាគរយ​បច្ចុប្បន្ន​នៃ​ភារកិច្ច​ដែលបាន​បញ្ចប់ ។"

#: imageeffect_inpainting.cpp:221
msgid "Smoothing"
msgstr "​ភាពរលោង"

#: imageeffect_inpainting.cpp:223
msgid "Detail preservation:"
msgstr "​លម្អិត​ការ​ការពារ ៖ "

#: imageeffect_inpainting.cpp:228
msgid ""
"<p>Preservation of details to set the sharpening level of the small features in "
"the target image. Higher values leave details sharp."
msgstr ""
"<p>ការ​ការពារ​នៃ​សេចក្ដី​លម្អិត​​ដើម្បី​កំណត់​​កម្រិត​ធ្វើ​ឲ្យ​ច្បាស់​នៃ​លក្ខណៈ​"
"ពិសេស​តូច​នៅ​ក្នុង​រូបភាព​គោលដៅ ។ "
"តម្លៃ​ខ្ពស់​ជាង​ទុក​សេចក្ដី​លម្អិត​ឲ្យ​រឹត​តែ​ច្បាស់ ។"

#: imageeffect_inpainting.cpp:234
msgid "Anisotropy:"
msgstr "​និវត្តទិស ៖ "

#: imageeffect_inpainting.cpp:239
msgid ""
"<p>Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr ""
"​"
"<p>អ្នក​កែប្រែ​និវត្តទិស​នៃ​សេចក្ដី​លម្អិត (directional) ។ "
"រក្សា​វា​ឲ្យ​តូច​សម្រាប់សម្លេង Gaussian ។"

#: imageeffect_inpainting.cpp:243
msgid "Smoothing:"
msgstr "ភាពរលោង ៖"

#: imageeffect_inpainting.cpp:248
msgid ""
"<p>Total smoothing power: if Detail Factor sets the relative smoothing and "
"Gradient Factor the direction, Time Step sets the overall effect."
msgstr ""
"<p>ស្វ័យគុណ​ភាព​រលោង​សរុប ៖ ប្រសិនបើ​កត្តា​លម្អិត​កំណត់​ភាពរលោង​ទំនាក់ទំនង​ "
"និង​កត្តា​ជម្រាល​ទិស ជំហាន​ពេលវេលា​កំណត់​បែបផែន​ទាំង​មូល ។"

#: imageeffect_inpainting.cpp:253
msgid "Regularity:"
msgstr "​និយតភាព ៖ "

#: imageeffect_inpainting.cpp:258
msgid ""
"<p>This value controls the smoothing regularity of the target image. Do not use "
"an high value here, else the target image will be completely blurred."
msgstr ""
"<p>តម្លៃនេះ​គ្រប់គ្រង​និយតភាព​ភាព​រលោង​​របស់​​គោលដៅរូបភាព ។ "
"កុំប្រើ​តម្លៃ​ខ្ពស់​នៅទីនេះ "
"​គោលដៅ​រូបភាពផ្សេងទៀត​នឹង​ត្រូវបាន​ធ្វើឲ្យ​ព្រិល​យ៉ាង​ពេញលេញ ។"

#: imageeffect_inpainting.cpp:264
msgid "Iterations:"
msgstr "អន្តរកម្ម ៖"

#: imageeffect_inpainting.cpp:269
msgid "<p>Sets the number of times the filter is applied on the target image."
msgstr "​<p>កំណត់​ចំនួន​ដង​ដែល​បាន​អនុវត្តតម្រង​ទៅ​លើគោលដៅរូបភាព ។"

#: imageeffect_inpainting.cpp:277
msgid "Advanced Settings"
msgstr "​ការកំណត់​កម្រិត​ខ្ពស់"

#: imageeffect_inpainting.cpp:279
msgid "Angular step:"
msgstr "​ជំហាន​ដែល​មាន​ជ្រុង​ស្រួច ៖ "

#: imageeffect_inpainting.cpp:284
msgid ""
"<p>Set here the angular integration step in degrees in analogy to anisotropy."
msgstr ""
"​"
"<p>កំណត់​ជំហាន​រួម​បញ្ចូល​គ្នា​ដែល​មាន​ជ្រុង​ស្រួច​គិត​ជា​អង្សា​នៅ​ក្នុង​សទិសភាព"
"​ទៅ​និវត្តទិស ។"

#: imageeffect_inpainting.cpp:288
msgid "Integral step:"
msgstr "​ជំហាន​រួម​បញ្ចូល​គ្នា ៖"

#: imageeffect_inpainting.cpp:293
msgid "<p>Set here the spatial integral step. Stay below 1."
msgstr "<p>កំណត់​ជំហាន​រួម​បញ្ចូល​គ្នា​នៃ​ទំហំ​ក្នុង​លំហរ ។ នៅ​ពី​ក្រោម​ ១ ។"

#: imageeffect_inpainting.cpp:297
msgid "Gaussian:"
msgstr "​Gaussian ៖ "

#: imageeffect_inpainting.cpp:302
msgid "<p>Set here the precision of the Gaussian function."
msgstr "​<p>កំណត់​ចំនួន​ខ្ទង់​នៃ​អនុគមន៍ Gaussian ។"

#: imageeffect_inpainting.cpp:306
msgid "Use linear interpolation"
msgstr "​ប្រើ​ការ​ថែមថយ​លីនីអ៊ែរ"

#: imageeffect_inpainting.cpp:307
msgid "<p>Enable this option to quench the last bit of quality (slow)."
msgstr "<p>បើក​ជម្រើស​នេះ​ដើម្បី​បង្ក្រាប​ប៊ីត​ចុងក្រោយ​នៃ​គុណភាព (យឺត)​ ។"

#: imageeffect_inpainting.cpp:310
msgid "Normalize photograph"
msgstr "​ធ្វើ​រូបថត​ឲ្យ​សាមញ្ញ"

#: imageeffect_inpainting.cpp:311
msgid "<p>Enable this option to process an output image normalization."
msgstr ""
"​"
"<p>បើក​ជម្រើស​ដើម្បី​ចូល​ដំណើរ​ការ​លទ្ធផល​ការ​ធ្វើ​ឲ្យ​រូបភាព​សាមញ្ញ ។"

#: imageeffect_inpainting.cpp:556
msgid "InPainting"
msgstr "ការគូរ​ខាងក្នុង"

#: imageeffect_inpainting.cpp:581
msgid "Photograph Inpainting Settings File to Load"
msgstr "ឯកសារ​ការកំណត់​គូរ​ខាងក្នុង​រូបថត​​ដើម្បីផ្ទុក"

#: imageeffect_inpainting.cpp:593
msgid "\"%1\" is not a Photograph Inpainting settings text file."
msgstr "\"%1\" មិនមែន​ជា​ឯកសារ​អត្ថបទ​​ការកំណត់​គូរ​ខាងក្នុង​រូបថត​ទេ ។"

#: imageeffect_inpainting.cpp:614
msgid "Cannot load settings from the Photograph Inpainting text file."
msgstr "មិនអាច​ផ្ទុក​ការកំណត់​​ពី​ឯកសារ​អត្ថបទ​​គូរពីខាងក្នុង​រូបថត​បានទេ ។"

#: imageeffect_inpainting.cpp:623
msgid "Photograph Inpainting Settings File to Save"
msgstr "ការកំណត់​ឯកសារ​ការគូរ​ពីខាងក្នុង​រូបថត​ដើម្បី​រក្សាទុក"

#: imageeffect_inpainting.cpp:645
msgid "Cannot save settings to the Photograph Inpainting text file."
msgstr ""
"មិន​អាច​រក្សា​ការកំណត់​​ទៅ​កាន់​ឯកសារ​អត្ថបទ​គូរ​ពីខាងក្នុង​រូបថត​បានទេ ។"

#: imageplugin_inpainting.cpp:42
msgid "Inpainting..."
msgstr "កំពុង​គូរ​ពីខាងក្នុង..."

#: imageplugin_inpainting.cpp:46
msgid ""
"This filter can be used to inpaint a part in a photo. Select a region to "
"inpaint to use this option."
msgstr ""
"តម្រង​នេះ​អាចត្រូវបានប្រើ​សម្រាប់​​គូរ​​ផ្នែក​ខាងក្នុង​ផ្នែក​មួយ​នៃ​រូបថត ។ "
"ជ្រើស​តំបន់​មួយ​​គូរ​ពីខាងក្នុង​​ដើម្បី​ប្រើ​ជម្រើស​នេះ ។"

#. i18n: file digikamimageplugin_inpainting_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "​ជួសជុល"
