#: imageeffect_border.cpp:55
msgid "Add Border Around Photograph"
msgstr "បន្ថែម​ស៊ុម​ជុំវិញ​រូបថត"

#: imageeffect_border.cpp:64 imageeffect_border.cpp:463
msgid "Add Border"
msgstr "បន្ថែម​ស៊ុម"

#: imageeffect_border.cpp:66
msgid "A digiKam image plugin to add a border around an image."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​ digiKam ដើម្បី​បន្ថែម​​ស៊ុម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:72
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: imageeffect_border.cpp:82
msgid "Type:"
msgstr "ប្រភេទ ៖"

#: imageeffect_border.cpp:85
msgid "Solid"
msgstr "តាន់"

#: imageeffect_border.cpp:88
msgid "Beveled"
msgstr "ជ្រុងទេរ"

#: imageeffect_border.cpp:89
msgid "Decorative Pine"
msgstr "ស្រល់​ស្រស់​ស្អាត"

#: imageeffect_border.cpp:90
msgid "Decorative Wood"
msgstr "ឈើ​ស្រស់​ស្អាត"

#: imageeffect_border.cpp:91
msgid "Decorative Paper"
msgstr "ក្រដាស់​ស្រស់ស្អាត"

#: imageeffect_border.cpp:92
msgid "Decorative Parque"
msgstr "ក្ដារក្រាល​ស្រស់ស្អាត"

#: imageeffect_border.cpp:93
msgid "Decorative Ice"
msgstr "ទឹកកក​ស្រស់ស្អាត"

#: imageeffect_border.cpp:94
msgid "Decorative Leaf"
msgstr "ស្លឹកឈើ​ស្រស់ស្អាត"

#: imageeffect_border.cpp:95
msgid "Decorative Marble"
msgstr "ថ្មម៉ាប​ស្រស់ស្អាត"

#: imageeffect_border.cpp:96
msgid "Decorative Rain"
msgstr "តំណក់​ភ្លៀង​ស្រស់ស្អាត"

#: imageeffect_border.cpp:97
msgid "Decorative Craters"
msgstr "រណ្ដៅ​ភ្នំភ្លើង​ស្រស់ស្អាត"

#: imageeffect_border.cpp:98
msgid "Decorative Dried"
msgstr "រីងស្ងួត​ស្រស់ស្អាត"

#: imageeffect_border.cpp:99
msgid "Decorative Pink"
msgstr "ផ្កាឈូក​ស្រស់ស្អាត"

#: imageeffect_border.cpp:100
msgid "Decorative Stone"
msgstr "ដុំ​ថ្ម​ស្រស់ស្អាត"

#: imageeffect_border.cpp:101
msgid "Decorative Chalk"
msgstr "ដីស​ស្រស់ស្អាត"

#: imageeffect_border.cpp:102
msgid "Decorative Granite"
msgstr "ក្រានីត​ស្រស់ស្អាត"

#: imageeffect_border.cpp:103
msgid "Decorative Rock"
msgstr "ផ្ទាំងថ្ម​ស្រស់ស្អាត"

#: imageeffect_border.cpp:104
msgid "Decorative Wall"
msgstr "ជញ្ជាំង​ស្រស់ស្អាត"

#: imageeffect_border.cpp:105
msgid "<p>Select here the border type to add around the image."
msgstr "<p>ជ្រើស​ប្រភេទ​ស៊ុម ដើម្បី​បន្ថែម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:110
msgid "Width:"
msgstr "ទទឹង​ ៖"

#: imageeffect_border.cpp:112
msgid "<p>Set here the border width in pixels to add around the image."
msgstr "<p>នៅ​ទី​នេះ​កំណត់​ទទឹង​ស៊ុម​គិត​ជា​ភីកសែល ដើម្បី​បន្ថែម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:324
msgid "First:"
msgstr "ទី​មួយ ៖"

#: imageeffect_border.cpp:325
msgid "Second:"
msgstr "ទីពីរ ៖"

#: imageeffect_border.cpp:326
msgid "<p>Set here the foreground color of the border."
msgstr "<p>កំណត់​ពណ៌​ផ្ទៃ​ខាង​មុខ​របស់​ស៊ុម​នៅ​ទីនេះ ។"

#: imageeffect_border.cpp:327
msgid "<p>Set here the Background color of the border."
msgstr "<p>កំណត់​ពណ៌​ផ្ទៃ​ខាង​ក្រោយ​របស់​ស៊ុម​នៅ​ទីនេះ ។"

#: imageeffect_border.cpp:343
msgid "<p>Set here the color of the main border."
msgstr "<p>កំណត់​ពណ៌​របស់​ស៊ុម​មេ​នៅ​ទីនេះ ។"

#: imageeffect_border.cpp:344
msgid "<p>Set here the color of the line."
msgstr "<p>កំណត់​ពណ៌​របស់​បន្ទាត់​នៅ​ទីនេះ ។"

#: imageeffect_border.cpp:350
msgid "<p>Set here the color of the upper left area."
msgstr "<p>កំណត់​ពណ៌​របស់​ផ្ទៃ​ខាង​លើ​ឆ្វេង​នៅ​ទីនេះ ។"

#: imageeffect_border.cpp:351
msgid "<p>Set here the color of the lower right area."
msgstr "<p>កំណត់​ពណ៌​របស់​ផ្ទៃ​ខាង​ក្រោម​ស្ដាំ​នៅទីនេះ ។"

#: imageeffect_border.cpp:372
msgid "<p>Set here the color of the first line."
msgstr "<p>កំណត់​ពណ៌​របស់​បន្ទាត់​ទីមួយ​នៅ​ទីនេះ ។"

#: imageeffect_border.cpp:373
msgid "<p>Set here the color of the second line."
msgstr "<p>កំណត់​ពណ៌​របស់​បន្ទាត់​ទីពីរ​នៅ​ទីនេះ ។"

#: imageplugin_border.cpp:42
msgid "Add Border..."
msgstr "បន្ថែម​ស៊ុម..."

