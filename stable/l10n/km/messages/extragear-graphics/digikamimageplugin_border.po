#: imageeffect_border.cpp:62 imageeffect_border.cpp:467
msgid "Add Border"
msgstr "បន្ថែម​ស៊ុម"

#: imageeffect_border.cpp:64
msgid "A digiKam image plugin to add a border around an image."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​ digiKam សម្រាប់​បន្ថែម​ស៊ុម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:71
