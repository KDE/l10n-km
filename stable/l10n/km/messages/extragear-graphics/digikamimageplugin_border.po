#: imageeffect_border.cpp:65 imageeffect_border.cpp:563
msgid "Add Border"
msgstr "បន្ថែម​ស៊ុម"

#: imageeffect_border.cpp:67
msgid "A digiKam image plugin to add a border around an image."
msgstr "កម្មវិធី​ជំនួយ​រូបភាព​ digiKam សម្រាប់​បន្ថែម​ស៊ុម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:74
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង អ្នក​ថែទាំ"

#: imageeffect_border.cpp:77
msgid "Developer"
msgstr "អ្នក​អភិវឌ្ឍន៍"

#: imageeffect_border.cpp:87
msgid "Type:"
msgstr "​ប្រភេទ ៖"

#: imageeffect_border.cpp:90
msgid "Solid"
msgstr "​តាន់"

#: imageeffect_border.cpp:93
msgid "Beveled"
msgstr "ជ្រុងទេរ"

#: imageeffect_border.cpp:94
msgid "Decorative Pine"
msgstr "ស្រល់​ស្រស់ស្អាត"

#: imageeffect_border.cpp:95
msgid "Decorative Wood"
msgstr "ឈើ​ស្រស់ស្អាត"

#: imageeffect_border.cpp:96
msgid "Decorative Paper"
msgstr "ក្រដាស់​ស្រស់ស្អាត"

#: imageeffect_border.cpp:97
msgid "Decorative Parquet"
msgstr "ក្ដារក្រាល​ស្រស់ស្អាត"

#: imageeffect_border.cpp:98
msgid "Decorative Ice"
msgstr "ទឹកកក​ស្រស់ស្អាត"

#: imageeffect_border.cpp:99
msgid "Decorative Leaf"
msgstr "ស្លឹកឈើ​ស្រស់ស្អាត"

#: imageeffect_border.cpp:100
msgid "Decorative Marble"
msgstr "ថ្មម៉ាប​ស្រស់ស្អាត"

#: imageeffect_border.cpp:101
msgid "Decorative Rain"
msgstr "ភ្លៀង​ស្រស់ស្អាត"

#: imageeffect_border.cpp:102
msgid "Decorative Craters"
msgstr "រណ្ដៅ​ភ្នំភ្លើង​ស្រស់ស្អាត"

#: imageeffect_border.cpp:103
msgid "Decorative Dried"
msgstr "រីងស្ងួត​ស្រស់ស្អាត"

#: imageeffect_border.cpp:104
msgid "Decorative Pink"
msgstr "ផ្កាឈូក​ស្រស់ស្អាត"

#: imageeffect_border.cpp:105
msgid "Decorative Stone"
msgstr "ដុំ​ថ្ម​ស្រស់ស្អាត"

#: imageeffect_border.cpp:106
msgid "Decorative Chalk"
msgstr "ដីស​ស្រស់ស្អាត"

#: imageeffect_border.cpp:107
msgid "Decorative Granite"
msgstr "ក្រានីត​ស្រស់ស្អាត"

#: imageeffect_border.cpp:108
msgid "Decorative Rock"
msgstr "ផ្ទាំងថ្ម​ស្រស់ស្អាត"

#: imageeffect_border.cpp:109
msgid "Decorative Wall"
msgstr "ជញ្ជាំង​ស្រស់ស្អាត"

#: imageeffect_border.cpp:110
msgid "<p>Select here the border type to add around the image."
msgstr "<p>ជ្រើស​ប្រភេទ​ស៊ុម ដើម្បី​បន្ថែម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:117
msgid "Preserve Aspect Ratio"
msgstr "រក្សា​សមាមាត្រ"

#: imageeffect_border.cpp:118
msgid ""
"Enable this option if you want to preserve aspect ratio of image. If enabled, "
"the border width will be in percent of image size, else the border width will "
"in pixels."
msgstr ""
"អនុញ្ញាត​ជម្រើស​នេះ ប្រសិន​បើ​អ្នក​ចង់​រក្សាសមាមាត្រ​របស់​រូបភាព ។ "
"ប្រសិន​បើ​បា​ន​អនុញ្ញាត ទទឹង​ស៊ុម​នឹង​គិត​ជា​ភាគរយ​នៃ​ទំហំ​រូបភាព "
"បើ​មិនដូច្នេះ​ទេ ទទឹង​ស៊ុម​នឹង​គិត​ជា​ភីកសែល ។"

#: imageeffect_border.cpp:123
msgid "Width (%):"
msgstr "ទទឹង (%) ៖"

#: imageeffect_border.cpp:126
msgid "<p>Set here the border width in percents of image size."
msgstr "<p>នៅ​ទី​នេះ​ កំណត់​ទទឹង​ស៊ុម​គិត​ជា​ភាគរយ​របស់​ទំហំ​រូបភាព ។"

#: imageeffect_border.cpp:128
msgid "Width (pixels):"
msgstr "ទទឹង (ភីកសែល) ៖"

#: imageeffect_border.cpp:130
msgid "<p>Set here the border width in pixels to add around the image."
msgstr ""
"<p>នៅ​ទី​នេះ​កំណត់​ទទឹង​ស៊ុម​គិត​ជា​ភីកសែល ដើម្បី​បន្ថែម​ជុំវិញ​រូបភាព ។"

#: imageeffect_border.cpp:377
msgid "First:"
msgstr "ទីមួយ ៖"

#: imageeffect_border.cpp:378
msgid "Second:"
msgstr "ទីពីរ ៖"

#: imageeffect_border.cpp:379
msgid "<p>Set here the foreground color of the border."
msgstr "<p>កំណត់​ពណ៌​ផ្ទៃ​ខាង​មុខ​របស់​ស៊ុម ។"

#: imageeffect_border.cpp:380
msgid "<p>Set here the Background color of the border."
msgstr "<p>កំណត់​ពណ៌​ផ្ទៃ​ខាង​ក្រោយ​របស់​ស៊ុម ។"

#: imageeffect_border.cpp:396
msgid "<p>Set here the color of the main border."
msgstr "<p>កំណត់​ពណ៌​របស់​ស៊ុម​មេ ។"

#: imageeffect_border.cpp:397
msgid "<p>Set here the color of the line."
msgstr "<p>កំណត់​ពណ៌​របស់​បន្ទាត់ ។"

#: imageeffect_border.cpp:403
msgid "<p>Set here the color of the upper left area."
msgstr "<p>កំណត់​ពណ៌​របស់​ផ្ទៃ​ខាង​លើ​ឆ្វេង ។"

#: imageeffect_border.cpp:404
msgid "<p>Set here the color of the lower right area."
msgstr "<p>កំណត់​ពណ៌​របស់​ផ្ទៃ​ខាង​ក្រោម​ស្ដាំ ។"

#: imageeffect_border.cpp:425
msgid "<p>Set here the color of the first line."
msgstr "<p>កំណត់​ពណ៌​របស់​បន្ទាត់​ទីមួយ ។"

#: imageeffect_border.cpp:426
msgid "<p>Set here the color of the second line."
msgstr "<p>កំណត់​ពណ៌​របស់​បន្ទាត់​ទីពីរ ។"

#: imageplugin_border.cpp:42
msgid "Add Border..."
msgstr "បន្ថែម​ស៊ុម..."

#: imageplugin_border.cpp:63
msgid "Add Border Around Photograph"
msgstr "បន្ថែម​ស៊ុម​ជុំវិញ​រូបថត"

