#: plugin_katetextfilter.cpp:66
msgid "Filter Te&xt..."
msgstr "តម្រង​អត្ថបទ..."

#: plugin_katetextfilter.cpp:256
msgid ""
"You are not allowed to execute arbitrary external applications. If you want "
"to be able to do this, contact your system administrator."
msgstr "អ្នក​មិន​អនុញ្ញាត​អោយ​ប្រតិបត្តិ​កម្មវិធី​ខាង​ក្រៅ arbitrary បាន​ទេ​ ។ ប្រសិន​បើ​អ្នក​ចង់​មាន​លទ្ធ​ភាព​ដើម្បី​ធ្វើ​ការងារ​នេះ ,​សូម​ទំនាក់ទំនង​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​របស់​អ្នក ។​"

#: plugin_katetextfilter.cpp:258
msgid "Access Restrictions"
msgstr "ចូល​ដំណើរការ​ការ​ដាក់​កម្រិត"

#: plugin_katetextfilter.cpp:267
msgid "Filter"
msgstr "តម្រង"

#: plugin_katetextfilter.cpp:268
msgid "Enter command to pipe selected text through:"
msgstr "បញ្ចូល​ពាក្យ​បញ្ជា​ទៅ​បំពង់​ឯកសារ​ដែល​បាន​ជ្រើស​តាម ៖ ​"

#: plugin_katetextfilter.cpp:310
msgid ""
"<qt><p>Usage: <code>textfilter COMMAND</code></p><p>Replace the selection "
"with the output of the specified shell command.</p></qt>"
msgstr "<qt><p>ការ​ប្រើប្រាស់ ៖ <code>textfilter COMMAND</code></p><p>​ជំនួស​ការ​ជ្រើស​ជាមួយ​លទ្ធផល​នៃ​ពាក្យ​បញ្ជា​សែល​ដែល​បាន​បញ្ជាក់ ។</p></qt>"

#: plugin_katetextfilter.cpp:319
msgid "You need to have a selection to use textfilter"
msgstr "អ្នក​ត្រូវការ​មាន​ការ​ជ្រើស​មួយ​ដើម្បី​ប្រើ​តម្រង​អត្ថបទ"

#: plugin_katetextfilter.cpp:327
msgid "Usage: textfilter COMMAND"
msgstr "ការ​ប្រើប្រាស់ ៖ ពាក្យ​បញ្ជា​តម្រង​អត្ថបទ"

