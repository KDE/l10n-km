msgstr "ផ្នែក​នៃ​អង្គការ"

#: kfile_cert.cpp:62 kfile_cert.cpp:70
msgid "Locality"
msgstr "តំបន់"

#: kfile_cert.cpp:63 kfile_cert.cpp:71
msgid "Country"
msgstr "ប្រទេស"

#: kfile_cert.cpp:64 kfile_cert.cpp:72
msgid "Common Name"
msgstr "ឈ្មោះ​ធម្មតា"

#: kfile_cert.cpp:65 kfile_cert.cpp:73
