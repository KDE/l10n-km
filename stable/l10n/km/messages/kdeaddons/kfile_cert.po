#: kfile_cert.cpp:59
msgid "Subject"
msgstr "ប្រធាន​បទ"

#: kfile_cert.cpp:60 kfile_cert.cpp:68
msgid "Organization"
msgstr "អង្គការ"

#: kfile_cert.cpp:61 kfile_cert.cpp:69
