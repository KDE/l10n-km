#: kfile_cert.cpp:53
msgid "Certificate Information"
msgstr "ព័ត៌មាន​វិញ្ញាបនបត្រ"

#: kfile_cert.cpp:54
msgid "Valid From"
msgstr "មាន​សុពលភាពចាប់​ពី"

#: kfile_cert.cpp:55
msgid "Valid Until"
msgstr "មាន​ប្រសិទ្ធិភាព​រហូតដល់"

#: kfile_cert.cpp:56
msgid "State"
