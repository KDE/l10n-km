#: kfile_lnk.cpp:46
msgid "Windows Link File Information"
msgstr "បង្អួច​ព័ត៌មាន​តំណ​ឯកសារ"

#: kfile_lnk.cpp:51
msgid "Size of Target"
msgstr "ទំហំ​នៃ​គោលដៅ"

#: kfile_lnk.cpp:54
msgid "Location"
msgstr "ទីតាំង"

#: kfile_lnk.cpp:55
msgid "Points To"
msgstr "ចង្អុល​ទៅ"

#: kfile_lnk.cpp:56
msgid "Description"
msgstr "ការពិពណ៌នា"

#: kfile_lnk.cpp:78
#, c-format
msgid "on Windows disk: %1"
msgstr "នៅ​លើ​ថាស​បង្អួច ៖ %1"

#: kfile_lnk.cpp:83
msgid "on network share"
msgstr "នៅ​លើ​ការ​ចែក​រំលែក​បណ្ដាញ"

#: lnkforward.cpp:37
msgid "lnkforward"
msgstr "lnkforward"

#: lnkforward.cpp:39
msgid "KDE tool for opening URLs given in a Windows .lnk file"
msgstr ""
"ឧបករណ៌ KDE សម្រាប់​ការ​បើក URLs ត្រូវ​បាន​អោយ​នៅ​ក្នុង​បង្អួច​តំណ​ឯកសារ"

#: lnkforward.cpp:45
msgid ""
"Map a Windows drive to a local mountpoint, e.g. \"C=/mnt/windows\"\n"
"This option can be given multiple times"
msgstr ""
"ផ្គូផ្គ​ដ្រាយ​បង្អួច​ទៅ​ចំណុច​ម៉ោន​មូលដ្ឋាន , ឧ. \"C=/mnt/windows\"\n"
"ជម្រើស​នេះ​អាច​ត្រូវ​បាន​ផ្ដល់​អោយ​ច្រើន​ដង"

#: lnkforward.cpp:47
msgid "Windows .lnk file to open"
msgstr "បង្អួច​តំណ​ឯកសារ​ដើម្បី​បើក"
