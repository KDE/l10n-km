msgid "Volume Control Implementation"
msgstr "ការប្រតិបត្តិ​គ្រប់គ្រង​កម្រិត​សម្លេង"

#: mediacontrol.cpp:130
msgid "Fix for JuK-Support"
msgstr "ជួសជុល​សម្រាប់​ការគាំទ្រ JuK"

#: mediacontrol.cpp:132
msgid "mpd-Support"
msgstr "ការគាំទ្រ mpd"

#: mediacontrol.cpp:155
msgid "Configure MediaControl..."
msgstr "កំណត់​រចនាសម្ព័ន្ធ​វត្ថុបញ្ជា​មេឌៀ..."

#: mediacontrol.cpp:157
msgid "About MediaControl"
msgstr "អំពី​វត្ថុ​បញ្ជា​មេឌៀ"

#: mediacontrol.cpp:214
msgid "Start the player"
msgstr "ចាប់ផ្តើម​ឧបករណ៏​ចាក់"

#: mediacontrol.cpp:425
msgid "There was trouble loading theme %1. Please choose a different theme."
msgstr "មាន​បញ្ហា​​ការផ្ទុក​ស្បែក​ %1 ។ សូម​ជ្រើស​​ស្បែក​មួយផ្សេង​ទៀត ។"

#: mpdInterface.cpp:140
msgid ""
"Connection refused to %1:%2.\n"
"Is mpd running?"
msgstr ""
"ការ​តភ្ជាប់​ត្រូវបាន​​បដិសេធទៅកាន់ %1:%2 ។\n"
"តើ mpd កំពុង​រត់​មែនទេ?"

#: mpdInterface.cpp:143
msgid "Host '%1' not found."
msgstr "ម៉ាស៊ីន «%1» រកមិនឃើញ ។"

#: mpdInterface.cpp:146
msgid "Error reading socket."
msgstr "ការអាន​រន្ធ​មាន​កំហុស ។"

#: mpdInterface.cpp:149
msgid "Connection error"
msgstr "ការ​តភ្ជាប់​មាន​កំហុស"

#: mpdInterface.cpp:154 mpdInterface.cpp:209
msgid "MediaControl MPD Error"
msgstr "MediaControl MPD មាន​កំហុស​"

#: mpdInterface.cpp:155
msgid "Reconnect"
msgstr "​ភ្ជាប់​ឡើង​វិញ"

#: mpdInterface.cpp:562
#, c-format
msgid "No tags: %1"
msgstr "គ្មាន​ស្លាក ៖ %1"

#: playerInterface.cpp:32
msgid "Could not start media player."
msgstr "មិនអាច​ចាប់ផ្តើម​ឧបករណ៏​ចាក់​​មេឌៀ​បានទេ ។"

