#: image_plugin.cpp:71
msgid "You want to overwrite the left picture with the one on the right."
msgstr "អ្នក​ចង់​សរសេរ​ជាន់លើ​រូបភាព​នៅ​ខាង​​ឆ្វេង​​ដោយ​រូបភាព​មួយនៅ​ខាង​ស្តាំ ។"

#: imagevisualizer.cpp:46
msgid ""
"This picture isn't stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"រូបភាព​នេះ​មិន​ត្រូវ​បាន​​ទុក\n"
"នៅ​លើ​ម៉ាស៊ីន​មូលដ្ឋាន​ទេ ។\n"
"ចុច​លើ​ស្លាក​នេះ​​ដើម្បី​ផ្ទុក​វា ។\n"

#: imagevisualizer.cpp:54
msgid "Unable to load image"
msgstr "មិន​អាច​ផ្ទុក​រូបភាព​បាន​ទេ"

#: imagevisualizer.cpp:67
msgid ""
"_: The color depth of an image\n"
"Depth: %1\n"
msgstr "ជម្រៅ ៖ %1\n"

#: imagevisualizer.cpp:68
#, c-format
msgid ""
"_: The dimensions of an image\n"
"Dimensions: %1x%1"
msgstr "វិមាត្រ ៖ %1x%1"

