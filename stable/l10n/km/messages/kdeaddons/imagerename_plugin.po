#: image_plugin.cpp:71
#, fuzzy
msgid "You want to overwrite the left picture with the one on the right."
msgstr "អ្នកចង់​សរសេរ​ជាន់លើ​រូបភាពឆ្វេង​​ជាមួយ​រូបភាពមួយនៅខាងស្តាំ ។"

#: imagevisualizer.cpp:46
#, fuzzy
msgid ""
"This picture isn't stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"រូបភាពនេះ​មិនត្រូវបាន​រក្សា\n"
"នៅលើ​ម៉ាស៊ីន​មូលដ្ឋានទេ ។\n"
"ចុច​លើ​ស្លាកនេះ​​ដើម្បី​ផ្ទុក​វា ។\n"

#: imagevisualizer.cpp:54
#, fuzzy
msgid "Unable to load image"
msgstr "មិនអាច​ផ្ទុករូបភាព​បានទេ"

