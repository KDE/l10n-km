msgstr "ស្វែងរក​ក្រុមហ៊ុន​ផ្ដល់ ៖ "

#: lyrics.cpp:44
msgid "Search Provider"
msgstr "ស្វែងរក​ក្រុមហ៊ុន​ផ្ដល់"

#: lyrics.cpp:45
