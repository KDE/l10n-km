msgid "Search Toolbar"
msgstr "របារ​ឧបករណ៍​ស្វែងរក"

#: searchbar.cpp:69
msgid "Search Bar"
msgstr "របារ​ស្វែងរក"

#: searchbar.cpp:77
msgid ""
"Search Bar"
"<p>Enter a search term. Click on the icon to change search mode or provider."
msgstr ""
"របារ​ស្វែងរក"
"<p>​បញ្ចូល​ពាក្យ​ដែល​ត្រូវ​ស្វែងរក ។ "
"ចុច​លើ​ប៊ូតុង​ដើម្បី​ប្ដូរ​របៀប​ស្វែងរក​កម្មវិធី​ផ្ដល់អោយ ។"

#: searchbar.cpp:80
msgid "Focus Searchbar"
msgstr "កំណុំ​របារ​ស្វែងរក​"

#: searchbar.cpp:318
msgid "Find in This Page"
msgstr "រក​ក្នុង​ទំព័រ​នេះ"

#: searchbar.cpp:349
msgid "Select Search Engines..."
msgstr "ជ្រើស​ម៉ាស៊ីន​ស្វែងរក"

