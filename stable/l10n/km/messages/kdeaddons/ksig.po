#: ksig.cpp:107
msgid "Search"
msgstr "ស្វែងរក"

#: ksig.cpp:120
msgid ""
"To get started, first create a new signature by selecting \"New\" above. You "
"will then be able to edit and save your collection of signatures."
msgstr ""
"ដើម្បី​ចាប់​ផ្ដើម , ដំបូង​បង្កើត​ហត្ថលេខា​ថ្មី​មួយ​ដោយ​ជ្រើស \"ថ្មី\" ខាង​លើ ។ "
"អ្នក បន្ទាប់​មក​នឹង​អាច​កែ​សម្រួល​និង​រក្សាការ​ប្រមូល​ហត្ថលេខា​របស់​អ្នក​ទុក ។"

#: ksig.cpp:170
msgid "Do you want to save your changes before exiting?"
msgstr "តើ​អ្នក​ចង់​រក្សា​ការ​ផ្លាស់​ប្ដូរ​របស់​អ្នក​ទុក​មុន​ពេល​ចេញឬ ?"

#: ksig.cpp:222
msgid "Standard signature header:"
msgstr "បឋម​កថា​ហត្ថលេខាខ្នាត​គម្រូ ៖"

#: ksig.cpp:233
msgid "Standard signature footer:"
msgstr "បាត​កថា​ហត្ថលេខា​ខ្នាត​គម្រូ ៖"

#: main.cpp:27 main.cpp:39
msgid "KSig"
msgstr "KSig"

#: main.cpp:31
msgid "Display a random signature"
msgstr "បង្ហាញ​ហត្ថលេខា​ដែល​ចៃដន្យ"

#: main.cpp:32
msgid "Display a signature for the day"
msgstr "បង្ហាញ​ហត្ថលេខា​សម្រាប់​ពេល​ថ្ងៃ"

