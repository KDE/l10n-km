#: _translatorinfo.cpp:3 vimpart_factory.cpp:83
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "piseth_dv@khmeros.info​"

#: vimpart_factory.cpp:77
msgid "VimPart"
msgstr "VimPart"

#: vimpart_factory.cpp:78
msgid "VimPart - Vim embedded in KDE"
msgstr "VimPart - Vim បាន​បង្កប់​នៅក្នុង KDE"

#: vimpart_factory.cpp:80
msgid "(c) 2002"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ​ ២០០២"

#: vimpart_factory.cpp:81
msgid "Initial Version"
msgstr "កំណែ​ដំបូង"

#: vimpart_factory.cpp:82
msgid "KTextEditor implementation; improvements"
msgstr "​ការប្រតិបត្តិ KTextEditor​ ។ ធ្វើឲ្យ​ប្រសើរ"

#: vimpart_shell.cpp:39
msgid "&Open File..."
msgstr "បើក​ឯកសារ..."

#: vimpart_shell.cpp:119
msgid "No libvimpart found."
msgstr "រក libvimpart មិនឃើញ ។"

#: vimpart_shell.cpp:148
msgid "Files to load"
msgstr "ឯកសារដែល​​ត្រូវ​ផ្ទុក"

#: vimpart_shell.cpp:152
msgid "Test Shell for the vim kpart."
msgstr "សាកល្បង សែល​សម្រាប់ vim kpart ។"

#: vimview.cpp:138
msgid "Save the current document"
msgstr "​រក្សាទុក​ឯកសារ​បច្ចុប្បន្ន"

#: vimview.cpp:142
msgid "Revert the most recent editing actions"
msgstr "​ត្រឡប់​សកម្មភាព​កែសម្រួល​​ថ្មី​បំផុត​ទៅ​ដើម"

#: vimview.cpp:146
msgid "Revert the most recent undo operation"
msgstr "​ត្រឡប់​ប្រតិបត្តិការ​មិន​ធ្វើ​វិញ​ថ្មី​ៗបំផុត​ទៅ​ដើម"

#: vimview.cpp:150
msgid "Cut the selected text and move it to the clipboard"
msgstr "​កាត់​អត្ថបទ​ដែល​បាន​ជ្រើស និង ផ្លាស់​ទី​វា​ទៅ​ក្ដារ​តម្បៀត​ខ្ទាស់"

#: vimview.cpp:154
msgid "Paste previously copied or cut clipboard contents"
msgstr "​បិទ​ភ្ជាប់​មាតិកា​របស់​ក្ដារ​តម្បៀត​ខ្ទាស់​ដែល​បាន​​កាត់ ឬ ចម្លង​ពី​មុន ។"

#: vimview.cpp:159
msgid "Closes the current document."
msgstr "បិទ​ឯកសារ​បច្ចុប្បន្ន"

#: vimview.cpp:163
msgid "Use this command to copy the currently selected text to the system clipboard."
msgstr ""
"​ប្រើ​ពាក្យ​បញ្ជា​នេះ ដើម្បី​ចម្លង​អត្ថបទ​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន "
"ទៅ​ក្ដារ​តម្បៀត​ខ្ទាស់របស់​​ប្រព័ន្ធ ។​"

#: vimview.cpp:167
msgid "Save the current document to disk, with a name of your choice."
msgstr "​រក្សា​ទុក​ឯកសារ​បច្ចុប្បន្ន​ទៅ​ថាស ជា​មួយ​នឹង​​ឈ្មោះ​មួយ​នៃ​ជម្រើស​របស់​អ្នក ។"

#: vimview.cpp:171
msgid ""
"This command opens a dialog and lets you choose a line that you want the "
"cursor to move to."
msgstr ""
"​ពាក្យ​បញ្ជា​នេះ​បើក​​ប្រអប់​មួយ និង "
"​អនុញ្ញាត​​ឲ្យ​អ្នក​ជ្រើស​បន្ទាត់​មួយ​ដែល​អ្នក​ចង់​ឲ្យ​ទស្សន៍​ទ្រនិច​​ផ្លាស់​ទី​"
"ទៅ​កាន់ ។"

#: vimview.cpp:175
msgid "Select the entire text of the current document."
msgstr "​ជ្រើស​អត្ថបទ​ទាំង​មូល​នៃ​ឯកសារ​បច្ចុប្បន្ន ។"

#: vimview.cpp:179
msgid "Find text in the current document."
msgstr "រក​អត្ថបទ​នៅក្នុង​ឯកសារ​បច្ចុប្បន្ន"

#: vimwidget.cpp:83 vimwidget.cpp:93
msgid "Please use the KDE control module and configure the Vim component."
msgstr "សូម​ប្រើ​​ម៉ូឌុល​បញ្ជា KDE និង​កំណត់​រចនាសម្ព័ន្ធ​សមាសភាគ Vim ។"

#: vimwidget.cpp:83 vimwidget.cpp:93 vimwidget.cpp:102 vimwidget.cpp:110
#: vimwidget.cpp:117
msgid "Vim Error"
msgstr "កំហុស​ Vim"

#: vimwidget.cpp:98
msgid ""
"\n"
"Unable to start the Vim editing control. Use the KDE Control Center to "
"reconfigure and test your Vim component.\n"
msgstr ""
"\n"
"មិនអាច​ចាប់ផ្តើម​វត្ថុបញ្ជា​កែសម្រួល Vim ។ ប្រើ​មជ្ឈមណ្ឌល​ត្រួតពិនិត្យ KDE​ ដើម្បី​កំណត់រចនា​សម្ព័ន្ធ​ឡើងវិញ​ និង​សាកល្បង​សមាសភាគ​ Vim របស់​អ្នក ។\n"

#: vimwidget.cpp:101
msgid "Please use the KDE control module and configure the Vim component.\n"
msgstr "សូម​ប្រើ​​ម៉ូឌុល​បញ្ជា KDE និង​កំណត់​រចនាសម្ព័ន្ធ​សមាសភាគ Vim ។\n"

#: vimwidget.cpp:109
msgid "Vim executable '%1' does not exist or is not accessible.\n"
msgstr "Vim ដែលអាច​ប្រតិបត្តិ «%1» មិនមាន រឺ មិន​អាច​ចូលដំណើរ​ការ​បានទេ ។\n"

#: vimwidget.cpp:116
msgid "Vim executable '%1' is not executable.\n"
msgstr "Vim ដែលអាច​​ប្រតិបត្តិ %1' iគឺមិនអាច​ប្រតិបត្តិ​បានទេ ។\n"

#: xvim_win.cpp:25
msgid "Select Mode"
msgstr "​ជ្រើស​របៀប"

#: xvim_win.cpp:27
msgid "Evaluate expressions"
msgstr "វាយតម្លៃ​កន្សោម"

#: xvim_win.cpp:29
msgid "Send keys"
msgstr "គ្រាប់ចុច​បញ្ជូន"

#: xvim_win.cpp:55
#, c-format
msgid "Error code: %1"
msgstr "​កូដ​កំហុស ៖ %1"

#: xvim_win.cpp:57
#, c-format
msgid "Result: %1"
msgstr "លទ្ធផល ៖ %1"

#: xvimstart.cpp:32
msgid "XVIM"
msgstr "XVIM"

#: xvimstart.cpp:32
msgid "A Vim remote command tool"
msgstr "Vim ឧបករណ៏​បញ្ជា​ពីចម្ងាយ"

