#: wakeup.cpp:169
#, fuzzy
msgid "Wakeup"
msgstr "ភ្ញាក់ឡើង"

#: wakeup.cpp:169
#, fuzzy
msgid "Alarm Configuration"
msgstr "ការ​កំណត់​រចនាសម្ព័ន្ធ​សម្លេងរោទ៍"

#: wakeup.cpp:203
#, fuzzy
msgid "Select days:"
msgstr "ជ្រើស​ថ្ងៃ ៖"

#: wakeup.cpp:204
#, fuzzy
msgid "Hour"
msgstr " ម៉ោង"

#: wakeup.cpp:205
#, fuzzy
msgid "Minute"
msgstr "​​នាទី"

#: wakeup.cpp:240
#, fuzzy
msgid "Volume Control"
msgstr "ឧបករណ៍​បញ្ជា​កម្រិត​សម្លេង"

#: wakeup.cpp:241
#, fuzzy
msgid "No change to volume, just starts the player"
msgstr "គ្មាន​ការប្តូរ​ទៅ​កម្រិត​សម្លេង គ្រាន់តែ​ចាប់ផ្តើម​ឧបករណ៏​ចាក់​"

#: wakeup.cpp:242
#, fuzzy
msgid "The volume decreases slowly and finally stops the player"
msgstr "កម្រិត​សម្លេង​បន្ថយ​យ៉ាងយឺតៗ ហើយ​ទីបញ្ចប់​បញ្ឈប់​ឧបករណ៏​ចាក់​"

#: wakeup.cpp:243
#, fuzzy
msgid "The player starts and the volume increases to the chosen value"
msgstr "ឧបករណ៏​ចាក់​ចាប់ផ្តើម ហើយ​កម្រិត​សម្លេង​បង្កើន​ទៅកាន់​តម្លៃ​ដែល​បាន​ជ្រើស"

#: wakeup.cpp:248
#, fuzzy
msgid "Volume increases to:"
msgstr "កម្រិត​សម្លេង​បង្កើន​ទៅ ៖"

