#: thinkpad.cpp:90
msgid "Mute on"
msgstr "បើក ស្ងាត់"

#: thinkpad.cpp:90
msgid "Mute off"
msgstr "បិទ ស្ងាត់"

#: thinkpad.cpp:99
msgid "Thinkpad Button Pressed"
msgstr "ចុច​ប៊ូតុង​Thinkpad "

#: thinkpad.cpp:107
msgid "ThinkLight is on"
msgstr "ThinkLight ត្រូវ​បាន​បើក"

#: thinkpad.cpp:107
msgid "ThinkLight is off"
msgstr "ThinkLight ត្រូវ​បាន​បិទ"

#: thinkpad.cpp:142
msgid "Zoom button pressed"
msgstr "ចុច​ប៊ូតុង​ពង្រីក"

#: thinkpad.cpp:151
msgid "Home button pressed"
msgstr "ចុច​ប៊ូតុង Home"

#: thinkpad.cpp:159
msgid "Search button pressed"
msgstr "ចុច​ប៊ូតុង​ Search"

#: thinkpad.cpp:167
msgid "Mail button pressed"
msgstr "ចុច​ប៊ូតុង​ Mail"

#: thinkpad.cpp:190
msgid "Display changed: LCD on, CRT off"
msgstr "ទិដ្ឋភាព​ត្រូវ​បានប្តូរ ៖ LCD បើក, CRT បិទ"

#: thinkpad.cpp:194
msgid "Display changed: LCD off, CRT on"
msgstr "ទិដ្ឋភាព​ត្រូវ​បានប្តូរ ៖ LCD បើក, CRT បិទ"

#: thinkpad.cpp:198
msgid "Display changed: LCD on, CRT on"
msgstr "ទិដ្ឋភាព​ត្រូវ​បានប្តូរ ៖ LCD បើក, CRT បើក"

#: thinkpad.cpp:205
msgid "HV Expansion is on"
msgstr "HV ការពង្រី​គឺ​ បើក"

#: thinkpad.cpp:205
msgid "HV Expansion is off"
msgstr "HV ការពង្រី​គឺ​ បិទ"

#: thinkpad.cpp:212
msgid "Power management mode AC changed: PM AC high"
msgstr "របៀប​គ្រប់គ្រង​ថាមពល AC បានប្តូរ ៖ PM AC ខ្ពស់"

#: thinkpad.cpp:216
msgid "Power management mode AC changed: PM AC auto"
msgstr "របៀប​គ្រប់គ្រង​ថាមពល AC បានប្តូរ ៖ PM AC ដោយ​ស្វ័យប្រវត្តិ"

#: thinkpad.cpp:220
msgid "Power management mode AC changed: PM AC manual"
msgstr "របៀប​គ្រប់គ្រង​ថាមពល AC បានប្តូរ ៖ PM AC ដោយដៃ"

#: thinkpad.cpp:224
msgid "Power management mode AC changed: PM AC unknown"
msgstr "របៀប​គ្រប់គ្រង​ថាមពល AC បានប្តូរ ៖ PM AC មិន​ស្គាល់"

#: thinkpad.cpp:233
msgid "Power management mode battery changed: PM battery high"
msgstr "របៀប​គ្រប់គ្រង​ការប្តូរថ្ម ៖ ថ្ម PM មានគុណភាពខ្ពស់"

#: thinkpad.cpp:237
msgid "Power management mode battery changed: PM battery auto"
msgstr "របៀប​គ្រប់គ្រង​ការប្តូរថ្ម ៖ ថ្ម PM ដោយស្វ័យប្រវត្តិ"

#: thinkpad.cpp:241
msgid "Power management mode battery changed: PM battery manual"
msgstr "របៀប​គ្រប់គ្រង​ការប្តូរថ្ម ៖ ថ្ម PM ដោយ​ដៃ"

#: thinkpad.cpp:245
msgid "Power management mode battery changed: PM battery unknown"
msgstr "របៀប​គ្រប់គ្រង​ការប្តូរថ្ម ៖ មិនស្គាល់​ថ្ម PM"

#: thinkpad.cpp:252
msgid "Wireless LAN is enabled"
msgstr "LAN ឥតខ្សែ គឺត្រូវ​បានអនុញ្ញាត"

#: thinkpad.cpp:252
msgid "Wireless LAN is disabled"
msgstr "LAN ឥតខ្សែ គឺ មិនត្រូវ​បានអនុញ្ញាត"

#: thinkpad.cpp:257
msgid "Bluetooth is enabled"
msgstr "ប្ល៊ូធូស ត្រូវបានអនុញ្ញាត"

#: thinkpad.cpp:257
msgid "Bluetooth is disabled"
msgstr "ប្ល៊ូធូស មិនត្រូវបានអនុញ្ញាត"

