#: main.cpp:34
msgid "KDE Floppy Disk Utility"
msgstr "ឧបករណ៍​ថាស​ទន់​របស់ KDE"

#: main.cpp:38
msgid "Default device"
msgstr "ឧបករណ៍​លំនាំ​ដើម"

#: main.cpp:45
msgid "KFloppy"
msgstr "KFloppy"

#: main.cpp:51
msgid "KFloppy helps you format floppies with the filesystem of your choice."
msgstr ""
"KFloppy "
"ជួយ​អ្នក​ឲ្យ​ធ្វើ​ទ្រង់ទ្រាយ​ថាសទន់​ដែល​មាន​ប្រព័ន្ធ​ឯកសារ​នៃ​ជម្រើស​របស់​អ្នក ។"

#: main.cpp:54
msgid "Author and former maintainer"
msgstr "អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​ពីមុន"

#: main.cpp:55
msgid "User interface re-design"
msgstr "រចនា​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ឡើង​វិញ"

#: main.cpp:56
msgid "Add BSD support"
msgstr "បន្ថែម​ការ​គាំទ្រ BSD"

#: main.cpp:57
msgid "Make KFloppy work again for KDE 3.4"
msgstr "ធ្វើ​ឲ្យ KFloppy ដំណើរ​ការ​ម្ដង​ទៀត​សម្រាប់ KDE 3.4"

#: format.cpp:269
#, c-format
msgid "Unexpected drive number %1."
msgstr "លេខ​ដ្រាយ %1ដែល​មិន​រំពឹង​ទុក ។"

#: format.cpp:275
#, c-format
msgid "Unexpected density number %1."
msgstr "លេខ​ដង់​ស៊ីតេ %1 ដែល​មិន​បាន​រំពឹង​ទុក ។"

#: format.cpp:290
msgid "Cannot find a device for drive %1 and density %2."
msgstr "មិន​អាច​រក​ឧបករណ៍​សម្រាប់​ដ្រាយ %1 និង​ដង់ស៊ីតេ %2 ។"

#: format.cpp:309
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"មិន​អាច​ចូល​ដំណើរ​ការ %1\n"
"សូម​ប្រាកដ​ថា​មាន​ឧបករណ៍ និង​ប្រាកដ​ថា​អ្នក​មាន​សិទ្ធិ​សរសេរ​ទៅ​កាន់​វា ។"

#: format.cpp:340
msgid "The program %1 terminated with an error."
msgstr "កម្មវិធី %1 បាន​បញ្ចប់​ដោយ​មាន​កំហុស​មួយ ។"

#: format.cpp:346
msgid "The program %1 terminated abnormally."
msgstr "កម្មវិធី %1 បាន​បញ្ចប់​ដោយ​មិន​ធម្មតា ។"

#: format.cpp:409 format.cpp:570 format.cpp:669 format.cpp:770 format.cpp:849
#: format.cpp:943
msgid "Internal error: device not correctly defined."
msgstr "កំហុស​ខាង​ក្នុង ៖ ឧបករណ៍​បាន​កំណត់​​​មិន​ត្រឹមត្រូវ ។"

#: format.cpp:416
msgid "Cannot find fdformat."
msgstr "មិន​អាច​រក fdformat ។"

#: format.cpp:448
msgid "Could not start fdformat."
msgstr "មិន​អាច​ចាប់​ផ្ដើម fdformat ។"

#: format.cpp:475
#, c-format
msgid "Error formatting track %1."
msgstr "កំហុស​ក្នុង​ការ​ធ្វើ​ទ្រង់ទ្រាយ​ដាន %1 ។"

#: format.cpp:483 format.cpp:516
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"មិន​អាច​ចូល​ដំណើរ​ការ​ថាស​ទន់ ឬ ដ្រាយ​ថាស​ទន់ ។\n"
"សូម​បញ្ចូល​ថាស​ទន់ និង​ប្រាកដ​ថា អ្នក​បាន​ជ្រើស​ដ្រាយ​ថាស​ទន់​ត្រឹមត្រូវ ។"

#: format.cpp:504
#, c-format
msgid "Low-level formatting error at track %1."
msgstr "កំហុស​​ធ្វើ​ទ្រង់ទ្រាយ​កម្រិត​ទាប​នៅ​ដាន %1 ។"

#: format.cpp:509
#, c-format
msgid "Low-level formatting error: %1"
msgstr "កំហុស​ធ្វើ​ទ្រង់ទ្រាយ​កម្រិត​ទាប ៖ %1"

#: format.cpp:523 format.cpp:726 format.cpp:892 format.cpp:983
msgid ""
"Device busy.\n"
"Perhaps you need to unmount the floppy first."
msgstr ""
"ឧបករណ៍​ជាប់​រវល់ ។\n"
"ប្រហែល​ជា ដំបូង​អ្នក​​មិន​រៀបចំ​ថាស​ទន់ ។"

#: format.cpp:529
#, c-format
msgid "Low-level format error: %1"
msgstr "កំហុស​ធ្វើ​ទ្រង់ទ្រាយ​កម្រិត​ទាប ៖ %1"

#: format.cpp:577
msgid "Cannot find dd."
msgstr "មិន​អាច​រក dd ។"

#: format.cpp:592
msgid "Could not start dd."
msgstr "មិន​អាច​ចាប់​ផ្ដើម dd ។"

#: format.cpp:676
msgid "Cannot find a program to create FAT filesystems."
msgstr "មិន​អាច​រក​កម្មវិធី​មួយ ដើម្បី​បង្កើត​ប្រព័ន្ធ​ឯកសារ FAT ។"

#: format.cpp:707
msgid "Cannot start FAT format program."
msgstr "មិន​អាច​ចាប់​ផ្ដើម​កម្មវិធី​ធ្វើ​ទ្រង់ទ្រាយ FAT ។"

#: format.cpp:721 format.cpp:887 format.cpp:978
msgid ""
"Floppy is mounted.\n"
"You need to unmount the floppy first."
msgstr ""
"ថាស​ទន់​ត្រូវ​បាន​រៀបចំ ។\n"
"ជា​ដំបូង អ្នក​ត្រូវ​តែមិន​រៀបចំ​ថាស​ទន់ ។"

#: format.cpp:777
msgid ""
"_: BSD\n"
"Cannot find a program to create UFS filesystems."
msgstr "មិន​អាច​រក​កម្មវិធី​មួយ ដើម្បី​បង្កើត​ប្រព័ន្ធ​ឯកសារ UFS ។"

#: format.cpp:795
msgid ""
"_: BSD\n"
"Cannot start UFS format program."
msgstr "មិន​អាច​ចាប​់​ផ្ដើម​កម្មវិធី​ធ្វើ​ទ្រង់ទ្រាយ UFS ។"

#: format.cpp:856
msgid "Cannot find a program to create ext2 filesystems."
msgstr "មិន​អាច​រក​កម្មវិធី​មួយ ដើម្បី​បង្កើត​ប្រព័ន្ធ​ឯកសារ ext2 ។​"

#: format.cpp:873
msgid "Cannot start ext2 format program."
msgstr "មិន​អាច​ចាប់​ផ្ដើម​កម្មវិធី​ធ្វើ​ទ្រង់ទ្រាយ ext2 ។"

#: format.cpp:950
msgid "Cannot find a program to create Minix filesystems."
msgstr "មិនអាច​រក​កម្មវិធី​មួយ ដើម្បី​បង្កើត​ប្រព័ន្ធ​ឯកសារ Minix ។"

#: format.cpp:967
msgid "Cannot start Minix format program."
msgstr "មិន​អាច​ចាប់​ផ្ដើម​កម្មវិធី​ធ្វើ​ទ្រង់ទ្រាយ Minix ។"

