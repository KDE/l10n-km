#. i18n: file ui/directoryserviceswidgetbase.ui line 124
#: rc.cpp:54
#, fuzzy, no-c-format
msgid ""
"<qt>\n"
"<h1>X.500 Directory Services</h1>\n"
"You can use X.500 directory services to retrieve certificates and certificate "
"revocation lists that are not saved locally. Ask your local administrator if "
"you want to make use of this feature and are unsure which directory service you "
"can use.\n"
"<p>\n"
"If you do not use a directory service, you can still use local certificates.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>X.៥០០ សេវា​ថត​</h1>\n"
"អ្នក​អាច​ប្រើ​ X.៥០០ សេវា​ថត​ដើម្បី​ទៅ​យកវិញ្ញាបនបត្រនិង ​ "
"ការលុប​វិញ្ញាបនបត្រពី​បញ្ជី​ដែល​មិន​បាន​រក្សាទុកកន្លែង​ណាមួយ​ ។  "
"ស្នើ​ទៅ​មូល​ដ្ឋាន​អ្នកគ្រប់គ្រង​ បើ​អ្នកចង់​ប្រើ​លក្ខណៈពិសេស​បែប​នេះ​ហើយ "
"មិន​ច្បាស់​សេវា​ថត​មួយ​ណា​អ្នក​អាច​មើល​ ។ \n"
"<p>\n"
"បើ​អ្នក​មិន​ប្រើ​សេវា​ថត​ អ្នក​នៅ​តែ​អាច​ប្រើ​មូលដ្ឋាន​វិញ្ញាបនបត្រ ។\n"
"</qt>"

