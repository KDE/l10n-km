#, no-c-format
msgid "A Multipart/Signed holding Signature and signed data."
msgstr ""
"ហត្ថលេខា​រង់ចាំដែលមាន​ច្រើន​ផ្នែក​/ចុះហត្ថលេខា និង "
"ទិន្នន័យ​ដែលបាន​ចុះហត្ថលេខា ។"

#. i18n: file signatureconfigurationdialog.ui line 328
#: rc.cpp:659
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Multipart detached signature</h1>\n"
"When this option is selected, the signature and the signed data will be "
"separate parts of a Multipart/Signed message part. Signed message data will be "
"readable even by Mail User Agents not supporting the signaturing algorithm and "
"not supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ហត្ថលេខា​ដែល​បាន​ផ្ដាច់​ច្រើន​ផ្នែក​</h1>\n"
"នៅពេល​ដែល​បាន​ជ្រើស​ជម្រើស​នេះ ហត្ថលេខា​ និង ទិន្នន័យ​ដែលបាន​ចុះហត្ថលេខា "
"នឹងជាផ្នែក​ដែល​ដាក់​ផ្សេងពីគ្នា​នៃ​​ផ្នែកសា​ដែល​ដែលមានផ្នែក​ច្រើន/ដែលបាន​ចុះហត្ថ"
"លេខា ។ ទិន្នន័យ​សារ​ដែល​បាន​ចុះហត្ថលេខា "
"នឹងជា​ការដែលអាច​អានបាន​ដោយ​ភ្នាក់ងារ​អ្នកប្រើ​សំបុត្រ​ដែលមិន​គាំទ្រក្បួន​ដោះស្រា"
"យ​ការចុះហត្ថលេខា និង មិនគាំទ្រ​ឌិកូឌីង ASN.1 ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 344
#: rc.cpp:665
#, no-c-format
msgid "Opa&que (only recommended for SPHINX)"
msgstr "ស្រអាប់ (បាន​ផ្ដល់អនុសាសន៍​តែសម្រាប់​ SPHINX)"

#. i18n: file signatureconfigurationdialog.ui line 347
#: rc.cpp:668
#, no-c-format
msgid "Signature and signed data encoded in one ASN.1 block."
msgstr ""
"ទិន្នន័យ​ហត្ថលេខា និង ទិន្នន័យ​ដែលបាន​​ចុះហត្ថលេខាបានអ៊ិនកូដនៅក្នុងប្លុក ASN.1 "
"មួយ ។"

#. i18n: file signatureconfigurationdialog.ui line 353
#: rc.cpp:671
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Opaque signed messages</h1>\n"
"When this option is selected, both the signature and the signed data will be "
"encoded into one ASN.1 block. Messages will be readable only by Mail User "
"Agents supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ហត្ថលេខា​ដែលបាន​ចុះហត្ថលេខា​ស្រអាប់</h1>\n"
"នៅពេល​ដែល​បាន​ជ្រើស​ជម្រើស​នេះ ទាំងហត្ថលេខា​ "
"ទាំង​ទិន្នន័យ​ដែល​បាន​ចុះហត្ថលេខា​នឹងត្រូវបាន​អ៊ិនកូដ​ទៅក្នុង​ប្លុក ASN.1 មួយ ។ "
"សារ​នឹង​បានតែ​អានបាន​ដោយ​ភ្នាក់ងារ​អ្នកប្រើ​សំបុត្រ​ដែលគាំទ្រ​ការ​ឌិកូដ​ "
"ASN.1 ។\n"
"</qt>"

