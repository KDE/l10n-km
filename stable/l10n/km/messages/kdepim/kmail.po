#. i18n: file signatureconfigurationdialog.ui line 173
#: rc.cpp:581
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Sign All Message Parts By Default</h1>\n"
"If this option is selected, all parts of a message (i.e. the main message body "
"and all attachments) are signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ចុះហត្ថលេខា​នៅគ្រប់​ផ្នែក​នៃ​សារទាំងអស់​តាមលំនាំដើម</h1>\n"
"ប្រសិនបើ​បាន​ជ្រើស​ជម្រើស​នេះ ផ្នែក​ទាំងអស់​របស់សារ (មានន័យថា តួសារ​ចម្បង​ និង "
"ឯកសារ​ភ្ជាប់ទាំងអស់) ត្រូវបាន​ចុះហត្ថលេខា​តាមលំនាំដើម ។\n"
"<p>\n"
"នេះជា​ការកំណត់​លំនាំដើម ដែលអ្នកនៅតែអាច​បដិសេធ​វា​ចំពោះ​សាររៀងខ្លួន​នីមួយៗ ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 181
#: rc.cpp:589
#, no-c-format
msgid "Ask &before signing each part"
msgstr "សួរ​មុនេះពេល​ចុះ​ហត្ថលេខា​ផ្នែក​នីមួយៗ"

#. i18n: file signatureconfigurationdialog.ui line 184
#: rc.cpp:592
#, no-c-format
msgid "Check to be asked for each part whether to sign"
msgstr "ធីក ដើម្បី​ឲ្យ​សួររក​ផ្នែក​នីមួយៗ​ថាតើ​ត្រូវ​ចុះហត្ថលេខា​ឬអត់"

#. i18n: file signatureconfigurationdialog.ui line 190
#: rc.cpp:595
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Ask Before Signing Each Part</h1>\n"
"When this option is selected, you will be asked for each part of the message "
"(i.e. the main message body as well as all attachments) individually whether "
"you want the part to be signed.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>សួរ​មុនពេល​ចុះហត្ថលេខា​ផ្នែក​នីមួយៗ</h1>\n"
"នៅពេល​ដែល​បាន​ជ្រើស​ជម្រើស​នេះ "
"អ្នកនឹងត្រូវបាន​សួរ​រក​ផ្នែកផ្សេងៗគ្នា​​នីមួយៗ​របស់​សារ (មានន័យថា "
"តួសារ​ចម្បង​គឺ​ល្អប្រសើ​ដូចជា​ឯកសារ​ភ្ជាប់​ទាំងអស់) ថាតើ "
"អ្នកចង់​ឲ្យផ្នែកត្រូវបាន​ចុះហត្ថលេខា ។\n"
"</qt>"

