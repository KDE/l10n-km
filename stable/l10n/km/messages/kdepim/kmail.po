msgstr "កុំ​ចុះហត្ថលេខា​លើសារ"

#. i18n: file signatureconfigurationdialog.ui line 201
#: rc.cpp:604
#, no-c-format
msgid "Check for not signing a message by default"
msgstr "ពិនិត្យ​រកមើល​ការ​មិនចុះហត្ថលេខា​លើសារ​តាមលំនាំដើម"

#. i18n: file signatureconfigurationdialog.ui line 209
#: rc.cpp:607
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Do Not Sign Messages</h1>\n"
"If this option is selected, messages are not signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"setting.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>កុំ​ចុះហត្ថលេខា​លើសារ</h1>\n"
"ប្រសិនបើ​បាន​ធីក​ជម្រើស​នេះ សារ​មិនត្រូវបាន​ចុះហត្ថលេខា​តាម​លំនាំដើម​ឡើយ ។\n"
"<p>\n"
"នេះ​ជាការកំណត់​លំនាំដើម "
"ដែលអ្នកនៅតែអាច​បដិសេធ​វា​សម្រាប់​ការកំណទ់ផ្សេងៗគ្នា​នីមួយៗ ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 217
#: rc.cpp:615
#, no-c-format
msgid "The signature certificate is configured on the <em>Certificates</em> page."
msgstr ""
"វិញ្ញាបនបត្រ​ហត្ថលេខា​​ត្រូវបាន​កំណត់​រចនា​សម្ព័ន្ធ​នៅលើ​ទំព័រ <em>"
"វិញ្ញាបនបត្រ</em> ។"

#. i18n: file signatureconfigurationdialog.ui line 226
#: rc.cpp:618
#, no-c-format
msgid "RSA + SHA-1"
msgstr "RSA + SHA-1"

#. i18n: file signatureconfigurationdialog.ui line 233
#: rc.cpp:621
#, no-c-format
msgid "Selects the signature algorithm"
msgstr "ជ្រើស​ក្បួនដោះស្រាយ​ហត្ថលេខា"

#. i18n: file signatureconfigurationdialog.ui line 243
#: rc.cpp:624
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Signature Algorithm</h1>\n"
"An algorithm is a description for the computer on how it should perform a "
"certain task. The signature algorithm describes how the computer applies your "
"signature key to your message so that the receiver can determine whether the "
"message really is from you.\n"
"<p>\n"
"The selection of a certain signature algorithm determines how easy or how "
"difficult it is to forge a message. However, all algorithms provided in the "
"SPHINX environment are considered to be very safe. Generally, the default will "
"work just fine here.\n"
"<p>\n"
"This setting is a default, you can override it for each individual message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ក្បួន​ដោះស្រាយ​ហត្ថលេខា</h1>\n"
"ក្បួន​ដោះស្រាយ គឺជា​​ការពណ៌នា​សម្រាប់​កុំព្យូទ័រ​ "
"នៅលើរបៀប​ដែល​វា​គួរតែធ្វើ​ភារកិច្ច​ដែលមាន ។ ក្បួនដោះស្រាយ​ហត្ថលេខា "
"ពណ៌នា​អំពី​របៀប​ដែល​កុំព្យូទ័រ​អនុវត្ត​សោ​ហត្ថលេខារបស់អ្នក​ទៅ​សាររបស់អ្នក​ "
"ដូច្នេះ​អ្នកទទួល​អាច​កំណត់​ថាតើ​​សារពិត​ជា​មកពីអ្នក​មែន​ឬអត់ ។\n"
"<p>\n"
"ជម្រើស​នៃ​ក្បួនដោះស្រាយ​ហត្ថលេខា​ពិតប្រាកដ​កំណត់​ថា​ វាលំបាក​យ៉ាងណា ឬ "
"ស្រួល​យ៉ាងណា​ក្នុង​ការ​ក្លែងបន្លំ​សារ ។ ទោះជាយ៉ាងណា​ក៏ដោយ "
"ក្បួនដោះស្រាយ​ទាំងអស់​បានផ្ដល់​នៅក្នុង​បរិស្ថាន SPHINX  "
"គឺត្រូវបាន​​ចាត់ទុកថា​មាន​សុវត្ថិភាព​បំផុត ។ ជាទូទៅ "
"លំនាំដើម​ធ្វើការ​ល្អ​បាន​តែ​នៅទីនេះ​ប៉ុណ្ណោះ ។\n"
"<p>\n"
"ការកំណត់​នេះ​គឺជា​លំនាំដើម​មួយ "
"ដែលអ្នកអាច​បដិសេធ​វា​សម្រាប់​សារ​ផ្សេងៗគ្នា​នីមួយៗ ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 251
