#: kmreaderwin.cpp:563
msgid "Show the list of headers in a fancy format"
msgstr "បង្ហាញ​បញ្ជី​នៃ​បឋមកថា​​នៅក្នុង​ទ្រង់ទ្រាយ​ដែល​ល្អ"

#: kmreaderwin.cpp:567
msgid ""
"_: View->headers->\n"
"&Brief Headers"
msgstr "បឋមកថា​សង្ខេប"

#: kmreaderwin.cpp:570
msgid "Show brief list of message headers"
msgstr "បង្ហាញ​បញ្ជី​សង្ខេប​នៃ​បឋមកថា​សារ"

#: kmreaderwin.cpp:574
msgid ""
"_: View->headers->\n"
"&Standard Headers"
msgstr "បឋមកថា​ខ្នាត​គំរូ"

#: kmreaderwin.cpp:577
msgid "Show standard list of message headers"
msgstr "បង្ហាញ​បញ្ជី​​ខ្នាត​គំរូ​នៃ​បឋមកថា​សារ"

#: kmreaderwin.cpp:581
msgid ""
"_: View->headers->\n"
"&Long Headers"
msgstr "បឋមកថា​វែង"

#: kmreaderwin.cpp:584
msgid "Show long list of message headers"
msgstr "បង្ហាញ​បញ្ជី​ដែល​វែង​នៃ​បឋមកថា​សារ"

#: kmreaderwin.cpp:588
msgid ""
"_: View->headers->\n"
"&All Headers"
msgstr "បឋមកថា​ទាំងអស់"

#: kmreaderwin.cpp:591
msgid "Show all message headers"
msgstr "បង្ហាញ​បឋមកថា​សារទាំងអស់"

#: kmreaderwin.cpp:597
msgid ""
"_: View->\n"
"&Attachments"
msgstr "ឯកសារ​ភ្ជាប់"

#: kmreaderwin.cpp:598
msgid "Choose display style of attachments"
msgstr "ជ្រើស​រចនាប័ទ្ម​បង្ហាញ​នៃ​ឯកសារ​ភ្ជាប់"

#: kmreaderwin.cpp:602
msgid ""
"_: View->attachments->\n"
"&As Icons"
msgstr "ជា​រូបតំណាង"

#: kmreaderwin.cpp:605
msgid "Show all attachments as icons. Click to see them."
msgstr "បង្ហាញ​ឯកសារ​ភ្ជាប់ទាំងអស់​ជា​រូបតំណាង ។ ចុច​ដើម្បី​មើល​ពួកវា ។"

#: kmreaderwin.cpp:609
msgid ""
"_: View->attachments->\n"
"&Smart"
msgstr "ឆ្លាត"

