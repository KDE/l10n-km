#. i18n: file encryptionconfigurationdialog.ui line 97
#: rc.cpp:217
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Encrypt All Message Parts By Default</h1>\n"
"If this option is selected, all parts of a message (i.e. the main message body "
"and all attachments) are encrypted by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>អ៊ិនគ្រីប​ផ្នែក​សារ​ទាំងអស់​តាម​លំនាំដើម</h1>\n"
"ប្រសិនបើ​បាន​ជ្រើស​​ជម្រើស​នេះ ផ្នែក​ទាំងអស់​របស់សារ (មានន័យថា​ តួសារ​ចម្បង​ "
"និង ឯកសារ​ភ្ជាប់ទាំងអស់) គឺត្រូវបាន​អ៊ិនគ្រីបតាមលំនាំដើម ។\n"
"<p>\n"
"នេះគឺ​ជាការ​កំណត់​លំនាំដើម "
"អ្នក​នៅតែអាច​បដិសេធ​វា​ចំពោះ​សារផ្ទាល់ខ្លួន​នីមួយៗ ។\n"
"</qt>"

#. i18n: file encryptionconfigurationdialog.ui line 105
#: rc.cpp:225
#, no-c-format
msgid "Ask &before encrypting each part"
msgstr "សួរ​មុនពេល​ធ្វើការ​អ៊ិនគ្រីប​ផ្នែក​នីមួយៗ"

#. i18n: file encryptionconfigurationdialog.ui line 108
#: rc.cpp:228
#, no-c-format
msgid "Check to be asked for each part whether to encrypt"
msgstr "ធីក​ ដើម្បី​ឲ្យ​គេសួររក​ផ្នែក​នីមួយៗ​ថាតើ​ត្រូវ​អ៊ិនគ្រីប​ឬអត់"

#. i18n: file encryptionconfigurationdialog.ui line 114
#: rc.cpp:231
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Ask Before Encrypting Each Part</h1>\n"
"When this option is selected, you will be asked for each part of the message "
"(i.e. the main message body as well as all attachments) individually whether "
"you want the part to be encrypted.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>សួរ​មុនពេល​ធ្វើការ​អ៊ិនគ្រីប​ផ្នែក​នីមួយៗ</h1>\n"
"នៅពេលដែល​បាន​ជ្រើស​ជម្រើស​នេះ "
"អ្នកនឹង​ត្រូវបាន​សួរ​រក​ផ្នែក​នីមួយ​របស់សារផ្ទាល់ខ្លួន (មានន័យថា តួសារ​ចម្បង "
"ក៏ដូចជាឯកសារភ្ជាប់​ទាំងអស់) ថាតើ​អ្នកចង់​ឲ្យ​អ៊ិនគ្រីប​ផ្នែក​ឬអត់ ។\n"
"</qt>"

#. i18n: file encryptionconfigurationdialog.ui line 122
#: rc.cpp:237
#, no-c-format
msgid "&Do not encrypt messages"
msgstr "កុំ​អ៊ិនគ្រីប​សារ"

#. i18n: file encryptionconfigurationdialog.ui line 125
#: rc.cpp:240
#, no-c-format
msgid "Check for not encrypting a message by default"
msgstr "ធីក ដើម្បី​កុំ​ឲ្យ​ធ្វើការ​អ៊ិនគ្រីប​សារ​តាម​លំនាំដើម"

#. i18n: file encryptionconfigurationdialog.ui line 133
#: rc.cpp:243
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Do Not Encrypt Messages</h1>\n"
"If this option is selected, messages are not encrypted by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"setting.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>កុំធ្វើការអ៊ិនគ្រីប​សារ​តាម​លំនាំដើម</h1>\n"
"ប្រសិនបើបាន​ជ្រើស​ជម្រើស​នេះ សារគឺ​មិនត្រូវបាន​អ៊ិនគ្រីប​តាមលំនាំ​ដើមឡើយ ។\n"
"<p>\n"
"នេះ​ជា​ការកំណត់​លំនាំដើម "
"អ្នក​នៅតែអាច​បដិសេធ​វា​ចំពោះ​ការកំណទ់​ផ្ទាល់ខ្លួន​នីមួយៗ ។\n"
"</qt>"

#. i18n: file encryptionconfigurationdialog.ui line 139
#: rc.cpp:251
#, no-c-format
msgid "Triple-DES"
msgstr "Triple-DES"

#. i18n: file encryptionconfigurationdialog.ui line 146
#: rc.cpp:254
#, no-c-format
msgid "Selects the encryption algorithm"
msgstr "ជ្រើស​ក្បួន​ដោះស្រាយ​ការអ៊ិនគ្រីប"

#. i18n: file encryptionconfigurationdialog.ui line 156
#: rc.cpp:257
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Encryption Algorithm</h1>\n"
"An algorithm is a description for the computer on how it should perform a "
"certain task. The encryption algorithm describes how the computer applies your "
"recipient's key to your message so that only the intended receiver can read the "
"message.\n"
"<p>\n"
"The selection of a certain encryption algorithm determines how easy or how "
"difficult it is to intercept and read a message. However, all algorithms "
"provided in the SPHINX environment are considered to be very safe. Generally, "
"the default will work just fine here.\n"
"<p>\n"
"This setting is a default, you can override it for each individual message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ក្បួន​ដោះស្រាយ​ការអ៊ិនគ្រីប</h1>\n"
"ក្បួន​ដោះស្រាយ​ គឺ​ជា​សេចក្ដី​ពណ៌នា​សម្រាប់​កុំព្យូទ័រ "
"លើរបៀប​ដែលវា​គួរតែ​ធ្វើ​ភារកិច្ច​ជាក់លាក់មួយ ។ ក្បួន​ដោះស្រាយ​ការអ៊ិនគ្រីប​ "
"ពិពណ៌នាអំពី​របៀបដែល​កុំព្យូទ័រ​អនុវត្ត​សោអ្នកទទួល​របស់អ្នក​ទៅកាន់​សាររបស់អ្នក "
"ដូចនោះហើយ មានតែអ្នកទទួល​ដែល​បាន​បម្រុង​ទុកប៉ុណ្ណោះ​ដែល​អាច​អាន​សារ​បាន ។\n"
"<p>\n"
"ការជ្រើស​រើស​ក្បួនដោះស្រាយ​ការអ៊ិនគ្រីបជាក់លាក់មួយ កំណត់​ពី​របៀប​ងាយស្រួល​ និង​ "
"ពិបាកដែលវាទប់ស្កាត់ និង​ អាន​សារ ។ ទោះជាយ៉ាងណា​ក៏ដោយ "
"ក្បួន​ដោះស្រាយ​ទាំងអស់​បាន​ផ្ដល់​នៅក្នុងបរិស្ថាន SPHINX "
"គឺត្រូវបាន​គិតថា​មាន​សុវត្ថភាព​ ។ ជាទូទៅ "
"លំនាំដើម​នឹងធ្វើការ​ល្អ​​បានតែ​នៅទីនេះ​ប៉ុណ្ណោះ ។\n"
"<p>\n"
"ការកំណត់​នេះ​ជា​លំនាំ​ដើម ដែលអ្នកអាច​បដិសេធ​វា​ចំពោះ​សារ​ផ្ទាល់ខ្លួន​នីមួយៗ ។\n"
"</qt>"

