#: rc.cpp:732 rc.cpp:941
#, no-c-format
msgid "Warn when trying to send &unsigned messages"
msgstr "ព្រមាន​ នៅពេល​ដែល​កំពុងព្យាយាម​ផ្ញើ​សារ​ដែល​មិនទាន់បាន​ចុះហត្ថលេខា"

#. i18n: file signatureconfigurationdialog.ui line 563
#: rc.cpp:735 rc.cpp:944
#, no-c-format
msgid "Check to be warned when sending unsigned messages."
msgstr ""
"ពិនិត្យ​មើល​ដើម្បី​ទទួល​យក​ការព្រមាន​នៅពេល​ដែល​កំពុង​ផ្ញើ​សារ​ដែល​មិនទាន់​បាន​ចុ"
"ះហត្ថលេខា ។"

#. i18n: file signatureconfigurationdialog.ui line 571
#: rc.cpp:738 rc.cpp:947
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn When Trying To Send Unsigned Messages</h1>\n"
"If this box is checked, you will be warned when you try to send parts of or the "
"whole message unsigned.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ព្រមាន​ នៅពេលដែល​កំពុងព្យាយាម​ផ្ញើ​សារ​ដែល​មិនទាន់បាន​ចុះហត្ថលេខា</h1>\n"
"ប្រសិនបើ​បាន​ធីក​ប្រអប់​នេះ "
"អ្នកនឹង​ត្រូវបាន​ព្រមាន​នៅពេល​ដែល​អ្នកព្យាយាម​ផ្ញើ​សារ​មួយផ្នែក​ ឬ​ "
"ទាំងមូលដែលមិនបាន​​ចុះហត្ថលេខានោះ ។\n"
"<p>\n"
"វា​ត្រូវ​បាន​ផ្ដល់​អនុសាសន៍​ឲ្យ​ទុក​ជម្រើស​នេះ​នៅបើក​សម្រាប់​ការរួមបញ្ចូល​គ្នា​អ"
"តិបរមា ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 579
#: rc.cpp:746
#, no-c-format
msgid "Warn if CA certificate e&xpires in less than:"
msgstr "ព្រមាន​ ប្រសិនបើ​វិញ្ញាបនបត្រ CA ផុតកំណត់​ក្នុង​ពេល​តិចជាង ៖"

#. i18n: file signatureconfigurationdialog.ui line 593
#: rc.cpp:752 rc.cpp:780 rc.cpp:794
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Certificate Expires</h1>\n"
"If this option is checked, then you will be warned when trying to use a "
"certificate for signing that expires within the specified amount of days.\n"
"<p>\n"
"It is recommended to keep this option turned on to avoid using certificates "
"that expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ព្រមាន​ប្រសិនបើ​វិញ្ញាបនបត្រ​ផុតកំណត់</h1>\n"
"ប្រសិនបើ​បាន​ធីក​ជម្រើស​នេះ "
"ពេលនោះ​អ្នកនឹង​ត្រូវបាន​ព្រមាន​នៅពេល​ដែល​កំពុងព្យាយាម​ប្រើ​វិញ្ញាបនបត្រ​សម្រាប់​"
"កាចុះហត្ថលេខា​ដែល​ផុតកំណត់​នៅក្នុងចំនួន​ថ្ងៃ​ដែល​បាន​បញ្ជាក់ ។\n"
"<p>\n"
"វា​ត្រូវបាន​ផ្ដល់អនុសាសន៍​ឲ្យ​ទុក​ជម្រើស​នេះ​នៅបើក​ដើម្បី​ជៀសវាង​ការប្រើ​វិញ្ញាប"
"នបត្រ​ដែលផុតកំណត់​ក្នុង​ពេល​ខាងមុខ ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 618
#: rc.cpp:766 rc.cpp:998
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Signature Certificate Expires</h1>\n"
"Select the minimum number of days the signature certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ព្រមាន​ប្រសិនបើ​វិញ្ញាបនបត្រ​ហត្ថលេខា​ផុតកំណត់</h1>\n"
"ជ្រើស​ចំនួន​ថ្ងៃ​អប្បរមា​ "
"ដែល​វិញ្ញាបនបត្រ​ហត្ថលេខា​គួរ​តែ​ត្រឹមត្រូវ​ដោយក្រៅពីការប្រកាស់ការព្រមាន ។\n"
"<p>\n"
"ការកំណត់​ SPHINX ដែលបានផ្ដល់អនុសាសន៍​គឺ 14 ថ្ងៃ ។\n"
"</qt>"

#. i18n: file signatureconfigurationdialog.ui line 626
#: rc.cpp:774
#, no-c-format
msgid "Warn if s&ignature certificate expires in less than:"
msgstr "ព្រមាន ប្រសិនបើ​វិញ្ញាបនបត្រ​ហត្ថលេខា​ផុតកំណត់​ក្នុង​ពេល​តិចជាង ៖"

#. i18n: file signatureconfigurationdialog.ui line 648
#: rc.cpp:788
#, no-c-format
msgid "Warn if root certificate expires in &less than:"
