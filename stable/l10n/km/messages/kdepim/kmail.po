"</qt>"
msgstr ""
"<qt>\n"
"<h1>ពិនិត្យ​មើល​ផ្លូវ​វិញ្ញា​បនបត្រ</h1>\n"
"ប្រសិនបើបាន​បើក​ជម្រើស​នេះ "
"ផ្លូវទាំងមូល​នៃ​វិញ្ញាបនបត្រ​របស់​អ្នកប្រើ​ឡើង​ទៅ​កាន់​ root "
"នឹង​ត្រូវបាន​ពិនិត្យ ។\n"
"<p>\n"
"ចំណាំថា​វា​មិនអាច​បិទ​ការពិនិត្យ​វិញ្ញាបនបត្រ​របស់​អ្នកទទួល​ដោយខ្លួនវា​បានទេ ។\n"
"</qt>"

#. i18n: file encryptionconfigurationdialog.ui line 308
#: rc.cpp:312
#, no-c-format
msgid "&Use certificate revocation lists (CRLs)"
msgstr "ប្រើ​បញ្ជី​ដកហូត​វិញ្ញាបនបត្រ​វិញ (CRLs)"

#. i18n: file encryptionconfigurationdialog.ui line 314
#: rc.cpp:315
#, no-c-format
msgid "Check to use CRLs"
msgstr "ពិនិត្យ​ដើម្បី​ប្រើ CRLs"

#. i18n: file encryptionconfigurationdialog.ui line 322
#: rc.cpp:318
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Use Certificate Revocation Lists (CRLs)</h1>\n"
"A certificate revocation list contains certificates that have been withdrawn "
"and should not be used for encryption purposes any longer. A user may wish to "
"have his or her certificate revoked because he or she suspects that the "
"certificate's integrity has been compromised (e.g. somebody has guessed the "
"PIN).\n"
"<p>\n"
"It is recommended to use CRLs for maximum security. In the configuration dialog "
"for certificate and CRL management, you can select where to retrieve the CRLs "
"from.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ប្រើ​បញ្ជី​ដកហូត​វិញ្ញាបនបត្រ​វិញ (CRLs)</h1>\n"
"បញ្ជី​ដកហូត​វិញ្ញាបនបត្រ​វិញ មាន​វិញ្ញាបនបត្រ​ដែល​ត្រូវបានដកចេញ និង "
"មិនគួរ​ត្រូវបានប្រើ​សម្រាប់​គោលបំណង​ក្នុង​ការ​អ៊ិនគ្រីបទៀតទេ ។ "
"អ្នកប្រើ​ម្នាក់​អាច​​ចង់ឲ្យ​បាន​ដកហូត​វិញ្ញាបនបត្រ​របស់​គាត់​ ឬ នាង​វិញ "
"ព្រោះ​គាត់ ឬ "
"នាង​សង្ស័យ​ថា​ភាពត្រឹមត្រូវ​របស់​វិញ្ញាបនបត្រ​ត្រូវបាន​សម្រុះ​សម្រួល (ឧទាហរណ៏ "
"អ្នកមួយចំនួន​បានទាយ PIN) ។\n"
"<p>\n"
"វា​ត្រូវបាន​ផ្ដល់អនុសាសន៍​ឲ្យប្រើ CRLs ចំពោះ​សុវត្ថិភាព​ដែល​ខ្ពស់​បំផុត ។ "
"ក្នុង​ប្រអប់​អបអរសារទ​ចំពោះ​ការគ្រប់គ្រង​វិញ្ញាបនបត្រ និង CRL "
"អ្នកអាច​ជ្រើស​កន្លែង​ណា​ដែល​​ត្រូវ​ទៅ​ប្រមូល​យក CRLs ពី ។\n"
"</qt>"

#. i18n: file encryptionconfigurationdialog.ui line 330
#: rc.cpp:326
#, no-c-format
msgid "Warn if CRL e&xpires in less than:"
msgstr "ព្រមាន​ ប្រសិនបើ CRL ផុតកំណត់​ក្នុង​រយៈពេល​តិចជាង ៖"

#. i18n: file encryptionconfigurationdialog.ui line 336
#: rc.cpp:329
#, no-c-format
msgid "Check to be warned if a CRL expires in the near future"
msgstr "ធីក​ ដើម្បី​ទទួល​យក​ការព្រមាន ប្រសិនបើ​ CRL ផុតកំណត់​ក្នុងពេល​ខាងមុខ"

#. i18n: file encryptionconfigurationdialog.ui line 342
#: rc.cpp:332
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If CRL Expires In The Near Future</h1>\n"
"If this box is checked, you will be warned if one of the CRLs you are using is "
"about to expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ព្រមាន​ ប្រសិនបើ​ CRL ផុតកំណត់​ក្នុង​ពេលខាងមុខ</h1>\n"
"ប្រសិនបើ​បានធីក​ប្រអប់នេះ អ្នកនឹង​ត្រូវបាន​ព្រមាន​ ប្រសិនបើ​ CRLs មួយ​ "
"ដែល​អ្នកកំពុង​តែប្រើគឺ​ប្រហែល​ជាផុតកំណត់​ក្នុង​ពេល​ខាងមុខ ។\n"
"</qt>"

