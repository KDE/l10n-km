msgstr "អ៊ិនគ្រីប​ទៅ​កាន់ខ្លួន​ឯងជានិច្ច"

#. i18n: file encryptionconfigurationdialog.ui line 417
#: rc.cpp:355
#, no-c-format
msgid "Check to have encrypted messages also encrypted using your own key."
msgstr ""
"ធីក​ ដើម្បី​បានអ៊ិនគ្រីប​សារ "
"ក៏ដូចជា​បានអ៊ិនគ្រីប​ការប្រើ​សោផ្ទាល់ខ្លួន​របស់អ្នក ។"

#. i18n: file encryptionconfigurationdialog.ui line 425
#: rc.cpp:358
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Always encrypt to self</h1>\n"
"If this box is checked, encrypted messages sent by you will also be encrypted "
"using your own key.\n"
"<p>\n"
"It is recommended to leave this option turned on to enable you to read the "
"messages you have sent.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>អ៊ិនគ្រីប​ទៅកាន់​ខ្លួន​ឯង​ជានិច្ច</h1>\n"
