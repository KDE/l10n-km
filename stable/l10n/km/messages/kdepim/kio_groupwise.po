#: groupwise.cpp:116
msgid ""
"Unknown path. Known paths are '/freebusy/', '/calendar/' and '/addressbook/'."
msgstr ""
"ផ្លូវ​ដែល​មិន​ស្គាល់ ។ ផ្លូវ​ដែល​ស្គាល់​ជា '/ទំនេរ/រវល់/', '/ប្រតិទិន/' និង "
"'/សៀវភៅ​អាសយដ្ឋាន/' ។"

#: groupwise.cpp:161
msgid "Illegal filename. File has to have '.ifb' suffix."
msgstr "ឈ្មោះ​ឯកសារ​មិន​ត្រឹមត្រូវ ។ ឯកសារ​ត្រូវ​តែ​មានបច្ច័យ '.irfb' ។"

#: groupwise.cpp:179
msgid "Need username and password to read Free/Busy information."
msgstr ""
"ត្រូវការ​ឈ្មោះ​អ្នកប្រើ និង ពាក្យ​សម្ងាត់​ដើម្បី​អាន​ព័ត៌មាន ទំនេរ/រវល់ ។"

#: groupwise.cpp:193 groupwise.cpp:239 groupwise.cpp:300 groupwise.cpp:366
msgid "Unable to login: "
msgstr "មិន​អាច​ចូល ៖"

#: groupwise.cpp:197
msgid "Unable to read free/busy data: "
msgstr "មិន​អាច​អានទិន្នន័យ​ទំនេរ/រវល់ ៖"

#: groupwise.cpp:243
msgid "Unable to read calendar data: "
msgstr "មិន​អាច​អាន​ទិន្នន័យ​របស់​ប្រតិទិន ៖"

#: groupwise.cpp:271 groupwise.cpp:339
msgid "No addressbook IDs given."
msgstr "មិន​បាន​ផ្តល់​លេខ​សម្គាល់​សៀវភៅ​អាសយដ្ឋាន ។"

#: groupwise.cpp:304
msgid "Unable to read addressbook data: "
msgstr "មិន​អាច​អាន​ទិន្នន័យ​សៀវភៅ​អាសយដ្ឋាន ៖"

#: groupwise.cpp:370
msgid "Unable to update addressbook data: "
msgstr "មិន​អាច​ធ្វើ​ឲ្យ​ទិន្នន័យ​សៀវភៅ​អាសយដ្ឋាន​ទាន់​សម័យ ៖"

#: groupwise.cpp:407
#, c-format
msgid ""
"An error occurred while communicating with the GroupWise server:\n"
"%1"
msgstr ""
"កំហុស​មួយ​បាន​កើតឡើង ខណៈពេល​ទំនាក់ទំនង​ជាមួយ​នឹង​ម៉ាស៊ីន​បម្រើ GroupWise ៖\n"
"%1"
