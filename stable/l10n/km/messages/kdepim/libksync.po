#: conflictdialog.cpp:36
msgid "Resolve Conflict"
msgstr "ដោះស្រាយ​ការ​ប៉ះទង្គិច​"

#: conflictdialog.cpp:48
msgid "Keep Both"
msgstr "រក្សា​ទាំង​ពីរ"

#: conflictdialog.cpp:55
msgid "Both entries have changed fields"
msgstr "ធាតុ​ទាំង​ពីរ​បាន​ផ្លាស់ប្ដូរ​វាល"

#: conflictdialog.cpp:55
msgid "Unknown"
msgstr "មិនស្គាល់"

#: conflictdialog.cpp:84
msgid "Which entry do you want to take precedence?"
msgstr "តើ​ធាតុ​មួយ​ណា​ដែល​អ្នក​ចង់​កំណត់​អាទិភាព ?"

#: syncuikde.cpp:62
msgid "\"%1\" was deleted on %2. Do you want to delete it?"
msgstr "\"%1\" ត្រូវ​បាន​លុប​នៅ​លើ %2 ។ តើ​អ្នក​ចង់​លុប​វា​ទេ ?"

#: syncuikde.cpp:64
msgid "Delete?"
msgstr "លុប​ ?"

#: syncuikde.cpp:76
msgid "\"%1\" was deleted on %2 and changed on %3"
msgstr "\"%1\" ត្រូវ​បាន​លុប​នៅ​លើ %2 ហើយ​បាន​ផ្លាស់ប្ដូរ​នៅលើ %3"

#: syncuikde.cpp:77
msgid "Delete or Modify?"
msgstr "លុប ឬ​កែប្រែ ?"

#: syncuikde.cpp:90
msgid "\"%1\" was changed on both sources. Which one do you want to take?"
msgstr ""
"\"%1\" ត្រូវ​បាន​ផ្លាស់ប្ដូឬ​នៅ​ប្រភព​ទាំង​ពីរ ។ តើ​អ្នក​ចង់​យក​មួយ​ណា ?"

#: syncuikde.cpp:92
msgid "Modified Two Entries"
msgstr "បាន​កែប្រែ​ធាតុ​ទាំង​ពីរ"

#: syncuikde.cpp:107
msgid "The entry with the id %1 was deleted on %2 and %3"
msgstr "ធាតុ​ដែល​មាន​លេខសម្គាល់ %1 ត្រូវ​បា​ន​លុប​នៅ​លើ %2 និង %3"
