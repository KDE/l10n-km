#: text_calendar.cpp:228
#, c-format
msgid "Answer: %1"
msgstr "ចំលើយ ៖ %1"

#: text_calendar.cpp:230
msgid "Answer: Incidence with no summary"
msgstr "ចំលើយ ៖ ឧប្បត្ដិហេតុ​ដោយ​គ្មាន​សេចក្ដី​សង្ខេប"

#: text_calendar.cpp:241
msgid "Could not save file to KOrganizer"
msgstr "មិន​អាច​រក្សា​ទុក​ឯកសារ​ចូល KOrganizer"

#: text_calendar.cpp:354
msgid "Accept incidence"
msgstr "យល់ព្រម​នូវ​ឧប្បត្ដិហេតុ"

#: text_calendar.cpp:356
msgid "Accept incidence conditionally"
msgstr "យល់ព្រម​នូវ​លក្ខខណ្ឌ​ឧប្បត្ដិហេត្ដុ"

#: text_calendar.cpp:358
msgid "Throw mail away"
msgstr "បោះចោល​សំបុត្រ"

#: text_calendar.cpp:360
msgid "Decline incidence"
msgstr "បដិសេធ​នូវ​ឧប្បត្ដិហេតុ"

#: text_calendar.cpp:362
msgid "Check my calendar..."
msgstr "ពិនិត្យ​ប្រតិទិន​របស់​ខ្ញុំបស់​ខ្ញុំ..."

#: text_calendar.cpp:364
msgid "Enter incidence into my calendar"
msgstr "បញ្ចូល​នូវ​ឧប្បត្ដិហេតុ ចូល​ក្នុង​ប្រតិទិន​របស់​ខ្ញុំ"

#: text_calendar.cpp:366
msgid "Remove incidence from my calendar"
msgstr "យក​ចេញ​នូវ​ឧប្បត្ដិហេតុ ពី​ប្រតិទិន​របស់​ខ្ញុំ"
