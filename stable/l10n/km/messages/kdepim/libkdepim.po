#: ../libemailfunctions/email.cpp:450
msgid ""
"The email address you entered is not valid because it contains more than one @. "
"You will not create valid messages if you do not change your address."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ "
"ព្រោះ​វា​មាន​ច្រើន​ជាង​១​@ ។ ប្រសិនបើ​អ្នក​មិន​ប្តូរ​អាស័យដ្ឋាន​ទេ "
"អ្នក​នឹង​មិន​អាច​បង្កើត​សារ​ត្រឹមត្រូវ​បានទេ ។"

#: ../libemailfunctions/email.cpp:455
msgid ""
"The email address you entered is not valid because it does not contain a @.You "
"will not create valid messages if you do not change your address."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​វា​មាន @ ។​ "
"ប្រសិនបើ​អ្នក​មិន​ប្តូរ​អាស័យដ្ឋាន​ទេ "
"អ្នក​នឹង​មិន​អាច​បង្កើត​សារ​ត្រឹមត្រូវ​បានទេ ។"

#: ../libemailfunctions/email.cpp:460
msgid "You have to enter something in the email address field."
msgstr " អ្នក​បាន​បញ្ចូល​អ្វី​មួយចំនួន​ទៅក្នុង​វាល​អាស័យដ្ឋាន​អីុមែ៉ល​ ។"

#: ../libemailfunctions/email.cpp:462
msgid ""
"The email address you entered is not valid because it does not contain a local "
"part."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​វា​មាន "
"មូលដ្ឋាន​ផ្លូវ ។​"

#: ../libemailfunctions/email.cpp:465
msgid ""
"The email address you entered is not valid because it does not contain a domain "
"part."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​វា​មាន ផ្លូវ​ដែន ។​"

#: ../libemailfunctions/email.cpp:468
msgid ""
"The email address you entered is not valid because it contains unclosed "
"comments/brackets."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ "
"ព្រោះ​វា​មិនបានបិទ​ពាក្យ​អត្ថាធិប្បាយ / តង្កៀប ([ ])"

#: ../libemailfunctions/email.cpp:471
msgid "The email address you entered is valid."
msgstr "អាស័យដ្ឋាន​អីុមែ៉ល​ដែលអ្នក​បាន​បញ្ចូល​គឺ ត្រឹមត្រូវ ។"

#: ../libemailfunctions/email.cpp:473
msgid ""
"The email address you entered is not valid because it contains an unclosed "
"anglebracket."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​វា​មិនបានបិទ "
"តង្កៀប​មុំ​ ។"

#: ../libemailfunctions/email.cpp:476
msgid ""
"The email address you entered is not valid because it contains an unopened "
"anglebracket."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​វា​មិនទាន់​បាន​បើក "
"តង្កៀប ។​"

#: ../libemailfunctions/email.cpp:479
msgid ""
"The email address you have entered is not valid because it contains an "
"unexpected comma."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​វា​មិនមានក្បៀស ។"

#: ../libemailfunctions/email.cpp:482
msgid ""
"The email address you entered is not valid because it ended unexpectedly, this "
"probably means you have used an escaping type character like an \\  as the last "
"character in your email address."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ ព្រោះ​ "
"វា​បាន​បញ្ចប់​មិន​គួរឲ្យជឿ  "
"នេះទំនងជា​មានន័យថា​អ្នក​​បាន​ប្រើប្រភេទ​តួអក្សរ​ដែលគួ​ជៀសវាង​ដូចជា  \\   "
"នៅ​ចុង​អាស័ដ្ឋាន​អីុមែ៉ល ។"

#: ../libemailfunctions/email.cpp:487
msgid ""
"The email address you entered is not valid because it contains quoted text "
"which does not end."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ "
"ព្រោះ​វា​មាន​អត្ថបទ​ដែល​បាន​ស្រង់​ដែល​មិន​ត្រូវ​បាន​បញ្ចប់ ។​"

#: ../libemailfunctions/email.cpp:490 ../libemailfunctions/email.cpp:551
msgid ""
"The email address you entered is not valid because it does not seem to contain "
"an actual email address, i.e. something of the form joe@kde.org."
msgstr ""
"អាស័យដ្ឋាន​អីុមែ៉ល​ដែល​អ្នក​បាន​បញ្ចូលមិនត្រឹមត្រូវ "
"ព្រោះ​វាមើល​ទៅ​ហាក់​បី​ដូចជា​មាន​អាស័យដ្ឋាន​ពិតប្រាកដ​ ។​ឧទាហរណ៍ "
"ជួនកាល​វាមានទំរង់​ដូច joe@kde.org ។"

