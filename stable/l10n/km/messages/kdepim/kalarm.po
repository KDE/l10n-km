msgstr "មិន​អាច​ទុកអ៊ីមែល​នេះ​ក្នុង KMail"

#: prefdlg.cpp:94
msgid "Preferences"
msgstr "ចំណង់​ចំណូល​ចិត្ត"

#: prefdlg.cpp:98
msgid "General"
msgstr "ទូទៅ"

#: prefdlg.cpp:101
msgid "Email"
msgstr "អ៊ីមែល"

#: prefdlg.cpp:101
msgid "Email Alarm Settings"
msgstr "ការកំណត់​ការជូនដំណឹង​អ៊ីមែល"

#: prefdlg.cpp:104
msgid "View Settings"
msgstr "ការ​កំណត់​ទិដ្ឋភាព"

#: prefdlg.cpp:107
msgid "Font & Color"
msgstr "ពុម្ព​អក្សរ និង ​ពណ៌"

#: prefdlg.cpp:107
