#: main.cpp:56
msgid "List all possible modules"
msgstr "រាយ​ម៉ូឌុល​ដែល​អាច​មានទាំងអស់"

#: main.cpp:57
msgid "Configuration module to open"
msgstr "ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ​ដែល​ត្រូវ​បើក"

#: main.cpp:58
msgid "Specify a particular language"
msgstr "បញ្ជាក់​ភាសា​ពិសេស"

#: main.cpp:59
msgid "Embeds the module with buttons in window with id <id>"
msgstr "បង្កប់​ម៉ូឌុល​នេះ​ទៅ​នឹង​ប៊ូតុង ក្នុង​បង្អួច​ដែល​មាន​លេខ​សម្គាល់ <id>"

#: main.cpp:60
msgid "Embeds the module without buttons in window with id <id>"
msgstr ""
"បង្កប់​ម៉ូឌុល​នេះដោយ​គ្មាន​​ប៊ូតុង ក្នុង​បង្អួច​ដែល​មាន​លេខ​សម្គាល់ <id>"

#: main.cpp:61
msgid "Do not display main window"
msgstr "កុំ​បង្ហាញ​បង្អួច​មេ"

#: main.cpp:197
msgid "KDE Control Module"
msgstr "មជ្ឈមណ្ឌល​បញ្ជា​​របស់ KDE"

#: main.cpp:199
msgid "A tool to start single KDE control modules"
msgstr "ឧបករណ៍​ដែល​ត្រូវ​ចាប់ផ្តើម​ម៉ូឌុល​ត្រួតពិនិត្យ​​តែ​មួយរបស់ KDE "

#: main.cpp:201
msgid "(c) 1999-2004, The KDE Developers"
msgstr "(c) ១៩៩៩-២០០៤ អ្នក​អភិវឌ្ឍន៍ KDE"

#: main.cpp:203
msgid "Maintainer"
msgstr "អ្នក​ថែ​ទាំ"

#: main.cpp:224
msgid "The following modules are available:"
msgstr "ម៉ូឌុល​ខាងក្រោម​គឺ​អាច​រក​បាន ៖"

#: main.cpp:243
msgid "No description available"
msgstr "មិន​មាន​ការ​ពិពណ៌នា"

#: main.cpp:310
#, c-format
msgid "Configure - %1"
msgstr "កំណត់​រចនា​សម្ព័ន្ធ - %1"
