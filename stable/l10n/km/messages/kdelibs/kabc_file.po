#: resourcefile.cpp:218 resourcefile.cpp:254 resourcefile.cpp:477
msgid "Unable to open file '%1'."
msgstr "មិន​អាច​បើក​ឯកសារ '%1' ។"

#: resourcefile.cpp:223 resourcefile.cpp:474
msgid "Problems during parsing file '%1'."
msgstr "មាន​បញ្ហា កំឡុងពេល​ញែក​ឯកសារ '%1' ។"

#: resourcefile.cpp:327 resourcefile.cpp:355
msgid "Unable to save file '%1'."
msgstr "មិន​អាច​រក្សា​ទុក​ឯកសារ '%1' ។"

#: resourcefile.cpp:465
msgid "Download failed in some way!"
msgstr "ការ​ទាញ​យក​ឯកសារ​បាន​បរាជ័យ​ក្នុង​ករណីខ្លះ !"

#: resourcefileconfig.cpp:45
msgid "Format:"
msgstr "ទ្រង់ទ្រាយ ៖"

#: resourcefileconfig.cpp:51
msgid "Location:"
msgstr "ទីតាំង ៖"
