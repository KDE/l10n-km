#. i18n: ectx: property (text), widget (QRadioButton, localAndCached)
#: configdialog.ui:30
msgid "Local and cached content"
msgstr "មាតិតា​ឃ្លាំង​សម្ងាត់ និង​មូលដ្ឋាន"

#. i18n: ectx: property (text), widget (QRadioButton, everything)
#: configdialog.ui:40
msgid "Everything"
