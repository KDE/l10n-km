#, kde-format
msgctxt "@info:status"
msgid "Folder %1 does not seem to be a valid email folder"
msgstr "ថត %1 ហាក់បី​ដូច​ជា​មិនមែន​ជា​ថត​អ៊ីមែល​ត្រឹមត្រូវ​ទេ"

#: mixedmaildirstore.cpp:957
#, kde-format
msgctxt "@info:status"
