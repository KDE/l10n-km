#: configdialog.cpp:35
msgid "Select a KMail Mail folder"
msgstr "ជ្រើស​ថត​សំបុត្រ KMail"

#: configdialog.cpp:51
msgid "The selected path is empty."
msgstr "ផ្លូវ​ដែល​បាន​ជ្រើស​ទទេ ។"

#: configdialog.cpp:65
msgid "The selected path contains valid Maildir folders."
msgstr "ផ្លូវ​ដែលបានជ្រើស​មាន​ថត Maildir ត្រឹមត្រូវ ។"

#: configdialog.cpp:72
msgid "The selected path is a valid Maildir."
msgstr "ផ្លូវ​ដែល​បាន​ជ្រើស​គឺ​ជា Maildir ត្រឹមត្រូវ ។"

#: configdialog.cpp:78
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr "ផ្លូវ​ដែលបាន​ជ្រើស​មិនទាន់មាន​នៅឡើយ​ទេ Maildir ថ្មី​នឹង​ត្រូវ​បាន​បង្កើត ។"

#: configdialog.cpp:81
msgid "The selected path does not exist."
msgstr "ផ្លូវ​ដែល​បាន​ជ្រើស​មិន​ទាន់​មាន​ទេ ។"

#: mixedmaildirresource.cpp:152 mixedmaildirresource.cpp:167
#: mixedmaildirresource.cpp:198 mixedmaildirresource.cpp:218
