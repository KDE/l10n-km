#: mixedmaildirresource.cpp:379
msgctxt "@info:status"
msgid "Unusable configuration."
msgstr "កា​រកំណត់​រចនាសម្ព័ន្ធ​ដែល​មិនអាច​ប្រើ​បាន ។"

#: mixedmaildirresource.cpp:242
msgctxt "@info:status"
msgid "Synchronizing email folders"
msgstr "ធ្វើ​សមកាលកម្ម​ថត​អ៊ីមែល"

#: mixedmaildirresource.cpp:257
#, kde-format
msgctxt "@info:status"
msgid "Synchronizing email folder %1"
msgstr "ធ្វើ​សមកាលកម្ម​អ៊ីមែល %1"

#: mixedmaildirresource.cpp:358
#, kde-format
msgctxt "@info:status"
msgid "Cannot move root maildir folder '%1'."
msgstr "មិនអាច​ផ្លាស់ទី​ថត root maildir '%1' បាន​ទេ ។"

#: mixedmaildirresource.cpp:386
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "មិន​អាច​លុប​ថត maildir កម្រិត​កំពូល​ '%1' បាន​ទេ ។"

#: mixedmaildirresource.cpp:400
#, kde-format
msgctxt "@info:status"
msgid "Unable to create maildir '%1'."
msgstr "មិន​អាច​បង្កើត maildir '%1' បាន​ទេ ។"

#: mixedmaildirresource.cpp:412
msgctxt "@info:status"
msgid "No usable storage location configured."
msgstr "គ្មាន​ទីតាំង​ផ្ទុក​ដែលអាច​ប្រើ​បាន​ត្រូវ​បាន​កំណត់​រចនាសម្ព័ន្ធ​ទេ ។"

#. i18n: ectx: label, entry (Path), group (General)
#: mixedmaildirresource.kcfg:10
msgid "Path to KMail mail folder"
msgstr "ផ្លូវ​ទៅកាន់​ថត​សំបុត្រ KMail"

#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: mixedmaildirresource.kcfg:14
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr "ចំណុច​ផ្លូវ​ទៅកាន់​ថត​ដែល​មាន​ Maildirs ជំនួស​ឲ្យទៅ​កាន់ maildir ខ្លួន​វា ។"

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: mixedmaildirresource.kcfg:18
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាង​ក្រោយ​ពិតប្រាកដ ។"

#: mixedmaildirstore.cpp:530
msgctxt "@info:status"
msgid "Given folder name is empty"
msgstr "ឈ្មោះ​ថត​ដែល​បាន​ផ្ដល់​គឺ​ទទេ"

