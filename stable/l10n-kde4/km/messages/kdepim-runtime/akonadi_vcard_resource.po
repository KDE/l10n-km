#. i18n: file: vcardresource.kcfg:10
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:3
msgid "Path to vCard file."
msgstr "ផ្លូវ​ទៅកាន់​ឯកសារ vCard ។"

#. i18n: file: vcardresource.kcfg:14
#. i18n: ectx: label, entry (DisplayName), group (General)
#: rc.cpp:6
msgid "Display name."
msgstr "ឈ្មោះ​បង្ហាញ ។"

#. i18n: file: vcardresource.kcfg:18
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:9
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាងក្រោយ​ពិត ។"

#. i18n: file: vcardresource.kcfg:22
#. i18n: ectx: label, entry (MonitorFile), group (General)
#: rc.cpp:12
msgid "Monitor file for changes."
msgstr "គ្រប់គ្រង​ឯកសារ​សម្រាប់​ការ​ផ្លាស់ប្ដូរ ។"

#: vcardresource.cpp:57
#, kde-format
msgid "Contact with uid '%1' not found."
msgstr "រក​មិនឃើញ​ទំនាក់ទំនង​ជា​មួយ uid '%1' នោះ​ទេ ។"

#: vcardresource.cpp:75
msgctxt "Filedialog filter for *.vcf"
msgid "vCard Address Book File"
msgstr "ឯកសារ​សៀវភៅ​អាសយដ្ឋាន vCard"

#: vcardresource.cpp:76
msgid "Select Address Book"
msgstr "ជ្រើស​សៀវភៅ​អាសយដ្ឋាន"

#: vcardresource.cpp:155 vcardresource.cpp:175
#, kde-format
msgid "Unable to open vCard file '%1'."
msgstr "មិនអាច​បើក​​ឯកសារ vCard '%1' បានទេ ។"
