#: plugins/channel/csv/kdetv_csvchannels.desktop:9
msgctxt "Name"
msgid "CSV Channel File Plugin"
msgstr "កម្មវិធី​ជំនួយ​ឯកសារ​ឆានែល CSV"

#: plugins/channel/csv/kdetv_csvchannels.desktop:41
msgctxt "Comment"
msgid ""
"This stores your channel files in CSV (comma separated variables) format."
msgstr "វា​ស្ដារ​ឯកសារ​ឆានែល​របស់​អ្នក​ឡើង​វិញ​នៅ​ក្នុងទ្រង់ទ្រាយ CSV (អថេរ​បានបំបែក​ដោយ​សញ្ញាក្បៀស) ។"

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:9
msgctxt "Name"
msgid "KWinTV Legacy Channel File Plugin"
msgstr "កម្មវិធី​ជំនួយ​ឯកសារ​ឆានែល​ចាស់ៗ​របស់ KWinTV"

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:35
msgctxt "Comment"
msgid ""
"This allows you to use your legacy KWinTV format channel files in Kdetv."
msgstr "វា​អនុញ្ញាត​ឲ្យ​អ្នក​ប្រើ​ឯកសារ​​ឆានែល​ទ្រង់ទ្រាយ​ KWinTV ចាស់ៗ​របស់​អ្នក​នៅ​ក្នុង Kdetv ។"

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:9
msgctxt "Name"
msgid "xawtv Channel File Plugin"
msgstr "កម្មវិធី​ជំនួយ​ឯកសារ​ឆានែល xawtv"

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:38
msgctxt "Comment"
msgid "This loads your xawtv format channel files in kdetv."
msgstr "វា​ផ្ទុក​ឯកសារ​ឆានែល​ទ្រង់ទ្រាយ xawtv របស់​អ្នក​នៅ​ក្នុង kdetv ។"

#: plugins/channel/xml/kdetv_xmlchannels.desktop:9
msgctxt "Name"
msgid "XML Channel File Plugin"
msgstr "កម្មវិធី​ជំនួយ​ឯកសារ​ឆានែល XML"

#: plugins/channel/xml/kdetv_xmlchannels.desktop:39
msgctxt "Comment"
msgid ""
"This stores your channel files in XML format.  This is the standard file "
"format for kdetv."
msgstr ""
"វា​ស្ដារ​ឯកសារ​ឆានែល​របស់​អ្នក​នៅ​ក្នុង​ទ្រង់ទ្រាយ XML ។ វា​គឺ​ជា​ទ្រង់ទ្រាយ​​ឯកសារ​​ស្តង់ដារសម្រាប់ kdetv ។"

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:9
msgctxt "Name"
msgid "Zapping Channel File Plugin"
msgstr "កម្មវិធី​ជំនួយ​ឯកសារ​ឆានែល Zapping"

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:34
msgctxt "Comment"
msgid ""
"This loads/stores your channel files in XML format zapping (zapping.sf.net) "
"uses."
msgstr "វា​ផ្ទុក/ស្ដារ​ឯកសារ​ឆានែល​របស់​អ្នក​នៅ​ក្នុង​ទ្រង់ទ្រាយ XML (zapping.sf.net) ។"

