#: amor/amor.desktop:2
msgctxt "Name"
msgid "AMOR"
msgstr "AMOR"

#: amor/amor.desktop:71
msgctxt "GenericName"
msgid "On-Screen Creature"
msgstr "ការច្នៃ​ប្រឌិត​លើ​អេក្រង់"

#: amor/data/billyrc:5
msgctxt "Description"
msgid "Little Billy"
msgstr "កូនប៊ីលីតូច"

#: amor/data/billyrc:70
msgctxt "About"
msgid "Static window sitter\\nGraphic from http://www.xbill.org/"
msgstr "អ្នក​ថែទាំ​បង្អួចថិតិវន្ត\\nរចនា​ក្រាហ្វិក​ពី http://www.xbill.org/"

#: amor/data/blobrc:4
msgctxt "Description"
