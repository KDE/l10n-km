#: src/ktp_approver.desktop:2
msgctxt "Name"
msgid "Instant Messaging Approver"
msgstr "កម្មវិធី​អនុម័ត​ការ​ផ្ញើ​សារ​បន្ទាន់"

#: src/ktp_approver.desktop:45
msgctxt "Comment"
msgid ""
"Shows notifications for incoming IM/Call requests and allows you to open a "
"handler to answer"
msgstr ""
"បង្ហាញ​ការ​ជូន​ដំណឹង​សម្រាប់​ការ​អនុញ្ញាត និង​ការ​ស្នើ IM/Call មកដល់​ដែល​នឹង​បើក​កម្មវិធី​ដោះស្រាយ​ចម្លើយ"

