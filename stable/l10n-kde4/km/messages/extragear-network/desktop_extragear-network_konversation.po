#: data/konversation.notifyrc:58
msgctxt "Name"
msgid "New message"
msgstr "សារ​ថ្មី"

#: data/konversation.notifyrc:109
msgctxt "Comment"
msgid "New message arrived in a channel"
msgstr "សារ​ថ្មី​មកដល់​ក្នុង​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:160
msgctxt "Name"
msgid "Nick written"
msgstr "សមត្ថិនាម​ដែល​បាន​សរសេរ"

#: data/konversation.notifyrc:208
msgctxt "Comment"
msgid "Someone wrote your nick in a message"
msgstr "មាន​នរណា​ម្នាក់​សរសេរ​សមត្ថិនាម​របស់​អ្នក​នៅ​ក្នុង​សារ"

#: data/konversation.notifyrc:258
msgctxt "Name"
msgid "Highlight triggered"
msgstr "បានកេះ​អ្វី​ដែលបាន​បន្លិច"

#: data/konversation.notifyrc:301
msgctxt "Comment"
msgid "Someone triggered a highlight"
msgstr "មាន​អ្នកណាម្នាក់​បានកេះ​ការ​បន្លិច"

#: data/konversation.notifyrc:347
msgctxt "Name"
msgid "Private message"
msgstr "សារ​ឯកជន"

#: data/konversation.notifyrc:395
msgctxt "Comment"
msgid "You received a private message"
msgstr "អ្នក​បាន​ទទួល​សារ​ឯកជន​មួយ"

#: data/konversation.notifyrc:446
msgctxt "Name"
msgid "Nick changed"
msgstr "បាន​ផ្លាស់ប្ដូរ​សមត្ថិនាម"

#: data/konversation.notifyrc:494
msgctxt "Comment"
msgid "Someone changed their nick"
msgstr "មាន​នរណា​ម្នាក់​បាន​ប្ដូរ​សមត្ថិនាម​របស់​អ្នក"

#: data/konversation.notifyrc:544
msgctxt "Name"
msgid "Incoming file"
msgstr "ឯកសារ​មកដល់"

#: data/konversation.notifyrc:594
msgctxt "Comment"
msgid "Someone wants to transmit a file to you over DCC"
msgstr "មាន​នរណា​ម្នាក់​ចង់​បញ្ជូន​ឯកសារ​ឲ្យ​អ្នក​តាម DCC"

#: data/konversation.notifyrc:644
msgctxt "Name"
msgid "DCC transfer error"
msgstr "កំហុស​ក្នុង​ផ្ទេរ DCC"

#: data/konversation.notifyrc:689
msgctxt "Comment"
msgid "An error occurred in a DCC transfer"
msgstr "កំហុស​បានកើត​ឡើង​នៅ​ក្នុងការ​ផ្ទេរ DCC"

#: data/konversation.notifyrc:736
msgctxt "Name"
msgid "DCC transfer complete"
msgstr "បញ្ចប់​ការ​ផ្ទេរ DCC"

#: data/konversation.notifyrc:781
msgctxt "Comment"
msgid "A DCC transfer successfully completed"
msgstr "ការ​ផ្ទេរ DCC បានបញ្ចប់ដោយ​ជោគជ័យ"

#: data/konversation.notifyrc:828
msgctxt "Name"
msgid "Nick joined channel"
msgstr "សមត្ថិនាម​ដែលបាន​ចូល​រួម​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:875
msgctxt "Comment"
msgid "New nick joined a channel"
msgstr "សមត្ថិនាម​ថ្មី​ដែល​បាន​ចូលរួម​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:925
msgctxt "Name"
msgid "Nick left channel"
msgstr "សមត្ថិនាម​បាន​ចេញ​ពី​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:972
msgctxt "Comment"
msgid "A nick left a channel"
msgstr "សមត្ថិនាម​ដែល​បាន​ចេញ​ពី​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:1022
msgctxt "Name"
msgid "Mode change"
msgstr "ផ្លាស់ប្ដូរ​របៀប"

#: data/konversation.notifyrc:1069
msgctxt "Comment"
msgid "A user or channel mode was changed"
msgstr "អ្នកប្រើ ឬ​របៀប​ប៉ុស្ដិ៍​ត្រូវ​បាន​ផ្លាស់ប្ដូរ"

#: data/konversation.notifyrc:1119
#, fuzzy
#| msgctxt "Name"
#| msgid "Nick written"
msgctxt "Name"
msgid "Nick online"
msgstr "សមត្ថិនាម​ដែល​បាន​សរសេរ"

#: data/konversation.notifyrc:1169
msgctxt "Comment"
msgid "A user on your watched nicks list has come online"
msgstr "អ្នកប្រើ​នៅ​លើ​បញ្ជី​សមត្ថិនាម​ដែល​បាន​ឃ្លាំមើល​របស់​អ្នក​ បាន​នៅលើ​បណ្ដាញ"

#: data/konversation.notifyrc:1219
msgctxt "Name"
msgid "Query"
msgstr "សំណួរ​"

#: data/konversation.notifyrc:1270
msgctxt "Comment"
msgid "Someone started a conversation (query) with you"
msgstr "មាន​នរណា​ម្នាក់​បាន​ចាប់ផ្ដើម​ការ​សន្ទនា (សំណួរ) ជាមួយ​អ្នក"

#: data/konversation.notifyrc:1320
msgctxt "Name"
msgid "Kick"
msgstr "ទាត់ចេញ"

#: data/konversation.notifyrc:1370
msgctxt "Comment"
msgid "Someone kicked you out of a channel"
msgstr "មាន​នរណាម្នាក់​បាន​ទាត់អ្នក​ចេញ​ពី​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:1420
msgctxt "Name"
msgid "Connection failure"
msgstr "បរាជ័យ​ការ​តភ្ជាប់"

#: data/konversation.notifyrc:1469
msgctxt "Comment"
msgid "Failed to connect to server"
msgstr "បរាជ័យ​ក្នុង​ការ​តភ្ជាប់​ទៅ​ម៉ាស៊ីន​បម្រើ"

#: data/konversation.notifyrc:1520
msgctxt "Name"
msgid "You joined a channel"
msgstr "អ្នក​បាន​ចូល​រួម​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:1567
msgctxt "Comment"
msgid "You joined a channel"
msgstr "អ្នក​បាន​ចូល​រួម​ប៉ុស្ដិ៍"

#: data/konversation.notifyrc:1617
msgctxt "Name"
msgid "DCC Chat"
msgstr "ជជែក​កំសាន្ត DCC"

#: data/konversation.notifyrc:1666
msgctxt "Comment"
msgid "Someone started a DCC chat with you"
msgstr "មាន​នរណា​ម្នាក់​បាន​ចាប់ផ្ដើម​ការ​ជជែក​កំសាន្ដ DCC ជាមួយ​អ្នក"

