#: aurorae/Air-Oxygen/metadata.desktop:2
msgctxt "Name"
msgid "Air-Oxygen"
msgstr "Air-Oxygen"

#: aurorae/Air-Oxygen/metadata.desktop:35
msgctxt "Comment"
msgid ""
"An Aurorae theme based on the Air Plasma theme and Oxygen-lookalike buttons"
msgstr "ស្បែក Aurorae ដោយ​ផ្អែកលើ​ស្បែក​ Air Plasma និង​ប៊ូតុង Oxygen-lookalike"

