#: conduits/abbrowserconduit/abbrowser_conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the handheld addressbook with KDE's addressbook."
msgstr "conduit នេះ​ធ្វើ​សមកាលកម្ម​​សៀវភៅ​អាសយដ្ឋាន​ឧបករណ៍​យួរដៃ​ជា​មួយ​សៀវភៅ​អាសយដ្ឋាន​របស់ KDE ។"

#: conduits/abbrowserconduit/abbrowser_conduit.desktop:22
msgctxt "Name"
msgid "Addressbook"
msgstr "សៀវភៅ​អាសយដ្ឋាន"

#: conduits/docconduit/doc_conduit.desktop:4
msgctxt "Comment"
msgid "Adds text files to your handheld, suitable for DOC readers."
msgstr "បន្ថែម​ឯកសារ​អត្ថបទ​ទៅ​ឧបករណ៍​យួរដៃ​របស់​អ្នក ដែល​សមរម្យ​សម្រាប់​កម្មវិធី​អាន DOC ។"

#: conduits/docconduit/doc_conduit.desktop:22
msgctxt "Name"
msgid "Palm DOC"
msgstr "Palm DOC"

#: conduits/docconduit/kpalmdoc.desktop:4
msgctxt "Name"
msgid "KPalmDOC"
msgstr "KPalmDOC"

#: conduits/docconduit/kpalmdoc.desktop:6
msgctxt "GenericName"
msgid "PalmDOC Converter"
msgstr "កម្មវិធី​បម្លែង PalmDOC"

#: conduits/knotes/knotes-conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the Memo Pad application with KNotes."
msgstr "កម្មវិធី conduit syncs the Memo Pad នេះ​មាន KNotes ។"

#: conduits/knotes/knotes-conduit.desktop:22
msgctxt "Name"
msgid "KNotes / Memos"
msgstr "KNotes / Memos"

#: conduits/malconduit/mal_conduit.desktop:4
msgctxt "Name"
msgid "MAL (AvantGo) Conduit"
msgstr "MAL (AvantGo) Conduit"

#: conduits/malconduit/mal_conduit.desktop:20
msgctxt "Comment"
msgid ""
"Syncronize AvantGo (or generally a MAL server's content) to the handheld. "
"This allows you to view web-pages offline on the handheld, like your cinema "
"or TV schedule, or any other web page."
msgstr ""
"Syncronize AvantGo (ជា​ទូទៅ​ជា​មាតិកា​​របស់​ម៉ាស៊ីន​បម្រើ MAL) ទៅ​កាន់​ឧបករណ៍​យួរដៃ ។វា​អនុញ្ញាត​ឲ្យ​អ្ន​"
"ក​មើល​ទំព័រ​ប​ណ្ដាញ​ក្រៅ​បណ្ដាញ​នៅ​លើ​ឧបករណ៍​យួរដៃ ដូច​ជា​កម្មវិធី​ភាពយន្ត ឬ​ទូរទស្សន៍ ឬ​ទំព័រ​បណ្ដាញ​ផ្សេងៗ​ទៀត ។"

#: conduits/memofileconduit/memofile-conduit.desktop:4
msgctxt "Name"
msgid "Memo File"
msgstr "ឯកសារ Memo"

#: conduits/memofileconduit/memofile-conduit.desktop:23
msgctxt "Comment"
msgid "This conduit syncs your handheld memos with a local directory."
msgstr "ឧបករណ៍​យួរដៃ​របស់ conduit syncs នេះ​មាន​ថត​មូលដ្ឋាន ។"

#: conduits/notepadconduit/notepad-conduit.desktop:4
msgctxt "Name"
msgid "NotePad"
msgstr "NotePad"

#: conduits/notepadconduit/notepad-conduit.desktop:11
msgctxt "Comment"
msgid "This conduit backs up NotePad drawings to a local folder."
msgstr "conduit បម្រុង​ទុក​គំនូរ​របស់ NotePad ទៅ​ថត​មូលដ្ឋាន ។"

#: conduits/null/null-conduit.desktop:4
msgctxt "Name"
msgid "NULL"
msgstr "NULL"

#: conduits/null/null-conduit.desktop:6
msgctxt "Comment"
msgid "This conduit does nothing."
msgstr "conduit មិន​ធ្វើ​អ្វី​សោះ ។"

#: conduits/perlconduit/perl-conduit.desktop:4
msgctxt "Name"
msgid "Perl (Sample)"
msgstr "Perl (គំរូ)"

#: conduits/perlconduit/perl-conduit.desktop:24
msgctxt "Comment"
msgid "This sample conduit runs a Perl interpreter."
msgstr "conduit ធម្មតា​នេះ​រត់​ជា​កម្មវិធី​បកប្រែ Perl"

#: conduits/popmail/popmail-conduit.desktop:4
msgctxt "Comment"
msgid "Send mail from your handheld through KMail."
msgstr "ផ្ញើ​សំបុត្រ​ពី​ឧបករណ៍​យួរដៃ​របស់​អ្នក​តាមរយៈ KMail ។"

#: conduits/popmail/popmail-conduit.desktop:22
msgctxt "Name"
msgid "Mail"
msgstr "សំបុត្រ"

#: conduits/pythonconduit/python-conduit.desktop:4
msgctxt "Name"
msgid "Python (Sample)"
msgstr "Python (គំរូ)"

#: conduits/pythonconduit/python-conduit.desktop:23
msgctxt "Comment"
msgid "This sample conduit runs a Python interpreter."
msgstr "conduit គំរូ​នេះ​រត់​ជា​កម្មវិធី​បកប្រែ Python ។"

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:4
msgctxt "Comment"
msgid ""
"This conduit writes information about your handheld and the sync to a file."
msgstr "conduit នេះ​សរសេរ​ព័ត៌មាន​អំពី​ឧបករណ៍​យួរដៃ​របស់​អ្នក និង​ធ្វើ​សមកាលកម្ម​ទៅ​កាន់​ឯកសារ ។"

#: conduits/sysinfoconduit/sysinfo_conduit.desktop:22
msgctxt "Name"
msgid "System Information"
msgstr "ព័ត៌មាន​ប្រព័ន្ធ​"

#: conduits/timeconduit/time_conduit.desktop:4
msgctxt "Comment"
msgid "This conduit sets the time on your handheld from the PC clock."
msgstr "conduit នេះ​កំណត់​ពេលវេលា​នៅ​លើ​ឧបករណ៍​យួរដៃ​របស់​អ្នក​ពី​នាឡិកា PC ។"

#: conduits/timeconduit/time_conduit.desktop:22
msgctxt "Name"
msgid "Time Synchronization"
msgstr "ការ​ធ្វើ​សមកាលកម្ម​ពេលវេលា"

#: conduits/vcalconduit/todo-conduit.desktop:4
msgctxt "Comment"
msgid "This conduit syncs the ToDo list from your handheld to KOrganizer."
msgstr "conduit នេះ​ធ្វើ​សមកាលកម្ម​បញ្ជី​ការងារ​ត្រូវ​ធ្វើ​ពី​ឧបករណ៍​យួរដៃ​របស់​អ្នក​ទៅ KOrganizer ។"

#: conduits/vcalconduit/todo-conduit.desktop:22
msgctxt "Name"
msgid "ToDos (KOrganizer)"
msgstr "ការងារ​ត្រូវ​ធ្វើ (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:4
msgctxt "Name"
msgid "Calendar (KOrganizer)"
msgstr "ប្រតិទិន (KOrganizer)"

#: conduits/vcalconduit/vcal-conduit.desktop:24
msgctxt "Comment"
msgid "This conduit synchronizes your handheld with the KOrganizer datebook."
msgstr "conduit នេះ​ធ្វើ​សមកាលកម្ម​ឧបករណ៍​យួរដៃ​របស់​អ្នក​ជា​មួយ​​សៀវភៅ​កាលបរិច្ឆេទ KOrganizer ។"

