#: freespacenotifier.cpp:96
#, fuzzy, kde-format
msgid ""
"You are running low on disk space on your home partition (currently %2%, %1 "
"MiB free).\n"
"Would you like to run a file manager to free some disk space?"
msgstr ""
"អ្នក​កំពុង​ដំណើរ​ការ​ទាប​លើទំហំ​ថាស​លើភាគ​ថាស​ផ្ទះ​របស់​អ្នក​ (បច្ចុប្បន្នទំនេរ %2%, %1 MiB ).\n"
"តើ​អ្នក​ចង់​ដំណើរ​ការ​គ្រប់​គ្រង​ឯកសារ​ទំហំថាស​ទំនេរ​ខ្លះ ?"

#: freespacenotifier.cpp:97
#, fuzzy
msgid "Open File Manager"
msgstr "គ្រប់​គ្រង​ឯក​សារ​បើក"

#: freespacenotifier.cpp:97
#, fuzzy
msgid "Do Nothing"
msgstr "មិន​ធ្វើ​អ្វី​ទាំង​អស់"

#: freespacenotifier.cpp:97
#, fuzzy
msgid "Configure Warning"
msgstr "ការ​ព្រមាន​កំណត់​រចនា​សម្ព័ន្ធ"

#: freespacenotifier.cpp:131
#, fuzzy
msgid "General"
msgstr "ទូទៅ"

#. i18n: file: freespacenotifier.kcfg:9
#. i18n: ectx: label, entry (minimumSpace), group (General)
#: rc.cpp:3
#, fuzzy
msgid "Minimum free space before user starts being notified."
msgstr "ទំហំ​ទំនេរ​អប្បបរ​មា​មុន​ពេល​អ្នក​ប្រើ​ចាប់​ផ្តើម​ជួន​ដំណឹង ។"

#. i18n: file: freespacenotifier.kcfg:15
#. i18n: ectx: label, entry (enableNotification), group (General)
#: rc.cpp:6
#, fuzzy
msgid "Is the free space notification enabled."
msgstr "ទំហំ​ទំនេរ​ដែ​ល​អនុញ្ញាត​ឲ្យ​ជួន​ដំ​ណឹង ។"

#. i18n: file: freespacenotifier_prefs_base.ui:17
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_enableNotification)
#: rc.cpp:9
#, fuzzy
msgid "Enable low disk space warning"
msgstr "អនុញ្ញាត​ការ​ព្រមាន​ទំហំ​ថាស​ទាប"

#. i18n: file: freespacenotifier_prefs_base.ui:27
#. i18n: ectx: property (text), widget (QLabel, label_minimumSpace)
#: rc.cpp:12
#, fuzzy
msgid "Warn when free space is below:"
msgstr "ព្រមាន​នៅ​ពេល​ដែល​ទំហំ​ទំនេរខាង​ក្រោម ៖"

