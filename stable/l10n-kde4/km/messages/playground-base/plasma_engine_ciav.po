#: ciavc.cpp:70
msgid "Data download was aborted"
msgstr "ការ​ទាញយក​ទិន្នន័យ​ត្រូវ​បានបោះបង់"

#: ciavc.cpp:73
msgid "Data download timed out"
msgstr "អស់ពេល​ក្នុងការ​ទាញ​យក​​ទិន្នន័យ"

#: ciavc.cpp:76
msgid "The hostname could not be resolved"
msgstr "ឈ្មោះម៉ាស៊ីន​មិនអាច​ត្រូវ​បានដោះស្រាយ​បានទេ"

#: ciavc.cpp:79
msgid "404: File not found"
msgstr "៤០៤ ៖ រក​មិនឃើញឯកសារ"

#: ciavc.cpp:82
msgid "Retriever Error"
msgstr "កំហុស​កម្មវិធី​ទៅ​យក"

#: ciavc.cpp:85
msgid "Invalid XML"
msgstr "XML មិនត្រឹមត្រូវ"

#: ciavc.cpp:88
msgid "XML not accepted by parser"
msgstr "XML មិន​បានទទួល​ដោយ​អ្នក​ប្រើ"

#: ciavc.cpp:91
msgid "XML parsing failed"
msgstr "បានបរាជ័យ​ក្នុងការ​ញែក XML"

#: ciavc.cpp:94
msgid "Invalid Syndication::ErrorCode"
msgstr "ការ​ការពារ​មិនត្រឹមត្រូវ ៖ ៖ កូដ​កំហុស"

#: ciavc.cpp:97
msgid "Error"
msgstr "កំហុស"

#: ciavc.cpp:97
msgid "Syndication Error"
msgstr "កំហុសក្នុងការការពារ"
