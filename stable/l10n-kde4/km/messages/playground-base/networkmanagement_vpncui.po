#. i18n: file: vpncauth.ui:16
#. i18n: ectx: property (caption), widget (QWidget)
#: rc.cpp:3
msgid "VPNCAuthentication"
msgstr "ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ VPNC"

#. i18n: file: vpncauth.ui:30
#. i18n: ectx: property (text), widget (QLabel)
#: rc.cpp:6
msgid "Password"
msgstr "ពាក្យសម្ងាត់"

#. i18n: file: vpncauth.ui:38
#. i18n: ectx: property (text), widget (QLabel)
#: rc.cpp:9
msgid "Group Password"
msgstr "ដាក់​ពាក្យ​សម្ងាត់​ជា​ក្រុម"

#. i18n: file: vpncprop.ui:13
#. i18n: ectx: property (windowTitle), widget (QWidget, VpncProp)
#: rc.cpp:12
msgid "Cisco VPN"
msgstr "Cisco VPN"

#. i18n: file: vpncprop.ui:23
#. i18n: ectx: attribute (title), widget (QWidget, TabPage)
#: rc.cpp:15
msgid "Required Information"
msgstr "ព័ត៌មាន​ដែល​ត្រូ​វការ"

#. i18n: file: vpncprop.ui:29
#. i18n: ectx: property (text), widget (QLabel, textLabel3)
#: rc.cpp:18
msgid "Gateway:"
msgstr "ច្រកចេញចូល ៖"

#. i18n: file: vpncprop.ui:45
#. i18n: ectx: property (text), widget (QLabel, labelGroup)
#: rc.cpp:21
msgid "Group name:"
msgstr "ឈ្មោះ​ក្រុម ៖"

#. i18n: file: vpncprop.ui:78
#. i18n: ectx: attribute (title), widget (QWidget, TabPage)
#: rc.cpp:24
msgid "Optional Information"
msgstr "ព័ត៌មាន​ជម្រើស"

#. i18n: file: vpncprop.ui:84
#. i18n: ectx: property (text), widget (QCheckBox, chkIPAdresses)
#: rc.cpp:27
msgid ""
"Only use VPN Connection for these addresses (for example: 172.16.0.0/16 "
"10.11.12.0/24):"
msgstr ""
"ប្រើតែ​ការ​តភ្ជាប់ VPN សម្រាប់​អាសយដ្ឋាន​ទាំង​នេះ (ឧទាហរណ៍ ៖ 172.16.0.0/16 "
"10.11.12.0/24) ៖"

#. i18n: file: vpncprop.ui:107
#. i18n: ectx: property (text), widget (QCheckBox, chkDisableNatTraversal)
#: rc.cpp:30
msgid "Disable NAT traversal"
msgstr "បិទ​ការ​ផ្លាស់ទី NAT"

#. i18n: file: vpncprop.ui:114
#. i18n: ectx: property (text), widget (QCheckBox, chkSingleDES)
#: rc.cpp:33
msgid "Enable weak single DES encryption"
msgstr "បើក​ការ​អ៊ិនគ្រីប​ DES មួយ​ដែល​ខ្សោយ"

#. i18n: file: vpncprop.ui:128
#. i18n: ectx: property (text), widget (QCheckBox, chkUseKeepAlive)
#: rc.cpp:36
msgid "Use NAT keep alive packets"
msgstr "ប្រើ​កញ្ចប់ព័ត៌មាន​បន្តផ្ទាល់ NAT"

#. i18n: file: vpncprop.ui:135
#. i18n: ectx: property (text), widget (QCheckBox, chkUseDomain)
#: rc.cpp:39
msgid "Use domain for authentication"
msgstr "ប្រើដែន​សម្រាប់​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#. i18n: file: vpncprop.ui:142
#. i18n: ectx: property (text), widget (QCheckBox, chkOverrideUsername)
#: rc.cpp:42
msgid "Override user name"
msgstr "បដិសេធ​ឈ្មោះ​អ្នក​ប្រើ"

#. i18n: file: vpncprop.ui:159
#. i18n: ectx: property (text), widget (QLabel, lblUsername)
#: rc.cpp:45
msgid "Username:"
msgstr "ឈ្មោះ​អ្នកប្រើ ៖"

#. i18n: file: vpncprop.ui:179
#. i18n: ectx: property (text), widget (QLabel, lblDomain)
#: rc.cpp:48
msgid "Domain:"
msgstr "ដែន ៖"

#. i18n: file: vpncprop.ui:192
#. i18n: ectx: property (text), widget (QLabel, lblKeepAliveInterval)
#: rc.cpp:51
msgid "Interval:"
msgstr "ចន្លោះពេល ៖"
