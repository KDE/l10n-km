#. i18n: file: plasmagikdesigned.ui:73
#. i18n: ectx: property (text), widget (QLabel, firstLabel)
#: rc.cpp:106
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal; text-decoration:none;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Hello,<br />with this "
"dialog you are going to magically package your</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">new exciting creation.</"
"p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Your creation will need to "
"be in an empty folder, containing just the</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">files you want to be "
"packaged. Please note that the <span style=\" font-weight:600; color:#000000;"
"\">WHOLE </span><span style=\" color:#000000;\">directory,</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; color:#000000;\">with all "
"its content, will be packaged.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">If you are going to use a "
"custom license, please</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">remember to add a file "
"called '<span style=\" font-weight:600;\">COPYING</span>'  in the top level "
"of the </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">directory you are going to "
"package. Note that this file existance </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">will be checked, and the "
"filename must be uppercase (the check is </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">case-sensitive).</p></"
"body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal; text-decoration:none;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Hello,<br />ជា​មួយ​ប្រអប់​នេះ "
"អ្នកនឹង​ខ្ចប់​ការ​បង្កើត​ដ៏​អស្ចារ្យ​របស់​​ដោយ​មន្តអាគម</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">។</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">កា​របង្កើត​របស់​អ្នក​ នឹង​តម្រូវ​ឲ្យ​មាន​"
"នៅ​ក្នុង​ថត​ទទេ ដែលមាន​តែ</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ឯកសារ​ដែល​អ្នក​ចង់​ឲ្យ​ខ្ចប់ ។ សូម​ចំណាំ​"
"ថា  <span style=\" font-weight:600; color:#000000;\">ថត​ទាំងមូល </span><span "
"style=\" color:#000000;\"></span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; color:#000000;\">ដែល​មាន​មាតិការ​"
"របស់​វា​ទាំងអស់ នឹង​ត្រូវ​បាន​ខ្ចប់ ។</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ប្រសិន​បើ​អ្នកនឹង​ប្រើអាជ្ញាបណ្ណ​"
"ផ្ទាល់ខ្លួន សូម</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ចាំថា ត្រូវ​បន្ថែម​ឯកសារ​ដែល​មាន​"
"ឈ្មោះ '<span style=\" font-weight:600;\">COPYING</span>'  នៅ​ក្នុង​កម្រិត​កំពូល​របស់ </"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ថត ដែល​អ្នក​នឹង​ខ្ចប់ ។ ចំណាំ​ថា "
"ឯកសារ​ដែល​មាន </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">នឹង​ត្រូវ​បាន​ពិនិត្យ និង​ឈ្មោះ​ឯកសារ​"
"ឯកសារ​ត្រូវ​តែ​ជា​អក្សរ​ធំ (ការ​ពិនិត្យ​គឺ </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ប្រកាន់​អក្សរ​តូចធំ) ។</p></"
"body></html>"

#. i18n: file: plasmagikdesigned.ui:333
#. i18n: ectx: property (text), widget (QLabel, creationDescriptionLabel)
#: rc.cpp:189
msgid "Add a simple description:"
msgstr "បន្ថែម​សេចក្ដីពិពណ៌នា​ធម្មតា ៖"

#. i18n: file: plasmagikdesigned.ui:343
#. i18n: ectx: property (text), widget (QLabel, releaseNotesLabel)
#: rc.cpp:192
msgid "Here you can add release notes for your creation:"
msgstr "នៅ​ទីនេះ អ្នក​អាច​បន្ថែម​ឯកសារ​ចេញ​ផ្សាយ​សម្រាប់​ការ​បង្កើត​របស់​អ្នក ៖"

#. i18n: file: plasmagikdesigned.ui:400
#. i18n: ectx: property (toolTip), widget (QLabel, firstFileLabel)
#: rc.cpp:201
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">The file you should select "
"as \"main file\" differs a lot depending on what is the type of package you "
"are making. </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Here are a few examples "
"provided to help you choose the right file.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">The file to be selected "
"should already have been specified by the application (see manual, etc...), "
"if not, please complain to the application maintainer.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Here are the examples:</"
"p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"> <span style=\" font-"
"weight:600;\">* Wallpaper:</span> For a wallpaper, the image to be loaded "
"should probably be selected here.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600;\">* Script:"
"<span style=\" font-weight:400;\"> In case your creation is a script, you "
"should select the main file, that includes each other, the one the "
"application should directly use.</span></p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ឯកសារ​ដែល​​អ្នក​គួរ​ជ្រើស​ជា \"ឯកសារ​"
"មេ\" ខុសគ្នា​ច្រើន​ ដោយ​អាស្រ័យ​លើ​​ប្រភេទ​កញ្ចប់​អ្វី​ដែល​អ្នក​កំពុង​ធ្វើ ។ </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">នៅ​ទីនេះ មាន​ឧទាហរណ៍​ចំនួន​​បាន​ផ្ដល់​​"
"ដើម្បី​ជួយ​អ្នក​ឲ្យ​ជ្រើសឯកសារ​ដែល​ត្រឹមត្រូវ ។</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ឯកសារ​ដែល​ត្រូ​វជ្រើស គួរ​ត្រូវ​បាន​"
"បញ្ជាក់​ដោយ​កម្មវិធី​រួ​ចហើយ (សូម​មើល​សៀវភៅ​ដៃ ...។ល។) ប្រសិនបើ​មិន​មាន​ទេ សូម​តវ៉ា​ទៅ​អ្នក​ថែទាំ​កម្មវិធី​ ។"
"</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">នៅទីនេះ មាន​ឧទាហរណ៍​មួយ​ចំនួន ៖</"
"p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"> <span style=\" font-"
"weight:600;\">* Wallpaper:</span> ចំពោះ​ផ្ទាំង​រូបភាព រូបភាព​ដែល​ត្រូ​វផ្ទុក គួរ​ត្រូវ​បានប្រើ​នៅ​"
"ទីនេះ ។</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600;\">* Script:"
"<span style=\" font-weight:400;\"> នៅ​ក្នុងករណី​កា​របង្កើត​របស់​អ្នកជា​ស្គ្រីប អ្នក​គួរ​ជ្រើស​"
"ឯកសារ​មេ ដែល​រួម​មាន​វា​ កម្មវិធី​មួយដែល​គួរ​ប្រើ​រួច​ហើយ ។</span></p></body></html>"

