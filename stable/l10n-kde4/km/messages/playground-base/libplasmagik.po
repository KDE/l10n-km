msgstr "បង្កើត​កញ្ចប់"

#. i18n: file: plasmagikdesigned.ui:489
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:232
msgid ""
"If you want to upload the package you have just created on\n"
"our servers via KNewStuff, so that everyone can \n"
"download it immediately with a one-click procedure,\n"
"please do so by clicking on the button below."
msgstr ""
"ប្រសិន​បើ​អ្នក​ចង់​ផ្ទុក​កញ្ចប់ឡើង អ្នក​​គ្រាន់​តែ​បានបង្កើត​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​តាមរយៈ KNewStuff ដូច្នេះ​អ្នក​"
"រាល់គ្នា​អាច​ទាញ​យក​វា​បាន​ភ្លាមៗ ដោយ​គ្រាន់​តែ​​ប្រើ​ចុច​មួយ​ដង សូម​ធ្វើ​វា​ដោយ​ចុច​​លើ​ប៊ូតុង​ខាង​ក្រោម ។"

#. i18n: file: plasmagikdesigned.ui:496
#. i18n: ectx: property (text), widget (QPushButton, uploadButton)
#: rc.cpp:238
msgid "Upload"
msgstr "ផ្ទុកឡើង"

#. i18n: file: welcomepage.ui:33
#. i18n: ectx: property (text), widget (QLabel, firstLabel)
#: rc.cpp:241
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">With this dialog you are "
"going to magically package your new creation.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Your creation will need to "
"be in an empty folder, containing just the files you want to be packaged. "
"Please note that the <span style=\" font-weight:600; color:#000000;\">WHOLE "
"</span><span style=\" color:#000000;\">directory, with all its content, will "
"be packaged.</span></p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">If you are going to use a "
"custom license, please</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">remember to add a file "
"called '<span style=\" font-weight:600;\">COPYING</span>'  in the top level "
"of the directory you are going to package.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ជា​មួយ​ប្រអប់​នេះ អ្នក​នឹង​បង្កើត​កញ្ចប់​​"
"នៃ​ការ​បង្កើត​ថ្មី​របស់​អ្នក ។</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ការ​បង្កើត​របស់​អ្នក​នឹង​មិន​ចាំបាច់​នៅ​"
"ក្នុង​ថត​ទទេ​នោះទេ មាន​តែ​ឯកសារដែល​អ្នក​ចង់​ឲ្យ​បង្កើត​​ជា​កញ្ចប់ ។ សូម​ចំណាំថាថត <span style=\" "
"font-weight:600; color:#000000;\">ទាំង​មូល </span><span style=\" color:#000000;"
"\">មាន​មាតិកា​របស់​វា​ទាំងអស់ នឹង​ត្រូវ​បាន​បង្កើត​ជា​កញ្ចប់ ។</span></p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ប្រសិនបើ​អ្នក​ចង់​ប្រើ​អាជ្ញាបណ្ណ​"
"ផ្ទាល់ខ្លួន សូម</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ចងចាំ​ត្រូ​វបន្ថែម​ឯកសារ​ដែល​មាន​ឈ្មោះ​"
"ថា<span style=\" font-weight:600;\">COPYING</span>'  នៅ​ក្នុង​កម្រិត​កំពូល​របស់​ថត ដែល​អ្នក​"
