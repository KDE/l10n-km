#: kateexternaltools.cpp:268
#, kde-format
msgid "Failed to expand the command '%1'."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ពង្រីក​ពាក្យ​បញ្ជា '%1' ។"

#: kateexternaltools.cpp:269
msgid "Kate External Tools"
msgstr "ឧបករណ៍​ខាងក្រៅ​របស់ Kate"

#: kateexternaltools.cpp:451
msgid "Edit External Tool"
msgstr "កែសម្រួល​ឧបករណ៍​​​ខាងក្រៅ"

#: kateexternaltools.cpp:469
msgid "&Label:"
msgstr "ស្លាក៖"

#: kateexternaltools.cpp:474
msgid "The name will be displayed in the 'Tools->External' menu"
msgstr "ឈ្មោះ​នឹង​ត្រូវ​បាន​បង្ហាញ​ក្នុង​ម៉ឺនុយ 'Tools->External'"

#: kateexternaltools.cpp:486
msgid "S&cript:"
msgstr "ស្គ្រីប ៖"

#: kateexternaltools.cpp:491
msgid ""
"<p>The script to execute to invoke the tool. The script is passed to /bin/sh "
"for execution. The following macros will be expanded:</p><ul><li><code>%URL</"
"code> - the URL of the current document.</li><li><code>%URLs</code> - a list "
"of the URLs of all open documents.</li><li><code>%directory</code> - the URL "
"of the directory containing the current document.</li><li><code>%filename</"
"code> - the filename of the current document.</li><li><code>%line</code> - "
"the current line of the text cursor in the current view.</li><li><code>"
"%column</code> - the column of the text cursor in the current view.</"
"li><li><code>%selection</code> - the selected text in the current view.</"
"li><li><code>%text</code> - the text of the current document.</li></ul>"
msgstr ""
"<p>ស្គ្រីប​ប្រតិបត្តិ​ដើម្បី​ប្រើ​ឧបករណ៍ ។ ស្គ្រីប​​ទៅ​កាន់ /bin/sh "
"សម្រាប់​ប្រតិបត្តិការ ។ macros នឹង​ត្រូវ​បាន​ពង្រីក ៖</p><ul><li><code>%"
"URL</code> - ​​the URL of the current document.</li><li><code>%URLs</code> - "
"a list of the URLs of all open documents.</li><li><code>%directory</code> - "
"the URL of the directory containing the current document.</li><li><code>%"
"filename</code> - the filename of the current document.</li><li><code>%"
"line</code> - the current line of the text cursor in the current "
"view.</li><li><code>%column</code> - the column of the text cursor in the "
"current view.</li><li><code>%selection</code> - the selected text in the "
"current view.</li><li><code>%text</code> - the text of the current "
"document.</li></ul>"

#: kateexternaltools.cpp:511
msgid "&Executable:"
msgstr "ឯកសារ​ប្រតិបត្តិ ៖"

#: kateexternaltools.cpp:516
msgid ""
"The executable used by the command. This is used to check if a tool should "
"be displayed; if not set, the first word of <em>command</em> will be used."
msgstr ""

#: kateexternaltools.cpp:524
msgid "&Mime types:"
msgstr "ប្រភេទ &Mime ៖"

#: kateexternaltools.cpp:529
msgid ""
"A semicolon-separated list of mime types for which this tool should be "
"available; if this is left empty, the tool is always available. To choose "
"from known mimetypes, press the button on the right."
msgstr ""

#: kateexternaltools.cpp:538
msgid "Click for a dialog that can help you create a list of mimetypes."
msgstr "ចុច​លើ​ប្រអប់​ដែល​អាច​ជួយ​អ្នក​ក្នុង​ការ​បង្កើត​បញ្ជី mimetypes ។"

#: kateexternaltools.cpp:544
msgid "&Save:"
msgstr "រក្សាទុក"

#: kateexternaltools.cpp:548
msgid "None"
msgstr "គ្មាន"

#: kateexternaltools.cpp:548
msgid "Current Document"
msgstr "ឯកសារ​បច្ចុប្បន្ន"

#: kateexternaltools.cpp:548
msgid "All Documents"
msgstr "ឯកសារ​ទាំងអស់"

#: kateexternaltools.cpp:552
msgid ""
"You can choose to save the current or all [modified] documents prior to "
"running the command. This is helpful if you want to pass URLs to an "
"application like, for example, an FTP client."
msgstr ""
"អ្នក​អាច​ជ្រើស​រក្សាទុក​បច្ចុប្បន្ន ឬ​​ឯកសារ [modified] ទាំង​អស់ "
"ដើម្បី​ដំណើរការ​ពាក្យ​បញ្ជា ។ វា​មាន​ប្រយោជន៍ ប្រសិនបើ​អ្នក​ចង់​ហុច URLs "
"ទៅ​កាន់​កម្មវិធី ឧទាហរណ៍ ម៉ាស៊ីន​កូន​របស់ FTP ។"

#: kateexternaltools.cpp:559
msgid "&Command line name:"
msgstr "ឈ្មោះ​បន្ទាត់​ពាក្យ​បញ្ជា ៖"

#: kateexternaltools.cpp:565
msgid ""
"If you specify a name here, you can invoke the command from the view command "
"line with exttool-the_name_you_specified_here. Please do not use spaces or "
"tabs in the name."
msgstr ""
"ប្រសិនបើ​អ្នក​បញ្ជាក់​ឈ្មោះ​នៅ​ទី​នេះ "
"អ្នក​អាច​​ប្រើ​ពាក្យ​បញ្ជា​ពី​បន្ទាត់​ពាក្យ​បញ្ជា exttool-"
"the_name_you_specified_here ។ សូម​កុំ​ប្រើ​ចន្លោះ​មិន​ឃើញ (spaces) ឬ​ថេប "
"(tabs) នៅ​ឈ្មោះ​របស់​អ្នក ។"

#: kateexternaltools.cpp:576
msgid "You must specify at least a name and a command"
msgstr "អ្នក​ត្រូវ​តែ​បញ្ជាក់​យ៉ាង​ហោច​ណាស់​ពាក្យ​​បញ្ជា​មួយ​ ឬ​ឈ្មោះ​មួយ"

#: kateexternaltools.cpp:590
msgid "Select the MimeTypes for which to enable this tool."
msgstr "ជ្រើស MimeTypes សម្រាប់​បើក​ឧបករណ៍​​នេះ ។"

#: kateexternaltools.cpp:592
msgid "Select Mime Types"
msgstr "ជ្រើស​ប្រភេទ Mime"

#: kateexternaltoolsplugin.cpp:46 kateexternaltoolsplugin.cpp:128
#: kateexternaltoolsplugin.cpp:136 kateexternaltoolsplugin.cpp:157
