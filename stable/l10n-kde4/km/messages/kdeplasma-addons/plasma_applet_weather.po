#: weatherapplet.cpp:181
msgctxt "Shown when you have not set a weather provider"
msgid "Please Configure"
msgstr "សូម​កំណត់​រចនាសម្ព័ន្ធ"

#: weatherapplet.cpp:184
#, kde-format
msgctxt ""
"%1 is the weather condition, %2 is the temperature, both come from the "
"weather provider"
msgid "%1 %2"
msgstr "%1 %2"

#: weatherapplet.cpp:238 weatherapplet.cpp:240 weatherapplet.cpp:245
#: weatherapplet.cpp:247
#, kde-format
msgctxt "temperature, unit"
msgid "%1%2"
msgstr "%1%2"

#: weatherapplet.cpp:267
#, kde-format
msgctxt "Low temperature"
msgid "Low: %1"
msgstr "ទាប ៖ %1"

#: weatherapplet.cpp:269
#, kde-format
msgctxt "High temperature"
msgid "High: %1"
msgstr "ខ្ពស់ ៖ %1"

#: weatherapplet.cpp:271
#, kde-format
msgctxt "High & Low temperature"
msgid "H: %1 L: %2"
msgstr "ខ្ពស់ ៖ %1 ទាប ៖ %2"

#: weatherapplet.cpp:395
#, kde-format
msgctxt "certain weather condition, probability percentage"
msgid "%1 (%2%)"
msgstr "%1 (%2%)"

#: weatherapplet.cpp:410 weatherapplet.cpp:423
msgctxt "Short for no data available"
msgid "-"
msgstr "-"

#: weatherapplet.cpp:452
#, kde-format
msgctxt "Forecast period timeframe"
msgid "1 Day"
msgid_plural "%1 Days"
msgstr[0] "%1 ថ្ងៃ"

#: weatherapplet.cpp:476
#, kde-format
msgctxt "windchill, unit"
msgid "Windchill: %1"
msgstr "ខ្យល់​ត្រជាក់ ៖ %1"

#: weatherapplet.cpp:484
#, kde-format
msgctxt "humidex, unit"
msgid "Humidex: %1"
msgstr "Humidex ៖ %1"

#: weatherapplet.cpp:491
#, kde-format
msgctxt "ground temperature, unit"
msgid "Dewpoint: %1"
msgstr "ចំណុច​សើម ៖ %1"

#: weatherapplet.cpp:497
#, kde-format
msgctxt "pressure, unit"
msgid "Pressure: %1 %2"
msgstr "សម្ពាធ ៖ %1 %2"

#: weatherapplet.cpp:503
#, kde-format
msgctxt "pressure tendency, rising/falling/steady"
msgid "Pressure Tendency: %1"
msgstr "និន្នាការ​សម្ពាធ ៖ %1"

#: weatherapplet.cpp:513
#, kde-format
msgctxt "distance, unit"
msgid "Visibility: %1 %2"
msgstr "ភាព​​មើលឃើញ ៖ %1%2"

#: weatherapplet.cpp:515
#, kde-format
msgctxt "visibility from distance"
msgid "Visibility: %1"
msgstr "ភាព​​មើលឃើញ ៖ %1"

#: weatherapplet.cpp:523
#, kde-format
msgctxt "content of water in air"
msgid "Humidity: %1"
msgstr "សំណើម ៖ %1"

#: weatherapplet.cpp:528
#, kde-format
msgctxt "wind direction, speed"
msgid "%1 %2 %3"
msgstr "%1 %2 %3"

#: weatherapplet.cpp:532
msgctxt "Not available"
msgid "N/A"
msgstr "គ្មាន"

#: weatherapplet.cpp:535
msgctxt "Wind condition"
msgid "Calm"
msgstr "ត្រជាក់"

#: weatherapplet.cpp:547
#, kde-format
msgctxt "winds exceeding wind speed briefly"
msgid "Wind Gust: %1 %2"
msgstr "សន្ទុះ​ខ្យល់ ៖ %1 %2"

#: weatherapplet.cpp:555
msgctxt "current weather information"
msgid "Details"
msgstr "សេចក្ដី​លម្អិត"

#: weatherapplet.cpp:570
msgctxt "weather warnings"
msgid "Warnings Issued:"
msgstr "ការ​ព្រមាន​បានចេញផ្សាយ ៖"

#: weatherapplet.cpp:607
msgctxt "weather watches"
msgid "Watches Issued:"
msgstr "អាកាសធាតុ​បានចេញ​ផ្សាយ ៖"

#: weatherapplet.cpp:633
msgctxt "weather notices"
msgid "Notices"
msgstr "ចំណាំ"
