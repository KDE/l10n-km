#: weatherapplet.cpp:174
msgctxt "Shown when you have not set a weather provider"
msgid "Please Configure"
msgstr "សូម​កំណត់​រចនាសម្ព័ន្ធ"

#: weatherapplet.cpp:177
#, kde-format
msgctxt ""
"%1 is the weather condition, %2 is the temperature, both come from the "
"weather provider"
msgid "%1 %2"
msgstr "%1 %2"

#: weatherapplet.cpp:288 weatherapplet.cpp:295
msgctxt "Degree, unit symbol"
msgid "°"
msgstr "°"

#: weatherapplet.cpp:288 weatherapplet.cpp:290 weatherapplet.cpp:295
#: weatherapplet.cpp:297
#, kde-format
msgctxt "temperature, unit"
msgid "%1%2"
msgstr "%1%2"

#: weatherapplet.cpp:317
#, kde-format
msgctxt "Low temperature"
msgid "Low: %1"
msgstr "ទាប ៖ %1"

#: weatherapplet.cpp:319
#, kde-format
msgctxt "High temperature"
msgid "High: %1"
msgstr "ខ្ពស់ ៖ %1"

#: weatherapplet.cpp:321
#, kde-format
msgctxt "High & Low temperature"
msgid "H: %1 L: %2"
msgstr "ខ្ពស់ ៖ %1 ទាប ៖ %2"

#: weatherapplet.cpp:333 weatherapplet.cpp:364
msgctxt "Not available"
msgid "N/A"
msgstr "គ្មាន"

#: weatherapplet.cpp:360
#, kde-format
msgctxt "wind direction, speed"
msgid "%1 %2 %3"
msgstr "%1 %2 %3"

#: weatherapplet.cpp:367
msgctxt "Wind condition"
msgid "Calm"
msgstr "ត្រជាក់"

#: weatherapplet.cpp:466
#, kde-format
msgctxt "certain weather condition, probability percentage"
msgid "%1 (%2%)"
msgstr "%1 (%2%)"

#: weatherapplet.cpp:481 weatherapplet.cpp:494
msgctxt "Short for no data available"
msgid "-"
msgstr "-"

#: weatherapplet.cpp:521
#, kde-format
msgctxt "Forecast period timeframe"
msgid "1 Day"
msgid_plural "%1 Days"
msgstr[0] "%1 ថ្ងៃ"

#: weatherapplet.cpp:549
#, kde-format
msgctxt "windchill, unit"
msgid "Windchill: %1"
msgstr "ខ្យល់​ត្រជាក់ ៖ %1"

#: weatherapplet.cpp:557
#, kde-format
msgctxt "humidex, unit"
msgid "Humidex: %1"
msgstr "Humidex ៖ %1"

#: weatherapplet.cpp:564
#, kde-format
msgctxt "ground temperature, unit"
msgid "Dewpoint: %1"
msgstr "ចំណុច​សើម ៖ %1"

#: weatherapplet.cpp:572
#, kde-format
msgctxt "pressure, unit"
msgid "Pressure: %1 %2"
msgstr "សម្ពាធ ៖ %1 %2"

#: weatherapplet.cpp:578
#, kde-format
msgctxt "pressure tendency, rising/falling/steady"
msgid "Pressure Tendency: %1"
msgstr "និន្នាការ​សម្ពាធ ៖ %1"

#: weatherapplet.cpp:589
#, kde-format
msgctxt "distance, unit"
msgid "Visibility: %1 %2"
msgstr "ភាព​​មើលឃើញ ៖ %1%2"

#: weatherapplet.cpp:591
#, kde-format
msgctxt "visibility from distance"
msgid "Visibility: %1"
msgstr "ភាព​​មើលឃើញ ៖ %1"

#: weatherapplet.cpp:599
msgctxt "Precent, measure unit"
msgid "%"
msgstr "%"

#: weatherapplet.cpp:599
#, kde-format
msgctxt "content of water in air"
msgid "Humidity: %1%2"
msgstr "សំណើម ៖ %1%2"

#: weatherapplet.cpp:622
#, kde-format
msgctxt "winds exceeding wind speed briefly"
msgid "Wind Gust: %1 %2"
msgstr "សន្ទុះ​ខ្យល់ ៖ %1%2"

#: weatherapplet.cpp:630
msgctxt "current weather information"
msgid "Details"
msgstr "សេចក្ដី​លម្អិត"

#: weatherapplet.cpp:645
msgctxt "weather warnings"
msgid "Warnings Issued:"
msgstr "ការ​ព្រមាន​បានចេញផ្សាយ ៖"

#: weatherapplet.cpp:683
msgctxt "weather watches"
msgid "Watches Issued:"
msgstr "ការ​ឃ្លាំង​មើល​បានចេញ​ផ្សាយ ៖"

#: weatherapplet.cpp:709
msgctxt "weather notices"
msgid "Notices"
msgstr "ចំណាំ"
