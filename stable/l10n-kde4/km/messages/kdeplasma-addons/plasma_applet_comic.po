#: comic.cpp:64
msgid "Go to Strip"
msgstr "ទៅ​កាន់​ចម្រៀក"

#: comic.cpp:80
msgid "&Strip Number:"
msgstr "លេខ​ចម្រៀក ៖"

#: comic.cpp:148
msgid "&Jump to first Strip"
msgstr "លោត​ទៅ​​ចម្រៀក​ដំបូង"

#: comic.cpp:152
msgid "&Jump to current Strip"
msgstr "លោត​ទៅ​ចម្រៀក​កំប្លែង​បច្ចុប្បន្ន"

#: comic.cpp:156
msgid "&Save Comic As..."
msgstr "រក្សាទុក​កំប្លែង​ជា..."

#: comic.cpp:160
msgctxt "@option:check Context menu of comic image"
msgid "&Actual Size"
msgstr "ទំហំ​ពិតប្រាកដ"

#: comic.cpp:244
msgid "General"
msgstr "ទូទៅ"

#: configwidget.cpp:87
msgid "Comic:"
msgstr "កំប្លែង ៖"

#: configwidget.cpp:90
msgid "Show comic author"
msgstr "បង្ហាញ​អ្នកនិពន្ធ​កំប្លែង"

#: configwidget.cpp:91
msgid "Show comic title"
msgstr "បង្ហាញ​ចំណង​ជើង​កំប្លែង"

#: configwidget.cpp:92
msgid "Show comic url"
msgstr "បង្ហាញ Url កំប្លែង"

#: configwidget.cpp:93
msgid "Show comic identifier"
msgstr "បង្ហាញ​​ឧបករណ៍​កំណត់​អត្តសញ្ញាណ​កំប្លែង"

#: configwidget.cpp:94
msgid "Show arrows only on hover"
msgstr "បង្ហាញ​ព្រួញ​តែ​នៅ​ពេល​សំកាំង​ប៉ុណ្ណោះ"

#: configwidget.cpp:96
msgid "Download new comics"
msgstr "ទាញ​យក​កំប្លែង​ថ្មី"

#: configwidget.cpp:97
msgid "Get New Comics..."
msgstr "ទទួល​កំប្លែង​ថ្មី..."
