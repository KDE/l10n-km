msgstr "ផ្ទុក​​ការ​កំណតត់​រចនា​សម្ពន័​ឡើង​វិញ"

#: kimstatusbargraphics.cpp:283
msgid "Collapse to panel"
msgstr "វេញ​​ទៅ​បន្ទះ"

#: kimstatusbargraphics.cpp:285
msgid "Embed into the panel"
msgstr "បង្កប់​ក្នុង​បន្ទះ"

#: main.cpp:29
