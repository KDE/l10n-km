#: kimpanelapplet.cpp:120
msgid "kimpanel"
msgstr "kimpanel"

#: kimpanelapplet.cpp:120
msgid "KDE Input Method Panel"
msgstr "បន្ទះ​យុទ្ធសាស្ត្រ​បញ្ចូល KDE"

#: kimstatusbargraphics.cpp:52
msgid "Icon Filter"
msgstr "តម្រង​រូបតំណាង"

#: kimstatusbargraphics.cpp:72 kimstatusbargraphics.cpp:289
