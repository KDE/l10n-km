#: ai.cpp:8
msgid "Occupied lines:"
msgstr "បន្ទាត់​ដែល​បាន​កាន់កាប់ ៖"

#: ai.cpp:10
msgid "Number of holes:"
msgstr "ចំនួន​រន្ធ ៖"

#: ai.cpp:12
msgid "Number of spaces:"
msgstr "ចំនួន​ចន្លោះ ៖"

#: ai.cpp:12
msgid "Number of spaces under mean height"
msgstr "ចំនួន​ចន្លោះ​នៅ​ពី​ក្រោម​កម្ពស់"

#: ai.cpp:14
msgid "Peak-to-peak distance:"
msgstr "ចម្ងាយ​ពី​កំពូល​ទៅ​កំពូល ៖"

#: ai.cpp:16
msgid "Mean height:"
msgstr "កម្ពស់​មធ្យម"

#: ai.cpp:18
msgid "Number of full lines:"
msgstr "ចំនួន​បន្ទាត់​ពេញ ៖"

#: field.cpp:17
msgid "Indicate the number of garbage lines you received from your opponent."
msgstr "បញ្ជាក់​ចំនួន​នៃ​បន្ទាត់​សំណល់ ដែល​អ្នក​ទទួល​បាន​ពី​គូរ​ប្រកួត"

#: field.cpp:45
msgid "Total:"
msgstr "សរុប ៖"

#: field.cpp:53
#, kde-format
msgid "1 Line:"
msgid_plural "%1 Lines:"
msgstr[0] "បន្ទាត់ %1 ៖"

#: main.cpp:73
msgid "KSirtet"
msgstr "KSirtet"

#: main.cpp:74
msgid "KSirtet is an adaptation of the well-known Tetris game"
msgstr "KSirtet គឺ​ជា​ការ​ធ្វើ​តាម​ល្បែង Tetris ដ៏​ល្បីល្បាញ"

#: main.cpp:76
msgid "Removed lines"
msgstr "បន្ទាត់​ដែល​បាន​យក​ចេញ"

#: piece.cpp:51
msgid "Z piece color:"
msgstr "ពណ៌​រាង​អក្សរ Z ៖"

#: piece.cpp:51
msgid "S piece color:"
msgstr "ពណ៌​រាង​អក្សរ S ៖"

#: piece.cpp:52
msgid "I piece color:"
msgstr "ពណ៌​រាង​អក្សរ I ៖"

#: piece.cpp:52
msgid "T piece color:"
msgstr "ពណ៌​រាង​អក្សរ T ៖"

#: piece.cpp:53
msgid "Square color:"
msgstr "ពណ៌​ការេ ៖"

#: piece.cpp:53
msgid "Mirrored L piece color:"
msgstr "ពណ៌​រាង​អក្សរ L បញ្ច្រាស់ ៖"

#: piece.cpp:54
msgid "L piece color:"
msgstr "ពណ៌​រាង​អក្សរ L ៖"

#: piece.cpp:54
msgid "Garbage block color:"
msgstr "ពណ៌​ដុំ​សំណល់ ៖"

