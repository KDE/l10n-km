#: knewthemedlg.cpp:31
msgid "New Theme"
msgstr "ស្បែកថ្មី"

#: kthememanager.cpp:62
msgid "KDE Theme Manager"
msgstr "កម្មវិធី​គ្រប់គ្រង​ស្បែក KDE"

#: kthememanager.cpp:63 kthememanager.cpp:69
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr "ម៉ូឌុល​បញ្ជា​នេះ​ដោះស្រាយ​រាល់​ការ​ដំឡើង យកចេញ និង​បង្កើតស្បែក KDE ដែល​មើល​ឃើញ ។"

#: kthememanager.cpp:65
msgid "(c) 2003, 2004 Lukáš Tinkl"
msgstr "រក្សា​សិទ្ធ​ឆ្នាំ ២០០៣-២០០៤ Lukáš Tinkl"

#: kthememanager.cpp:265
msgid "Theme Files"
msgstr "ឯកសារ​ស្បែក"

#: kthememanager.cpp:266
msgid "Select Theme File"
msgstr "ជ្រើស​ឯកសារ​ស្បែក"

#: kthememanager.cpp:300
#, kde-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​យក​ស្បែក <b>%1</b> ចេញ​ឬ?"

#: kthememanager.cpp:301
msgid "Remove Theme"
msgstr "យក​ស្បែក​ចេញ"

#: kthememanager.cpp:323
msgid "My Theme"
msgstr "ស្បែក​របស់​ខ្ញុំ"

#: kthememanager.cpp:334
#, kde-format
msgid "Theme %1 already exists."
msgstr "ស្បែក %1 មាន​រួច​ហើយ ។"

#: kthememanager.cpp:354
#, kde-format
msgctxt "%1 is theme archive name"
msgid "Your theme has been successfully created in %1."
msgstr "ស្បែក​របស់​អ្នក​បាន​បង្កើត​ដោយ​ជោគជ័យ​ក្នុង %1 ។"

#: kthememanager.cpp:355
msgid "Theme Created"
msgstr "ស្បែក​ត្រូវ​បាន​បង្កើត"

#: kthememanager.cpp:357
msgid "An error occurred while creating your theme."
msgstr "កំហុស​មួយ​បាន​កើត​ឡើង ខណៈ​ពេល​បង្កើត​ស្បែក​របស់​អ្នក ។"

#: kthememanager.cpp:358
msgid "Theme Not Created"
msgstr "ស្បែក​មិន​ត្រូវ​បាន​បង្កើត"

#: kthememanager.cpp:385
msgid "This theme does not contain a preview."
msgstr "ស្បែក​នេះ​មិន​មាន​ទិដ្ឋភាព​សម្រាប់​មើល​ជាមុន​ឡើយ ។"

#: kthememanager.cpp:389
#, kde-format
msgid "Author: %1<br />Email: %2<br />Version: %3<br />Homepage: %4"
msgstr "អ្នក​និពន្ធ ៖ %1<br />អ៊ីមែល ៖ %2<br />កំណែ ៖ %3<br />គេហ​ទំព័រ ៖ %4"

