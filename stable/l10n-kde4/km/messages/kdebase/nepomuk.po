#: services/strigi/systray.cpp:41 services/strigi/systray.cpp:44
#: services/strigi/systray.cpp:88
msgid "Search Service"
msgstr "ស្វែងរក​សេវា"

#: services/strigi/systray.cpp:46 services/strigi/systray.cpp:47
