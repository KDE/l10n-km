#: trackmouse_config.cpp:47
msgid "Hold Ctrl+Meta keys to see where the mouse cursor is."
msgstr "សង្កត់​គ្រាប់ចុច បញ្ជា​(Ctrl)​+មេតា ដើម្បីមើល​ទីតាំង​របស់​ទស្សន៍ទ្រនិច​កណ្ដុរ ។"

#: thumbnailaside.cpp:40 thumbnailaside_config.cpp:71
msgid "Toggle Thumbnail for Current Window"
msgstr "បិទបើក​រូបភាព​តូចៗសម្រាប់​បង្អួច​បច្ចុប្បន្ន"

#: desktopgrid_config.cpp:48
msgid "Animate desktop changes"
msgstr "ធ្វើ​ឲ្យ​ការ​ផ្លាស់ប្ដូរ​ផ្ទៃតុ​មាន​ចលនា"

#: sharpen_config.cpp:48 sharpen.cpp:40
msgid "Toggle Sharpen effect"
msgstr "បិទ/បើក​បែបផែន​ច្បាស់"

#: shadow_config.cpp:49
msgid "X offset:"
msgstr "អុហ្វសិត X ៖"

#: shadow_config.cpp:55
