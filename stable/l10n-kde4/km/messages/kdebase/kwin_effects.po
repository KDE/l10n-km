#: invert_config.cpp:48 invert.cpp:39
msgid "Toggle Invert effect"
msgstr "បិទ/បើក​បែបផែន​បញ្ច្រាស"

#: maketransparent_config.cpp:47
msgid "Changes opacity of following elements:"
msgstr "ផ្លាស់ប្ដូរ​ភាព​ស្រអាប់​របស់​ធាតុ​ដូច​ខាង​ក្រោម ៖"

#: maketransparent_config.cpp:49
msgid "Decorations:"
msgstr "ការ​តែង​លម្អ ៖"

#: maketransparent_config.cpp:56
msgid "Moved/resized windows:"
msgstr "បង្អួច​ដែល​បានផ្លាស់ទី/ផ្លាស់ប្ដូរ​ទំហំ ៖"

#: maketransparent_config.cpp:63
msgid "Dialogs:"
msgstr "ប្រអប់ ៖"

#: presentwindows_config.cpp:50
msgid "Activate when cursor is at a specific edge or corner of the screen:"
msgstr "ធ្វើ​ឲ្យ​សកម្ម នៅពេល​ដែល​ទស្សន៍ទ្រនិច​នៅ​ជ្រុង​ជាក់លាក់​របស់​អេក្រង់ ៖"

#: presentwindows_config.cpp:54
msgid "for windows on current desktop: "
msgstr "សម្រាប់​បង្អួច​នៅលើ​ផ្ទៃតុ​បច្ចុប្បន្ន ៖ "

#: presentwindows_config.cpp:60
msgid "for windows on all desktops: "
msgstr "សម្រាប់​បង្អួច​នៅលើ​ផ្ទៃតុ​ទាំងអស់ ៖ "

#: presentwindows_config.cpp:72 presentwindows.cpp:57
msgid "Toggle Expose Effect"
msgstr "បិទបើក​បែបផែន​បង្ហាញ"

#: presentwindows_config.cpp:75 presentwindows.cpp:61
msgid "Toggle Expose effect (incl other desktops)"
msgstr "បិទ/បើក​បែបផែន​មើល​ឃើញ (រួម​មាន​ផ្ទៃតុ​ផ្សេងៗ)"

