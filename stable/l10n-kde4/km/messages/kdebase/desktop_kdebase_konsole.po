#: data/profiles/Shell.profile:2
msgctxt "Name"
msgid "Shell"
msgstr "សែល"

#: data/profiles/Shell.profile:91
msgctxt "Comment"
msgid "Konsole default profile"
msgstr "ទម្រង់លំនាំដើម​របស់ Konsole"

#: desktop/konsole.desktop:9
msgctxt "Name"
msgid "Konsole"
msgstr "Konsole"

#: desktop/konsole.desktop:102
msgctxt "GenericName"
msgid "Terminal"
msgstr "ស្ថានីយ៍"

#: desktop/konsolehere.desktop:8
msgctxt "Name"
msgid "Open Terminal Here"
msgstr "បើក​ស្ថានីយ៍​នៅ​ទីនេះ"

#: desktop/konsole.notifyrc:3
msgctxt "Comment"
msgid "Konsole"
msgstr "Konsole"

#: desktop/konsole.notifyrc:95
msgctxt "Name"
msgid "Bell in Visible Session"
msgstr "ជូន​ដំណឹង​នៅ​ក្នុង​សម័យ​ដែល​មើល​ឃើញ"

#: desktop/konsole.notifyrc:176
msgctxt "Comment"
msgid "Bell emitted within a visible session"
msgstr "ជូន​ដំណឹង​ដែលបានលុប​នៅ​ក្នុង​សម័យ​ដែល​មើល​ឃើញ"

#: desktop/konsole.notifyrc:264
msgctxt "Name"
msgid "Bell in Non-Visible Session"
msgstr "ជូន​ដំណឹង​នៅ​ក្នុង​សម័យ​ដែល​មើល​មិន​ឃើញ"

#: desktop/konsole.notifyrc:345
msgctxt "Comment"
msgid "Bell emitted within a non-visible session"
msgstr "ជូន​ដំណឹង​ថា​បាន​លុប​នៅ​ក្នុង​សម័យ​ដែល​មើល​មិន​ឃើញ"

#: desktop/konsole.notifyrc:434
msgctxt "Name"
msgid "Activity in Monitored Session"
msgstr "សកម្មភាព​នៅ​ក្នុង​សម័យ​ដែល​បាន​ត្រួតពិនិត្យ"

#: desktop/konsole.notifyrc:514
msgctxt "Comment"
msgid "Activity detected in a monitored session"
msgstr "សកម្ម​ភាព​បាន​រកឃើញ​នៅ​ក្នុង​សម័យ​ដែល​បាន​ត្រួតពិនិត្យ"

#: desktop/konsole.notifyrc:602
msgctxt "Name"
msgid "Silence in Monitored Session"
msgstr "ស្ងាត់​នៅ​ក្នុង​សម័យ​ដែល​បាន​ត្រួតពិនិត្យ"

#: desktop/konsole.notifyrc:682
msgctxt "Comment"
msgid "Silence detected in a monitored session"
msgstr "ស្ងាត់​ដែលបានរកឃើញ​នៅ​ក្នុង​សម័យ​ដែល​បាន​ត្រួតពិនិត្យ"

#: desktop/konsole.notifyrc:769
msgctxt "Name"
msgid "Session Finished With Non-Zero Status"
msgstr "សម័យ​បាន​បញ្ចប់​ដោយ​មាន​ស្ថានភាព​មិន​សូន្យ"

#: desktop/konsole.notifyrc:852
msgctxt "Comment"
msgid "A session has exited with non-zero status"
msgstr "សម័យ​បាន​ចាកចេញ​ដោយ​មាន​ស្ថានភាព​​មិន​សូន្យ"

#: desktop/konsolepart.desktop:13 desktop/terminalemulator.desktop:5
msgctxt "Name"
msgid "Terminal Emulator"
msgstr "កម្មវិធី​ត្រាប់តាម​ស្ថានីយ៍"

#: desktop/quick-access-konsole.desktop:11
msgctxt "Name"
msgid "Quick Access Terminal"
msgstr "ចូល​ប្រើ​ស្ថានីយ៍​រហ័ស"

