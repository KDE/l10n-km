#: main.cpp:260
msgid "KCMInit - runs startups initialization for Control Modules."
msgstr "KCMInit - រត់​កា​រចាប់ផ្ដើម​ពេល​ចាប់ផ្ដើ​មឡើង​សម្រាប់​ម៉ូឌុល​ត្រួតពិនិត្យ ។"

#: main.cpp:265
msgid "List modules that are run at startup"
msgstr "រាយ​ម៉ូឌុល​ដែល​រត់​នៅ​ពេល​ចាប់ផ្ដើម"

#: main.cpp:266
msgid "Configuration module to run"
msgstr "ម៉ូឌុល​កំណត់​រចនាសម្ព័ន្ធ​ត្រូវ​រត់"

