#: kdialog.cpp:420 kdialog.cpp:532
msgid "Open"
msgstr "បើក​"

#: kdialog.cpp:461
msgid "Save As"
msgstr "រក្សា​ទុក​ជា"

#: kdialog.cpp:624
msgid "KDialog"
msgstr "KDialog"

#: kdialog.cpp:625
msgid "KDialog can be used to show nice dialog boxes from shell scripts"
msgstr "KDialog អាច​ត្រូវ​បាន​ប្រើ ដើម្បី​បង្ហាញ​ប្រអប់​ស្អាត​ពី​ស្គ្រីប​សែល"

#: kdialog.cpp:627
msgid "(C) 2000, Nick Thompson"
msgstr "រក្សា​សិទ្ធិ​ឆ្នាំ ២០០០ ដោយ​ Nick Thompson"

#: kdialog.cpp:628
msgid "David Faure"
msgstr "David Faure"

#: kdialog.cpp:628
msgid "Current maintainer"
msgstr "អ្នក​ថែទាំ​បច្ចុប្បន្ន"

#: kdialog.cpp:629
msgid "Brad Hards"
msgstr "Brad Hards"

#: kdialog.cpp:630
