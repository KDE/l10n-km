msgstr "មិន​ជ្រើស​ទាំងអស់"

#: main.cpp:98
msgid "KDebugDialog"
msgstr "KDebugDialog"

#: main.cpp:99
msgid "A dialog box for setting preferences for debug output"
msgstr "ប្រអប់​ដែល​ប្រើ​សម្រាប់​កំណត់​ចំណូល​ចិត្ត ទៅ​ឲ្យ​លទ្ធផល​បំបាត់​កំហុស"

