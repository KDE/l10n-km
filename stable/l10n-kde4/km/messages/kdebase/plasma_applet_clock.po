#: clock.cpp:140
msgctxt "@title:window"
msgid "Configure Clock"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​នាឡិកា"

#. i18n: tag string
#. i18n: file clockConfig.ui line 32
#: rc.cpp:3
msgid "Display the second hand"
msgstr "បង្ហាញ​ទ្រនិច​វិនាទី"

#. i18n: tag string
#. i18n: file clockConfig.ui line 35
#: rc.cpp:6
msgid ""
"Check this if you want to display the second hand in order to see the "
"seconds."
msgstr "គូស​ធីក​វា ប្រសិនបើ​អ្នក​ចង់​បង្ហាញ​ទ្រនិច​វិនាទី ដើម្បី​មើល​វិនាទី ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 38
#: rc.cpp:9
msgid "Display seconds"
msgstr "បង្ហាញ​វិនាទី"

#. i18n: tag string
#. i18n: file clockConfig.ui line 45
#: rc.cpp:12
msgid "Display the time as a string"
msgstr "បង្ហាញ​ពេលវេលា​ជា​ខ្សែងអក្សរ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 48
#: rc.cpp:15
msgid ""
"Check this if you want to display the time as a string within the clock."
msgstr "គូស​ធីក​ប្រសិន​បើ​អ្នក​ចង់​បង្ហាញ​ពេលវេលា​ជា​ខ្សែអក្សរ​នៅ​ក្នុង​នាឡិកា ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 51
#: rc.cpp:18
msgid "Also display the time in text"
msgstr "បង្ហាញ​ពេលវេលា​ជា​អត្ថបទ​ដែរ"
