#: main.cpp:40
msgid "winstartmenu"
msgstr "winstartmenu"

#: main.cpp:41
msgid "An application to create/update or remove Windows Start Menu entries"
msgstr "កម្មវិធី​ត្រូវ​បង្កើត/ធ្វើ​ឲ្យទាន់សម័យ ឬ​យក​ធាតុ​ម៉ឺនុយ​ចាប់ផ្ដើម​របស់​វីនដូ"

#: main.cpp:43
msgid "(C) 2008 Ralf Habacker"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ដោយ Ralf Habacker"

#: main.cpp:47
msgid "Remove installed Start Menu entries"
msgstr "យក​ធាតុ​ម៉ឺនុយ​ចាប់ផ្ដើម​ដែល​បាន​ដំឡើង"

#: main.cpp:48
msgid ""
"Install Start Menu entries (this is also the default when this option is not "
"used)"
msgstr "ដំឡើង​ធាតុ​ម៉ឺនុយចាប់ផ្ដើម (នេះ​ក៏​ជា​លំនាំដើម​ នៅពេល​ជម្រើស​នេះ​មិន​ត្រូវ​បានប្រើ)"

