#: solid-network.cpp:53
msgid "solid-network"
msgstr "បណ្ដាញ​មិន​ប្រែប្រួល"

#: solid-network.cpp:55
msgid ""
"KDE tool for querying and controlling your network interfaces from the "
"command line"
msgstr "ឧបករណ៍ KDE សម្រាប់​សួរ និង​​ត្រួតពិនិត្យ​ចំណុច​ប្រទាក់​បណ្ដាញ​​របស់​អ្នក​ពី​បន្ទាត់​ពាក្យ​បញ្ជា"

#: solid-network.cpp:365
msgid "Syntax Error: Not enough arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ គ្មាន​អាគុយម៉ង់​គ្រប់គ្រាន់"

#: solid-network.cpp:371
msgid "Syntax Error: Too many arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ អាគុយម៉ង់​ច្រើន​ពេក"

#: solid-network.cpp:383
msgid "Show available commands by domains"
msgstr "បង្ហាញ​ពាក្យ​បញ្ជា​ដែលអាច​ប្រើ​បាន​ដោយ​ដែន"

#: solid-network.cpp:385
msgid "Command (see --commands)"
msgstr "ពាក្យបញ្ជា (សូម​មើល --commands)"

#: solid-network.cpp:387
msgid "Arguments for command"
msgstr "អាគុយម៉ង់​សម្រាប់​ពាក្យ​បញ្ជា"

#: solid-network.cpp:399
msgid "Syntax:"
msgstr "វាក្យសម្ពន្ធ ៖"

#: solid-network.cpp:402
msgid "             # List the network devices present.\n"
msgstr "             # រាយ​ឧបករណ៍​បណ្ដាញ​ដែលមាន ។\n"

#: solid-network.cpp:405
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr "             # រាយ​បណ្ដាញ​ដែល​បាន​ស្គាល់​ទៅ​ជា​ឧបករណ៍​ដែលបាន​បញ្ជាក់​ដោយ 'uni' ។\n"

#: solid-network.cpp:408
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'wireless-hardware' option is given,\n"
"             #  return whether the wireless hardware is enabled\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # សួរ​ថាតើ​លក្ខណៈពិសេស​បណ្ដាញ​សកម្ម ឬ​អត់ ។\n"
"             # - ប្រសិនបើ​ជម្រើស 'ស្ថានភាព' ត្រូវ​បានផ្ដល់ ត្រឡប់ថាតើ\n"
"             # បណ្ដាញ​ត្រូវ​បានបើក​សម្រាប់​ប្រព័ន្ធ​ឬ​ក៏​អត់\n"
"             # - ប្រសិន​បើ​ជម្រើស 'ឥតខ្សែ' ត្រូវ​បាន​ផ្ដល់ ត្រឡប់​ថាតើ\n"
"             # ឥតខ្សែ​ត្រូវ​បាន​បើក​សម្រាប់​ប្រព័ន្ធ\n"
"             # - ប្រសិនបើ​ជម្រើស 'ផ្នែករឹង​ឥតខ្សែ' ត្រូវ​បានផ្ដល់\n"
"             #  ត្រឡប់​ថាតើ​ផ្នែក​រឹង​ឥតខ្សែ​ត្រូវ​បានបើក\n"
"             # - ប្រសិន​បើ​ជម្រើស 'ចំណុច​ប្រទាក់' ត្រូវ​បានផ្ដល់ បោះពុម្ព\n"
"             # លក្ខណសម្បត្តិ​របស់​ចំណុច​ប្រទាក់​បណ្ដាញ​ដែល 'uni' សំអាង​លើ ។\n"
"             # - ប្រសិន​បើ​ជម្រើស 'បណ្ដាញ' ត្រូវ​បានផ្ដល់ បោះពុម្ព\n"
"             # លក្ខណសម្បត្តិ​របស់​បណ្ដាញ​នៅលើ 'device-uni' ដែល 'network-uni' សំអាង​"
"លើ ។\n"

#: solid-network.cpp:421 solid-network.cpp:424
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # អនុញ្ញាត ឬ​មិនអនុញ្ញាត​ការ​តបណ្ដាញ​លើ​ប្រព័ន្ធ​នេះ ។\n"

#: solid-network.cpp:427
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)\n"
"             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # ធ្វើ​ឲ្យ​បណ្ដាញ 'network-uni' សកម្ម​នៅលើ 'device-uni' ។\n"
"             # ស្រេចចិត្ត ដោយប្រើ ១២៨ ការ​អ៊ិនគ្រីប​ប្រព័ន្ធ​ទូទៅ មាន​គ្រាប់ចុច​គោល ៦ 'key' ។ "
"()\n"
"             # កន្លែង​ដែល 'ការផ្ទៀងផ្ទាត់​ភាពត្រឹមត្រូវ' គឺ ៖\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"

