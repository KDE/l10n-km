#: solid-bluetooth.cpp:51
msgid "solid-bluetooth"
msgstr "ប៊្លូធូស​​មិន​ប្រែប្រួល"

#: solid-bluetooth.cpp:53
msgid "KDE tool for querying and controlling your hardware from the command line"
msgstr "ឧបករណ៍ KDE សម្រាប់​សួរ និង​​ត្រួតពិនិត្យ​ថាសរឹង​របស់​អ្នក​ពី​បន្ទាត់​ពាក្យ​បញ្ជា"

#: solid-bluetooth.cpp:165
msgid "Syntax Error: Not enough arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ គ្មាន​អាគុយម៉ង់​គ្រប់គ្រាន់"

#: solid-bluetooth.cpp:171
msgid "Syntax Error: Too many arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ អាគុយម៉ង់​ច្រើន​ពេក"

#: solid-bluetooth.cpp:183
msgid "Show available commands by domains"
msgstr "បង្ហាញ​ពាក្យ​បញ្ជា​ដែលអាច​ប្រើ​បាន​ដោយ​ដែន"

#: solid-bluetooth.cpp:185
msgid "Command (see --commands)"
msgstr "ពាក្យបញ្ជា (សូម​មើល --commands)"

#: solid-bluetooth.cpp:187
msgid "Arguments for command"
msgstr "អាគុយម៉ង់​សម្រាប់​ពាក្យ​បញ្ជា"

#: solid-bluetooth.cpp:199
msgid "Syntax:"
msgstr "វាក្យសម្ពន្ធ ៖"

#: solid-bluetooth.cpp:202
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # រាយ​ចំណុចប្រទាក់​/អាដាប់ទ័រ​ប្ល៊ូធូស\n"

#: solid-bluetooth.cpp:205
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # រាយ​ចំណុចប្រទាក់/អាដាប់ទ័រ​​លំនាំដើម​របស់​ប្ល៊ូធូស\n"

#: solid-bluetooth.cpp:208
msgid "             # Request to create a remote bluetooth device on the bus\n"
msgstr "             # សំណើ​ដើម្បី​បង្កើត​ឧបករណ៍​ប៊្លូធូស​ពី​ចម្ងាយ​នៅ​លើខ្សែ​បញ្ជូន\n"

#: solid-bluetooth.cpp:211
msgid "             # Request to remove the remote bluetooth device from the bus\n"
msgstr "             # សំណើ​ដើម្បី​យក​ឧបករណ៍​ប្ល៊ូធូស​ពី​ចម្ងាយ​ពីខ្សែបញ្ជូន\n"

#: solid-bluetooth.cpp:214
msgid "             # Request the properties from the bluetooth adapter\n"
msgstr "             # សំណើ​លក្ខណសម្បត្តិ​​ពី​អាដាប់ទ័រ​ប៊្លូធូស\n"

#: solid-bluetooth.cpp:406
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ មិន​ស្គាល់​ពាក្យ​បញ្ជា '%1'"

#: solid-bluetooth.cpp:614
msgid "Error: unsupported operation."
msgstr "កំហុស ៖ ប្រតិបត្តិការ​ដែល​មិន​បាន​គាំទ្រ !"

#: solid-bluetooth.cpp:625 solid-bluetooth.cpp:676
#, kde-format
msgid "Error: %1"
msgstr "កំហុស ៖ %1"

#: solid-bluetooth.cpp:722
#, kde-format
msgid "Progress: %1%"
msgstr "វឌ្ឍនភាព ៖ %1%"

#: solid-bluetooth.cpp:727
#, kde-format
msgid "Info: %1"
msgstr "ព័ត៌មាន ៖ %1"

