#: solid-powermanagement.cpp:48
msgid "solid-powermanagement"
msgstr "កា​រគ្រប់គ្រង​ថាមពល​មិន​ប្រែប្រួល"

#: solid-powermanagement.cpp:50
msgid ""
"KDE tool for querying and controlling your power management options from the "
"command line"
msgstr ""
"ឧបករណ៍ KDE សម្រាប់​សួរ និង​​ត្រួតពិនិត្យ​ជម្រើស​គ្រប់គ្រង​ថាមពល​របស់​អ្នក​ពី​បន្ទាត់​ពាក្យ​បញ្ជាត់​ពាក្យ​បញ្ជា"

#: solid-powermanagement.cpp:162
msgid "Syntax Error: Not enough arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ គ្មាន​អាគុយម៉ង់​គ្រប់គ្រាន់"

#: solid-powermanagement.cpp:168
msgid "Syntax Error: Too many arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ អាគុយម៉ង់​ច្រើន​ពេក"

#: solid-powermanagement.cpp:180
msgid "Show available commands"
msgstr "បង្ហាញ​ពាក្យ​បញ្ជា​ដែល​អាច​ប្រើ​បាន"

#: solid-powermanagement.cpp:182
msgid "Command (see --commands)"
msgstr "ពាក្យបញ្ជា (សូម​មើល --commands)"

#: solid-powermanagement.cpp:184
msgid "Arguments for command"
msgstr "អាគុយម៉ង់​សម្រាប់​ពាក្យ​បញ្ជា"

#: solid-powermanagement.cpp:196
msgid "Syntax:"
msgstr "វាក្យសម្ពន្ធ ៖"

#: solid-powermanagement.cpp:199
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # methods supported by the system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policies\n"
msgstr ""
"             # រាយ​សំណុំ​ជាក់លាក់​របស់​ព័ត៌មាន​ទាក់ទង​នឹង​ការ​គ្រប់គ្រង​ថាមពល ។\n"
"             # - ប្រសិន​បើ​ជម្រើស 'ផ្អាក' ត្រូវ​បាន​បញ្ជាក់ ផ្ដល់​បញ្ជី​​កា​រផ្អាក\n"
"             # វិធីសាស្ត្រ​បានគាំទ្រ​ដោយ​ប្រព័ន្ធ\n"
"             # - ប្រសិន​បើ​ជម្រើស 'គោងការណ៍' ត្រូវ​បាន​បញ្ជាក់ ផ្ដល់​នូវ​បញ្ជី\n"
"             # គ្រោងការណ៍​គ្រប់គ្រង​ថាមពល​ដែល​បានគាំទ្រដោយ​ប្រព័ន្ធ​នេះ\n"
"             # - ប្រសិនបើ​ជម្រើស 'cpufreq' ត្រូវ​បាន​បញ្ជាក់ ផ្ដល់​នូវ​បញ្ជី\n"
"             # គោលនយោបាយ​ប្រេកង់​ស៊ីភីយូ​ដែល​បាន​គាំទ្រ\n"

#: solid-powermanagement.cpp:206
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # កំណត់​ជម្រើស​គ្រប់គ្រង​ថាមពល​របស់​ប្រព័ន្ធ ។\n"
"             # - ប្រសិន​បើ​បាន​បញ្ជាក់​ជម្រើស 'cpufreq' គោលនយោបាយ​ហ្វ្រេកង់​ស៊ីភីយូ\n"
"             # កំណត់​អ្វី​ដែលទាក់ទង​ទៅនឹង 'តម្លៃ'\n"

#: solid-powermanagement.cpp:211
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # ផ្អាក​កុំព្យូទ័រ​ដោយប្រើ 'វិធីសាស្ដ្រ​' ដែលបាន​ផ្ដល់ ។\n"

#: solid-powermanagement.cpp:214
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # កំណត់ និង​យក​ជម្រើស​ពន្លឺ​របស់​ប្រព័ន្ធ ។\n"
"             # - ប្រសិន​បើ​បាន​បញ្ជាក់​ជម្រើស 'កំណត់' នោះ​ពន្លឺ​គឺ​ត្រូវបាន​កំណត់\n"
"             # ទៅ 'តម្លៃ' (ជា​ភាគរយ)\n"
"             # - ប្រសិន​បើ​បាន​បញ្ជាក់​ជម្រើស 'យក' នោះ​ពន្លឺ​បច្ចុប្បន្ន\n"
"             # នឹង​ត្រូវបាន​ត្រឡប់ (ជា​ភាគរយ)'\n"

#: solid-powermanagement.cpp:261 solid-powermanagement.cpp:276
#, kde-format
msgid "Syntax Error: Unknown option '%1'"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ មិន​​ស្គាល់​ជម្រើស '%1'"

#: solid-powermanagement.cpp:293
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ មិន​ស្គាល់​ពាក្យ​បញ្ជា '%1'"

#: solid-powermanagement.cpp:342
#, kde-format
msgid "Unsupported suspend method: %1"
msgstr "វិធីសាស្ត្រ​ផ្អាក​ដែល​មិន​បានគាំទ្រ ៖ %1"

#: solid-powermanagement.cpp:350
msgid "Error: unsupported operation."
msgstr "កំហុស ៖ ប្រតិបត្តិការ​ដែល​មិន​បាន​គាំទ្រ !"

#: solid-powermanagement.cpp:361
#, kde-format
msgid "Error: %1"
msgstr "កំហុស ៖ %1"

#: solid-powermanagement.cpp:450
#, kde-format
msgid "Unsupported cpufreq policy: %1"
msgstr "គោលនយោបាយ​ cpufreq ដែល​មិន​បាន​គាំទ្រ ៖ %1"

#: solid-powermanagement.cpp:481
#, kde-format
msgid "Progress: %1%"
msgstr "វឌ្ឍនភាព ៖ %1%"

#: solid-powermanagement.cpp:486
#, kde-format
msgid "Info: %1"
msgstr "ព័ត៌មាន ៖ %1"
