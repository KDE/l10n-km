#: appletbrowser.cpp:96
msgid "All Widgets"
msgstr "ធាតុក្រាហ្វិក​ទាំង​អស់"

#: appletbrowser.cpp:115 appletbrowser.cpp:119
#, kde-format
msgctxt ""
"%1 is the entity (person, staff, organization...) which recommends the widget"
msgid "Recommended by %1"
msgstr "បានផ្ដល់​អនុសាសន៏​ដោយ %1"

#: appletbrowser.cpp:125
msgid "My Favorite Widgets"
msgstr "ធាតុក្រាហ្វិក​សំណព្វ​របស់​ខ្ញុំ"

#: appletbrowser.cpp:128 appletbrowser.cpp:164
msgid "Widgets I Have Used Before"
msgstr "ធាតុក្រាហ្វិក​ដែលខ្ញុំ​បានប្រើ​ពី​មុន"

#: appletbrowser.cpp:131
msgid "Currently Running Widgets"
msgstr "ធាតុក្រាហ្វិក​ដែលកំពុង​រត់​បច្ចុប្បន្ន"

#: appletbrowser.cpp:135
msgid "Categories:"
msgstr "ប្រភេទ ៖ "

#: appletbrowser.cpp:447
msgid "Download New Plasma Widgets"
msgstr "ទាញយក​ធាតុក្រាហ្វិក​ប្លាស្មា​ថ្មី"

#: appletbrowser.cpp:459
#, kde-format
msgctxt ""
"%1 is a type of widgets, as defined by e.g. some plasma-packagestructure-*."
"desktop files"
msgid "Download New %1"
msgstr "ទាញយក %1 ថ្មី"

#: appletbrowser.cpp:469
msgid "Install Widget From Local File..."
msgstr "ដំឡើង​ធាតុក្រាហ្វិក​ពី​ឯកសារ​មូលដ្ឋាន..."

#: appletbrowser.cpp:480
msgid "Widgets"
msgstr "ធាតុក្រាហ្វិក"

#: appletbrowser.cpp:484
msgid "Add Widget"
msgstr "បន្ថែម​ធាតុក្រាហ្វិក"

#: appletbrowser.cpp:485
msgid "Install New Widgets"
msgstr "ដំឡើង​ធាតុក្រាហ្វិក​ថ្មី"

#: appletbrowser.cpp:487
msgid "Get New Widgets"
msgstr "យក​ធាតុក្រាហ្វិក​ថ្មី"

#: appletbrowser.cpp:491
msgid "Close the dialog"
msgstr "បិទ​ប្រអប់"

#: appletbrowser.cpp:492
msgid ""
"<qt>When clicking <b>Close</b>, this dialog will be closed with no further "
"action taken.</qt>"
msgstr "<qt>នៅ​ពេល​ចុច <b>បិទ</b> ប្រអប់​នេះ​នឹង​ត្រូវ​បា​បិទ​ដោយ​គ្មាន​សកម្មភាព​ទៀតទេ ។</qt>"

#: appletbrowser.cpp:493
msgid "Add selected widgets"
msgstr "បន្ថែម​ធាតុក្រាហ្វិក​ដែល​បានជ្រើស"

#: appletbrowser.cpp:494
msgid ""
"<qt>When clicking <b>Add Widget</b>, the selected widgets will be added to "
"your desktop.</qt>"
msgstr ""
"<qt>នៅ​ពេល​ចុច <b>បន្ថែម​ធាតុក្រាហ្វិក</b> ធាតុក្រាហ្វិក​ដែលបានជ្រើស​នឹង​ត្រូវ​បាន​បន្ថែម​ទៅ​ផ្ទៃតុ​របស់​"
"អ្នក ។</qt>"

#: appletbrowser.cpp:495
msgid "Install new widgets"
msgstr "ដំឡើង​ធាតុក្រាហ្វិក​ថ្មី"

#: appletbrowser.cpp:496
msgid ""
"<qt>Selecting <b>Get New Widgets</b> will show a window that allows you to "
"download new widgets directly from the Internet, while Install From File "
"allows you to add new widgets from files you have on disk.</qt>"
msgstr ""
"<qt>ជ្រើស <b>យក​ធាតុក្រាហ្វិក​ថ្មី</b> នឹង​បង្ហាញ​បង្អួច​ដែល​អនុញ្ញាត​ឲ្យអ្នក​ទាញយក​ធាតុក្រាហ្វិក​ថ្មី​ដោយ​"
"ផ្ទាល់​ពី​អ៊ីនធឺណិត ខណៈពេល​ដែល​ការ​ដំឡើង​ពី​ឯកសារ​អនុញ្ញាត​ឲ្យ​អ្នក​បន្ថែម​ធាតុក្រាហ្វិក​ថ្មី​ពី​ឯកសារ​ដែល​អ្នក​មាន​នៅ​"
"លើ​ថាស ។</qt>"

#: kcategorizeditemsview.cpp:38
msgid "Enter search phrase here"
msgstr "បញ្ជូល​ឃ្លាង​ស្វែង​រក​នៅ​ទីនេះ"

#: kcategorizeditemsviewmodels.cpp:72
msgid "Filters"
msgstr "តម្រង"

#: openwidgetassistant.cpp:46
msgid "Select the type of widget to install from the list below."
msgstr "ជ្រើសប្រភេទ​ធាតុក្រាហ្វិក​ដើម្បី​ដំឡើង​ពី​បញ្ជី​ខាងក្រោម ។"

#: openwidgetassistant.cpp:54
msgid "Plasmoid: Native plasma widget"
msgstr "ប្លាស្មយ ៖ ធាតុក្រាហ្វិក​ប្លាស្មា​សកម្ម"

#: openwidgetassistant.cpp:75
msgid "Install New Widget From File"
msgstr "ដំឡើង​ធាតុក្រាហ្វិក​ថ្មី​ពី​ឯកសារ"

#: openwidgetassistant.cpp:80
msgid "Select File"
msgstr "ជ្រើស​ឯកសារ"

#: openwidgetassistant.cpp:172
#, kde-format
msgid "Could not load the required installer %1. The error given was: %2"
msgstr "មិនអាច​ផ្ទុក​កម្មវិធី​ដំឡើង %1 ដែល​ត្រូវការ ។ កំហុស​បាន​ផ្ដល់​គឺ ៖ %2"

#: openwidgetassistant.cpp:175 openwidgetassistant.cpp:187
msgid "Installation Failure"
msgstr "ការ​ដំឡើង​បរាជ័យ"

#: openwidgetassistant.cpp:186
#, kde-format
msgid "Installing the package %1 failed."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ដំឡើង​កញ្ចប់ %1 ។"

