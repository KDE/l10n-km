#: misc/coordinate_system.cpp:327
msgid ""
"Enter coordinates in the following format: \"x;y\",\n"
"where x is the x coordinate, and y is the y coordinate."
msgstr ""
"បញ្ចូល​កូអរដោនេ​​ក្នុង​ទ្រង់ទ្រាយ​ដូច​ខាងក្រោម​ ៖  \"x;y\"\n"
"ដែល​ x ​ ជា​កូអរដោនេ​ x ​ ហើយ​  y ជា​កូអរដោនេ​នៃ​ y  ។​"

#: misc/coordinate_system.cpp:333
msgid ""
"Enter coordinates in the following format: <b>\"x;y\"</b>,<br />where x is "
"the x coordinate, and y is the y coordinate."
msgstr ""
"បញ្ចូល​កូអរដោនេ​នៅ​ក្នុង​ទ្រង់​ទ្រាយ​ដូច​ខាង​ក្រោម​ ៖ <b>\"x;y\"</b><br />ដែល​ x គឺ​ជា​កូអរដោនេ​ x "
"ហើយ​ y គឺ​ជា​កូអរដោនេ​ y ។"

#: misc/coordinate_system.cpp:375
msgid ""
"Enter coordinates in the following format: \"r; θ°\",\n"
"where r and θ are the polar coordinates."
msgstr ""
"បញ្ចូល​កូអរដោនេ​នៅ​ក្នុង​ទ្រង់​ទ្រាយ​ដូច​ខាង​ក្រោម​ ៖ \"r; θ°\"\n"
"ដែល​ r និង​ θ គឺ​ជា​កូអរដោនេ​ប៉ូលែ ។"

#: misc/coordinate_system.cpp:382
msgid ""
"Enter coordinates in the following format: <b>\"r; θ°\"</b>,<br />where r "
"and θ are the polar coordinates."
msgstr ""
"បញ្ចូល​កូអរដោនេ​នៅ​ក្នុង​ទ្រង់ទ្រាយ​ដូច​ខាងក្រោម​ ៖  <b>\"r; θ°\"</b> ដែល r នឹង  θ ជា​កូអរដោនេ​​"
"ប៉ូលែ​​ ។​"

