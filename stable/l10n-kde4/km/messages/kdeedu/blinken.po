#: blinken.cpp:780
msgid "Next sequence in 2, 1..."
msgstr "លំដាប់បន្ទាប់ពី ២, ១...."

#: blinken.cpp:785
msgid "Remember this sequence..."
msgstr "ចងចាំ​លំដាប់​នេះ..."

#: blinken.cpp:790
msgid "Repeat the sequence"
msgstr "ធ្វើ​លំដាប់​នេះ​ម្ដងទៀត"

