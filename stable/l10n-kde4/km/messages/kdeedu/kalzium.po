msgstr "តម្លៃ​នេះ​កំណត់​មាត្រដ្ឋាន​សីតុណ្ហភាព​ណា​មួយ​ដែល​នឹង​ត្រូវ​ប្រើ​នៅ​ក្នុង​ Kalzium"

#. i18n: file: src/kalzium.kcfg:251
#. i18n: ectx: whatsthis, entry (temperatureUnit), group (Units)
#. i18n: file: src/kalzium.kcfg:266
#. i18n: ectx: whatsthis, entry (combobox_temperature), group (Units)
#: rc.cpp:2096 rc.cpp:2114
msgid "Select the scale for the temperature"
msgstr "ជ្រើស​មាត្រដ្ឋាន​សម្រាប់​សីតុណ្ហភាព"

#. i18n: file: src/kalzium.kcfg:255
#. i18n: ectx: label, entry (lengthUnit), group (Units)
#. i18n: file: src/kalzium.kcfg:270
#. i18n: ectx: label, entry (combobox_length), group (Units)
#: rc.cpp:2099 rc.cpp:2117
msgid "This value defines which length scale should be used within Kalzium"
msgstr "តម្លៃ​នេះ​កំណត់​មាត្រដ្ឋាន​ប្រវែង​ណា​មួយ​ដែល​នឹង​ត្រូវ​ប្រើ​នៅ​ក្នុង​ Kalzium"

#. i18n: file: src/kalzium.kcfg:256
#. i18n: ectx: whatsthis, entry (lengthUnit), group (Units)
#. i18n: file: src/kalzium.kcfg:271
#. i18n: ectx: whatsthis, entry (combobox_length), group (Units)
#: rc.cpp:2102 rc.cpp:2120
msgid "Select the scale for the length"
msgstr "ជ្រើស​មាត្រដ្ឋាន​សម្រាប់​ប្រវែង"

#. i18n: file: src/kalzium.kcfg:275
#. i18n: ectx: label, entry (schemaSelected), group (Units)
#. i18n: file: src/kalzium.kcfg:276
#. i18n: ectx: whatsthis, entry (schemaSelected), group (Units)
#: rc.cpp:2123 rc.cpp:2126
msgid "True if schema was last selected"
msgstr "ពិត​ បើ​សិន​គ្រោង​ការណ៍​ត្រូវ​បាន​ជ្រើស​ជា​លើក​ចុងក្រោយ"

#. i18n: file: src/kalzium.kcfg:282
#. i18n: ectx: label, entry (spectrumWavelengthUnit), group (Spectrum)
#: rc.cpp:2129
msgid "This value defines which unit is used for the wavelength"
msgstr "តម្លៃ​នេះ​កំណត់​ខ្នាត​ណា​មួយ​ដែល​នឹង​ត្រូវ​ប្រើ​សម្រាប់​ជំហាន​រលក"

#. i18n: file: src/kalzium.kcfg:283
#. i18n: ectx: whatsthis, entry (spectrumWavelengthUnit), group (Spectrum)
#: rc.cpp:2132
msgid "Unit of the Wavelength"
msgstr "ខ្នាត​សម្រាប់​ជំហាន​រលក"

#. i18n: file: src/kalzium.kcfg:287
#. i18n: ectx: label, entry (spectrumType), group (Spectrum)
#: rc.cpp:2135
msgid ""
"This value defines which Spectrum type is used. Emission or absorption "
"spectrum"
msgstr "តម្លៃ​នេះ​កំណត់​ប្រភេទ​ស្ប៉ិច​ណា​មួយ​ដែល​នឹង​ត្រូវ​ប្រើ​ ។ ស្ប៉ិច​​ចេញ ឬ​ស្ប៉ិច​សំរូប"

#. i18n: file: src/kalzium.kcfg:288
#. i18n: ectx: whatsthis, entry (spectrumType), group (Spectrum)
#: rc.cpp:2138
msgid "SpectrumType"
msgstr "ប្រភេទ​ស្ប៉ិច"

#. i18n: file: src/kalzium.kcfg:294
#. i18n: ectx: label, entry (mass), group (Calculator)
#: rc.cpp:2141
msgid ""
"This setting tells the nuclear calculator whether the amounts are always in "
"terms of mass"
msgstr "ការ​កំណត់​នេះ​នឹង​ប្រាប់​ដល់​ម៉ាស៊ីន​គណនា​ ថា​តើ​បរិមាណ​នឹង​គិត​ជា​ម៉ាស​ជា​និច្ច​ដែរ​ឬ​ទេ"

#. i18n: file: src/kalzium.kcfg:295
#. i18n: ectx: whatsthis, entry (mass), group (Calculator)
#: rc.cpp:2144
msgid "True if the user wants to specify amount only in terms of mass"
msgstr "ពិត បើ​សិន​​ជា​អ្នក​ប្រើ​ចង់​បញ្ជាក់​បរិមាណ​គិត​ជា​ម៉ាស"

#. i18n: file: src/kalzium.kcfg:298
#. i18n: ectx: label, entry (ideal), group (Calculator)
#: rc.cpp:2147
msgid "This setting says whether the user wants the gas to be ideal by default"
msgstr "ការ​កំណត់​នេះ​និយាយ​ថា​តើ អ្នក​ចង់​ឲ្យ​ឧស្ម័ន​បរិសុទ្ធ​តាម​លំនាំ​ដើម​ដែរ​ឬ​ទេ"

#. i18n: file: src/kalzium.kcfg:299
#. i18n: ectx: whatsthis, entry (ideal), group (Calculator)
#: rc.cpp:2150
msgid ""
"True if gases are assumed to be ideal, the Van der Waals co-efficients will "
"not be shown in the calculator"
msgstr ""
"ពិត បើ​សិន​ ឧស្ម័ន​ត្រូវ​បាន​សន្មត​ថា បរិសុទ្ធ សហ​មេគុណ Van der Waals នឹង​មិន​ត្រូវ​បាន​បង្ហាញ​នៅ​ក្នុង​ម៉ាស៊ីន​"
"គណនា​ទេ"

#. i18n: file: src/kalzium.kcfg:303
#. i18n: ectx: label, entry (soluteMass), group (Calculator)
#: rc.cpp:2153
msgid ""
"This setting tells the concentration calculator that amount of solute is "
"always in mass"
msgstr "ការ​កំណត់​នេះ​ប្រាប់​ម៉ាស៊ីន​គណនា​កំហាប់​ថា បរិមាណ​នៃ​ធាតុ​រលាយ​ត្រូវ​បាន​គិត​ជា​ម៉ាស​ជានិច្ច"

#. i18n: file: src/kalzium.kcfg:304
#. i18n: ectx: whatsthis, entry (soluteMass), group (Calculator)
#: rc.cpp:2156
msgid "True if the amount of solute is specified only in terms of mass"
msgstr "ពិត បើ​សិន​បរិមាណ​នៃ​ធាតុ​រលាយ​ត្រូវ​បាន​បញ្ជាក់​ជា​ម៉ាស​ជានិច្ច"

#. i18n: file: src/kalzium.kcfg:307
#. i18n: ectx: label, entry (solventVolume), group (Calculator)
#: rc.cpp:2159
msgid ""
"This setting tells the concentration calculator that amount of solvent is "
"always in volume"
msgstr "ការ​កំណត់​នេះ​ប្រាប់​ម៉ាស៊ីន​គណនា​កំហាប់​ថា បរិមាណ​នៃ​ធាតុ​រំលាយ​ត្រូវ​បាន​គិត​ជា​មាឌ​ជានិច្ច"

#. i18n: file: src/kalzium.kcfg:308
#. i18n: ectx: whatsthis, entry (solventVolume), group (Calculator)
#: rc.cpp:2162
msgid "True if the amount of solvent is specified only in terms of volume"
msgstr "ពិត បើ​សិន​បរិមាណ​នៃ​ធាតុ​រំលាយ​ត្រូវ​បាន​បញ្ជាក់​ជា​មាឌ"

#. i18n: file: src/kalzium.kcfg:311
#. i18n: ectx: label, entry (alias), group (Calculator)
#: rc.cpp:2165
msgid ""
"This setting tells the molecular mass calculator whether extra details such "
"as aliases should be shown"
msgstr ""
"ការ​កំណត់​នេះ​ប្រាប់​ម៉ាស៊ីន​គណនា​ម៉ាស​ម៉ូលេគុល​ថា​តើ សេចក្ដី​លម្អិត​បន្ថែម​ ដូច​ជា​ ឈ្មោះ​តាង​ជា​ដើម គួរ​នឹង​ត្រូវ​បាន​"
"បង្ហាញ​ដែរ​ឬទេ"

#. i18n: file: src/kalzium.kcfg:312
#. i18n: ectx: whatsthis, entry (alias), group (Calculator)
#: rc.cpp:2168
msgid "True if the aliases and other details should be shown"
msgstr "ពិត បើសិន​ឈ្មោះតាង​ និង​ព័ត៌មាន​លម្អិត​ផ្សេង​ទៀត​ត្រូវ​បាន​បង្ហាញ"

#. i18n: file: src/kalzium.kcfg:315
#. i18n: ectx: label, entry (addAlias), group (Calculator)
#: rc.cpp:2171
msgid ""
"This setting tells the molecular calculator whether the add Alias tab should "
"be shown"
msgstr "ការកំណត់​នេះ​ប្រាប់​ម៉ាស៊ីន​គណនា​ម៉ូលេគុល​ ថា​តើ​ផ្ទាំង​បន្ថែម​ឈ្មោះ​​តាង​គួរ​តែ​ត្រូវ​បាន​​បង្ហាញ​ដែរ​ឬ​ទេ"

#. i18n: file: src/kalzium.kcfg:316
#. i18n: ectx: whatsthis, entry (addAlias), group (Calculator)
#: rc.cpp:2174
msgid "True if the user wants to add aliases"
msgstr "ពិត បើ​អ្នក​ប្រើ​ចង់​បន្ថែម​ឈ្មោះ​តាង"

#. i18n: file: src/kalzium.kcfg:321
#. i18n: ectx: label, entry (showsidebar), group (Sidebar)
#. i18n: file: src/kalzium.kcfg:322
#. i18n: ectx: whatsthis, entry (showsidebar), group (Sidebar)
#: rc.cpp:2177 rc.cpp:2180
msgid "Show or hide the sidebar"
msgstr "បង្ហាញ ឬ​លាក់​របារ​ចំហៀង"

#. i18n: file: data/knowledge.xml:4
#: rc.cpp:2182 src/kalziumgradienttype.cpp:454
msgid "State of matter"
msgstr "សភាព​រូបធាតុ"

#. i18n: file: data/knowledge.xml:5
#: rc.cpp:2184
msgid ""
"Form of a substance; dependant on form stability and whether it takes up a "
"definite volume: solid, liquid or gaseous."
msgstr ""
"សណ្ឋាន​សារធាតុ អាស្រ័យ​លើ​ស្ថិរភាព​សណ្ឋាន និង​ថា​តើ​​​វា​ត្រូវ​ការ​មាឌ​ជាក់លាក់​ដូចជា វត្ថុរឹ​ង វត្ថុរាវ ឬ​ឧស្ម័ន​"
"ដែរ​ឬ​ទេ ។"

#. i18n: file: data/knowledge.xml:7
#: rc.cpp:2186
msgid "Boiling point"
msgstr "ចំណុច​​រំពុះ"

#. i18n: file: data/knowledge.xml:8
#: rc.cpp:2188
msgid "Melting point"
msgstr "ចំណុច​រលាយ"

#. i18n: file: data/knowledge.xml:12
#: rc.cpp:2190
msgid "Chemical Symbol"
msgstr "និមិត្តសញ្ញា​គីមី"

#. i18n: file: data/knowledge.xml:13
#: rc.cpp:2192
msgid ""
"One, two, or three letter abbreviation; set through international convention."
msgstr "អក្សរ​កាត់​មួយ ពីរ ឬ​បី​ កំណត់​តាម​សម្មតិកម្ម​អន្តរជាតិ ។"

#. i18n: file: data/knowledge.xml:19
#: rc.cpp:2196
msgid "Chromatography"
msgstr "ក្រូម៉ាតូក្រាភី"

#. i18n: file: data/knowledge.xml:20
#: rc.cpp:2198
msgid ""
"Matter separation in a moving medium (mobile phase) through differentiated "
"absorption on a static medium (stationary phase)."
msgstr ""
"ការ​ញែក​រូប​ធាតុ​នៅ​ក្នុង​មជ្ឈដ្ឋាន​​ចល័ត​ (ផាស​​ចល័ត​) តាម​រយៈ​សំរូប​ខុស​ៗ​គ្នា​នៅ​លើ​មជ្ឈដ្ឋានថេរ (ផាស​អចល័ត​) ។"

#. i18n: file: data/knowledge.xml:23
#: rc.cpp:2200
msgid "Distillation"
msgstr "បំណិត"

#. i18n: file: data/knowledge.xml:24
#: rc.cpp:2202
msgid ""
"Separation of a liquid solution (homogeneous mix) into its components "
"through evaporation and condensation. In a fractionary distillation the "
"process is repeated several times in a column."
msgstr ""
"ការ​ញែក​សូលុយស្យុង​វត្ថុរាវ (ល្បាយ​ស្មើ​សាច់​) ទៅ​ជា​សមាស​ភាគ​តាម​រំហួត​ និង​កំណក​ ។ នៅ​ក្នុង​បំណិត​ប្រភាគ​ "
"ដំណើរការ​ត្រូវ​បាន​ធ្វើ​ឡើង​វិញ​បី​បួន​ដង​នៅ​ក្នុង​កូឡោន ។"

#. i18n: file: data/knowledge.xml:28
#: rc.cpp:2206
msgid ""
"Matter that cannot be broken down into simpler matter. Chemical elements are "
"cornerstones of Materials. Elements consist of atoms that consist of a "
"nucleus of positive protons, neutral neutrons, and a shell of electrons."
msgstr ""
"រូបធាតុ​ដែល​មិន​អាច​បំបែក​ជា​រូបធាតុ​ធម្មតា​បាន​ ។ ធាតុ​គីមី​គឺ​ជា​ស្នូល​សំខាន់​នៃ​រូបធាតុ​ ។ ធាតុ​​​មានអាតូមដែល​ផ្ទុក​"
"ណ្វៃយ៉ូ​ដែល​មាន​ប្រូតុង​វិជ្ជមាន ណឺត្រុង​ណឺត និង​ស្រទាប់​អេឡិចត្រុង ។​"

#. i18n: file: data/knowledge.xml:31
#: rc.cpp:2208
msgid "Emulsion"
msgstr "អេមុលស្យុង"

#. i18n: file: data/knowledge.xml:32
#: rc.cpp:2210
msgid "Heterogeneous mix of two liquids."
msgstr "ល្បាយ​មិន​ស្មើ​សាច់​នៃ​វត្ថុ​រាវ​ពីរ ។"

#. i18n: file: data/knowledge.xml:35
#: rc.cpp:2212
msgid "Extraction"
msgstr "យោបក"

#. i18n: file: data/knowledge.xml:36
#: rc.cpp:2214
msgid "Processing a homogeneous or heterogeneous mix to get pure matter."
msgstr "ដំណើរការ​ញែក​ល្បាយ​ស្មើ​សាច់ ឬ​ល្បាយ​មិន​ស្មើ​សាច់​ដើម្បី​ទទួល​​បាន​រូប​ធាតុ​សុទ្ធ ។"

#. i18n: file: data/knowledge.xml:38
#. i18n: file: data/knowledge.xml:46
#: rc.cpp:2216 rc.cpp:2222
msgid "Mix"
msgstr "ល្បាយ"

#. i18n: file: data/knowledge.xml:42
#: rc.cpp:2218
msgid "Filtering"
msgstr "ចំរោះ"

#. i18n: file: data/knowledge.xml:43
#: rc.cpp:2220
msgid ""
"Separation of a solid matter from a liquid matter or gaseous matter with a "
"filter (porous separation wall)."
msgstr ""
"ការ​ញែក​រូបធាតុ​រឹង​ចេញ​ពី​រូបធាតុ​រាវ​ ឬ​រូបធាតុ​ឧស្ម័ន​ដោយ​ប្រើ​តម្រង​ (ផ្ទៃ​សម្រាប់​ញែក​មាន​រន្ធ​តូច​ៗ​) ។"

#. i18n: file: data/knowledge.xml:47
#: rc.cpp:2224
msgid ""
"Matter consisting of differentiated matter, combined in non-set ratios. [i]"
"Homogeneous mixes[/i] have a coherent look, [i]heterogeneous mixes[/i] "
"consist of multiple phases."
msgstr ""
"រូបធាតុ​​មាន​រូបធាតុ​ខុស​ៗ​គ្នា​ ដែល​ផ្សំ​នៅ​ក្នុង​ផល​ធៀប​មិន​កំណត់​​ ។ [i]ល្បាយ​ស្មើ​សាច់​[/i] មាន​លក្ខណៈ​ច្បាស់​លាស់​ "
"[i]ល្បាយ​មិន​ស្មើ​សាច់​[/i] មាន​ផាសច្រើន ។"

#. i18n: file: data/knowledge.xml:50
#: rc.cpp:2226
msgid "Accuracy"
msgstr "ភាព​ជាក់​លាក់"

#. i18n: file: data/knowledge.xml:51
#: rc.cpp:2228
msgid "Consisting of accidental and systematic errors."
msgstr "មាន​កំហុស​ប្រព័ន្ធ និង​ឧប្បត្តិហេតុ ។​"

#. i18n: file: data/knowledge.xml:54
#: rc.cpp:2230
msgid "Law of Conservation of Mass"
msgstr "ច្បាប់​រក្សា​ម៉ាស"

#. i18n: file: data/knowledge.xml:55
#: rc.cpp:2232
msgid ""
"During a chemical reaction mass is neither lost nor gained. The sum mass of "
"the material going into the reaction equals the sum of the mass of the "
"products of the reaction."
msgstr ""
"នៅ​ពេល​មាន​ប្រតិកម្ម​គីមី ម៉ាស​គឺ​មិន​ខាត ឬ​ក៏​ចំណេញ​ដែរ​ ។ ម៉ាស​សរុប​នៃ​រូបធាតុ​ដែល​កំពុង​មាន​ប្រតិកម្ម​ស្មើ​នឹង​ផល​សរុប​"
"នៃ​ម៉ាស​​របស់​ផលិត​ផល​​​ប្រតិកម្ម ។"

#. i18n: file: data/knowledge.xml:58
#: rc.cpp:2234
msgid "Law of multiple proportions"
msgstr "ច្បាប់​សមាមាត្រ​ពហុគុណ"

#. i18n: file: data/knowledge.xml:59
#: rc.cpp:2236
msgid ""
"An alloy always contains the same elements in the same mass ratio. Should "
"two or more elements bind together then the mass ratio is constant."
msgstr ""
"សំលោហៈ​​មាន​ផ្ទុក​ធាតុ​ដូច​គ្នា​នៅ​ក្នុង​ផល​ធៀប​ម៉ាស​តែ​មួយ​ជានិច្ច ។​ ​ធាតុ​មួយ​ ឬ​ច្រើន​​​ចង​សម្ព័ន្ធ​គ្នា​ ពេល​នោះ​ផល​ធៀប​"
"ម៉ាស​នឹង​ថេរ ។"

#. i18n: file: data/knowledge.xml:62
#: rc.cpp:2238
msgid "Crystallization"
msgstr "កំណក​ក្រាម"

#. i18n: file: data/knowledge.xml:63
#: rc.cpp:2240
msgid ""
"Separation of solid, crystalline matter from a solution, or the liquid or "
"gaseous phases."
msgstr "ការ​ញែក​វត្ថុ​រឹង រូប​ធាតុ​ក្រាម​ចេញ​ពី​សូលុយស្យុង​ ឬ​ពី​ផាស​​រាវ ឬ​ពី​ផាស​ឧស្ម័ន ។"

#. i18n: file: data/knowledge.xml:66
#: rc.cpp:2242
msgid "Solution"
msgstr "សូលុយស្យុង"

#. i18n: file: data/knowledge.xml:67
#: rc.cpp:2244
msgid "Homogeneous mix of multiple pure materials"
msgstr "ល្បាយ​ស្មើ​សាច់​នៃ​រូបធាតុ​សុទ្ធ​ច្រើន"

#. i18n: file: data/knowledge.xml:71
#: rc.cpp:2248
msgid "Measurement of an amount of matter."
msgstr "ការ​វាស់​បរិមាណ​នៃ​រូបធាតុ ។"

#. i18n: file: data/knowledge.xml:74
#: rc.cpp:2250
msgid "Matter"
msgstr "រូបធាតុ​"

#. i18n: file: data/knowledge.xml:75
#: rc.cpp:2252
msgid "All that takes up space and has mass."
msgstr "ទាំង​អស់​ដែល​ត្រូវ​ការ​លំហរ និង​មាន​ម៉ាស ។"

#. i18n: file: data/knowledge.xml:78
#: rc.cpp:2254
msgid "Phase"
msgstr "ផាស"

#. i18n: file: data/knowledge.xml:79
#: rc.cpp:2256
msgid ""
"Through chemical composition and physical attributes, homogeneous portion of "
"matter that separated from its environment in its expansion through a "
"surface."
msgstr ""
"តាម​រយៈ​សមាស​ភាព​គីមី​ និង​គុណ​លក្ខណៈ​រូប​ ផ្នែក​នៃ​រូបធាតុ​មិន​ស្មើ​សាច់​បាន​ញែក​ពីបរិស្ថាននៅ​ក្នុង​ការ​ពង្រីក​របស់​វា​"
"តាម​រយៈផ្ទៃ ។"

#. i18n: file: data/knowledge.xml:82
#: rc.cpp:2258
msgid "Accuracy and precision"
msgstr "ភាព​ជាក់​លាក់ និង​ចំនួន​ខ្ទង់​"

#. i18n: file: data/knowledge.xml:83
#: rc.cpp:2260
msgid ""
"Expressed through standard deviation: Values given over accidental errors."
msgstr "បាន​បង្ហាញ​តាម​រយៈ​គម្លាត​ស្តង់ដារ ៖ តម្លៃ​ដែល​បាន​​ផ្ដល់​ឲ្យ​​កំហុស​ចៃដន្យ ។"

#. i18n: file: data/knowledge.xml:86
#: rc.cpp:2262
msgid "Correctness"
msgstr "ភាព​ត្រឹមត្រូវ​"

#. i18n: file: data/knowledge.xml:87
#: rc.cpp:2264
msgid "Values given over accidental errors."
msgstr "តម្លៃ​ដែល​បាន​ផ្ដល់​ឲ្យ​​​កំហុស​ចៃដន្យ ។"

#. i18n: file: data/knowledge.xml:90
#: rc.cpp:2266
msgid "SI-Unit"
msgstr "ខ្នាត SI"

#. i18n: file: data/knowledge.xml:91
#: rc.cpp:2268
msgid "Measurement unit using International Symbols."
msgstr "ខ្នាត​វាស់​ដែល​ប្រើ​និមិត្ត​សញ្ញា​អន្តរជាតិ ។"

#. i18n: file: data/knowledge.xml:94
#: rc.cpp:2270
msgid "Significant figures"
msgstr "លេខ​ក្រោម​ក្បៀស​ចាំ​បាច់"

#. i18n: file: data/knowledge.xml:95
#: rc.cpp:2272
msgid "The number of digits which are meaningful in a number."
msgstr "ចំនួន​តួ​លេខ​ដែល​មាន​ន័យ​គ្រប់​គ្រាន់​នៅ​ក្នុង​លេខ ។"

#. i18n: file: data/knowledge.xml:98
#: rc.cpp:2274
msgid "Standard deviation"
msgstr "គម្លាត​គំរូ"

#. i18n: file: data/knowledge.xml:99
#: rc.cpp:2276
msgid "An amount with which the precision of a measurement can be estimated."
msgstr "ចំនួន​ដែល​មាន​ខ្ទង់​រង្វាស់​ដែល​អាច​ប៉ាន់​ស្មាន​បាន ។"

#. i18n: file: data/knowledge.xml:102
#: rc.cpp:2278
msgid "Suspension"
msgstr "កករ​វិល​វល់​​"

#. i18n: file: data/knowledge.xml:103
#: rc.cpp:2280
msgid "Heterogeneous mix consisting of a liquid and solid matter."
msgstr "ល្បាយ​ស្មើ​សាច់​ដែល​មាន​រូបធាតុ​រឹង និង​រាវ ។"

#. i18n: file: data/knowledge.xml:106
#: rc.cpp:2282
msgid "Alloys"
msgstr "សំលោហៈ"

#. i18n: file: data/knowledge.xml:107
#: rc.cpp:2284
msgid "Pure matter consisting of multiple elements in a set ratio."
msgstr "រូប​ធាតុ​សុទ្ធ​ដែល​មាន​ធាតុ​ជាច្រើន​គិត​ជា​ផល​ធៀប​សំណុំ ។"

#. i18n: file: data/knowledge.xml:110
#: rc.cpp:2286
msgid "Alpha rays"
msgstr "កាំ​រស្មី​អាល់ហ្វា"

#. i18n: file: data/knowledge.xml:111
#: rc.cpp:2288
msgid ""
"Rays consisting of alpha particles, consisting of two protons and two "
"neutrons that are emitted from the Atoms of certain radioactive elements."
msgstr ""
"កាំ​រស្មី​​​មាន​ភាគ​ល្អិត​អាល់ហ្វា ដែល​ផ្ទុក​នូវ​ប្រូតុង​ពីរ​ និង​ណឺត្រុង​ពីរ​ ដែល​ត្រូវ​បាន​បញ្ចេញ​មក​ពី​អាតូម​នៃ​ធាតុ​វិទ្យុ​"
"សកម្ម​ណាមួយ​ ។"

#. i18n: file: data/knowledge.xml:114
#. i18n: file: data/knowledge.xml:127
#. i18n: file: data/knowledge.xml:134
#. i18n: file: data/knowledge.xml:142
#. i18n: file: data/knowledge.xml:219
#. i18n: file: data/knowledge.xml:226
#. i18n: file: data/knowledge.xml:235
#: rc.cpp:2290 rc.cpp:2306 rc.cpp:2312 rc.cpp:2320 rc.cpp:2397 rc.cpp:2403
#: rc.cpp:2413
msgid "Atom"
msgstr "អាតូម"

#. i18n: file: data/knowledge.xml:115
#: rc.cpp:2292
msgid ""
"Atoms are chemically inseparable and building blocks of matter. Atoms of one "
"kind are called an Element."
msgstr "អាតូម​គឺ​ជា​ប្លុក​នៃ​រូបធាតុ​ដែល​កកើត​ និង​មិន​អាច​ញែក​បាន​ ។ អាតូម​មួយ​ប្រភេទ​ត្រូវ​បាន​គេ​ហៅ​ថា ធាតុ ​។"

#. i18n: file: data/knowledge.xml:118
#. i18n: file: data/knowledge.xml:215
#. i18n: file: data/knowledge.xml:227
#. i18n: file: data/knowledge.xml:236
#. i18n: file: data/knowledge.xml:244
#: rc.cpp:2296 rc.cpp:2392 rc.cpp:2405 rc.cpp:2415 rc.cpp:2423
msgid "Electron"
msgstr "អេឡិចត្រុង"

#. i18n: file: data/knowledge.xml:119
#. i18n: file: data/knowledge.xml:223
#. i18n: file: data/knowledge.xml:237
#: rc.cpp:2298 rc.cpp:2399 rc.cpp:2417
msgid "Proton"
msgstr "ប្រូតុង"

#. i18n: file: data/knowledge.xml:120
#. i18n: file: data/knowledge.xml:228
#. i18n: file: data/knowledge.xml:232
#: rc.cpp:2300 rc.cpp:2407 rc.cpp:2409
msgid "Neutron"
msgstr "ណឺត្រុង"

#. i18n: file: data/knowledge.xml:124
#: rc.cpp:2302
msgid "Atomic nucleus"
msgstr "ណ្វៃយ៉ូអាតូម"

#. i18n: file: data/knowledge.xml:125
#: rc.cpp:2304
msgid ""
"The small, positively-charged center of an Atom, in which Protons and "
"Neutrons are found."
msgstr "មជ្ឈមណ្ឌល​របស់​អាតូម​​តូច​មួយ​ដែល​មាន​បន្ទុក​វិជ្ជមាន​ មាន​ប្រូតុង​ និង​ណឺត្រុង​នៅ​ក្នុង​នោះ​ ។​"

#. i18n: file: data/knowledge.xml:131
#: rc.cpp:2308 src/kalziumgradienttype.cpp:290 src/elementdataviewer.cpp:228
msgid "Atomic Mass"
msgstr "ម៉ាស​អាតូម"

#. i18n: file: data/knowledge.xml:132
#: rc.cpp:2310
msgid ""
"Mass of an atom, taken on a scale where the mass of a carbon atom is 12u. In "
"elements that consist of different isotopes the mid-range mass of the "
"isotope mix is given."
msgstr ""
"ម៉ាស​អាតូម​ ត្រូវ​ការ​មាត្រដ្ឋាន​ ដែល​មាន​ម៉ាស​នៃ​អាតូម​កាបូន​ស្មើ​នឹង 12u ។ ចំពោះ​ធាតុ​ដែល​មាន​អ៊ីសូតូប​ផ្សេង​​"
"គ្នា ម៉ាស​នៃ​ល្បាយ​អ៊ីសូតូប​ដែល​នៅ​ចន្លោះ​កណ្ដាល​​នឹង​ត្រូវ​បាន​ផ្ដល់​ ។"

#. i18n: file: data/knowledge.xml:139
#. i18n: file: data/knowledge.xml:149
#. i18n: file: data/knowledge.xml:156
#. i18n: file: data/knowledge.xml:163
#. i18n: file: data/knowledge.xml:170
#. i18n: file: data/knowledge.xml:177
#. i18n: file: data/knowledge.xml:187
#. i18n: file: data/knowledge.xml:196
#. i18n: file: data/knowledge.xml:205
#: rc.cpp:2316 rc.cpp:2326 rc.cpp:2332 rc.cpp:2338 rc.cpp:2344 rc.cpp:2350
#: rc.cpp:2362 rc.cpp:2372 rc.cpp:2382
msgid "Isotope"
msgstr "អ៊ីសូតូប"

#. i18n: file: data/knowledge.xml:140
#: rc.cpp:2318
msgid ""
"Isotopes are forms of a chemical element whose nuclei have the same atomic "
"number, Z, but different atomic masses, A. The word isotope, meaning at the "
"same place, comes from the fact that all isotopes of an element are located "
"at the same place on the periodic table."
msgstr ""
"អ៊ីសូតូប​ គឺ​ជា​ទម្រង់​នៃ​ធាតុ​គីមី​ដែល​ណ្វៃយ៉ូ​របស់​វា​មាន​លេខ​អាតូម និង​ Z ដូច​គ្នា ប៉ុន្តែ​មាន​ម៉ាស​អាតូម និង​ A ខុស​"
"គ្នា ។ ពាក្យ​ថា​ អ៊ីសូតូប មាន​ន័យ​ថា ស្ថិត​នៅ​ក្នុង​ទីតាំង​តែ​មួយ ពោល​គឺ​ថា អ៊ីសូតូប​នៃ​ធាតុ​ទាំង​អស់​មាន​ទីតាំង​ដូច​គ្នា​"
"នៅ​លើ​តារាង​ខួប​គីមី ។"

#. i18n: file: data/knowledge.xml:146
#: rc.cpp:2322
msgid "Spin"
msgstr "រង្វិល​ល្បឿន"

#. i18n: file: data/knowledge.xml:147
#: rc.cpp:2324
msgid ""
"The spin is an intrinsic angular momentum associated with microscopic "
"particles. It is a purely quantum mechanical phenomenon without any analogy "
"in classical mechanics. Whereas classical angular momentum arises from the "
"rotation of an extended object, spin is not associated with any rotating "
"internal masses, but is intrinsic to the particle itself."
msgstr ""
"រង្វិល​ល្បឿន គឺ​ជា​ម៉ូម៉ង់តូម​មុំ​ខាង​ក្នុង​ ដែល​មាន​ទំនាក់​ទំនង​នឹង​ភាគ​ល្អិត​មីក្រូស្កូពិច​ ។ វា​គឺ​ជា​បាតុភូត​មេកានិច​"
"កង់តូមសុទ្ធ​ដោយ​គ្មាន​ភាព​ស្រដៀង​គ្នា​ណា​មួយ​នៅ​ក្នុង​មេកានិច​បែប​បុរាណ​ទេ ។ ចំណែក​ម៉ូម៉ង់តូម​មុំ​បែប​បុរាណ​កើត​ឡើង​ពី​"
"ការ​បង្វិល​វត្ថុ​ដែល​បាន​បន្លាយ​ រង្វិល​ល្បឿន​មិន​មាន​ទំនាក់​ទំនង​ជាមួយ​នឹង​ម៉ាស​ខាង​ក្នុង​ដែល​បាន​បង្វិល​ទេ  ប៉ុន្តែ​"
"ម៉ាស​ខាង​ក្នុង​របស់​វា​មាន​ទំនាក់​ទំនង​ជា​មួយ​នឹង​ភាគ​ល្អិត​ផ្ទាល់ ។"

#. i18n: file: data/knowledge.xml:153
#: rc.cpp:2328 src/detailinfodlg.cpp:345
msgid "Magnetic Moment"
msgstr "ម៉ូម៉ង់​ម៉ាញេទិច"

#. i18n: file: data/knowledge.xml:154
#: rc.cpp:2330
msgid ""
"The magnetic moment of an object is a vector relating the aligning torque in "
"a magnetic field experienced by the object to the field vector itself. It is "
"measured in units of the nuclear magneton &#956;[sub]n[/sub]=(5.0507866 "
"&#177; 0.0000017) 10[sup]-27[/sup] JT[sup]-1[/sup]"
msgstr ""
"ម៉ូម៉ង់​ម៉ាញេទិច​នៃ​វត្ថុ​ គឺ​ជា​វ៉ិចទ័រ​ដែល​មាន​ទំនាក់​ទំនង​ជា​មួយ​នឹង​កម្លាំង​បង្វិល​ដែល​បាន​តម្រៀប​ជា​ជួរ​នៅ​ក្នុង​ដែន​"
"ម៉ាញេទិច​ដែល​បាន​ពិសោធន៍​ដោយ​វត្ថុ​ជាមួយ​នឹង​ដែន​​វ៉ិចទ័រ​​ផ្ទាល់​ ។ វា​ត្រូវ​បាន​គេ​វាស់​គិត​ជា​ខ្នាត​ម៉ាញេតុង​ណ្វៃយ៉ូ​ "
"&#956;[sub]n[/sub]=(5.0507866 &#177; 0.0000017) 10[sup]-27[/sup] JT[sup]-1[/"
"sup]"

#. i18n: file: data/knowledge.xml:160
#: rc.cpp:2334
msgid "Decay Mode"
msgstr "គំរូ​បំបែក"

#. i18n: file: data/knowledge.xml:161
#: rc.cpp:2336
msgid ""
"The decay mode describes a particular way a particle decays. For radioactive "
"decay (the decay of nuclides) the decay modes are:[br] -> alpha decay "
"(emission of a Helium-4 nucleus).[br] -> &#946;[sup]-[/sup] decay (emission "
"of an electron)[br] -> &#946;[sup]+[/sup] decay (emission of a positron) "
"[br] -> electron capture (EC) [br] -> proton emission [br] -> spontaneous "
"fission [br] Typically one decay mode predominates for a particular nuclide."
msgstr ""
"គំរូ​បំបែក​ពិពណ៌នា​អំពី​វិធីសាស្ត្រ​ពិសេស​ណា​មួយ​ក្នុង​ការ​បំបែក​ភាគ​ល្អិត​ ។ សម្រាប់​ការ​បំបែក​ធាតុ​វិទ្យុ​សកម្ម​ (ការ​"
"បំបែក​នុយគ្លីត​) គំរូ​បំបែក​គឺ​ ៖[br] -> ការ​បំបែក​អាល់ហ្វា​ (ការ​បញ្ចេញ​ណ្វៃយ៉ូ 4 ​អេល្យ៉ូម​) ។[br] -> ការ​"
"បំបែក​ &#946;[sup]-[/sup] (ការ​បញ្ចេញ​អេឡិចត្រុង​)[br] -> ការ​បំបែក &#946;[sup]+[/sup]  "
"(ការបញ្ចេញប៉ូស៊ីត្រុង​) [br] -> ការ​ចាប់​យក​អេឡិច​ត្រុង​ (EC) [br] -> ការ​បញ្ចេញ​ប្រូតុង​ [br] -> ការ​"
"បំបែក​ដោយ​ឯក​ឯង​ [br] ជា​ពិសេស​ គំរូ​បំបែក​មួយ​លុប​លើ​នុយគ្លីត​ពិសេស​មួយ​ ។"

#. i18n: file: data/knowledge.xml:167
#: rc.cpp:2340
msgid "Decay Energy"
msgstr "ថាមពល​បំបែក"

#. i18n: file: data/knowledge.xml:168
#: rc.cpp:2342
msgid "The decay energy is the energy released by a nuclear decay."
msgstr "ថាមពល​បំបែក​ គឺ​ជា​ថាមពល​ដែល​បញ្ចេញ​ដោយ​ការ​បំបែក​ណ្វៃយ៉ូ​ ។"

#. i18n: file: data/knowledge.xml:174
#: rc.cpp:2346
msgid "Nuclides"
msgstr "នុយគ្លីត"

#. i18n: file: data/knowledge.xml:175
#: rc.cpp:2348
msgid "[i]see isotopes[/i]"
msgstr "[i]សូម​មើល​អ៊ីសូតូប[/i]"

#. i18n: file: data/knowledge.xml:178
#. i18n: file: data/knowledge.xml:184
#. i18n: file: data/knowledge.xml:197
#. i18n: file: data/knowledge.xml:207
#: rc.cpp:2352 rc.cpp:2358 rc.cpp:2374 rc.cpp:2386
msgid "Isotone"
msgstr "អ៊ីសូតូន"

#. i18n: file: data/knowledge.xml:179
#. i18n: file: data/knowledge.xml:188
#. i18n: file: data/knowledge.xml:198
#. i18n: file: data/knowledge.xml:202
#: rc.cpp:2354 rc.cpp:2364 rc.cpp:2376 rc.cpp:2378
msgid "Nuclear Isomer"
msgstr "អ៊ីសូមែណ្វៃយ៉ូ"

#. i18n: file: data/knowledge.xml:180
#: rc.cpp:2356
msgid "Isobars"
msgstr "អ៊ីសូបា"

#. i18n: file: data/knowledge.xml:185
#: rc.cpp:2360
msgid "Two nuclides are isotones if they have the same number N of neutrons."
msgstr "នុយគ្លីត​ពីរ​នឹង​ជា​អ៊ីសូតូន បើ​សិន​ពួក​វា​មាន​ចំនួន​ណឺត្រុង​ N ដូច​គ្នា ។"

#. i18n: file: data/knowledge.xml:189
#. i18n: file: data/knowledge.xml:193
#. i18n: file: data/knowledge.xml:206
#: rc.cpp:2366 rc.cpp:2368 rc.cpp:2384
msgid "Isobar"
msgstr "អ៊ីសូបា"

#. i18n: file: data/knowledge.xml:194
#: rc.cpp:2370
msgid ""
"Isobars are nuclides having the same mass number, i.e. sum of protons plus "
"neutrons."
msgstr "អ៊ីសូបា​ គឺ​ជា​នុយគ្លីត​ដែល​មាន​ចំនួន​ម៉ាស​ដូច​គ្នា មាន​​ន័យ​ថា ផល​សរុប​នៃ​ប្រូតុង​បូក​នឹង​ណឺត្រុង ។"

#. i18n: file: data/knowledge.xml:203
#: rc.cpp:2380
msgid ""
"A nuclear isomer is a metastable or isomeric state of an atom caused by the "
"excitation of a proton or neutron in its nucleus so that it requires a "
"change in spin before it can release its extra energy. They decay to lower "
"energy states of the nuclide through two isomeric transitions:[br] -> "
"&#947;- emission (emission of a high-energy photon)[br] -> internal "
"conversion (the energy is used to ionize the atom)[br] Contrast this with "
"the definition of a chemical isomer, the more common use of the word. Also "
"contrast with the meaning of isotope, in which the difference is the number "
"of neutrons in the nucleus. Metastable isomers of a particular atom are "
"usually designated with an \"m\" (or, in the case of atoms with more than "
"one isomer, 2m, 3m, and so on). This designation is usually placed after the "
"atomic symbol and number of the atom (e.g., Co-58m), but is sometimes placed "
"as a superscript before (e.g., [sup]m[/sup]Co-58 or [sup]58m[/sup]Co)."
msgstr ""
"អ៊ីសូមែ​ណ្វៃយ៉ូ គឺ​​ជា​ភាព​មេតា​ស្ថិត​ស្ថិរ ឬ​ជា​ភាព​អ៊ីសូមែនៃ​អាតូម​ដែល​បង្ក​ដោយ​ការ​​រំញោច​នៃ​ប្រូតុង ឬ​ណឺត្រុង​នៅ​"
"ក្នុងណ្វៃយ៉ូ​ផ្ទាល់​ ដូច្នេះ​វា​តម្រូវ​ឲ្យ​មាន​ការ​ផ្លាស់​ប្ដូរ​ល្បឿន​រង្វិល​ មុន​ពេល​ដែល​វា​អាច​បញ្ចេញ​ថាមពល​បន្ថែម​ "
"។ ពួក​វា​បំបែក​ទៅ​ជា​ភាព​​នុយគ្លីត​ដែល​មាន​ថាមពល​ទាប​​​តាម​រយៈ​អន្តរភាព​អ៊ីសូមែ​ពីរ ៖[br] -> ការ​បញ្ចេញ "
"&#947;-  (ការ​បញ្ចេញ​ប្រូតុង​ដែល​មាន​ថាមពល​ខ្ពស់​)[br] -> ការ​បម្លែង​ខាង​ក្នុង​ (ថាមពល​ត្រូវ​បាន​ប្រើ​"
"ដើម្បី​ធ្វើ​អ៊ីយ៉ុង​កម្ម​អាតូម​)[br] ពាក្យ​ត្រូវ​បាន​គេ​ប្រើ​ប្រាស់​ទូទៅ​ ផ្ទុយ​ពី​និយម​ន័យ​នៃ​អ៊ីសូមែ​គីមី ។ ក៏​មាន​លក្ខណៈ​"
"ផ្ទុយ​គ្នា​ជា​មួយ​នឹង​អត្ថន័យ​អ៊ីសូតូប​ផង​ដែរ ដែល​ភាព​ខុស​គ្នា​នោះ​ គឺ​ចំនួន​ណឺត្រុង​នៅ​ក្នុង​ណ្វៃយ៉ូ​ ។ អ៊ីសូមែ​មេតាស្ថិតស្ថិរ​"
"នៃ​អាតូម​ពិសេស ជា​ទូទៅ​​ត្រូវ​បាន​កំណត់​ដោយ​អក្សរ​ \"m\" (ឬ នៅ​ក្នុង​ករណី​ដែល​​អាតូម​​មាន​អ៊ីសូមែ​​ ,2m, 3m "
"ជាដើម​ច្រើន​ជាង​មួយ​) ។ ជា​ទូទៅ​អក្សរ​នេះ ត្រូវ​បាន​គេ​ដាក់​នៅ​ពី​​ក្រោយ​និមិត្ត​សញ្ញា និង​លេខរបស់​​អាតូម (ឧ. "
"Co-58m) ប៉ុន្តែ ជួនកាល​ក៏​ត្រូវ​បាន​គេ​ដាក់​ជា​អក្សរ​តូច​លើ​ពី​មុខ​ផង​ដែរ (ឧ. [sup]m[/sup]Co-58 ឬ "
"[sup]58m[/sup]Co) ។"

#. i18n: file: data/knowledge.xml:211
#: rc.cpp:2388
msgid "Beta rays"
msgstr "កាំ​រស្មី​បែតា"

#. i18n: file: data/knowledge.xml:212
#: rc.cpp:2390
msgid ""
"Rays consisting of electrons that are emitted from Atoms of radioactive "
"elements."
msgstr "កាំ​រស្មី​មាន​អេឡិចត្រុង​ដែល​ត្រូវ​បាន​បញ្ចេញ​មក​ពី​អាតូម​នៃ​ធាតុ​វិទ្យុ​សកម្ម​ ។"

#. i18n: file: data/knowledge.xml:217
#: rc.cpp:2394
msgid ""
"The electron is a subatomic particle with a mass of m[sub]e[/sub]=(9.1093897 "
"&#177; 0.0000054)e-31 kg and a negative charge of [i]e[/i]=(1.60217733 "
"&#177; 0.00000049)e-19 C\n"
"\t\t"
msgstr ""
"អេឡិចត្រុង​ គឺ​ជា​ភាគ​ល្អិត​អាតូម​រង​ដែល​មាន​ម៉ាស​ m[sub]e[/sub]=(9.1093897 &#177; 0.0000054)"
"e-31 គីឡូក្រាម និង​បន្ទុក​អវិជ្ជមាន​ [i]e[/i]=(1.60217733 &#177; 0.00000049)e-19 C\n"
"\t\t"

#. i18n: file: data/knowledge.xml:224
#: rc.cpp:2401
msgid ""
"The proton is a subatomic particle with a mass of m[sub]e[/sub]=(1.6726231 "
"&#177; 0.0000010) 10[sup]-27[/sup] kg and a positive charge of [i]e[/i]="
"(1.60217733 &#177; 0.00000049) 10[sup]-19[/sup] C which occurs in the "
"nucleus of an atom."
msgstr ""
"ប្រូតុង គឺ​ជា​ភាគ​ល្អិត​អាតូម​រង​ដែល​មាន​ម៉ាស​ m[sub]e[/sub]=(1.6726231 &#177; 0.0000010) 10"
"[sup]-27[/sup] គីឡូក្រាម និង​បន្ទុក​វិជ្ជមាន​ [i]e[/i]=(1.60217733 &#177; 0.00000049) 10"
"[sup]-19[/sup] C ដែល​កើត​មាន​នៅ​ក្នុង​ណ្វៃយ៉ូ​របស់​អាតូម ។​"

#. i18n: file: data/knowledge.xml:233
#: rc.cpp:2411
msgid ""
"The neutron is a subatomic particle with a mass of m[sub]e[/sub]=(1.6749286 "
"&#177; 0.0000010) 10[sup]-27[/sup] kg which occurs in the nucleus of an atom."
msgstr ""
"ណឺត្រុង គឺ​ជា​ភាគ​ល្អិត​អាតូម​រង​ដែល​មាន​ម៉ាស​ m[sub]e[/sub]=(1.6749286 &#177; 0.0000010) 10"
"[sup]-27[/sup] គីឡូក្រាម​ដែល​កើត​មាន​នៅ​ក្នុង​ណ្វៃយ៉ូ​របស់​អាតូម ។"

#. i18n: file: data/knowledge.xml:241
#: rc.cpp:2419
msgid "Cathode Rays"
msgstr "កាំ​រស្មី​កាតូត"

#. i18n: file: data/knowledge.xml:242
#: rc.cpp:2421
msgid ""
"Cathode rays are streams of electrons observed in vacuum tubes, i.e. "
"evacuated glass tubes that are equipped with at least two electrodes, a "
"cathode (negative electrode) and an anode (positive electrode) in a "
"configuration known as a diode."
msgstr ""
"កាំ​រស្មី​កាតូត គឺ​ជា​ចរន្ត​អេឡិចត្រុង​ដែល​ត្រូវ​បាន​សង្កេត​នៅ​ក្នុង​បំពង់​សុញ្ញាកាស​ មាន​ន័យ​ថា​បំពង់​កែវ​ដែល​​គ្មាន​"
"ខ្យល់​ ​ត្រូវ​បាន​បំពាក់​ដោយ​អេឡិចត្រូត​យ៉ាង​ហោច​ណាស់​ពីរ​ គឺ​កាតូត​ (អេឡិចត្រូត​អវិជ្ជមាន​) និង​អាណូត​ (អេឡិចត្រូត​"
"វិជ្ជមាន​) នៅ​ក្នុង​រូបសណ្ឋាន​ដែល​គេ​ស្គាល់ថាជា​ ឌីអូដ ។"

#. i18n: file: data/knowledge.xml:248
#. i18n: file: data/knowledge.xml:262
#. i18n: file: data/knowledge.xml:271
#. i18n: file: data/knowledge.xml:279
#: rc.cpp:2425 rc.cpp:2443 rc.cpp:2453 rc.cpp:2461
msgid "Ionic Radius"
msgstr "កាំ​អ៊ីយ៉ុង"

#. i18n: file: data/knowledge.xml:249
#: rc.cpp:2427
msgid ""
"The Ionic Radius is the radius of a charged atom, known as an ion. The ion "
"can have a positive or a negative charge. The charge of the ion with the "
"radius shown is also displayed in Kalzium. A positive ion has fewer "
"electrons in its shell than the atom, a negative ion has more electrons. "
"Therefore, a positive ion has a smaller radius than its atom and vice versa."
msgstr ""
"កាំ​អ៊ីយ៉ុង គឺ​ជា​កាំ​នៃ​អាតូម​ដែល​មាន​បន្ទុក​ ត្រូវ​បាន​ហៅថា​ អ៊ីយ៉ុង ។ អ៊ីយ៉ុង​អាច​មាន​ទាំង​បន្ទុក​វិជ្ជមាន និង​"
"អវិជ្ជមាន​ ។ បន្ទុក​អ៊ីយ៉ុង​ដែល​អ្នក​អាច​មើល​ឃើញ​​កាំ​របស់​វា ក៏​ត្រូវ​បាន​បង្ហាញ​នៅ​ក្នុង​ Kalzium ផង​ដែរ ។ អ៊ីយ៉ុង​"
"វិជ្ជមាន​ មាន​អេឡិចត្រុង​នៅ​ក្នុង​ស្រទាប់​របស់​វា​តិច​ជាង​អាតូម​ ចំណែក​អ៊ីយ៉ុង​អវិជ្ជមាន​ មាន​អេឡិចត្រុង​ច្រើន​ជាង​"
"អាតូម​ ។ ដូច្នេះ អ៊ីយ៉ុង​វិជ្ជមាន​ មាន​កាំ​តូច​ជាង​អាតូម​របស់​វា និងផ្សេងពីនេះ ។"

#. i18n: file: data/knowledge.xml:258
#: rc.cpp:2437
msgid ""
"The van der Waals radius of an atom is the radius of an imaginary hard "
"sphere which can be used to model the atom for many purposes. Van der Waals "
"radii are determined from measurements of atomic spacing between pairs of "
"unbonded atoms in crystals."
msgstr ""
"កាំ​ van der Waals របស់​អាតូម​ គឺ​ជា​កាំ​នៃ​ស្វ៊ែរ​​រឹង​បែប​ប្រឌិត​ ដែល​អាច​ត្រូវ​បាន​ប្រើ​ធ្វើ​ជា​គំរូ​អាតូម​សម្រាប់​"
"គោល​បំណង​ច្រើន​យ៉ាង ។ កាំ Van der Waals ត្រូវ​បាន​កំណត់​តាម​រង្វាស់​នៃ​គម្លាត​អាតូម​រវាង​គូ​អាតូម​ដែល​មិន​"
"សម្ព័ន្ធ​គ្នា​នៅ​ក្នុង​ក្រាម​ ។"

#. i18n: file: data/knowledge.xml:267
#: rc.cpp:2447
msgid ""
"The atomic radius is the distance from the atomic nucleus to the outmost "
"stable electron orbital in a atom that is at equilibrium."
msgstr "កាំ​អាតូម គឺ​ជា​ចម្ងាយ​ពី​ណ្វៃយ៉ូ​អាតូម​ទៅ​អរប៊ីតាល់​អេឡិចត្រុង​ថេរ​ខាង​ក្រៅ​បំផុត​នៅ​ក្នុង​អាតូម​ដែល​មាន​លំនឹង​។"

#. i18n: file: data/knowledge.xml:276
#: rc.cpp:2457
msgid ""
"The covalent radius in chemistry corresponds to half of the distance between "
"two identical atomic nuclei, bound by a covalent bond."
msgstr ""
"កាំ​កូវ៉ាឡង់​នៅ​ក្នុង​គីមី​ត្រូវ​គ្នា​នឹង​ពាក់​កណ្ដាល​ចម្ងាយ​រវាង​ណ្វៃយ៉ូ​នៃ​អាតូម​ពីរ​ដូច​គ្នា​ ដែល​សម្ព័ន្ធ​កូវ៉ាឡង់​ជា​មួយ​"
"គ្នា ។"

#. i18n: file: data/tools.xml:5
#: rc.cpp:2465
msgid "Watchglass"
msgstr "កញ្ចក់​នាឡិកា"

#. i18n: file: data/tools.xml:6
#: rc.cpp:2467
msgid ""
"Watchglasses are round glass panes with a diameter of around 5 - 10cm, used "
"in various experimental techniques. The border is bent upwards to allow the "
"watchglass to hold small amounts of liquids in order to let them evaporate. "
"The evaporation can be accelerated by heating the watchglass with a Bunsen "
"burner. Watchglasses can also be used to cover Petri dishes or beakers, and "
"are also suited to weighing small amounts of matter or drying them in an "
"airing cupboard. The term watchglass is derived from the former pocket "
"watches' protection glass which was often domed."
msgstr ""
"កញ្ចក់​នាឡិកា​ គឺ​ជា​ផ្ទាំង​កញ្ចក់​មូល​ដែល​មាន​អង្កត់​ផ្ចិត​ប្រហែល​ ៥ ទៅ ១​០​ ស.ម ដែល​ត្រូវ​បាន​គេ​ប្រើ​នៅ​ក្នុង​"
"បច្ចេកទេស​ពិសោធន៍​ផ្សេង​ៗ ។ គែម​របស់​វា​កោង​ឡើង​លើ​ ដែល​ធ្វើ​ឲ្យ​កញ្ចក់​នាឡិកា​អាច​ទប់​ទ្រ​វត្ថុ​រាវ​មួយ​ចំនួន​តូច​​​ "
"ដើម្បី​ឲ្យ​ពួក​វា​អាច​ហួត​បាន​ ។ រំហួត​អាច​ត្រូវ​បាន​ពន្លឿន​ដោយ​ការ​កម្ដៅ​កញ្ចក់​នាឡិកា​ដោយ​ប្រើ​ចំពុះ​ប៊ុនសិន ។ កញ្ចក់​"
"នាឡិកា​ក៏​អាច​ត្រូវ​បាន​គេ​ប្រើ ដើម្បី​គ្រប​ចាន​បណ្ដុះ ឬ​បេស៊ែ និង​ក៏​ត្រូវ​បាន​ប្រើ​ ដើម្បី​ថ្លឹង​រូបធាតុ​មួយ​ចំនួន​តូច​ ឬ​"
"សម្ងួត​ពួកវា​នៅ​ក្នុង​ទូ​ដែល​មាន​ខ្យល់ ។  ពាក្យ​ថា កញ្ចក់​នាឡិកា​ (watchglass) មាន​ប្រភព​មក​ពី​ពាក្យ​ថា​កញ្ចក់​"
"ការពារ​របស់​នាឡិកា​ដាក់​ក្នុង​ហោប៉ៅ​​ដែល​ជា​ទូទៅ​វា​មាន​សណ្ឋាន​​ជា​រាង​ក្រឡូម​ ។"

#. i18n: file: data/tools.xml:10
#: rc.cpp:2469
msgid "Dehydrator"
msgstr "ដេអ៊ីដ្រាតករ"

#. i18n: file: data/tools.xml:13
#: rc.cpp:2471
msgid ""
"A dehydrator is a piece of laboratory apparatus, often made of glass, and "
"which serves to dry chemical matters; that is, to remove water or liquid "
"from a sample.\n"
"\t\t\tIn principle it is a glass bowl with cap that has a planar grinding, "
"so that the bowl is air-tight. The dehydrator's lower part is ordinarily "
"filled with a drying agent such as calcium chloride, silica gel, phosphoric "
"anhydride or sulphuric acid. The sample to be dried is placed on a "
"diaphanous cartridge of plastic or ceramic above the drying agent.\n"
"\t\t\tThe drying agent is hygroscopic, which means that it dehumidifies its "
"environment by absorbing water vapor. The dry atmosphere then takes up water "
"from the sample to be dried."
msgstr ""
"ដេអ៊ីដ្រាតករ​ គឺ​ជា​ផ្នែក​មួយ​នៃ​ឧបករណ៍​ពិសោធន៍​ ដែល​ជា​ញឹកញាប់ ធ្វើ​អំពី​កញ្ចក់​ ហើយ​វា​ត្រូវ​បាន​គេ​ប្រើ សម្រាប់​​"
"ការ​សម្ងួត​សារធាតុ​គីមី ពោល​គឺ​ផ្ដាច់​យក​ទឹក​ចេញ​ពី​វត្ថុរាវ និង​សំណាក ។\n"
"\t\t\t តាម​ទ្រឹស្ដី វា​គឺ​ជា​ចាន​កញ្ចក់​ដែល​មាន​គម្រប​បិទ​ជិត​ ដែល​ធ្វើ​ឲ្យ​ចាន​មាន​លក្ខណៈ​បង្ហាប់​ខ្យល់​ ។ ផ្នែក​"
"ខាង​ក្រោម​របស់​ដេអ៊ីដ្រាតករ​ ត្រូវ​បាន​បំពេញ​តាម​ធម្មតា​ដោយ​ភ្នាក់ងារ​សម្ងួត​ដូច​ជា កាល់ស្យូមក្លរួ  ជេល​ស៊ីលីស "
"អានីឌ្រិច​ផូស្វរិច ឬ​អាស៊ីត​​​ស៊ុលផួរិច ។ សំណាក​ដែល​ត្រូវ​បាន​​សម្ងួត​ នឹង​ត្រូវ​បាន​ដាក់​នៅ​លើ​ប្រអប់​ថ្លា​ប្លាស្ទិក ឬ​នៅ​លើ​"
"សេរ៉ាមិច​ដែល​នៅ​ពី​លើ​ភ្នាក់ងារ​សម្ងួត​ ។\n"
"\t\t\tភ្នាក់​ងារ​សម្ងួត គឺ​ជា​អ្នក​ស្រូប​សំណើម​ វា​​មានន័យ​ថា វា​សំណើម​បរិស្ថាន​របស់​វា​ដោយ​ការ​ស្រូប​យក​ចំហាយ​ទឹក "
"។ បន្ទាប់​មក បរិយាកាស​ស្ងួត​ក៏​ចាប់​យក​ទឹក​ពី​សំណាក​ដែល​ត្រូវ​បាន​សម្ងួត ។"

#. i18n: file: data/tools.xml:17
#: rc.cpp:2475
msgid "Spatula"
msgstr "វែកកូរ"

#. i18n: file: data/tools.xml:18
#: rc.cpp:2477
msgid ""
"The spatula is a laboratory tool to scrape off, grind, and transport "
"chemicals. The material they are made of (e.g. iron, titanium, platinum) and "
"their design (e.g. flat spatula or spoon spatula) varies."
msgstr ""
"វែក​កូរ​ ជា​ឧបករណ៍​ពិសោធន៍​សម្រាប់​កោស កិន​ និង​បញ្ជូន​សារ​ធាតុ​គីមី ។ ពួក​វា​ធ្វើ​ពី​វត្ថុធាតុ​ដូច​ជា​​ (ឧ. ដែក​ "
"ទីតានីញ៉ូម​ ប្លាទីន​) ហើយ​ការ​រចនា​របស់​វា​​ (ឧ. វែក​សំប៉ែត​  ឬ​វែក​បាយ) ក៏​មាន​លក្ខណៈ​​ផ្សេង​ៗ​គ្នា​ដែរ​​ ។"

#. i18n: file: data/tools.xml:22
#: rc.cpp:2479
msgid "Water Jet Pump"
msgstr "ម៉ាស៊ីន​បូម​ទឹក​"

#. i18n: file: data/tools.xml:23
#: rc.cpp:2481
msgid ""
"The water jet pump has two entry pipes and one exit, and consists, in "
"principle, of two pipes one inside the other. At the water entry a water jet "
"shoots under full pressure out of a nozzle into a slightly larger pipe. The "
"water jet thereby carries away air or fluid from the second entry. <br> This "
"is caused by the negative pressure in a drifting fluid, and thus it is an "
"application of the hydrodynamic paradox (objects close to drifting fluids "
"are aspirated instead of being pushed away)."
msgstr ""
"ម៉ាស៊ីន​បូម​ទឹក​មាន​បំពង់​ចូល​ពីរ និង​បំពង់​ចេញ​មួយ​ ជា​រួម​មាន​បំពង់​ពីរ បំពង់​មួយ​ស្ថិត​នៅ​ក្នុង​បំពង់​មួយ​ផ្សេង​ទៀត​ ។ នៅ​ត្រង់​"
"ផ្លូវ​ចូល​របស់​ទឹក​ ម៉ាស៊ីន​បូម​ទឹក​​បាញ់​ទឹក​ក្រោម​សម្ពាធ​មួយ​ពេញ​ទី​ ចេញ​ពី​ក្បាល​ទុយយោ​ចូល​ទៅ​ក្នុង​បំពង់​ធំ​ល្មម​មួយ​ផ្សេង​ទៀត "
"។ ដូច្នេះ​ ម៉ាស៊ីន​បូម​ទឹក​នាំ​វត្ថុ​រាវ​ និង​ខ្យល់​ចេញ​ពី​បំពង់​ចូល​ទី​ពីរ​ ។ <br> វា​បង្ក​ឡើង​ដោយ​សម្ពាធ​អវិជ្ជមាន​នៅ​"
"ក្នុង​អង្គធាតុ​រាវ​ដែល​មាន​លំហូរ​ ដូច្នេះ​វា​ជា​ការ​អនុវត្ត​នៃ​ដំណើរការ​ផ្ទុយ​គ្នា​នៃ​អ៊ីដ្រូឌីណាមិច (វត្ថុ​នៅ​ជិត​"
"វត្ថុរាវ​ដែល​មាន​លំហូរ​នឹង​ត្រូវ​ស្រូប​យក​ជាជាង​ច្រាន​ចេញ​) ។"

#. i18n: file: data/tools.xml:27
#: rc.cpp:2483
msgid "Refractometer"
msgstr "ចំណាំង​បែរ"

#. i18n: file: data/tools.xml:28
#: rc.cpp:2485
msgid ""
"With a refractometer the refractive index of optical media is determined. If "
"the refractive index of a chemical is known it can be used after a synthesis "
"to determine the sample's purity or to audit the synthesis' success."
msgstr ""
"ជា​មួយ​នឹង​ចំណាំង​បែរ សន្ទស្សន៍​​ចំណាំង​បែរ​នៃ​មេឌៀ​អុបទិចនឹង​ត្រូវ​បាន​កំណត់​ ។​​ បើ​សិន សន្ទស្សន៍​ចំណាំង​បែរ​នៃ​សារធាតុ​"
"គីមី​ត្រូវ​បាន​ស្គាល់ វា​អាច​នឹង​ត្រូវ​បាន​ប្រើ​ បន្ទាប់​ពី​ការ​ធ្វើ​សំយោគ​ ដើម្បី​កំណត់​ភាព​សុទ្ធ​របស់​សំណាក ឬ​ដើម្បី​តាម​"
"ដាន​ភាព​ជោគ​ជ័យ​របស់​សំយោគ ។"

#. i18n: file: data/tools.xml:32
#: rc.cpp:2487
msgid "Mortar"
msgstr "ត្បាល់​បុក"

#. i18n: file: data/tools.xml:33
#: rc.cpp:2489
msgid ""
"A mortar is used for manually grinding solids. It can also be used to "
"homogenize a mixture of powders by grinding. A club-shaped tool known as a "
"pestle is used with the mortar for grinding."
msgstr ""
"ត្បាល់​បុក​ត្រូវ​បាន​ប្រើ សម្រាប់​បុក​វត្ថុ​រឹង​ដោយ​ដៃ ។ វា​ក៏​អាច​ត្រូវ​បាន​គេ​ប្រើ ដើម្បី​ធ្វើ​ឲ្យ​ល្បាយ​នៃ​ម្សៅ​ស្មើ​"
"សាច់​ដោយ​ការ​បុក​ផង​ដែរ ។ ឧបករណ៍​រាង​ដំបង​ត្រូវ​បាន​គេ​ស្គាល់​ថា ជា​អង្រែ​ ត្រូវ​បាន​ប្រើ​ជា​មួយ​ត្បាល់​សម្រាប់​បុក​ "
"។"

#. i18n: file: data/tools.xml:37
#: rc.cpp:2491
msgid "Heating Coil"
msgstr "រង្វេល​កម្ដៅ"

#. i18n: file: data/tools.xml:38
#: rc.cpp:2493
msgid ""
"Heating coils are used to heat flasks and other containers. Multiple heating "
"coils can be connected with a thermometer so that the heat will not exceed a "
"specified temperature. It is possible to use a magnetic field inside the "
"heating coil to stir fluids with a magnetic stirrer. This will homogenize "
"the fluid in terms of temperature and composition."
msgstr ""
"រង្វេល​កម្ដៅ​ ត្រូវ​បាន​គេ​ប្រើ​ដើម្បី​ដុត​កម្ដៅ​កែវ​ និង​ឧបករណ៍​ផ្ទុក​ផ្សេង​ៗ​ទៀត ។ រង្វេល​កម្ដៅ​ជា​ច្រើន​អាច​ត្រូវ​"
"បាន​ត​ភ្ជាប់​ជា​មួយ​នឹង​ទែម៉ូម៉ែត្រ​ ដើម្បី​កុំ​ឲ្យ​កម្ដៅ​លើស​ពី​សីតុណ្ហភាព​ដែល​បាន​កំណត់ ។ គេ​ក៏​អាច​ប្រើ​ដែន​ម៉ាញេទិច​នៅ​"
"ខាង​ក្នុង​រង្វេល​កម្ដៅ​ផង​ដែរ ដើម្បី​កូរ​វត្ថុរាវ​ដោយ​ប្រើ​ឧបករណ៍​កូរ​ម៉ាញេទិច​ ។ វា​នឹង​ធ្វើ​ឲ្យ​វត្ថុរាវ​មាន​ល្បាយ​"
"ស្មើ​​សាច់​ដោយ​គិត​ពី​​សីតុណ្ហភាព និងសមាសធាតុ ។"

#. i18n: file: data/tools.xml:42
#: rc.cpp:2495
msgid "Cork Ring"
msgstr "ក្រវិលឆ្នុក"

#. i18n: file: data/tools.xml:43
#: rc.cpp:2497
msgid ""
"Large containers like round-bottomed flasks are placed on rings made of "
"cork, a special soft lightweight wood with good insulating qualities to "
"protect fragile instruments."
msgstr ""
"ឧបករណ៍​ផ្ទុក​ធំ​ៗ​ដូច​ជា​កែវ​បាត​មូល​ត្រូវបានគេ​ដាក់​នៅ​លើ​​រង្វង់​​ដែល​ធ្វើ​ពី​​ឈើ​ម្យ៉ាង​ ដែល​ជា​ឈើ​មាន​ទម្ងន់​ស្រាល​ពិសេស​"
"ដែល​មាន​គុណភាព​អ៊ីសូឡង់​ល្អ​ សម្រាប់​ការពារ​ឧបករណ៍​ដែល​ផុយស្រួយ ។"

#. i18n: file: data/tools.xml:47
#: rc.cpp:2499
msgid "Dropping Funnel"
msgstr "ឡាវ​សម្រក់"

#. i18n: file: data/tools.xml:48
#: rc.cpp:2501
msgid ""
"A dropping funnel can be used to drop precise amounts of fluid. The dropping "
"speed can be controlled with a valve."
msgstr ""
"ឡាវ​សម្រក់​អាច​ត្រូវ​បាន​គេ​ប្រើ ដើម្បី​សម្រក់​បរិមាណ​​​វត្ថុរាវ​ជាក់​លាក់ ។ ល្បឿន​សម្រក់​អាច​ត្រូវ​បាន​ត្រួត​ពិនិត្យ​​"
"ដោយវ៉ាល ។"

#. i18n: file: data/tools.xml:52
#: rc.cpp:2503
msgid "Separating Funnel"
msgstr "ឡាវញែក"

#. i18n: file: data/tools.xml:53
#: rc.cpp:2505
msgid ""
"A separating funnel can be used to separate a mixture of fluids of differing "
"densities. A valve at the bottom allows the denser fluid to be drained for "
"transfer to another container."
msgstr ""
"ជីឡាវ​ញែក​អាច​ត្រូវ​បាន​គេ​ប្រើ ដើម្បី​ញែក​ល្បាយ​វត្ថុ​រាវ​ដែល​មាន​ដង់ស៊ីតេ​ខុស​ៗ​គ្នា ។ វ៉ាល​នៅ​ខាងក្រោម​អនុញ្ញាត​"
"ឲ្យ​បង្ហូរ​វត្ថុរាវ​ខាប់​ ដើម្បី​ផ្ទេរ​ទៅ​ឧបករណ៍​ផ្ទុក​មួយ​ទៀត ។"

#. i18n: file: data/tools.xml:57
#: rc.cpp:2507
msgid "Test Tube Rack"
msgstr "បន្ទាស​​បំពង់​ពិសោធន៍​"

#. i18n: file: data/tools.xml:58
#: rc.cpp:2509
msgid ""
"This rack is useful when many small amounts of chemicals are to be tested in "
"a row; or alternatively, to dry test tubes."
msgstr ""
"បន្ទាស​នេះ​មាន​ប្រយោជន៍​បំផុត នៅ​ពេល​ដែល​សារ​ធាតុ​គីមី​មួយ​ចំនួន​តូច​ត្រូវ​បាន​ពិសោធន៍​នៅ​ក្នុង​ជួរ​​​ដេក​មួយ ឬ​បើ​មិន​អញ្ចឹង​"
"ទេ ប្រើ​សម្រាប់​សម្ងួត​បំពង់​ពិសោធន៍ ។"

#. i18n: file: data/tools.xml:62
#: rc.cpp:2511
msgid "Vortexer"
msgstr "ឧបករណ៍​គំនួប"

#. i18n: file: data/tools.xml:63
#: rc.cpp:2513
msgid ""
"A vortexer serves to homogenize reagents found in laboratories. The "
"container containing liquid to be homogenized is put on a platform. The "
"platform shakes by rotary agitation up to 3000RPM at which point a contact "
"sensor is activated. In this way extremely small volumes of fluid can be "
"homogenized quickly. It is the opposite of a centrifuge, used to separate "
"fluids."
msgstr ""
"ឧបករណ៍​គំនួប​ប្រើ​សម្រាប់​ធ្វើឲ្យ​ប្រតិករ​ស្មើ​សាច់​ដូច​ដែល​បាន​ឃើញ​នៅ​ក្នុង​ទី​ពិសោធន៍ ។ ឧបករណ៍​ផ្ទុក​ដែល​មាន​វត្ថុ​រាវ​"
"ដែល​ត្រូវ​ធ្វើ​ឲ្យ​ស្មើ​សាច់​នឹង​ត្រូវ​បាន​ដាក់​នៅ​លើ​ជើង​ទម្រ​ ។ ជើង​ទម្រ​នឹង​ញ័រ​ដោយ​ការ​រញ្ជួយ​ដែល​វិល​រហូត​ដល់​​​​ ៣​០​០​០​ "
"RPM នៅ​ត្រង់​ចំណុច​​ដែល​ឧបករណ៍​ចាប់​សញ្ញាណ​ត្រូវ​បាន​ធ្វើ​ឲ្យ​សកម្ម​ ។ តាម​វិធីសាស្ត្រ​នេះ មាឌ​វត្ថុរាវ​ដែល​តូច​បំផុត​"
"អាច​នឹង​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ស្មើ​សាច់​យ៉ាង​ឆាប់​រហ័ស ។ វា​ផ្ទុយ​ពី​ប្រដាប់​ទាញ​ចេញ​ ដែល​ត្រូវ​បាន​ប្រើ​សម្រាប់​ញែក​វត្ថុ​"
"រាវ ។"

#. i18n: file: data/tools.xml:67
#: rc.cpp:2515
msgid "Wash Bottle"
msgstr "ដប​បាញ់​សម្អាត​"

#. i18n: file: data/tools.xml:68
#: rc.cpp:2517
msgid ""
"These bottles are used for many purposes. In most laboratories they are "
"usually filled with water, salt, acid or other commonly used fluids. They "
"make it easy to apply the fluid if a precisely measured amount is not needed."
msgstr ""
"ដប​ទាំងនេះ​ត្រូវ​បាន​ប្រើ​សម្រាប់​គោល​បំណង​ជាច្រើន ។ នៅ​ក្នុង​ការ​​​ពិសោធន៍​ភាគ​ច្រើន ពួក​វា​​ត្រូវ​បាន​បំពេញ​ដោយ​"
"ទឹក អំបិល អាស៊ីត ឬ​វត្ថុ​រាវ​ដែល​ប្រើ​ជាទូទៅ​ផ្សេង​ទៀត ។ ពួក​វា​ធ្វើ​ឲ្យ​​ងាយ​ស្រួល​ក្នុង​ការ​​អនុវត្ត​វត្ថុ​រាវ បើ​"
"អ្នក​មិន​ត្រូវការ​វាស់​បរិមាណ​​​សរុប​ជាក់លាក់ ។"

#. i18n: file: data/tools.xml:72
#: rc.cpp:2519
msgid "Rotary Evaporator"
msgstr "ឧបករណ៍​បង្ហួត​​រង្វិល"

#. i18n: file: data/tools.xml:73
#: rc.cpp:2521
msgid ""
"A rotary evaporator consists of a round flask in a bath of hot water, and is "
"designed to evaporate solvents. The flask is rotated and the solvent "
"collects under a vacuum onto a condenser and drips into a condensate "
"collecting flask. In this way solutions can be concentrated or purified. By "
"attaching a vacuum pump, the air pressure and therefore the boiling point of "
"the fluid can be decreased."
msgstr ""
"ឧបករណ៍​បង្ហួត​រង្វិល​មាន​កែវ​រាង​មូល​ស្ថិត​នៅ​ក្នុង​អាងទឹក​ក្ដៅ ហើយ​វា​មាន​តួនាទី​ក្នុង​ការ​បង្ហួត​ធាតុ​​រំលាយ ។ កែវ​"
"ត្រូវ​បាន​បង្វិល​ ហើយ​ធាតុ​រំលាយ​ប្រមូល​ផ្ដុំ​នៅ​ក្រោម​សុញ្ញាកាស​ពី​លើ​សីតករ និង​សម្រក់​ទឹក​ចូល​ទៅ​ក្នុង​កែវ​ដែល​ប្រមូល​ផ្ដុំ​"
"ធាតុ​ក​ជា​ញើស​ ។ តាម​រយៈ​វិធីសាស្ត្រ​នេះ សូលុយស្យុង​អាច​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ខាប់​ ឬ​បន្សុទ្ធ ។ ដោយ​ការ​តភ្ជាប់​ជា​មួយ​"
"ស្នប់​សុញ្ញាកាស​ សម្ពាធ​ខ្យល់ ព្រម​ទាំង​ចំណុច​រំពុះ​នៃ​វត្ថុ​រាវ​អាច​នឹង​ថយ​ចុះ ។"

#. i18n: file: data/tools.xml:77
#: rc.cpp:2523
msgid "Reflux Condenser"
msgstr "សីតករ​វិល​ត្រឡប់"

#. i18n: file: data/tools.xml:78
#: rc.cpp:2525
msgid ""
"A reflux condenser subjects fluid to a process where a gas produced by "
"heating is collected on the reflux condenser. The fluid is cooled until it "
"condenses and runs back into the original fluid. Usually it is put on a "
"round-bottomed flask or several neck flasks."
msgstr ""
"សីតករ​វិល​​​ត្រឡប់​នាំ​យក​វត្ថុ​រាវ​ទៅ​កាន់​ដំណើរ​ការ​ត្រង់​កន្លែង​ដែល​ឧស្ម័ន​ត្រូវ​បាន​បង្កើត​ឡើង​ដោយ​កម្ដៅ​ដែល​នឹង​ត្រូវ​"
"បាន​ប្រមូល​ផ្ដុំ​នៅ​លើ​សីតករ​វិល​ត្រឡប់​ ។ វត្ថុ​រាវ​នឹង​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ត្រជាក់​ រហូត​ដល់​វា​ក​ទៅ​ជា​ទឹក និង​ត្រឡប់​ទៅ​កាន់​"
"វត្ថុ​រាវ​ដើម​វិញ​ ។ ជា​ទូទៅ​ វា​ត្រូវ​បាន​គេ​ដាក់​នៅ​លើ​កែវ​បាត​មូល ឬ​កែវ​ដែល​មាន​ក​បី​បួន ។"

#. i18n: file: data/tools.xml:82
#: rc.cpp:2527
msgid "Pipette Bulb"
msgstr "បំពង់​បឺត​ប៉ោង"

#. i18n: file: data/tools.xml:83
#: rc.cpp:2529
msgid ""
"A pipette bulb is used to fill pipettes.  Squeezing then releasing the bulb "
"produces a negative pressure, causing fluid to flow into the pipette; "
"squeezing the bulb then causes the fluid to flow out of the pipette."
msgstr ""
"បំពង់​បឺត​​ប៉ោង​ត្រូវ​បាន​គេ​ប្រើ​សម្រាប់​បំពេញ​បំពង់​បឺត​ផ្សេង​ទៀត ។  ច្របាច់​ ហើយ​ព្រលែង​បំពង់​បឺត​​ ធ្វើ​ឲ្យ​វា​បង្កើត​"
"បាន​ជា​សម្ពាធ​អវិជ្ជមាន ដែល​អាច​នាំ​ឲ្យ​វត្ថុ​រាវ​ហូរ​ចូល​ទៅ​ក្នុង​បំពង់​បឺត​ផ្សេង​ទៀត​ ហើយ​​ការដែល​​ច្របាច់ និង​"
"ព្រលែង​បំពង់​បឺត​ម្ដង​ទៀត អាច​ធ្វើ​ឲ្យ​វត្ថុរាវ​ហូរ​ចេញ​ពី​បំពង់​បឺត ។"

#. i18n: file: data/tools.xml:87
#: rc.cpp:2531
msgid "Test Tube"
msgstr "បំពង់​ពិសោធន៍​"

#. i18n: file: data/tools.xml:88
#: rc.cpp:2533
msgid ""
"In a test tube small reactions or experiments are performed. There are many "
"different types of tubes. For example some have connectors, some are etched "
"for measurements, some are hardened for durability."
msgstr ""
"នៅ​ក្នុង​បំពង់​ពិសោធន៍​​ ប្រតិកម្ម​ និង​ការ​ពិសោធន៍​​ដ៏​តូច​មួយ​នឹង​ត្រូវ​បាន​អនុវត្ត ។ មាន​បំពង់​ខុស​ៗ​គ្នា​ជា​ច្រើន​ប្រភេទ​ "
"។ ឧទាហរណ៍ បំពង់​ខ្លះ​មាន​ឧបករណ៍​តភ្ជាប់ ខ្លះ​ទៀត​ត្រូវ​បាន​រចនា​សម្រាប់​រង្វាស់ ខ្លះ​ទៀត​ត្រូវ​បាន​ធ្វើ​ឲ្យ​រឹង​"
"ជាប់​មាំ​ល្អ ។"

#. i18n: file: data/tools.xml:92
#: rc.cpp:2535
msgid "Protective Goggles"
msgstr "វ៉ែនតា​សម្រាប់​ការពារ​ភ្នែក​"

#. i18n: file: data/tools.xml:93
#: rc.cpp:2537
msgid ""
"Most laboratories insist that protective goggles are worn. Without them, it "
"is too risky to work with most chemicals. Usually, the lens is a special "
"type of plastic that affords protection from both mechanical impacts, and "
"acid and base chemicals."
msgstr ""
"ទី​ពិសោធន៍​មួយ​ចំនួន​បាន​ទទូច​ថា​មនុស្ស​គ្រប់គ្នា​ត្រូវ​ពាក់​វ៉ែនតា​សម្រាប់​ការពារ​ភ្នែក​ ។ បើ​គ្មាន​ពួក​វា វា​​ពិត​ជា​"
"គ្រោះ​ថ្នាក់​ណាស់​ក្នុង​ការ​ដែល​ធ្វើការ​ជាមួយ​ធាតុ​គីមី​ជាច្រើន ។ ជា​ទូទៅ​ កញ្ចក់​របស់​វា ​គឺ​ជា​ប្រភេទ​កញ្ចក់​​"
"ប្លាស្ទិក​ពិសេស​ដែល​ការពារ​អ្នក​ពី​ផល​ប៉ះពាល់​មេកានិច និង ធាតុ​គីមី​ដូចជា អាស៊ីដ និង បាស ។"

#. i18n: file: data/tools.xml:97
#: rc.cpp:2539
msgid "Round-Bottomed Flask"
msgstr "កែវ​បាត​មូល"

#. i18n: file: data/tools.xml:98
#: rc.cpp:2541
msgid ""
"A round-bottomed flask is used for many reactions. Some can be connected to "
"other items, as the frosting on the neck shows. With cork rings they can be "
"placed on a table."
msgstr ""
"កែវ​បាត​មូល​ត្រូវ​បាន​គេ​ប្រើ​សម្រាប់​ប្រតិកម្ម​ជា​ច្រើន​ ។ កែវ​ខ្លះ​អាច​នឹង​ត្រូវ​បាន​តភ្ជាប់​ទៅ​វត្ថុ​ផ្សេង​ទៀត ដូច​"
"ជា​ការ​បង្កក​នៅ​លើ​ក​កែវ​​ដូច​ដែល​បាន​បង្ហាញ​ជាដើម​ ។ ជា​មួយ​នឹង​ក្រវិល​ឆ្នុក​ទាំង​នេះ ពួក​វា​អាច​នឹង​ត្រូវ​បាន​គេ​"
"ដាក់​នៅ​លើ​តុ ។"

#. i18n: file: data/tools.xml:102
#: rc.cpp:2543
msgid "Full Pipette"
msgstr "បំពង់​បឺត​ពេញ"

#. i18n: file: data/tools.xml:103
#: rc.cpp:2545
msgid ""
"Unlike a regular pipette, a full pipette only has one marking for a specific "
"volume."
msgstr "មិន​ដូច​បំពង់​បឺត​ធម្មតា​ទេ បំពង់​បឺត​ពេញ​មាន​ស្នាម​សម្គាល់​តែ​មួយ​គត់​សម្រាប់​មាឌ​ដែល​ពិសេស​​ ។"

#. i18n: file: data/tools.xml:107
#: rc.cpp:2547
msgid "Drying Tube"
msgstr "បំពង់​​សម្ងួត​"

#. i18n: file: data/tools.xml:108
#: rc.cpp:2549
msgid ""
"Some reactions need to be kept free of water: to make this possible a drying "
"tube can be used.  Drying tubes contains a hygroscopic chemical to absorb "
"water from the atmosphere."
msgstr ""
"ប្រតិកម្មខ្លះ​មិន​ត្រូវ​ការ​ជាតិ​ទឹក​ទេ ៖ ដើម្បី​ធ្វើ​ដូច្នេះ​បាន​ គេ​នឹង​ប្រើ​បំពង់​សម្ងួត ។ បំពង់​សម្ងួត​មាន​សារធាតុ​"
"គីមីសម្រាប់​ស្រូប​យក​ទឹក​​ពី​បរិយាកាស​ ។"

#. i18n: file: data/tools.xml:112
#: rc.cpp:2551
msgid "Test Tube Holder"
msgstr "ឧបករណ៍​ចាប់​បំពង់​ពិសោធន៍"

#. i18n: file: data/tools.xml:113
#: rc.cpp:2553
msgid ""
"Test tube holders make it easier to hold test tubes. By using a holder, "
"there is a safe distance between ones hand and the test tube when the tube "
"is hot.  Typically, test tube holders are used to hold test tubes over open "
"flames."
msgstr ""
"ឧបករណ៍​ចាប់​បំពង់​ពិសោធន៍​ធ្វើ​ឲ្យ​​ងាយ​ស្រួល​ក្នុង​ការ​ចាប់​បំពង់​ពិសោធន៍ ។ ដោយ​ការ​ប្រើ​ឧបករណ៍​ចាប់​នេះ​ នឹង​មាន​"
"ចម្ងាយ​សុវត្ថិភាព​ចន្លោះ​ពី​ដៃ​​ជា​មួយ​នឹង​បំពង់​ពិសោធន៍​ នៅ​ពេល​ដែល​បំពង់​នេះ​ក្ដៅ​ ។  ជា​រួម​ ឧបករណ៍​ចាប់​បំពង់​ពិសោធន៍​"
"នេះ​ត្រូវ​បាន​ប្រើ​សម្រាប់​ការ​ចាប់​បំពង់​ពិសោធន៍​នៅ​លើ​អណ្ដាត​ភ្លើង​ទី​លំហ​ ។"

#. i18n: file: data/tools.xml:117
#: rc.cpp:2555
msgid "Measuring Cylinder"
msgstr "ស៊ីឡាំង​ក្រិត"

#. i18n: file: data/tools.xml:118
#: rc.cpp:2557
msgid ""
"A measuring cylinder can be used to measure amounts of liquids relatively "
"precisely. Furthermore, the cylinder allows particulate matter to sink: "
"following this, the particulates can be separated from the fluid by "
"decanting."
msgstr ""
"ស៊ីឡាំង​ក្រិត​អាច​​ត្រូវ​បាន​គេ​ប្រើ ដើម្បី​វាស់​បរិមាណ​វត្ថុ​រាវ​ជាក់​ស្ដែង​ ។ លើស​ពី​នេះ​ទៅ​ទៀត ស៊ីឡាំង​ក្រិត​នេះ​អាច​"
"ធ្វើ​ឲ្យ​រូបធាតុ​ភាគ​ល្អិត​លិច​បាន​ ៖ ដើម្បី​ធ្វើ​ដូច្នេះ​បាន គេ​ត្រូវ​ញែក​រូបធាតុ​ភាគ​ល្អិត​ពី​វត្ថុរាវ​ដោយ​ការ​សំរិត​"
"ផ្នែក​រាវ​ចេញ ។"

#. i18n: file: data/tools.xml:122
#: rc.cpp:2559
msgid "Thermometer"
msgstr "ទែម៉ូម៉ែត្រ​"

#. i18n: file: data/tools.xml:123
#: rc.cpp:2561
msgid ""
"A thermometer can be used to determine the temperature of a sample. In a "
"laboratory, special thermometers are used which can also be used within "
"acids or bases."
msgstr ""
"ទែម៉ូម៉ែត្រ​​ត្រូវ​បាន​ប្រើ ដើម្បី​កំណត់​សីតុណ្ហភាព​នៃ​សំណាក​ ។ ក្នុង​ទី​ពិសោធន៍ ទែម៉ូម៉ែត្រ​ពិសេស​ដែល​ត្រូវ​បាន​ប្រើ ក៏​"
"អាច​នឹង​ត្រូវ​បាន​ប្រើ​នៅ​ក្នុង​អាស៊ីត ឬ​បាស​ផង​ដែរ ។"

#. i18n: file: data/tools.xml:127
#: rc.cpp:2563
msgid "Magnetic Stir Bar"
msgstr "របារ​កូរ​ម៉ាញេទិច"

#. i18n: file: data/tools.xml:128
#: rc.cpp:2565
msgid ""
"Magnetic stir bars are highly chemically inert, small magnetic bars. Most "
"heaters have a built-in magnet which can rotate: this causes the stir bar to "
"rotate and the mixture to become homogenized."
msgstr ""
"របារ​កូរ​ម៉ាញេទិច គឺ​ជា​របារ​ម៉ាញេទិច​តូច​ៗ​ ដែល​មាន​និចល​​គីមី​ខ្ពស់ ។ ឧបករណ៍​កម្ដៅ​ភាគ​ច្រើន​មាន​ម៉ាញេទិច​ជាប់​មក​"
"ជា​មួយ​ដែល​អាច​​​បង្វិល​បាន​ ៖ វា​អាច​ធ្វើ​ឲ្យ​របារ​កូរ​ត្រូវ​បង្វិល​ ហើយ​ល្បាយ​ប្រែ​ជា​ស្មើសាច់ ។"

#. i18n: file: data/tools.xml:132
#: rc.cpp:2567
msgid "Magnetic Stir Bar Retriever"
msgstr "ឧបករណ៍​ទាញ​យក​របារ​កូរ​ម៉ាញេទិច"

#. i18n: file: data/tools.xml:133
#: rc.cpp:2569
msgid ""
"A magnetic stir bar retriever can be used to retrieve magnetic stir bars "
"from containers. The retriever is a bar with a magnet at the end which "
"attracts the stir bars."
msgstr ""
"ឧបករណ៍​ទាញ​យក​របារ​កូរ​ម៉ាញេទិច ត្រូវ​បាន​ប្រើ​ ដើម្បី​ទាញ​យក​របារ​កូរ​ម៉ាញេទិច​ពី​ឧបករណ៍​ផ្ទុក ។ ឧបករណ៍​ទាញ​យក​ "
"គឺ​ជា​របារ​ដែល​មាន​ម៉ាញេទិច​នៅ​ខាង​ចុង ដែល​ទាញ​យក​របារ​កូរ ។"

#. i18n: file: data/tools.xml:137
#: rc.cpp:2571
msgid "Pipette"
msgstr "បំពង់​បឺត"

#. i18n: file: data/tools.xml:138
#: rc.cpp:2573
msgid ""
"Pipettes are used to introduce small quantities of liquids in laboratories. "
"A pipette has a volume scale and, as a rule, pipette bulbs are used as "
"droppers for liquids. Both sorts of pipettes are calibrated for fluids with "
"a temperature of 20°C and for time of outflow (signified by \"Ex.\"). If "
"needed, times of outflow are indicated on the pipettes."
msgstr ""
"បំពង់​បឺត​ត្រូវ​ប្រើ​ដើម្បី​បញ្ចូល​បរិមាណ​នៃ​វត្ថុរាវ​បន្តិច​បន្តួច​នៅ​ក្នុង​ទី​ពិសោធន៍ ។ បំពង់​បឺត​មាន​មាត្រដ្ឋាន​មាឌ ហើយ​"
"បើ​តាម​ច្បាប់ បំពង់​បឺត​ប៉ោង នឹង​ត្រូវ​ប្រើ​ជា​ឧបករណ៍​សម្រក់​សម្រាប់​វត្ថុ​រាវ ។​​ បំពង់​បឺត​ទាំង​ពីរ​ប្រភេទ​ត្រូវ​បាន​ក្រិត​"
"ខ្នាត​សម្រាប់​វត្ថុ​រាវ​​ដែល​​មាន​សីតុណ្ហភាព​ត្រឹម​ 20°C និង​សម្រាប់​រយៈ​ពេល​នៃ​លំហូរ​​ចេញ​ (សម្គាល់​ដោយ​ \"Ex."
"\") ។ បើ​ចាំបាច់ រយៈ​ពេល​នៃ​លំហូរ​ចេញ​នឹង​​បង្ហាញ​នៅ​លើ​បំពង់​បឺត ។"

#. i18n: file: data/tools.xml:142
#: rc.cpp:2575
msgid "Erlenmeyer Flask"
msgstr "ដប​អ៊ែឡិនម៉ីយែ"

#. i18n: file: data/tools.xml:148
#: rc.cpp:2577
msgid ""
"An Erlenmeyer flask, named after the chemist Emil Erlenmeyer (1825-1909), is "
"different to a beaker in that it comes with an inverted conical base and a "
"cylindrical neck. There are different types of Erlenmeyer flasks for "
"laboratory applications: the narrow neck and wide neck forms. Depending on "
"the application the flask may have precision grinding to allow good "
"connection to other containers.\n"
"\t\t\t<br>\n"
"\t\t\tThe narrow neck reduces the risk of fluid escaping, especially when "
"boiling or during reactions which agitate the contents.\n"
"\t\t\t<br>\n"
"\t\t\tAn Erlenmeyer flask is useful for mixing fluids or accelerating "
"reactions by stirring or shaking, for example. The Erlenmeyer flask is "
"particularly suited for a magnetic stirrer, since it can be placed directly "
"on the stirring platform. A round-bottomed flask, by contrast, must be "
"placed on a cork ring on the stirring platform.\n"
msgstr ""
"ដប​អ៊ែឡិនម៉ីយែ ត្រូវ​បាន​ដាក់​ឈ្មោះ​តាម​អ្នក​គីមីវិទូ​ Emil Erlenmeyer (១​៨​២​៥-១​៩​០​៩​) មាន​លក្ខណៈ​ខុស​គ្នា​ពី​"
"កែវ​បែស៊ែ​ត្រង​ថា​វា​មាន​ទ្រង់​ទ្រាយ​ជា​សាជី​ផ្កាប់ និង​មាន​ក​ជា​រាង​ស៊ីឡាំង ។ មាន​ដប​អ៊ែឡិនម៉ីយែជា​​ច្រើន​ប្រភេទ​"
"សម្រាប់​ការ​ពិសោធន៍​គឺ​​ ៖ ដប​ដែល​មាន​ក​តូច និង​ដប​ក​ធំ​ ។ ដោយ​ផ្អែក​ទៅ​តាម​ការ​ពិសោធន៍​ ដប​អាច​ត្រូវ​បាន​គេ​ធ្វើ​ឲ្យ​"
"មាន​លក្ខណៈ​ពិសេស​​ ដើម្បី​​ឲ្យ​វា​ងាយ​ស្រួល​ក្នុង​ការ​​​ត​ភ្ជាប់​​ទៅ​កាន់​ឧបករណ៍​ផ្ទុក​ផ្សេង​ទៀត ។\n"
"\t\t\t<br>\n"
"\t\t\tដប​ក​តូច​អាច​ជួយ​​កាត់​បន្ថយ​​ការ​ហៀ​វត្ថុ​រាវ​ចេញ ជា​ពិសេស​នៅ​ពេល​ដែល​ទឹក​ពុះ ឬ​នៅ​ពេល​មាន​ប្រតិកម្ម​ដែល​"
"ធ្វើ​ឲ្យ​បរិមាណ​ទឹក​ខាង​ក្នុង​ក្រឡក​​។\n"
"\t\t\t<br>\n"
"\t\t\tដប​អ៊ែឡិនម៉ីយែ​មាន​សារ​ប្រយោជន៍​បំផុត​សម្រាប់​ការ​លាយ​វត្ថុ​រាវ​ ឬ​​សម្រាប់​ការ​បង្កើន​ល្បឿន​ប្រតិកម្ម​ ដោយ​"
"ការ​កូរ ឬ​ក្រឡុក​ជា​ដើម​ ។ ដប​អ៊ែឡិនម៉ីយែ​ត្រូវ​បាន​ប្រើ​ជា​ពិសេស​ជា​មួយ​នឹង​ឧបករណ៍​កូរ​ម៉ាញេទិច​ ដោយ​សារ​តែ​គេ​អាច​"
"ដាក់​វា​ដោយ​ផ្ទាល់​នៅ​លើ​ទម្រ​សម្រាប់​កូរ​​បាន ។ ចំណែក​កែវ​បាត​មូល​ គេ​ត្រូវ​តែ​ដាក់​វា​​លើ​ក្រវិល​ឆ្នុក​ដែល​នៅ​ពី​លើ​ទម្រ​"
"សម្រាប់​កូរ ។\n"

#. i18n: file: data/tools.xml:153
#: rc.cpp:2584
msgid "Ultrasonic Bath"
msgstr "អាង​អ៊ុលត្រា"

#. i18n: file: data/tools.xml:154
#: rc.cpp:2586
msgid ""
"For some chemical reactions it is important that the solvent is gas free. To "
"achieve this the reaction vessel is put for some time into a ultrasonic "
"bath. Due to the high sound frequency, the vapor locks peel away and ascend. "
"This procedure is called out-gassing."
msgstr ""
"ចំពោះ​ប្រតិកម្ម​គីមី​មួយ​ចំនួន​ វា​ចាំ​បាច់​ណាស់​ថា ធាតុ​រំលាយ​ដាច់​ខាត​មិន​ត្រូវ​មាន​ឧស្ម័ន​ទេ ។ ដើម្បី​ធ្វើ​ដូច្នេះ​បាន "
"គេ​ត្រូវ​តែ​ដាក់​ភាជន៍​ប្រតិកម្ម​នេះ​ចូល​ទៅ​ក្នុង​អាង​អ៊ុលត្រា​មួយ​រយៈ​ ។ ដោយ​សារ​តែ​មាន​ប្រេកង់​សំឡេង​​កម្រិត​ខ្ពស់ "
"ចំហាយ​នឹង​ទប់​ភាគ​ទឹក​មិន​ឲ្យ​ហៀរ​ចេញ ឬ​មិន​ឲ្យ​ឡើង​ ។ ដំណើរការ​បែប​នេះ ត្រូវ​បាន​គេ​ហៅថា ការ​បង្ហូរ​ឧស្ម័ន​ចេញ "
"។"

#. i18n: file: data/tools.xml:158
#: rc.cpp:2588
msgid "Scales"
msgstr "មាត្រដ្ឋាន"

#. i18n: file: data/tools.xml:159
#: rc.cpp:2590
msgid ""
"In a laboratory, very precise quantities of reagents often have to be "
"weighed out. High precision scales can measure masses down to 1/10000 gram.  "
"As such, they stand on granite blocks to avoid vibrations and are protected "
"against changes in airflow by a dome."
msgstr ""
"នៅ​ក្នុង​ទី​ពិសោធន៍ គ្រប់​បរិមាណ​នៃ​ប្រតិករ​ជាក់​ស្ដែង​នឹង​ត្រូវ​បាន​គេ​ថ្លឹង ។ មាន​មាត្រដ្ឋាន​ដែល​មាន​ចំនួន​ខ្ទង់​ខ្ពស់​"
"អាច​នឹង​វាស់​ចុះ​ត្រឹម​ ១​/១​០​០​០​០​ ក្រាម ។  ដូច្នេះ ពួក​វា​នឹង​ស្ថិត​នៅ​លើ​ដុំ​ក្រានីត ដើម្បី​ចៀសវាង​លំញ័រ និង​ដើម្បី​"
"ទប់​ទល់នឹង​ការ​ផ្លាស់​ប្ដូរ​នៅ​ក្នុង​លំហូរ​ខ្យល់​តាម​ក្រឡូម ។"

#. i18n: file: data/tools.xml:163
#: rc.cpp:2592
msgid "Distillation bridge"
msgstr "ស្ពាន​បំណិត"

#. i18n: file: data/tools.xml:164
#: rc.cpp:2594
msgid ""
"One means of separating a mixture is to use distillation.  In this setting, "
"a distillation bridge acts as a conduit between the two pots.  One pot "
"contains the mixture to be separated, and through heating, a gas forms which "
"is lead through the bridge. At the end of the bridge the gas phase is "
"condensed and drips into a round flask.  Typically, the bridge is cooled by "
"return flow.  Also, there is often a thermometer for controlling the "
"temperature of the distillation bridge."
msgstr ""
"ដើម្បី​ញែក​ល្បាយ​បាន​ គឺ​ត្រូវ​ប្រើ​បំណិត​ ។ នៅ​ក្នុង​ដំណាក់​កាល​នេះ ស្ពាន​បំណិត​ដើរ​តួ​ជា​បំពង់​ចម្លង​រវាង​ឆ្នាំង​ទាំង​"
"ពីរ ។  ឆ្នាំង​មួយ​មាន​ផ្ទុក​ល្បាយ​ដែល​ត្រូវ​​ញែក​ ហើយ​តាម​រយៈ​កម្ដៅ​នេះ ឧស្ម័ន​កកើត​ឡើង​ ឧស្ម័ន​ត្រូវ​បាន​នាំ​ឆ្លង​"
"កាត់​តាម​ស្ពាន​នេះ ។ នៅ​ខាង​ចុង​ស្ពាន ផាស​ឧស្ម័ន​​ត្រូវ​បាន​បង្កក​ ហើយ​ក៏​ស្រក់​ចូល​ទៅ​ក្នុង​កែវ​មូល​ ។  ជា​រួម "
"ស្ពាន​ត្រូវ​បាន​ធ្វើ​​ឲ្យ​ត្រជាក់​ដោយ​លំហូរ​ត្រឡប់ ។  ជា​រឿយៗ ក៏​មាន​ទែម៉ូម៉ែត្រ​សម្រាប់​ត្រួត​ពិនិត្យ​សីតុណ្ហភាព​​ស្ពាន​"
"បំណិត​ផង​ដែរ ។"

#. i18n: file: data/tools.xml:169
#: rc.cpp:2596
msgid "Syringe"
msgstr "សឺរ៉ាំង"

#. i18n: file: data/tools.xml:170
#: rc.cpp:2598
msgid ""
"A syringe consists of two parts, a glass tube and a plunger, both normally "
"made of glass. Gasses flow into the glass tube, and as the syringe is a "
"closed system, the plunger moves outwards. This can be used to measure the "
"volume of a reaction."
msgstr ""
"សឺរ៉ាំង​រួម​មាន​ពីរ​ផ្នែក បំពង់​កែវ​ និង​ប្រដាប់​បូម ជា​ធម្មតា​ពួក​វា​ធ្វើ​អំពី​កែវ​ ។ ឧស្ម័ន​ហូរ​ចូល​ទៅ​ក្នុង​បំពង់​កែវ​ "
"ហើយ​ដោយ​សារ​តែ​សឺរ៉ាំង​ជា​ប្រព័ន្ធ​បិទ​ ប្រដាប់​បូម​នឹង​រំកិល​ចេញ​ក្រៅ​ ។ គេ​អាច​ប្រើ​វា​ដើម្បី​វាស់​មាឌ​​ប្រតិកម្ម​បាន​ ។"

#. i18n: file: data/tools.xml:174
#: rc.cpp:2600
msgid "Separation Beaker"
msgstr "កែវ​បេស៊ែ​សម្រាប់​ញែក"

#. i18n: file: data/tools.xml:175
#: rc.cpp:2602
msgid ""
"First, four small caps are placed at the four ends of the separation "
"beaker.  Then, whilst distilling, the beaker is turned by 60 degrees after a "
"certain temperate has been reached.  In doing so, at the end of the "
"distillation, all four caps contain a specific liquid, depending on the "
"boiling point of the liquid distilled."
msgstr ""
"ដំបូង​ គម្រប​តូច​ៗ​ទាំង​បួន​ត្រូវ​បាន​គេ​ដាក់​​នៅ​ខាង​ចុង​ទាំង​បួន​នៃ​កែវ​បេស៊ែ​​សម្រាប់​ញែក ។ បន្ទាប់​មក នៅ​ពេល​កំពុង​តែ​"
"ធ្វើ​បំណិត​​ កែវ​បេស៊ែរ​​នឹង​ត្រូវ​​បាន​បង្វិល​ត្រឹម​ ៦​០ ដឺក្រេ បន្ទាប់​ពី​សីតុណ្ហភាព​បាន​ឈាន​ដល់​កម្រិត​ពិត​ប្រាកដ​មួយ​​ ។ "
"នៅ​ទី​បញ្ចប់​នៃ​បំណិត​ គម្រប​ទាំងបួន​នឹង​មាន​ផ្ទុក​នូវ​វត្ថុរាវ​ដែល​បាន​កំណត់​ ដោយ​ផ្អែក​លើ​ចំណុច​រំពុះ​របស់​វត្ថុ​រាវ​ដែល​"
"បាន​ធ្វើ​បំណិត​​ ។"

#. i18n: file: data/tools.xml:179
#: rc.cpp:2604
msgid "Burner"
msgstr "ចំពុះ​ដុត"

#. i18n: file: data/tools.xml:180
#: rc.cpp:2606
msgid ""
"There are several types of burners; this picture shows a Teclu-Burner. Each "
"type of burner has specific uses, and they vary in peak temperature and "
"overall heating capacity."
msgstr ""
"មាន​ចំពុះ​ដុត​បី​បួន​ប្រភេទ​ ហើយ​រូប​ភាព​នេះ​នឹង​បង្ហាញ​អំពី​ចំពុះ​​ដុត​ Teclu ។ ចំពុះ​ដុត​ប្រភេទ​នីមួយ​ៗ​មាន​ការ​ប្រើ​"
"ប្រាស់​ជាក់​លាក់​ផ្សេង​ពី​គ្នា ហើយ​ពួក​វា​ប្រែប្រួល​ទៅ​តាម​សីតុណ្ហភាព​ដែល​ខ្ពស់​បំផុត និង​ទៅ​តាមអំណាច​​កម្ដៅ​​​ទាំង​មូល ។"

#. i18n: file: data/tools.xml:184
#: rc.cpp:2608
msgid "Extractor Hood"
msgstr "គម្រប​ឧបករណ៍​យោបក"

#. i18n: file: data/tools.xml:185
#: rc.cpp:2610
msgid ""
"Extractor hoods are used to filter out gases from chemical reactions.  The "
"air, once cleaned, is pumped outside of the building."
msgstr ""
"គម្រប​ឧបករណ៍​យោក​ត្រូវ​ប្រើ ដើម្បី​ត្រង​យក​ឧស្ម័ន​ចេញ​ពី​ប្រតិកម្ម​គីមី ។  នៅ​ពេល​បាន​សម្អាត​ហើយ ខ្យល់​នឹង​ត្រូវ​បូម​"
"ចេញ​ទៅ​ក្រៅ​អគារ ។"

#. i18n: file: data/tools.xml:189
#: rc.cpp:2612
msgid "Contact Thermometer"
msgstr "ទែម៉ូម៉ែត្រ​កុងតាក់"

#. i18n: file: data/tools.xml:190
#: rc.cpp:2614
msgid ""
"Contact thermometers differ from regular thermometers in that they are "
"connected to a heating coil, and are hence able to both sense and control "
"the current temperature.  In doing so, they allow experiments to be "
"performed under a constant temperature.  Contact thermometers work using a "
"negative feedback loop: once the desired temperature has been reached, the "
"heating coil is deactivated; when the temperature falls, the heating coil is "
"reactivated."
msgstr ""
"ទែម៉ូម៉ែត្រ​កុងតាក់​ខុស​ពី​ទែម៉ូម៉ែត្រ​ធម្មតា ត្រង់​ថា ពួក​វា​ត្រូវ​បាន​តភ្ជាប់​ទៅ​​នឹង​រង្វេល​កម្ដៅ​  ដូច្នេះ​ហើយ ទើប​"
"ពួក​វា​អាច​ដឹង និង​ត្រួត​ពិនិត្យ​សីតុណ្ហភាព​បច្ចុប្បន្ន​បាន​ ។ ធ្វើ​ដូច្នេះ ពួក​វា​នឹង​អនុញ្ញាត​ឲ្យ​មាន​ការ​អនុវត្ត​​ការ​"
"ពិសោធន៍​ក្រោម​សីតុណ្ហភាព​ថេរ ។  ទែម៉ូម៉ែត្រ​កុងតាក់​ដំណើរការ​ដោយ​ប្រើ​រង្វង់​ឥទ្ធិពល​ត្រឡប់​អវិជ្ជមាន​ ៖ នៅ​ពេល​"
"ឈាន​ដល់​កម្រិត​សីតុណ្ហភាព​ដែល​ចង់​បាន​ហើយ រង្វេល​កម្ដៅ​នឹង​ត្រូវ​បិទ នៅ​ពេល​សីតុណ្ហភាព​ធ្លាក់​ចុះ រង្វេល​កម្ដៅ​នឹង​"
"ត្រូវ​បើក​ឡើង​វិញ ។"

#. i18n: file: data/tools.xml:194
#: rc.cpp:2616
msgid "Clamps"
msgstr "អង្គំ"

#. i18n: file: data/tools.xml:195
#: rc.cpp:2618
msgid "Laboratory clamps make it easier to hold many kinds of tools."
msgstr "ការ​ប្រើ​អង្គំ​នៅ​ក្នុងទី​​ពិសោធន៍​ធ្វើ​ឲ្យ​វា​ងាយ​ស្រួល​នៅ​ក្នុង​ការ​ទប់​ឧបករណ៍​ជាច្រើន​ប្រភេទ ។"

#. i18n: file: data/tools.xml:199
#: rc.cpp:2620
msgid "Indicator Paper"
msgstr "ក្រដាស​ចង្អុល​ពណ៌"

#. i18n: file: data/tools.xml:200
#: rc.cpp:2622
msgid ""
"There are multiple ways of measuring the pH value of a solution, one of "
"which is to use indicator paper. Indicator paper changes color depending on "
"the pH of the solution applied to it, and by comparing to a chart a fairly "
"accurate measure of the solution's pH can be obtained.  If a more accurate "
"measure is needed, a glass electrode can be used, which works by measuring "
"the conductivity of the solution."
msgstr ""
"មាន​វិធីសាស្ត្រ​ជា​ច្រើន​ប្រភេទ​ក្នុង​ការ​វាស់​តម្លៃ​ pH នៃ​សូលុយស្យុង​ វិធីសាស្ត្រ​មួយ​ គឺ​ត្រូវ​ប្រើ​ក្រដាស​ចង្អុល​ពណ៌ "
"។ ក្រដាស​ចង្អុល​ពណ៌​ប្ដូរ​ពណ៌​ដោយ​ផ្អែក​លើ​តម្លៃ​ pH នៃ​សូលុយស្យុង​ដែល​បាន​អនុវត្ត​​ទៅ​លើ​វា និង​​ដោយ​ការ​ប្រៀប​ធៀប​"
"ជា​មួយ​តារាង​​ គេ​នឹង​ទទួល​បាន​រង្វាស់​ pH របស់​សូលុយស្យុង​ដែល​ត្រឹម​ត្រូវ ។  បើ​ត្រូវ​ការ​រង្វាស់​ដែល​ត្រឹម​ត្រូវ​ជាង​"
"នេះ  គេ​នឹង​ប្រើ​អេឡិចត្រូត​កញ្ចក់​ ដែល​​ដំណើរ​ការ​ដោយ​ការ​វាស់​ភាព​ចំលង​នៃ​សូលុយស្យុង ។"

#. i18n: file: data/tools.xml:204
#: rc.cpp:2624
msgid "Short-Stem Funnel"
msgstr "ជី​ឡាវ​ក​ស្ដួច​ខ្លី"

#. i18n: file: data/tools.xml:205
#: rc.cpp:2626
msgid ""
"A funnel can be used to fill a narrow-necked vessel with a liquid or fine "
"powder."
msgstr "ជីឡា​វនេះ​​អាច​ត្រូវបាន​ប្រើ​សម្រាប់​បំពេញ​ភាជន៍​ដែល​មាន​មាត់​តូច​ជាមួយ​នឹង​​វត្ថុ​រាវ​ ឬម្សៅម៉ដ្ឋ ។"

#. i18n: file: data/tools.xml:209
#: rc.cpp:2628
msgid "Buret"
msgstr "ប៊ុយរ៉ែត"

#. i18n: file: data/tools.xml:210
#: rc.cpp:2630
msgid ""
"Burets are used to titrate liquids.  A buret is filled with a specific "
"volume of a liquid, and placed beneath it is a container such as an "
"Erlenmeyer flask.  By opening the valve on the buret, the liquid in the "
"container will then be titrated.  High-quality burets have a venting "
"mechanism with which they can be very easily refilled with the exact volume "
"for which the buret is calibrated."
msgstr ""
"ប៊ុយរ៉ែត​ត្រូវ​ប្រើ​ ដើម្បី​កំណត់​អត្រា​​វត្ថុ​រាវ​ ។  ប៊ុយរ៉ែត​ត្រូវ​បាន​បំពេញ​ដោយ​មាឌ​នៃ​វត្ថុរាវ​ជាក់​លាក់ និង​ត្រូវ​បាន​"
"ដាក់​នៅ​ខាង​ក្រោម​ វា​គឺ​ជា​ឧបករណ៍​ផ្ទុក​ដូច​ជា​ដបអ៊ែឡិនម៉ីយែ​ដែរ ។​  ដោយ​ការ​បើក​វ៉ាល​នៅ​លើ​ប៊ុយរ៉ែត​ វត្ថុ​រាវ​នៅ​"
"ក្នុង​ឧបករណ៍​ផ្ទុក​នឹង​ត្រូវ​បាន​កំណត់​អត្រា​​ ។ ប៊ុយរ៉ែត​ដែល​មាន​គុណភាព​ខ្ពស់​មាន​ចលន​ការ​បញ្ចេញ​ដែល​អាច​បំពេញ​ពួក​វា​"
"ឡើង​វិញ​ដោយ​ងាយ​ ដោយ​មាន​មាឌ​ជាក់​ស្ដែង​សម្រាប់​ប៊ុយរ៉ែត​ណា​មួយ​ដែល​បាន​ក្រិត​ខ្នាត ។"

#. i18n: file: data/tools.xml:214
#: rc.cpp:2632
msgid "Beaker"
msgstr "បេស៊ែ"

#. i18n: file: data/tools.xml:215
#: rc.cpp:2634
msgid ""
"Beakers can be used for many tasks.  For instance, they are used to store "
"chemicals and to perform chemical reactions.  They are often also used for "
"titrations."
msgstr ""
"បេស៊ែ​ត្រូវ​បាន​ប្រើ​សម្រាប់​ការ​ងារ​​ច្រើន​យ៉ាង ។ ឧទាហរណ៍ ពួក​វា​ត្រូវ​បាន​ប្រើ​ដើម្បី​ស្តុក​ទុក​សារ​ធាតុ​គីមី និង​"
"ដើម្បី​អនុវត្ត​ប្រតិកម្ម​គីមី ។  ជា​ញឹក​ញាប់ ពួក​វា​ក៏​ត្រូវ​បាន​ប្រើ​សម្រាប់​អត្រា​កម្ម​ផង​ដែរ ។"

#. i18n: file: data/tools.xml:219
#: rc.cpp:2636
msgid "DSC (Differential Scanning Calorimeter)"
msgstr "DSC (កាឡូរីម៉ែត្រស្កេន​​ឌីផេរ៉ង់ស្យែល)"

#. i18n: file: data/tools.xml:220
#: rc.cpp:2638
msgid ""
"A DSC measures the heat flow volume of a compound.  This value is very "
"specific for every kind of matter, and thus a DSC can be used to identify "
"chemicals or to describe them."
msgstr ""
"A DSC វាស់​មាឌ​លំហូរ​កម្ដៅ​នៃ​សមាស​ធាតុ ។  តម្លៃ​នេះ​មាន​ភាព​ជាក់​លាក់​សម្រាប់​គ្រប់​ប្រភេទ​​រូប​ធាតុ​ទាំង​អស់​ "
"ហេតុ​ដូច្នេះ  DSC អាច​ត្រូវ​ប្រើ ដើម្បី​រក​អត្តសញ្ញាណ​នៃ​សារ​ធាតុ​គីមី ឬ​ដើម្បី​ពិពណ៌នា​អំពី​ពួកវា​ ។"

#. i18n: file: data/tools.xml:224
#: rc.cpp:2640
msgid "Dewar Vessel"
msgstr "ភាជន៍ Dewar"

#. i18n: file: data/tools.xml:225
#: rc.cpp:2642
msgid ""
"A Dewar vessel (or Dewar flask), named after the physicist Sir James Dewar "
"(1842-1923), is a double-walled vacuum flask, designed to provide good "
"thermal insulation.  As such, they are useful for keeping liquids cool or "
"warm.  One well-known example of a Dewar vessel is a Thermos flask."
msgstr ""
"ភាជន៍  Dewar  (ឬ​កែវ​ Dewar ) ត្រូវ​បាន​ដាក់​ឈ្មោះ​តាម​​រូប​វិទូ​ គឺ​​ Sir James Dewar (១​៨​៤​២-១​៩​២​"
"៣) គឺ​ជា​កែវ​សុញ្ញាកាស​ដែល​មាន​ផ្ទៃ​ពីរ​ជាន់​ ដែល​មាន​មុខងារ​ក្នុង​ការ​ផ្ដល់​អ៊ីសូឡង់កម្ដៅ​បាន​ល្អ ។ ដូច្នេះ ពួក​វា​"
"មាន​ប្រយោជន៍​បំផុត​សម្រាប់​ការ​រក្សា​វត្ថុ​រាវ​ឲ្យ​នៅ​ត្រជាក់​ ឬ​ក្ដៅ ។ គំរូ​ដ៏​ល្បី​ល្បាញ​មួយ​ទៀត​របស់​ភាជន៍​ Dewar គឺ​"
"កែវ Thermos ។"

#. i18n: tag label attribute value
#. i18n: file: element_tiny.xml:2
#: rc.cpp:2645
msgid "Dummy"
msgstr "រូប​តាង"

#. i18n: tag label attribute value
#. i18n: file: element_tiny.xml:3
#: rc.cpp:2648
msgid "Hydrogen"
msgstr "អ៊ីដ្រូសែន"

#. i18n: tag label attribute value
#. i18n: file: element_tiny.xml:5
#: rc.cpp:2651
msgid "Helium"
