#: klettres.cpp:108
msgid ""
"The file sounds.xml was not found in\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"Please install this file and start KLettres again.\n"
"\n"
msgstr ""
"បាន​រកឃើញ​ឯកសារ sounds.xml នៅក្នុង\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"សូម​ដំឡើង​ឯកសារ​នេះ ហើយ​ចាប់ផ្ដើម KLettres ម្ដងទៀត ។\n"
"\n"

#: klettres.cpp:111
msgid "KLettres - Error"
msgstr "KLettres - កំហុស"

#: klettres.cpp:130
msgid "New Sound"
msgstr "សំឡេង​ថ្មី"

#: klettres.cpp:134
msgid "Play a new sound"
msgstr "លេង​សំឡេង​ថ្មី"

#: klettres.cpp:135
msgid ""
"You can play a new sound by clicking this button or using the File menu, New "
"Sound."
msgstr "អ្នក​អាច​ចាក់​សំឡេង​ថ្មី ដោយ​ចុច​ប៊ូតុង​នេះ ឬ​ប្រើ​ម៉ឺនុយ ឯកសារ -> សំឡេងថ្មី ។"

#: klettres.cpp:138
msgid "Get Alphabet in New Language..."
