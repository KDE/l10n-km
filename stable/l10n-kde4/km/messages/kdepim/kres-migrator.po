#: kabcmigrator.cpp:53
#, kde-format
msgid ""
"Unsupported file format found. The file format '%1' is no longer supported, "
"please convert to another one."
msgstr ""
"រកឃើញ​ទ្រង់ទ្រាយ​ឯកសារ​ដែល​មិនបានគាំទ្រ ។ ទ្រង់ទ្រាយ​ឯកសារ '%1' លែង​គាំទ្រ​ទៀត​ហើយ សូម​បម្លែង​ទៅ​"
"ទ្រង់ទ្រាយ​ផ្សេង ។"

#: kabcmigrator.cpp:57
#, kde-format
msgid "File format '%1' is not yet supported natively."
msgstr "ទ្រង់ទ្រាយ​ឯកសារ '%1' មិនត្រូវ​បាន​គាំទ្រ​នៅឡើយ​ទេ ។"

#: kabcmigrator.cpp:67 kcalmigrator.cpp:54
#, kde-format
msgid "Failed to create resource: %1"
msgstr "បាន​បរាជ័យ​ក្នុងការ​បង្កើត​ប្រភព ៖ %1"

#: kcalmigrator.cpp:77
#, kde-format
msgid "Failed to create birthdays resource: %1"
msgstr "បាន​បរាជ័យ​ក្នុងកា​របង្កើត​ប្រភព​ថ្ងៃ​កំណើត ៖ %1"

#: kresmigratorbase.cpp:106
#, kde-format
msgid "Trying to migrate '%1' to compatibility bridge..."
msgstr "ព្យាយាម​ប្ដូរ '%1' ឲ្យ​ឆប​គ្នា​នឹង​ប្រ៊ីត..."

#: kresmigratorbase.cpp:115
#, kde-format
msgid "Unable to create compatibility bridge: %1"
msgstr "មិនអាច​បង្កើត​ប្រ៊ីត​ឆបគ្នា​បានទេ ៖ %1"

#: kresmigratorbase.cpp:151
#, kde-format
msgid "Migration of '%1' to compatibility bridge failed: %2"
msgstr "បាន​បរាជ័យ​​ក្នុង​ការ​ប្ដូរ '%1' ឲ្យ​ឆប​គ្នា​នឹង​ប្រ៊ីត ៖ %2"

#: kresmigratorbase.cpp:154
#, kde-format
msgid "Migration of '%1' to native backend failed: %2"
msgstr "បានបរាជ័យ​ក្នុងការ​ប្ដូរ​ '%1' ទៅ​កម្មវិធី​ផ្នែកខាង​ក្រោយ​ដើម ៖ %2"

#: kresmigratorbase.cpp:182
#, kde-format
msgid "Unable to obtain resource type '%1'."
msgstr "មិនអាច​យក​ប្រភេទ​ប្រភព '%1' បានទេ ។"

#: main.cpp:46
msgid "KResource Migration Tool"
msgstr "ឧបករណ៍​ប្ដូរ KResource"

#: main.cpp:48
msgid "Migration of KResource settings and application to Akonadi"
msgstr "ប្ដូរការ​កំណត់ KResource និង​កម្មវិធី Akonadi"

#: main.cpp:50
msgid "(c) 2008 the Akonadi developers"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៨ ដោយ​អ្នក​អភិវឌ្ឍន៍ Akonadi"

#: main.cpp:54
msgid "Volker Krause"
msgstr "Volker Krause"

#: main.cpp:54
msgid "Author"
msgstr "អ្នកនិពន្ធ"

#: main.cpp:60
msgid "Only migrate to Akonadi KResource bridges"
msgstr "ប្ដូរ​តែ​ទៅ​ប្រ៊ីត Akonadi KResource ប៉ុណ្ណោះ"

#: main.cpp:61
msgid "Omit setting up of the client side compatibility bridges"
msgstr "លុប​ការ​កំណត់​​នៃ​ផ្នែកខាង​ម៉ាស៊ីន​ភ្ញៀវ​ឲ្យ​ឆប​គ្នា​នឹង​ប្រ៊ីត"

#: main.cpp:62
msgid "Only migrate contact resources"
msgstr "ប្តូរ​តែ​ប្រភព​ទំនាក់ទំនង​ប៉ុណ្ណោះ"

#: main.cpp:63
msgid "Only migrate calendar resources"
msgstr "ប្ដូរ​តែ​ប្រភព​ប្រតិទិន​ប៉ុណ្ណោះ"

#: main.cpp:64
msgid "Only migrate the specified types (supported: contact, calendar)"
msgstr "ប្ដូរ​តែ​ប្រភេទ​ដែល​បាន​បញ្ជាក់​ប៉ុណ្ណោះ (បានគាំទ្រ ៖ ទំនាក់ទំនង ប្រតិទិន)"

#: main.cpp:66
msgid "Show reporting dialog"
msgstr "បង្ហាញ​ប្រអប់​របាយការណ៍"

#: main.cpp:67
msgid "Show report only if changes were made"
msgstr "បង្ហាញះ​តែ​ក្នុងករណី​ដែល​ត្រូវ​បាន​ធ្វើ​ឡើង"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម,​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,vannak@khmeros.info,piseth_dv@khmeros.info"

#: kresmigrator.h:75
msgid "Client-side bridge already set up."
msgstr "បាន​រៀបចំ​ប្រ៊ីត​ខាង​ម៉ាស៊ីន​ភ្ញៀវ​រួច​ហើយ ។"

#: kresmigrator.h:81
#, kde-format
msgid "Trying to migrate '%1'..."
msgstr "កំពុង​ព្យាយាម​ប្ដូរ​ '%1'..."

#: kresmigrator.h:88
#, kde-format
msgid "No native backend for '%1' available."
msgstr "មិនមាន​កម្មវិធី​ផ្នែក​ខាងក្រោយ​ដើម '%1' នោះទេ ។"

#: kresmigrator.h:96
#, kde-format
msgid "'%1' has already been migrated."
msgstr "'%1' ត្រូវ​បាន​ប្ដូរ​រួច​ហើយ ។"

#: kresmigrator.h:135
#, kde-format
msgid "Trying to migrate '%1' from compatibility bridge to native backend..."
msgstr "ព្យាយាម​ប្ដូរ '%1' ពី​ប្រ៊ីត​ឆបគ្នា​ទៅ​កម្មវិធី​ផ្នែក​ខាងក្រោម​ដើម..."

#: kresmigrator.h:139
#, kde-format
msgid "No native backend available, keeping compatibility bridge for '%1'."
msgstr "មិនមាន​កម្មវិធី​ផ្នែក​ខាងក្រោយ​ដើម​ទេ  រក្សា​​ប្រ៊ីត​​​ឆបគ្នា​​សម្រាប់ '%1' ។"

#: kresmigrator.h:169
#, kde-format
msgid "Migration of '%1' succeeded."
msgstr "កា​រប្ដូរ '%1' បាន​ជោគជ័យ ។"

#: kresmigrator.h:177
#, kde-format
msgid "Migration of '%1' to compatibility bridge succeeded."
msgstr "ការ​ប្ដូរ '%1' ទៅ​ប៊្រីត​ឆបគ្នា​បានជោគជ័យ ។"

#: kresmigrator.h:199
msgid "Setting up client-side bridge..."
msgstr "កំពុង​រៀបចំ​ប៊្រីត​ខាង​ម៉ាស៊ីន​ភ្ញៀវ..."

#: kresmigrator.h:203
msgid "Akonadi Compatibility Resource"
msgstr "ប្រភព​ភព​ឆបគ្នា​ Akonadi"

#: kresmigrator.h:206
msgid "Client-side bridge set up successfully."
msgstr "បាន​រៀបចំ​ប៊្រីត​ខាង​ម៉ាស៊ីន​ភ្ញៀវ​ដោយ​ជោគជ័យ ។"

#: kresmigrator.h:208
msgid ""
"Could not create client-side bridge, check if Akonadi KResource bridge is "
"installed."
msgstr ""
"មិនអាច​បង្កើត​ប្រ៊ីត​ខាង​ម៉ាស៊ីន​ភ្ញៀវ​បានទេ ពិនិត្យ​មើល​ប្រសិន​បើ​ប៊្រីត Akonadi KResource ត្រូវ​បាន​ដំឡើង ។"
