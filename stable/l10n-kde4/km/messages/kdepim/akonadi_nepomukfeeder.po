#: nepomukfeederagentbase.cpp:218
#, kde-format
msgid "Indexing collection '%1'..."
msgstr "កំពុង​ដាក់​លិបិក្រម​​ការ​ប្រមូល​ផ្ដុំ '%1'..."

#: nepomukfeederagentbase.cpp:271
msgid "Indexing completed."
msgstr "បាន​បញ្ចប់​ការ​ដាក់​លិបិក្រម"

#: nepomukfeederagentbase.cpp:328
msgid "Unable to start the Nepomuk server."
msgstr "មិន​អាច​ចាប់ផ្ដើម​ម៉ាស៊ីន​បម្រើ Nepomuk បាន​ទេ ។"

#: nepomukfeederagentbase.cpp:334 nepomukfeederagentbase.cpp:355
msgid "Waiting for the Nepomuk server to start..."
msgstr "កំពុង​រង់ចាំ​ម៉ាស៊ីន​បម្រើ Nepomuk ចាប់ផ្ដើម..."

#: nepomukfeederagentbase.cpp:348
#, kde-format
msgid "A blacklisted backend is used: '%1'."
msgstr "កម្មវិធី​ផ្នែក​ខាង​ក្រោយ​នៃ​បញ្ជី​ខ្មៅ​ត្រូវ​បាន​ប្រើ ៖ '%1' ។"

#: nepomukfeederagentbase.cpp:350
#, kde-format
msgid "Calling the Nepomuk storage service failed: '%1'."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ហៅ​សេវា​ផ្ទុក​របស់ Nepomuk ៖ '%1' ។"

#: nepomukfeederagentbase.cpp:358
msgid "Nepomuk is not running."
msgstr "Nepomuk មិន​កំពុង​ដំណើរការ​ទេ ។"

#: nepomukfeederagentbase.cpp:365
msgid "Nepomuk backend for Strigi is not available."
msgstr "កម្មវិធី​ផ្នែក​ខាងក្រោយ Nepomuk សម្រាប់ Strigi មិន​អាច​ប្រើ​បាន​ទេ ។"

#: nepomukfeederagentbase.cpp:376
msgid "Ready to index data."
msgstr "រួចរាល់​ដើម្បី​ដាក់​លិបិក្រម​ទិន្នន័យ ។"

#: nepomukfeederagentbase.cpp:383
#, kde-format
msgid ""
"<b>Nepomuk Indexing Agents Have Been Disabled</b><br/>The Nepomuk service is "
"not available or fully operational and attempts to rectify this have failed. "
"Therefore indexing of all data stored in the Akonadi PIM service has been "
"disabled, which will severely limit the capabilities of any application "
"using this data.<br/><br/>The following problems were detected:<ul><li>%1</"
"li></ul>Additional help can be found here: <a href=\"http://userbase.kde.org/"
"Akonadi\">userbase.kde.org/Akonadi</a>"
msgstr ""
"<b>ភ្នាក់ងារ​ដាក់​លិបិក្រម​របស់ Nepomuk ត្រូវ​បាន​បិទ​</b><br/>សេវា Nepomuk មិនអាច​ប្រើបាន​ ឬ​ហើយ​"
"បាន​បរាជ័យ​ក្នុងការ​​ប៉ុនប៉ង​កែតម្រូវ​បាន ។ ដូច្នេះ​កា​រដាក់​លិបិក្រម​គ្រប់​ទិន្នន័យ​ទាំងអស់​ត្រូវបាន​រក្សាទុក​នៅ​ក្នុង​"
"សេវា​ Akonadi PIM ត្រូវ​បាន​បិទ ដែលនឹង​កំណត់​សមត្ថភាព​កម្មវិធី​ជាក់លាក់​ឲ្យ​ប្រើ​ទិន្នន័យ​​នេះ ។<br/><br/"
">បញ្ហា​ដូច​ខាងក្រោម​ត្រូវបាន​រក​ឃើញ ៖<ul><li>%1</li></ul>ជំនួយ​បន្ថែម​អាច​រក​បាននៅទី​នេះ ៖ <a "
"href=\"http://userbase.kde.org/Akonadi\">userbase.kde.org/Akonadi</a>"

#: nepomukfeederagentbase.cpp:392
msgid "Nepomuk not operational"
msgstr "Nepomuk មិន​ដំណើរការ​ទេ"

#: nepomukfeederagentbase.cpp:395
msgid "Nepomuk Indexing Disabled"
msgstr "បានបិទ​ការ​ដាក់​លិបិក្រម Nepomuk"

#: nepomukfeederagentbase.cpp:448
msgid "Strigi is not available for indexing."
msgstr "Strigi មិន​អាច​ប្រើ​បាន​សម្រាប់​ដាក់​លិបិក្រម​ទេ ។"
