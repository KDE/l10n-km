msgstr "បន្ថែម​តម្រង​នេះ​ទៅ​ម៉ឺនុយ អនុវត្តតម្រង"

#: kmfilterdlg.cpp:256
msgid "Shortcut:"
msgstr "​ផ្លូវ​កាត់ ៖"

#: kmfilterdlg.cpp:265
msgid "Additionally add this filter to the toolbar"
msgstr "បន្ថែម​តម្រង​នេះ ទៅ​របារ​ឧបករណ៍​ផង​ដែរ"

#: kmfilterdlg.cpp:270
msgid "Icon for this filter:"
msgstr "រូបតំណាង​សម្រាប់​តម្រង​នេះ ៖"

#: kmfilterdlg.cpp:633
