#: text_calendar.cpp:360
#, kde-format
msgid "No attachment named \"%1\" found in the invitation."
msgstr "រក​មិនឃើញ​ឯកសារ​ភ្ជាប់ដែលមាន​ឈ្មោះ \"%1\" នៅ​ក្នុងការ​អញ្ជើញ​ទេ ។"

#: text_calendar.cpp:368
#, kde-format
msgid ""
"The invitation attachment \"%1\" is a web link that is inaccessible from "
"this computer. Please ask the event organizer to resend the invitation with "
"this attachment stored inline instead of a link."
msgstr ""
"ឯកសារ​ភ្ជាប់នៃ​ការ​អញ្ជើញ​ \"%1\" គឺ​ជា​តំណ​បណ្ដាញ​ដែល​មិនអាច​ចូលដំណើរការ​ពី​កុំព្យូទ័រ​នេះ​ទេ ។ សូម​សួរ​"
"អ្នករៀបចំ​ព្រឹត្តិការណ៍​ ដើម្បី​ផ្ញើ​ការ​អញ្ជើញ​ដែលមានឯកសារ​ភ្ជាប់នេះ​ម្ដ​ង​ទៀត​ដែលបានទុក​នៅ​ក្នុង​តួ​ជំនួស​តំណ ។"

#: text_calendar.cpp:415
msgid ""
"<qt>None of your identities match the receiver of this message,<br />please "
"choose which of the following addresses is yours, if any, or select one of "
"your identities to use in the reply:</qt>"
msgstr "<qt>គ្មាន​អត្តសញ្ញាណ​របស់​អ្នក​ផ្គូផ្គង​នឹង​អ្នក​ទទួល​សារ​នេះ​ទេ<br />សូម​ជ្រើស​អាសយដ្ឋាន​ដូច​ខាង​ក្រោម​ណាមួយ​ដែល​ជា​របស់​អ្នក ប្រសិនបើ​មាន ឬ​​ជ្រើស​អត្តសញ្ញាណ​មួយ​ក្នុង​ចំណោម​អត្តសញ្ញាណ​ជា​ច្រើន​របស់​អ្នក​ ដើម្បី​ប្រើ​នៅ​ក្នុង​ការ​ឆ្លើយ​តប ៖</qt>"

#: text_calendar.cpp:422
msgid ""
"<qt>Several of your identities match the receiver of this message,<br /"
">please choose which of the following addresses is yours:</qt>"
msgstr ""
"<qt>អត្តសញ្ញាណ​របស់​អ្នក​ជាច្រើន​ផ្គូផ្គង​នឹង​អ្នក​ទទួលសារ​នេះ<br /"
">សូម​ជ្រើស​អាសយដ្ឋាន​ដូច​ខាង​ក្រោម​ណាមួយ​ជា​របស់​អ្នក ៖</qt>"

#: text_calendar.cpp:437
#| msgid "Select Attendees"
msgid "Select Address"
msgstr "ជ្រើស​​អាសយដ្ឋាន"

#: text_calendar.cpp:493
#| msgid "Answer: %1"
msgid "Answer: "
msgstr "ចម្លើយ ៖ "

#: text_calendar.cpp:495
#, kde-format
#| msgid "Delegated: %1"
msgctxt "Not able to attend."
msgid "Declined: %1"
msgstr "បាន​បដិសេធ ៖ %1"

#: text_calendar.cpp:497
#, kde-format
#| msgid "Delegated: %1"
msgctxt "Unsure if it is possible to attend."
msgid "Tentative: %1"
msgstr "សាកល្បង ៖ %1"

#: text_calendar.cpp:499
#, kde-format
#| msgid "Delegated: %1"
msgctxt "Accepted the invitation."
msgid "Accepted: %1"
msgstr "បាន​ទទួល ៖ %1"

#: text_calendar.cpp:626
msgid "Incidence with no summary"
msgstr "ឧប្បត្ដិហេតុ​​ដែល​គ្មាន​សេចក្ដី​សង្ខេប"

#: text_calendar.cpp:630
#, kde-format
msgid "Answer: %1"
msgstr "ចម្លើយ ៖ %1"

#: text_calendar.cpp:633
#, kde-format
msgid "Delegated: %1"
msgstr "បាន​ទទួល ៖ %1"

#: text_calendar.cpp:636
#, kde-format
msgid "Forwarded: %1"
msgstr "បាន​បញ្ជូន​បន្ត ៖ %1"

#: text_calendar.cpp:639
#, kde-format
msgid "Declined Counter Proposal: %1"
msgstr "បាន​បដិសេធ​សំណើ​របស់​កម្មវិធី​​រាប់ ៖ %1"

#: text_calendar.cpp:710
msgid "Reaction to Invitation"
msgstr "ប្រតិកម្ម​ចំពោះ​កា​រអញ្ជើញ"

#: text_calendar.cpp:711 text_calendar.cpp:932
msgid "Comment:"
msgstr "សេចក្ដី​អធិប្បាយ ៖"

#: text_calendar.cpp:744
msgid "Delegation to organizer is not possible."
msgstr "មិន​អាច​ទទួល​ដើម្បី​រៀបចំ ។"

#: text_calendar.cpp:866
msgid "Save Invitation Attachment"
msgstr "រក្សាទុក​ការ​អញ្ជើញ​ជា​ឯកសារ​ភ្ជាប់"

#: text_calendar.cpp:873
#, kde-format
msgctxt "@info"
msgid "File <filename>%1</filename> exists.<nl/> Do you want to replace it?"
msgstr "មាន​ឯកសារ <filename>%1</filename> រួច​ហើយ ។<nl/> តើ​អ្នក​ចង់ជំនួស​វា​ទេ ?"

#: text_calendar.cpp:931
msgid "Decline Counter Proposal"
msgstr "បដិសេធ​សំណើ​របស់​កម្មវិធី​រាប់"

#: text_calendar.cpp:965
msgid ""
"You have no writable calendar folders for invitations, so storing or saving "
"a response will not be possible.\n"
"Please create at least 1 writable events calendar and re-sync."
msgstr ""
"អ្នក​មិនមាន​ថត​ប្រតិទិន​ដែលអាច​សរសេរ​បាន​សម្រាប់​ការ​អញ្ជើញ​នេះ​ទេ ដូច្នេះ​ការ​តម្រៀប ឬ​រក្សាទុក​ការ​ឆ្លើយតប​មិន​អាច​ធ្វើបាន​ទេ ។\n"
"សូម​បង្កើត​យ៉ាង​ហោចណាស់​ប្រតិទិន​ព្រឹត្តិការណ៍​ដែល​អាច​សរសេរ​បាន​ ១ ហើយ​ធ្វើ​សមកាលកម្ម ។"

#: text_calendar.cpp:1032
msgctxt "@info"
msgid ""
"The organizer is not expecting a reply to this invitation but you can send "
"them an email message if you desire.\n"
"\n"
"Would you like to send the organizer a message regarding this invitation?\n"
"Press the [Cancel] button to cancel the recording operation."
msgstr ""
"អ្នក​រៀបចំ​មិនរំពឹង​ថា​ឆ្លើយតប​ទៅ​ការ​អញ្ជើញ​នេះ​ទេ ប៉ុន្តែ​អ្នក​អាច​ផ្ញើ​អ៊ីមែល​ឲ្យ​ពួកគេ​បាន ប្រសិនបើ​អ្នក​ចង់ ។\n"
"\n"
"តើ​អ្នក​ចង់​ផ្ញើ​សារ​ឲ្យ​អ្នក​រៀបចំ​ទាក់ទង​នឹង​ការ​អញ្ជើញ​នេះ​ឬ ?\n"
"ចុច​ប៊ូតុង [បោះបង់] ដើម្បី​បោះបង់​ប្រតិបត្តិការ​ថត ។"

#: text_calendar.cpp:1036
#| msgid "Could not save file to KOrganizer"
msgctxt "@title:window"
msgid "Send Email to Organizer"
msgstr "ផ្ញើ​អ៊ីមែល​ទៅ​អ្នក​រៀបចំ"

#: text_calendar.cpp:1037
msgid "Do Not Send"
msgstr "កុំ​ផ្ញើ"

#: text_calendar.cpp:1038
msgid "Send EMail"
msgstr "ផ្ញើ​អ៊ីមែល"

#: text_calendar.cpp:1046
#, kde-format
#| msgid "Answer: %1"
msgid "Re: %1"
msgstr "ឆ្លើយតប ៖ %1"

#: text_calendar.cpp:1108
msgid "Open Attachment"
msgstr "បើក​ឯកសារ​ភ្ជាប់"

#: text_calendar.cpp:1110
msgid "Save Attachment As..."
msgstr "រក្សាឯកសា​រ​ភ្ជាប់​ទុក​ជា..."

#: text_calendar.cpp:1127
msgid "Accept invitation"
msgstr "ទទួល​យក​ការអញ្ជើញ"

#: text_calendar.cpp:1129
msgid "Accept invitation conditionally"
msgstr "ទទួល​យកការ​អញ្ជើញ​​​តាម​លក្ខខណ្ឌ"

#: text_calendar.cpp:1131
msgid "Accept counter proposal"
msgstr "ទទួល​យក​សំណើ​របស់​កម្មវិធី​រាប់"

#: text_calendar.cpp:1133
msgid "Create a counter proposal..."
msgstr "បង្កើត​សំណើ​កម្មវិធីរាប់..."

#: text_calendar.cpp:1135
msgid "Throw mail away"
msgstr "បោះ​សំបុត្រ​ចោល"

#: text_calendar.cpp:1137
msgid "Decline invitation"
msgstr "​បដិសេធ​កា​រអញ្ជើញ"

#: text_calendar.cpp:1139
msgid "Decline counter proposal"
msgstr "បដិសេធ​សំណើ​របស់​កម្មវិធី​រាប់"

#: text_calendar.cpp:1141
msgid "Check my calendar..."
msgstr "ពិនិត្យ​ប្រតិទិន​របស់​ខ្ញុំ..."

#: text_calendar.cpp:1143
msgid "Record response into my calendar"
msgstr "ថត​ការឆ្លើយតប​ទុកក្នុង​ប្រតិទិន​របស់ខ្ញុំ"

#: text_calendar.cpp:1145
#| msgid "Remove invitation from my calendar"
msgid "Record invitation into my calendar"
msgstr "ថត​ការ​អញ្ជើញ​​ក្នុង​ប្រតិទិន​របស់​ខ្ញុំ"

#: text_calendar.cpp:1147
#| msgid "Remove invitation from my calendar"
msgid "Move this invitation to my trash folder"
msgstr "ផ្លាស់ទី​ការ​អញ្ជើញ​នេះ​ទៅ​កាន់​ថត​ធុងសំរាម​របស់​ខ្ញុំ"

#: text_calendar.cpp:1149
msgid "Delegate invitation"
msgstr "ទទួល​ការ​អញ្ជើញ"

#: text_calendar.cpp:1151
msgid "Forward invitation"
msgstr "បញ្ជូន​ការអញ្ជើញ​ត"

#: text_calendar.cpp:1153
msgid "Remove invitation from my calendar"
msgstr "យក​ការ​អញ្ជើញ​ចេញ​ពី​ប្រតិទិន​របស់​ខ្ញុំ"

#: text_calendar.cpp:1156
#, kde-format
msgid "Open attachment \"%1\""
msgstr "បើក​ឯកសារ​ភ្ជាប់ \"%1\""

#: attendeeselector.cpp:32
msgid "Select Attendees"
msgstr "ជ្រើស​អ្នក​ចូល​រួម​ថ្មី"

#: attendeeselector.cpp:42
msgid "Click to add a new attendee"
msgstr "ចុច ដើម្បី​បន្ថែម​អ្នក​ចូលរួម​ថ្មី"

#: delegateselector.cpp:34
msgid "Select delegate"
msgstr "ជ្រើស​កា​រទទួលយក"

#: delegateselector.cpp:41
msgid "Delegate:"
msgstr "ទទួល​យក ៖"

#: delegateselector.cpp:44
msgid "Keep me informed about status changes of this incidence."
msgstr "ជូន​ដំណឹង​ខ្ញុំជា​និច្ច​អំពី​ការ​ផ្លាស់ប្ដូរ​ស្ថានភាព​នៃ​ឧប្បត្តិហេតុ​នេះ ។"

