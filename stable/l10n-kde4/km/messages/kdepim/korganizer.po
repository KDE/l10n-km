#: koeditorrecurrence.cpp:625
msgctxt "@title:group"
msgid "E&xceptions"
msgstr "ករណី​លើកលែង"

#: koeditorrecurrence.cpp:633
msgctxt "@info:whatsthis"
msgid ""
"A date that should be considered an exception to the recurrence rules for "
"this event or to-do."
msgstr ""
"កាលបរិច្ឆេទ​ដែល​គួរ​ត្រូវ​បាន​ចាត់​ទុក​ជា​ករណី​លើកលែង​ចំពោះ​ច្បាប់​កើតឡើង​ដដែលៗ សម្រាប់​ព្រឹត្តិការណ៍ ឬ​ការងារ​"
"ត្រូវ​ធ្វើ​នេះ ។"

#: koeditorrecurrence.cpp:639
msgctxt "@action:button"
msgid "&Add"
msgstr "បន្ថែម"

#: koeditorrecurrence.cpp:642
msgctxt "@info:whatsthis"
msgid ""
"Add this date as an exception to the recurrence rules for this event or to-"
"do."
msgstr ""
"បន្ថែម​កាលបរិច្ឆេទ​នេះ​ជា​ករណី​លើក​លែង​ទៅ​ក្នុង​ច្បាប់​កើតឡើង​ដដែលៗ សម្រាប់​ព្រឹត្តិការណ៍ ឬ​ការងារ​ត្រូវ​ធ្វើ​"
"នេះ ។"

