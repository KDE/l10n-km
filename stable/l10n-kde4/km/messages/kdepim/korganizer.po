#: rc.cpp:715 rc.cpp:1650
msgid "Free/Busy Retrieval Username"
msgstr "ឈ្មោះ​អ្នក​ប្រើ​ទៅ​យក​ទំនេរ/រវល់"

#. i18n: file: korganizer.kcfg:498
