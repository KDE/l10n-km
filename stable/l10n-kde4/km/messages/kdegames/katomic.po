#: gamewidget.cpp:119
#, kde-format
msgid "Level %1 finished. "
msgstr "បាន​បញ្ចប់​កម្រិត %1 ។ "

#: gamewidget.cpp:123
msgid "Congratulations! You have a new highscore!"
msgstr "អបអរ​សាទរ ! អ្នក​មាន​ពិន្ទុ​ខ្ពស់​ថ្មី​ហើយ !"

#: gamewidget.cpp:150
#, kde-format
msgid ""
"Level %1 can not be found. Please check your installation. Now switching to "
"Level 1"
msgstr "មិន​អាច​រកឃើញ​កម្រិត %1 ទេ ។ សូម​ពិនិត្យ​មើល​ការ​ដំឡើង​របស់​អ្នក ។ ឥឡូវ ប្ដូរ​ទៅ​កម្រិត ១"

#: gamewidget.cpp:156
msgid ""
"Level 1 data can not be found. Please check your installation. KAtomic will "
"quit now."
msgstr ""
"មិន​អាច​រកឃើញ​ទិន្នន័យ​កម្រិត​ ១ ទេ ។ សូម​ពិនិត្យ​មើល​ការ​ដំឡើង​របស់​អ្នក ។ KAtomic នឹង​បិទ​នៅពេល​ឥឡូវ​នេះ ។"

#: gamewidget.cpp:229
