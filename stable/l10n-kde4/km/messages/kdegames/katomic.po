#: chooselevelsetdialog.cpp:39
msgid "Level Sets"
msgstr "កំណត់​កម្រិត"

#: gamewidget.cpp:97
#, kde-format
msgid ""
"Failed to load level set \"%1\". Check if it is installed on your computer."
msgstr ""
"បាន​បរាជ័យ​ក្នុង​ការកំណត់​កម្រិត \"%1\" ។ ត្រួត​ពិនិត្យ​ថាតើ​ វា​ត្រូវ​បាន​ដំឡើង​លើ​កុំព្យូទ័រ​​អ្នក​រួច​ហើយ ។"

#: gamewidget.cpp:153
#, kde-format
msgid "Level %1 finished. "
msgstr "បាន​បញ្ចប់​កម្រិត %1 ។ "

#: gamewidget.cpp:157
msgid "Congratulations! You have a new highscore!"
msgstr "អបអរ​សាទរ ! អ្នក​មាន​ពិន្ទុ​ខ្ពស់​ថ្មី​ហើយ !"

