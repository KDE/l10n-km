#: gamewidget.cpp:338
msgid ""
"Welcome to KBounce.\n"
" Press Ctrl+N or space to start a game"
msgstr ""
"សូម​ស្វាគមន៍​មក​កាន់ KBounce ។\n"
" ចុច​បញ្ជា(Ctrl)+N ឬ​ចន្លោះ​ដើម្បី​ចាប់ផ្ដើម​ល្បែង"

#: gamewidget.cpp:341
msgid "Paused"
msgstr "បាន​ផ្អាក"

#: gamewidget.cpp:344
#, kde-format
msgid "You have successfully cleared more than %1% of the board\n"
msgstr "អ្នក​បាន​ជម្រះ​ដោយ​ជោគជ័យ​នូវ​ក្ដារ​ច្រើន​ជាង %1%\n"

#: gamewidget.cpp:345
#, kde-format
msgid "%1 points: %2 points per remaining life\n"
msgstr "%1 ពិន្ទុ ៖ %2 ពិន្ទុ​/ជីវិត​ដែល​នៅ​សល់\n"

#: gamewidget.cpp:346
#, kde-format
msgid "%1 points: Bonus\n"
msgstr "%1 ពិន្ទុ ៖ ពិន្ទុ​បន្ថែម\n"

#: gamewidget.cpp:347
#, kde-format
msgid "%1 points: Total score for this level\n"
msgstr "%1 ពិន្ទុ ៖ ពិន្ទុ​សរុប​សម្រាប់​កម្រិត​នេះ\n"

#: gamewidget.cpp:348
#, kde-format
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr "បន្ត​ទៅ​កម្រិត %1 ។ ចងចាំ​ថា ពេល​នេះ​អ្នក​ទទួល​បាន​ជីវិត %2 !"

#: gamewidget.cpp:351
msgid "Game over."
msgstr "ល្បែង​ចប់​ហើយ ។"

#: main.cpp:30
msgid "KDE Bounce Ball Game"
msgstr "ល្បែង KDE Bounce Ball"

