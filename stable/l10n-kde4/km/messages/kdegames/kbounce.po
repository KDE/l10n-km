msgstr "បាន​បំពេញ ៖ %1%"

#: mainwindow.cpp:47 mainwindow.cpp:215
#, kde-format
msgid "Lives: %1"
msgstr "ជីវិត ៖ %1"

#: mainwindow.cpp:48 mainwindow.cpp:220
