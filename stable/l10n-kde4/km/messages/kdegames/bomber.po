#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម,​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,vannak@khmeros.info,piseth_dv@khmeros.info"

#. i18n: file: src/bomberui.rc:9
#. i18n: ectx: ToolBar (mainToolBar)
#: rc.cpp:5
msgid "Main Toolbar"
msgstr "របារ​ឧបករណ៍​មេ"

#: src/bomberwidget.cpp:317
msgctxt "Message show to the user when the game is loaded"
msgid ""
"Welcome to Bomber.\n"
"Click to start a game"
msgstr ""
"សូម​ស្វាគមន៍​មក​កាន់ Bomber ។\n"
"ចុច​ដើម្បី​ចាប់ផ្ដើម​ល្បែង"

#: src/bomberwidget.cpp:320
msgctxt "Message show to the user while the game is paused"
msgid "Paused"
msgstr "បានផ្អាក"

#: src/bomberwidget.cpp:323
#, kde-format
msgctxt "Message telling user which level they just completed"
msgid "You have successfully cleared level %1\n"
msgstr "អ្នក​បាន​ជម្រើស​កម្រិត %1 ដោយ​ជោគជ័យ\n"

#: src/bomberwidget.cpp:324
#, kde-format
msgctxt "Message telling user which level they are about to start"
msgid "On to level %1."
msgstr "នៅ​​កម្រិត %1 ។"

#: src/bomberwidget.cpp:327
msgctxt "Used to tell the user that the game is over"
msgid "Game over."
msgstr "ល្បែង​ចប់ហើយ ។"

#: src/main.cpp:25
msgid "Arcade bombing game"
msgstr "ល្បែង​គ្រាប់បែក Arcade"

#: src/main.cpp:31
msgid "Bomber"
msgstr "គ្រាប់បែក"

#: src/main.cpp:32
msgid "(C) 2007 John-Paul Stanford"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៧ ដោយ John-Paul Stanford"

#: src/main.cpp:34
msgid "John-Paul Stanford"
msgstr "John-Paul Stanford"

#: src/bomber.cpp:42 src/bomber.cpp:200
#, kde-format
msgctxt "Used to display the current level of play to the user"
msgid "Level: %1"
msgstr "កម្រិត ៖ %1"

#: src/bomber.cpp:43 src/bomber.cpp:206
#, kde-format
msgctxt "Used to inform the user of their current score"
msgid "Score: %1"
msgstr "ពិន្ទុ ៖ %1"

#: src/bomber.cpp:44 src/bomber.cpp:213
#, kde-format
msgctxt "Used to tell the user how many lives they have left"
msgid "Lives: %1"
msgstr "បន្តផ្ទាល់ ៖ %1"

#: src/bomber.cpp:83
msgctxt "Menu item used to disable or enable sound"
msgid "&Play Sounds"
msgstr "ចាក់​សំឡេង"

#: src/bomber.cpp:88
msgctxt "The name of the action used for dropping bombs"
msgid "&Drop bomb"
msgstr "ទម្លាក់​គ្រាប់បែក"

#: src/bomber.cpp:89
msgctxt "The tool tip text for the action used to drop bombs"
msgid "Drop bomb"
msgstr "ទម្លាក់​គ្រាប់បែក"

#: src/bomber.cpp:91
msgctxt "Description of the action used to drop bombs"
msgid "Makes the plane drop a bomb while flying"
msgstr "បង្កើត​យន្តហោះ​ទម្លាក់​គ្រាប់បែក​ពេលហោះហើរ"

#: src/bomber.cpp:138
msgctxt ""
"Message displayed when play tries to quit a game that is currently running"
msgid "Do you really want to close the running game?"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​បិទ​ល្បែង​ដែល​កំពុង​រត់​ឬ ?"

#: src/bomber.cpp:179
msgid "Theme"
msgstr "ស្បែក"

#: src/bomber.cpp:231
#, kde-format
msgctxt "Game over messaged displayed in the status bar"
msgid "Game over. Press '%1' for a new game"
msgstr "ល្បែង​ចប់ហើយ ។ ចុច '%1' ដើម្បី​ចាប់ផ្ដើម​ល្បែង​ថ្មី"

