#: gameengine.cpp:90
msgid "Game Paused!"
msgstr "ល្បែង​បាន​ផ្អាក !"

#: gameengine.cpp:197
msgid "Well done! You won the game!"
msgstr "ល្អណាស់ ! អ្នក​បាន​ឈ្នះ​ហើយ !"

#: gameengine.cpp:286 textitems.cpp:96
#, kde-format
msgid "Level %1"
msgstr "កម្រិត %1"

#: gameengine.cpp:436
msgid "Oops! You have lost the ball!"
msgstr "អុព្ហ ! អ្នក​បាន​ចាញ់​ហើយ !"

#: gameengine.cpp:500
msgid "Game Over!"
msgstr "ល្បែង​ចប់​ហើយ !"

#: gameengine.cpp:558
#, kde-format
msgid "Press %1 to fire the ball"
msgstr "ចុច %1 ដើម្បីបាញ់​បាល់"

#: main.cpp:30
msgid "KBreakOut"
msgstr "KBreakOut"

#: main.cpp:31
msgid "A breakout like game for KDE"
msgstr "ការ​បំបែក​ដូច​ជា​ល្បែង​សម្រាប់ KDE"

#: main.cpp:33
msgid "(c) 2007-2008 Fela Winkelmolen"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៧-២០០៨ ដោយ Fela Winkelmolen"

#: main.cpp:34
msgid "Fela Winkelmolen"
msgstr "Fela Winkelmolen"

#: main.cpp:35
msgid "original author and maintainer"
msgstr "អ្នក​និពន្ធ និង​ថែទាំ​ដើម"

#: main.cpp:37
msgid "Eugene Trounev"
msgstr "Eugene Trounev"

#: main.cpp:38
msgid "artwork"
msgstr "ការងារ​សិ​ល្បះ"

#: mainwindow.cpp:106
msgid "Fire Ball"
msgstr "បាញ់បាល់"

#: mainwindow.cpp:111
msgid "Pause"
msgstr "ផ្អាក"

#: mainwindow.cpp:131
msgid "Theme"
msgstr "ស្បែក"

#: mainwindow.cpp:143
#, kde-format
msgid "Failed to load \"%1\" theme. Please check your installation."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ផ្ទុកស្បែក \"%1\" ។ សូម​ពិនិត្យ​មើល​ការ​ដំឡើង​របស់​អ្នក ។"

#: mainwindow.cpp:162
msgid "Starting a new game will end the current one!"
msgstr "ចាប់ផ្ដើម​ល្បែង​ថ្មី​នឹង​បញ្ចប់​បច្ចុប្បន្ន !"

#: mainwindow.cpp:163
msgid "New Game"
msgstr "ល្បែង​ថ្មី"

#: mainwindow.cpp:164
#, fuzzy
#| msgid "Start a New Game"
msgid "Start a new game"
msgstr "ចាប់ផ្ដើម​ល្បែង​ថ្មី"

#: mainwindow.cpp:187
msgid "Game won!"
msgstr "បាន​ឈ្នោះ​ហើយ"

#. i18n: file: kbreakout.kcfg:9
