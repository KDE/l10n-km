#: src/gui/views/sudokuview.cpp:77
#, kde-format
msgid "Selected item %1, Time elapsed %2. Press SHIFT to highlight."
msgstr "ធាតុ​ដែល​បាន​ជ្រើស %1 ពេលវេលា​កន្លង %2 ។ ចុច​គ្រាប់​ចុច​ប្ដូរ (SHIFT) ដើម្បី​បន្លិច ។"

