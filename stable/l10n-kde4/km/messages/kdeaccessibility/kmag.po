#: kmag.cpp:183
msgid "Hide Main &Toolbar"
msgstr "លាក់​របារ​ឧបករណ៍​មេ"

#: kmag.cpp:185
msgid "Show &View Toolbar"
msgstr "បង្ហាញ​របារ​ឧបករណ៍​មើល"

#: kmag.cpp:189
msgid "Hide &View Toolbar"
msgstr "លាក់​របារ​ឧបករណ៍​មើល"

#: kmag.cpp:191
msgid "Show &Settings Toolbar"
msgstr "បង្ហាញ​របារ​ឧបករណ៍​ការ​កំណត់"

#: kmag.cpp:195
msgid "Hide &Settings Toolbar"
msgstr "លាក់​របារ​ឧបករណ៍​ការ​កំណត់"

#: kmag.cpp:198
msgid "&Follow Mouse Mode"
msgstr "ធ្វើ​តាម​របៀប​កណ្ដុរ"

#: kmag.cpp:202
msgid "Magnify around the mouse cursor"
msgstr "ពង្រីក​ជុំវិញ​ទស្សន៍ទ្រនិច​កណ្ដុរ"

#: kmag.cpp:203
msgid "If selected, the area around the mouse cursor is magnified"
msgstr "ប្រសិន​បើ​បាន​ជ្រើស ផ្ទៃ​ជុំវិញ​ទស្សន៍​ទ្រនិច​កណ្ដុរ​ត្រូវ​បាន​ពង្រីក"

#: kmag.cpp:205
msgid "Se&lection Window Mode"
msgstr "របៀប​ជ្រើស​បង្អួច"

#: kmag.cpp:209
msgid "Show a window for selecting the magnified area"
msgstr "បង្ហាញ​បង្អួចដើម្បី​ជ្រើស​ផ្ទៃ​ដែល​បាន​ពង្រីក"

