msgid "Hide"
msgstr "លាក់"

#: kmag.cpp:215
msgid "Hide the mouse cursor"
msgstr "លាក់​ទស្សន៍ទ្រនិច​កណ្ដុរ"

#: kmag.cpp:217
msgid "Stays On Top"
msgstr "លាក់​នៅ​ផ្នែក​ខាងលើ"

#: kmag.cpp:221
msgid "The KMagnifier Window stays on top of other windows."
msgstr "បង្អួច KMagnifier នៅ​ផ្នែក​ខាងលើ​នៃ​វីនដូ​ផ្សេង​ទៀត ។"

