#: kmag.cpp:145
msgid "&Stop"
msgstr "បញ្ឈប់"

#: kmag.cpp:148
msgid "Click to stop window refresh"
msgstr "ចុច​ដើម្បី​បញ្ឈប់​បង្អួច​ធ្វើ​ឲ្យ​ស្រស់​"

#: kmag.cpp:149
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"ការ​ចុច​លើ​រូប​តំណាង​នេះ​នឹង <b>ចាប់ផ្ដើម</b> / <b>បញ្ឈប់</b>  ធ្វើ​បច្ចុប្បន្នភាព​​​ការ​បង្ហាញ ។ ការ​"
"បញ្ឈប់​​​បច្ចុប្បន្នភាព​​នឹង​ធ្វើ​ឲ្យ​ថាមពល​ដែល​ដំណើរ​ការ​ទទេ ដែល​ទាមទារ (ការ​ប្រើប្រាស់ CPU)"

#: kmag.cpp:155
msgid "&Save Snapshot As..."
msgstr "រក្សា​ទុក​រូបថត​ជា..."

#: kmag.cpp:158
msgid "Saves the zoomed view to an image file."
msgstr "រក្សា​ទុក​ទិដ្ឋភាព​ពង្រីក​ទៅ​ឯកសារ​រូបភាព ។"

#: kmag.cpp:159
msgid "Save image to a file"
msgstr "រក្សា​ទុក​រូបភាព​ទៅ​ឯកសារ"

#: kmag.cpp:162
msgid "Click on this button to print the current zoomed view."
msgstr "ចុច​ប៊ូតុង​នេះ​ដើម្បី​បោះពុម្ព​ទិដ្ឋភាព​ពង្រីក​បច្ចុប្បន្ន ។"

#: kmag.cpp:165 kmag.cpp:166
msgid "Quits the application"
msgstr "បិទ​កម្មវិធី"

#: kmag.cpp:169
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"ចុច​ប៊ូតុង​នេះ​ដើម្បី​ចម្លង​ទិដ្ឋភាព​ដែល​ពង្រីក​បច្ចុប្បន្ន​ទៅ​ក្ដារ​តម្បៀត​ខ្ទាស់​ដែល​អ្នក​អាច​បិទភ្ជាប់​ក្នុង​កម្មវិធី​"
"ផ្សេង​ទៀត​បាន ។"

#: kmag.cpp:170
msgid "Copy zoomed image to clipboard"
msgstr "ចម្លង​រូបភាព​ដែល​ពង្រីក​ទៅ​ក្ដារ​តម្បៀត​ខ្ទាស់"

#: kmag.cpp:176
msgid "&Follow Mouse Mode"
msgstr "ធ្វើ​តាម​របៀប​កណ្ដុរ"

#: kmag.cpp:180
msgid "Mouse"
msgstr "កណ្ដុរ"

#: kmag.cpp:181
msgid "Magnify around the mouse cursor"
msgstr "ពង្រីក​ជុំវិញ​ទស្សន៍ទ្រនិច​​កណ្ដុរ"

#: kmag.cpp:182
msgid "If selected, the area around the mouse cursor is magnified"
msgstr "ប្រសិនបើ​ជ្រើស ផ្ទៃ​ជុំវិញ​ទស្សន៍ទ្រនិច​កណ្ដុរ​ត្រូវ​បាន​​ពង្រីក"

#: kmag.cpp:184
msgid "&Follow Focus Mode"
msgstr "អនុវត្ត​តាម​របៀប​ផ្ដោត"

#: kmag.cpp:188
msgid "Focus"
msgstr "ផ្ដោត"

#: kmag.cpp:189
msgid "Magnify around the keyboard focus"
msgstr "ពង្រីក​ជុំវិញ​ចំណុច​​ក្ដារ​ចុច"

#: kmag.cpp:190
msgid "If selected, the area around the keyboard cursor is magnified"
msgstr "ប្រសិនបើ​ជ្រើស ផ្ទៃ​ជុំវិញ​ទស្សន៍ទ្រនិច​ក្ដារ​ចុច​​ត្រូវ​បាន​ពង្រីក"

#: kmag.cpp:192
msgid "Se&lection Window Mode"
msgstr "ការ​ជ្រើស​របៀប​បង្អួច"

#: kmag.cpp:196
msgid "Window"
msgstr "បង្អួច"

#: kmag.cpp:197
msgid "Show a window for selecting the magnified area"
msgstr "បង្ហាញ​បង្អួច​សម្រាប់​ការ​ជ្រើសរើស​ផ្ទៃ​ដែល​បាន​ពង្រីក"

#: kmag.cpp:199
msgid "&Whole Screen Mode"
