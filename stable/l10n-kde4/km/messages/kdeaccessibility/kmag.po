msgid "Zoom factor"
msgstr "កត្តា​ពង្រីក"

#: kmag.cpp:237
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "ចុច​លើ​ប៊ូតុង​នេះ​ដើម្បី <b>បង្រួម</b> លើ​ផ្ទៃ​​ដែល​បាន​ជ្រើស ។"

#: kmag.cpp:239
msgid "&Rotation"
msgstr "បង្វិល"

#: kmag.cpp:242
msgid "Select the rotation degree."
