#: kmag.cpp:243
msgid "Rotation degree"
msgstr "ដឺក្រេ​បង្វិល​"

#: kmag.cpp:250
msgid "&Refresh"
msgstr "ធ្វើ​ឲ្យ​ស្រស់"

#: kmag.cpp:253
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr "ជ្រើស​អត្រា​ធ្វើ​ឲ្យ​ស្រស់ ។ អត្រា​កាន់​តែ​ខ្ពស់ ថាមពល​កុំព្យូទ័រ​ត្រូវ​ត្រូវការ​កាន់​តែ​ច្រើន (ស៊ីភីយូ) ។"

#: kmag.cpp:254
