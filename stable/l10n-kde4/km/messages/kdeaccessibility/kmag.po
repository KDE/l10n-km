msgid "Click on this button to fit the zoom view to the zoom window."
msgstr "ចុច​ប៊ូតុង​នេះ ដើម្បី​ធ្វើ​ឲ្យ​ទិដ្ឋភាព​ពង្រីក​សម​នឹង​បង្អួច​ពង្រីក ។"

#: kmag.cpp:218
msgid "Hide Mouse &Cursor"
msgstr "លាក់​ទស្សន៍​ទ្រនិច​កណ្ដុរ"

#: kmag.cpp:223
msgid "Show Mouse &Cursor"
msgstr "បង្ហាញ​ទស្សន៍​ទ្រនិច​កណ្ដុរ"

#: kmag.cpp:225
msgid "Hide the mouse cursor"
msgstr "លាក់​ទស្សន៍​ទ្រនិច​កណ្ដុរ"

#: kmag.cpp:228
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "ចុច​ប៊ូតុង​នេះ​ដើម្បី <b>ពង្រីក</b> លើ​ផ្ទៃ​ដែល​បាន​ជ្រើស ។"

#: kmag.cpp:230
msgid "&Zoom"
msgstr "ពង្រីក "

#: kmag.cpp:233
msgid "Select the zoom factor."
