msgstr "មិនអាច​រក​មូលដ្ឋាន​ទិន្នន័យ​ណាមួយ​សម្រាប់​ការ​តភ្ជាប់​បណ្ដោះអាសន្ន​បាន​ទេ ។"

#: kexidb/connection.cpp:787
#, kde-format
msgid "Error during starting temporary connection using \"%1\" database name."
msgstr "មាន​កំហុស​កំឡុង​ពេល​ចាប់ផ្ដើម​ការ​តភ្ជាប់បណ្ដោះអាសន្ន​ ដោយ​ប្រើ​ឈ្មោះ​មូលដ្ឋាន​ទិន្នន័យ \"%1\" ។"

#: kexidb/connection.cpp:804
msgid "Cannot drop database - name not specified."
msgstr "មិនអាច​ទម្លាក់​មូលដ្ឋាន​ទិន្នន័យ - ឈ្មោះ​មិន​បាន​បញ្ជាក់ ។"

#: kexidb/connection.cpp:821
msgid "Cannot delete database - name not specified."
msgstr "មិនអាច​លុប​មូលដ្ឋាន​ទិន្នន័យ​បាន​ទេ - ឈ្មោះ​មិនបាន​បញ្ជាក់ ។"

#: kexidb/connection.cpp:826
#, kde-format
msgid "Cannot delete system database \"%1\"."
msgstr "មិនអាច​លុប​មូលដ្ឋាន​ទិន្នន័យ​ប្រព័ន្ធ​ \"%1\" បានទេ ។"

#: kexidb/connection.cpp:1187
msgid "Error while executing SQL statement."
msgstr "កំហុស​​ខណៈពេល​ប្រតិបត្តិ​សេចក្ដី​ថ្លែងការណ៍ SQL ។"

#: kexidb/connection.cpp:1622
msgid "Creating table failed."
