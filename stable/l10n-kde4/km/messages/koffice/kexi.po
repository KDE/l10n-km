#, kde-format
msgid "System name \"%1\" cannot be used as table name."
msgstr "ឈ្មោះ​ប្រព័ន្ធ \"%1\" មិន​អាច​ត្រូវ​បាន​ប្រើ​ជា​​ឈ្មោះ​តារាង​បាន​ទេ ។"

