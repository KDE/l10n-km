#: models/kptcommonstrings.cpp:104
msgctxt "@info:tooltip"
msgid "Budgeted Cost of Work Scheduled"
msgstr "ថ្លៃ​​ចំណាយ​ក្នុង​ការងារ​ដែល​បាន​កំណត់​ពេល​"

#: models/kptcommonstrings.cpp:105
