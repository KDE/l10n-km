#: models/kptcommonstrings.cpp:119
msgctxt "@info:tooltip"
msgid "The fixed cost"
msgstr "ថ្លៃ​ចំណាយ​ថេរ"

#: models/kptcommonstrings.cpp:120
msgctxt "@info:tooltip"
msgid "The account where the resource cost is accumulated"
msgstr "គណនី​ដែល​ថ្លៃ​ចំណាយ​ធនធាន​ត្រូវ​បាន​បម្រុង​ទុក"

#: models/kptcommonstrings.cpp:122
msgctxt "@info:tooltip"
msgid "The name of the account"
msgstr "ឈ្មោះ​គណនី"

#: models/kptcommonstrings.cpp:123
msgctxt "@info:tooltip"
msgid "The description of the account"
msgstr "សេចក្ដី​ពិពណ៌នា​របស់​គណនី"

#: models/kptcommonstrings.cpp:125
msgctxt "@info:tooltip"
msgid "The name of the schedule"
msgstr "ឈ្មោះ​កាល​វិភាគ"

#: models/kptcommonstrings.cpp:126
msgctxt "@info:tooltip"
msgid "The schedules state"
msgstr "ស្ថានភាព​កាល​វិភាគ"

#: models/kptcommonstrings.cpp:128
msgctxt "@info:tooltip"
msgid "Controls resource overbooking when scheduling"
msgstr "ត្រួត​ពិនិត្យ​ធន​ធាន​​ដែល​ប្រើ​លើស នៅ​ពេល​កំណត់​ពេល"

#: models/kptcommonstrings.cpp:130
msgctxt "@info:whatsthis"
msgid ""
"<para>Controls resource overbooking when scheduling.</para><para>If "
"overbooking is allowed, a resource may be booked (on working days) to work "
"more than it is available. This can happen if the resource is allocated to "
"multiple tasks or are booked on other projects.</para><para>If overbooking "
"is to be avoided, resources will not be booked more than they are available. "
"On resource conflict, tasks will be delayed until the resource is available."
"</para>"
msgstr ""
"<para>ត្រួត​ពិនិត្យ​ធន​ធាន​ដែល​បាន​ប្រើ​លើស​ នៅ​ពេល​កំណត់​ពេល​ ។</para><para>​ប្រសិនបើ​ការ​ប្រើ​​លើស​ត្រូវ​"
"បាន​អនុញ្ញាត ​ធន​ធាន​អាច​ត្រូវ​បាន​ប្រើ​ (នៅ​ថ្ងៃ​ធ្វើ​ការ​) ដើម្បី​ដំណើរ​ការ​ឲ្យ​បាន​ច្រើន​ជាង​ធម្មតា ។ វា​"
"អាច​កើត​ឡើង​បាន ប្រសិនបើ​ធន​ធាន​ត្រូវ​បាន​បម្រុង​ទុក​សម្រាប់​ភារកិច្ច​ជា​ច្រើន ឬ​ត្រូវ​បាន​ប្រើ​នៅ​លើ​គម្រោង​ផ្សេង​"
"ទៀត ។</para><para>ប្រសិនបើ​ការ​ប្រើ​​លើស​ត្រូវ​បាន​ជៀស​វាង នោះ​ធន​ធាន​នឹង​មិន​ត្រូវ​បាន​ប្រើ​ច្រើន​ជាង​អ្វី​"
"ដែល​អាច​ធ្វើ​បាន​ទេ ។ នៅ​លើ​ធន​ធាន​ដែល​មាន​ភាព​ប៉ះ​ទង្គិច​ ភារកិច្ច​នឹង​ត្រូវ​ពន្យារពេល​ រហូត​ដល់​ធន​ធាន​អាច​"
"ប្រើ​បាន ។</para>"

#: models/kptcommonstrings.cpp:136
msgctxt "@info:tooltip"
msgid "The distribution to be used during scheduling"
msgstr "ការ​ចែក​ចាយ​នឹង​ត្រូវ​បាន​ប្រើ​ក្នុង​​អំឡុង​​កំណត់​ពេល"

#: models/kptcommonstrings.cpp:138
msgctxt "@info:whatsthis"
msgid ""
"<para>The distribution to be used during scheduling</para><para>If "
"distribution is 'None', the tasks estimate is used as is during scheduling.</"
"para><para>If distribution is 'PERT', the estimate used is calculated based "
"on the entered optimistic- (O), pessimistic-(P) and most likely (M) "
"estimate. The formula used for this is (O + 4 * M + P) / 6.<para>"
msgstr ""
"<para>ការ​ចែក​ចាយ​នឹង​ត្រូវ​ប្រើ​ក្នុង​អំឡុង​កំណត់​ពេល​</para><para>​បើ​សិន​ការ​ចែក​ចាយ​ជា​ 'គ្មាន​'  ការ​"
"ប៉ាន់​ស្មាន​ភារកិច្ច​នឹង​ត្រូវ​ប្រើ​ក្នុង​អំឡុង​កំណត់​ពេល​ ។</para><para>ប្រសិនបើ​ការចែក​ចាយ​ជា​ 'PERT' ការ​"
"ប៉ាន់​ស្មាន​នឹង​ត្រូវ​ប្រើ​នៅ​ពេល​ធ្វើ​ការ​គណនា​ ដោយ​ផ្អែក​លើ​សុទិដ្ឋិនិយម​ (O) ទុទ្ទិដ្ឋិនិយម​ (P) និង​ការ​ប៉ាន់​"
"ស្មាន​ (M) ​ទំនង​បំផុត​ដែល​ត្រូវ​បាន​បញ្ចូល ។ រូបមន្ត​ដែល​ត្រូវ​​ប្រើ​សម្រាប់​ការចែក​ចាយ​នេះ​គឺ (O + 4 * M + "
"P) / 6 ។<para>"

#: models/kptcommonstrings.cpp:144
