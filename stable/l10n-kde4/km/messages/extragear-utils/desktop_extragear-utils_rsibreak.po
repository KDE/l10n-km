#: plasma/plasma-applet-rsibreak.desktop:3 src/rsibreak.desktop:11
msgctxt "Name"
msgid "RSIBreak"
msgstr "RSIBreak"

#: plasma/plasma-applet-rsibreak.desktop:41
msgctxt "Comment"
msgid "Plasma RSIBreak applet"
msgstr "អាប់ភ្លេត RSIBreak ប្លាស្មា"

#: plasma/plasma-engine-rsibreak.desktop:2
msgctxt "Name"
msgid "RSIBreak engine"
msgstr "ម៉ាស៊ីន RSIBreak"

#: plasma/plasma-engine-rsibreak.desktop:38
msgctxt "Comment"
msgid "Provides current times left to breaks and rsibreak status"
msgstr "ផ្ដល់​នូវ​ពេលវេលា​បច្ចុប្បន្ន​ដែល​នៅ​សល់​ដើម្បី​សម្រាក និង​ស្ថានភាព​របស់ rsibreak"

#: src/rsibreak.desktop:49
msgctxt "Comment"
msgid "Makes sure you rest now and then"
msgstr "សូម​ប្រាកដ​ថា​អ្នក​សម្រាក​ឥឡូវ​នេះ និង​ពេល​ក្រោយ"

#: src/rsibreak.notifyrc:3
msgctxt "Comment"
msgid "RSIBreak"
msgstr "RSIBreak"

#: src/rsibreak.notifyrc:42
msgctxt "Name"
msgid "Breaks"
msgstr "សម្រាក"

#: src/rsibreak.notifyrc:84
msgctxt "Name"
msgid "Start of a short break"
msgstr "ការ​ចាប់ផ្ដើម​នៃ​ការ​សម្រាក​ខ្លី"

#: src/rsibreak.notifyrc:121
msgctxt "Comment"
msgid "When a short break starts"
msgstr "ពេល​ការ​សម្រាក​ខ្លី​ចាប់ផ្ដើម"

#: src/rsibreak.notifyrc:162
msgctxt "Name"
msgid "End of a short break"
msgstr "ចុង​បញ្ចប់​នៃ​ការ​សម្រាក​ខ្លី"

#: src/rsibreak.notifyrc:199
msgctxt "Comment"
msgid "When a short break ends"
msgstr "ពេល​​ការ​សម្រាក​ខ្លី​បញ្ចប់"

#: src/rsibreak.notifyrc:240
msgctxt "Name"
msgid "Start of a long break"
msgstr "ការ​ចាប់ផ្ដើម​ការ​សម្រាក​វែង"

#: src/rsibreak.notifyrc:277
msgctxt "Comment"
msgid "When a long break starts"
msgstr "ពេល​ការ​សម្រាក​វែង​ចាប់ផ្ដើម"

#: src/rsibreak.notifyrc:318
msgctxt "Name"
msgid "End of a long break"
msgstr "ចុង​បញ្ចប់​នៃ​ការ​សម្រាក​វែង"

#: src/rsibreak.notifyrc:355
msgctxt "Comment"
msgid "When a long break ends"
msgstr "ពេល​ការ​សម្រាក​វែង​បញ្ចប់"

#: src/rsibreak.notifyrc:394
msgctxt "Name"
msgid "Regarding timers"
msgstr "ទាក់ទង​នឹង​កម្មវិធី​កំណត់​ពេលវេលា"

#: src/rsibreak.notifyrc:422
msgctxt "Name"
msgid "When the short timer has been reset"
msgstr "នៅពេល​កម្មវិធីកំណត់​ពេលវេលា​ខ្លី​ត្រូវបានកំណត់​ឡើងវិញ"

#: src/rsibreak.notifyrc:451
msgctxt "Name"
msgid "When the timers have been reset"
msgstr "នៅពេល​កម្មវិធី​កំណត់​ពេលវេលា​ត្រូវបានកំណត់​ឡើងវិញ"
