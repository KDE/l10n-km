#: kio_nepomuk.cpp:295
#, kde-format
msgid ""
"The desktop search service is not activated. Unable to answer queries "
"without it."
msgstr "សេវាកម្ម​ស្វែងរក​ផ្ទៃតុ​មិន​ត្រូវ​បាន​ធ្វើ​ឲ្យ​សកម្ម​ទេ ។ មិន​អាច​ឆ្លើយ​សំណួរ​ដោយ​គ្មាន​វា​បាន​ទេ ។"

#: resourcepagegenerator.cpp:199
