#: plugin_timeadjust.cpp:66
msgid "Adjust Time && Date..."
msgstr "លៃតម្រូវ​ពេលវេលា និង​កាលបរិច្ឆេទ..."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
