#: timeadjustdialog.cpp:162 timeadjustdialog.cpp:597
msgid "Adjust Time & Date"
msgstr "លៃតម្រូវ​ពេលវេលា និង​កាលបរិច្ឆេទ"

#: timeadjustdialog.cpp:170
msgid "Time Adjust"
msgstr "កា​រលៃតម្រូវ​ពេលវេលា"

#: timeadjustdialog.cpp:173
msgid "A Kipi plugin for adjusting time stamp of picture files"
msgstr "កម្មវិធី​ជំនួយ Kipi plugin សម្រាប់​លៃតម្រូវ​ត្រា​ពេលវេលា​របស់​រូបភាព"

#: timeadjustdialog.cpp:174
msgid ""
"(c) 2003-2005, Jesper K. Pedersen\n"
"(c) 2006-2008, Gilles Caulier"
msgstr ""
"រក្សាសិទ្ធិ​ឆ្នាំ ២០០៣-២០០៥ ដោយ Jesper K. Pedersen\n"
"រក្សាសិទ្ធិ​ឆ្នាំ ២០០៦-២០០៨​ ដោយ Gilles Caulier"

#: timeadjustdialog.cpp:177
msgid "Jesper K. Pedersen"
msgstr "Jesper K. Pedersen"

#: timeadjustdialog.cpp:178
msgid "Author"
msgstr "អ្នក​និពន្ធ"

#: timeadjustdialog.cpp:181
msgid "Gilles Caulier"
msgstr "Gilles Caulier"

#: timeadjustdialog.cpp:182
msgid "Developer and maintainer"
msgstr "អ្នក​អភិវឌ្ឍ និង​អ្នក​ថែទាំ"

#: timeadjustdialog.cpp:191
msgid "Plugin Handbook"
msgstr "សៀវភៅ​ដៃ​កម្មវិធី​ជំនួយ"

#: timeadjustdialog.cpp:199
msgid "Adjustment Type"
msgstr "ប្រភេទ​លៃតម្រូវ"

#: timeadjustdialog.cpp:204
msgid "Add"
msgstr "បន្ថែម"

#: timeadjustdialog.cpp:205
msgid "Subtract"
msgstr "ដក"

#: timeadjustdialog.cpp:206
msgid "Set file date to EXIF/IPTC/XMP creation date"
msgstr "កំណត់​កាលបរិច្ឆេទ​ឯកសារ​ទៅ​កាលបរិច្ឆេទ​បង្កើត EXIF/IPTC/XMP"

#: timeadjustdialog.cpp:207
msgid "Custom date"
msgstr "កាលបរិច្ឆេទ​ផ្ទាល់ខ្លួន"

#: timeadjustdialog.cpp:222
msgid "Reset to current date"
msgstr "កំណត់​​ទៅ​កាលបរិច្ឆេទ​បច្ចុប្បន្ន​ឡើង​វិញ"

#: timeadjustdialog.cpp:225
msgid "Update EXIF creation date"
msgstr "ធ្វើ​ឲ្យ​កាលបរិច្ឆេទ​បង្កើត EXIF ទាន់សម័យ"

#: timeadjustdialog.cpp:226
msgid "Update IPTC creation date"
msgstr "ធ្វើ​ឲ្យ​កាលបរិច្ឆេទ​បង្កើត​ IPTC ទាន់សម័យ"

#: timeadjustdialog.cpp:227
msgid "Update XMP creation date"
msgstr "ធ្វើ​កាលបរិច្ឆេទ​បង្កើត​ XMP ទាន់​សម័យ"

#: timeadjustdialog.cpp:245
msgid "Adjustments"
msgstr "ការ​លៃតម្រូវ"

#: timeadjustdialog.cpp:248
msgid "Hours:"
msgstr "ម៉ោង ៖"

#: timeadjustdialog.cpp:253
msgid "Minutes:"
msgstr "នាទី ៖"

#: timeadjustdialog.cpp:258
msgid "Seconds:"
msgstr "វិនាទី ៖"

#: timeadjustdialog.cpp:263
msgid "Days:"
msgstr "ថ្ងៃ ៖"

#: timeadjustdialog.cpp:268
msgid "Months:"
msgstr "ខែ ៖"

#: timeadjustdialog.cpp:273
msgid "Years:"
msgstr "ឆ្នាំ ៖"

#: timeadjustdialog.cpp:297
msgid "Example"
msgstr "ឧទាហរណ៍"

#: timeadjustdialog.cpp:449
#, kde-format
msgid "1 image will be changed; "
msgid_plural "%1 images will be changed; "
msgstr[0] "រូបភាព %1 នឹង​ត្រូ​វបាន​ផ្លាស់ប្ដូរ"

#: timeadjustdialog.cpp:452
#, kde-format
msgid "1 image will be skipped due to an inexact date."
msgid_plural "%1 images will be skipped due to inexact dates."
msgstr[0] "រូបភាព %1 នឹង​ត្រូវ​បាន​រំលង​ដោយ​សារ​តែ​កាលបរិច្ឆេទ​មិន​ច្បាស់លាស់ ។"

#: timeadjustdialog.cpp:460
#, kde-format
msgid "1 image will be changed"
msgid_plural "%1 images will be changed"
msgstr[0] "រូបភាព %1 នឹង​ត្រូវ​បាន​ផ្លាស់ប្ដូរ"

#: timeadjustdialog.cpp:474
#, kde-format
msgid "<b>%1</b><br/>would, for example, change into<br/><b>%2</b>"
msgstr "<b>%1</b><br/>ឧទាហរណ៍ នឹង​​ផ្លាស់ប្ដូរ​ទៅ​ជា<br/><b>%2</b>"

#: timeadjustdialog.cpp:595
msgid "Unable to set date and time like picture metadata from:"
msgstr "មិនអាច​កំណត់​កាលបរិច្ឆេទ និង​ពេលវេលា​ដូច​ជា​ទិន្នន័យ​មេតា​រូបភាព ៖"
