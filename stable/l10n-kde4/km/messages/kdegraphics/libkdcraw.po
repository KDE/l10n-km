#: libkdcraw/dcrawsettingswidget.cpp:422
msgid ""
"<p><b>Black point value</b><p>Specify specific black point value of the "
"output image.<p>"
msgstr "<p><b>តម្លៃ​ចំណុច​ខ្មៅ​</b><p>បញ្ជាក់​តម្លៃ​ចំណុច​ខ្មៅ​ជាក់លាក់​របស់​រូបភាព​លទ្ធផល ​​។<p>"

