#: mainwindow.cpp:1017
msgid ""
"<html>Enter the address here.<br /><i>Example: vncserver:1 (host:port / "
"screen)</i></html>"
msgstr ""
"<html>បញ្ចូល​អាសយដ្ឋាន​នៅទីនេះ ៖<br /><i>ឧទាហរណ៍ ៖ vncserver:1 (ម៉ាស៊ីន ៖ ច្រក / អេក្រង់)"
"</i></html>"

#: mainwindow.cpp:1028
msgid ""
"<html>Enter the address here.<br /><i>Example: nxserver (host)</i></html>"
msgstr "<html>បញ្ចូល​អាសយដ្ឋាន​នៅទីនេះ ។<br /><i>ឧទាហរណ៍ ៖ nxserver (ម៉ាស៊ីន)</i></html>"

#: mainwindow.cpp:1039
msgid ""
"<html>Enter the address here. Port is optional.<br /><i>Example: "
"rdpserver:3389 (host:port)</i></html>"
msgstr ""
"<html>បញ្ចូល​អាសយដ្ឋាន​នៅ​ទីនេះ ។ ច្រក​គឺស្រេចចិត្ត ។<br /><i>ឧទាហរណ៍ ៖ rdpserver:3389 "
"(ម៉ាស៊ីន ៖ ច្រក)</i></html>"

#: mainwindow.cpp:1052
msgid "Browse Local Network"
msgstr "រកមើល​បណ្ដាញ​មូលដ្ឋាន"

#: mainwindow.cpp:1072
msgid ""
"\"rdesktop\" cannot be found on your system; make sure it is properly "
"installed."
msgstr ""
"\"rdesktop\" មិនអាច​រកឃើញ​នៅ​ក្នុង​ប្រព័ន្ធ​របស់​អ្នក​ទេ សូម​ប្រាក​ដថា​វា​ត្រូវ​បាន​ដំឡើង​យ៉ាង​សមរម្យ ។"

