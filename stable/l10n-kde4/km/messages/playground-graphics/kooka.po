#: img_saver.cpp:71
msgid "Kooka Save Assistant"
msgstr "ជំនួយ​ការ​រក្សាទុក​របស់ Kooka"

#: img_saver.cpp:91
msgid ""
"<B>Save Assistant</B><P>Select an image format to save the scanned image."
msgstr "<B>ជំនួយការ​រក្សាទុក​</B><P>ជ្រើស​ទ្រង់ទ្រាយ​រូបភាព​មួយ​ដើម្បី​រក្សាទុក​រូបភាព​ដែល​បាន​ស្កេន ។"

#: img_saver.cpp:109
msgid "Available image formats:"
msgstr "ទ្រង់ទ្រាយ​រូបភាព​ដែល​មាន ៖"

#: img_saver.cpp:131
msgid "-No format selected-"
msgstr "-គ្មាន​ទ្រង់ទ្រាយ​បាន​ជ្រើស-"

#: img_saver.cpp:138
msgid "Select the image sub-format"
msgstr "ជ្រើស​ទ្រង់ទ្រាយ​រង​របស់​រូបភាព"

#: img_saver.cpp:143
msgid "Do not ask again for the save format if it is defined."
msgstr "កុំសួរ​ម្ដងទៀត​សម្រាប់​ទ្រង់ទ្រាយ​រក្សាទុក ប្រសិន​បើ​វា​ត្រូវ​បាន​កំណត់ ។"

#: img_saver.cpp:177
msgid "-no hint available-"
msgstr "-គ្មាន​ព័ត៌មាន​ជំនួយ-"

#: img_saver.cpp:291
#, kde-format
msgid ""
"The folder\n"
"%1\n"
" does not exist and could not be created;\n"
"please check the permissions."
msgstr ""
"មិនមាន​ថត\n"
"%1\n"
" និង​មិន​អាច​ត្រូវ​បានបង្កើត សូម​ពិនិត្យ​មើល​សិទ្ធិ ។"

#: img_saver.cpp:298
#, kde-format
msgid ""
"The directory\n"
"%1\n"
" is not writeable;\n"
"please check the permissions."
msgstr ""
"ថត\n"
"%1\n"
" មិន​អាច​សរសេរ​បាន ។\n"
"សូម​ពិនិត្យ​មើល​សិទ្ធិ ។"

#: img_saver.cpp:357
msgid "Filename"
msgstr "ឈ្មោះ​ឯកសារ"

#: img_saver.cpp:357
msgid "Enter filename:"
msgstr "បញ្ចូល​ឈ្មោះ​ឯកសារ ៖"

#: img_saver.cpp:501
msgid "palleted color image (16 or 24 bit depth)"
msgstr "រូបភាព​ពណ៌ស្រាល (ជម្រៅ ១៦ ឬ ២៤​ប៊ីត)"

#: img_saver.cpp:504
msgid "palleted gray scale image (16 bit depth)"
msgstr "រូបភាព​មាត្រដ្ឋាន​ប្រផេះ​ស្រាល (ជម្រៅ ១៦ប៊ីត)"

#: img_saver.cpp:507
msgid "lineart image (black and white, 1 bit depth)"
msgstr "រូបភាព​សិល្បៈ​បន្ទាត់ (សខ្មៅ, ជម្រៅ ១ ប៊ីត)"

#: img_saver.cpp:510
msgid "high (or true-) color image, not palleted"
msgstr "រូបភាព​ពណ៌​កម្រិត​ខ្ពស់ (ឬ ធម្មជាតិ) មិន​មែន​ស្រាល​ឡើយ"

#: img_saver.cpp:513
msgid "Unknown image type"
msgstr "មិន​ស្គាល់​ប្រភេទ​រូបភាព"

#: img_saver.cpp:724
msgid " image save OK      "
msgstr " image save OK      "

#: img_saver.cpp:725
msgid " permission error   "
msgstr " permission error   "

#: img_saver.cpp:726
msgid " bad filename       "
msgstr " ឈ្មោះ​ឯកសារ​មិន​ល្អ       "

#: img_saver.cpp:727
msgid " no space on device "
msgstr " គ្មាន​ទំហំ​នៅ​លើ​ឧបករណ៍"

#: img_saver.cpp:728
msgid " could not write image format "
msgstr " មិន​អាច​សរសេរ​ទ្រង់ទ្រាយ​រូបភាព"

#: img_saver.cpp:729
msgid " can not write file using that protocol "
msgstr " មិន​អាច​សរសេរ​ឯកសារ​ដោយ​ប្រើ​ពិធីការ​នោះ"

#: img_saver.cpp:730
msgid " user canceled saving "
msgstr " អ្នក​ប្រើ​បាន​បោះបង់​ការ​រក្សាទុក"

#: img_saver.cpp:731
msgid " unknown error      "
msgstr " មិន​ស្គាល់​កំហុស"

#: img_saver.cpp:732
msgid " parameter wrong    "
msgstr " ខុស​ប៉ារ៉ាម៉ែត្រ"

#: img_saver.cpp:781 img_saver.cpp:877
msgid ""
"The filename you supplied has no file extension.\n"
"Should the correct one be added automatically? "
msgstr ""
"ឈ្មោះ​ឯកសារ​ដែល​អ្នក​បាន​ផ្ដល់​គ្មាន​កន្ទុយ​ឡើយ ។\n"
"តើ​ឯកសារ​ដែល​មាន​កន្ទុយ​ត្រឹមត្រូវ​គួរ​ត្រូវ​បានបន្ថែម​ដោយ​ស្វ័យ​ប្រវត្តិ ?"

#: img_saver.cpp:782 img_saver.cpp:878
#, kde-format
msgid "That would result in the new filename: %1"
msgstr "គួរ​តែ​មាន​លទ្ធផល​នៅ​ក្នុង​ឈ្មោះ​ឯកសារ​ថ្មី ៖ %1"

#: img_saver.cpp:784 img_saver.cpp:880
msgid "Extension Missing"
msgstr "បាត់​ផ្នែក​បន្ថែម"

#: img_saver.cpp:785 img_saver.cpp:881
msgid "Add Extension"
msgstr "បន្ថែម​ផ្នែក​បន្ថែម"

#: img_saver.cpp:785 img_saver.cpp:881
msgid "Do Not Add"
msgstr "កុំ​បន្ថែម"

#: img_saver.cpp:802 img_saver.cpp:895
msgid "Format changes of images are currently not supported."
msgstr "បច្ចុប្បន្ន​នេះ ការ​ផ្លាស់ប្ដូរ​ទ្រង់ទ្រាយ​រូបភាព​មិន​ត្រូវ​បាន​គាំទ្រ​ឡើយ ។"

#: img_saver.cpp:803 img_saver.cpp:896
msgid "Wrong Extension Found"
msgstr "រកឃើញ​​ផ្នែក​បន្ថែម​ខុស"

#: imgprintdialog.cpp:59
msgid "Image Printing"
msgstr "ការ​បោះពុម្ព​រូបភាព"

#: imgprintdialog.cpp:64 imgprintdialog.cpp:117
msgid "Image Print Size"
msgstr "ទំហំ​បោះពុម្ព​រូបភាព"

#: imgprintdialog.cpp:68
msgid "Scale to same size as on screen"
msgstr "ធ្វើ​មាត្រដ្ឋាន​ទំហំ​ឲ្យ​ដូច​លើ​អេក្រង់"

#: imgprintdialog.cpp:70
msgid "Screen scaling. That prints according to the screen resolution."
msgstr "ការ​ធ្វើ​មាត្រដ្ឋាន​អេក្រង់ ។ បោះពុម្ព​អាស្រ័យ​តាម​គុណភាព​អេក្រង់ ។"

#: imgprintdialog.cpp:74
msgid "Original size (calculate from scan resolution)"
msgstr "ទំហំ​ដើម (គណនា​ពី​គុណភាព​ស្កេន)"

#: imgprintdialog.cpp:77
msgid ""
"Calculates the print size from the scan resolution. Enter the scan "
"resolution in the dialog field below."
msgstr "គណនា​ទំហំ​បោះពុម្ព​ពី​គុណភាព​ស្កេន ។ បញ្ចូល​គុណភាព​ស្កេន​នៅ​ក្នុង​វាល​ប្រអប់​ខាង​ក្រោម ។"

#: imgprintdialog.cpp:81
msgid "Scale image to custom dimension"
msgstr "ធ្វើ​មាត្រដ្ឋាន​រូបភាព​តាម​​វិមាត្រ​ផ្ទាល់​ខ្លួន"

#: imgprintdialog.cpp:83
msgid ""
"Set the print size yourself in the dialog below. The image is centered on "
"the paper."
msgstr "កំណត់​ទំហំ​បោះពុម្ព​ដោយ​ខ្លួនឯងនៅ​​ក្នុង​ប្រអប់​ខាង​ក្រោម ។ រូបភាព​នឹង​ស្ថិត​នៅ​ចំ​កណ្ដាល​ក្រដាស ។"

#: imgprintdialog.cpp:87
msgid "Scale image to fit to page"
msgstr "ធ្វើ​មាត្រដ្ឋាន​រូបភាព​ឲ្យ​សម​នឹង​ទំព័រ"

#: imgprintdialog.cpp:88
msgid ""
"Printout uses maximum space on the selected pager. Aspect ratio is "
"maintained."
msgstr "លទ្ធផល​បោះពុម្ព​ប្រើ​​ទំហំ​​​អតិបរមា​នៅ​លើ​ក្រដាស​ដែល​បាន​ជ្រើស ។ សមាមាត្រ​នឹង​ត្រូវ​បាន​រក្សា ។"

#: imgprintdialog.cpp:98
msgid "Resolutions"
msgstr "គុណភាព​បង្ហាញ"

#: imgprintdialog.cpp:102
msgid "Generate low resolution PostScript (fast draft print)"
msgstr "បង្កើត PostScript ដែល​មាន​គុណភាព​បង្ហាញ​ទាប (បោះពុម្ព​សេចក្ដី​ព្រាង​លឿន)"

#: imgprintdialog.cpp:109
msgid "Scan resolution (dpi) "
msgstr "គុណភាព​ស្កេន (dpi) "

#: imgprintdialog.cpp:111
msgid " dpi"
msgstr " dpi"

#: imgprintdialog.cpp:121
msgid "Image width:"
msgstr "ទទឹង​រូបភាព ៖"

#: imgprintdialog.cpp:122 imgprintdialog.cpp:126
msgid " mm"
msgstr " ម.ម​."

#: imgprintdialog.cpp:125
msgid "Image height:"
msgstr "កម្ពស់​រូបភាព ៖"

#: imgprintdialog.cpp:129
msgid "Maintain aspect ratio"
msgstr "រក្សា​សមាមាត្រ"

#: imgprintdialog.cpp:174
#, kde-format
msgid "Screen resolution: %1 dpi"
msgstr "Screen resolution: %1 dpi"

#: imgprintdialog.cpp:218
msgid "Please specify a scan resolution larger than 0"
msgstr "សូម​បញ្ជាក់​គុណភាព​ស្កេន​ធំ​ជាង 0"

#: imgprintdialog.cpp:223
msgid ""
"For custom printing, a valid size should be specified.\n"
"At least one dimension is zero."
msgstr ""
"សម្រាប់​ការ​បោះពុម្ព​ផ្ទាល់​ខ្លួន អ្នក​គួរ​តែ​បញ្ជាក់​តម្លៃ​ត្រឹមត្រូវ​មួយ ។\n"
"យ៉ាង​ហោច​ណាស់ វិមាត្រ​មួយ​ស្មើ​សូន្យ ។"

#: kocrbase.cpp:81 kookapref.cpp:89
msgid "Optical Character Recognition"
msgstr "ការ​ទទួល​ស្គាល់​តួអក្សរ​អុបទិក (OCR)"

#: kocrbase.cpp:85
msgid "Start OCR"
msgstr "ចាប់ផ្ដើម OCR"

#: kocrbase.cpp:85
msgid "Start the Optical Character Recognition process"
msgstr "ចាប់ផ្ដើម​ដំណើរការ​ការ​ទទួល​ស្គាល់​តួអក្សរ​អុបទិក"

#: kocrbase.cpp:86
msgid "Cancel"
msgstr "បោះបង់"

#: kocrbase.cpp:86
msgid "Stop the OCR Process"
msgstr "បញ្ឈប់​ដំណើរការ OCR"

#: kocrbase.cpp:130
msgid "Image"
msgstr "រូបភាព"

#: kocrbase.cpp:131
msgid "Image Information"
msgstr "ព័ត៌មាន​អំពី​រូបភាព"

#: kocrbase.cpp:156 kookapref.cpp:88
msgid "OCR"
msgstr "OCR"

#: kocrbase.cpp:160
#, kde-format
msgid "<b>Starting Optical Character Recognition with %1</b><p>"
msgstr "<b>ចាប់ផ្ដើម​ការ​ទទួល​ស្គាល់​តួអក្សរ​អុបទិក​ជាមួយ %1</b><p>"

#: kocrbase.cpp:188
msgid "Spell-checking"
msgstr "ការ​ពិនិត្យ​អក្ខរាវិរុទ្ធ"

#: kocrbase.cpp:191
msgid "OCR Post Processing"
msgstr "ដំណើរការ​ក្រោយ OCR"

#: kocrbase.cpp:192
msgid "Enable spell-checking for validation of the OCR result"
msgstr "អនុញ្ញាត​ឲ្យ​ពិនិត្យ​អក្ខរាវិរុទ្ធ ដើម្បី​ផ្ទៀងផ្ទាត់​លទ្ធផល OCR"

#: kocrbase.cpp:195
msgid "Spell-Check Options"
msgstr "ជម្រើស​ពិនិត្យ​អក្ខរាវិរុទ្ធ"

#: kocrgocr.cpp:77
msgid "GOCR"
msgstr "GOCR"

#: kocrgocr.cpp:82
msgid ""
"GOCR is an Open Source project for optical character recognition.<P>The "
"author of gocr is <B>Joerg Schulenburg</B><BR>For more information about "
"gocr see <A HREF=http://jocr.sourceforge.net>http://jocr.sourceforge.net</A>"
msgstr ""
"GOCR គឺ​ជា​គម្រោង​កូដ​បើក​ចំហ​សម្រាប់ការ​​ទទួល​ស្គាល់​តួអក្សរ​អុបទិក ។<P>អ្នក​និពន្ធរបស់ gocr គឺ <B>Joerg "
"Schulenburg</B><BR>សម្រាប់​ព័ត៌មាន​បន្ថែម​អំពី gocr សូម​មើល <A HREF=http://jocr."
"sourceforge.net>http//jocr.sourceforge.net</A>"

#: kocrgocr.cpp:111
msgid ""
"The path to the gocr binary is not configured yet.\n"
"Please go to the Kooka configuration and enter the path manually."
msgstr ""
"មិន​ទាន់​បាន​កំណត់​រចនាសម្ព័ន្ធ​ផ្លូវ​ទៅ​កាន់​ឯកសារ​គោល​ពីរ gocr នៅ​ឡើយ​ទេ ។\n"
"សូម​ចូល​ទៅ​ការ​កំណត់​រចនាសម្ព័ន្ធ Kooka ហើយ​បញ្ចូល​ផ្លូវ​ដោយ​ដៃ ។"

#: kocrgocr.cpp:113 kocrocrad.cpp:124 kookapref.cpp:299
msgid "OCR Software Not Found"
msgstr "រក​មិន​ឃើញ​កម្មវិធី OCR"

#: kocrgocr.cpp:118 kocrocrad.cpp:129
msgid "Not found"
msgstr "រក​មិន​ឃើញ"

#: kocrgocr.cpp:122
msgid "Using GOCR binary: "
msgstr "ការ​​ប្រើ​ឯកសារ​គោល​ពីរ GOCR ៖"

#: kocrgocr.cpp:133
msgid "&Gray level"
msgstr "កម្រិត​ស្រអាប់"

#: kocrgocr.cpp:137
msgid ""
"The numeric value gray pixels are \n"
"considered to be black.\n"
"\n"
"Default is 160"
msgstr ""
"ភីកសែល​ប្រផេះ​ដែល​មាន​តម្លៃ​ជា​លេខ\n"
"ត្រូវ​បាន​ចាត់​ទុក​ជា​ពណ៌​ខ្មៅ ។\n"
"\n"
"លំនាំដើម​គឺ ១៦០"

#: kocrgocr.cpp:139
msgid "&Dust size"
msgstr "ទំហំធូលី"

#: kocrgocr.cpp:143
msgid ""
"Clusters smaller than this value\n"
"will be considered to be dust and \n"
"removed from the image.\n"
"\n"
"Default is 10"
msgstr ""
"ក្រុម​ដែល​តូច​ជាង​តម្លៃ​នេះ\n"
"ត្រូវ​ចាត់ទុក​ជា​ធូលី\n"
"ហើយ​នឹង​ត្រូវ​បាន​យកចេញ​ពី​រូបភាព ។\n"
"\n"
"លំនាំដើម​គឺ ១០"

#: kocrgocr.cpp:145
msgid "&Space width"
msgstr "ទទឹង​ទំហំ"

#: kocrgocr.cpp:148
msgid ""
"Spacing between characters.\n"
"\n"
"Default is 0 what means autodetection"
msgstr ""
"ចន្លោះ​រវាង​តួអក្សរ ។\n"
"\n"
