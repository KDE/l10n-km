#: libkgapi/accessmanager_p.cpp:82
msgid "No valid reply received"
msgstr "មិន​បាន​ទទួល​ចម្លើយ​តប​ត្រឹមត្រូវ​ទេ"

#: libkgapi/accessmanager_p.cpp:112
msgid "Bad request."
msgstr "សំណើ​មិន​ល្អ"

#: libkgapi/accessmanager_p.cpp:170 libkgapi/accessmanager_p.cpp:171
#, kde-format
msgid ""
"Requested resource is forbidden.\n"
"\n"
"Google replied '%1'"
msgstr ""
"បាន​ទប់ស្កាត់​ធនធាន​ដែល​បាន​ស្នើ ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:179 libkgapi/accessmanager_p.cpp:180
#, kde-format
msgid ""
"Requested resource does not exist.\n"
"\n"
"Google replied '%1'"
msgstr ""
"មិន​មាន​ធនធាន​ដែល​បាន​ស្នើ​ទេ ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:188 libkgapi/accessmanager_p.cpp:189
#, fuzzy, kde-format
#| msgid ""
#| "Conflict. Remote resource is newer then local.\n"
#| "\n"
#| "Google replied '%1'"
msgid ""
"Conflict. Remote resource is newer than local.\n"
"\n"
"Google replied '%1'"
msgstr ""
"ប៉ះទង្គិច ធនធាន​ពី​ចម្ងាយ​គឺ​ថ្មី​ជាង​ធនធាន​មូលដ្ឋាន ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:197 libkgapi/accessmanager_p.cpp:198
#, kde-format
msgid ""
"Requested resource does not exist anymore.\n"
"\n"
"Google replied '%1'"
msgstr ""
"ធនធាន​ដែល​បាន​ស្នើ​មិន​មាន​ទៀត​ទេ ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:206 libkgapi/accessmanager_p.cpp:207
#, kde-format
msgid ""
"Internal server error. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"កំហុស​ម៉ាស៊ីន​បម្រើ​ខាងក្នុង សាកល្បង​ម្ដងទៀត​នៅ​ពេល​ក្រោយ ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:215 libkgapi/accessmanager_p.cpp:216
#, kde-format
msgid ""
"User quota exceeded. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"បាន​លើស​ពី​កូតា​អ្នកប្រើ សូម​ព្យាយាម​ម្ដងទៀត​នៅ​ពេល​ក្រោយ ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:224
#, kde-format
msgid ""
"Unknown error.\n"
"\n"
"Google replied '%1'"
msgstr ""
"មិន​ស្គាល់​កំហុស ។\n"
"\n"
"Google បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:255 libkgapi/accessmanager_p.cpp:256
#, fuzzy
#| msgid "Unknown reply content type!"
msgid "Unknown reply content type."
msgstr "មិន​ស្គាល់​ប្រភេទ​មាតិកា​ឆ្លើយតប !"

#: libkgapi/accessmanager_p.cpp:331
#, kde-format
msgid "Invalid request, service %1 is not registered."
msgstr "សំណើ​មិន​ត្រឹមត្រូវ សេវាកម្ម %1 មិន​ត្រូវ​បាន​ចុះឈ្មោះ​ទេ ។"

#: libkgapi/auth_p.cpp:178
msgid "Authentication cancelled"
msgstr "បាន​បោះបង់​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#: libkgapi/auth_p.cpp:230
msgid "Failed to parse newly fetched tokens"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ញែក​ថូខឹន​ដែល​បាន​ទៅ​ប្រមូល​យក​ថ្មីៗ"

#: libkgapi/common.h:100
msgid "An unknown error has occurred."
msgstr "មាន​កំហុស​មិន​ស្គាល់​បាន​កើតឡើង ។"

#: libkgapi/common.h:126
#, kde-format
