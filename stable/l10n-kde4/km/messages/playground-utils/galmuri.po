#: repositorymanager.cpp:80
#, kde-format
msgid "Error in repositories.xml at line %1, column %2: %3"
msgstr "កំហុស​ក្នុង repositories.xml នៅ​បន្ទាត់​ទី %1, ជួរ​ឈរ %2: %3"

#: repositorymanager.cpp:102
msgid "Could not open repositories.xml for writing"
msgstr "មិន​អាច​បើក​ឃ្លាំង repositories.xml សម្រាប់​សរសេរ"

#: repositorymodel.cpp:99
msgid "Repository"
msgstr "ឃ្លាំង"

#: repositorymodel.cpp:100
msgid "URL"
msgstr "URL"

#: manager/mainwindow.cpp:51
msgid "N&ew Job..."
msgstr "ការងារ​ថ្មី..."

#: manager/mainwindow.cpp:57
msgid "&Delete"
msgstr "លុប"

#: manager/mainwindow.cpp:62
msgid "Job &Properties..."
msgstr "លក្ខណៈ​សម្បត្តិ​ការងារ..."

#: manager/newjobwizard.cpp:48
msgid "Create A New Job"
msgstr "បង្កើត​ការងារ​ថ្មី"

#: manager/newjobwizard.cpp:58
msgid "This target is not configurable."
msgstr "គោលដៅ​នេះ​មិន​អាច​កំណត់​រចនា​សម្ព័ន្ធ​បាន ។"

#: manager/newjobwizard.cpp:76
msgid "&Previous"
msgstr "មុន"

#: manager/newjobwizard.cpp:77
msgid "&Next"
msgstr "បន្ទាប់"

#: manager/newjobwizard.cpp:143
msgid "Step 1: Basic Settings"
msgstr "ជំហាន​ទី ១ ៖ កា​រកំណត់​មូលដ្ឋាន"

#: manager/newjobwizard.cpp:144
msgid ""
"Please note that job description is not essential therefore you may leave it "
"blank."
msgstr "សូម​ចំណាំ​ថា សេចក្ដីពិពណ៌នា​ការងារ​មិន​សំខាន់​ទេ ដូច្នេះ​អ្នកអាច​ទុក​ឲ្យ​វា​នៅ​ទំនេរ ។"

#: manager/newjobwizard.cpp:154
msgid "Step 2: Job Details"
msgstr "ជំហានទី ២ ៖ សេចក្ដី​លម្អិត​ការងារ"

#: manager/newjobwizard.cpp:155
msgid "You can configure target-specific options here."
msgstr "អ្នក​អាច​កំណត់​រចនាសម្ព័ន្ធ​សកម្មភាព​ជាក់លាក់​គោលដៅ​នៅ​ទីនេះ ។"

#: manager/newjobwizard.cpp:168
msgid "Step 3: Timing Conditions"
msgstr "ជំហាន​ទី ៣ ៖ ការ​កំណត់​លក្ខខណ្ឌ​ពេលវេលា"

#: manager/newjobwizard.cpp:195
msgid "You must enter a job name."
msgstr "អ្នក​ត្រូវ​តែ​បញ្ចូល​ឈ្មោះ​ការងារ ។"

#: manager/newjobwizard.cpp:202
msgid "Please select a backup target."
msgstr "សូម​ជ្រើស​គោលកដៅ​បម្រុង​ទុក ។"

#: manager/pluginmodel.cpp:36
msgid "Target"
msgstr "គោលដៅ"

#: manager/pluginmodel.cpp:37
msgid "Description"
msgstr "សេចក្ដី​ពិពណ៌នា"
