#: main.cpp:54
msgid "kcmkvaio"
msgstr "kcmkvaio"

#: main.cpp:55
msgid "KDE Control Module for Sony Vaio Laptop Hardware"
msgstr "ម៉ូឌុល​បញ្ជា KDE សម្រាប់​ផ្នែក​រឹង​កុំព្យូទ័រ​យួរ​ដៃ Sony Vaio"

#: main.cpp:58
msgid "(c) 2003 Mirko Boehm"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ 2003 ដោយ Mirko Boehm"

#: main.cpp:60
msgid "Mirko Boehm"
msgstr "Mirko Boehm"

#: main.cpp:61
msgid "Original author"
msgstr "អ្នក​និពន្ធ​ដើម"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 16
#: rc.cpp:3
msgid "KVaio: General Options"
msgstr "KVaio ៖ ជម្រើស​ទូទៅ"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 36
#: rc.cpp:6
msgid ""
"Cannot find the <i>Sony Programmable Interrupt Controller</i>. If this is a "
"Sony Vaio Laptop, make sure the <b>sonypi</b> driver module loads without "
"failures."
msgstr ""
"មិន​អាច​រកឃើញ <i>វត្ថុ​បញ្ជា​រំខាន​ដែល​អាច​រៀបចំ​កម្មវិធី​បាន​របស់ Sony</i> ។ បើ​វា​ជា​កុំព្យូទ័រ​យួរ​ដៃ "
"Sony Vaio សូម​ឲ្យ​ប្រាកដ​ថា​ម៉ូឌុល​កម្មវិធី​បញ្ជា <b>sonypi</b> ផ្ទុក​ដោយ​មិន​បរាជ័យ ។"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 61
#: rc.cpp:9
msgid "System Power"
msgstr "ថាមពល​ប្រព័ន្ធ"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 72
#: rc.cpp:12
msgid "Remaining battery capacity:"
msgstr "សមាសភាព​ថ្ម​ដែល​នៅ​សល់ ៖"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 110
#: rc.cpp:15
msgid "AC"
msgstr "ចរន្ត​ឆ្លាស់"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 151
#: rc.cpp:18
msgid "Bat 1"
msgstr "ថ្ម ១"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 187
#: rc.cpp:21
msgid "Bat 2"
msgstr "ថ្ម ២"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 200
#: rc.cpp:24
msgid "Other Options"
msgstr "ជម្រើស​ផ្សេង​ទៀត"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 211
#: rc.cpp:27
msgid "Periodically inform about battery and AC adapter status"
msgstr "ជូន​ដំណឹង​ទៀត​ទាត់​អំពី​ស្ថានភាព​ថ្ម និង ចរន្ត​ឆ្លាស់"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 219
#: rc.cpp:30
msgid "Show battery and AC status on Back button press"
msgstr "បង្ហាញ​ស្ថានភាព​ថ្ម និង ចរន្ត​ឆ្លាស់​នៅ​ពេល​ចុច​ប៊ូតុង​ថយក្រោយ"

#. i18n: tag string
#. i18n: file kcmkvaio_general.ui line 227
#: rc.cpp:33
msgid "Report unhandled events using On Screen Display"
msgstr "រាយការណ៍​ព្រឹត្តិការណ៍​មិន​បាន​ដោះស្រាយ ដោយ​ប្រើ​ការ​បង្ហាញ​លើ​អេក្រង់"

