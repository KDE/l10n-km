#: part.cpp:86
msgctxt "@title:menu"
msgid "&Value Coding"
msgstr "កូដ​តម្លៃ"

#: part.cpp:88
msgctxt "@item:inmenu encoding of the bytes as values in the hexadecimal format"
msgid "&Hexadecimal"
msgstr "គោលដប់ប្រាំមួយ"

#: part.cpp:89
msgctxt "@item:inmenu encoding of the bytes as values in the decimal format"
msgid "&Decimal"
msgstr "គោល​ដប់"

#: part.cpp:90
msgctxt "@item:inmenu encoding of the bytes as values in the octal format"
msgid "&Octal"
msgstr "គោលប្រាំបី"

#: part.cpp:91
msgctxt "@item:inmenu encoding of the bytes as values in the binary format"
msgid "&Binary"
msgstr "គោលពីរ"

#: part.cpp:97
msgctxt "@title:menu"
msgid "&Char Encoding"
msgstr "ការ​អ៊ិនកូដ​តួអក្សរ"

#: part.cpp:102
msgctxt "@option:check"
msgid "Show &Non-printing Chars"
msgstr "បង្ហាញ​តួអក្សរ​មិនអាច​បោះពុម្ព"

#: part.cpp:110
msgctxt "@title:menu"
msgid "&Dynamic Layout"
msgstr "ប្លង់​ថាមវន្ត"

#: part.cpp:113
msgctxt "@item:inmenu  The layout will not change on size changes."
msgid "&Off"
msgstr "បិទ"

#: part.cpp:115
msgctxt ""
"@item:inmenu  The layout will adapt to the size, but only with complete "
"groups of bytes."
msgid "&Wrap Only Complete Byte Groups"
msgstr "រុំ​តែ​ក្រុម​បៃ​ពេញលេញ"

#: part.cpp:117
msgctxt ""
"@item:inmenu  The layout will adapt to the size and fit in as much bytes per "
"line as possible."
msgid "&On"
msgstr "បើក"

#: part.cpp:122
msgctxt "@option:check"
msgid "&Line Offset"
msgstr "អុហ្វសិត​ជួរ"

#: part.cpp:128
msgctxt "@title:menu"
msgid "&Show Values or Chars"
msgstr "បង្ហាញ​តម្លៃ ឬ​តួអក្សរ"

#: part.cpp:130
#| msgctxt "@item:inmenu"
#| msgid "&Values Column"
msgctxt "@item:inmenu"
msgid "&Values"
msgstr "​តម្លៃ"

#: part.cpp:131
#| msgctxt "@item:inmenu"
#| msgid "&Chars Column"
msgctxt "@item:inmenu"
msgid "&Chars"
msgstr "តួអក្សរ"

#: part.cpp:132
msgctxt "@item:inmenu"
msgid "Values && Chars"
msgstr "តម្លៃ និង​តួអក្សរ"

#: partfactory.cpp:35
msgid "OktetaPart"
msgstr "OktetaPart"

