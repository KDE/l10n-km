#: warning.cpp:104 warning.cpp:105
msgid "Low &trigger:"
msgstr "កេះ​ទាប ៖"

#: warning.cpp:127
msgid "Run &command:"
msgstr "រត់ពាក្យបញ្ជា ៖"

#: warning.cpp:139
msgid "This command will be run when the battery gets low"
msgstr "បញ្ជានេះ​នឹង ត្រូវបានរត់នៅពេល​អស់ថ្ម"

#: warning.cpp:142
msgid "&Play sound:"
msgstr "ចាក់​សម្លេង ៖"

#: warning.cpp:154
msgid "This sound will play when the battery gets low"
msgstr "នឹង​ចាក់​សម្លេង​នេះ​នៅពេល​អស់ថ្ម"

#: warning.cpp:157
msgid "System &beep"
msgstr "សម្លេង ប៊ីប របស់ ប្រព័ន្ធ"

#: warning.cpp:160
msgid "The system will beep if this is enabled"
msgstr "ប្រព័ន្ធ​នឹង​ឮសម្លេង​ប៊ីប​ ប្រសិន​បើ​បិទវា"

#: warning.cpp:162
msgid "&Notify"
msgstr "ជូនដំណឹង"

#: warning.cpp:172
msgid "Panel b&rightness"
msgstr "បន្ទះពន្លឺ"

#: warning.cpp:174
msgid "If enabled the back panel brightness will change"
msgstr "វានឹង ប្តួរ​ប្រសិន​បើ​បន្ទះ​ពន្លឺ​ខាងក្រោយ​ត្រូវបាន​អនុញ្ញាត"

#: warning.cpp:180
msgid "How bright or dim to make the back panel"
msgstr "តើ​កម្រិត​ភ្លឺ​និង​ស្រអាប់​ប៉ុន្មាន​ដើម្បី​បង្កើត​បន្ទះ​ខាងក្រោយ"

#: warning.cpp:199
msgid "If enabled the laptop's power performance profile will change"
msgstr "ប្រសិនបើ​បាន​អនុញ្ញាត នោះ​ទម្រង់​សមត្ថភាពថាមពល​របស់​កុំព្យូទ័រ​នឹង​ផ្លាស់ប្ដូរ"

#: warning.cpp:208
msgid "The performance profile to change to"
msgstr "ទម្រង់សមត្ថភាព​ដែលត្រូវផ្លាស់ប្ដូរ​ទៅ"

#: warning.cpp:222
msgid "If enabled the CPU performance will be throttled"
msgstr "ប្រសិនបើ​បានអនុញ្ញាត នោះ​សមត្ថភាព CPU នឹងត្រូវបាន​បើក"

#: warning.cpp:231
msgid "How much to throttle the CPU performance by"
msgstr "សមត្ថ​ភាព​ CPU ត្រូវ​បិទ​ឬ​បើក​តាម​ចំនួន​ប៉ុន្មាន"

#: warning.cpp:243
msgid "System State Change"
msgstr "ការផ្លាស់ប្ដូរ​ស្ថាន​ភាព​ប្រព័ន្ធ"

#: warning.cpp:244
msgid "You may choose one of the following to occur when the battery gets low"
msgstr "អ្នកអាច​ជ្រើស​អ្វី​មួយ​ក្នុងចំណោម​អ្វី​នៅខាងក្រោមដើម្បី​ឲ្យ​កើតឡើង នៅពេល​ដែល​ថ្ម​ជិត​អស់"

#: warning.cpp:248
msgid "Move the system into the standby state - a temporary lower power state"
msgstr "ផ្លាស់ទី​ប្រព័ន្ធ​ទៅក្នុង​សភាពរង់ចាំ - សភាព​ដែលជិត​អស់​ថាមពល​បណ្ដោះអាសន្ន"

#: warning.cpp:254
msgid "Move the system into the suspend state - also known as 'save-to-ram'"
msgstr "ផ្លាស់ទី​ប្រព័ន្ធ​ទៅជា​សភាព​ផ្អាក - ក៏បានដឹង​ដែរ​ថាជា 'រក្សាទុក​ទៅកាន់​សតិ'"

#: warning.cpp:260
msgid "Move the system into the hibernate state - also known as 'save-to-disk'"
msgstr "ផ្លាស់ទី​ប្រព័ន្ធ​ទៅ​ជា​សភាព​សម្ងំ - ក៏​បានដឹងដែរថា​ជា 'រក្សាទុក​ទៅកាន់​ថាស'"

#: warning.cpp:265
msgid "&Logout"
msgstr "ចេញ"

#: warning.cpp:269
msgid "Power the laptop off"
msgstr "បិទកុំព្យួទ័រយួរដៃ"

#: warning.cpp:272
#, fuzzy
msgid "&None"
msgstr "គ្មាន"

#: warning.cpp:281
msgid ""
"This panel controls how and when you receive warnings that your battery "
"power is going to run out VERY VERY soon."
msgstr ""
"បន្ទះ​នេះ​ត្រួតពិនិត្យ​អំពី​របៀប និង អ្វី​ដែលអ្នក​ទទួល​ការព្រមាន​ថា​ថាមពល​ថ្ម​របស់អ្នក​នឹង​អស់​ក្នុង​ពេល​ឆាប់បំផុត ។"

#: warning.cpp:283
msgid ""
"This panel controls how and when you receive warnings that your battery "
"power is about to run out"
msgstr "បន្ទះ​នេះ​ត្រួតពិនិត្យ​អំពី​របៀប និង អ្វី​ដែលអ្នក​បាន​ទទួល​ការព្រមាន​ថា​ថាមពល​ថ្ម​របស់​អ្នក​ប្រហែល​ជាអស់"

#: warning.cpp:644 warning.cpp:661
msgid "Only local files are currently supported."
msgstr "មាន​តែ​ឯកសារ​មូលដ្ឋាន​ប៉ុណ្ណោះ​ដែល​បច្ចុប្បន្ន​ត្រូវបាន​គាំទ្រ ។"

#: warning.cpp:672
msgid ""
"<h1>Low battery Warning</h1>This module allows you to set an alarm in case "
"your battery's charge is about to run out."
msgstr ""
"<h1>ការព្រមាន​អំពីការ​ជិត​អស់ថ្ម</h1>ម៉ូឌុល​នេះ​អនុញ្ញាត​ឲ្យអ្នកកំណត់​សូរសម្លេង​ នៅក្នុង​ករណី​ដែល​ការសាកថ្ម​"
"របស់​ថ្ម​របស់អ្នក​​ប្រហែល​ជាអស់ ។"

#~ msgid "N/A"
#~ msgstr "មិនមាន"
