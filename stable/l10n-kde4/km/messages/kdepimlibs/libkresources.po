#: configdialog.cpp:63 configpage.cpp:144 configpage.cpp:361
msgid "Resource Configuration"
msgstr "ការ​កំណត់​រចនាសម្ព័ន្ធ​ធនធាន"

#: configdialog.cpp:83
msgid "General Settings"
msgstr "ការ​កំណត់​ទូទៅ"

#: configdialog.cpp:85
msgid "Name:"
msgstr "ឈ្មោះ ៖"

#: configdialog.cpp:90
msgid "Read-only"
msgstr "បាន​តែ​អាន"

#: configdialog.cpp:104
#, kde-format
msgid "%1 Resource Settings"
msgstr "ការ​កំណត់​ធនធាន %1 "

#: configdialog.cpp:152
msgid "Please enter a resource name."
msgstr "សូម​បញ្ចូល​ឈ្មោះ​ធនធាន​មួយ ។"

#: configpage.cpp:91 configpage.cpp:105
msgid "Yes"
msgstr "បាទ/ចាស"

#: configpage.cpp:148 selectdialog.cpp:65
msgid "Resources"
msgstr "ធនធាន"

#: configpage.cpp:162
msgid "Name"
msgstr "ឈ្មោះ"

#: configpage.cpp:162
msgid "Type"
msgstr "ប្រភេទ"

#: configpage.cpp:162
msgid "Standard"
msgstr "ស្តង់ដារ"

#: configpage.cpp:170
msgid "&Add..."
msgstr "បន្ថែម..."

#: configpage.cpp:174
msgid "&Remove"
msgstr "យក​ចេញ​"

#: configpage.cpp:179
msgid "&Edit..."
msgstr "កែសម្រួល..."

#: configpage.cpp:184
msgid "&Use as Standard"
msgstr "ប្រើ​ជា​ស្តង់ដារ"

#: configpage.cpp:345
msgid "There is no standard resource. Please select one."
msgstr "គ្មាន​ធនធាន​ស្តង់ដារ ។ សូម​ជ្រើស​មួយ ។"

#: configpage.cpp:362
msgid "Please select type of the new resource:"
msgstr "សូម​ជ្រើស​ប្រភេទ​ធនធាន​ថ្មី ៖"

#: configpage.cpp:374
#, kde-format
msgid "Unable to create resource of type '%1'."
msgstr "មិន​អាច​បង្កើត​​​ធនធាន​ប្រភេទ '%1' ។"

#: configpage.cpp:427
msgid ""
"You cannot remove your standard resource. Please select a new standard "
"resource first."
msgstr "អ្នក​មិន​អាច​យក​ធនធាន​ស្តង់ដារ​របស់​អ្នក​ចេញ​បាន​ទេ ។​ សូម​ជ្រើស​ធនធាន​ស្តង់ដារ​ថ្មី​សិន ។"

#: configpage.cpp:465 configpage.cpp:486
msgid "You cannot use a read-only resource as standard."
msgstr "មិនអាច​ប្រើ​ធានធាន​បាន​តែ​អាន​ជា​ស្តង់ដារ ។"

#: configpage.cpp:491
msgid "You cannot use an inactive resource as standard."
msgstr "អ្នក​មិន​អាច​ប្រើ​ធនធាន​អសកម្ម​ជា​ស្តង់ដារ​បាន​ទេ ។"

#: configpage.cpp:575
msgid ""
"You cannot deactivate the standard resource. Choose another standard "
"resource first."
msgstr "អ្នក​មិន​អាច​​ធ្វើ​ឲ្យ​ធនធានស្តង់ដារ​សកម្ម​​បាន​ទេ ។ ដំបូង សូមជ្រើស​​ធនធានស្តង់ដារ​​មួយ​ផ្សេង​សិន ។"

#: configpage.cpp:604
msgid ""
"There is no valid standard resource. Please select one which is neither read-"
"only nor inactive."
msgstr "មិនមាន​ធនធាន​ស្តង់ដារ​ត្រឹមត្រូវ​ទេ ។ សូម​ជ្រើស​ធនធាន​មួយ​ដែល​អាច​បាន​តែ​អា ឬ​មិន​សកម្ម ។"

