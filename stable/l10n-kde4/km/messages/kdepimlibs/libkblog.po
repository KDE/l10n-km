#: blogger1.cpp:244
msgid "Could not fetch user's info out of the result from the server, not a map."
msgstr "មិន​អាច​ទៅ​យក​ព័ត៌មាន​របស់​អ្នក​ប្រើ​ចេញ​ពីលទ្ធផល​មក​ពីម៉ាស៊ី​ន​បម្រើ  មិនមែន​ជា​ផែនទី ។"

#: blogger1.cpp:271
msgid "Could not fetch blogs out of the result from the server, not a list."
msgstr "មិន​អាច​ទៅ​យក​កំណត់​ហេតុ​បណ្តាញ​ចេញ​ពី​លទ្ធផល​មក​ពី​ម៉ាស៊ីនបម្រើ​ មិនមែន​ជា​បញ្ជី ។"

#: blogger1.cpp:308
msgid "Could not fetch list of posts out of the result from the server, not a list."
msgstr "មិន​អាច​ទៅ​យក​បញ្ជី​ប្រកាសចេញពី​លទ្ធផល​មក​ពី​ម៉ាស៊ីន​បម្រើ​ មិន​មែន​ជា​បញ្ជី ។"

#: blogger1.cpp:327
msgid "Could not read post."
msgstr "មិន​អាច​អាន​ប្រកាស ។"

#: blogger1.cpp:355 blogger1.cpp:358 movabletype.cpp:280 movabletype.cpp:283
msgid "Could not fetch post out of the result from the server."
msgstr "មិន​អាច​ទៅ​យក​ការ​ប្រកាស​ចេញ​ពីលទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ​បាន​ទេ ។"

#: blogger1.cpp:376 movabletype.cpp:241
msgid "Could not read the postId, not a string or an integer."
msgstr "មិន​អាច​អាន​ postId មិន​មែន​ជា​​ខ្សែអក្សរ ឬ​ចំនួន​គត់ ។"

#: blogger1.cpp:409 blogger1.cpp:433 movabletype.cpp:315
msgid "Could not read the result, not a boolean."
msgstr "មិន​អាច​អាន​លទ្ធផល មិន​មែន​ជា​ប៊ូលីន ។"

#: gdata.cpp:214 gdata.cpp:279 gdata.cpp:339 gdata.cpp:383 gdata.cpp:438
msgid "Authentication failed."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ផ្ទៀង​ផ្ទាត់​ភាព​ត្រឹម​ត្រូវ ។"

#: gdata.cpp:522
msgid "Could not regexp the Profile ID."
msgstr "មិន​អាច​ regexp លេខ​សម្គាល់​ទម្រង់ ។"

#: gdata.cpp:542
msgid "Could not get blogs."
msgstr "មិន​អាច​ទទួលយក​​កំណត់​ហេតុ​បណ្តាញ​បាន​ទេ ។"

#: gdata.cpp:564 gdata.cpp:784
msgid "Could not regexp the blog id path."
msgstr "មិន​អាច​ regexp ផ្លូវ​លេខ​សម្គាល់​របស់កំណត់​ហេតុ​បណ្តាញ ។"

#: gdata.cpp:585 gdata.cpp:631
msgid "Could not get comments."
msgstr "មិន​អាច​ទទួល​សេចក្ដី​អធិប្បាយ ។"

#: gdata.cpp:599 gdata.cpp:645
msgid "Could not regexp the comment id path."
msgstr "មិន​អាច regexp ផ្លូវ​លេខ​សម្គាល់​របស់​សេច​ក្ដីអធិប្បាយ ។"

#: gdata.cpp:677 gdata.cpp:752
msgid "Could not get posts."
msgstr "មិនអាច​ទទួល​ប្រកាស ។"

#: gdata.cpp:697
msgid "Could not regexp the post id path."
msgstr "មិន​អាច regexp ផ្លូវ​​​លេខសម្គាល់​របស់​ប្រកាស ។"

#: gdata.cpp:813 gdata.cpp:867 gdata.cpp:948 wordpressbuggy.cpp:332
#: wordpressbuggy.cpp:381
msgid "Could not regexp the id out of the result."
msgstr "មិន​អាច​ regexp លេខ​សម្គាល់​ចេញ​ពី​លទ្ធផល​បាន​ទេ ។"

#: gdata.cpp:822 gdata.cpp:876 gdata.cpp:957
msgid "Could not regexp the published time out of the result."
msgstr "មិន​អាច​ regexp អស់ពេល​​ដែល​បាន​បោះ​ពុម្ពផ្សាយ​លទ្ធផល​ ។"

#: gdata.cpp:831 gdata.cpp:885 gdata.cpp:966
msgid "Could not regexp the update time out of the result."
msgstr "មិន​អាច​ regexp អស់ពេល​បច្ចុប្បន្នភាព​ចេញ​​ពីលទ្ធផល​បាន​ទេ ។"

#: livejournal.cpp:344 livejournal.cpp:453 livejournal.cpp:478
msgid "Could not read the post ID, result not a map."
msgstr "មិន​អាច​អាន​លេខ​សម្គាល់ប្រកាស លទ្ធផល​មិន​មែន​ជា​ផែន​ទី ។"

#: livejournal.cpp:491
msgid "The returned post ID did not match the sent one: "
msgstr "លេខ​សម្គាល់​កា​រប្រកាស​ដែល​បាន​ត្រឡប់​មិន​ផ្គូផ្គង​​ការ​ប្រកាស​ដែល​បាន​ផ្ញើ​ចេញ ៖"

#: metaweblog.cpp:78
msgid "Media is a null pointer."
msgstr "មេឌៀ​គឺ​ជា​ចំណុច​​ទទេ"

#: metaweblog.cpp:188
msgid "Could not list categories out of the result from the server."
msgstr "មិន​អាច​រាយ​ប្រភេទ​ចេញ​ពី​លទ្ធផល​មក​ពី​ម៉ាស៊ីន​បម្រើ​បាន​ទេ ។"

#: metaweblog.cpp:250
msgid "Could not read the result, not a map."
msgstr "មិនអាច​អាន​លទ្ធផល មិនមែន​ជា​ផែនទី ។"

#: movabletype.cpp:380
#| msgid "Could not read the result, not a boolean."
msgid "Could not read the result - is not a list. Category fetching failed."
msgstr "មិន​អាច​អាន​លទ្ធផល​- មិន​មែន​ជា​បញ្ជី​ ។ បាន​បរាជ័យ​ប្រភេទ​នៃ​ការ​ទទួលយក​ ។"

#: movabletype.cpp:413
#| msgid "Could not read the result, not a boolean."
msgid ""
"Could not read the result - is not a boolean value. Category setting "
"failed.  Will still publish now if necessary."
msgstr ""
"មិន​អាច​អាន​លទ្ធផល​- មិន​មែន​ជា​តម្លៃ​ប៊ូលីន​ ។ បាន​បរាជ័យ​ក្នុង​ការកំណត់​ប្រភេទ ។  នឹងនៅ​តែ​បោះ​"
"ផ្សាយពុម្ពខណៈនេះ​បើ​ចាំបាច់ ។"

#: movabletype.cpp:535
msgid "Could not fetch list of trackback pings out of the result from the server."
msgstr "មិន​អាច​ទៅ​យក​បញ្ជី pings តាម​ដាន​ត្រឡប់​ចេញ​ពី​លទ្ធផល​មក​ពី​ម៉ាស៊ីន​បម្រើ​បាន​ទេ ។"

#: wordpressbuggy.cpp:77 wordpressbuggy.cpp:189
msgid "Post is a null pointer."
msgstr "ប្រកាស​គឺ​ជា​ចំណុច​ទទេ ។"

