#: plugin_katexmltools.cpp:127
msgid "&Insert Element..."
msgstr "បញ្ចូល​ធាតុ..."

#: plugin_katexmltools.cpp:132
msgid "&Close Element"
msgstr "បិទ​ធាតុ"

#: plugin_katexmltools.cpp:137
msgid "Assign Meta &DTD..."
msgstr "កំណត់ Meta DTD..."

#: plugin_katexmltools.cpp:405
msgid "Assign Meta DTD in XML Format"
msgstr "កំណត់ Meta DTD ក្នុង​ទ្រង់ទ្រាយ XML"

#: plugin_katexmltools.cpp:410
#, kde-format
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr ""
"ឯកសារ​បច្ចុប្បន្ន​ត្រូវ​បាន​កំណត់​អត្តសញ្ញាណ​ជា​ប្រភេទ​ឯកសារ \"%1\" ។ DTD "
"មេតា​សម្រាប់​ប្រភេទ​ឯកសារ​នេះ នឹង​ត្រូវ​បាន​ផ្ទុក​ឥឡូវនេះ ។"

#: plugin_katexmltools.cpp:413
msgid "Loading XML Meta DTD"
msgstr "កំពុង​ផ្ទុក XML Meta DTD"

#: plugin_katexmltools.cpp:448
#, kde-format
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "មិន​អាច​បើក​ឯកសារ '%1' បាន​ទេ ។ ម៉ាស៊ីន​បម្រើ​បាន​ត្រឡប់​កំហុស ។"

#: plugin_katexmltools.cpp:450 pseudo_dtd.cpp:50 pseudo_dtd.cpp:61
msgid "XML Plugin Error"
msgstr "កំហុស​កម្មវិធី​ជំនួយ XML"

#: plugin_katexmltools.cpp:1009
msgid "Insert XML Element"
msgstr "បញ្ចូល​ធាតុ XML"

#: plugin_katexmltools.cpp:1034
msgid ""
"Enter XML tag name and attributes (\"<\", \">\" and closing tag will be "
"supplied):"
msgstr ""
"បញ្ចូល​ឈ្មោះ​ស្លាក និង​គុណ​លក្ខណៈ XML (\"<\", \">\" និង​ស្លាក​បិទ "
"នឹង​ត្រូវ​បាន​ផ្គត់ផ្គង់) ៖"

#: pseudo_dtd.cpp:48
#, kde-format
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed "
"XML."
msgstr ""
"មិន​អាច​ញែក​ឯកសារ '%1' បាន​ទេ ។ សូម​ពិនិត្យមើល​ថា​ឯកសារ​គឺ XML "
"ដែល​មាន​ទម្រង់​ត្រឹមត្រូវ ។"

#: pseudo_dtd.cpp:56
#, kde-format
msgid ""
"The file '%1' is not in the expected format. Please check that the file is "
"of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation "
"for more information."
msgstr ""
"ឯកសារ '%1' មិន​ស្ថិត​ក្នុង​ទ្រង់ទ្រាយ​ដែល​បាន​រំពឹង ។ "
"សូម​ពិនិត្យមើល​ថា​ឯកសារ​ស្ថិត​ក្នុង​ចំណោម​ប្រភេទ​នេះ ៖\n-//Norman Walsh//DTD "
"DTDParse V2.0//EN\nអ្នក​អាច​បង្កើត​ឯកសារ​បែបនេះ​ដោយ​ប្រើ dtdparse ។ "
"សូម​មើល​កម្រង​ឯកសារ​កម្មវិធី​ជំនួយ Kate សម្រាប់​ព័ត៌មាន​បន្ថែម ។"

#: pseudo_dtd.cpp:71
msgid "Analyzing meta DTD..."
msgstr "កំពុង​វិភាគ DTD មេតា..."

#: pseudo_dtd.cpp:71
msgid "Cancel"
msgstr "បោះបង់"

#. i18n: file: ui.rc:4
#. i18n: ectx: Menu (xml)
#: rc.cpp:3
msgid "&XML"
msgstr "XML"
