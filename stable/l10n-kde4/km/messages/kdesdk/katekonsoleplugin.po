#: kateconsole.cpp:59
msgid "You do not have enough karma to access a shell or terminal emulation"
msgstr "អ្នក​មិនមាន karma គ្រាប់គ្រាន់​ដើម្បី​ចូលដំណើរការ​សែល ឬ​ការ​ត្រាប់តាម​ស្ថានីយ"

#: kateconsole.cpp:81 kateconsole.cpp:106
msgid "Terminal"
msgstr "ស្ថានីយ"

#: kateconsole.cpp:87
msgid "Terminal Settings"
msgstr "ការ​កំណត់​ស្ថានីយ"

#: kateconsole.cpp:134
msgid "&Pipe to Terminal"
msgstr "បង្ហូរ​ទៅ​ស្ថានីយ"

#: kateconsole.cpp:138
msgid "S&yncronize Terminal with Current Document"
msgstr "ធ្វើសមកាលកម្ម​ស្ថានីយ​ជាមួយ​ឯកសារ​បច្ចុប្បន្ន"

#: kateconsole.cpp:143
msgid "&Focus Terminal"
msgstr "ផ្ដោតអារម្មណ៍​ស្ថានីយ"

#: kateconsole.cpp:228
msgid ""
"Do you really want to pipe the text to the console? This will execute any "
"contained commands with your user rights."
msgstr ""
"តើ​អ្នក​ពិត​ជា​ចង់​បង្ហូរ​អត្ថបទ​ទៅ​កុងសូល​ឬ ? វា​​នឹង​ប្រតិបត្តិ​ពាក្យ​បញ្ជា​ណា​ដែល​មាន​សិទ្ធិ​អ្នកប្រើ​របស់​អ្នក ។"

#: kateconsole.cpp:229
msgid "Pipe to Terminal?"
msgstr "បង្ហូរ​ទៅ​ស្ថានីយ ?"

#: kateconsole.cpp:230
msgid "Pipe to Terminal"
msgstr "បង្ហូរ​ទៅស្ថានីយ"

#: kateconsole.cpp:251
#, kde-format
msgid "Sorry, can not cd into '%1'"
msgstr "សូម​អភ័យទោស អ្នក​មិន​អាច​ស៊ីឌី​ទៅក្នុង '%1'"

#: kateconsole.cpp:267 kateconsole.cpp:283
msgid "Defocus Terminal"
msgstr "មិនផ្ដោតអារម្មណ៍​ស្ថានីយ"

#: kateconsole.cpp:276
msgid "Focus Terminal"
msgstr "ផ្ដោតអារម្មណ៍​ស្ថានីយ"

#: kateconsole.cpp:302
msgid ""
"&Automatically syncronize the terminal with the current document when "
"possible"
msgstr "ធ្វើ​សមកាលកម្ម​ស្ថានីយ​ជា​មួយ​នឹង​ឯកសារ​បច្ចុប្បន្ន​នៅ​ពេល​ដែល​អាច"

#. i18n: file: ui.rc:4
#. i18n: ectx: Menu (tools)
#: rc.cpp:3
msgid "&Tools"
msgstr "ឧបករណ៍"
