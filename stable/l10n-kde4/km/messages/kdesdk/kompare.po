#: libdiff2/komparemodellist.cpp:252 libdiff2/komparemodellist.cpp:277
#, kde-format
msgid ""
"<qt>No models or no differences, this file: <b>%1</b>, is not a valid diff "
"file.</qt>"
msgstr ""
"<qt>គ្មាន​ម៉ូដែល​ ឬ​ភាព​ខុសគ្នា​ឡើយ​ ឯកសារ​នេះ​ ៖ <b>%1</b> គ្មាន​ឯកសារ​ខុស​គ្នា​​​ឡើយ​ ។​</qt>"

#: libdiff2/komparemodellist.cpp:261
#, kde-format
msgid ""
"<qt>There were problems applying the diff <b>%1</b> to the file <b>%2</b>.</"
"qt>"
msgstr "<qt>មាន​បញ្ហា​ក្នុង​ការ​អនុវត្ត diff​ <b>%1</b> ទៅ​កាន់​ឯកសារ​ <b>%2</b> ។</qt>"

#: libdiff2/komparemodellist.cpp:288
#, kde-format
msgid ""
"<qt>There were problems applying the diff <b>%1</b> to the folder <b>%2</b>."
"</qt>"
msgstr "<qt>មាន​បញ្ហា​ក្នុង​ការ​អនុវត្ត ​diff​ <b>%1</b> ទៅ​កាន់​ថត​ <b>%2</b> ។</qt>"

#: libdiff2/komparemodellist.cpp:320 libdiff2/komparemodellist.cpp:632
msgid "Could not open a temporary file."
msgstr "មិន​អាច​បើក​ឯកសារ​បណ្ដោះ​អាសន្ន​បាន​ទេ​ ។"

#: libdiff2/komparemodellist.cpp:368 libdiff2/komparemodellist.cpp:375
#, kde-format
msgid "<qt>Could not write to the temporary file <b>%1</b>, deleting it.</qt>"
msgstr "<qt>មិន​អាច​សរសេរ​​ទៅកាន់​ឯកសារ​បណ្ដោះ​អាសន្ន​បាន​ទេ​ <b>%1</b> លុប​វា​ ។</qt>"

#: libdiff2/komparemodellist.cpp:403
#, kde-format
msgid ""
"<qt>Could not create destination directory <b>%1</b>.\n"
"The file has not been saved.</qt>"
msgstr ""
"<qt>មិន​អាច​បង្កើត​​ថត​ទិសដៅ​ <b>%1</b> ។\n"
"មិន​អាច​រក្សាទុក​ឯកសារ​​​បាន​ឡើយ ។</qt>"

#: libdiff2/komparemodellist.cpp:420
#, kde-format
msgid ""
"<qt>Could not upload the temporary file to the destination location <b>%1</"
"b>. The temporary file is still available under: <b>%2</b>. You can manually "
"copy it to the right place.</qt>"
msgstr ""
"<qt>មិន​អាច​ធ្វើ​បច្ចុប្បន្នភាព​ឯកសារ​ថត​បណ្ដោះ​អាសន្ន​​ទៅ​ទីតាំង​ទិស​ដៅ​បាន​ទេ​ <b>%1</b> ។ ឯកសារ​បណ្ដោះ​"
"អាសន្ន​​នៅ​តែ​មាន​នៅ​ខាង​ក្រោម​ ៖ <b>%2</b> ។ ​អ្នក​អាច​ចម្លង​​វា​ដោយ​ដៃ​ទៅកាន់​ទីតាំង​ត្រឹមត្រូវ​ ។</qt>"

#: libdiff2/komparemodellist.cpp:485 libdiff2/komparemodellist.cpp:598
msgid "Could not parse diff output."
msgstr "មិន​អាច​ញែក​ទិន្នផល ​diff​ បាន​ឡើយ ។"

#: libdiff2/komparemodellist.cpp:501
msgid "The files are identical."
msgstr "ឯកសារ​ដូច​គ្នា​ ។"

#: libdiff2/komparemodellist.cpp:664
msgid "Could not write to the temporary file."
msgstr "មិន​អាច​សរសេរ​ទៅកាន់​ឯកសារ​បណ្ដោះ​អាសន្ន​បាន​ទេ​ ។"

#: libdiff2/komparemodellist.cpp:932
msgid ""
"The diff is malformed. Some lines could not be parsed and will not be "
"displayed in the diff view."
msgstr ""
"diff គឺ​មិន​ត្រឹមត្រូវ ។ បន្ទាត់​មួយ​ចំនួន​មិន​អាច​ត្រូវ​បាន​ញែក និង​មិន​ត្រូវ​បាន​បង្ហាញ​នៅ​ក្នុង​ទិដ្ឋភាព​ diff "
"ឡើយ ។"

