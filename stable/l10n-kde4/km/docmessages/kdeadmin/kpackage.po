#: index.docbook:89
#, no-c-format
msgid "<phrase>Left Panel - Package Tree</phrase>"
msgstr "<phrase>បន្ទះ​ខាង​ឆ្វេង - មែក​ធាង​កញ្ចប់</phrase>"

