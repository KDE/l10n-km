#, no-c-format
msgid "<guilabel>Package</guilabel> - The name of the package"
msgstr "<guilabel>កញ្ចប់</guilabel> - ឈ្មោះ​នៃ​កញ្ចប់"

#. Tag: para
#: index.docbook:409
#, no-c-format
msgid "<guilabel>File Name</guilabel> - The name of the matched file"
msgstr "<guilabel>ឈ្មោះ​កញ្ចប់</guilabel> - ឈ្មោះ​នៃ​កញ្ចប់​ដែល​ផ្គូផ្គង"

#. Tag: para
#: index.docbook:412
#, fuzzy, no-c-format
msgid ""
"Only the files in installed packages are shown unless <guilabel>Also search "
"uninstalled packages</guilabel> is set, this will only work if the "
"<command>apt-file</command> command is installed. The database used by the "
"<command>apt-file</command> command is updated by the <guimenuitem>Apt-File "
"Update</guimenuitem> menu item."
msgstr ""
"មាន​តែ​ឯកសារ​ក្នុង​កញ្ចប់​ដែល​បាន​ដំឡើង​ត្រូវ​បាន​បង្ហាញ​ទាល់តែ <guilabel>ស្វែងរក​កញ្ចប់​ដែល​មិន​បាន​យក​ចេញ​"
"ផង​ដែរ</guilabel> ត្រូវ​បាន​កំណត់ នេះ​នឹង​ធ្វើ​ការ​តែ​ជាមួយ​កញ្ចប់ APT ដេបៀន បើ​ពាក្យ​បញ្ជា "
"<command>apt-file</command> បាន​ដំឡើង ។ មូលដ្ឋាន​ទិន្នន័យ​ដែល​ប្រើ​ដោយ​ពាក្យ​បញ្ជា "
"<command>apt-file</command> ​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ទាន់​សម័យ​ដោយ​ធាតុ​ម៉ឺនុយ <guimenuitem>ភាព​ទាន់​"
"សម័យ Apt</guimenuitem> ។"

