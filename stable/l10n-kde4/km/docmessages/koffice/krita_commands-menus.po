"set the brightness and contrast ratio of your image here."
msgstr ""
"<action>បើក​<link linkend=\"commands-dialogs-filters-brightnesscontrast"
"\"><guilabel>ប្រអប់​</guilabel> ពន្លឺ /កម្រិត​ពណ៌</link>។</action> អ្នកអាច​កំណត់​ពន្លឺ និង​"
"សមាមាត្រ​កម្រិត​ពណ៌​នៃ​រូបភាព​របស់​អ្នកនៅ​ទី​នេះ ។"

#. Tag: menuchoice
#: commands-menus.docbook:1512
#, no-c-format
msgid ""
"<guimenu>Filter</guimenu> <guisubmenu>Adjust</guisubmenu> "
"<guimenuitem>Desaturate</guimenuitem>"
