#. Tag: title
#: commands.docbook:7
#, no-c-format
msgid "The Menu Entries"
msgstr "ធាតុ​ម៉ឺនុយ​"

#. Tag: title
#: commands.docbook:10
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ឯកសារ</guimenu>"

#. Tag: menuchoice
#: commands.docbook:15
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New Project</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>N</keycap> </"
"keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>គម្រោងថ្មី</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:25
#, no-c-format
msgid ""
"<action>Creates a new project.</action> You have to choose the project type "
"(Audio CD, Data DVD, ...)."
msgstr ""
"<action>បង្កើត​គម្រោង​ថ្មី​មួយ​</action>​ អ្នក​ត្រូវ​តែ​ជ្រើស​ប្រភេទ​គម្រោង (ស៊ីឌីអូឌីយ៉ូ ឌីវីឌី​ទិន្នន័យ...) ។​"

#. Tag: menuchoice
#: commands.docbook:33
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>O</keycap> </"
"keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>បើក​...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:43
#, no-c-format
msgid ""
"<action>Opens an existing project</action> which can be selected with KDE's "
"Open File dialog."
msgstr ""
"<action>បើក​គម្រោង​ដែល​មាន​ស្រាប់</action> ដែល​អាច​ត្រូវ​បានជ្រើស​ដោយ​ប្រអប់​បើក​ឯកសារ​របស់ KDE ។"

#. Tag: menuchoice
#: commands.docbook:51
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>R</keycap> </"
"keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>បើក​ឯកសារ​ដែល​ប្រើ​ថ្មីៗ​"
"</guimenuitem>"

#. Tag: para
#: commands.docbook:61
#, no-c-format
msgid ""
"This is a shortcut to <action>re-open recently opened projects</action>. The "
"sub-menu belonging to this item contains a list of these projects, clicking "
"on a specific file will open it again."
msgstr ""
"នេះ​ជា​ផ្លូវកាត់​ដើម្បី<action>បើក​គម្រោង​ដែល​បាន​បើក​ថ្មី​​ឡើង​វិញ</action> ។ម៉ឺនុយ​រង​របស់​ធាតុ​នេះ​មាន​"
"បញ្ជី​គម្រោង​ទាំង​នេះ ចុច​លើ​ឯកសារ​ជាក់លាក់​នឹង​បើក​វា​ម្ដង​ទៀត ។"

#. Tag: menuchoice
#: commands.docbook:71
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>S</keycap> </"
"keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>រក្សាទុក​</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:81
#, no-c-format
msgid ""
"<action>Saves the current project.</action> If there has already been a save "
"of the document then this will overwrite the previously saved file without "
"asking for the user's consent. If it is the first save of a new document the "
"Save As dialog will be invoked."
msgstr ""
"<action>រក្សាទុក​គម្រោង​បច្ចុប្បន្ន ។</action> ប្រសិន​បើ​មាន​ឯកសារ​ដែល​បាន​រក្សាទុក​រួ​ចហើយ បន្ទាប់​មក​"
"វា​នឹង​សរសេរ​ជាន់​លើ​ឯកសារ​ដែល​បាន​រក្សាទុក​ពី​មុន​ដោយ​មិន​សួរ​បញ្ជាក់​ឡើយ ។ ប្រសិន​បើ​វា​ជា​ការ​រក្សាទុក​ដំបូង​នៃ​"
"ឯកសារ​ថ្មី ប្រអប់​រក្សាទុក​ជា​នឹង​ត្រូវ​បានហៅ ។"

#. Tag: menuchoice
#: commands.docbook:92
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>រក្សាទុកជា...</guimenuitem>"

#. Tag: para
#: commands.docbook:98
#, no-c-format
msgid ""
"<action>Saves the current project with a new file name.</action> KDE's Save "
"As dialog appears to specify name and directory of the new project file."
msgstr ""
"<action>រក្សាទុក​គម្រោង​បច្ចុប្បន្ន​ដោយ​ដាក់​ឈ្មោះ​ឯកសារ​ថ្មី ។</action> ប្រអប់​រក្សាទុក​ជា​របស់ KDE នឹង​"
"បង្ហាញ​ដើម្បី​បញ្ជាក់​ឈ្មោះ និង​ថត​របស់​ឯកសារ​គម្រោង​ថ្មី ។"

#. Tag: menuchoice
#: commands.docbook:107
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr "<guimenu>ឯកសារ​</guimenu> <guimenuitem>រក្សាទុក​ទាំង​អស់</guimenuitem>"

#. Tag: para
#: commands.docbook:113
#, no-c-format
msgid ""
"<action>Saves all open projects.</action> This is the same as selecting "
"<menuchoice> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem> </"
"menuchoice> for each of them."
msgstr ""
"<action>រក្សាទុក​គម្រោង​ដែល​បើក​ទាំងអស់ ។</action> នេះ​គឺ​ដូច​គ្នា​នឹង​ការ​ជ្រើស<menuchoice> "
"<guimenu>ឯកសារ</guimenu> <guimenuitem>រក្សាទុក</guimenuitem> </menuchoice> "
"សម្រាប់​ពួក​វា​នីមួយ ។"

#. Tag: menuchoice
#: commands.docbook:125
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>C</keycap> </"
"keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>បិទ​</guimenuitem>"

#. Tag: para
#: commands.docbook:135
#, no-c-format
msgid ""
"<action>Closes the current project.</action> If a project has been modified "
"but not yet saved then &k3b; will ask what to do. You can choose to save or "
"discard the changes, and you also have the opportunity to cancel closing and "
"keep the project open."
msgstr ""
"<action>បិត​គម្រោង​បច្ចុប្បន្ន ។</action> ប្រសិន​បើ​គម្រោង​មួយ​ត្រូវ​បានកែប្រែ ប៉ុន្តែ​មិន​ទាន់​ត្រូវ​បាន​"
"រក្សាទុក​នៅ​ឡើយ​​ទេ ​នោះ K3b នឹង​សួរ​ថា​ត្រូវ​ធ្វើអ្វី ។ អ្នក​អាច​ជ្រើស​ត្រូវ​រក្សាទុក ឬ​បោះបង់​ការ​ផ្លាស់ប្ដូរ "
"ហើយ​អ្នក​ក៏​មាន​ឳកាសផង​ដែរ​ដើម្បី​បោះបង់​ការ​បិទ ហើយ​​ទុក​ឲ្យ​គម្រោង​នៅ​តែ​បើក ។"

#. Tag: menuchoice
#: commands.docbook:147
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr "<guimenu>ឯកសារ</guimenu> <guimenuitem>បិទ​ទាំងអស់</guimenuitem>"

#. Tag: para
#: commands.docbook:153
#, no-c-format
msgid ""
"<action>Closes all open projects.</action> For each unsaved project &k3b; "
"will ask what to do, just like it does when <menuchoice> <guimenu>File</"
"guimenu> <guimenuitem>Close</guimenuitem> </menuchoice> is selected."
msgstr ""
"<action>បិទ​គម្រោង​ដែល​បើក​​ទាំងអស់ ។</action> សម្រាប់​គម្រោង​ដែល​មិន​បាន​រក្សាទុក​នីមួយៗ K3b នឹង​សួរ​អ្វី​"
"ត្រូវ​ធ្វើ ដូច​​ដែល​វា​ធ្លាប់​ធ្វើ នៅ​ពេលជ្រើស​<menuchoice> <guimenu>ឯកសារ</guimenu> "
"<guimenuitem>បិទ</guimenuitem> </menuchoice> ។"

#. Tag: menuchoice
#: commands.docbook:165
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap> </keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>Q</keycap> </"
"keycombo> </shortcut> <guimenu>ឯកសារ​</guimenu> <guimenuitem>បោះបង់​</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:175
#, no-c-format
msgid ""
"<action>Quits &k3b;</action> after closing all of its open projects. For "
"every unsaved project &k3b; will ask what to do, just like it does when "
"<menuchoice> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem> </"
"menuchoice> is selected."
msgstr ""
"<action>បោះបង់ K3b</action> បន្ទាប់​ពី​បិទ​គម្រោង​របស់​វា​ដែល​បើក​ទាំងអស់ ។ សម្រាប់​គម្រោង​ដែល​មិនបាន​"
"រក្សាទុក​នីមួយៗ K3b នឹង​សួរ​អ្វី​ត្រូវ​ធ្វើ គឺ​ដូច​អ្វី​ដែល​វា​ធ្វើ​នៅ​ពេលជ្រើស<menuchoice> "
"<guimenu>ឯកសារ</guimenu> <guimenuitem>បិទ</guimenuitem> </menuchoice> ។"

#. Tag: title
#: commands.docbook:192
#, no-c-format
msgid "The <guimenu>Project</guimenu> Menu"
msgstr "ម៉ឺនុយ<guimenu>គម្រោង</guimenu>"

#. Tag: menuchoice
#: commands.docbook:197
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Add Files...</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>បន្ថែម​ឯកសារ​...</guimenuitem>"

#. Tag: para
#: commands.docbook:203
#, no-c-format
msgid ""
"When this item is selected, the appearing dialog <action>lets you choose one "
"or more files to be added to the project.</action> This has the same effect "
"as dragging files directly from the Contents View into the Project View. If "
"the current project is a data disc project, the added files will appear in "
"the disc's root directory."
msgstr ""
"នៅ​ពេល​ជម្រើស​ធាតុ​នេះ ប្រអប់​លេច​ឡើង​​<action>អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​​ឯកសារ​មួយ ឬ​ច្រើន​ត្រូវ​បន្ថែម​ទៅ​"
"គម្រោង ។</action> នេះ​មាន​ប្រសិទ្ធិភាព​ដូចគ្នា​នឹង​ការ​អូស​ឯកសារ​ដោយ​ផ្ទាល់​ពី​ទិដ្ឋភាព​មាតិកា​ទៅ​ក្នុង​"
"ទិន្ននភាព​គម្រោង ។ ប្រសិន​បើ​គម្រោង​បច្ចុប្បន្ន​គឺ​ជា​គម្រោង​ទិន្នន័យ​ថាស ឯកសារ​ដែល​បាន​បន្ថែម​នឹង​បង្ហាញ​នៅ​"
"ក្នុង​ថត root របស់​ថាស ។"

#. Tag: menuchoice
#: commands.docbook:215
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Clear Project</guimenuitem>"
msgstr "<guimenu>គម្រោង</guimenu> <guimenuitem>ជម្រះ​គម្រោង</guimenuitem>"

#. Tag: para
#: commands.docbook:221
#, no-c-format
msgid ""
"<action>Removes all files and directories from the current project.</action> "
"The project itself remains open."
msgstr ""
"<action>យក​ឯកសារ​ និង​ថត​ទាំងអស់​ចេញ​ពី​គម្រោង​បច្ចុប្បន្ន ។</action> គម្រោង​ខ្លួន​វាផ្ទាល់​នៅ​តែ​បើក ។"

#. Tag: menuchoice
#: commands.docbook:230
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap> </keycombo> </"
"shortcut> <guimenu>Project</guimenu> <guimenuitem>Burn...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>B</keycap> </"
"keycombo> </shortcut> <guimenu>គម្រោង​</guimenu> <guimenuitem>ដុត​...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:240
#, no-c-format
msgid ""
"<action>Opens the Burn dialog for the current project.</action> This is in "
"fact the same as the Properties dialog - the only difference is that there "
"is an additional Burn button which causes &k3b; to burn a disc from project "
"data. The Burn dialog won't open if the project does not contain any files."
msgstr ""
"<action>បើក​ប្រអប់​ដុត​សម្រាប់​គម្រោង​បច្ចុប្បន្ន ។</action> ជា​ការ​ពិត​វា​ដូចគ្នា​នឹង​ប្រអប់​លក្ខណៈ​សម្បត្តិ "
"- ខុស​គ្នា​តែ​ថា​មាន​ប៊ូតុង​ដុត​បន្ថែម ដែល​បណ្ដាល​ឲ្យ K3b ដុត​ថាស​ពី​ទិន្នន័យ​គម្រោង ។ ប្រអប់​ដុត​នឹង​មិន​បើក​ ប្រសិន​"
"បើ​គម្រោង​មិន​មាន​ឯកសារ​ ។"

#. Tag: menuchoice
#: commands.docbook:251
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap> </keycombo> </"
"shortcut> <guimenu>Project</guimenu> <guimenuitem>Properties...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>P</keycap> </"
"keycombo> </shortcut> <guimenu>គម្រោង​</guimenu> <guimenuitem>លក្ខណៈសម្បត្តិ​...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:261
#, no-c-format
msgid ""
"<action>Opens the Properties dialog for the current project. </action> Here "
"you can specify a lot of options concerning the project. Every project type "
"has got a different set of options, most of them can be explained by using "
"What's This (accessible by right-mouse-clicking)."
msgstr ""
"<action>បើក​ប្រអប់​លក្ខណៈ​សម្បត្តិ​សម្រាប់​គម្រោង​បច្ចុប្បន្ន ។ </action> នៅ​ទីនេះ អ្នក​អាច​បញ្ជាក់​"
"ជម្រើស​ជា​ច្រើន​ទាក់ទង​នឹង​គម្រោង ។ ប្រភេទ​គម្រោង​​នីមួយៗ​​បានទទួល​សំណុំ​គម្រោង​ផ្សេងៗ​គ្នា ពួក​វា​ភាគ​ច្រើន​អាច​"
"ត្រូវ​បាន​ពន្យល់​ដោយ​ប្រើ នេះជា​អ្វី (អាច​ចូលដំណើរការ​ដោយ​ចុច​កណ្ដុរ​ស្ដាំ) ។"

#. Tag: menuchoice
#: commands.docbook:272
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Import Session</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>នាំចូល​សម័យ</guimenuitem>"

#. Tag: para
#: commands.docbook:278
#, no-c-format
msgid ""
"This Item only appears if a Data CD/DVD or Video DVD project is active. It "
"causes K3b to <action>import the file entries from the previous session to "
"the current project</action>. You can use this when compiling files for "
"multi-session discs. Hence that data from the previous session is always "
"included, even if you don't choose to make use of this command. It just "
"helps to know what's on the disc already."
msgstr ""
"ធាតុ​នេះ​បង្ហាញ​តែ​ក្នុង​ករណី​ដែល​គម្រោង​ស៊ីឌី/ឌីវីឌី​ទិន្នន័យ ឬ​ឌីវីឌី​វីដេអូ​សកម្ម​​ប៉ុណ្ណោះ ។ វា​បណ្ដាល​ឲ្យ​ K3b "
"<action>នាំចូល​ធាតុ​ឯកសារ​ពី​សម័យ​មុន​ទៅ​​​ក្នុង​សម័យ​បច្ចុប្បន្ន</action> ។ អ្នក​អាច​ប្រើ​វា​នៅ​ពេល​ចង​ក្រង​"
"ឯកសារ​សម្រាប់​ថាស​ដែល​មាន​ច្រើន​សម័យ ។ ហេតុ​ដូច្នេះ​ទិន្នន័យ​នោះ​បាន​មក​ពី​សម័យ​មុន​តែងតែ​ត្រូវ​បាន​រួម​បញ្ចូល​ជា​"
"និច្ច ទោះ​បីជា​អ្នក​មិន​ជ្រើស​ដើម្បី​បង្កើត​កា​រប្រើ​ពាក្យ​បញ្ជា​នេះ​ក៏​ដោយ ។ វា​គ្រាន់​តែ​ជួយ​ឲ្យដឹង​អ្វី​នៅ​លើ​ថាស​រួច​"
"ហើយ ។"

#. Tag: menuchoice
#: commands.docbook:291
#, no-c-format
msgid ""
"<guimenu>Project</guimenu> <guimenuitem>Clear Imported Session</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>ជម្រះ​សម័យ​ដែល​បាន​នាំចូល</guimenuitem>"

#. Tag: para
#: commands.docbook:297
#, no-c-format
msgid ""
"This Item only appears if a Data CD/DVD or Video DVD project is active. It "
"causes K3b to <action>remove the file entries from the current project that "
"were imported</action> by <menuchoice> <guimenu>Project</guimenu> "
"<guimenuitem>Import Session</guimenuitem> </menuchoice> while keeping all of "
"the other data in the project. Hence that making use of this command doesn't "
"actually remove anything from the disc that will be burned, it just hides "
"these files again."
msgstr ""
"ធាតុ​នេះ​បង្ហាញ​តែក្នុង​ករណី​ដែល​​គម្រោង​ស៊ីឌី​/ឌីវីឌី​ទិន្នន័យ ឬឌីវីឌី​វីដេអូ​សកម្ម​ប៉ុណ្ណោះ ។ វា​បណ្ដាល​ឲ្យ K3b "
"<action>យក​ធាតុ​ឯកសារ​ចេញ​ពី​គម្រោង​បច្ចុប្បន្ន​ដែល​ត្រូវ​បាន​នាំចូល</action> ដោយ <menuchoice> "
"<guimenu>គម្រោង</guimenu> <guimenuitem>នាំចូល​សម័យ</guimenuitem> </menuchoice> "
"ខណៈពេល​រក្សាទុក​ទិន្នន័យ​ផ្សេងៗ​ទាំងអស់​នៅ​ក្នុង​គម្រោង ។ ហេតុ​ដូច្នេះ ការ​ធ្វើ​ឲ្យ​ប្រើ​ពាក្យ​បញ្ជា​នេះពិត​ជា​មិន​"
"យក​អ្វី​ចេញ​ពី​ថាស​ដែល​នឹង​ត្រូវ​បាន​ដុត​ទេ វា​គ្រាន់​តែ​លាក់​ឯកសារ​ម្ដង​ទៀត ។"

#. Tag: menuchoice
#: commands.docbook:313
#, no-c-format
msgid "<guimenu>Project</guimenu> <guimenuitem>Edit Boot Images</guimenuitem>"
msgstr "<guimenu>គម្រោង​</guimenu> <guimenuitem>កែសម្រួល​រូបភាព​ចាប់​ផ្តើម</guimenuitem>"

#. Tag: para
#: commands.docbook:319
#, no-c-format
msgid ""
"This Item only appears if a Data CD/DVD or Video DVD project is active. "
"<action>Here you can specify boot images</action> in order to create "
"bootable CDs or DVDs. A boot image can be a direct copy of a floppy or hard "
"disk (for example, created by the dd shell command) as well as another "
"disc's boot image. In any case it's a single file containing a complete, "
"bootable system that is burned as a normal file. In order to let the "
"computer know that the disc contains a boot image, the burning application "
"creates a boot catalog file whose name can be determined in the dialog "
"window."
msgstr ""
"ធាតុ​នេះ​លេច​ឡើង​តែ​ក្នុងករណី​ដែល​​គម្រោង​ស៊ីឌី​/ឌីវីឌី​ទិន្នន័យ ឬ​ឌីវីឌី​វីដេអូ​សកម្ម​ប៉ុណ្ណោះ ។<action>នៅ​ទីនេះ អ្នក​"
"អាច​បញ្ជាក់​រូបភាព​ចាប់ផ្ដើម</action> ដើម្បី​បង្កើត​ស៊ីឌី​ ឬ​ឌីវីឌី​ដែល​អាច​ចាប់ផ្ដើម​បាន ។ រូបភាព​ចាប់ផ្ដើម​"
"អាច​ត្រូវ​បាន​ចម្លង​ដោយ​ផ្ទាល់​ពី​ថាសទន់ ឬ​ថាស​រឹង (ឧទាហរណ៍ បាន​បង្កើត​ដោយ​ពាក្យ​បញ្ជា​សែល dd) ព្រមទាំង​"
"រូបភាព​ចាប់ផ្ដើម​របស់​ថាស​ផ្សេង​ទៀត ។ ក្នុង​ករណី​មួយ​ចំនួន វា​ជា​ឯកសារ​តែ​មួយ​ដែល​មាន​ប្រព័ន្ធ​ឯកសារ​ដែល​អាច​"
"ចាប់ផ្ដើម​បាន​ពេញលេញ ដែល​ត្រូវ​បាន​ដុត​ជា​ឯកសារ​ធម្មតា ។ ដើម្បី​អនុញ្ញាត​ឲ្យ​កុំព្យូទ័រ​ដឹង​ថា ថាស​មានរូបភាព​"
"ចាប់ផ្ដើម កម្មវិធីដុត​បង្កើត​ឯកសារ​កាតាឡុក​ចាប់ផ្ដើម​ ដែល​ឈ្មោះ​របស់វា​អាច​ត្រូវ​បាន​កំណត់​នៅ​ក្នុង​បង្អួច​"
"ប្រអប់ ។"

#. Tag: title
#: commands.docbook:367
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ឧបករណ៍</guimenu>"

#. Tag: menuchoice
#: commands.docbook:372
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Copy CD...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guimenuitem>ចម្លង​ស៊ីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:378
#, no-c-format
msgid ""
"<action>Opens the CD Copy dialog.</action> Without the need of a project "
"file, it provides the ability to copy a CD's content to another disc. "
"Alternatively, you can choose only to create an image of the source CD which "
"can be burned anytime. There is also an option to clone the CD instead of "
"normal copying, which should be preferred when copying CDs with defective "
"sectors or Video CDs."
msgstr ""
"<action>បើក​ប្រអប់​ចម្លង​ស៊ីឌី ។</action> ដោយមិន​ត្រូវ​ការ​​ឯកសារ​គម្រោង វា​ផ្ដល់នូវ​សមត្ថភាព​ចម្លង​"
"មាតិកា​របស់​ស៊ីឌី​ទៅ​ថាស​ផ្សេង​ទៀត ។ ជា​ជម្រើស អ្នក​អាច​ជ្រើស​ដើម្បី​បង្កើត​តែ​រូបភាព​របស់​ស៊ីឌី​ប្រភព ដែល​អាច​"
"ត្រូវ​បាន​ដុត​នៅ​ពេល​ណា​មួយ ។ ក៏​មានជម្រើស​មួយ​ផ្សេង​ទៀត​ដែរ​ដើម្បី​ក្លូន​ស៊ីឌី​ជំនួស​ឲ្យ​កា​រចម្លង​ធម្មតា ដែល​គួរ​ត្រូវ​"
"បាន​ពេញចិត្ត​ នៅ​ពេល​ចម្លង​ស៊ីឌី​ដែល​មាន​ផ្នែក​មិន​ពេញលេញ ឬ​ស៊ីឌី​វីដេអូ ។"

#. Tag: menuchoice
#: commands.docbook:392
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Copy DVD...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guimenuitem>ចម្លង​ឌីវីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:398
#, no-c-format
msgid ""
"<action>Opens the DVD Copy dialog.</action> Without the need of a project "
"file, it provides the ability to copy a DVD's content to another disc. "
"Alternatively, you can choose only to create an image of the source DVD "
"which can be burned anytime. Video transcoding within the DVD Copy dialog is "
"not yet supported, so the destination disc has to be large enough to contain "
"all of the source disc's (video) data in its original form."
msgstr ""
"<action>បើក​ប្រអប់ចម្លង​ឌីវីឌី ។</action> ដោយ​មិន​ត្រូវ​ការ​ឯកសារ​គម្រោង វា​ផ្ដល់​នូវ​សមត្ថភាព​ចម្លង​"
"មាតិកា​របស់​ឌីវីឌី​ទៅ​ថាស​ផ្សេង​ទៀត ។ ជា​ជម្រើស អ្នក​អាច​ជ្រើស​ដើម្បី​បង្កើត​តែ​រូបភាព​របស់​ឌីវីឌី​ប្រភព ដែល​អាច​"
"ត្រូវ​បាន​ដុត​នៅ​ពេល​ណា​មួយ ។ ការ​បម្លែង​វីដេអូ​នៅ​ក្នុង​ប្រអប់​ចម្លង​ឌីវីឌី​មិន​ទាន់​គាំទ្រ​នៅ​ឡើយ​ទេ ដូច្នេះ​ថាស​ទិសដៅ​"
"ត្រូវ​តែ​ធំ​ល្មម​ដើម្បី​ដាក់​ទិន្នន័យ (វីដេអូ) របស់​ថាស​ប្រភព​នៅ​ក្នុង​ទម្រង់​ដើម​របស់​វា ។"

#. Tag: menuchoice
#: commands.docbook:413
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Erase CD-RW...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guimenuitem>លុប​ស៊ីឌី​អាន-សរសេរ...</guimenuitem>"

#. Tag: para
#: commands.docbook:419
#, no-c-format
msgid ""
"<action>Opens the Erase CD-RW dialog.</action> With its help you can clear "
"the contents of a CD-RW, or part of it."
msgstr ""
"<action>បើក​ប្រអប់​លុប​ស៊ីឌី​អាន-សរសេរ ។</action> ជា​មួយ​នឹង​ជំនួយ​របស់​វា អ្នក​អាច​ជម្រះ​មាតិកា​របស់ស៊ីឌី​"
"អាន-សរសេរ ឬ​ផ្នែក​របស់​វា ។"

#. Tag: menuchoice
#: commands.docbook:428
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Format DVD±RW...</guimenuitem>"
msgstr ""
"<guimenu>ឧបករណ៍</guimenu> <guimenuitem>ធ្វើ​ទ្រង់ទ្រាយ​ឌីវីឌី±អាន/សរសេរ...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:434
#, no-c-format
msgid ""
"<action>Opens the DVD Formatting dialog.</action> With its help you can "
"format a DVD-R(W) or DVD+R(W), which causes the disc's contents to be "
"deleted. &k3b; gives the choice between the \"Overwrite\" and \"Incremental"
"\" writing modes."
msgstr ""
"<action>បើក​ប្រអប់​ធ្វើទ្រង់ទ្រាយ​ឌីវីឌី ។</action> ជា​មួយ​នឹង​ជំនួយ​របស់​វា អ្នក​អាច​ធ្វើ​ទ្រង់ទ្រាយ​ឌីវីឌី-"
"អាន(សរសេរ) ឬ​ឌីវីឌី+អាន(សរសេរ) ដែល​បណ្ដាល​ឲ្យ​មាតិកា​របស់ថា​ត្រូវ​បាន​លុប ។ K3b ផ្ដល់​នូវ​ជម្រើស​រវាង​"
"របៀប​សរសេរ​ \"ជាន់លើ\" និង​\"បង្កើន\" ។"

#. Tag: menuchoice
#: commands.docbook:445
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Burn CD Image...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guimenuitem>ដុត​រូបភាព​ស៊ីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:451
#, no-c-format
msgid ""
"<action>Burns a previously created CD image.</action> The Burn CD Image "
"dialog asks to select an <literal role=\"extension\">*.iso</literal>, "
"<literal role=\"extension\">*.cue</literal> or <literal role=\"extension\">*."
"toc</literal> file as data source that you can instantly burn by pressing "
"the Start button. (Nero <literal role=\"extension\">*.nrg</literal> files "
"are currently not supported, so you have to make use of other tools like "
"<ulink url=\"http://gregory.kokanosky.free.fr/v4/linux/nrg2iso.en.html\"> "
"<application>Nrg2Iso</application></ulink>.)"
msgstr ""
"<action>ដុត​រូបភាព​ស៊ីឌី​ដែល​បាន​បង្កើត​ពី​មុន ។</action> ប្រអប់​ដុត​រូបភាព​ស៊ីឌី​ស្នើ​ឲ្យ​ជ្រើសឯកសារ "
"<literal role=\"extension\">*.iso</literal> <literal role=\"extension\">*."
"cue</literal> ឬ <literal role=\"extension\">*.toc</literal> ជា​ប្រភព​ទិន្នន័យ​ដែលអ្នក​"
"អាច​ដុត​ភ្លាមៗ​ដោយ​ចុច​ប៊ូតុង​ចាប់ផ្ដើម ។ (ឯកសារ Nero <literal role=\"extension\">*.nrg</"
"literal> បច្ចុប្បន្ន​មិន​ត្រូវ​បានគាំទ្រ​នៅ​ឡើយ​ទេ ដូច្នេះ​អ្នក​ត្រូវ​តែ​បង្កើត​ការ​ប្រើ​​ឧបករណ៍​ផ្សេង​ទៀត ដូច​"
"ជា<ulink url=\"http://gregory.kokanosky.free.fr/v4/linux/nrg2iso.en.html\"> "
"<application>Nrg2Iso</application></ulink> ។)"

#. Tag: menuchoice
#: commands.docbook:469
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Burn DVD ISO Image...</guimenuitem>"
msgstr ""
"<guimenu>ឧបករណ៍</guimenu> <guimenuitem>ដុត​រូបភាព​អាយអេសអូ​ឌីវីឌី...</guimenuitem>"

#. Tag: para
#: commands.docbook:475
#, no-c-format
msgid ""
"<action>Burns a previously created DVD image.</action> The Burn Iso9660 "
"Image dialog asks to select an <literal role=\"extension\">*.iso</literal> "
"file as data source that you can instantly burn by pressing the Start button."
msgstr ""
"<action>ដុត​រូបភាព​ឌីវីឌី​ដែល​បាន​បង្កើត​ពីមុន ។</action> ប្រអប់​ដុត​រូបភាព Iso9660 ស្នើ​ឲ្យ​ជ្រើស​"
"ឯកសារ<literal role=\"extension\">*.iso</literal> ជា​ប្រភព​ទិន្នន័យ​ដែល​អ្នក​អាច​ដុត​បាន​"
"ភ្លាមៗ ដោយ​ចុច​ប៊ូតុង ចាប់ផ្ដើម ។"

#. Tag: menuchoice
#: commands.docbook:486
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Encode Video...</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍​</guimenu> <guimenuitem>អ៊ិនកូដ​វីដេអូ...</guimenuitem>"

#. Tag: para
#: commands.docbook:492
#, no-c-format
msgid ""
"<action>A DVD video that has already been ripped can be encoded</action> "
"with a little help from the Encoding Video dialog. This dialog box normally "
"opens after ripping the DVD from within the Contents View, but can also be "
"used standalone. It contains information about the ripped DVD video, "
"encoding options and even video resizing and cropping abilities."
msgstr ""
"<action>វីដេអូ​ឌីវីឌី​ដែល​ត្រូវ​បាន​បម្លែង​រួច​ហើយ​អាច​ត្រូវ​បានអ៊ិនកូដ</action> ជា​មួយ​នឹង​ជំនួយ​បន្តិចបន្តួច​ពី​"
"ប្រអប់​អ៊ិនកូដ​វីដេអូ ។ ប្រអប់​នេះ​តាមធម្មតា​បើក​បន្ទាប់ពី​បម្លែង​ឌីវីឌី​ពី​ក្នុង​ទិន្នភាព​មាតិកា ប៉ុន្តែ​អាច​ត្រូវ​បាន​"
"ប្រើ​​ម្នាក់​ឯង ។ វា​មាន​ព័ត៌មាន​អំពី​វីដេអូ​ឌីវីឌី​ដែល​បាន​បម្លែង ជម្រើស​អ៊ិនកូដ និង​ការ​ផ្លាស់ប្ដូរ​ទំហំ​វីដេអូ និង​​"
"សមត្ថភាព​ច្រឹប ។"

#. Tag: menuchoice
#: commands.docbook:504
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Diskinfo</guimenuitem>"
msgstr "<guimenu>ឧបករណ៍</guimenu> <guimenuitem>ព័ត៌មាន​ថាស</guimenuitem>"

#. Tag: para
#: commands.docbook:510
#, no-c-format
msgid ""
"<action>Shows information about the inserted disk.</action> This information "
"will be displayed in the Contents View and covers disk properties like type, "
"size and track length of the CD or DVD in your drive."
msgstr ""
"<action>បង្ហាញ​ព័ត៌មាន​អំពី​ថាស​ដែល​បាន​បញ្ចូល ។</action> ព័ត៌មាន​នេះ​នឹង​ត្រូវ​បាន​បង្ហាញ​នៅ​ក្នុង​ទិដ្ឋភាព​"
"មាតិកា​ និង​គម្រប​លក្ខណៈ​សម្បត្តិ ដូចជា ប្រភេទ ទំហំ ប្រវែង​បទ​របស់​ស៊ីឌី ឬ​ឌីវីឌី​នៅ​ក្នុង​ដ្រាយ​របស់​អ្នក ។"

#. Tag: title
#: commands.docbook:524
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "ម៉ឺនុយ​<guimenu>ការកំណត់​</guimenu>"

#. Tag: menuchoice
#: commands.docbook:529
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Toolbars</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> <guimenuitem>របារឧបករណ៍​</guimenuitem>"

#. Tag: para
#: commands.docbook:535
#, no-c-format
msgid ""
"<action>Pops up a list of &k3b;'s toolbars.</action> If a toolbar entry is "
"checked, it means that the toolbar is currently visible."
msgstr ""
"<action>បញ្ជី​លេចឡើង​នៃ​របារឧបករណ៍​របស់ K3b ។</action> ប្រសិន​បើ​ធាតុ​របារ​ឧបករណ៍​ត្រូវ​បាន​គូសធីក "
"វា​មាន​ន័យ​ថា​របារឧបករណ៍​បច្ចុប្បន្ន​អាច​មើល​ឃើញ ។"

#. Tag: menuchoice
#: commands.docbook:544
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""
"<guimenu>ការ​កំណត់</guimenu> <guimenuitem>បង្ហាញ/លាក់​របារ​ស្ថានភាព</guimenuitem>"

#. Tag: para
#: commands.docbook:550
#, no-c-format
msgid ""
"This enables you to <action>show or hide the small bar at the bottom of the "
"main window</action> containing various information about &k3b;'s status and "
"activities."
msgstr ""
"វា​អនុញ្ញាត​ឲ្យ​អ្នក​<action>បង្ហាញ ឬ​លាក់​របារ​តូច​នៅ​បាត​របស់បង្អួច​មេ</action> ដែល​មាន​ព័ត៌មាន​ផ្សេងៗ​"
"អំពី​ស្ថានភាព និង​សកម្មភាព​របស់ K3b​ ។"

#. Tag: menuchoice
#: commands.docbook:559
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Directories</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> <guimenuitem>បង្ហាញ​ថត​</guimenuitem>"

#. Tag: para
#: commands.docbook:565
#, no-c-format
msgid ""
"<action>Toggles the visibility of the Directory View.</action> This view "
"enables you to select directories and disc drives. When selected, their "
"contents will appear in the Contents View. Disc drives have also got a "
"context menu providing functions like Disk Info, (un)mounting the drive or "
"ejecting the medium."
msgstr ""
"<action>បិទ​បើក​ភាព​​មើលឃើញ​របស់​ទិដ្ឋភាព​ថត ។</action> ទិដ្ឋភាព​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​ថត និង​"
"ដ្រាយ​ថាស ។ នៅ​ពេល​បាន​ជ្រើស មាតិការបស់ពួកវា​នឹង​បង្ហាញ​នៅ​ក្នុង​ទិដ្ឋភាព​មាតិកា ។ ដ្រាយ​ថាស​ក៏​បាន​ទទួល​"
"ម៉ឺនុយ​បរិបទ​ដោយ​ផ្ដល់​នូវ​មុខងារ​ដូច​ជា ព័ត៌មាន​ថាស ការ​ម៉ោន/អាន់ម៉ោន​ដ្រាយ ឬ​ការ​ច្រាន​ឧបករណ៍​ផ្ទុក​ចេញ ។"

#. Tag: menuchoice
#: commands.docbook:576
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Contents</guimenuitem>"
msgstr "<guimenu>ការកំណត់​</guimenu> <guimenuitem>បង្ហាញ​មាតិកា​</guimenuitem>"

#. Tag: para
#: commands.docbook:582
#, no-c-format
msgid ""
"<action>Toggles the visibility of the Contents View.</action> This view "
"enables you to select files that can be dragged into the Project View in "
"order to add them to the project. The Contents View also acts as an "
"interface to rip audio CDs and video discs when a disc drive containing an "
"appropriate CD/DVD is selected in the Directory View."
msgstr ""
"<action>បិទបើក​ភាព​មើល​ឃើញ​របស់​ទិដ្ឋភាព​មាតិកា ។</action> ទិដ្ឋភាព​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​ឯកសារ​"
"ដែលអាច​ត្រូវ​បាន​អូស​ទៅ​ក្នុង​ទិដ្ឋភាព​គម្រោង ដើម្បី​បន្ថែម​ពួកវា​ទៅ​ក្នុង​គម្រោង ។ ទិដ្ឋភាព​មាតិកា​ក៏​ធ្វើ​ជា​ចំណុច​"
"ប្រទាក់​ដើម្បី​បម្លែង​ស៊ីឌី​អូឌីយ៉ូ និងថាស​វីដេអូ នៅ​ពេល​ដ្រាយ​ថាស​មាន​ស៊ីឌី/ឌីវីឌី​សមរម្យ​ត្រូវ​បាន​ជ្រើស​នៅ​ក្នុង​ទិដ្ឋភាព​"
"ថត ។"

#. Tag: menuchoice
#: commands.docbook:594
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show Document Header</guimenuitem>"
msgstr "<guimenu>ការ​កំណត់</guimenu> <guimenuitem>បង្ហាញ​បឋមកថា​ឯកសារ​</guimenuitem>"

#. Tag: para
#: commands.docbook:600
#, no-c-format
msgid ""
"<action>Toggles the visibility of the document header</action> belonging to "
"the Project View. This is a small bar that is only visible if the Project "
"View contains any open projects. The document header has no functionality, "
"yet it's nice eye candy and improves clarity by separating the Project View "
"from the other views."
msgstr ""
"<action>បិទ​បើក​ភាព​មើលឃើញ​របស់បឋមកថា​ឯកសារ</action> ជា​របស់​ទិដ្ឋភាព​គម្រោង ។ នេះ​គឺ​ជា​របារ​តូច​"
"ដេលអាច​មើល​ឃើញ​តែ​ក្នុង​ករណី​ដែល​ទិដ្ឋភាព​គម្រោង​មាន​គម្រោង​ដែល​បើក​ណាមួយ ។ បឋមកថា​ឯកសារ​គ្មាន​មុខងារ "
"សូម្បី​វា​ជា​រូបតំណង​ភ្នែក និង​បង្កើនពន្លឺ​ដោយ​បំបែក​ទិដ្ឋភាព​គម្រោង​ពី​ទិដ្ឋភាព​ផ្សេង​ទៀត ។"

#. Tag: menuchoice
#: commands.docbook:612
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu><guimenuitem>កំណត់​រចនាសម្ព័ន្ធ​ផ្លូវ​កាត់​...</guimenuitem>"

#. Tag: para
#: commands.docbook:618
#, no-c-format
msgid ""
"This command <action>opens a dialog box where the key bindings for &k3b;'s "
"menu commands may be changed</action>. After selecting one of the available "
"commands from the upper part of the dialog, the shortcut for this action can "
"be changed in the lower part."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ<action>បើក​ប្រអប់ដែល​ជា​កន្លែង​ចង​គ្រាប់ចុច​សម្រាប់ពាក្យ​បញ្ជា​ម៉ឺនុយ​របស់ K3b ​អាច​ត្រូវ​បាន​"
"ផ្លាស់ប្ដូរ</action> ។ បន្ទាប់​ពី​ជ្រើស​ពាក្យ​បញ្ជា​មួយ​ក្នុង​ចំណោម​ពាក្យ​បញ្ជា​ដែល​មាន​ពី​ផ្នែក​ខាង​លើ​របស់​"
"ប្រអប់ ផ្លូវកាត់​សម្រាប់​សកម្មភាព​នេះ​អាច​ត្រូវ​បាន​ផ្លាស់ប្ដូរ​នៅ​ក្នុង​ផ្នែក​ទាប ។"

#. Tag: menuchoice
#: commands.docbook:629
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> <guimenuitem>កំណត់​រចនាសម្ព័ន្ធ​របារ​ឧបករណ៍...</guimenuitem>"

#. Tag: para
#: commands.docbook:635
#, no-c-format
msgid ""
"This command <action>opens a dialog box where the toolbars can be "
"customized</action>. The drop down box on top of the dialog determines which "
"toolbar can be edited at the moment. The Available Actions list on the left "
"contains all commands that can be added to the toolbar, the Current Actions "
"list on the right shows the ones that are already there. Items can be added "
"by selecting the appropriate command out of the Available Actions list and "
"pressing the right button to move it to the Current Actions list. Removing "
"an item works the other way round. The up and down buttons change the "
"commands's position within the toolbar."
msgstr ""
"ពាក្យ​បញ្ជា​នេះ<action>បើក​ប្រអប់​ដែល​របារ​ឧបករណ៍​អាច​ត្រូវ​បាន​ប្ដូរ​តាម​បំណង</action> ។ ប្រអប់​"
"ទម្លាក់ចុះ​នៅ​កំពូល​របស់​ប្រអប់​កំណត់​ថា​តើ​របារ​ឧបករណ៍​ណា​មួយ​អាច​ត្រូ​វបាន​កែសម្រួល​នៅ​ពេលនេះ ។ បញ្ជី​សកម្មភាព​"
"ដែល​មាន​នៅ​ខាង​ឆ្វេង​មាន​ពាក្យ​បញ្ជា​ទាំងអស់​ ដែល​អាច​ត្រូវ​បាន​បន្ថែម​ទៅ​កាន់​របារ​ឧបករណ៍ បញ្ជី​សកម្មភាព​"
"បច្ចុប្បន្ន​នៅ​ខាង​ស្ដាំ​បង្ហាញ​សកម្មភាព​មួយ​ក្នុង​ចំណោម​សកម្មភាព​ដែល​មាន​រួច​ហើយ​នៅ​ទីនោះ ។ ធាតុ​អាច​ត្រូវ​បាន​"
"បន្ថែម​ដោយ​ជ្រើស​ពាក្យ​បញ្ជា​ដែល​សមរម្យ​​ចេញ​ពី​បញ្ជី​សកម្មភាព​ដែល​មាន ហើយចុច​ប៊ូតុង​កណ្ដុរ​ស្ដាំ​ដើម្បី​ផ្លាស់ទី​វា​ទៅ​"
"កាន់​បញ្ជី​សកម្មភាព​បច្ចុប្បន្ន ។ ការ​យក​ធាតុ​ចេញ​ដំណើរការ​តាមវិធី​ផ្សេង​ទៀត ។ ប៊ូតុង​ឡើង​លើ និង​ចុះក្រោម​"
"ផ្លាស់ប្ដូរ​ទីតាំង​របស់​ពាក្យ​បញ្ជា​នៅ​ក្នុង​របារ​ឧបករណ៍ ។"

#. Tag: menuchoice
#: commands.docbook:653
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>&k3b; Setup</guimenuitem>"
msgstr "<guimenu>ការ​កំណត់</guimenu> <guimenuitem>ការ​រៀបចំ K3b</guimenuitem>"

#. Tag: para
#: commands.docbook:659
#, no-c-format
msgid ""
"This <action>opens &k3bsetup;</action> which helps setting the right "
"permissions needed by &k3b; in order to burn CDs and DVDs. Linux' user "
"rights management permits program execution and access to disc drives if no "
"permissions have been granted by the administrator. &k3bsetup; cannot set "
"permissions without administrator privileges, so you have to enter the root "
"password when starting up."
msgstr ""
"វា<action>បើក​ការ​រៀបចំ K3b</action> ដែលជួយ​កំណត់​សិទ្ធិ​ត្រឹមត្រូវ​ដែល​ត្រូវ​ការ​ដោយ K3b ដើម្បី​ដុត​ស៊ីឌី "
"និង​ឌីវីឌី ។ ការ​គ្រប់គ្រង​សិទ្ធិ​អ្នក​ប្រើរបស់​លីនុច​អនុញ្ញាត​ឲ្យ​កម្មវិធី​ប្រតិបត្តិ​ និង​ចូល​ដំណើរការ​ដ្រាយ​ថាស ប្រសិន​បើ​"
"គ្មាន​សិទ្ធិ​ត្រូវ​បាន​ផ្ដល់​ឲ្យ​ដោយ​អ្នក​គ្រប់គ្រង ។ ការ​រៀបចំ K3b មិន​អាច​កំណត់​សិទ្ធិ​ដោយ​គ្មាន​សិទ្ធិ​ជា​អ្នកគ្រប់គ្រង​"
"ទេ ដូច្នេះ​អ្នក​ត្រូវ​តែ​បញ្ចូល​ពាក្យ​សម្ងាត់របស់ root នៅ​ពេល​ចាប់ផ្ដើម ។"

#. Tag: menuchoice
#: commands.docbook:672
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &k3b;...</guimenuitem>"
msgstr ""
"<guimenu>ការកំណត់​</guimenu> <guimenuitem>កំណត់​រចនាសម្ព័ន្ធ K3b...</guimenuitem>"

#. Tag: para
#: commands.docbook:678
#, no-c-format
msgid ""
"<action>Opens the Options dialog</action> where general program settings can "
"be configured. Although most of &k3b;'s functionality should work out of the "
"box, this dialog allows to customize and fine-tune the program."
msgstr ""
"<action>បើក​ប្រអប់​ជម្រើស</action> ដែល​​ការ​កំណត់​កម្មវិធី​ទូទៅ​អាច​ត្រូវ​បាន​កំណត់​រចនសម្ព័ន្ធ ។ ទោះ​បីជា​"
"មាន​មុខងាររបស់ K3b ជា​ច្រើន​គួរ​ដំណើរការ​ខាង​ក្រៅ​ប្រអប់ ប្រអប់​នេះ​អនុញ្ញាត​ឲ្យ​ប្ដូរ​កម្មវិធី​តាមបំណង និង​"
"ត្រឡប់​មក​វិញ ។"

