#~ "The panel consists of a large list of specific events which need to be "
#~ "communicated to the user. This list is organized into groups by "
#~ "applications."
#~ msgstr ""
#~ "បន្ទះ​នេះ​មាន​បញ្ជី​ព្រឹត្តិការណ៍​ជាក់លាក់​ធំ​មួយ ដែល​ត្រូវ​ឲ្យ​ភ្ជាប់​ទំនាក់​ទំនង​ទៅកាន់​អ្នក​ប្រើ ។ បញ្ជី​នេះ​ត្រូវ​"
#~ "បាន​រៀបចំ​ជា​ក្រុមទៅ​តាម​កម្មវិធី ។"

#~ msgid "<guiicon>Execute a program</guiicon>"
#~ msgstr "<guiicon>ប្រតិបត្តិ​កម្មវិធី​មួយ</guiicon>"

#~ msgid "Print to standard error output"
#~ msgstr "បោះពុម្ព​ទៅកាន់​លទ្ធផល​កំហុស​ស្តង់ដារ"

#~ msgid ""
#~ "If an icon is present in this column, &kde; will send a message to the "
#~ "computers standard output."
#~ msgstr ""
#~ "ប្រសិន​បើ​មាន​រូប​តំណាង​​​នៅ​ក្នុង​ជួរ​ឈរ​នេះ នោះ KDE នឹង​ផ្ញើ​សារ​ទៅ​កាន់​លទ្ធផល​ស្តង់ដារ​របស់​កុំព្យូទ័រ ។"

#~ msgid "Display a message box"
#~ msgstr "បង្ហាញ​ប្រអប់​សារ​​មួយ"

#~ msgid "Flash the taskbar entry"
#~ msgstr "បញ្ចាំង​ធាតុ​បញ្ចូល​របស់​របារ​ភារកិច្ច"

#~ msgid "<guilabel>Execute a program</guilabel>"
#~ msgstr "<guilabel>ប្រតិបត្តិ​កម្មវិធី​មួយ</guilabel>"

#~ msgid "Print a message to standard error output"
#~ msgstr "បោះពុម្ព​សារ​ទៅកាន់​ stderr"

#~ msgid "Mark taskbar entry"
#~ msgstr "សម្គាល់​ធាតុ​របស់​របារ​ភារកិច្ច"

#~ msgid "Change all notifications in all &kde; applications"
#~ msgstr "ផ្លាស់​ប្ដូរ​ការ​ជូន​ដំណឹង​ទាំង​អស់​នៅ​ក្នុង​កម្មវិធី​របស់ KDE"

#~ msgid ""
#~ "You can alter more than one notification at a time by using the section "
#~ "of the dialog labeled <guilabel>Quick Controls</guilabel>."
#~ msgstr ""
#~ "អ្នក​អាច​ផ្លាស់ប្ដូរ​ការ​ជូន​ដំណឹង​ច្រើន​ជាង​មួយ​ក្នុង​ពេល​តែ​មួយ ​ដោយ​ប្រើ​ផ្នែក​នៃ​ប្រអប់​ដែល​មាន​ស្លាក "
#~ "<guilabel>ការ​ត្រួត​​ពិនិត្យ​រហ័ស</guilabel> ។"

#~ msgid ""
#~ "The first item in this section is a checkbox labeled <guilabel>Apply to "
#~ "all applications</guilabel>. If there is a mark in this checkbox, any "
#~ "changes made in the <guilabel>Quick Controls</guilabel> area are applied "
#~ "to all applications (not just the selected application). If there is no "
#~ "mark in this checkbox, any changes are limited to the application "
#~ "selected at the top of the dialog."
#~ msgstr ""
#~ "ធាតុ​ទីមួយ​ក្នុង​ផ្នែក​នេះ​ គឺ​ជា​ប្រអប់​ធីក​ដែល​មាន​ស្លាក <guilabel>អនុវត្ត​ទៅ​គ្រប់​កម្មវិធី</"
#~ "guilabel> ។ ប្រសិន​បើ​មាន​ធីក​​ក្នុង​ប្រអប់​ធីក​នេះ ការ​ផ្លាស់ប្ដូរ​ដែល​ធ្វើ​ក្នុង​ផ្ទៃ <guilabel>ការ​"
#~ "ត្រួត​ពិនិត្យ​រហ័ស</guilabel> នឹង​ត្រូវ​បាន​អនុវត្ត​ទៅ​គ្រប់​កម្មវិធី​ទាំងអស់ (មិន​មែន​ត្រឹម​តែ​កម្មវិធី​ដែល​បាន​"
#~ "ជ្រើស​ទេ) ។ ប្រសិន​បើ​មិន​មាន​ធីក​នៅ​ក្នុង​ប្រអប់​ធីក​នេះ​ទេ ការ​ផ្លាស់ប្ដូរ​​នឹង​ត្រូវ​បាន​កំណត់​ចំពោះ​កម្មវិធី​ដែល​"
#~ "បាន​ជ្រើស​នៅ​ខាងលើ​ប្រអប់ ។"

#~ msgid ""
#~ "The next line consists of a button and a drop down box. This is used to "
#~ "enable every notification of a single type. Simply select the "
#~ "notification type from the drop down box (on the right) and click the "
#~ "button labeled <guibutton>Turn On All</guibutton>. This will enable all "
#~ "notifications of that type."
#~ msgstr ""
#~ "បន្ទាត់​បន្ទាប់​មាន​ប៊ូតុង និង​ប្រអប់​ទម្លាក់​ចុះ ។ វា​ត្រូវ​បាន​ប្រើ​ដើម្បី​បើក​ការ​ជូន​ដំណឹង​នៃ​ប្រភេទ​មួយ ។ ​"
#~ "ជ្រើស​ប្រភេទ​ការ​ជូន​ដំណឹង​ពី​ប្រអប់​ទម្លាក់​ចុះ (នៅ​ខាង​ស្ដាំ) ហើយ​​ចុច​ប៊ូតុង​ដែល​មាន​ស្លាក <guibutton>បើក​"
#~ "ទាំងអស់</guibutton> ។ វា​នឹង​បើក​ការ​ជូន​ដំណឹង​នៃ​ប្រភេទ​នោះ ។"

#~ msgid ""
#~ "The bottom line operates the same, but when you select the button labeled "
#~ "<guibutton>Turn Off All</guibutton>, all the notifications of the "
#~ "selected type will be disabled."
#~ msgstr ""
#~ "បន្ទាត់​ខាងក្រោម​គឺ​ប្រិតបត្តិ​ដូច​គ្នា ប៉ុន្តែ​ពេលអ្នក​ជ្រើស​ប៊ូតុង​ដែល​មាន​ស្លាក <guibutton>បិទ​ទាំងអស់</"
#~ "guibutton> ការ​ជូន​ដំណឹង​ទាំងអស់​នៃ​ប្រភេទ​ដែល​បាន​ជ្រើស​នឹង​ត្រូវ​បាន​បិទ ។"

#~ msgid "Change sound player options"
#~ msgstr "ផ្លាស់ប្ដូរ​ជម្រើស​ឧបករណ៍​ចាក់​សំឡេង"

#~ msgid ""
#~ "If you click the button labeled <guibutton>Player settings</guibutton>, a "
#~ "small dialog box will appear with three radio buttons:"
#~ msgstr ""
#~ "ប្រសិន​បើ​អ្នក​ចុច​ប៊ូតុង​ដែល​មាន​ស្លាក <guibutton>ការ​កំណត់​ឧបករណ៍​ចាក់</guibutton>ប្រអប់​តូច​មួយ​នឹង​"
#~ "លេចឡើង​ជាមួយ​ប៊ូតុង​មូល​បី ៖"

#~ msgid ""
#~ "When you have made your selection, click <guibutton>Apply</guibutton> to "
#~ "save changes but keep the dialog box open. Click <guibutton>OK</"
#~ "guibutton> to save changes and close dialog box. Click <guibutton>Cancel</"
#~ "guibutton> to close the dialog box without making any changes."
#~ msgstr ""
#~ "នៅពេល​ដែល​អ្នក​បាន​ធ្វើការ​ជ្រើសរើស​របស់​អ្នក ចុច​ <guibutton>អនុវត្ត</guibutton> ដើម្បី​រក្សា​"
#~ "ទុក​ការ​ផ្លាស់ប្ដូរ ប៉ុន្តែ​ទុក​ឲ្យ​ប្រអប់​នៅ​បើក​ដដែល ។ ចុច <guibutton>យល់​ព្រម</guibutton> ដើម្បី​"
#~ "រក្សា​ទុក​ការផ្លាស់​ប្ដូរ ហើយ​បិទ​ប្រអប់ ។ ចុច <guibutton>បោះ​បង់</guibutton> ដើម្បី​បិទ​ប្រអប់​ដោយ​"
#~ "មិន​ធ្វើការ​ផ្លាស់ប្ដូរ​អ្វី​ទាំងអស់ ។"
