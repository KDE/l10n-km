msgstr ""

#. Tag: title
#: index.docbook:438
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:443
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Select...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:448
#, no-c-format
msgid ""
"<action>Lets you select files according to their filename</action>. For "
"example, you could use <literal role=\"extension\">*.txt</literal> to select "
"all text files. Note that you can't use more than one filter at a time."
msgstr ""

#. Tag: menuchoice
#: index.docbook:456
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:463
#, no-c-format
msgid "Selects all the files in the archive"
msgstr ""

#. Tag: menuchoice
#: index.docbook:468
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Deselect All</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:473
#, no-c-format
msgid "Unselects all the files in the archive"
msgstr ""

#. Tag: menuchoice
#: index.docbook:478
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Invert Selection</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:483
#, no-c-format
msgid ""
"Reverses which files are selected. Selected files become unselected, and "
"unselected files are selected."
msgstr ""

#. Tag: menuchoice
#: index.docbook:489
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>View Shell Output</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:494
#, no-c-format
msgid ""
"Displays the <guilabel>Shell Output</guilabel> box, which <action>shows you "
"the output of the most recent command(s)</action> run by &ark;. This is "
"sometimes useful if you are having problems and want to troubleshoot."
msgstr ""

#. Tag: title
#: index.docbook:506
#, no-c-format
msgid "The <guimenu>Action</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:511
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>Add File...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:516
#, no-c-format
msgid ""
"Shows the <guilabel>Select Files to Add</guilabel> dialog box, where you can "
"select files. Hold down &Ctrl; and click to select multiple files. To go up "
"a folder, <mousebutton>right</mousebutton> click the folder box, and you can "
"choose <guimenuitem>Up</guimenuitem> (this will probably be improved soon). "
"The <guilabel>Advanced</guilabel> tab has options which are specific to the "
"type or archive you are working with."
msgstr ""

#. Tag: menuchoice
#: index.docbook:527
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>Add Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:532
#, no-c-format
msgid ""
"Shows the <guilabel>Add Folder...</guilabel> dialog box, where you can "
"choose a <action>folder to add</action>. Just choose a folder and choose "
"<guibutton>Open</guibutton>."
msgstr ""

#. Tag: menuchoice
#: index.docbook:539
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>Delete</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:544
#, no-c-format
msgid "Removes the currently selected files from the archive."
msgstr ""

#. Tag: menuchoice
#: index.docbook:550
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>Extract</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:555
#, no-c-format
msgid ""
"Shows the <guilabel>Extract</guilabel> dialog box, which allows you to "
"<action>select where you will extract files</action> to. You can also select "
"which files to extract:"
msgstr ""

#. Tag: para
#: index.docbook:561
#, no-c-format
msgid ""
"<guilabel>Current</guilabel> extracts the most recently selected file. If "
"multiple files are selected, only the most recently selected one will be "
"extracted."
msgstr ""

#. Tag: para
#: index.docbook:566
#, no-c-format
msgid "<guilabel>All</guilabel> extracts the entire contents of the archive."
msgstr ""

#. Tag: para
#: index.docbook:570
#, no-c-format
msgid ""
"<guilabel>Selected Files</guilabel> extracts all the files which have been "
"selected."
msgstr ""

#. Tag: para
#: index.docbook:574
#, no-c-format
msgid ""
"<guilabel>Pattern</guilabel> allows you to specify which files will be "
"extracted, corresponding to certain patterns, &eg; <literal role=\"extension"
"\">*.txt</literal> or <literal role=\"extension\">*.jpg</literal> Note that "
"you can only use one pattern at a time."
msgstr ""

#. Tag: menuchoice
#: index.docbook:591
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>View</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:596
#, no-c-format
msgid "Opens the currently selected file in the associated viewer program."
msgstr ""

#. Tag: menuchoice
#: index.docbook:602
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>Open With...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:607
#, no-c-format
msgid ""
"<action>Opens the currently selected file in a program you choose.</action> "
"The <guilabel>Open With...</guilabel> dialog box lets you choose which "
"program to use."
msgstr ""

#. Tag: menuchoice
#: index.docbook:614
#, no-c-format
msgid "<guimenu>Action</guimenu> <guimenuitem>Edit With...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:619
#, no-c-format
msgid ""
"<action>Opens the currently selected file in a program you choose.</action> "
"Any changes you make in the editor program will be reflected in the archive, "
"as it will be updated."
msgstr ""

#. Tag: title
#: index.docbook:630
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:635
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Toolbar</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:640
#, no-c-format
msgid "Toggles whether the toolbar is displayed."
msgstr ""

#. Tag: menuchoice
#: index.docbook:645
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:650
#, no-c-format
msgid "Toggles whether the status bar is displayed."
msgstr ""

#. Tag: menuchoice
#: index.docbook:656
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Search Bar</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:661
#, no-c-format
msgid "Toggles whether the search bar is displayed."
msgstr ""

#. Tag: menuchoice
#: index.docbook:667
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:672
#, no-c-format
msgid ""
"Displays the <guilabel>Configure Shortcuts</guilabel> dialog box. This "
"<action>lets you choose shortcut keys for various menu items.</action> To "
"change a shortcut, select an action from the list, and then choose which "
"keystroke to use. Clicking on the bottom right hand <interface>Key</"
"interface> button lets you choose which specific key to use. Just press the "
"new key."
msgstr ""

#. Tag: menuchoice
#: index.docbook:682
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:687
#, no-c-format
msgid ""
"Displays a &kde; standard dialog where you can configure the toolbar icons."
msgstr ""

#. Tag: menuchoice
#: index.docbook:693
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Ark...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:698
#, no-c-format
msgid ""
"This opens the &ark; configuration dialog. The dialog contains four modules "
"(General, Addition, Extraction and Folders). Configuring &ark; is covered in "
"the section <link linkend=\"configuration\">Configuration</link>"
msgstr ""

