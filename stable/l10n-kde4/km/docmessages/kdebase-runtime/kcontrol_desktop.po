#, no-c-format
msgid "desktop"
msgstr "ផ្ទៃតុ"

#. Tag: title
#: index.docbook:29
#, no-c-format
msgid "Desktop"
msgstr "ផ្ទៃតុ"

#. Tag: guilabel
#: index.docbook:32
#, no-c-format
msgid "Appearance Tab"
msgstr "ផ្ទាំង​​រូបរាង"

#. Tag: para
#: index.docbook:34
#, no-c-format
msgid "Here you can configure how icons on your desktop appear."
msgstr "នៅទីនេះ អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​របៀប​ដែល​រូបតំណាង​លេចឡើង​នៅលើ​ផ្ទៃតុ​របស់អ្នក ។"

#. Tag: guilabel
#: index.docbook:38
#, no-c-format
msgid "Standard font:"
msgstr "ពុម្ពអក្សរ​ខ្នាត​គំរូ ៖"

#. Tag: para
#: index.docbook:39
#, no-c-format
msgid ""
"This option can be used to change the typeface used on the desktop. Simply "
"select your typeface from the dropdown box."
msgstr ""
"ជម្រើស​នេះ​អាចត្រូវបាន​ប្រើ​ដើម្បី​ផ្លាស់ប្ដូរ​លក្ខណៈអក្សរ​ដែលបាន​ប្រើ​នៅលើ​ផ្ទៃតុ ។ ជ្រើស​លក្ខណៈ​អក្សរ​"
"របស់អ្នក​ពី​ប្រអប់​ទម្លាក់ចុះ ។"

#. Tag: guilabel
#: index.docbook:43
#, no-c-format
msgid "Font size:"
msgstr "ទំហំ​ពុម្ពអក្សរ ៖"

#. Tag: para
#: index.docbook:44
#, no-c-format
msgid "You can change the relative size of the text on the Desktop."
msgstr "អ្នក​អាច​ផ្លាស់ប្ដូរ​ទំហំពុម្ពអក្សរ​ដែលទាក់ទង​នៅលើ​ផ្ទៃតុ ។"

#. Tag: guilabel
#: index.docbook:48
#, no-c-format
msgid "Normal text color:"
msgstr "ពណ៌​អត្ថបទ​ធម្មតា ៖"

#. Tag: para
#: index.docbook:49
#, no-c-format
msgid ""
"This option lets you select the color of normal (or unhighlighted) text."
msgstr "ជម្រើស​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​ពណ៌​​អត្ថបទ​ធម្មតា (ឬ​មិន​បន្លិច) ។"

#. Tag: guilabel
#: index.docbook:52
#, no-c-format
msgid "Text background color:"
msgstr "ពណ៌​ផ្ទៃ​ខាងក្រោយ​អត្ថបទ ៖"

#. Tag: para
#: index.docbook:53
#, no-c-format
msgid ""
"This option lets you select the background color of normal text. If left "
"unchecked, the text has a transparent background. If selected, you can "
"choose the color by pressing the button."
msgstr ""
"ជម្រើស​នេះ​អនុញ្ញាត​ឲ្យអ្នក​ជ្រើស​ពណ៌ផ្ទៃខាងក្រោយ​នៃ​អត្ថបទ​ធម្មតា ។ ប្រសិន​បើ​អ្នក​មិន​ធីក​ទេ គឺ​អត្ថបទ​នឹង​"
"បង្ហាញ​ផ្ទៃខាងក្រោយ​ថ្លា ។ ប្រសិន​បើអ្នក​បាន​ជ្រើស អ្នក​អាច​ជ្រើស​ពណ៌​ដោយ​ចុច​ប៊ូតុង ។"

#. Tag: guilabel
#: index.docbook:59
#, no-c-format
msgid "Underline filenames:"
msgstr "គូស​បន្ទាត់​ពីក្រោម​ឈ្មោះ​ឯកសារ ៖"

#. Tag: para
#: index.docbook:60
#, no-c-format
msgid "Determines if file names are underlined on the Desktop."
msgstr "កំណត់​ថាតើ​ឈ្មោះឯកសារ​ត្រូវបាន​គូសបន្ទាត់​​ពីក្រោម​នៅលើ​ផ្ទៃតុ​ឬ​អត់ ។"

#. Tag: guilabel
#: index.docbook:67
#, no-c-format
msgid "Multiple Desktops"
msgstr "ផ្ទៃតុ​ច្រើន"

#. Tag: para
#: index.docbook:69
#, no-c-format
msgid ""
"&kde; offers you the possibility to have several virtual desktops. In this "
"tab you can configure the number of desktops as well as their names. Just "
"use the slider to adjust the number of desktops. You can assign names to the "
"desktops by entering text into the text fields below."
msgstr ""
"KDE ផ្ដល់លទ្ធភាព​ឲ្យអ្នក​មាន​ផ្ទៃតុ​និម្មិត​ច្រើន ។ នៅក្នុង​ផ្ទាំង​នេះ អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​ចំនួន​ផ្ទៃតុ​ព្រម​"
"ទាំង​ឈ្មោះ​របស់​វាផងដែរ ។ ដោយគ្រាន់តែ​ប្រើ​គ្រាប់​រំកិល​ដើម្បី​លៃតម្រូវ​ចំនួន​ផ្ទៃតុ ។ អ្នក​អាច​ផ្ដល់​ឈ្មោះ​ទៅ​ឲ្យ​"
"ផ្ទៃតុ​បាន ដោយ​បញ្ចូល​អត្ថបទ​ទៅក្នុង​វាល​អត្ថបទ​ខាងក្រោម ។"

#. Tag: para
#: index.docbook:75
#, fuzzy, no-c-format
#| msgid ""
#| "If you enable <guilabel>Mouse wheel over desktop switches desktop</"
#| "guilabel> then scrolling the wheel over an empty space on the desktop "
#| "will change the the next virtual desktop numerically, in the direction "
#| "you scrolled (either up or down)."
msgid ""
"If you enable <guilabel>Mouse wheel over desktop switches desktop</guilabel> "
"then scrolling the wheel over an empty space on the desktop will change to "
"the next virtual desktop numerically, in the direction you scrolled (either "
"up or down)."
msgstr ""
"ប្រសិន​បើអ្នក​ធីក <guilabel>កង់កណ្ដុរ​លើផ្ទៃខាងក្រោយផ្ទៃតុ​ ប្ដូរ​ផ្ទៃតុ</guilabel> នៅពេល​នោះ ការ​"
"រមូរកង់កណ្ដុរ​លើ​ផ្ទៃទទេ​នៅលើ​ផ្ទៃតុ នឹង​ផ្លាស់ប្ដូរ​ផ្ទៃតុ​និម្មិត​បន្ទាប់​​តាម​លេខរៀង គឺ​តាម​ទិស​ដែលអ្នក​បាន​រមូរ "
"(ឡើង​លើ ឬ​ចុះក្រោម) ។"
