#. Tag: title
#: desktop.docbook:8
#, no-c-format
msgid "The desktop"
msgstr "ផ្ទៃតុ"

#. Tag: para
#: desktop.docbook:13
#, no-c-format
msgid "How do I add an application to the desktop?"
msgstr "តើ​ខ្ញុំ​បន្ថែម​កម្មវិធី​ទៅ​ផ្ទៃតុ​ដោយ​របៀប​ណា ?"

#. Tag: para
#: desktop.docbook:17
#, no-c-format
msgid ""
"Just choose the desired application from the <guimenu>K</guimenu> menu and "
"drag and drop it to the Desktop."
msgstr ""
"គឺ​គ្រាន់​តែ​ជ្រើស​កម្មវិធី​ដែល​ចង់​ដាក់​នោះ​ពី​ម៉ឺនុយ <guimenu>K</guimenu> ហើយ​អូស និង​ទម្លាក់​វា​ទៅកាន់​ផ្ទៃ​តុ​"
"ជា​ការ​ស្រេច ។"

#. Tag: para
#: desktop.docbook:19
#, fuzzy, no-c-format
#| msgid ""
#| "For applications not listed in the <guimenu>K</guimenu> menu, use the "
#| "&RMB; on the desktop and choose <menuchoice><guimenuitem>Create New</"
#| "guimenuitem><guisubmenu>File</guisubmenu> <guimenuitem>Link to "
#| "Application...</guimenuitem></menuchoice> and fill in the configuration "
#| "for the application you want to link to."
msgid ""
"For applications not listed in the <guimenu>K</guimenu> menu, use the &RMB; "
"on the desktop and choose <menuchoice><guimenuitem>Create New</guimenuitem> "
"<guimenuitem>Link to Application...</guimenuitem></menuchoice> and fill in "
"the configuration for the application you want to link to."
msgstr ""
"ចំពោះ​កម្មវិធី​ដែល​មិន​មាន​នៅ​ក្នុង​ម៉ឺនុយ <guimenu>K</guimenu> គឺ​ត្រូវចុច​ប៊ូតុង​កណ្ដុរ​ខាង​ស្ដាំ​លើ​ផ្ទៃតុ ហើយ​"
"ជ្រើស <menuchoice><guimenuitem>បង្កើត​ថ្មី</guimenuitem><guisubmenu>ឯកសារ</"
"guisubmenu> <guimenuitem>តំណ​ទៅ​កម្មវិធី...</guimenuitem></menuchoice> ហើយ​បំពេញ​ការ​"
"កំណត់​រចនា​សម្ព័ន្ធ​សម្រាប់​កម្មវិធី​ដែល​ចង់​តភ្ជាប់ ។"

#. Tag: para
#: desktop.docbook:29
#, no-c-format
msgid "How do I mount/unmount a device from the desktop?"
msgstr "តើ​ខ្ញុំ​ម៉ោន​/​អាន់ម៉ោន​ឧបករណ៍​ពី​ផ្ទៃតុ​បាន​ដោយ​របៀប​ណា ?"

#. Tag: para
#: desktop.docbook:33
#, no-c-format
msgid ""
"First, make sure you are allowed to <command>mount</command>/"
"<command>umount</command> the relevant device as a user."
msgstr ""
"ដំបូង ត្រូវ​ប្រាកដ​ថា​អ្នក​មាន​សិទ្ធិ​ក្នុង​ការ​ <command>mount</command>/<command>umount</"
"command> ឧបករណ៍​ដែល​ទាក់ទង​ជា​អ្នក​ប្រើ ។"

#. Tag: para
#: desktop.docbook:35
#, fuzzy, no-c-format
#| msgid ""
#| "Then you can add any device via &RMB; on the desktop and then choosing "
#| "<menuchoice><guimenu>Create New</guimenu><guimenuitem>Link to Device</"
#| "guimenuitem></menuchoice> and then selecting the device of the type you "
#| "wish to control from the desktop. Fill in the settings for the device in "
#| "the dialog that appears and click <guilabel>OK</guilabel>. You can use "
#| "the resulting desktop icon to mount/unmount the device from the desktop."
msgid ""
"Then you can add any device by clicking on the desktop with the &RMB; and "
"then choosing <menuchoice><guimenu>Create New</guimenu><guisubmenu>Link to "
"Device</guisubmenu></menuchoice>. Select the device of the type you wish to "
"control. Fill in the settings for the device in the dialog that appears and "
"click <guilabel>OK</guilabel>. You can use the resulting desktop icon to "
"mount/unmount the device from the desktop."
msgstr ""
"បន្ទាប់​មក​អ្នក​អាច​បន្ថែម​ឧបករណ៍​ណា​មួយ​តាម​រយៈ​ប៊ូតុង​កណ្ដុរ​ស្ដាំ​នៅ​លើ​ផ្ទៃតុ ហើយ​ជ្រើស "
"<menuchoice><guimenu>បង្កើត​ថ្មី</guimenu><guimenuitem>ភ្ជាប់​ទៅកាន់​ឧបករណ៍</"
"guimenuitem></menuchoice> និង​បន្ទាប់​មក​ជ្រើស​ឧបករណ៍​នៃ​ប្រភេទ​ដែល​អ្នក​ចង់​បញ្ជា​ពី​ផ្ទៃតុ ។ បំពេញ​"
"ក្នុង​ការ​កំណត់​សម្រាប់​ឧបករណ៍​នៅ​ក្នុង​ប្រអប់​ដែល​លេចឡើង ហើយ​ចុច <guilabel>យល់ព្រម</guilabel> ។ អ្នក​"
"អាច​ប្រើ​រូប​តំណាង​ផ្ទៃតុ​​លទ្ធផល​ដើម្បី​ម៉ោន/អាន់ម៉ោន ឧបករណ៍​ពី​ផ្ទៃតុ ។"

#. Tag: para
#: desktop.docbook:44
#, no-c-format
msgid "Where are the icons kept?"
msgstr "តើ​រូប​តំណាង​រក្សា​ទុក​នៅ​កន្លែង​ណា ?"

#. Tag: para
#: desktop.docbook:47
#, fuzzy, no-c-format
#| msgid ""
#| "The icons can be found only in <filename class=\"directory\">"
#| "$<envar>KDEDIRS</envar>/share/icons</filename> or <filename class="
#| "\"directory\">$<envar>HOME</envar>/.kde/share/icons</filename> or "
#| "<filename class=\"directory\">$<envar>HOME</envar>/.kde2/share/icons</"
#| "filename>. To use icons stored in other locations, you must either copy "
#| "them into one of the above-mentioned fixed &kde; locations or make "
#| "symlinks."
msgid ""
"The icons can be found only in <filename class=\"directory\">"
"$<envar>KDEDIRS</envar>/share/icons</filename> or <filename class=\"directory"
"\">$<envar>HOME</envar>/.kde/share/icons</filename>. To use icons stored in "
"other locations, you must either copy them into one of the above-mentioned "
"fixed &kde; locations or make symlinks."
msgstr ""
"រូប​តំណាង​អាច​ត្រូវ​បាន​រក​ឃើញ​តែ​នៅ​ក្នុង <filename class=\"directory\">$<envar>KDEDIRS</"
"envar>/share/icons</filename> ឬ <filename class=\"directory\">$<envar>HOME</"
"envar>/.kde/share/icons</filename> ឬ <filename class=\"directory\">"
"$<envar>HOME</envar>/.kde2/share/icons</filename> ។ ដើម្បី​ប្រើ​រូប​តំណាង​ដែល​បាន​ទុក​នៅ​"
"ទីតាំង​ផ្សេង អ្នក​ត្រូវ​ចម្លង​ពួក​វា​ដាក់​ក្នុង​ទីតាំង​ KDE ថេរ​ដែល​បាន​បញ្ជាក់​ខាង​លើ ឬ​ធ្វើ​តំណ​វា ។"

#. Tag: para
#: desktop.docbook:57
#, no-c-format
msgid "How do I use the mouse scroll wheel in &kde;?"
msgstr "តើ​ខ្ញុំ​ត្រូវ​ប្រើ​កង់​រមូរ​កណ្ដុរ​ក្នុង KDE ដោយ​របៀប​ណា ?"

#. Tag: para
#: desktop.docbook:60
#, fuzzy, no-c-format
#| msgid ""
#| "Mouse wheel support comes with &Qt; 2.0 and above, so &kde; based on that "
#| "will automatically support the use of the mouse scroll wheel if your "
#| "system is configured correctly. Check your &X-Server; settings support "
#| "the use of a scrollwheel if it is not working."
msgid ""
"Mouse wheel support comes with &Qt; 2.0 and above, so &kde; based on that "
"will automatically support the use of the mouse scroll wheel if your system "
"is configured correctly. Check that your &X-Server; settings support the use "
"of a scrollwheel if it is not working."
msgstr ""
"ការ​គាំទ្រ​កង់​កណ្ដុរ​ដាក់​ភ្ជាប់​មក​ជាមួយ Qt™ ២.០ និង​ខ្ពស់​ជាង​នេះ ដូច្នេះ KDE ដែល​ផ្អែក​លើវា​នឹង​គាំទ្រ​​ការ​"
"ប្រើ​របស់​កង់​រមូរ​កណ្ដុរ​ដោយ​ស្វ័យប្រវត្តិ ប្រសិន​បើ​ប្រព័ន្ធ​របស់​អ្នក​ត្រូវ​បាន​កំណត់​រចនា​សម្ព័ន្ធ​យ៉ាង​ត្រឹមត្រូវ ។ "
"ពិនិត្យ​ការ​កំណត់​ម៉ាស៊ីន​បម្រើ X របស់​អ្នក​គាំទ្រ​ការ​ប្រើ​របស់​កង់​រមូរ បើ​វា​មិន​ធ្វើការ​នោះ ។"

#. Tag: para
#: desktop.docbook:67
#, no-c-format
msgid "How do I launch applications in a particular desktop?"
msgstr "តើ​ខ្ញុំ​ត្រូវ​បើក​ដំណើរ​ការ​កម្មវិធី​ក្នុង​ផ្ទៃតុ​ពិសេស​ដោយ​របៀបណា ?"

#. Tag: para
#: desktop.docbook:70
#, no-c-format
msgid ""
"&kde; comes with a program called &kstart;. To start an <application>xterm</"
"application> on the second desktop and then activate it use: "
"<userinput><command>kstart</command> <option>--desktop 2 --activate --window "
"\"xterm\" </option>xterm</userinput>."
msgstr ""
"KDE បាន​ភ្ជាប់​មក​ជាមួយ​នូវ​កម្មវិធី​មួយ​ដែល​ហៅ​ថា KStart ។ ដើម្បី​ចាប់ផ្ដើម <application>xterm</"
"application> នៅ​លើ​ផ្ទៃតុ​ទីពីរ ហើយ​បន្ទាប់​មក​ធ្វើ​វា​ឲ្យ​សកម្ម​នោះ គឺ​ប្រើ ៖ "
"<userinput><command>kstart</command> <option>--desktop 2 --activate --window "
"\"xterm\" </option>xterm</userinput> ។"

#. Tag: para
#: desktop.docbook:75
#, no-c-format
msgid ""
"Note that the <option>--window</option> option is important. It takes an "
"argument which is a regular expression matching the title of the window to "
"apply the settings to."
msgstr ""
"ចំណាំ​ថា​ជម្រើស <option>--window</option> គឺ​មាន​សារៈសំខាន់ ។ វា​យក​អាគុយម៉ង់​ដែល​ជា​កន្សោម​ធម្មតា​"
"ផ្គូផ្គង​នឹង​ចំណង​ជើង​របស់​បង្អួច​ដើម្បី​អនុវត្ត​ការ​កំណត់ ។"

#. Tag: para
#: desktop.docbook:78
#, no-c-format
msgid ""
"Please read <command>kstart</command> <option>--help-all</option> for more "
"magic available with &kstart; (and there is an abundance)."
msgstr ""
"សូម​អាន <command>kstart</command> <option>--help-all</option> សម្រាប់​ភាព​អស្ចារ្យ​ដែល​"
"មាន​ភ្ជាប់​នឹង Kstart (និង​មាន​សន្ធឹកសន្ធាប់​ទៀត) ។"

#. Tag: para
#: desktop.docbook:86
#, no-c-format
msgid ""
"Where do I save my files if I want them to appear directly on the desktop?"
msgstr "តើ​ខ្ញុំ​ត្រូវ​រក្សា​ទុក​ឯកសារ​របស់​ខ្ញុំ​នៅ​ទីណា បើ​ខ្ញុំ​ចង់​ឲ្យ​ពួក​វា​លេចឡើង​​នៅ​លើ​ផ្ទៃតុ​ដោយ​ផ្ទាល់ ?"

#. Tag: para
#: desktop.docbook:90
#, no-c-format
msgid ""
"<filename class=\"directory\">$<envar>HOME</envar>/Desktop</filename>. You "
"might need to refresh your desktop after you have saved your files."
msgstr ""
"គឺ <filename class=\"directory\">$<envar>HOME</envar>/Desktop</filename> ។ អ្នក​"
"ត្រូវ​ធ្វើ​ឲ្យ​ផ្ទៃតុ​របស់​អ្នក​ស្រស់​បន្ទាប់​ពី​អ្នក​បាន​រក្សាទុក​ឯកសារ​របស់​អ្នក​រួច ។"

#. Tag: para
#: desktop.docbook:98
#, no-c-format
msgid "I've deleted the Trash icon on my desktop. How can I get it back?"
msgstr ""

#. Tag: para
#: desktop.docbook:102
#, no-c-format
msgid ""
"Right-click on the desktop and in the context menu that appears, choose "
"<menuchoice><guisubmenu>Create New...</guisubmenu><guimenuitem>Link to "
"Location (URL)...</guimenuitem> </menuchoice>. Set the <guilabel>File name</"
"guilabel> to <userinput>Trash</userinput> and the location to "
"<userinput>trash:/</userinput>. Click on <guibutton>OK</guibutton> and "
"you're done."
msgstr ""
