#. Tag: title
#: configkde.docbook:6
#, no-c-format
msgid "Configuring &kde;"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ KDE"

#. Tag: para
#: configkde.docbook:11
#, no-c-format
msgid "How do I set the language used by &kde;?"
msgstr "តើ​ខ្ញុំ​ត្រូវ​កំណត់​ភាសា​ដែល​ប្រើ​ដោយ KDE ដោយ​របៀប​ណា ?"

#. Tag: para
#: configkde.docbook:15
#, no-c-format
msgid ""
"There are two ways to set the language &kde; uses in the messages it will "
"display:"
msgstr "មាន​វិធី​ពីរ​យ៉ាង​ក្នុងការ​កំណត់​ភាសា ដែល KDE ប្រើ​នៅ​ក្នុងសារ ដែល​វា​នឹង​បង្ហាញ ៖"

#. Tag: term
#: configkde.docbook:19
#, no-c-format
msgid "Using the <application>&kde; Control Center</application>"
msgstr "ការ​ប្រើប្រាស់ <application>មជ្ឈមណ្ឌល​បញ្ជា KDE</application>"

#. Tag: para
#: configkde.docbook:20
#, no-c-format
msgid ""
"Fire up the <application>&kde; Control Center</application> and select "
"<guimenu>Regional &amp; Accessibility</guimenu> followed by "
"<guimenuitem>Country/Region &amp; Language</guimenuitem>. You can select "
"your language and location here. If &kde; cannot find a translation in the "
"first language chosen, it will fall back on the default language. This is "
"usually (American) English by default."
msgstr ""
"បើក <application>មជ្ឈមណ្ឌល​បញ្ជា KDE</application> ហើយ​ជ្រើស <guimenu>តំបន់ &amp; "
"មធ្យោបាយ​ងាយ​ស្រួល</guimenu> បន្ទាប់​មក​ជ្រើស <guimenuitem>ប្រទេស​/​តំបន់ និង ភាសា</"
"guimenuitem> ។ អ្នក​អាច​ជ្រើស​ភាសា និង​ទីតាំង​របស់​អ្នក​នៅ​ទីនេះ ។ ប្រសិន​បើ KDE មិន​អាច​រក​ការ​បកប្រែ​"
"នៅ​ក្នុង​ភាសា​ទី​មួយ​ដែល​បាន​ជ្រើស​ទេ វា​នឹង​ត្រឡប់​ទៅ​ប្រើ​ភាសា​លំនាំ​ដើម​វិញ ។ ជាទូទៅ លំនាំដើម​របស់​វា​គឺ "
"(អាមេរិក) អង់គ្លេស ។"

#. Tag: para
#: configkde.docbook:26
#, no-c-format
msgid ""
"Using the <application>&kde; Control Center</application> is the preferred "
"way of choosing languages in &kde;."
msgstr ""
"ភាគច្រើន គេ​ចូលចិត្ត​ប្រើ <application>មជ្ឈមណ្ឌល​បញ្ជា KDE</application> ដើម្បី​ជ្រើស​រើស​ភាសា​"
"នៅ​ក្នុង KDE ។"

#. Tag: term
#: configkde.docbook:29
#, fuzzy, no-c-format
#| msgid "Using the <envar>LANG</envar> environment variable"
msgid "Using the <envar>KDE_LANG</envar> environment variable"
msgstr "ការ​ប្រើ​អថេរ​បរិស្ថាន <envar>LANG</envar>"

#. Tag: para
#: configkde.docbook:30
#, fuzzy, no-c-format
#| msgid ""
#| "The second method uses the standard locale setting on your system. To "
#| "change the language, simply set the environment variable <envar>LANG</"
#| "envar> accordingly. For example, if your shell is <application>bash</"
#| "application>, execute <userinput><command>export</command> <envar>LANG</"
#| "envar>=de</userinput> to set German as the language used."
msgid ""
"The second method uses the standard locale setting on your system. To change "
"the language, simply set the environment variable <envar>KDE_LANG</envar> "
"accordingly. For example, if your shell is <application>bash</application>, "
"execute <userinput><command>export</command> <envar>KDE_LANG</envar>=de</"
"userinput> to set German as the language used."
msgstr ""
"វិធីសាស្ត្រ​ទីពីរ​ប្រើ​ការ​កំណត់​មូលដ្ឋាន​ស្តង់ដារ​នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក ។ ដើម្បី​ផ្លាស់ប្ដូរ​ភាសា ត្រូវ​កំណត់​អថេរ​"
"បរិស្ថាន <envar>LANG</envar> ឲ្យបាន​ត្រឹមត្រូវ ។ ឧទាហរណ៍ ប្រសិន​បើ​សែល​របស់​អ្នក​គឺ​ជា "
"<application>bash</application> គឺ​ត្រូវ​ប្រតិបត្តិ <userinput><command>export</"
"command> <envar>LANG</envar>=de</userinput> ដើម្បី​កំណត់ ភាសា​អាល្លឺម៉ង់​ជា​ភាសា​ដែល​ត្រូវ​"
"ប្រើ ។"

#. Tag: para
#: configkde.docbook:43
#, no-c-format
msgid "Is there any keyboard switcher for international keyboards for &kde;?"
msgstr "តើមាន​កម្មវិធី​ប្ដូរ​ក្ដារចុច​សម្រាប់​​ក្ដារចុច​អន្តរជាតិ​នៅ​ក្នុង KDE ដែរ​ឬទេ ?"

#. Tag: para
#: configkde.docbook:47
#, no-c-format
msgid ""
"Yes, you can configure it using the <application>&kde; Control Center</"
"application> <guimenu>Regional &amp; Accessibility</guimenu> "
"<guimenuitem>Keyboard Layout</guimenuitem> configuration page."
msgstr ""
"បាទ​មាន អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​វា​ដោយ​ប្រើ​ទំព័រ​កំណត់​រចនា​សម្ព័ន្ធ <application>មជ្ឈមណ្ឌល​បញ្ជា "
"KDE</application> ហើយ​ជ្រើស <menuchoice><guimenu>តំបន់ &amp; មធ្យោបាយ​ងាយ​ស្រួល</"
"guimenu> <guimenuitem>ប្លង់​ក្ដារចុច</guimenuitem></menuchoice> ។"

#. Tag: para
#: configkde.docbook:58
#, no-c-format
msgid ""
"How do I replace the standard text login screen with the &kde; login screen?"
msgstr "តើ​ខ្ញុំ​អាច​ជំនួស​អេក្រង់​ចូល​អត្ថបទ​ស្តង់ដារ​ដោយ​អេក្រង់​ចូល​ KDE តាម​របៀប​ណា ?"

#. Tag: para
#: configkde.docbook:62
#, no-c-format
msgid ""
"Your distribution/&UNIX; flavor may have its own setup tools to change this "
"(&eg; <application>YaST</application> on &SuSE; &Linux;). This will be the "
"safest way to enable the &kde; login screen. However, if for some reason you "
"do not wish to use these tools, the following instructions may be useful."
msgstr ""
"បែបបទនៃ​ការ​ចែកចាយ/យូនីក របស់​អ្នក​អាច​មាន​ឧបករណ៍​រៀបចំ​ផ្ទាល់ខ្លួន​របស់​វា​ក្នុងការ​ផ្លាស់ប្ដូរ (ឧ. "
"<application>YaST</application> នៅ​លើស៊ូស៊ី​លីនុច) ។ នេះ​ជា​វិធី​ដែល​លឿន​បំផុត​ដើម្បី​ប្រើ​អេក្រង់​ចូល "
"KDE ។ ទោះជា​យ៉ាងណាក៏ដោយ ប្រសិន​បើ​មាន​មូលហេតុ​ណាមួយ​ដែល​ធ្វើឲ្យ​អ្នក​មិន​ចង់​​ប្រើ​ឧបករណ៍​ទាំងនេះ សូម​មើល​"
"សេចក្ដី​ណែនាំ​ខាងក្រោម ។"

#. Tag: para
#: configkde.docbook:66
#, no-c-format
msgid ""
"First, you need to change to the <quote>xdm runlevel</quote> (runlevel 5 on "
"&RedHat; and &SuSE; systems) by editing your <filename>/etc/inittab</"
"filename> file. In the file, you should have a line saying <userinput>id:3:"
"initdefault:</userinput>. Change it to <userinput>id:5:initdefault:</"
"userinput>. Now, at the end of the file, comment out the following line: "
"<literal>x:5:respawn:/usr/bin/X11/xdm -nodaemon</literal> and replace it "
"with <userinput>x:5:respawn:<replaceable>/opt/kde/</replaceable>bin/kdm -"
"nodaemon</userinput>."
msgstr ""
"ដំបូង អ្នក​ត្រូវ​ប្ដូរ​ទៅ <quote>xdm runlevel</quote> (runlevel 5 នៅ​លើ​ប្រព័ន្ធ RedHat® និង​ "
"ស៊ូស៊ី) ដោយ​​កែ​សម្រួល​ឯកសារ <filename>/etc/inittab</filename> របស់​អ្នក ។ នៅ​ក្នុង​ឯកសារ អ្នក​"
"នឹង​ឃើញ​បន្ទាត់​មួយ​គឺ <userinput>id:3:initdefault:</userinput> ។ ប្ដូរ​វា​ទៅ "
"<userinput>id:5:initdefault:</userinput> ។ ឥឡូវ នៅ​ចុង​បញ្ចប់​ឯកសារ រក​បន្ទាត់​"
"ដូចខាងក្រោម ៖ <literal>x:5:respawn:/usr/bin/X11/xdm -nodaemon</literal> ហើយ​ជំនួស​"
"វា​ដោយ <userinput>x:5:respawn:<replaceable>/opt/kde/</replaceable>bin/kdm -"
"nodaemon</userinput> ។"

#. Tag: para
#: configkde.docbook:76
#, no-c-format
msgid "The location of &kdm; may differ on your system."
msgstr "ទីតាំង​របស់ kdm អាចខុស​ពី​ប្រព័ន្ធ​របស់​អ្នក ។"

#. Tag: para
#: configkde.docbook:78
#, no-c-format
msgid ""
"For changes to take effect immediately, type <command>init 5</command> (for "
"&RedHat; systems) at the shell prompt."
msgstr ""
"ចំពោះ​ការ​ផ្លាស់ប្ដូរ​ដើម្បី​ឲ្យ​មាន​ប្រសិទ្ធិភាព​ភ្លាមៗ គឺ​ត្រូវ​វាយ <command>init 5</command> (សម្រាប់​"
"ប្រព័ន្ធ RedHat) នៅ​ប្រអប់​បញ្ចូល​សែល ។"

#. Tag: para
#: configkde.docbook:80
#, no-c-format
msgid ""
"It is risky to initiate a graphical login without checking beforehand "
"whether it works. If it fails to work, you would be in for a hard time "
"getting back...."
msgstr ""
"វា​ដូច​ជា​ប្រថុយ​ពេកហើយ​ដែល​ចាប់​ផ្ដើម​ការ​ចូល​ក្រាហ្វិក​ដោយ​មិន​បាន​ពិនិត្យ​មើល​ជាមុន​ថាតើ​វា​ធ្វើការ​ឬ​អត់​នោះ ។ "
"ប្រសិន​បើ​វា​ធ្វើការ​បរាជ័យ អ្នក​នឹង​ពិបាក​ក្នុងការ​ត្រឡប់​មក​ក្រោយវិញ... ។"

#. Tag: para
#: configkde.docbook:85
#, no-c-format
msgid ""
"For FreeBSD, you should edit the file <filename>/etc/ttys</filename> and "
"change one of the lines that look like <programlisting>ttyv8   \"/usr/X11R6/"
"bin/xdm -nodaemon\"  xterm   off secure</programlisting> to instead say "
"<userinput>ttyv8 \"/usr/local/bin/kdm -nodaemon\" xterm off secure</"
"userinput>."
msgstr ""
"ចំពោះ FreeBSD អ្នក​គួរ​តែ​កែ​សម្រួល​ឯកសារ <filename>/etc/ttys</filename> និង​ផ្លាស់ប្ដូរ​បន្ទាត់​"
"មួយ​គឺ <programlisting>ttyv8   \"/usr/X11R6/bin/xdm -nodaemon\"  xterm   off "
"secure</programlisting> ជំនួស​ដោយ <userinput>ttyv8 \"/usr/local/bin/kdm -"
"nodaemon\" xterm off secure</userinput> វិញ ។"

#. Tag: para
#: configkde.docbook:114
#, no-c-format
msgid "Where do I find information regarding &kde; themes?"
msgstr "តើ​ខ្ញុំ​អាច​រក​ព័ត៌មាន​អំពី​ស្បែក KDE ​នៅ​កន្លែង​ណា ?      "

#. Tag: para
#: configkde.docbook:117
#, no-c-format
msgid ""
"Visit <ulink url=\"http://www.kde-look.org\">http://www.kde-look.org</ulink> "
"for a wide range of KDE themes and theming resources."
msgstr ""

#. Tag: para
#: configkde.docbook:124
#, no-c-format
msgid "How do I change &MIME; Types?"
msgstr "តើ​ខ្ញុំ​ផ្លាស់ប្ដូរ​ប្រភេទ MIME ដោយ​របៀបណា ?"

#. Tag: para
#: configkde.docbook:127
#, no-c-format
msgid ""
"If you are using &konqueror;, do this instead: first, open a &konqueror; "
"window and choose <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure Konqueror</guimenuitem></menuchoice>, then "
"<guilabel>File Associations</guilabel>. Find the type you want to change "
"(&eg; <literal>text/english</literal> or <literal>image/gif</literal>), and "
"set the application preference order to whatever you want."
msgstr ""
"ប្រសិន​បើ​អ្នក​កំពុង​ប្រើ Konqueror គឺ​ត្រូវ​ធ្វើ​ដូចតទៅ​នេះ ៖ ដំបូង ត្រូវ​បើក​បង្អួច Konqueror ហើយ​ជ្រើស "
"<menuchoice><guimenu>ការ​កំណត់</guimenu><guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ Konqueror</"
"guimenuitem></menuchoice> បន្ទាប់​មក​ជ្រើស <guilabel>ទំនាក់ទំនង​ឯកសារ</guilabel> ។ រក​"
"ប្រភេទ​ដែល​អ្នក​ចង់​ផ្លាស់ប្ដូរ (ឧ. <literal>text/english</literal> ឬ <literal>image/"
"gif</literal>) ហើយ​កំណត់​លំដាប់​ចំណូល​ចិត្ត​កម្មវិធី​ទៅ​អ្វី​ក៏​ដោយ​ដែល​អ្នក​ចង់​ប្ដូរ​ទៅ ។"

#. Tag: para
#: configkde.docbook:139
#, no-c-format
msgid "&kde; (&kdm;) does not read my <filename>.bash_profile</filename>!"
msgstr "KDE (kdm) មិន​អាន <filename>.bash_profile</filename> របស់​ខ្ញុំ​ទេ !"

#. Tag: para
#: configkde.docbook:143
#, no-c-format
msgid ""
"The login managers<application>xdm</application> and &kdm; do not run a "
"login shell, so <filename>.profile</filename>, <filename>.bash_profile</"
"filename>, &etc; are not sourced. When the user logs in, <application>xdm</"
"application> runs <command>Xstartup</command> as root and then "
"<command>Xsession</command> as user. So the normal practice is to add "
"statements in <filename>Xsession</filename> to source the user profile. "
"Please edit your <filename>Xsession</filename> and <filename>.xsession</"
"filename> files."
msgstr ""
"កម្មវិធី​គ្រប់គ្រង​ការ​ចូល​<application>xdm</application> និង kdm មិន​រត់​សែល​ចូល​ទេ ដូច្នេះ "
"<filename>.profile</filename>, <filename>.bash_profile</filename> -ល- មិន​ត្រូវ​"
"បាន​យក​ធ្វើ​ជា​ប្រភព​ទេ ។ នៅ​ពេល​ដែល​អ្នក​ប្រើចូល នោះ <application>xdm</application> រត់ "
"<command>Xstartup</command> ជា root ហើយ​បន្ទាប់​មក​រត់ <command>Xsession</command> "
"ជា​អ្នក​ប្រើ ។ ដូច្នេះ ការ​អុវត្ត​ធម្មតា គឺ​ត្រូវ​បន្ថែម​ឃ្លា​កូដ​នៅ​ក្នុង <filename>Xsession</"
"filename> ដើម្បី​យក​ទម្រង់​អ្នក​ប្រើ​ធ្វើ​ជា​ប្រភព ។ សូម​កែ​សម្រួល​ឯកសារ <filename>Xsession</"
"filename> និង <filename>.xsession</filename> របស់​អ្នក ។"

#. Tag: para
#: configkde.docbook:157
#, no-c-format
msgid "How do I use &TrueType; fonts in &kde;?"
msgstr "តើ​ខ្ញុំ​ប្រើ​ពុម្ពអក្សរ TrueType នៅ​ក្នុង​ KDE ដោយ​របៀប​ណា ?"

#. Tag: para
#: configkde.docbook:161
#, no-c-format
msgid ""
"You need to install &TrueType; font support into your &X-Window; "
"configuration. Please take a look at <ulink url=\"http://x.themes.org/\">x."
"themes.org</ulink> for the fonts, and <ulink url=\"http://www.dcs.ed.ac.uk/"
"home/jec/programs/xfsft/\">xfsft: &TrueType; Font Support For X11</ulink> or "
"<ulink url=\"http://X-TT.dsl.gr.jp/\">X-&TrueType; Server Project Home Page</"
"ulink> for the font servers."
msgstr ""
"អ្នក​ត្រូវ​ដំឡើង​ការ​គាំទ្រ​ពុម្ពអក្សរ TrueType ទៅ​ក្នុង​ការ​កំណត់​រចនា​សម្ព័ន្ធ X-Window របស់​អ្នក ។ សូម​"
"មើល​នៅ <ulink url=\"http://x.themes.org/\">x.themes.org</ulink> សម្រាប់​ពុម្ព​អក្សរ "
"និង <ulink url=\"http://www.dcs.ed.ac.uk/home/jec/programs/xfsft/\">xfsft: ការ​"
"គាំទ្រ​ពុម្ពអក្សរ TrueType សម្រាប់ X11</ulink> ឬ <ulink url=\"http://X-TT.dsl.gr.jp/"
"\">គេហទំព័រ​គម្រោង​ម៉ាស៊ីន​បម្រើ X-TrueType</ulink> សម្រាប់​ម៉ាស៊ីន​ប្រើ​ពុម្ពអក្សរ ។"

#. Tag: para
#: configkde.docbook:169
#, fuzzy, no-c-format
#| msgid ""
#| "If you have a bunch of &TrueType; fonts from &Microsoft; &Windows;, edit "
#| "the <filename>XF86Config</filename> file to get the fonts from the font "
#| "folder. Then just tell &kde; to use these new fonts with the font "
#| "administrator utility."
msgid ""
"If you have a bunch of &TrueType; fonts from &Microsoft; &Windows;, edit the "
"<filename>xorg.conf</filename> file to get the fonts from the font folder. "
"Then just tell &kde; to use these new fonts with the font administrator "
"utility."
msgstr ""
"បើ​អ្នក​មាន​ពុម្ព​អក្សរ TrueType មួយ​ចំនួន​ពី​ម៉ៃក្រូសូហ្វ វីនដូ ចូរ​អ្នក​កែ​សម្រួល​ឯកសារ "
"<filename>XF86Config</filename> ដើម្បី​យក​ពុម្ព​អក្សរ​ពី​ថត​ពុម្ព​អក្សរ ។ បន្ទាប់​មក អ្នក​​គ្រាន់​តែ​"
"ប្រាប់ KDE ឲ្យ​ប្រើ​ពុម្ព​អក្សរ​ថ្មី​ទាំងនេះ​ដោយប្រើ​ឧបករណ៍​ប្រើប្រាស់​កម្មវិធី​​គ្រប់គ្រង​ពុម្ព​អក្សរ ។"

#. Tag: para
#: configkde.docbook:179
#, no-c-format
msgid "Is it possible to enter, show and work with the Euro Symbol in &kde;?"
msgstr "តើ​អាច​បញ្ចូល បង្ហាញ និង​ធ្វើការ​ជាមួយ​និមិត្ត​សញ្ញា​អឺរ៉ុប​នៅ​ក្នុង KDE បាន​ឬ​​ទេ ?"

#. Tag: para
#: configkde.docbook:183
#, no-c-format
msgid ""
"Yes and no. For details, look here: <ulink url=\"http://www.koffice.org/"
"kword/euro.php\">http://www.koffice.org/kword/euro.php</ulink>."
msgstr ""
"បាទ/ចាស និង ទេ ។ ចំពោះ​ព័ត៌មាន​លម្អិត សូម​មើល ៖ <ulink url=\"http://www.koffice.org/"
"kword/euro.php\">http://www.koffice.org/kword/euro.php</ulink> ។"

#. Tag: para
#: configkde.docbook:189
#, no-c-format
msgid "How do I run a program at &kde; startup?"
msgstr "តើ​ខ្ញុំ​អាច​រត់​កម្មវិធី​នៅពេល​ចាប់​ផ្ដើម KDE ដោយ​របៀប​ណា ?"

#. Tag: para
#: configkde.docbook:191
#, fuzzy, no-c-format
#| msgid ""
#| "There are many ways to do that. If what you want to do is to run some "
#| "scripts that would set some environment variables (for example, to start "
#| "<command>gpg-agent</command>, <command>ssh-agent</command> and others), "
#| "you can put these scripts into <filename class=\"directory\">"
#| "$<envar>KDEHOME</envar>/env/</filename> and make sure their names end in "
#| "<literal role=\"extension\">.sh</literal>. $<envar>KDEHOME</envar> is "
#| "usually a folder named <filename class=\"directory\">.kde</filename> "
#| "(note the period at the beginning) in your home folder. If you want "
#| "scripts to be executed for all &kde; users, you can put them under "
#| "<filename class=\"directory\">$<envar>KDEDIR</envar>/env/</filename>, "
#| "where $<envar>KDEDIR</envar> is the prefix &kde; was installed to (you "
#| "can find this out using the command <userinput><command>kde-config</"
#| "command> --prefix</userinput>)."
msgid ""
"There are many ways to do that. If what you want to do is to run some "
"scripts that would set some environment variables (for example, to start "
"<command>gpg-agent</command>, <command>ssh-agent</command> and others), you "
"can put these scripts into <filename class=\"directory\">$<envar>KDEHOME</"
"envar>/env/</filename> and make sure their names end in <literal role="
"\"extension\">.sh</literal>. $<envar>KDEHOME</envar> is usually a folder "
"named <filename class=\"directory\">.kde</filename> (note the period at the "
"beginning) in your home folder. If you want scripts to be executed for all "
"&kde; users, you can put them under <filename class=\"directory\">"
"$<envar>KDEDIR</envar>/env/</filename>, where $<envar>KDEDIR</envar> is the "
"prefix &kde; was installed to (you can find this out using the command "
"<userinput><command>kde4-config</command> --prefix</userinput>)."
msgstr ""
"មាន​វិធី​ជា​ច្រើន​ដើម្បី​ធ្វើ​ដូច​នោះ ។ ប្រសិន​បើ​​អ្នក​ចង់​រត់​ស្គ្រីប​មួយ​ចំនួន ដែល​នឹង​កំណត់​អថេរ​បរិស្ថាន​ខ្លះៗ​នោះ "
"(ឧទាហរណ៍ ដើម្បី​ចាប់ផ្ដើម <command>gpg-agent</command>, <command>ssh-agent</"
"command> និង​ផ្សេង​ទៀត) អ្នក​អាច​ដាក់​ស្គ្រីប​ទាំងនេះ​ទៅ​ក្នុង <filename class=\"directory\">"
"$<envar>KDEHOME</envar>/env/</filename> ហើយ​​ឈ្មោះ​របស់​ពួក​វា​គឺ​ត្រូវ​​បញ្ចប់​ដោយ <literal "
"role=\"extension\">.sh</literal> ។ $<envar>KDEHOME</envar> ជា​ធម្មតា​គឺ​ជា​ថត​ដែល​មាន​"
"ឈ្មោះ <filename class=\"directory\">.kde</filename> (ចំណាំ​ថេរវេលា​នៅ​ពេល​ចាប់ផ្ដើម) "
"នៅ​ក្នុង​ថត​ផ្ទះ​របស់​អ្នក ។ ប្រសិន​បើ​អ្នក​ចង់​​ប្រតិបត្តិ​ស្គ្រីប​ដល់​អ្នក​ប្រើ KDE ទាំងអស់ អ្នក​អាច​ដាក់​ពួក​វា​នៅ​ "
"<filename class=\"directory\">$<envar>KDEDIR</envar>/env/</filename> ដែល ​"
"$<envar>KDEDIR</envar> គឺ​ជា​កន្លែង​ដែល​បាន​ដំឡើង​​​បុព្វបទ KDE (អ្នក​អាច​កំណត់​វា​ដោយ​ប្រើ​ពាក្យ​"
"បញ្ជា <userinput><command>kde-config</command> --prefix</userinput>) ។"

#. Tag: para
#: configkde.docbook:202
#, no-c-format
msgid ""
"If you wish to start a program after &kde; has started, you may want to use "
"the <filename class=\"directory\">Autostart</filename> folder. To add "
"entries to the <filename class=\"directory\">Autostart</filename> folder:"
msgstr ""
"ប្រសិន​បើ​អ្នក​ចង់​បើក​កម្មវិធី​បន្ទាប់​ពី​បាន​ចាប់​ផ្ដើម​ KDE គឺ​អ្នក​ត្រូវ​ប្រើថត <filename class="
"\"directory\">Autostart</filename> ។ ដើម្បី​បន្ថែម​ធាតុ​ទៅកាន់​ថត <filename class="
"\"directory\">Autostart</filename> គឺ​ត្រូវ ៖"

#. Tag: para
#: configkde.docbook:206
#, no-c-format
msgid "Open &konqueror;."
msgstr "បើក Konqueror"

#. Tag: para
#: configkde.docbook:208
#, no-c-format
msgid ""
"Select <menuchoice><guimenu>Go</guimenu><guimenuitem>Autostart</guimenuitem> "
"</menuchoice> from the menubar."
msgstr ""
"ជ្រើស <menuchoice><guimenu>ទៅ</guimenu><guimenuitem>ចាប់ផ្ដើម​ស្វ័យ​ប្រវត្តិ</"
"guimenuitem> </menuchoice> ពី​របារ​ម៉ឺនុយ ។"

#. Tag: para
#: configkde.docbook:211
#, no-c-format
msgid ""
"Right-click in the window view area and select "
"<menuchoice><guisubmenu>Create New</guisubmenu><guisubmenu>File</"
"guisubmenu><guimenuitem>Link to Application</guimenuitem> </menuchoice>"
msgstr ""
"ចុច​កណ្ដុរ​ខាង​ស្ដាំ​ក្នុង​ផ្ទៃ​ទិដ្ឋភាព​បង្អួច ហើយ​ជ្រើស <menuchoice><guisubmenu>បង្កើត​ថ្មី</"
"guisubmenu><guisubmenu>ឯកសារ</guisubmenu><guimenuitem>តំណ​ទៅ​កម្មវិធី</"
"guimenuitem> </menuchoice>"

#. Tag: para
#: configkde.docbook:215
#, no-c-format
msgid ""
"Click on the <guilabel>Application</guilabel> tab in the window that appears "
"and enter the name of the command to run in the <guilabel>Command</guilabel> "
"text box."
msgstr ""
"ចុច​លើ​ផ្ទាំង <guilabel>កម្មវិធី</guilabel> នៅ​ក្នុង​បង្អួច​ដែល​បង្ហាញ ហើយ​បញ្ចូល​ឈ្មោះ​ពាក្យ​បញ្ជា​ដែល​"
"ត្រូវ​រត់​នៅ​ក្នុង​ប្រអប់​អត្ថបទ <guilabel>ពាក្យ​បញ្ជា</guilabel> ។"

#. Tag: para
#: configkde.docbook:227
#, no-c-format
msgid ""
"How can I allow more than one user to be logged in a at a time? Can &kde; do "
"<quote>fast user switching</quote>?"
msgstr ""
"តើ​ខ្ញុំ​អាច​អនុញ្ញាត​ឲ្យ​អ្នក​ប្រើ​ច្រើន​ចូល​ក្នុង​ពេល​តែ​មួយ​បាន​ដោយ​របៀប​ណា ? តើ KDE អាច​"
"ធ្វើការ<quote>ប្ដូរ​អ្នក​ប្រើ​បាន​រហ័ស</quote>​ដែរ​ឬ​ទេ ?"

#. Tag: para
#: configkde.docbook:231
#, no-c-format
msgid ""
"To enable more than one user to log in at one time on the same computer "
"(sometimes referred to as <quote>fast user switching</quote>) you need to "
"tell the program that logs you in that it can use more than one session (or, "
"in &X-Window; terms, <quote>display</quote>) at a time."
msgstr ""
"ដើម្បី​អនុញ្ញាត​ឲ្យ​អ្នក​ប្រើ​ច្រើន​ចូល​ក្នុង​កុំព្យូទ័រ​មួយ​ក្នុង​ពេល​តែ​មួយ (ពេល​ខ្លះ​សំដៅ​លើ ពេល​<quote>ប្ដូរ​អ្នក​ប្រើ​"
"រហ័ស</quote>) អ្នក​ត្រូវ​ប្រាប់​កម្មវិធី​ដែល​បញ្ចូល​អ្នក​​ថា​វា​អាច​ប្រើ​សម័យ​ច្រើន​ជាង​មួយ (ឬ នៅ​ក្នុង​"
"ការព្រមព្រាង វីនដូ X ដែល<quote>បង្ហាញ</quote>) ក្នុងពេលតែមួយ ។"

#. Tag: para
#: configkde.docbook:236
#, no-c-format
msgid ""
"In &kde;, this program is called &kdm; which stands for <quote>&kde; Display "
"Manager</quote>. If you are not using &kdm; as your login screen then you "
"will need to consult the documentation for the software you are using on how "
"to accomplish multiple sessions."
msgstr ""
"ក្នុង KDE កម្មវិធី​នេះ​គឺ​គេ​ហៅថា kdm ដែល​តំណាង​ឲ្យ​<quote>កម្មវិធី​គ្រប់គ្រង​ការ​បង្ហាញ KDE</quote> "
"។ ប្រសិន​បើ​អ្នក​មិន​កំពុង​ប្រើ kdm ជា​អេក្រង់​ចូល​របស់​អ្នក​ទេ ពេល​នោះ​អ្នក​នឹង​ត្រូវ​ពិគ្រោះ​ឯកសារ​សម្រាប់​កម្មវិធី​"
"ដែល​អ្នក​កំពុង​ប្រើ​អំពី​របៀប​បំពេញ​សម័យ​ច្រើន ។"

#. Tag: para
#: configkde.docbook:241
#, no-c-format
msgid ""
"By default, this will be configured at installation time automatically if "
"&kdm; supports virtual terminals on your system (currently Linux only). If "
"it was not configured automatically, consult the &kdm; manual, section "
"<ulink url=\"help:/kdm/kdmrc-xservers\">Specifying permanent &X-Server;s</"
"ulink>. After modifying kdmrc, you will have to let &kdm; know about it; "
"just invoke <command>killall -HUP kdm</command>."
msgstr ""
"តាម​លំនាំ​ដើម វា​នឹង​ត្រូវ​បាន​កំណត់​រចនា​សម្ព័ន្ធ​នៅ​ពេល​ដំឡើង​ដោយ​ស្វ័យប្រវត្តិ ប្រសិន​បើ kdm គាំទ្រ​ស្ថានីយ​និម្មិត​"
"នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក (តែ​ចំពោះ​លីនុច​បច្ចុប្បន្ន​ប៉ុណ្ណោះ) ។ ប្រសិន​បើ​វា​មិន​ត្រូវ​បាន​កំណត់​រចនា​សម្ព័ន្ធ​ដោយ​"
"ស្វ័យប្រវត្តិទេ សូម​ពិគ្រោះ​សៀវភៅ​ដៃ kdm នៅ​ផ្នែក <ulink url=\"help:/kdm/kdmrc-xservers"
"\">ការបញ្ជាក់​ម៉ាស៊ីន​បម្រើ X អចិន្ត្រៃយ</ulink> ។ បន្ទាប់​ពី​កែប្រែ Kdmrc រួច​មក អ្នក​នឹង​ត្រូវ​តែ​"
"អនុញ្ញាត​ឲ្យ Kdm ស្គាល់​អំពី​វា ដោយគ្រាន់​តែ​ហៅ <command>killall -HUP kdm</command> ប៉ុណ្ណោះ ។"

#~ msgid ""
#~ "I would like to click the &LMB; anywhere on the desktop and have the "
#~ "<guimenu>K</guimenu> menu displayed."
#~ msgstr ""
#~ "ខ្ញុំ​ចង់​ចុច​ប៊ូតុង​កណ្ដុរ​ខាង​ឆ្វេង​នៅ​កន្លែង​ណាមួយ​នៅ​លើ​ផ្ទៃតុ ហើយ​ឲ្យ​បង្ហាញ​ម៉ឺនុយ <guimenu>K</"
#~ "guimenu> ។"

#~ msgid ""
