#. Tag: application
#: accessibility.docbook:29
#, no-c-format
msgid "<application>KMouseTool</application>"
msgstr "<application>KMouseTool</application>"

#. Tag: primary
#: accessibility.docbook:31
#, no-c-format
msgid "Mouse"
msgstr "កណ្ដុរ"

#. Tag: secondary
#: accessibility.docbook:31
#, no-c-format
msgid "clicking automatically"
msgstr "ការ​ចុច​ដោយស្វ័យ​ប្រវត្តិ"

#. Tag: para
#: accessibility.docbook:34
#, no-c-format
msgid ""
"<application>KMouseTool</application> is a &kde; program, which clicks the "
"mouse for you, so you do not have to. <application>KMouseTool</application> "
"works with any mouse or pointing device."
msgstr ""
"<application>KMouseTool</application> គឺ​ជា​កម្មវិធី​របស់ KDE មួយ​ដែល​សម្រាប់​ចុច​កណ្ដុរ​ឲ្យ​អ្នក "
"ដូច្នេះ​អ្នក​មិន​ចាំ​បាច់​ធ្វើ​វា​នោះ​ទេ ។ <application>KMouseTool</application> ធ្វើការ​ជា​មួយ​"
"ឧបករណ៍​ចង្អុរ ឬ​កណ្ដុរ​ណា​មួយ ។"

