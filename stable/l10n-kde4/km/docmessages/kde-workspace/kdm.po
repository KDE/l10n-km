#. Tag: term
#: index.docbook:1475
#, no-c-format
msgid ""
"<command>list</command> [<parameter>all</parameter> | <parameter>alllocal</"
"parameter>]"
msgstr ""

#. Tag: para
#: index.docbook:1478
#, no-c-format
msgid ""
"Return a list of running sessions. By default all active sessions are listed "
"(this is useful for a shutdown warning). If <parameter>all</parameter> is "
"specified, passive sessions are listed as well. If <parameter>alllocal</"
"parameter> is specified, passive sessions are listed as well, but all "
"incoming remote sessions are skipped (this is useful for a fast user "
"switching agent)."
msgstr ""

#. Tag: para
#: index.docbook:1484
#, no-c-format
msgid "Each session entry is a comma separated tuple of:"
msgstr ""

#. Tag: para
#: index.docbook:1486
#, no-c-format
msgid "Display or TTY name"
msgstr ""

#. Tag: para
#: index.docbook:1487
#, no-c-format
msgid ""
"VT name for local sessions, remote host name prefixed by <literal>@</"
"literal> for remote TTY sessions, otherwise empty"
msgstr ""

#. Tag: para
#: index.docbook:1489
#, no-c-format
msgid ""
"Logged in user's name, empty for passive sessions and outgoing remote "
"sessions (local chooser mode)"
msgstr ""

#. Tag: para
#: index.docbook:1491
#, no-c-format
msgid ""
"Session type for active local sessions, remote hostname for outgoing remote "
"sessions, empty for passive sessions."
msgstr ""

#. Tag: para
#: index.docbook:1493
#, no-c-format
msgid "A Flag field:"
msgstr ""

#. Tag: para
#: index.docbook:1494
#, no-c-format
msgid ""
"<literal>*</literal> for the display belonging to the requesting socket."
msgstr ""

#. Tag: para
#: index.docbook:1496
#, no-c-format
msgid ""
"<literal>!</literal> for sessions that cannot be killed by the requesting "
"socket."
msgstr ""

#. Tag: para
#: index.docbook:1498
#, no-c-format
msgid "<literal>t</literal> for TTY sessions."
msgstr ""

#. Tag: para
#: index.docbook:1502
#, no-c-format
msgid "New fields may be added in the future."
msgstr ""

#. Tag: para
#: index.docbook:1509
#, no-c-format
msgid ""
"Start a reserve login screen. If nobody logs in within some time, the "
"display is removed again. When the session on the display exits, the display "
"is removed, too."
msgstr ""

#. Tag: para
#: index.docbook:1512 index.docbook:1524
#, no-c-format
msgid "Permitted only on sockets of local displays and the global socket."
