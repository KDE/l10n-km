#~ "This page contains three listboxes. The large listbox on the left shows "
#~ "all the users on the system which might be a genuine user."
#~ msgstr ""
#~ "ទំព័រ​នេះ​មាន​ប្រអប់​បញ្ជី​បី ។ ប្រអប់​បញ្ជី​ធំ​នៅ​ខាងឆ្វេង​បង្ហាញ​អ្នក​ប្រើ​ទាំងអស់​នៅ​លើ​ប្រព័ន្ធ​ដែល​ប្រហែល​ជា​"
#~ "អ្នក​ប្រើ​វៃ​ឆ្លាត ។"

#~ msgid ""
#~ "The top rightmost listbox shows the selected users and the bottom "
#~ "rightmost listbox shows the users we don't want displayed in the login "
#~ "window."
#~ msgstr ""
#~ "ប្រអប់​បញ្ជី​នៅ​ខាងស្ដាំ​កំពូល​បំផុត​បង្ហាញ​អ្នក​ប្រើ​ដែល​បាន​ជ្រើស និង​ប្រអប់​បញ្ជី​ខាង​ស្ដាំ​ក្រោម​បំផុត​បង្ហាញ​អ្នក​"
#~ "ប្រើ​ដែល​យើង​មិន​ចង់​បង្ហាញ​ក្នុង​បង្អួច​ចូល ។"

#~ msgid "Images"
#~ msgstr "រូបភាព"

#~ msgid ""
#~ "This section of the manual only applies if <guilabel>Show users</"
#~ "guilabel> is selected. If it is not, this image box has no effect."
#~ msgstr ""
#~ "ផ្នែក​នេះ​នៃ​សៀវភៅ​ដៃ​អនុវត្ត​បាន​​តែ​នៅពេល​ដែល​បាន​ជ្រើស <guilabel>បង្ហាញ​អ្នក​ប្រើ</"
#~ "guilabel> ប៉ុណ្ណោះ ។ ប្រសិន​​បើ​មិន​បាន​ជ្រើស ប្រអប់​រូបភាព​នេះ​នឹង​​គ្មាន​ប្រសិទ្ធិភាព​ទេ ។"

#~ msgid ""
#~ "Every user on the system can be represented by a image. The image for the "
#~ "user is kept in a file called <filename>$<envar>KDEDIR</envar>/share/apps/"
#~ "kdm/pics/users/$<envar>USER</envar>.xpm.</filename> If the user doesn't "
#~ "have such a file the file <filename>$<envar>KDEDIR</envar>/share/apps/kdm/"
#~ "pics/users/default.xpm</filename> will be used instead."
#~ msgstr ""
#~ "អ្នក​ប្រើ​នីមួយៗ​នៅ​លើ​ប្រព័ន្ធ​អាច​ត្រូវ​បាន​តំណាង​ដោយ​រូបភាព​មួយ ។ រូបភាព​សម្រាប់​អ្នក​ត្រូវ​បាន​រក្សាទុក​នៅ​"
#~ "ក្នុង​ឯកសារ​​មួយ​ដែល​មាន​ឈ្មោះ​ថា <filename>$<envar>KDEDIR</envar>/share/apps/kdm/"
#~ "pics/users/$<envar>USER</envar>.xpm.</filename> បើ​អ្នក​ប្រើ​មិន​មាន​ឯកសារ​នោះ​ទេ "
#~ "ឯកសារ <filename>$<envar>KDEDIR</envar>/share/apps/kdm/pics/users/default."
#~ "xpm</filename> នឹង​ត្រូវ​បាន​ប្រើ​ជំនួស ។"

#~ msgid ""
#~ "To assign a new image to a user just select the user in one of the "
#~ "listboxes and either drop an imagefile on the image button to the right "
#~ "or click on the image button and select a new image from the image "
#~ "selector."
#~ msgstr ""
#~ "ដើម្បី​ផ្ដល់​រូបភាព​ថ្មី​ឲ្យ​អ្នក​ប្រើ គឺ​គ្រាន់​តែ​ជ្រើស​អ្នក​ប្រើ​នៅក្នុង​ប្រអប់​បញ្ជី​មួយ ហើយ​ទម្លាក់​ឯកសារ​រូបភាព​"
#~ "នៅលើ​ប៊ូតុង​រូបភាព​នៅ​ខាង​ស្ដាំ ឬ​ចុច​លើ​ប៊ូតុង​រូបភាព​ ហើយ​ជ្រើស​រូបភាព​ថ្មី​មួយ​ពី​ប្រអប់​ជ្រើស​រូបភាព ។"

#~ msgid ""
#~ "If no user is currently selected you will be asked if you want to change "
#~ "the default image."
#~ msgstr ""
#~ "ប្រសិន​បើ​បច្ចុប្បន្ន​​មិនបាន​ជ្រើស​អ្នក​ប្រើ​ណាមួយ​ទេ អ្នក​នឹង​ត្រូវ​បាន​សួរ​ថាតើ​អ្នក​ចង់​ផ្លាស់ប្ដូរ​រូបភាព​"
#~ "លំនាំដើម​ឬ​អត់ ។"

#~ msgid ""
#~ "The replacement is performed by a &konqueror; process so if the image "
#~ "file already exists you will be prompted by &konqueror; if you want to "
#~ "replace it. If you confirm the image will be replaced - you will "
#~ "<emphasis>not</emphasis> have to press the <guibutton>Apply</guibutton> "
#~ "button."
#~ msgstr ""
#~ "ការ​ជំនួស​ត្រូវ​បាន​ដំណើរ​ការ​ដោយ​ដំណើរ​ការ Konqueror ដូច្នេះ​បើ​​មាន​ឯកសារ​រូបភាព​រួច​ហើយ អ្នក​នឹង​ត្រូវ​"
#~ "ជូន​ដំណឹង​ដោយ Konqueror បើ​អ្នក​ចង់​ជំនួស​វា ។ បើ​អ្នក​អះអាង រូបភាព​នឹង​ត្រូវ​បាន​ជំនួស អ្នក​នឹង "
#~ "<emphasis>មិន</emphasis> ចាំបាច់​ចុច​ប៊ូតុង <guibutton>អនុវត្ត</guibutton> ទេ ។"

#, fuzzy
#~| msgid ""
#~| "Automatic login comes in two flavors: <guilabel>truly automatic login</"
#~| "guilabel> acts like you would expect automatic login to, &ie; &kdm; will "
#~| "automatically login without expecting any input from the user. Enable "
#~| "this using the <guilabel>Truly automatic login</guilabel> option. If "
#~| "this option is not enabled, &kdm; will start normally, enabling you to "
#~| "login as any user, and will only perform automatic login if you kill the "
#~| "X server, &eg; by pressing <keycombo action=\"simul\">&Ctrl;&Alt;"
#~| "<keycap>Backspace</keycap></keycombo>."
#~ msgid ""
#~ "Automatic login comes in two flavors: <guilabel>truly automatic login</"
#~ "guilabel> acts like you would expect automatic login to, &ie; &kdm; will "
#~ "automatically login without expecting any input from the user. Enable "
#~ "this using the <guilabel>Truly automatic login</guilabel> option. If this "
#~ "option is not enabled, &kdm; will start normally, enabling you to login "
#~ "as any user, and will only perform automatic login if you kill the X "
#~ "server, &eg; by pressing <keycombo action=\"simul\">&Ctrl;&Alt;&Backspace;"
#~ "</keycombo>."
#~ msgstr ""
#~ "ចូល​ស្វ័យប្រវត្តិ​​មាន​​បែបបទ​ពីរ ៖ <guilabel>ចូល​ស្វ័យប្រវត្តិ​ពិត</guilabel> ធ្វើ​សកម្មភាព​ដូច​អ្វី​ដែល​"
#~ "អ្នក​រំពឹង​ចូល​ស្វ័យប្រវត្តិ​ធ្វើ មានន័យ​ថា KDMនឹង​ចូល​ដោយ​ស្វ័យប្រវត្តិ​ដោយ​មិន​រំពឹង​ព័ត៌មាន​បញ្ចូល​ណា​មួយ​ពី​អ្នក​"
#~ "ប្រើ ។ អាច​អនុញ្ញាត​វា​ដោយ​ប្រើ​ជម្រើស <guilabel>ចូល​ស្វ័យប្រវត្តិ​ពិត</guilabel> ។ បើ​មិន​"
#~ "អនុញ្ញាត​​ជម្រើស​នេះទេ KDM នឹង​ចាប់ផ្ដើម​ជា​ធម្មតា ដោយ​អនុញ្ញាត​ឲ្យ​អ្នក​ចូល​ជា​អ្នក​ប្រើ​ណា​មួយ ហើយ​នឹង​"
#~ "ដំណើរ​ការ​ចូល​ស្វ័យប្រវត្តិ បើ​អ្នក​បិទ​ម៉ាស៊ីន​បម្រើ X ឧទាហរណ៍ ដោយ​ចុច <keycombo action=\"simul"
#~ "\">បញ្ជា(Ctrl)ជំនួស(Alt)<keycap>លុប​ថយ​ក្រោយ</keycap></keycombo> ។"

#~ msgid ""
#~ "Below this option you will see a list of users for which a password is "
#~ "required, as well as a (by default, empty) list of users that do not need "
#~ "to provide a password. When <guilabel>Enable password-less logins</"
#~ "guilabel> is enabled, you can move users from one list into the other, by "
#~ "selecting them and then clicking the <guibutton>&gt;&gt;</guibutton> and "
#~ "<guibutton>&lt;&lt;</guibutton> buttons."
#~ msgstr ""
#~ "នៅ​ក្រោម​ជម្រើស​នេះ​អ្នក​នឹង​ឃើញ​បញ្ជី​អ្នក​ប្រើ​ដែល​ត្រូវ​ការ​ពាក្យ​សម្ងាត់ ព្រមទាំង​ (លំនាំ​ដើម គឺ​ទទេ) បញ្ជី​"
#~ "អ្នក​ប្រើ​ដែល​មិន​ត្រូវ​ការ​ឲ្យ​ផ្ដល់​ពាក្យ​សម្ងាត់ ។ នៅពេល​ដែល​បាន​អនុញ្ញាត <guilabel>អនុញ្ញាត​ការ​ចូល​"
#~ "ដោយ​គ្មាន​ពាក្យ​សម្ងាត់</guilabel> ​អ្នក​អាច​ផ្លាស់​ទី​អ្នក​ប្រើ​ពី​បញ្ជី​មួយ​ទៅ​បញ្ជី​មួយ​ទៀត ដោយ​ជ្រើស​ពួក​វា "
#~ "ហើយ​ចុច​ប៊ូតុង <guibutton>​>>​</guibutton> និង <guibutton>​>>​​</guibutton> ។"

#~ msgid ""
#~ "The <guilabel>Automatically login after X server crash</guilabel> option "
#~ "allows you to skip the authentication procedure when your X server "
#~ "accidentally crashed. <guilabel>Show previous user</guilabel> will show "
#~ "the name of the last login already entered into the login field in &kdm;. "
#~ "Some site administrators would consider even this a possible security "
#~ "weakness, because potential attackers then know at least one valid login."
#~ msgstr ""
#~ "ជម្រើស <guilabel>ចូលម្ដង​ទៀត​​ដោយ​ស្វ័យប្រវត្តិ​បន្ទាប់​ពី​ម៉ាស៊ីន​បម្រើ X គាំង</guilabel> អនុញ្ញាត​"
#~ "ឲ្យ​អ្នក​រំលង​បែបបទ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ពេល​ម៉ាស៊ីន​បម្រើ X របស់​អ្នក​គាំង​ដោយ​ប្រការ​ណាមួយ ។ "
#~ "<guilabel>បង្ហាញ​អ្នក​ប្រើ​មុន</guilabel> នឹង​បង្ហាញ​ឈ្មោះ​នៃ​ការ​ចូល​ចុងក្រោយ​ដែល​បាន​បញ្ចូល​រួច​ហើយ​"
#~ "ទៅ​ក្នុង​វាល​ចូល និង KDM ។ អ្នក​គ្រប់គ្រង​ប្រព័ន្ធមួយ​ចំនួន​គួរ​ពិចារណា​សូម្បី​តែ​ភាព​ទន់ខ្សោយ​សុវត្ថិភាព​ដែល​អាច​"
#~ "នេះ ពីព្រោះ​អ្នក​វាយ​ប្រហារ​ដែល​មាន​អនុភាព យ៉ាងហោច​ណាស់​ស្គាល់​ការ​ចូល​ត្រឹមត្រូវ​មួយ​ដែរ ។"
