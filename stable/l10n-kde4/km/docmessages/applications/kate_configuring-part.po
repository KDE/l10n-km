#, no-c-format
msgid "Text Cursor Movement"
msgstr "ការផ្លាស់ទី​ទស្សទ្រនិចអត្ថបទ​"

#. Tag: guilabel
#: configuring-part.docbook:568
#, no-c-format
msgid "Smart home and smart end"
msgstr ""

#. Tag: para
#: configuring-part.docbook:570
#, no-c-format
msgid ""
"When selected, pressing the home key will cause the cursor to skip white "
"space and go to the start of a line's text."
msgstr ""
"នៅ​ពេល​ដែល​បានជ្រើស ចុច​គ្រាប់ចុច​ផ្ទះ​វា​បណ្តាល​ឲ្យ​ទស្សទ្រនិចរំលង​ចន្លោះ​មិនឃើញ​ ហើយ​ត្រឡប់ទៅ​ចាប់ផ្តើម​"
"អត្ថបទ​របស់​បន្ទាត់​ ។​"

#. Tag: guilabel
#: configuring-part.docbook:575
#, fuzzy, no-c-format
#| msgid "Page Up/Page Down moves cursor"
msgid "PageUp/PageDown moves cursor"
msgstr "ផ្លាស់ទី​ទស្សទ្រនិច​ទៅលើ​ ឬ​ចុះក្រោយ​"

#. Tag: para
#: configuring-part.docbook:577
#, fuzzy, no-c-format
#| msgid ""
#| "This option changes the behavior of the cursor when the user presses the "
#| "<keycap>Page Up</keycap> or <keycap>Page Down</keycap> key. If unselected "
#| "the text cursor will maintain its relative position within the visible "
#| "text in &kate; as new text becomes visible as a result of the operation. "
#| "So if the cursor is in the middle of the visible text when the operation "
#| "occurs it will remain there (except when one reaches the beginning or "
#| "end.) With this option selected, the first key press will cause the "
#| "cursor to move to either the top or bottom of the visible text as a new "
#| "page of text is displayed."
msgid ""
"This option changes the behavior of the cursor when the user presses the "
"<keycap>Page Up</keycap> or <keycap>Page Down</keycap> key. If unselected "
"the text cursor will maintain its relative position within the visible text "
"in &kappname; as new text becomes visible as a result of the operation. So "
"if the cursor is in the middle of the visible text when the operation occurs "
"it will remain there (except when one reaches the beginning or end.) With "
"this option selected, the first key press will cause the cursor to move to "
"either the top or bottom of the visible text as a new page of text is "
"displayed."
msgstr ""
"ជម្រើស​នេះ​ផ្លាស់ប្តូរ​​ឥរិយាបទ​នៃ​ទស្សទ្រនិច​ ពេល​អ្នកប្រើ​ចុច​  គ្រាប់ចុច <keycap> ឡើងលើ​ </keycap> "
"ឬ <keycap> ចុះក្រោម​ </keycap> ។ បើ​ទស្សទ្រនិច​អត្ថបទ​មិនទាន់​បាន ជ្រើស​ វា​នឹង​ថែទាំ​ទីតាំង​ដែល​"
"ទាក់ទង​របស់​វាក្នុង​អត្ថបទ​ដែល​អាច​មើល​ឃើញក្នុង​ kate ជា​អត្ថបទ​ថ្មី​មួយ​ដែល​អាច​មើល ឃើញលទ្ធផល​នៃ​"
"ប្រត្តិបតិការណ៍​ ។ ដូច្នេះ​បើ​ទស្សទ្រនិច​នៅ​ពាក់កណ្តាល​នៃអត្ថបទ​ដែលអាច​មើល​ឃើញ​ ពេល​មាន​ប្រត្តិបតិការណ៍​"
"កើតឡើង​ វា​នឹង​មាននូវ​ទី​នោះ​(លើកលែង​តែ ពេល​មាន​ប្រត្តិបតិការណ៍​មួយ​បានចាប់ផ្តើម ឬ​បញ្ចប់ ។) ជាមួយ​ជម្រើស​"
"ដែល​បានជ្រើស ចុចលើ​​គ្រាប់ចុច ​ដំបូង​វា​ នឹងផ្លាស់ទី​ទស្សទ្រនិច​ទៅកាន់ចំណុច​កំពុង​ ឬ​បាត​នៃ​អត្ថបទ​ដែលអាច​មើល​ឃើញ​"
"ជា​ទំព័រ​នៃ​អត្ថបទ​ថ្មី​ត្រូវ​បាន​បង្ហាញ ។"

#. Tag: guilabel
#: configuring-part.docbook:588
#, no-c-format
msgid "Autocenter cursor (lines):"
msgstr "ទស្សន៍ទ្រនិច​នៅ​ចំកណ្តាល​ដោយ​ស្វ័យប្រវត្តិ​ ( បន្ទាត់​) ៖​"

#. Tag: para
#: configuring-part.docbook:590
#, no-c-format
msgid ""
