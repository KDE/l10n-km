msgstr "<screeninfo>ប្រអប់​<guilabel>បង្វិល​</guilabel> ស្រទាប់</screeninfo>"

#. Tag: phrase
#: commands-dialogs.docbook:545
#, no-c-format
msgid "<phrase>The <guilabel>Rotate Layer</guilabel> dialog</phrase>"
msgstr "<phrase>ប្រអប់​<guilabel>បង្វិល​</guilabel> ស្រទាប់</phrase>"

#. Tag: para
#: commands-dialogs.docbook:547
#, no-c-format
