#. Tag: guilabel
#: configuring.docbook:164
#, no-c-format
msgid "Behavior on Application Startup"
msgstr "ការរៀបចំ​ឥរិយាបទ​កម្មវិធី​"

#. Tag: para
#: configuring.docbook:166
#, no-c-format
msgid ""
"Select how you want &kate; to behave at startup. This setting can be "
"overridden by specifying what to do on the <link linkend=\"command-line-"
"options\">command line</link>."
msgstr ""
"ជ្រើស​របៀប​ដែលអ្នកចង់​ឲ្យ​ Kate ចាប់​ផ្តើម​ឡើង​។ T ការកំណត់​នេះ​អាច​ត្រូវ​បាន​បដិសេធ ​ ដោ​យ​បញ្ជាក់​អ្វី​ដែល​"
"អ្នកធ្វើ​ជាមួយ <link linkend=\"command-line-options\">បន្ទាត់​ពាក្យបញ្ជា​ </link> ។​"

#. Tag: guilabel
#: configuring.docbook:171
#, no-c-format
msgid "Start new session"
msgstr "ចាប់​ផ្តើម​សម័យ​ថ្មី "

#. Tag: para
#: configuring.docbook:172
#, fuzzy, no-c-format
#| msgid ""
#| "With this option, &kate; will start a new, unnamed session when you start "
#| "it."
msgid ""
"With this option, &kate; will start a new, unnamed session when you start "
"the application."
msgstr "ជា​មួយ​ជម្រើស​នេះ Kate នឹង​ចាប់​ផ្តើម​សម័យ​ថ្មី​ដែល​មិនទាន់​មាន​ឈ្មោះ​ពេល​ចាប់​ផ្តើមវា​ ។​"

#. Tag: guilabel
#: configuring.docbook:176
#, fuzzy, no-c-format
#| msgid "Load last used session"
msgid "Load last-used session"
msgstr "សម័យ​ត្រូវ​បាន​ប្រើ​ផ្ទុក​ចុង​ក្រោយ​"

#. Tag: para
#: configuring.docbook:177
#, no-c-format
msgid ""
"&kate; will use the most recently opened session at startup. This is good if "
"you want to use the same session always or switch rarely."
msgstr ""
"Kate ប្រើ​សម័យ​ដែល​បាន​បើក​មុន​គេ​បំផុត​ពេល​ចាប់​ផ្តើម​ ។ នេះជាការល្អ​ បើ​អ្នក​ចង់​ប្រើ​សម័យ​ដូចគ្នា​ជានិច្ច​ ឬ​"
"ប្តូរ​ម្តងម្កាល​។​"

#. Tag: guilabel
#: configuring.docbook:182
#, no-c-format
msgid "Manually choose a session"
msgstr "ជ្រើស​​សៀវភៅ​ដៃ​សម័យ​"

#. Tag: para
#: configuring.docbook:183
#, fuzzy, no-c-format
#| msgid ""
#| "&kate; will display a small dialog that lets you choose your preferred "
#| "session. This is the default behavior. Nice if you use a lot of different "
#| "sessions frequently."
msgid ""
