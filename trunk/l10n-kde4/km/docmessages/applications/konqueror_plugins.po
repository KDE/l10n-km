#. Tag: para
#: plugins.docbook:309
#, fuzzy, no-c-format
#| msgid ""
#| "In File Manager mode, you can select <menuchoice><guimenu>Tools</"
#| "guimenu><guisubmenu>Create Image Gallery</guisubmenu></menuchoice> to "
