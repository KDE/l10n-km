#. Tag: phrase
#: plugins.docbook:331 plugins.docbook:399 plugins.docbook:450
#, no-c-format
msgid "Screenshot"
msgstr "រូបថត​អេក្រង់"

#. Tag: guimenuitem
#: plugins.docbook:339
#, no-c-format
msgid "Page title"
