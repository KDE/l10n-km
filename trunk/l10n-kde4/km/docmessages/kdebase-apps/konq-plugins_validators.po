#. Tag: para
#: index.docbook:27
#, no-c-format
msgid ""
"The &konqueror; validator plugin checks your &CSS; and &HTML; documents for "
"conformance to W3C recommendations and other standards."
msgstr ""
"កម្មវិធី​ជំនួយ​កម្មវិធី​ធ្វើ​ឲ្យ​មាន​សុពលភាព Konqueror ពិនិត្យ​ឯកសារ CSS និង HTML របស់​អ្នក​សម្រាប់​អនុលោម​"
"ទៅ​តាម​អនុសាសន៍ និង​ស្តង់ដារ​ផ្សេង​ទៀត W3C ។"

#. Tag: keyword
#: index.docbook:32
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

