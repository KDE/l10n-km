#, no-c-format
msgid "kinfocenter"
msgstr "kinfocenter"

#. Tag: keyword
#: index.docbook:33
#, no-c-format
msgid "system"
msgstr "ប្រព័ន្ធ​"

#. Tag: keyword
#: index.docbook:34
#, no-c-format
