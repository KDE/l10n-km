#. Tag: para
#: index.docbook:27
#, no-c-format
msgid "This documentation describes &kde;'s information center."
msgstr "ឯកសារ​នេះ​ណែនាំ​ពី​មជ្ឈមណ្ឌល​ព័ត៌មាន​របស់ Kde ។"

#. Tag: keyword
#: index.docbook:31
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword> KDE </keyword>"

