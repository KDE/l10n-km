#. Tag: title
#: menus.docbook:3
#, no-c-format
msgid "Menu Entries"
msgstr "ធាតុ​ម៉ឺនុយ"

#. Tag: para
#: menus.docbook:5
#, no-c-format
msgid ""
"Each menu item is discussed below. When there is a keyboard shortcut that "
"performs a menu item function, the default shortcut is listed with the menu "
"item."
msgstr ""
"ធាតុ​ម៉ឺនុយ​នីមួយៗ​ត្រូវ​បាន​ពិភាក្សា​ខាងក្រោម ។ ពេល​មាន​ផ្លូវកាត់​ក្ដារ​ចុច​ដែល​ដំណើរ​ការ​មុខងារ​ធាតុ​ម៉ឺនុយ "
"ផ្លូវកាត់​លំនាំ​ដើម​ត្រូវ​បាន​រាយ​បញ្ជី​ជាមួយ​ធាតុ​ម៉ឺនុយ ។"

#. Tag: title
#: menus.docbook:8
#, no-c-format
msgid "The Contact List Window's Menus"
msgstr "ម៉ឺនុយ​របស់​បង្អួច​បញ្ជី​ទំនាក់ទំនង"

#. Tag: title
#: menus.docbook:10
#, no-c-format
msgid "<guimenu>File</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu>ឯកសារ</guimenu>"

#. Tag: menuchoice
#: menus.docbook:15
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Set Status</guisubmenu> "
"<guimenuitem>Online</guimenuitem>"
msgstr ""
"<guimenu>ឯកសារ</guimenu> <guisubmenu>កំណត់​ស្ថានភាព</guisubmenu> <guimenuitem>លើ​"
"បណ្ដាញ</guimenuitem>"

#. Tag: para
#: menus.docbook:22
#, no-c-format
msgid "Go online with all accounts"
msgstr "ឡើង​លើ​បណ្ដាញ​ជាមួយ​គណនី​ទាំងអស់"

#. Tag: menuchoice
#: menus.docbook:28
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Set Status</guisubmenu> "
"<guimenuitem>Away</guimenuitem>"
msgstr ""
"<guimenu>ឯកសារ</guimenu> <guisubmenu>កំណត់​ស្ថានភាព</guisubmenu> <guimenuitem>ចាក​"
"ឆ្ងាយ</guimenuitem>"

#. Tag: para
#: menus.docbook:35
#, no-c-format
msgid "Set all connected accounts away"
msgstr "កំណត់​គណនី​ដែល​បាន​ភ្ជាប់​ទាំងអស់​ចាក​ឆ្ងាយ"

#. Tag: menuchoice
#: menus.docbook:41
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Set Status</guisubmenu> "
"<guimenuitem>Offline</guimenuitem>"
msgstr ""
"<guimenu>ឯកសារ</guimenu> <guisubmenu>កំណត់​ស្ថានភាព</guisubmenu> <guimenuitem>ក្រៅ​"
"បណ្ដាញ</guimenuitem>"

#. Tag: para
#: menus.docbook:48
#, no-c-format
msgid "Set all accounts offline"
msgstr "កំណត់​គណនី​ទាំងអស់​ក្រៅ​បណ្ដាញ"

#. Tag: menuchoice
#: menus.docbook:54
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Add Contact...</guimenuitem>"
msgstr "<guimenu>ឯកសារ</guimenu> <guimenuitem>បន្ថែម​ទំនាក់ទំនង...</guimenuitem>"

#. Tag: para
#: menus.docbook:60
#, no-c-format
msgid ""
"This displays the Add Contact Wizard, which allows you to add a new contact "
"to your list"
msgstr "នេះ​បង្ហាញ​អ្នក​ជំនួយ​ការ​បន្ថែម​ទំនាក់ទំនង ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​បន្ថែម​ទំនាក់ទំនង​ថ្មី​ទៅ​បញ្ជី​របស់​អ្នក"

#. Tag: menuchoice
#: menus.docbook:66
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Create New Group...</guimenuitem>"
msgstr "<guimenu>ឯកសារ</guimenu> <guimenuitem>បង្កើត​ក្រុម​ថ្មី...</guimenuitem>"

#. Tag: para
#: menus.docbook:72
#, no-c-format
msgid "Prompts you for the new group's name and adds it to the contact list."
msgstr "ជូន​ដំណឹង​អ្នក​សម្រាប់​ឈ្មោះ​របស់​ក្រុម​ថ្មី និង​បន្ថែម​វា​ទៅ​បញ្ជី​ទំនាក់ទំនង ។"

#. Tag: menuchoice
#: menus.docbook:78
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu>ឯកសារ</guimenu> <guimenuitem>ចេញ</guimenuitem>"

#. Tag: para
#: menus.docbook:86
#, no-c-format
msgid ""
"Disconnects you from all &im; systems, closes all the windows and exits the "
"application."
msgstr "ផ្ដាច់​អ្នក​ពី​ប្រព័ន្ធ IM ទាំងអស់ បិទ​បង្អួច​ទាំងអស់ និង​ចេញ​ពី​កម្មវិធី ។"

#. Tag: title
#: menus.docbook:93 menus.docbook:500
#, no-c-format
msgid "<guimenu>Edit</guimenu> Menu"
msgstr "ម៉ឺនុយ <guimenu>កែ​សម្រួល</guimenu>"

#. Tag: menuchoice
#: menus.docbook:126
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Send Single Message...</guimenuitem>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guimenuitem>ផ្ញើ​សារ​តែ​មួយ...</guimenuitem>"

#. Tag: para
#: menus.docbook:132
#, no-c-format
msgid ""
"Opens an email-style message window with the selected contact, to send a "
"single message."
msgstr "បើក​បង្អួច​សារ​រចនាប័ទ្ម​អ៊ីមែល​ដែល​មាន​ទមនាក់ទំនង​ដែល​បាន​ជ្រើស ដើម្បី​ផ្ញើ​សារ​តែ​មួយ ។"

#. Tag: menuchoice
#: menus.docbook:138
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Start Chat...</guimenuitem>"
msgstr ""
"<guimenu>កែ​សម្រួល</guimenu> <guimenuitem>ចាប់ផ្ដើម​ជជែក​កំសាន្ត...</guimenuitem>"

#. Tag: para
#: menus.docbook:144
#, no-c-format
msgid "Opens a chat window with the selected contact, to have a conversation."
msgstr "បើក​បង្អួច​ជជែក​កំសាន្ត​ដែល​មាន​ទំនាក់ទំនង​ដែល​បាន​ជ្រើស ដើម្បី​សន្ទនា​ជាមួយ ។"

#. Tag: menuchoice
#: menus.docbook:150
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Send File...</guimenuitem>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guimenuitem>ផ្ញើ​ឯកសារ...</guimenuitem>"

#. Tag: para
#: menus.docbook:156
#, no-c-format
msgid ""
"If supported by the &im; system, this opens a file selector to choose a file "
"to send to the selected contact."
msgstr ""
"បើ​គាំទ្រ​ដោយ​ប្រព័ន្ធ IM នេះ​បើក​ឧបករណ៍​ជ្រើស​ឯកសារ​ដើម្បី​ជ្រើស​ឯកសារ​ផ្ញើ​ទៅ​ទំនាក់ទំនង​ដែល​បាន​ជ្រើស ។"

#. Tag: menuchoice
#: menus.docbook:162
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Move To</guisubmenu>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guisubmenu>ផ្លាស់ទី​ទៅ</guisubmenu>"

#. Tag: para
#: menus.docbook:168
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Choose another group from the sub-menu, "
"and the contact will move to that group."
msgstr ""
"(ត្រូវ​បាន​បើក​ពេល​ទំនាក់ទំនង​ត្រូវ​បាន​ជ្រើស) ជ្រើស​ក្រុម​មួយ​ផ្សេង​ទៀត​ពី​ម៉ឺនុយ​រង ហើយ​ទំនាក់ទំនង​នឹង​ផ្លាស់ទី​ទៅ​ក្រុម​"
"នោះ ។"

#. Tag: menuchoice
#: menus.docbook:174
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Copy To</guisubmenu>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guisubmenu>ចម្លង​ទៅ</guisubmenu>"

#. Tag: para
#: menus.docbook:180
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Choose a group from the sub-menu, and "
"the contact will be copied to group. &im; systems that allow contacts to be "
"in more than one group on the server contact list will be updated "
"accordingly."
msgstr ""
"(បានអនុញ្ញាត​ពេល​ទំនាក់ទំនង​ត្រូវ​បាន​ជ្រើស) ជ្រើស​ក្រុម​ពី​ម៉ឺនុយ​រង ហើយ​ទំនាក់ទំនង​នឹង​ចម្លង​ទៅ​ក្រុម ។ ប្រព័ន្ធ "
"IM ដែល​អនុញ្ញាត​ទំនាក់ទំនង​ចូល​ច្រើន​ជាង​ក្រុម​មួយ​នៅ​លើ​ម៉ាស៊ីន​បម្រើ បញ្ជី​ទំនាក់ទំនង​នឹង​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ទាន់​សម័យ​"
"យ៉ាង​ទៀតទាត់ ។"

#. Tag: menuchoice
#: menus.docbook:186
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Add Contact...</guisubmenu>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guisubmenu>បន្ថែម​ទំនាក់ទំនង...</guisubmenu>"

#. Tag: para
#: menus.docbook:192
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Choose another account from the "
"submenu, and you can add another way to message that person using that "
"account."
msgstr ""
"(បាន​អនុញ្ញាត​បើ​ទំនាក់ទំនង​ត្រូវ​បាន​ជ្រើស) ជ្រើស​គណនី​មួយ​ផ្សេង​ទៀត​ពី​ម៉ឺនុយ​រង ហើយ​អ្នក​អាច​បន្ថែម​វិធី​មួយ​ផ្សេង​"
"ទៀត​ដើម្បី​បញ្ជូន​សារ​មនុស្ស​នោះ​កំពុង​ប្រើ​គណនី​នោះ ។"

#. Tag: menuchoice
#: menus.docbook:198
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Add to Your Contact List...</"
"guimenuitem>"
msgstr ""
"<guimenu>កែ​សម្រួល</guimenu> <guimenuitem>បន្ថែម​ទៅ​បញ្ជី​ទំនាក់ទំនង​របស់​អ្នក...</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:204
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Sometimes people will message you who "
"aren't on your contact list already. In this case, &kopete; creates a "
"temporary entry for them, but to keep them on your contact list, use this "
"function."
msgstr ""
"(បាន​អនុញ្ញាត​ពេល​ទំនាក់ទំនង​ត្រូវ​បាន​ជ្រើស) ពេល​ខ្លះ​មនុស្ស​នឹង​ផ្ញើ​សារ​ទៅ​អ្នក ដែល​មិន​នៅ​ក្នុង​បញ្ជី​ទំនាក់ទំនង​"
"របស់​អ្នក ។ ក្នុង​ករណី​នេះ Kopete បង្កើត​ធាតុ​បណ្ដោះ​អាសន្ន​សម្រាប់​ពួក​គាត់ ប៉ុន្តែ​រក្សា​ពួក​គាត់​នៅ​លើ​បញ្ជី​"
"ទំនាក់ទំនង​របស់​អ្នក ប្រើ​មុខងារ​នេះ ។"

#. Tag: menuchoice
#: menus.docbook:210
#, fuzzy, no-c-format
#| msgid ""
#| "<shortcut><keycombo><keycap>Delete</keycap></keycombo> </shortcut> "
#| "<guimenu>Edit</guimenu> <guimenuitem>Remove</guimenuitem>"
msgid ""
"<shortcut><keycombo><keycap>Del</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Delete Contact</guimenuitem>"
msgstr ""
"<shortcut><keycombo><keycap>លុប</keycap></keycombo> </shortcut> <guimenu>កែ​"
"សម្រួល</guimenu> <guimenuitem>យក​ចេញ</guimenuitem>"

#. Tag: para
#: menus.docbook:218
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Removes a contact from the contact list "
"entirely."
msgstr "(បាន​អនុញ្ញាត​ពេល​ទំនាក់ទំនង​ត្រូវ​បាន​ជ្រើស) យក​ចេញ​ទំនាក់ទំនង​ពី​បញ្ជី​ទំនាក់ទំនង​ទាំងមូល ។"

#. Tag: menuchoice
#: menus.docbook:224
#, fuzzy, no-c-format
#| msgid ""
#| "<shortcut><keycombo><keycap>Delete</keycap></keycombo> </shortcut> "
#| "<guimenu>Edit</guimenu> <guimenuitem>Remove</guimenuitem>"
msgid ""
"<shortcut><keycombo><keycap>F2</keycap></keycombo></shortcut> <guimenu>Edit</"
"guimenu> <guimenuitem>Rename</guimenuitem>"
msgstr ""
"<shortcut><keycombo><keycap>លុប</keycap></keycombo> </shortcut> <guimenu>កែ​"
"សម្រួល</guimenu> <guimenuitem>យក​ចេញ</guimenuitem>"

#. Tag: para
#: menus.docbook:231
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Renames the contact on the contact "
"list. If you do this, the contact list entry will no longer change if the "
"contact changes their display name remotely. You can re-enable this using "
"the contact's Properties dialog."
msgstr ""
"(បាន​អនុញ្ញាត​ពេល​ទំនាក់ទំនង​ត្រូវ​បាន​ជ្រើស) ប្ដូរ​ឈ្មោះ​ទំនាក់ទំនង​លើ​បញ្ជី​ទំនាក់ទំនង ។ បើ​អ្នក​ធ្វើ​នេះ ធាតុ​"
"បញ្ជី​ទំនាក់ទំនង​នឹង​មិន​ផ្លាស់ប្ដូរ បើ​ទំនាក់ទំនង​ផ្លាស់ប្ដូរ​ឈ្មោះ​បង្ហាញ​របស់​ពួក​វា​ពី​ចម្ងាយ ។ អ្នក​អាច​បើក​នេះ​"
"ឡើង​វិញ​ដោយ​ប្រើ​ប្រអប់​លក្ខណៈ​សម្បត្តិ​របស់​ទំនាក់ទំនង ។"

#. Tag: menuchoice
#: menus.docbook:237
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Properties</guimenuitem>"
msgstr "<guimenu>កែ​សម្រួល</guimenu> <guimenuitem>លក្ខណៈ​សម្បត្តិ</guimenuitem>"

#. Tag: para
#: menus.docbook:243
#, no-c-format
msgid ""
"The Properties dialog lets you choose custom icons for the selected item, "
"and change its name."
msgstr ""
"ប្រអប់​លក្ខណៈ​សម្បត្តិ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​រូប​តំណាង​ផ្ទាល់​ខ្លួន​សម្រាប់​ធាតុ​ដែល​បាន​ជ្រើស និង​ផ្លាស់ប្ដូរ​ឈ្មោះ​របស់​"
"វា ។"

#. Tag: para
#: menus.docbook:244
#, no-c-format
msgid ""
