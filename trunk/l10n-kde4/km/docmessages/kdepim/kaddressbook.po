#. Tag: title
#: index.docbook:120
#, no-c-format
msgid "Configure Resources"
msgstr "កំណត់​រចនា​សម្ព័ន្ធ​ធនធាន"

#. Tag: para
#: index.docbook:121
#, fuzzy, no-c-format
#| msgid ""
#| "&kaddressbook; can use multiple resources for loading and storing its "
#| "contacts. After starting &kaddressbook; for the first time you will have "
#| "a default resource installed that saves all contacts in a vCard file "
#| "under $HOME/.kde/share/apps/kabc/std.vcf; you can add more resources by "
#| "using the Resource Configuration dialog, which is available in "
#| "<application>kcontrol</application> under <guilabel>KDE Components</"
#| "guilabel>-><guilabel>KDE Resources Configuration</guilabel>:"
msgid ""
"&kaddressbook; can use multiple resources for loading and storing its "
"contacts. After starting &kaddressbook; for the first time you will have a "
"default resource installed that saves all contacts in a vCard file under "
"<filename>$<envar>HOME</envar>/.kde/share/apps/kabc/std.vcf</filename>; you "
"can add more resources by using the <guilabel>Resource Configuration</"
"guilabel> dialog, which is available in the &systemsettings; under "
"<guilabel>Advanced</guilabel>-> <guilabel>&kde; Resources</guilabel>:"
msgstr ""
"&kaddressbook; អាចប្រើ​ធនធាន​ច្រើន​សម្រាប់​ការ​ផ្ទុក និង​ទុក​ទំនាក់ទំនង​របស់​វា ។ បន្ទាប់​ពី​ចាប់ផ្ដើម "
"&kaddressbook; សម្រាប់​ពេលវេលា​ដំបូង អ្នក​នឹង​បាន​ដំឡើង​ធនធាន​លំនាំដើម ដែល​រក្សាទុក​ទំនាក់ទំនង​ទាំងអស់​"
"នៅ​ក្នុង​ឯកសារ vCard នៅ​ក្រោម $HOME/.kde/share/apps/kabc/std.vcf ។ អ្នក​អាច​បន្ថែម​ធនធាន​"
"បន្ថែម​ដោយ​ប្រើ​ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ធនធាន ដែល​មាន​នៅ​ក្នុង <application>kcontrol</"
"application> ក្រោម <guilabel>សមាសភាគ KDE</guilabel>-><guilabel>ការ​កំណត់​រចនា​សម្ព័ន្ធ​"
"ធនធាន KDE</guilabel> ៖"

