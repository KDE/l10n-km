#: menus.docbook:709
#, fuzzy, no-c-format
#| msgid ""
#| "<shortcut><keycombo action=\"simul\">&Shift;<keycap>R</keycap></"
#| "keycombo></shortcut> <guimenu>Message</guimenu> <guimenuitem>Reply "
