msgstr ""

#. Tag: para
#: index.docbook:618
#, no-c-format
msgid ""
"Internet shops such as Magnatune, Jamendo and Last.fm. First configure your "
"Internet resources in:<menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure &amarok;</guimenuitem></menuchoice>"
msgstr ""

