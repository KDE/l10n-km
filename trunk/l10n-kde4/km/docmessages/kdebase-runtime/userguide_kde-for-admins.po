#, no-c-format
msgid "/opt/kde3/share/applications/kde/kword.desktop"
msgstr "/opt/kde3/share/applications/kde/kword.desktop"

#. Tag: title
#: kde-for-admins.docbook:1441
#, no-c-format
msgid "Stored Where?"
msgstr "រក្សា​ទុក​នៅ​កន្លែង​ណា ?"

#. Tag: para
#: kde-for-admins.docbook:1443
#, no-c-format
msgid ""
"<literal role=\"extension\">.menu</literal> files describing the menu "
"structure. The files are stored in <filename class=\"directory\">"
"$<envar>KDEDIR</envar>/etc/xdg/menus</filename> and <filename class="
"\"directory\">/etc/xdg/menus</filename>. These store the system-wide menu "
"structure and are controlled by $<envar>XDG_CONFIG_DIRS</envar>. <filename "
"class=\"directory\">$<envar>HOME</envar>/.config/menus</filename> stores "
"user-specific changes to the menu structure and is controlled by "
"$<envar>XDG_CONFIG_HOME</envar>. For more information, see <ulink url="
"\"http://www.freedesktop.org/Standards/basedir-spec\">http://www.freedesktop."
"org/Standards/basedir-spec</ulink>."
msgstr ""
"ឯកសារ <literal role=\"extension\">.menu</literal> ពណ៌នា​អំពី​រចនា​សម្ព័ន្ធ​ម៉ឺនុយ ។ ឯកសារ​"
"ត្រូវ​បាន​រក្សា​ទុក​ក្នុង <filename class=\"directory\">$<envar>KDEDIR</envar>/etc/xdg/"
"menus</filename> និង <filename class=\"directory\">/etc/xdg/menus</filename> "
"។ ទាំងនេះ​រក្សា​ទុក​រចនា​សម្ព័ន្ធ​ម៉ឺនុយ​ប្រព័ន្ធ​ទំលំ​ទូលាយ ហើយ​ត្រូវ​បាន​ត្រួត​ពិនិត្យ​ដោយ "
"$<envar>XDG_CONFIG_DIRS</envar> ។ <filename class=\"directory\">"
"$<envar>HOME</envar>/.config/menus</filename> រក្សា​ការ​ផ្លាស់ប្ដូរ​របស់​អ្នក​ប្រើ​ជាក់លាក់​ទៅ​"
"រចនា​សម្ព័ន្ធ​ម៉ឺនុយ និង​ត្រូវ​ពិនិត្យ​ដោយ $<envar>XDG_CONFIG_HOME</envar> ។ ចំពោះ​ព័ត៌មាន​បន្ថែម សូម​"
"មើល <ulink url=\"http://www.freedesktop.org/Standards/basedir-spec\">http://"
"www.freedesktop.org/Standards/basedir-spec</ulink> ។"

#. Tag: para
#: kde-for-admins.docbook:1454
#, no-c-format
msgid ""
"<literal role=\"extension\">.desktop</literal> files describe the "
"applications and are stored in: <filename class=\"directory\">"
"$<envar>KDEDIR</envar>/share/applications</filename>, <filename class="
"\"directory\">/usr/share/applications</filename>, <filename class=\"directory"
"\">/usr/local/share/applications</filename>. These are the system-wide "
"application <literal role=\"extension\">.desktop</literal> files which are "
"controlled by $<envar>XDG_DATA_DIRS</envar>."
msgstr ""
"ឯកសារ <literal role=\"extension\">.desktop</literal> ពណ៌នា​អំពី​កម្មវិធី និង​ត្រូវ​បាន​រក្សា​"
"ទុក​ក្នុង ៖ <filename class=\"directory\">$<envar>KDEDIR</envar>/share/"
"applications</filename> <filename class=\"directory\">/usr/share/"
"applications</filename> <filename class=\"directory\">/usr/local/share/"
"applications</filename> ។ ទាំងនេះ​គឺ​ជា​កម្មវិធី​ប្រព័ន្ធ​ទូលំ​ទូលាយ ដែល​ឯកសារ <literal role="
"\"extension\">.desktop</literal> ត្រូវ​បាន​ត្រួត​ពិនិត្យ​ដោយ $<envar>XDG_DATA_DIRS</"
"envar> ។"

#. Tag: para
#: kde-for-admins.docbook:1464
#, no-c-format
msgid ""
"<filename class=\"directory\">$<envar>HOME</envar>/.local/applications</"
"filename> contains user-specific <literal role=\"extension\">.desktop</"
"literal> files and user-specific changes. It is controlled by "
"$<envar>XDG_DATA_HOME</envar>. For more information, see <ulink url=\"http://"
"www.freedesktop.org/Standards/basedir-spec\">http://www.freedesktop.org/"
"Standards/basedir-spec</ulink>"
msgstr ""
"<filename class=\"directory\">$<envar>HOME</envar>/.local/applications</"
"filename> មាន​ឯកសារ​អ្នក​ប្រើ​ជាក់លាក់ <literal role=\"extension\">.desktop</"
"literal> និង​ការ​ផ្លាស់ប្ដូរ​អ្នក​ប្រើ​ជាក់លាក់ ។ វា​ត្រូវ​បាន​ត្រួត​ពិនិត្យ​ដោយ "
"$<envar>XDG_DATA_HOME</envar> ។ ចំពោះ​ព័ត៌មាន​បន្ថែម សូមមើល <ulink url=\"http://www."
"freedesktop.org/Standards/basedir-spec\">http://www.freedesktop.org/"
"Standards/basedir-spec</ulink>"

#. Tag: para
#: kde-for-admins.docbook:1472
#, no-c-format
msgid ""
"<literal role=\"extension\">.directory</literal> files describing the sub-"
"menus are stored in: <filename class=\"directory\">$<envar>KDEDIR</envar>/"
"share/desktop-directories</filename>, <filename class=\"directory\">/usr/"
"share/desktop-directories</filename>, <filename class=\"directory\">/usr/"
"local/share/desktop-directories</filename>. These are the system-wide menu "
"<literal role=\"extension\">.directory</literal> files, controlled by "
"$<envar>XDG_DATA_DIRS</envar>. The user-specific changes are stored in "
"<filename class=\"directory\">$<envar>HOME</envar>/.local/desktop-"
"directories</filename>. These are controlled by $<envar>XDG_DATA_HOME</"
"envar>. For more information, see <ulink url=\"http://www.freedesktop.org/"
"Standards/basedir-spec\">http://www.freedesktop.org/Standards/basedir-spec</"
"ulink>"
msgstr ""
"ឯកសារ <literal role=\"extension\">.directory</literal> ពណ៌នា​អំពី​ម៉ឺនុយ​រង​ដែល​បាន​រក្សា​"
"ទុក​ក្នុង ៖ <filename class=\"directory\">$<envar>KDEDIR</envar>/share/desktop-"
"directories</filename> <filename class=\"directory\">/usr/share/desktop-"
"directories</filename>, <filename class=\"directory\">/usr/local/share/"
"desktop-directories</filename> ។ នេះ​គឺ​ជា​ឯកសារ​ម៉ឺនុយ​ប្រព័ន្ធ​ទូលំទូលាយ <literal role="
"\"extension\">.directory</literal> ដែល​បាន​ត្រួតពិនិត្យ​ដោយ $<envar>XDG_DATA_DIRS</"
"envar> ។ ការ​ផ្លាស់ប្ដូរ​អ្នក​ប្រើ​ជាក់លាក់​គឺ​ត្រូវ​បាន​រក្សា​ទុក​ក្នុង <filename class=\"directory"
"\">$<envar>HOME</envar>/.local/desktop-directories</filename> ។ ទាំងនេះ​គឺ​ត្រូវ​បាន​"
"ត្រួតពិនិត្យ​ដោយ $<envar>XDG_DATA_HOME</envar> ។ ចំពោះ​ព័ត៌មាន​បន្ថែម សូម​មើល <ulink url="
"\"http://www.freedesktop.org/Standards/basedir-spec\">http://www.freedesktop."
"org/Standards/basedir-spec</ulink>"

#. Tag: programlisting
#: kde-for-admins.docbook:1485
#, no-c-format
msgid ""
"<markup>\n"
"             &lt;Menu&gt;\n"
"                        &lt;Name&gt;Art&lt;/Name&gt;\n"
"                        &lt;Directory&gt;suse-edutainment-art.directory&lt;/"
"Directory&gt;\n"
"                        &lt;Include&gt;\n"
"                                &lt;Category&gt;X-SuSE-Art&lt;/Category&gt;\n"
"                        &lt;/Include&gt;\n"
"                &lt;/Menu&gt;\n"
"</markup>"
msgstr ""
"<markup>\n"
"             &lt;Menu&gt;\n"
"                        &lt;Name&gt;Art&lt;/Name&gt;\n"
"                        &lt;Directory&gt;suse-edutainment-art.directory&lt;/"
"Directory&gt;\n"
"                        &lt;Include&gt;\n"
"                                &lt;Category&gt;X-SuSE-Art&lt;/Category&gt;\n"
"                        &lt;/Include&gt;\n"
"                &lt;/Menu&gt;\n"
"</markup>"

#. Tag: para
#: kde-for-admins.docbook:1488
#, no-c-format
msgid ""
"<literal>Art</literal> is the internal name for this menu. <filename>suse-"
"edutainment-art.directory</filename> defines the name and icon for this "
"menu, and the menu includes all applications that have <literal>X-SuSE-Art</"
"literal> listed as a category, &eg;:"
msgstr ""
"<literal>Art</literal> គឺ​ជា​ឈ្មោះ​ខាង​ក្នុង​សម្រាប់​ម៉ឺនុយ​នេះ ។ <filename>suse-edutainment-"
"art.directory</filename> កំណត់​ញឈ្មោះ និង​រូប​តំណាង​សម្រាប់​ម៉ឺនុយ​នេះ ហើយ​ម៉ឺនុយ​រួម​បញ្ចូល​កម្មវិធី​ទាំងអស់​"
"ដែលបាន​រាយ <literal>X-SuSE-Art</literal> ជា​ប្រភេទ ឧទាហរណ៍ ៖"

#. Tag: programlisting
#: kde-for-admins.docbook:1492
#, no-c-format
msgid "Categories=Qt;KDE;Education;X-SuSE-Art"
msgstr "Categories=Qt;KDE;Education;X-SuSE-Art"

#. Tag: para
#: kde-for-admins.docbook:1494
#, no-c-format
msgid ""
"<filename>suse-edutainment-art.directory</filename> defines the name and "
"icon for this menu:"
msgstr ""
"<filename>suse-edutainment-art.directory</filename> កំណត់​ឈ្មោះ និង​រូប​តំណាង​សម្រាប់​ម៉ឺនុយ​"
"នេះ ៖"

#. Tag: programlisting
#: kde-for-admins.docbook:1496
#, no-c-format
msgid ""
"[Desktop Entry]\n"
"Name=Art and Culture\n"
"Icon=kcmsystem"
msgstr ""
"[Desktop Entry]\n"
"Name=Art and Culture\n"
"Icon=kcmsystem"

#. Tag: title
#: kde-for-admins.docbook:1502
#, no-c-format
msgid "Common Pitfalls"
msgstr "Pitfall ទូទៅ"

#. Tag: para
#: kde-for-admins.docbook:1504
#, no-c-format
msgid ""
"Applications <emphasis>not</emphasis> in the menu do <emphasis>not</"
"emphasis> exist with regard to other applications or file associations: If "
"you remove an application from the menu, &kde; assumes you don't want to use "
"it."
msgstr ""
"កម្មវិធី​ដែល​<emphasis>មិន</emphasis>​នៅក្នុង​ម៉ឺនុយ​<emphasis>មិន</emphasis>មាន​ការ​ទាក់ទង​ជាមួយ​"
"នឹង​កម្មវីធិ​ផ្សេងទៀត ឬ​ទំនាក់ទំនង​ឯកសារ​ទេ ៖ ប្រសិន​បើ​អ្នក​យក​កម្មវិធី​ចេញ​ពី​ម៉ឺនុយ នោះ KDE នឹង​សន្មត​ថា​អ្នក​"
"មិន​ចង់​ប្រើ​វា​ទេ ។"

#. Tag: para
#: kde-for-admins.docbook:1508
#, no-c-format
msgid ""
"When applications are unwanted in the menu, either place them in <filename>."
"hidden</filename> menu or a dedicated menu with <programlisting>\n"
"NoDisplay=true\n"
"</programlisting> in the <literal role=\"extension\">.directory</literal> "
"file"
msgstr ""
"ពេល​ដែល​មិន​ចង់​ដាក់​កម្មវិធី​ដែល​នៅ​ក្នុង​ម៉ឺនុយ គឺ​អាច​ដាក់​​ពួក​វា​ក្នុង​ម៉ឺនុយ <filename>.hidden</filename> "
"ឬ​ម៉ឺនុយ​ដែល​បាន​បង្ហាញ ដោយ​ប្រើ <programlisting>\n"
"NoDisplay=true\n"
"</programlisting> នៅ​ក្នុង​ឯកសារ <literal role=\"extension\">.directory</literal>"

#. Tag: title
#: kde-for-admins.docbook:1515
#, no-c-format
msgid "Essential Menus"
msgstr "ម៉ឺនុយ​សំខាន់"

#. Tag: para
#: kde-for-admins.docbook:1517
#, no-c-format
msgid ""
"<filename class=\"directory\">$<envar>KDEDIR</envar>/etc/xdg/menus/"
"applications-merged/</filename> contains <filename>kde-essential.menu</"
"filename> which includes some essential menus that are normally not shown in "
"the &kde; menu itself:"
msgstr ""
"<filename class=\"directory\">$<envar>KDEDIR</envar>/etc/xdg/menus/"
"applications-merged/</filename> មាន <filename>kde-essential.menu</filename> "
"ដែល​រួម​បញ្ចូល​នូវ​ម៉ឺនុយ​សំខាន់​មួយចំនួន​ដែល​ជា​ធម្មតា​មិន​ត្រូវ​បាន​បង្ហាញ​ក្នុង​ម៉ឺនុយ KDE ដោយ​ខ្លួន​វា ៖"

#. Tag: para
#: kde-for-admins.docbook:1522
#, no-c-format
msgid ""
"Control Center has a hidden Settings menu whose contents are defined by "
"<filename>kde-settings.menu</filename> and whose icon and name are defined "
"by <filename>kde-settings.directory</filename>"
msgstr ""
"មជ្ឈមណ្ឌល​បញ្ជា​មាន​ម៉ឺនុយ​ការ​កំណត់​ដែល​បាន​លាក់ ដែល​មាតិកា​របស់​វា​ត្រូវ​បាន​កំណត់​ដោយ <filename>kde-"
"settings.menu</filename> ហើយ​រូប​តំណាង និង​ឈ្មោះ​របស់​វា​ត្រូវ​បាន​កំណត់​ដោយ <filename>kde-"
"settings.directory</filename>"

#. Tag: para
#: kde-for-admins.docbook:1526
#, no-c-format
msgid ""
"Info Center has a hidden Information menu whose contents are defined by "
"<filename>kde-information.menu</filename> and whose icon and name are "
"defined by <filename>kde-information.directory</filename>."
msgstr ""
"មជ្ឈមណ្ឌល​ព័ត៌មាន​មាន​ម៉ឺនុយ​ព័ត៌មាន​ដែល​លាក់ ដែល​មាតិកា​របស់​វា​ត្រូវ​បាន​កំណត់​ដោយ <filename>kde-"
"information.menu</filename> ហើយ​រូបតំណាង និង​ឈ្មោះ​ត្រូវ​បាន​កំណត់​ដោយ <filename>kde-"
"information.directory</filename> ។"

#. Tag: para
#: kde-for-admins.docbook:1531
#, no-c-format
msgid ""
"Screensavers contains a hidden System/Screensavers menu, whose contents are "
"defined by <filename>kde-screensavers.menu</filename> and whose icon and "
"name are defined by <filename>kde-system-screensavers.directory</filename>. "
"<filename>$<envar>KDEDIR</envar>/share/desktop-directories/kde-system-"
"screensavers.directory</filename> contains:"
msgstr ""
"ធាតុ​រក្សា​អេក្រង់​មាន​ម៉ឺនុយ​ប្រព័ន្ធ/ធាតុរក្សា​អេក្រង់​ដែល​បាន​លាក់ ដែល​មាតិកា​របស់​វា​ត្រូវ​បាន​កំណត់​ដោយ "
"<filename>kde-screensavers.menu</filename> ហើយ​រូប​តំណាង និង​ឈ្មោះ​របស់​វា​ត្រូវ​បាន​កំណត់​ដោយ "
"<filename>kde-system-screensavers.directory</filename> ។ <filename>"
"$<envar>KDEDIR</envar>/share/desktop-directories/kde-system-screensavers."
"directory</filename> មាន ៖"

#. Tag: programlisting
#: kde-for-admins.docbook:1538
#, no-c-format
msgid "NoDisplay=true"
msgstr "NoDisplay=true"

#. Tag: title
#: kde-for-admins.docbook:1545
#, no-c-format
msgid "Old-Style Menus"
msgstr "ម៉ឺនុយ​រចនាប័ទ្ម​ចាស់"

#. Tag: para
#: kde-for-admins.docbook:1547
#, no-c-format
msgid ""
"&kde; continues to support old-style menus that are defined by the directory "
"structures in <filename class=\"directory\">$<envar>KDEDIR</envar>/share/"
"applnk</filename> (system wide) and <filename class=\"directory\">"
"$<envar>HOME</envar>/.kde/share/applnk</filename> (user specific). This is "
"observed unless the <literal role=\"extension\">.desktop</literal> file has "
"a <varname>Categories</varname>= line. In that case the categories determine "
"the location in the menu."
msgstr ""
"KDE បន្ត​គាំទ្រ​ម៉ឺនុយ​រចនា​ប័ទ្ម​ចាស់​ដែល​បាន​កំណត់​ដោយ​រចនា​សម្ព័ន្ធ​ថត​​នៅក្នុង <filename class="
"\"directory\">$<envar>KDEDIR</envar>/share/applnk</filename> (ប្រព័ន្ធ​ទូលាយ) និង "
"<filename class=\"directory\">$<envar>HOME</envar>/.kde/share/applnk</"
"filename> (អ្នកប្រើ​ជាក់លាក់) ។ នេះ​ត្រូវ​បាន​អង្កេត ទាល់​តែ​ឯកសារ <literal role="
"\"extension\">.desktop</literal> មាន​បន្ទាត់ <varname>Categories</varname>= ។ "
"ក្នុង​ករណី​នោះ ​ប្រភេទ​កំណត់​ទីតាំង​ក្នុង​ម៉ឺនុយ ។"

#. Tag: application
#: kde-for-admins.docbook:1556
#, no-c-format
msgid "KSycoca"
msgstr "KSycoca"

#. Tag: para
#: kde-for-admins.docbook:1557
#, fuzzy, no-c-format
#| msgid ""
#| "<application>KSycoca</application> caches menu structure and information "
#| "about all available applications. You can rebuild the database with "
#| "<userinput><command>kbuildsycoca</command></userinput>. The database "
#| "which is built lives in <filename class=\"directory\">/var/tmp/kdecache-"
#| "${<envar>USER</envar>}/ksycoca</filename>. It is automatically updated by "
#| "<application>KDED</application>, checked during &kde; login, and "
#| "<application>KDED</application> watches for changes while logged in."
msgid ""
"<application>KSycoca</application> caches menu structure and information "
"about all available applications. You can rebuild the database with "
"<userinput><command>kbuildsycoca4</command></userinput>. The database which "
"is built lives in <filename class=\"directory\">/var/tmp/kdecache-"
"${<envar>USER</envar>}/ksycoca</filename>. It is automatically updated by "
"<application>KDED</application>, checked during &kde; login, and "
"<application>KDED</application> watches for changes while logged in."
msgstr ""
"<application>KSycoca</application> ដាក់​ឃ្លាំង​សម្ងាត់​រចនា​សម្ព័ន្ធ​ម៉ឺនុយ និង​ព័ត៌មាន​អំពី​កម្មវិធី​ដែល​"
"មាន​ទាំងអស់ ។ អ្នក​អាច​សង់​មូលដ្ឋាន​ទិន្នន័យ​ឡើងវិញ​ដោយ​ប្រើ <userinput><command>kbuildsycoca</"
"command></userinput> ។ មូលដ្ឋាន​ទិន្នន័យ​ដែល​បាន​ស្ថាបនា​ គឺ​នៅ​ក្នុង <filename class="
"\"directory\">/var/tmp/kdecache-${<envar>USER</envar>}/ksycoca</filename> ។ "
"វា​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ទាន់​សម័យ​ដោយ​​ស្វ័យប្រវត្តិ​ដោយ <application>KDED</application> ដែល​បាន​ពិនិត្យ​"
"នៅ​ក្នុង​កំឡុង​ពេល​ដែល KDE ចូល និង <application>KDED</application> ឃ្លាំ​មើល​សម្រាប់​ការ​"
"ផ្លាស់ប្ដូរ​ខណៈ​ពេល​ដែល​ចូល ។"

#. Tag: para
#: kde-for-admins.docbook:1567
#, no-c-format
msgid ""
"To disable watching for changes (since it may hurt over NFS) add the "
"following to <filename>kdedrc</filename>:"
msgstr ""
"ដើម្បី​បិទ​ការ​ឃ្លាំ​មើល​ការ​ផ្លាស់ប្ដូរ (ចាប់ពី​​វា​ប៉ះពាល់​ដល់ NFS) បន្ថែម​ទៅ <filename>kdedrc</"
"filename> ដូច​ខាងក្រោម ៖"

#. Tag: programlisting
#: kde-for-admins.docbook:1569
#, no-c-format
msgid ""
"[General]\n"
"CheckSycoca=false"
msgstr ""
"[General]\n"
"CheckSycoca=false"

#. Tag: para
#: kde-for-admins.docbook:1572
#, no-c-format
msgid ""
"To force regeneration, run <userinput><command>touch $<envar>KDEDIR</envar>/"
"share/services/update_ksycoca</command></userinput>."
msgstr ""
"ដើម្បី​បង្ខំ​ឲ្យ​បង្កើត​ឡើង​វិញ គឺ​ត្រូវរត់ <userinput><command>touch $<envar>KDEDIR</envar>/"
"share/services/update_ksycoca</command></userinput> ។"

#. Tag: title
#: kde-for-admins.docbook:1577
#, no-c-format
msgid "&kmenuedit;"
msgstr "KMenuEdit"

#. Tag: para
#: kde-for-admins.docbook:1579
#, no-c-format
msgid ""
"&kmenuedit; is aimed at a single user setup. Changes to menu structure are "
"saved to <filename>~/.config/menus/applications-kmenuedit.menu</filename>, "
"changes to applications are saved in <filename class=\"directory\">~/.local/"
"share/applications/</filename> and changes to sub-menus (icon, name) are "
"saved in <filename class=\"directory\">~/.local/share/desktop-directories/</"
"filename>. The KIOSK Admin Tool uses &kmenuedit; and copies the above "
"changes to profile- or system-wide locations."
msgstr ""
"KMenuEdit ត្រូវ​បាន​ដាក់​គោល​បំណង​ចំពោះ​ការ​រៀបចំ​អ្នក​ប្រើ​តែ​ម្នាក់ ។ ផ្លាស់ប្ដូរ​ទៅ​រចនា​សម្ព័ន្ធ​ម៉ឺនុយ​ដែល​"
"ត្រូវ​បាន​រក្សា​ទុក​ទៅ<filename>~/.config/menus/applications-kmenuedit.menu</"
"filename> ផ្លាស់ប្ដូរ​ទៅ​កម្មវិធី​ដែល​ត្រូវ​បាន​រក្សាទុក​ក្នុង <filename class=\"directory\">~/."
"local/share/applications/</filename> និង​ផ្លាស់ប្ដូរ​ទៅ​ម៉ឺនុយ​រង (រូប​តំណាង ឈ្មោះ) ដែលត្រូវ​បាន​"
"រក្សា​ទុក​ក្នុង <filename class=\"directory\">~/.local/share/desktop-directories/</"
"filename> ។ ឧបករណ៍​គ្រប់គ្រង KIOSK ប្រើ KMenuEdit និង​ចម្លង​ការ​ផ្លាស់ប្ដូរ​ខាងលើ​ទៅ​ទីតាំង​ទម្រង់ ឬ​"
"ប្រព័ន្ធ​ទូលំ​ទូលាយ ។"

#. Tag: title
#: kde-for-admins.docbook:1596
#, no-c-format
msgid "&kde; Panel"
msgstr "បន្ទះ KDE"

#. Tag: para
#: kde-for-admins.docbook:1598
#, no-c-format
msgid ""
"The &kde; panel is also known as &kicker;. It is modular and consists of the "
"following components:"
msgstr "បន្ទះ​របស់ KDE ត្រូវ​បាន​ស្គាល់​ថា​ជា Kicker ។ វា​គឺ​ជា​ម៉ូឌុល និង​មាន​សមាសភាគ​ខាងក្រោម ៖"

#. Tag: para
#: kde-for-admins.docbook:1601
#, no-c-format
msgid "Applets"
msgstr "អាប់ភ្លេត"

#. Tag: para
#: kde-for-admins.docbook:1602
#, no-c-format
msgid "Application buttons"
msgstr "ប៊ូតុង​កម្មវិធី"

#. Tag: para
#: kde-for-admins.docbook:1603
#, no-c-format
msgid "Special Buttons"
msgstr "ប៊ូតុង​ពិសេស"

#. Tag: para
#: kde-for-admins.docbook:1607
#, no-c-format
msgid ""
"By default, the panel contains the following applets: <itemizedlist> "
"<listitem><para>Pager - shows the virtual desktops</para></listitem> "
"<listitem><para>Taskbar</para></listitem> <listitem><para>System Tray</"
"para></listitem> <listitem><para>Clock</para></listitem> </itemizedlist> and "
"the following special buttons:"
msgstr ""
"តាម​លំនាំ​ដើម បន្ទះ​មាន​អាប់ភ្លេត​ដូច​ខាងក្រោម ៖ <itemizedlist> <listitem><para>ភេកយ័រ - "
"បង្ហាញ​ផ្ទៃតុ​និម្មិត</para></listitem> <listitem><para>របារ​ភារកិច្ច</para></listitem> "
"<listitem><para>ថាស​ប្រព័ន្ធ</para></listitem> <listitem><para>នាឡិកា</para></"
"listitem> </itemizedlist> និង​ប៊ូតុង​ពិសេស​​ដូច​ខាងក្រោម ៖"

#. Tag: para
#: kde-for-admins.docbook:1616
#, no-c-format
msgid "&kde; menu"
msgstr "ម៉ឺនុយ KDE"

#. Tag: para
#: kde-for-admins.docbook:1617
#, no-c-format
msgid "Desktop Button"
msgstr "ប៊ូតុង​ផ្ទៃតុ"

#. Tag: para
#: kde-for-admins.docbook:1621
#, no-c-format
msgid "Various application buttons are also added, space permitting:"
msgstr "ប៊ូតុង​កម្មវិធី​ផ្សេងៗ​ក៏​ត្រូវ​បាន​បន្ថែម​ផង​ដែរ ដោយ​ដាក់​ឲ្យ​មាន​ចន្លោះ ៖"

#. Tag: para
#: kde-for-admins.docbook:1623
#, no-c-format
msgid "Home Button"
msgstr "ប៊ូតុង​ផ្ទះ"

#. Tag: para
#: kde-for-admins.docbook:1624
#, no-c-format
msgid "Browser Button"
msgstr "ប៊ូតុង​កម្មវិធី​រុករក"

#. Tag: para
#: kde-for-admins.docbook:1625
#, no-c-format
msgid "KMail Button"
msgstr "ប៊ូតុង KMail"

#. Tag: title
#: kde-for-admins.docbook:1631
#, no-c-format
msgid "File Associations"
msgstr "ទំនាក់ទំនង​ឯកសារ"

#. Tag: para
#: kde-for-admins.docbook:1633
#, no-c-format
msgid ""
"File associations associate a file type with an application or applications. "
"The type of a file is established by determining its &MIME; type. &MIME; "
"types known by &kde; are stored in <filename class=\"directory\">"
"$<envar>KDEDIR</envar>/share/mimelnk</filename> and each application's "
"<literal role=\"extension\">.desktop</literal> file contains a list of "
"&MIME; types supported by that application."
msgstr ""
"ទំនាក់ទំនង​ឯកសារ​ទាក់ទង​នឹង​ប្រភេទ​ឯកសារ​ដែលមាន​កម្មវិធី​មួយ ឬ​ច្រើន ។ ប្រភេទ​នៃ​ឯកសារ​ត្រូវ​បាន​បង្កើត​ឡើង​"
"ដោយ​កំណត់​ប្រភេទ MIME របស់​វា ។ ប្រភេទ MIME ត្រូវ​បាន​ស្គាល់​ដោយ KDE ដែល​ត្រូវបាន​រក្សា​ទុក​ក្នុង "
"<filename class=\"directory\">$<envar>KDEDIR</envar>/share/mimelnk</"
"filename> ហើយ​​ឯកសារ <literal role=\"extension\">.desktop</literal> របស់​កម្មវិធី​"
"នីមួយៗ មាន​បញ្ជី​នៃ​ប្រភេទ MIME ដែល​បាន​គាំទ្រ​ដោយ​កម្មវិធី​នោះ ។"

#. Tag: para
#: kde-for-admins.docbook:1641
#, no-c-format
msgid "<filename>kview.desktop</filename>:"
msgstr "<filename>kview.desktop</filename> ៖"

#. Tag: programlisting
#: kde-for-admins.docbook:1642
#, no-c-format
msgid ""
"MimeType=image/gif;image/x-xpm;image/x-xbm;image/jpeg;\n"
"image/x-bmp;image/png;image/x-ico;image/x-portable-bitmap;\n"
"image/x-portable-pixmap;image/x-portable-greymap;\n"
"image/tiff;image/jp2"
msgstr ""
"MimeType=image/gif;image/x-xpm;image/x-xbm;image/jpeg;\n"
"image/x-bmp;image/png;image/x-ico;image/x-portable-bitmap;\n"
"image/x-portable-pixmap;image/x-portable-greymap;\n"
"image/tiff;image/jp2"

#. Tag: para
#: kde-for-admins.docbook:1645
#, no-c-format
msgid "<filename>kuickshow.desktop</filename>:"
msgstr "<filename>kuickshow.desktop</filename> ៖"

#. Tag: programlisting
#: kde-for-admins.docbook:1646
#, no-c-format
msgid ""
"MimeType=image/gif;image/x-xpm;image/x-xbm;image/jpeg;\n"
"image/png;image/tiff;image/x-bmp;image/x-psd;image/x-eim;\n"
"image/x-portable-bitmap;image/x-portable-pixmap;\n"
"image/x-portable-greymap"
msgstr ""
"MimeType=image/gif;image/x-xpm;image/x-xbm;image/jpeg;\n"
"image/png;image/tiff;image/x-bmp;image/x-psd;image/x-eim;\n"
"image/x-portable-bitmap;image/x-portable-pixmap;\n"
"image/x-portable-greymap"

#. Tag: para
#: kde-for-admins.docbook:1649
#, no-c-format
msgid ""
"Both can open image/gif Which one is used to open a <literal role=\"extension"
"\">.gif</literal> file?"
msgstr ""
"​ទាំងពីរ​គឺ​អាច​បើក image/gif តើ​មួយ​ណា​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​បើក​ឯកសារ <literal role="
"\"extension\">.gif</literal> ?"

#. Tag: para
#: kde-for-admins.docbook:1651
#, no-c-format
msgid ""
"The application with highest preference!. <filename>kview.desktop</filename> "
"contains <programlisting>\n"
"InitialPreference=3\n"
"</programlisting> whereas <filename>kuickshow.desktop</filename> contains "
"<programlisting>\n"
"InitialPreference=6\n"
"</programlisting> Therefore, &kuickshow; will be used to open <literal role="
"\"extension\">.gif</literal> files."
msgstr ""
"កម្មវិធី​ដែល​មាន​ចំណូល​ចិត្ត​ខ្ពស់​បំផុត ! <filename>kview.desktop</filename> មាន "
"<programlisting>\n"
"InitialPreference=3\n"
"</programlisting> ផ្ទុយ​ទៅ​វិញ <filename>kuickshow.desktop</filename> មាន "
"<programlisting>\n"
"InitialPreference=6\n"
"</programlisting> ហេតុ​ដូច្នេះ KuickShow នឹង​ត្រូវ​បាន​ប្រើ​ដើម្បី​បើក​ឯកសារ <literal role="
"\"extension\">.gif</literal> ។"

#. Tag: para
#: kde-for-admins.docbook:1660
#, no-c-format
msgid "How can we make &kview; default?"
msgstr "តើ​យើង​អាច​ធ្វើ​ឲ្យ KView ជាលំនាំ​ដើម​តាម​របៀប​ណា ?"

#. Tag: para
#: kde-for-admins.docbook:1662
#, no-c-format
msgid ""
"A user can change file association in the &kcontrolcenter;. These changes "
"are stored in <filename>$<envar>HOME</envar>/.kde/share/config/profilerc</"
"filename>. To use the same settings for multiple users, store these settings "
"in user profile directory or the global &kde; config directory to use as "
"default for multiple users."
msgstr ""
"អ្នក​ប្រើ​អាច​ផ្លាស់ប្ដូរ​ទំនាក់ទំនង​ឯកសារ​ក្នុង KControlCenter ។ ការ​ផ្លាស់ប្ដូរ​ទាំងនេះ​ត្រូវ​បាន​រក្សា​ទុក​"
"ក្នុង <filename>$<envar>HOME</envar>/.kde/share/config/profilerc</filename> ។ "
"ដើម្បី​ប្រើ​ការ​កំណត់​ដូចគ្នា​សម្រាប់​អ្នក​ប្រើច្រើន គឺ​ត្រូវ​រក្សា​ទុក​ការ​កំណត់​ទាំងនេះ​ក្នុង​ថត​ទម្រង់​អ្នក​ប្រើ ឬ​ថត​"
"កំណត់​រចនា​សម្ព័ន្ធ KDE សកល​ដើម្បី​ប្រើ​ជា​លំនាំ​ដើម​សម្រាប់​អ្នក​ប្រើ​ច្រើន ។"

#. Tag: title
#: kde-for-admins.docbook:1676
#, no-c-format
msgid "<title>Locking Down &kde;</title>"
msgstr "<title>ចាក់​សោ KDE</title>"

#. Tag: title
#: kde-for-admins.docbook:1679
#, no-c-format
msgid "How It Works - The Basics"
msgstr "របៀប​វា​ធ្វើការ - មូលដ្ឋាន"

#. Tag: para
#: kde-for-admins.docbook:1681
#, no-c-format
msgid "&kde;'s lock down features are centered around the following options:"
msgstr "លក្ខណៈពិសេស​​ការ​ចាក់សោ​​របស់ KDE ត្រូវ​បាន​ដាក់​កណ្ដាល​ក្បែរ​​ជម្រើស​ខាងក្រោម ៖"

#. Tag: link
#: kde-for-admins.docbook:1685
#, no-c-format
msgid "Make configuration options immutable"
msgstr "ធ្វើ​ឲ្យ​ជម្រើស​កំណត់​រចនា​សម្ព័ន្ធ​មិនប្រែប្រួល"

#. Tag: link
#: kde-for-admins.docbook:1687
#, no-c-format
msgid "Restriction of specific actions"
msgstr "ការ​ដាក់​កម្រិត​នៃ​សកម្មភាព​ជាក់លាក់"

#. Tag: link
#: kde-for-admins.docbook:1689
#, no-c-format
msgid "Restrict access to certain &URL;s"
msgstr "កំណត់​ការ​ចូល​ដំណើរ​ការ​ទៅ URL ជាក់លាក់"

#. Tag: link
#: kde-for-admins.docbook:1691
#, no-c-format
msgid "Restrict access to certain configuration modules"
msgstr "កំណត់​ការ​ចូល​ដំណើរការ​ទៅ​ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ​ជាក់លាក់"

#. Tag: title
#: kde-for-admins.docbook:1698
#, no-c-format
msgid "Immutable Configuration Options"
msgstr "ជម្រើស​ការ​កំណត់​រចនា​សម្ព័ន្ធ​មិន​អាច​កែប្រែ"

#. Tag: subtitle
#: kde-for-admins.docbook:1699
#, no-c-format
msgid "<subtitle>Locking Down &kde;</subtitle>"
msgstr "<subtitle>ចាក់​សោ KDE</subtitle>"

#. Tag: para
#: kde-for-admins.docbook:1701
#, no-c-format
msgid ""
"Immutable options allow system administrator to provide default settings "
"that can not be changed by the user."
msgstr ""
"ជម្រើស​មិន​អាច​កែប្រែ​អនុញ្ញាត​ឲ្យ​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​ផ្ដល់​ការ​កំណត់​លំនាំ​ដើម​ដែល​អ្នក​ប្រើ​មិន​អាច​ផ្លាស់​ប្ដូរ​បាន "
"។"

#. Tag: para
#: kde-for-admins.docbook:1704
#, no-c-format
msgid ""
"Pre-existing configuration options of the user will be ignored once a "
"configuration option is made immutable."
msgstr ""
"ជម្រើស​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ដែល​មាន​មុន​របស់​អ្នក​ប្រើ​នឹង​មិន​ត្រូវ​បាន​អើពើទេ ពេល​ជម្រើស​ការ​កំណត់​រចនា​សម្ព័ន្ធ​"
"ត្រូវ​បាន​ធ្វើ​ឲ្យ​មិន​អាច​កែប្រែបាន ។"

#. Tag: para
#: kde-for-admins.docbook:1707
#, no-c-format
msgid ""
"Options can be controlled either on a per entry basis, per group of entries "
"or on a file by file basis."
msgstr ""
"ជម្រើស​អាច​ត្រូវ​បាន​ត្រួត​ពិនិត្យ​នៅ​ក្នុង​មួយ​មូលដ្ឋាន​ធាតុ ក្នុង​មួយ​ក្រុម​នៃ​ធាតុ ឬ​នៅ​លើ​ឯកសារ​ដោយ​មូលដ្ឋាន​"
"ឯកសារ ។"

#. Tag: para
#: kde-for-admins.docbook:1710
#, no-c-format
msgid ""
"If a file or group is immutable, all configuration options for that file or "
"group are immutable, even those options for which the system administrator "
"has no default provided."
msgstr ""
"ប្រសិន​បើ​ឯកសារ ឬ​ក្រុម​មិន​អាច​កែប្រែ​បាន​នោះ ជម្រើស​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទាំងអស់​សម្រាប់​ឯកសារ ឬ​ក្រុម​នោះ​គឺ​"
"មិន​អាច​កែប្រែ​បានដែរ សូម្បី​ជម្រើស​ទាំងនោះ​សម្រាប់​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​មួយ​ណា​ដែល​មិន​បាន​ផ្ដល់​លំនាំ​ដើម​ក៏ដោយ ។"

#. Tag: para
#: kde-for-admins.docbook:1714
#, no-c-format
msgid ""
"The support in applications for immutable options may vary from application "
"to application. Although the user will not be able to make permanent changes "
"to immutable configuration options, the user may still be presented with an "
"user interface option to make such change."
msgstr ""
"ការ​គាំទ្រ​ក្នុង​កម្មវិធី​សម្រាប់​ជម្រើស​មិន​អាច​កែប្រែ អាច​ខុស​គ្នា​ពី​កម្មវិធី​មួយ​ទៅ​កម្មវិធី​មួយ​ទៀត ។ ទោះបីជា​អ្នក​"
"ប្រើ​នឹង​មិន​អាច​ធ្វើ​ការ​ផ្លាស់ប្ដូរ​ជា​អចិន្ត្រៃយ៍​ទៅជា​ជម្រើស​ការ​កំណត់​រចនា​សម្ព័ន្ធ​មិន​អាច​កែប្រែ​ក៏ដោយ អ្នក​ប្រើ​"
"គឺ​នៅតែ​ត្រូវ​បាន​បង្ហាញ​ជាមួយ​ជម្រើស​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ដើម្បី​ធ្វើ​ការ​ផ្លាស់ប្ដូរ​ដូច​នោះ ។"

#. Tag: title
#: kde-for-admins.docbook:1722
#, no-c-format
msgid "Action Restrictions"
msgstr "ការ​ដាក់កម្រិត​សកម្មភាព"

#. Tag: para
#: kde-for-admins.docbook:1724
#, no-c-format
msgid ""
"&kde; applications are built around the action-concept. Actions can be "
"activated in various ways, typically via the menu-bar, one of the toolbars "
"or a keyboard shortcut. <action>Save Document</action> is an example of an "
"action. If you know the internal action name it is possible to restrict an "
"action. When an action is restricted it will no longer appear in the menu-"
"bar or toolbar. The internal name for the <action>Save Document</action> "
"action is <option>action/file_save</option>. The lock down framework also "
"provides a set of more abstract restrictions which can be used to disable "
"functionality not covered by a single action. An example is the "
"<option>shell_access</option> restriction which disables all functionality "
"that would offer the user access to a &UNIX; shell."
msgstr ""
"កម្មវិធី KDE ត្រូវ​បាន​ស្ថាបនា​ឡើង​​ជុំវិញ​គំនិត​សកម្មភាព ។ សកម្មភាព​អាច​ត្រូវ​បាន​ធ្វើ​ឲ្យ​សកម្ម​តាម​វិធី​ផ្សេងៗ "
"ជា​ទូទៅ​គឺ​​តាម​រយៈ​របារ​ម៉ឺនុយ របារ​ឧបករណ៍​មួយ ឬ​ផ្លូវកាត់​ក្ដារ​ចុច​មួយ ។ <action>រក្សា​ទុក​ឯកសារ</"
"action> គឺ​ជា​ឧទាហរណ៍​អំពី​សកម្មភាព​មួយ ។ ប្រសិន​បើ​អ្នក​ស្គាល់​ឈ្មោះ​សកម្មភាព​ខាងក្នុង វា​អាច​ដាក់​កម្រិត​"
"សកម្មភាព​នោះ​បាន ។ នៅពេល​សកម្មភាព​ត្រូវ​បាន​ដាក់​កម្រិត វា​នឹង​មិន​លេចឡើង​ក្នុង​របារ​ម៉ឺនុយ ឬ​របារ​ឧបករណ៍​យូរ​"
"ទេ​។ ឈ្មោះ​ខាងក្នុង​សម្រាប់​សកម្មភាព <action>រក្សា​ទុក​ឯកសារ</action> គឺ <option>action/"
"file_save</option> ។ គ្រោងការណ៍​ចាក់សោ​ក៏​ផ្ដល់​ផង​ដែរ​នូវ​សំណុំ​នៃ​ការដាក់​កម្រិត​អរូបី​បន្ថែម ​ដែល​អាច​ត្រូវ​"
"បាន​ប្រើ​ដើម្បី​បិទ​មុខងារ​ដែល​មិន​បាន​គ្រប​ដណ្ដប់​ដោយ​សកម្មភាព​តែ​មួយ ។ ឧទាហរណ៍​ គឺ​ការ​កម្រិត "
"<option>shell_access</option> ដែល​បិទ​មុខងារ​ទាំងអស់​ដែល​ផ្ដល់​សិទ្ធិ​ចូល​ដំណើរការ​ទៅ​​សែល យូនីក​ចំពោះ​"
"អ្នក​ប្រើ ។"

#. Tag: title
#: kde-for-admins.docbook:1737
#, no-c-format
msgid "Restrict User Access to Shells"
msgstr "ដាក់​កម្រិត​សិទ្ធិ​អ្នក​ប្រើ​ចំពោះ​សែល"

#. Tag: para
#: kde-for-admins.docbook:1739
#, no-c-format
msgid ""
"In order to prevent the user access to a command shell we can restrict the "
"<option>shell_access</option> action by adding the following to "
"<filename>kdeglobals</filename>:"
msgstr ""
"ដើម្បី​ការពារ​សិទ្ធិ​ចូលដំណើរការ​អ្នក​ប្រើ​ទៅ​សែល​ពាក្យ​បញ្ជា យើង​អាច​ដាក់​កម្រិត​សកម្មភាព "
"<option>shell_access</option> ដោយ​បន្ថែម​ទៅ​កាន់ <filename>kdeglobals</filename> "
"នូវ ៖"

#. Tag: screen
#: kde-for-admins.docbook:1744
#, no-c-format
msgid ""
"[KDE Action Restrictions]\n"
"shell_access=false"
msgstr ""
"[KDE Action Restrictions]\n"
"shell_access=false"

#. Tag: para
#: kde-for-admins.docbook:1746
#, no-c-format
msgid ""
"Since this affects the &kde; menu and the available applications, we must "
"force an update of the sycoca database:"
msgstr ""
"ដោយសារ​វា​ប៉ះពាល់​ដល់​ម៉ឺនុយ KDE និង​កម្មវិធី​ដែល​មាន យើង​ត្រូវ​តែ​បង្ខំ​ភាព​ទាន់​សម័យ​នៃ​មូលដ្ឋាន​ទិន្នន័យ "
"sycoca ៖"

#. Tag: screen
#: kde-for-admins.docbook:1749
#, no-c-format
msgid ""
"<userinput><command>touch</command> <filename>$<envar>KDEDIR</envar>/share/"
"services/update_ksycoca</filename></userinput>"
msgstr ""
"<userinput><command>touch</command> <filename>$<envar>KDEDIR</envar>/share/"
"services/update_ksycoca</filename></userinput>"

#. Tag: para
#: kde-for-admins.docbook:1751
#, no-c-format
msgid "Now re-login to &kde; and check the following points:"
msgstr "ឥឡូវ ចូល KDE ម្ដងទៀត ហើយ​​ពិនិត្យ​ចំណុច​ដូច​ខាងក្រោម ៖"

#. Tag: para
#: kde-for-admins.docbook:1754
#, no-c-format
msgid "The &kmenu;"
msgstr "ម៉ឺនុយ K"

#. Tag: para
#: kde-for-admins.docbook:1755
#, no-c-format
msgid ""
"In &konqueror;, <menuchoice><guimenu>Tools</guimenu><guimenuitem>Open "
"Terminal</guimenuitem></menuchoice>"
msgstr ""
"នៅក្នុង Konqueror <menuchoice><guimenu>ឧបករណ៍</guimenu><guimenuitem>បើក​ស្ថានីយ</"
"guimenuitem></menuchoice>"

#. Tag: para
#: kde-for-admins.docbook:1758
#, no-c-format
msgid ""
"The <keycombo action=\"simul\">&Alt;<keycap>F2</keycap></keycombo> run "
"command"
msgstr ""
"<keycombo action=\"simul\"><keycap>ប្ដូរ(Alt)+F2</keycap></keycombo> រត់​ពាក្យ​បញ្ជា"

#. Tag: para
#: kde-for-admins.docbook:1763
#, no-c-format
msgid ""
"Full documentation about available actions can be found on <ulink url="
"\"http://www.kde.org/areas/sysadmin/\">http://www.kde.org/areas/sysadmin/</"
"ulink>."
msgstr ""
"ឯកសារ​ពេញលេញ​អំពី​សកម្មភាព​ដែល​មាន អាចរក​បាន​នៅ <ulink url=\"http://www.kde.org/areas/"
"sysadmin/\">http://www.kde.org/areas/sysadmin/</ulink> ។"

#. Tag: para
#: kde-for-admins.docbook:1766
#, no-c-format
msgid "A few of the more interesting actions are listed below:"
msgstr "សកម្មភាព​ដែល​ចាប់​អារម្មណ៍​បន្ថែម​មួយ​ចំនួន​ត្រូវ​បាន​រាយ​នៅ​ខាងក្រោម ៖"

#. Tag: option
#: kde-for-admins.docbook:1770
#, no-c-format
msgid "action/options_configure"
msgstr "action/options_configure"

#. Tag: para
#: kde-for-admins.docbook:1771
#, fuzzy, no-c-format
#| msgid ""
#| "The <guimenuitem>Configure</guimenuitem> option form the "
#| "<guimenu>Settings</guimenu> menu"
msgid ""
"The <guimenuitem>Configure</guimenuitem> option from the <guimenu>Settings</"
"guimenu> menu"
msgstr ""
"ជម្រើស <guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ</guimenuitem> ពី​ម៉ឺនុយ <guimenu>ការ​កំណត់</guimenu>"

#. Tag: option
#: kde-for-admins.docbook:1775
#, no-c-format
msgid "action/help_report_bug"
msgstr "action/help_report_bug"

#. Tag: para
#: kde-for-admins.docbook:1776
#, no-c-format
msgid ""
"The <guimenuitem>Report Bug</guimenuitem> option from the <guimenu>Help</"
"guimenu> menu."
msgstr ""
"ជម្រើស <guimenuitem>រាយការណ៍​កំហុស</guimenuitem> ពី​ម៉ឺនុយ <guimenu>ជំនួយ</guimenu> ។"

#. Tag: option
#: kde-for-admins.docbook:1780
#, no-c-format
msgid "action/kdesktop_rmb"
msgstr "action/kdesktop_rmb"

#. Tag: para
#: kde-for-admins.docbook:1781
#, no-c-format
msgid "&RMB; mouse button menu on the desktop."
msgstr "ម៉ឺនុយ​ប៊ូតុង​កណ្ដុរ​ខាងស្ដាំ​នៅលើ​ផ្ទៃតុ ។"

#. Tag: option
#: kde-for-admins.docbook:1784
#, no-c-format
msgid "action/kicker_rmb"
msgstr "action/kicker_rmb"

#. Tag: para
#: kde-for-admins.docbook:1785
#, no-c-format
msgid "&RMB; mouse button menu on the panel."
msgstr "ម៉ឺនុយ​ប៊ូតុង​កណ្ដុរ​ខាង​ស្ដាំ​លើ​បន្ទះ ។"

#. Tag: option
#: kde-for-admins.docbook:1788
#, no-c-format
msgid "user/root"
msgstr "user/root"

#. Tag: para
#: kde-for-admins.docbook:1789
#, no-c-format
msgid ""
"Hide all actions or applications that require <systemitem class=\"username"
"\">root</systemitem> access."
msgstr ""
"លាក់​សកម្មភាព ឬ​កម្មវិធី​ទាំងអស់​ដែល​ទាមទារ​សិទ្ធិ​ជា <systemitem class=\"username\">root</"
"systemitem> ។"

#. Tag: option
#: kde-for-admins.docbook:1793
#, no-c-format
msgid "shell_access"
msgstr "shell_access"

#. Tag: para
#: kde-for-admins.docbook:1794
#, no-c-format
msgid "Hides all actions or applications that provide shell access."
msgstr "លាក់​រាល់​សកម្មភាព ឬ​កម្មវិធី​ទាំងអស់​ដែល​ផ្ដល់​សិទ្ធិ​ចូលដំណើរការ​សែល ។"

#. Tag: option
#: kde-for-admins.docbook:1798
#, no-c-format
msgid "print/system"
msgstr "print/system"

#. Tag: para
#: kde-for-admins.docbook:1799
#, no-c-format
msgid "Disables the option to select the printing system (backend)."
msgstr "បិទ​ជម្រើស​ដើម្បី​ជ្រើស​ប្រព័ន្ធ​ដែល​បោះពុម្ព (ផ្ទៃខាង​ក្រោយ) ។"

#. Tag: option
#: kde-for-admins.docbook:1803
#, no-c-format
msgid "lock_screen"
msgstr "lock_screen"

#. Tag: para
#: kde-for-admins.docbook:1804
#, no-c-format
msgid "Whether the user will be able to lock the screen"
msgstr "ថា​តើ​អ្នក​ប្រើ​នឹង​អាច​ចាក់​សោ​អេក្រង់​ឬអត់"

#. Tag: option
#: kde-for-admins.docbook:1808
#, no-c-format
msgid "start_new_session"
msgstr "start_new_session"

#. Tag: para
#: kde-for-admins.docbook:1809
#, no-c-format
msgid "Whether the user may start a second X session (see also &kdm;)"
msgstr "ថា​តើ​អ្នក​ប្រើ​អាច​ចាប់ផ្ដើម​សម័យ X ទីពីរ (មើល kdm ផង​ដែរ) ឬអត់"

#. Tag: option
#: kde-for-admins.docbook:1813
#, no-c-format
msgid "opengl_screensavers"
msgstr "opengl_screensavers"

#. Tag: para
#: kde-for-admins.docbook:1814
#, no-c-format
msgid "Whether OpenGL screensavers are allowed to be used."
msgstr "ថា​តើ​ធាតុ​រក្សា​អេក្រង់ OpenGL ត្រូវ​បាន​អនុញ្ញាត​ឲ្យ​ប្រើ​ឬអត់ ។"

#. Tag: option
#: kde-for-admins.docbook:1818
#, no-c-format
msgid "manipulatescreen_screensavers"
msgstr "manipulatescreen_screensavers"

#. Tag: para
#: kde-for-admins.docbook:1819
#, no-c-format
msgid "Permit screensavers that do not hide the entire screen"
msgstr "អនុញ្ញាត​ធាតុ​រក្សា​អេក្រង់​ដែល​មិន​លាក់​អេក្រង់​ទាំងមូល"

#. Tag: title
#: kde-for-admins.docbook:1827
#, no-c-format
msgid "&URL; Restrictions"
msgstr "ការ​ដាក់កម្រិត URL"

#. Tag: para
#: kde-for-admins.docbook:1829
#, no-c-format
msgid "There are three types of restrictions that can be applied to &URL;s:"
msgstr "មាន​ប្រភេទនៃ​ការដាក់​កម្រិត បី ​ដែល​អាច​ត្រូវ​បាន​អនុវត្ត​ទៅ URL ៖"

#. Tag: term
#: kde-for-admins.docbook:1834
#, no-c-format
msgid "list"
msgstr "រាយ"

#. Tag: para
#: kde-for-admins.docbook:1835
#, no-c-format
msgid "To control whether a directory listing is allowed."
msgstr "ដើម្បី​ត្រួត​ពិនិត្យ​ថា​តើ​ថត​ដែល​រាយ​ត្រូវ​បាន​អនុញ្ញាត​ឬអត់ ។"

#. Tag: term
#: kde-for-admins.docbook:1839
#, no-c-format
msgid "open"
msgstr "បើក"

#. Tag: para
#: kde-for-admins.docbook:1840
#, no-c-format
msgid "To control whether certain &URL;s can be opened"
msgstr "ដើម្បី​ត្រួត​ពិនិត្យ​ថា​តើ URL ជាក់លាក់​អាច​ត្រូវ​បាន​បើក​ឬអត់"

#. Tag: term
#: kde-for-admins.docbook:1844
#, no-c-format
msgid "Redirect"
msgstr "ប្ដូរ​ទិស"

#. Tag: para
#: kde-for-admins.docbook:1845
#, no-c-format
msgid ""
"To control whether one &URL; can open another &URL;, either automatically or "
"via a hyperlink."
msgstr "ដើម្បី​ត្រួត​ពិនិត្យ​ថា​តើ URL មួយ​អាច​បើក​ URL មួយ​ផ្សេង​ទៀត ដោយ​ស្វ័យប្រវត្តិ ឬ​តាម​រយៈ​តំណ​ខ្ពស់ ។"

#. Tag: para
#: kde-for-admins.docbook:1850
#, no-c-format
msgid ""
"Rules are checked in the order in which they are defined. The last rule that "
"is applicable to a &URL; defines whether the &URL; may be accessed."
msgstr ""
"ច្បាប់​ត្រូវ​បាន​ពិនិត្យ​នៅ​ក្នុង​លំដាប់​ដែល​ពួក​វា​ត្រូវ​បាន​កំណត់ ។ ច្បាប់​ចុងក្រោយ​ដែល​អាច​អនុវត្ត​ទៅ URL កំណត់​ថា​តើ​"
"អាចចូល​ដំណើរការ URL បាន​ឬអត់ ។"

#. Tag: para
#: kde-for-admins.docbook:1854
#, no-c-format
msgid ""
"The following rules disable opening http and https &URL;s outside "
"<systemitem class=\"domainname\">.ourcompany.com</systemitem>:"
msgstr ""
"ច្បាប់​ខាងក្រោម​មិន​អនុញ្ញាត​ការ​បើក http និង https URL ខាងក្រៅ <systemitem class="
"\"domainname\">.ourcompany.com</systemitem> ៖"

#. Tag: screen
#: kde-for-admins.docbook:1862
#, no-c-format
msgid ""
"[KDE URL Restrictions]\n"
"rule_count=2\n"
"rule_1=open,,,,http,,,false\n"
"rule_2=open,,,,http,*.ourcompany.com,,true"
msgstr ""
"[KDE URL Restrictions]\n"
"rule_count=2\n"
"rule_1=open,,,,http,,,false\n"
"rule_2=open,,,,http,*.ourcompany.com,,true"

#. Tag: para
#: kde-for-admins.docbook:1866
#, no-c-format
msgid ""
"The first four commas skip over the selection criteria with respect to the "
"originating &URL;. This part is only needed with redirect type rules."
msgstr ""
"សញ្ញា​ក្បៀស​បួន​ដំបូង​រំលង​ការ​វិភាគ​លក្ខណៈ​វិនិច្ឆ័យ​ជម្រើស​ដោយ​គោរព​តាម​ការបង្កើត URL ។ ផ្នែក​នេះ​ត្រូវការ​"
"ជាមួយ​ច្បាប់​ប្រភេទ​ប្ដូរ​ទិស​ ។"

#. Tag: para
#: kde-for-admins.docbook:1870
#, no-c-format
msgid "<option>rule_1</option> forbids the opening of any http or https &URL;"
msgstr "<option>rule_1</option> ហាម​ឃាត់​ការ​បើក​ http ឬ https URL ណា​មួយ"

#. Tag: para
#: kde-for-admins.docbook:1872
#, no-c-format
msgid ""
"<option>rule_2</option> allows the opening of any http and https &URL; in "
"the <systemitem class=\"domainname\">.ourcompany.com</systemitem> domain. "
"Note the wildcard <token>*</token> is only allowed at the start of a domain."
msgstr ""
"<option>rule_2</option> អនុញ្ញាត​ការ​បើក​នៃ http និង http URL មួយ​ចំនួន​ក្នុង​ដែន "
"<systemitem class=\"domainname\">.ourcompany.com</systemitem> ។ ចំណាំ​តួ​អក្សរ​ជំនួស "
"<token>*</token> គឺ​ត្រូវ​បាន​អនុញ្ញាត​តែ​នៅ​ពេល​ចាប់​ផ្ដើម​នៃ​ដែន​ប៉ុណ្ណោះ ។"

#. Tag: para
#: kde-for-admins.docbook:1878
#, no-c-format
msgid ""
"The following rules makes that the user can no longer browse directories on "
"the local file system that are outside his $<envar>HOME</envar> directory:"
msgstr ""
"ច្បាប់​ខាងក្រោម​ធ្វើ​ឲ្យ​អ្នក​ប្រើ​មិន​អាច​រក​មើល​ថត​នៅ​លើ​ប្រព័ន្ធ​ឯកសារ​មូលដ្ឋាន​ដែល​នៅ​ក្រៅ​ថត "
"$<envar>HOME</envar> របស់​គាត់ ៖"

#. Tag: screen
#: kde-for-admins.docbook:1886
#, no-c-format
msgid ""
"[KDE URL Restrictions]\n"
"rule_count=2\n"
"rule_1=list,,,,file,,,false\n"
"rule_2=list,,,,file,,$HOME,true"
msgstr ""
"[KDE URL Restrictions]\n"
"rule_count=2\n"
"rule_1=list,,,,file,,,false\n"
"rule_2=list,,,,file,,$HOME,true"

#. Tag: para
#: kde-for-admins.docbook:1889
#, no-c-format
msgid "<option>rule_1</option> forbids the listing of any local directory"
msgstr "<option>rule_1</option> ហាម​ឃាត់​ការរាយ​​ថត​មូលដ្ឋាន​ណាមួយ"

#. Tag: para
#: kde-for-admins.docbook:1891
#, no-c-format
msgid ""
"<option>rule_2</option> allows listing directories under the users own "
"$<envar>HOME</envar> directory."
msgstr ""
"<option>rule_2</option> អនុញ្ញាត​ការ​រាយ​ថត​​នៅ​ក្រោម​ថត $<envar>HOME</envar> ផ្ទាល់ខ្លួន​"
"របស់អ្នក​ប្រើ ។"

#. Tag: para
#: kde-for-admins.docbook:1896
#, no-c-format
msgid ""
"$<envar>HOME</envar> and $<envar>TMP</envar> are special values to indicate "
"the users home directory and the &kde; temporary directory of the user, &eg; "
"<filename class=\"directory\">/tmp/kde-bastian</filename>"
msgstr ""
"$<envar>HOME</envar> និង $<envar>TMP</envar> គឺជា​តម្លៃ​ពិសេស​ដែលត្រូវ​ចង្អុល​ថត​ផ្ទះ​របស់​អ្នក​"
"ប្រើ និង​ថត​បណ្ដោះ​អាសន្ន KDE របស់​អ្នក​ប្រើ ឧ. <filename class=\"directory\">/tmp/kde-"
"bastian</filename>"

#. Tag: para
#: kde-for-admins.docbook:1900
#, no-c-format
msgid ""
"The following rules makes that the user can no longer open local files that "
"are outside his $<envar>HOME</envar> directory:"
msgstr ""
"ច្បាប់​ខាងក្រោម​ធ្វើ​ឲ្យ​អ្នក​ប្រើ​មិន​អាច​បើក​ឯកសារ​មូលដ្ឋាន​ដែល​នៅ​ខាងក្រៅ​ថត $<envar>HOME</envar> "
"របស់​គាត់ ៖"

#. Tag: screen
#: kde-for-admins.docbook:1908
#, no-c-format
msgid ""
"[KDE URL Restrictions]\n"
"rule_count=3\n"
"rule_1=open,,,,file,,,false\n"
"rule_2=open,,,,file,,$HOME,true\n"
"rule_3=open,,,,file,,$TMP,true"
msgstr ""
"[KDE URL Restrictions]\n"
"rule_count=3\n"
"rule_1=open,,,,file,,,false\n"
"rule_2=open,,,,file,,$HOME,true\n"
"rule_3=open,,,,file,,$TMP,true"

#. Tag: para
#: kde-for-admins.docbook:1911
#, no-c-format
msgid "<option>rule_1</option> forbids the opening of any local file"
msgstr "<option>rule_1</option> ហាមឃាត់​ការ​បើក​នៃ​ឯកសារ​មូលដ្ឋាន​ណាមួយ"

#. Tag: para
#: kde-for-admins.docbook:1913
#, no-c-format
msgid ""
"<option>rule_2</option> allows opening files under the users own "
"$<envar>HOME</envar> directory."
msgstr ""
"<option>rule_2</option> អនុញ្ញាត​ដល់​ការ​បើក​ឯកសារ​នៅ​ពី​ក្រោម​ថត $<envar>HOME</envar> "
"ផ្ទាល់​ខ្លួន​របស់​អ្នក​ប្រើ ។"

#. Tag: para
#: kde-for-admins.docbook:1915
#, no-c-format
msgid ""
"<option>rule_3</option> allows opening files in the &kde; temporary "
"directory of the user. This is needed by certain &kde; applications that "
"first download a file or document to the temporary directory and then open "
"it in an application."
msgstr ""
"<option>rule_3</option> អនុញ្ញាត​ដល់​ការ​បើក​ឯកសារ​ក្នុង​ថត​បណ្ដោះ​អាសន្ន KDE របស់​អ្នក​ប្រើ ។ វា​"
"ត្រូវ​ការ​ដោយ​កម្មវិធី KDE ជាក់លាក់​ដែល​ដំបូង​គឺ​ទាញ​យក​ឯកសារ​ទៅ​ថត​បណ្ដោះ​អាសន្ន​ជាមុន ហើយ​បន្ទាប់មក​បើក​វា​"
"ក្នុង​កម្មវិធី ។"

#. Tag: para
#: kde-for-admins.docbook:1922
#, no-c-format
msgid ""
"The redirection option controls whether documents from a certain location "
"can refer, either automatically or manually via a hyperlink, to a certain "
"other location. A set of default rules is present as a general security "
"measure. For example documents located on the Internet may not refer to "
"locally stored documents."
msgstr ""
"ជម្រើស​ការ​ប្ដូរ​ទិសដៅ​ត្រួត​ពិនិត្យ​ថា​តើ​ឯកសារ​ពី​ទីតាំង​ជាក់លាក់​អាច​យោង​ទៅ​ទីតាំង​ផ្សេង​ទៀត​ជាក់លាក់​ដោយ​"
"ស្វ័យប្រវត្តិ ឬ​ដោយ​ដៃ​តាម​រយៈ​តំណ​ខ្ពស់  ។ សំណុំ​​​ច្បាប់​លំនាំ​ដើម​ត្រូវ​បាន​បង្ហាញ​ជា​រង្វាស់​សុវត្ថិភាព​ទូទៅ ។ "
"ឧទាហរណ៍​ ឯកសារ​ដែល​បាន​ដាក់​នៅ​លើ​អ៊ីនធឺណិត​មិន​អាច​យោង​ទៅ​ឯកសារ​ដែល​រក្សា​ទុក​ជា​មូលដ្ឋាន​ទេ ។"

#. Tag: para
#: kde-for-admins.docbook:1928
#, no-c-format
msgid ""
"For example, if we want to give the intranet-server <systemitem class="
"\"systemname\">www.mycompany.com</systemitem> the possibility to refer to "
"local files we could add the following rule:"
msgstr ""
"ឧទាហរណ៍ ប្រសិន​បើ​យើង​ចង់​ផ្ដល់​ម៉ាស៊ីន​បម្រើ​អ៊ីនធឺណិត​នូវ​លទ្ធភាព <systemitem class=\"systemname"
"\">www.mycompany.com</systemitem> ដើម្បី​យោង​ទៅ​ឯកសារ​មូលដ្ឋាន​ដែល​យើង​អាច​បន្ថែម​ច្បាប់​ដូច​"
"ខាងក្រោម ៖"

#. Tag: screen
#: kde-for-admins.docbook:1932
#, no-c-format
msgid ""
"[KDE URL Restrictions]\n"
"rule_count=1\n"
"rule_1=redirect,http,www.mycompany.com,,file,,,true"
msgstr ""
"[KDE URL Restrictions]\n"
"rule_count=1\n"
"rule_1=redirect,http,www.mycompany.com,,file,,,true"

#. Tag: para
#: kde-for-admins.docbook:1934
#, no-c-format
msgid ""
"Instead of listing a protocol by name, it is also possible to specify a "
"whole group of protocols. For that the following groups have been defined:"
msgstr ""
"ជំនួស​ឲ្យ​ការ​រាយ​ពិធីការ​តាម​ឈ្មោះ វា​ក៏​អាច​បញ្ជាក់​ក្រុម​ពិធីការ​ទាំងមូល​ផង​ដែរ ។ សម្រាប់​នោះ ក្រុម​ខាងក្រោម​គឺ​"
"ត្រូវ​បាន​កំណត់ ៖"

#. Tag: term
#: kde-for-admins.docbook:1940
#, no-c-format
msgid ":local"
msgstr ":local"

#. Tag: para
#: kde-for-admins.docbook:1941
#, no-c-format
msgid ""
"Protocols that access locally stored information, examples are file:/, "
"man:/, fonts:/, floppy:/"
msgstr ""
"ពិធីការ​ដែល​ចូល​ដំណើរ​ការ​ព័ត៌មាន​ដែល​រក្សា​ទុក​ជាមូលដ្ឋាន ឧទាហរណ៍​គឺ file៖/, man:/, fonts:/, "
"floppy:/"

#. Tag: term
#: kde-for-admins.docbook:1945
#, no-c-format
msgid ":internet"
msgstr ":internet"

#. Tag: para
#: kde-for-admins.docbook:1946
#, no-c-format
msgid "Common internet protocols such as http and ftp"
msgstr "ពិធីការ​អ៊ីនធឺណិត​ទូទៅ​ដូចជា http និង ftp"

#. Tag: para
#: kde-for-admins.docbook:1951
#, no-c-format
msgid ""
"Information about protocols is stored in <literal role=\"extension\">*."
"protocol</literal> files stored in <filename class=\"directory\">"
"$<envar>KDEDIR</envar>/share/services</filename>."
msgstr ""
"ព័ត៌មាន​អំពី​ពិធីការ​​គឺ​ត្រូវបាន​​រក្សា​ទុក​នៅ​ក្នុង​ឯកសារ <literal role=\"extension\">*.protocol</"
"literal> ដែល​រក្សា​ទុក​ក្នុង <filename class=\"directory\">$<envar>KDEDIR</envar>/"
"share/services</filename> ។"

#. Tag: para
#: kde-for-admins.docbook:1956
#, no-c-format
msgid ""
"The <option>Class</option>= entry defines the group a protocol is part of: "
"<userinput><command>grep</command> <option>Class=</option> <filename>"
"$<envar>KDEDIR</envar>/share/services/*.protocol</filename></userinput>"
msgstr ""
"<option>Class</option>= entry កំណត់​ក្រុម​ដែល​ពិធីការ​ជា​​ផ្នែក​​របស់វា ៖ "
"<userinput><command>grep</command> <option>Class=</option> <filename>"
"$<envar>KDEDIR</envar>/share/services/*.protocol</filename></userinput>"

#. Tag: para
#: kde-for-admins.docbook:1961
#, no-c-format
msgid "General rules:"
msgstr "ច្បាប់​ទូទៅ ៖"

#. Tag: para
#: kde-for-admins.docbook:1964
#, no-c-format
msgid "The :local protocols may refer to any other protocol"
msgstr "ពិធីការ :local អាច​យោង​ទៅ​ពិធីការ​ផ្សេង​ទៀត​ណាមួយ"

#. Tag: para
#: kde-for-admins.docbook:1966
#, no-c-format
msgid "It's always allowed to refer to an :internet protocol"
msgstr "វា​ត្រូវ​បាន​អនុញ្ញាត​ឲ្យ​យោង​ទៅ​ពិធីការ :internet ជានិច្ច"

#. Tag: para
#: kde-for-admins.docbook:1968
#, no-c-format
msgid "Not all protocols are part of a group, fish:/ for example."
msgstr "មិនមែន​ពិធីការ​ទាំងអស់​សុទ្ធតែ​ជា​ផ្នែក​របស់​ក្រុម​នោះ​ទេ ឧទាហរណ៍ fish:/ ។"

#. Tag: title
#: kde-for-admins.docbook:1975
#, no-c-format
msgid "Configuration Modules"
msgstr "ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ"

#. Tag: para
#: kde-for-admins.docbook:1977
#, no-c-format
msgid ""
"&kde; has configuration modules to configure various aspects of the &kde; "
"environment. Configuration modules appear in the Control Center, in the "
"Configuration dialog of an application or in both."
msgstr ""
"KDE មាន​ម៉ូឌុល​កំនត់​រចនា​សម្ព័ន្ធ​ដើម្បី​កំណត់​រចនា​សម្ព័ន្ធ​ទិដ្ឋភាព​ផ្សេងៗ​នៃ​បរិស្ថាន KDE ។ ម៉ូឌុល​កំណត់​រចនា​"
"សម្ព័ន្ធ​លេចឡើង​ក្នុង​មជ្ឈមណ្ឌល​បញ្ជា ក្នុង​ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​របស់​កម្មវិធី ឬ​ទាំងពីរ ។"

#. Tag: para
#: kde-for-admins.docbook:1982
#, no-c-format
msgid ""
"The proxy configuration module appears in the Control Center but also as "
"part of the <guilabel>Configure Konqueror</guilabel> dialog in &konqueror;"
msgstr ""
"ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ​ប្រូកស៊ី​លេចឡើង​ក្នុង​មជ្ឈមណ្ឌល​បញ្ជា ប៉ុន្តែ​ក៏​ជា​ផ្នែក​នៃ​ប្រអ់ប <guilabel>កំណត់​រចនា​"
"សម្ព័ន្ធ Konqueror</guilabel> ក្នុង Konqueror ដែរ ។"

#. Tag: para
#: kde-for-admins.docbook:1986
#, fuzzy, no-c-format
#| msgid ""
#| "Individual configuration modules can be started with <command>kcmshell</"
#| "command> <replaceable>module</replaceable>"
msgid ""
"Individual configuration modules can be started with <command>kcmshell4</"
"command> <replaceable>module</replaceable>"
msgstr ""
"ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ​នីមួយៗ​អាច​ត្រូវ​បាន​ចាប់ផ្ដើម​ដោយ <command>kcmshell</command> "
"<replaceable>ម៉ូឌុល</replaceable>"

#. Tag: para
#: kde-for-admins.docbook:1989
#, no-c-format
msgid "To start the Proxy module use:"
msgstr "ដើម្បី​ចាប់ផ្ដើម​ម៉ូឌុល​ប្រូកស៊ី គឺ​ត្រូវប្រើ ៖"

#. Tag: para
#: kde-for-admins.docbook:1991
#, fuzzy, no-c-format
