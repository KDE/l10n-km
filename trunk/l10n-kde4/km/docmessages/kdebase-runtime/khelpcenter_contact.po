msgid "Contact the &kde; team"
msgstr "ទាក់ទង​​ក្រុម KDE"

#. Tag: title
#: contact.docbook:10
#, no-c-format
msgid "Mailing lists"
msgstr "បញ្ជី​សំបុត្រ​រួម"

#. Tag: para
#: contact.docbook:12
#, no-c-format
msgid ""
"&kde; has several mailing lists up. See below for some of the most useful. "
"Older articles can be found in the <ulink url=\"http://lists.kde.org"
"\">mailing list archive</ulink>."
msgstr ""
"KDE មាន​បញ្ជី​សំបុត្រ​រួម​ជាច្រើន ។ សូម​មើល​បញ្ជី​សំបុត្ររួម​ដែលមាន​ប្រយោជន៍​បំផុត​មួយ​ចំនួន​នៅ​​ខាងក្រោម ។ អត្ថបទ​"
"ចាស់ៗ​អាច​រកបាន​នៅក្នុង <ulink url=\"http://lists.kde.org\">​ប័ណ្ណសារ​បញ្ជី​សំបុត្រ​រួម​</"
"ulink> ។"

