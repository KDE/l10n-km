#. Tag: title
#: filemng.docbook:6
#, no-c-format
msgid "The File Manager"
msgstr "កម្មវិធី​គ្រប់គ្រង​ឯកសារ"

#. Tag: para
#: filemng.docbook:8
#, no-c-format
msgid ""
"&kde;'s file manager is &konqueror;. The &konqueror; home page is located at "
"<ulink url=\"http://www.konqueror.org\">http://www.konqueror.org</ulink> "
"where a &konqueror; specific <acronym>FAQ</acronym> can be found."
msgstr ""
"កម្មវិធី​គ្រប់គ្រង​ឯកសារ​របស់ KDE គឺ Konqueror ។ គេហ​ទំព័រ​របស់ Konqueror គឺ <ulink url="
"\"http://www.konqueror.org\">http://www.konqueror.org</ulink> ដែល​អាច​រក​ឃើញ​នូវ​ "
"<acronym>FAQ</acronym> ជាក់លាក់​របស់ Konqueror ។"

#. Tag: para
#: filemng.docbook:18
#, no-c-format
msgid "How can I change the appearance of a folder in &konqueror;?"
msgstr "តើ​ខ្ញុំ​អាច​ផ្លាស់ប្ដូរ​រូបរាង​របស់​ថត​ក្នុង Konqueror ដោយ​របៀប​ណា ?"

#. Tag: para
#: filemng.docbook:22
#, no-c-format
msgid ""
"Right-click the folder, select <guimenuitem>Properties</guimenuitem>, click "
"on the large icon in the dialog which appears, and choose another icon."
msgstr ""
"ចុច​កណ្ដុរ​ខាង​ស្ដាំ​លើ​ថត ហើយ​ជ្រើស <guimenuitem>លក្ខណៈ​សម្បត្តិ</guimenuitem> សូម​ចុច​លើ​រូប​តំណាង​ធំ​"
"ក្នុង​ប្រអប់​ដែល​លេចឡើង បន្ទាប់​មក​ជ្រើស​រូប​តំណាង​មួយ​ផ្សេង​ទៀត ។"

#. Tag: para
#: filemng.docbook:24
#, fuzzy, no-c-format
#| msgid ""
#| "To change the icon displayed for entries in the <guimenu>K Menu</"
#| "guimenu>, use the <application>Menu Editor</application>, located at "
#| "<menuchoice><guisubmenu>Settings</guisubmenu><guimenuitem>Menu Editor</"
#| "guimenuitem></menuchoice>."
msgid ""
"To change the icon displayed for entries in the <guimenu>K Menu</guimenu>, "
"use the <application>Menu Editor</application>, accessed by clicking with "
"the &RMB; on the &kmenu; icon and selecting <guimenuitem>Menu Editor</"
"guimenuitem> from the menu."
msgstr ""
"ដើម្បី​ផ្លាស់ប្ដូរ​រូប​តំណាង​​ធាតុ​នៅ​ក្នុង <guimenu>ម៉ឺនុយ K</guimenu> គឺ​ត្រូវ​ប្រើ <application>កម្មវិធី​"
"និពន្ធ​ម៉ឺនុយ</application> ដែល​មាន​ទីតាំង​នៅ <menuchoice><guisubmenu>ការ​កំណត់</"
"guisubmenu><guimenuitem>កម្មវិធី​និពន្ធ​ម៉ឺនុយ</guimenuitem></menuchoice> ។"

#. Tag: para
#: filemng.docbook:34
#, no-c-format
msgid "How can I do non-anonymous &FTP; transfers with &konqueror;?"
msgstr "តើ​ខ្ញុំ​អាច​ធ្វើ​ការ​ផ្ទេរ FTP ដែល​មិន​មែន​ជា​អនាមិក​ជាមួយ Konqueror ដោយ​របៀប​ណា ?"

#. Tag: para
#: filemng.docbook:37
#, fuzzy, no-c-format
#| msgid ""
#| "Normally, if you enter a &URL; like <userinput>ftp://<replaceable>ftp."
#| "somehost.com</replaceable></userinput>, &konqueror; will attempt an "
#| "anonymous login to the &FTP; server. If you want to login as a particular "
#| "user, enter a &URL; like <userinput>ftp://<replaceable>username@ftp."
#| "somehost.com</replaceable></userinput> instead. &konqueror; will ask for "
#| "your password and connect to the server."
msgid ""
"Normally, if you enter a &URL; like <userinput>ftp://<replaceable>ftp."
"example.com</replaceable></userinput>, &konqueror; will attempt an anonymous "
"login to the &FTP; server. If you want to login as a particular user, enter "
"a &URL; like <userinput>ftp://<replaceable>username@ftp.example.com</"
"replaceable></userinput> instead. &konqueror; will ask for your password and "
"connect to the server."
msgstr ""
"ជា​ធម្មតា ប្រសិន​បើ​អ្នក​បញ្ចូល URL ដូច​ជា <userinput>ftp://<replaceable>ftp.somehost."
"com</replaceable></userinput> នោះ Konqueror នឹង​ចូល​ជា​អនាមិក​ទៅ​ម៉ាស៊ីន​បម្រើ FTP ។ ប្រសិន​"
"បើ​អ្នក​ចង់​ចូល​ជា​អ្នក​ប្រើ​ពិសេស សូម​បញ្ចូល URL ដូចជចា <userinput>ftp://"
"<replaceable>username@ftp.somehost.com</replaceable></userinput> ជំនួស​វិញ ។ "
"Konqueror នឹង​សួរ​រក​ពាក្យ​សម្ងាត់​របស់​អ្នក ហើយ​​តភ្ជាប់​ទៅ​ម៉ាស៊ីន​បម្រើ​តែម្ដង ។"

#. Tag: para
#: filemng.docbook:50
#, no-c-format
msgid "How do I specify the startup folder for &konqueror;?"
msgstr "តើ​ខ្ញុំ​ត្រូវ​បញ្ជាក់​ថត​ចាប់ផ្ដើម​សម្រាប់ Konqueror ដោយរបៀប​ណា ?"

#. Tag: para
#: filemng.docbook:54
#, no-c-format
msgid ""
"Using the &RMB;, click on the Home icon and choose <guimenuitem>Properties</"
"guimenuitem>. Under the <guilabel>Application</guilabel> tab you will "
"probably find something like <command>kfmclient openProfile filemanagement</"
"command>; just append <filename class=\"directory\">file:/whereever/you/"
"want</filename> with the folder you would like &konqueror; to start in."
msgstr ""
"គឺ​ដោយ​ប្រើ​ប៊ូតុង​កណ្ដុរ​ខាង​ស្ដាំ​​ចុច​លើ​រូប​តំណាង​ផ្ទះ ហើយ​ជ្រើស <guimenuitem>លក្ខណៈ​សម្បត្តិ</"
"guimenuitem> ។ នៅ​ពី​ក្រោម​ផ្ទាំង <guilabel>កម្មវិធី</guilabel> អ្នក​នឹង​ឃើញ​អ្វី​ដូច​ជា "
"<command>kfmclient openProfile filemanagement</command> ដោយ​គ្រាន់​តែ​បន្ថែម "
"<filename class=\"directory\">file:/whereever/you/want</filename> ដែលមាន​ថត​ដែល​"
"អ្នក​ចង់​ចាប់ផ្ដើម Konqueror ។"

#. Tag: para
#: filemng.docbook:66
#, no-c-format
msgid "How do I rename files?"
msgstr "តើ​ខ្ញុំ​ត្រូវ​ប្ដូរ​ឈ្មោះ​ឯកសារតាម​​របៀប​ណា ?"

#. Tag: para
#: filemng.docbook:69
#, no-c-format
msgid ""
"Simply <mousebutton>right</mousebutton> click on the file and select "
"<guimenuitem>Rename</guimenuitem> or press the keyboard shortcut <keycap>F2</"
"keycap> with a file selected."
msgstr ""
"​ចុច <mousebutton>កណ្ដុរ​ខាង​ស្ដាំ</mousebutton> លើ​ឯកសារ ហើយ​ជ្រើស <guimenuitem>ប្ដូរ​"
"ឈ្មោះ</guimenuitem> ឬ​ចុច​ផ្លូវកាត់​ក្ដារ​ចុច <keycap>F2</keycap> ពេល​ដែល​បាន​ជ្រើស​ឯកសារ​រួច ។"

#. Tag: para
#: filemng.docbook:76
#, no-c-format
msgid "Where did the delete entry from my right-click context menu go?"
msgstr "តើ​ធាតុ​ម៉ឺនុយ​បរិបទ​លុប​ពី​ម៉ឺនុយ​បរិបទ​​ដោយ​ចុច​កណ្ដុរ​ខាង​ស្ដាំ​របស់​ខ្ញុំ​​ទៅណា ?"

#. Tag: para
#: filemng.docbook:79
#, no-c-format
msgid ""
"In &kde; 3.4 the delete context menu entries that bypass the trashcan are no "
"longer displayed by default. To enable them, go to "
"<menuchoice><guimenu>Settings</guimenu><guimenuitem>Configure &konqueror;</"
"guimenuitem></menuchoice> and select <guilabel>Behaviour</guilabel> in the "
"iconbar to the left. Tick the checkbox <guilabel>Show 'Delete' context menu "
"entries which bypass the trashcan</guilabel>."
msgstr ""
"ក្នុង KDE ៣.៤ ធាតុ​ម៉ឺនុយ​បរិបទ​​លុប​ដែល​មិន​នៅ​ក្នុង​​ធុង​សំរាម​មិន​ត្រូវ​បាន​បង្ហាញ​តាម​លំនាំ​ដើម​ទៀត​ទេ ។ ដើម្បី​បើក​"
"ពួក​វា សូម​ទៅ​កាន់ <menuchoice><guimenu>ការ​កំណត់</guimenu><guimenuitem>កំណត់​រចនា​សម្ព័ន្ធ "
"Konqueror</guimenuitem></menuchoice> ហើយ​​ជ្រើស <guilabel>ឥរិយាបថ</guilabel> នៅ​"
"ក្នុង​របារ​រូប​តំណាង​នៅ​ខាងឆ្វេង ។ ធីក​ប្រអប់​ធីក <guilabel>បង្ហាញ​ធាតុបញ្ចូល​ម៉ឺនុយ​បរិបទ​​'លុប'​​ដែល​នឹង​"
"ជាសវៀង​ពី​ធុង​សំរាម</guilabel> ។"

#. Tag: para
#: filemng.docbook:91
#, no-c-format
msgid ""
"How do I configure the programs that &konqueror; uses to open different "
"types of files?"
msgstr ""
"តើ​ខ្ញុំ​ត្រូវ​កំណត់​រចនា​សម្ព័ន្ធ​កម្មវិធី​ដែល Konqueror ប្រើ​ដើម្បី​បើក​ប្រភេទ​ឯកសារ​ខុស​គ្នា​​ដោយ​របៀប​ណា ?"

#. Tag: para
#: filemng.docbook:94
#, no-c-format
msgid ""
"In order to configure file associations, you should go to the "
"&kcontrolcenter; and choose the item <guimenuitem>File Associations</"
"guimenuitem> under the category <guimenu>KDE Components</guimenu>."
msgstr ""
"ដើម្បី​កំណត់​រចនា​សម្ព័ន្ធ​ទំនាក់ទំនង​ឯកសារ អ្នក​គួរ​ទៅ​កាន់​មជ្ឈមណ្ឌល​បញ្ជា KDE ហើយ​ជ្រើស​ធាតុ "
"<guimenuitem>ទំនាក់ទំនង​ឯកសារ</guimenuitem> ដែលនៅ​ក្នុង​ប្រភេទ <guimenu>សមាសភាគ KDE</"
"guimenu> ។"

#. Tag: para
#: filemng.docbook:98
#, no-c-format
msgid ""
"Suppose the default <acronym>PDF</acronym> viewer is now &kghostview; and "
"you would prefer to use <application>KPDF</application> as a viewer. You "
"would simply type <userinput>pdf</userinput> in the search box at the top of "
"the dialog, choose <guimenuitem>pdf</guimenuitem> in the "
"<guimenu>application</guimenu> group and move <application>KPDF</"
"application> up. In the <guilabel>Embedding</guilabel> tab you can also "
"choose which component other applications will use to display files (for "
"example, when viewing files in &konqueror; or using &ark;'s embedded viewer)."
msgstr ""
"សន្មត់​ថា​កម្មវិធី​មើល​ <acronym>PDF</acronym> លំនាំ​ដើម​គឺ KGhostView ហើយ​អ្នក​អាច​ចូល​ចិត្ត​ប្រើ "
"<application>KPDF</application> ជា​កម្មវិធី​មើល ។ អ្នក​អាច​​វាយ <userinput>pdf</"
"userinput> នៅ​ក្នុង​ប្រអប់​ស្វែងរក​នៅ​ផ្នែក​ខាងលើ​នៃ​ប្រអប់ បន្ទាប់​មក​​ជ្រើស​ <guimenuitem>pdf</"
"guimenuitem> ក្នុង​ក្រុម <guimenu>កម្មវិធី</guimenu> ហើយ​ផ្លាស់ទី <application>KPDF</"
"application> ឡើង ។ ក្នុង​ផ្ទាំង <guilabel>បង្កប់</guilabel> អ្នក​អាច​ជ្រើស​សមាសភាគ​ណាមួយ​​ដែល​"
"កម្មវិធី​ផ្សេង​នឹង​ប្រើ​ដើម្បី​បង្ហាញ​ឯកសារ (ឧទាហរណ៍ នៅពេល​កំពុង​មើល​ឯកសារ​ក្នុង Konqueror ឬ​​ប្រើ​កម្មវិធី​"
"បង្កប់​របស់ ark) ។"

#. Tag: para
#: filemng.docbook:114
#, no-c-format
msgid ""
"How can I configure &konqueror; to open files with double-click instead of "
"single-click?"
msgstr ""

#. Tag: para
#: filemng.docbook:118
#, fuzzy, no-c-format
#| msgid ""
#| "In &konqueror;, go to <menuchoice><guimenu>Settings</"
#| "guimenu><guimenuitem>Configure Konqueror</guimenuitem></menuchoice> and "
#| "then to the <guilabel>File Associations</guilabel> page."
msgid ""
"In the &kcontrolcenter;, go to <menuchoice><guimenu>Peripherals</"
"guimenu><guimenuitem>Mouse</guimenuitem></menuchoice> and in the "
"<guilabel>General</guilabel> tab, select <guilabel>Double-click to open "
"files and folders</guilabel>."
msgstr ""
"ក្នុង Konqueror ​សូម​ចូលទៅ​កាន់ <menuchoice><guimenu>ការ​កំណត់</guimenu><guimenuitem>កំណត់​"
"រចនា​សម្ព័ន្ធ Konqueror</guimenuitem></menuchoice> ហើយ​បន្ទាប់​មក​​ទៅ​ទំព័រ <guilabel>ទំនាក់​"
"ទំនង​ឯកសារ</guilabel> ។"

#. Tag: para
#: filemng.docbook:127
#, no-c-format
msgid ""
"When I try to click on a folder in &konqueror;, I get the message: "
"<quote>There appears to be a configuration error. You have associated "
"Konqueror with inode/directory, but it cannot handle this file type.</quote>"
msgstr ""
"​ពេល​ខ្ញុំ​ព្យាយាម​ចុច​លើ​ថត​ក្នុង Konqueror វា​បង្ហាញ​សារ ៖ <quote>មាន​កំហុស​ការ​កំណត់​រចនា​សម្ព័ន្ធ​"
"លេចឡើង ។ អ្នក​បាន​ភ្ជាប់​ Konqueror ជាមួយ inode/ថត ប៉ុន្តែ​វា​មិន​អាច​គ្រប់គ្រង​ប្រភេទ​ឯកសារ​នេះ​បាន​"
"ទេ ។</quote>"

#. Tag: para
#: filemng.docbook:133
#, no-c-format
msgid ""
"You need to make sure that the embedding settings for inode/directory are "
"correct:"
msgstr "អ្នក​ត្រូវការ​ប្រាកដ​ថា ការ​កំណត់​បង្កប់​សម្រាប់ inode/ថត គឺ​ត្រឹមត្រូវ ៖"

#. Tag: para
#: filemng.docbook:136
#, no-c-format
msgid ""
"In &konqueror;, go to <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure Konqueror</guimenuitem></menuchoice> and then "
"to the <guilabel>File Associations</guilabel> page."
msgstr ""
"ក្នុង Konqueror ​សូម​ចូលទៅ​កាន់ <menuchoice><guimenu>ការ​កំណត់</guimenu><guimenuitem>កំណត់​"
"រចនា​សម្ព័ន្ធ Konqueror</guimenuitem></menuchoice> ហើយ​បន្ទាប់​មក​​ទៅ​ទំព័រ <guilabel>ទំនាក់​"
"ទំនង​ឯកសារ</guilabel> ។"

#. Tag: para
#: filemng.docbook:139
#, no-c-format
msgid "Open inode->directory in the tree view."
msgstr "បើក inode->directory ជា​ទិដ្ឋភាព​មែកធាង ។"

#. Tag: para
#: filemng.docbook:140
#, no-c-format
msgid ""
"Click on the <guilabel>Embedding</guilabel> tab. Make sure that "
"<guilabel>Left Click Action</guilabel> is set to <guilabel>Show file in "
"embedded viewer</guilabel>, and by default <guilabel>Icon View "
"(konq_iconview)</guilabel> is at the top of <guilabel>Services Preference "
"Order.</guilabel>"
msgstr ""
"ចុច​លើផ្ទាំង <guilabel>បង្កប់</guilabel> ។ សូម​ប្រាកដ​ថា​បាន​កំណត់ <guilabel>អំពើចុច​ប៊ូតុង​កណ្ដុរ​"
"ឆ្វេង</guilabel> ​ទៅ <guilabel>បង្ហាញ​ឯកសារ​ក្នុង​កម្មវិធី​មើល​ដែល​បង្កប់</guilabel> ហើយតាម​"
"លំនាំ​ដើម <guilabel>ទិដ្ឋភាព​រូប​តំណាង (konq_iconview)</guilabel> នៅ​កំពូល​នៃ "
"<guilabel>លំដាប់​ចំណង់​ចំណូល​ចិត្ត​សេវា</guilabel> ។"

#. Tag: para
#: filemng.docbook:154
#, no-c-format
msgid ""
"What are <option>%i</option> and <option>%m</option> in the Execute line?"
msgstr "តើ​អ្វី​ជា <option>%i</option> និង <option>%m</option> នៅ​ក្នុង​បន្ទាត់​ប្រតិបត្តិ ?"

#. Tag: para
#: filemng.docbook:157
#, no-c-format
msgid ""
"They are used by all &kde; applications (since they are implemented in "
"<classname>KApplication</classname> and all good &kde; programs create a "
"<classname>KApplication</classname> object before they even look at the "
"command line arguments)."
msgstr ""
"ពួក​វា​ត្រូវ​បាន​ប្រើ​ដោយ​កម្មវិធី KDE ទាំងអស់ (ចាប់​តាំង​ពី​ពួក​វា​បាន​ប្រតិបត្តិ​ក្នុង "
"<classname>KApplication</classname> ហើយ​កម្មវិធី KDE ល្អ​ទាំងអស់​បង្កើត​ធាតុ "
"<classname>KApplication</classname> មុន​ពេល​ពួក​វា​​មើល​អាគុយម៉ង់​បន្ទាត់​ពាក្យ​បញ្ជា) ។"

#. Tag: para
#: filemng.docbook:160
#, no-c-format
msgid ""
"A standard line for a &kde; application looks like this: "
"<userinput><command>foo</command> <option>... %i %m -caption \\\"%c\\\"</"
"option></userinput>. Pretty confusing, -but it has been designed in that way "
"so that it can integrate legacy, non-&kde; applications as smoothly as "
"possible. &konqueror;, when executing the line above, will extend the "
"command to <userinput><command><replaceable>foo</replaceable></command> "
"<option>-icon something.png -miniicon something_mini.png -caption \\\"The Foo"
"\\\"</option></userinput>. Both the icon and the mini-icon as well as \"The "
"Foo\" are properties defined in the <filename>.desktop</filename> file. If "
"the icons are not defined, they simply default to the executable name "
"<replaceable>foo</replaceable>."
msgstr ""
"បន្ទាត់​ស្តង់ដារ​សម្រាប់​កម្មវិធី KDE មាន​រូបរាង​ដូចនេះ​ ៖ <userinput><command>foo</command> "
"<option>... %i %m -caption \\\"%c\\\"</option></userinput> ។ ងាយ​ច្រឡំ​បំផុត ប៉ុន្តែ​វា​"
"ត្រូវ​បាន​រចនា​តាម​វិធី​នោះ​ ដូច្នេះ​វា​អាច​បញ្ចូល​កម្មវិធី​ដែល​មិន​មែន​ជា KDE ចាស់​ឲ្យ​កាន់​តែ​រលូន​តាម​ដែល​អាច​"
"ធ្វើ​ទៅបាន ។ Konqueror ពេល​ប្រតិបត្តិ​បន្ទាត់​ខាង​លើ នឹង​ពង្រីក​ពាក្យ​បញ្ជា​ទៅ "
"<userinput><command><replaceable>foo</replaceable></command> <option>-icon "
"something.png -miniicon something_mini.png -caption \\\"The Foo\\\"</"
"option></userinput> ។ ទាំង​រូប​តំណាង និង​រូប​តំណាង​ពាក់​កណ្ដាល​រួម​ទាំង \"Foo\" ជា​លក្ខណៈ​សម្បត្តិ​ដែល​"
"បាន​កំណត់​ក្នុង​ឯកសារ <filename>.desktop</filename> ។ បើ​រូប​តំណាង​មិន​ត្រូវ​បាន​កំណត់ ពួក​វា​ជា​"
"ធម្មតា​លំនាំ​ដើម​ចំពោះ​ឈ្មោះ​ដែល​អាច​ប្រតិបត្តិ​បាន <replaceable>foo</replaceable> ។"

#. Tag: para
#: filemng.docbook:173
#, no-c-format
msgid ""
"This way a user can change these things in &kmenuedit; for his or her "
"applications. The <option>-caption</option> option is important, because no "
"user will accept that the menu item <guimenuitem>Editor</guimenuitem> starts "
"something called <guilabel>kedit-0.9pl4-build47</guilabel>. Instead, he "
"expects a window called <guilabel>Editor</guilabel>. Furthermore these names "
"are localized, <abbrev>i.e.</abbrev> an American user launches "
"<guimenuitem>CD-Player</guimenuitem> and gets a window called <guilabel>CD-"
"Player</guilabel> while a German user launches <guimenuitem>CD-Spieler</"
"guimenuitem> and gets a window called <guilabel>CD-Spieler</guilabel>."
msgstr ""
"វិធី​នេះ​អ្នក​ប្រើ​អាច​ផ្លាស់ប្ដូរ​អ្វី​ទាំងនេះ​ក្នុង KMenuEdit សម្រាប់​កម្មវិធី​របស់​គាត់ ។ ជម្រើស <option>-"
"caption</option> សំខាន់ ពីព្រោះ​គ្មាន​អ្នក​ប្រើ​ដែល​នឹង​ព្រមទទួល​ថា​​ធាតុ​ម៉ឺនុយ​ <guimenuitem>កម្មវិធី​"
"និពន្ធ</guimenuitem> ចាប់ផ្ដើម​អ្វី​ដែល​ហៅ​ថា <guilabel>kedit-0.9pl4-build47</"
"guilabel> ។ ជំនួស​មកវិញ គាត់​រំពឹងថា​ជា​បង្អួច​ដែល​ហៅ​ថា <guilabel>កម្មវិធី​និពន្ធ</guilabel> ។ "
"លើស​ពី​នេះ ឈ្មោះ​ទាំងនេះ​ត្រូវ​បាន​ធ្វើ​មូលដ្ឋានីយកម្ម មាន​ន័យ​ថា​ អ្នក​ប្រើ​អាមេរិកាំង​បើក​ "
"<guimenuitem>CD-Player</guimenuitem> ហើយ​និង​បង្ហាញ​បង្អួច​ដែលមាន​ឈ្មោះ <guilabel>CD-"
"Player</guilabel> ខណៈ​ដែល​អ្នក​ប្រើ​អាល្លឺម៉ង់​បើក​ដំណើរ​ការ <guimenuitem>CD-Spieler</"
"guimenuitem> និង​បង្ហាញ​បង្អួច​ដែល​មាន​ឈ្មោះ <guilabel>CD-Spieler</guilabel> ។"

#. Tag: para
#: filemng.docbook:187
#, no-c-format
msgid ""
"How do I make &konqueror; start up without a menu bar? I can't save a view "
"profile when the menu bar is invisible!"
msgstr ""
"តើ​ខ្ញុំ​ត្រូវ​ធ្វើ​ឲ្យ Konqueror ចាប់ផ្ដើម​ដោយ​គ្មាន​របារ​ម៉ឺនុយ​ដោយ​របៀប​ណា ? ខ្ញុំ​មិន​អាច​រក្សា​ទុក​ទម្រង់​"
"ទិដ្ឋភាព ពេល​របារ​ម៉ឺនុយ​មើល​មិន​ឃើញ!"

#. Tag: para
#: filemng.docbook:191
#, no-c-format
msgid ""
"The easiest way to do this is to edit &konqueror;'s configuration file "
"manually. Add the following lines to <filename>~/.kde/share/config/"
"konquerorrc</filename>:"
msgstr ""
"វិធី​ដែល​ស្រួល​បំផុត​ដើម្បី​ធ្វើ​វា ​គឺ​ត្រូវ​កែ​សម្រួល​ឯកសារ​​កំណត់​រចនា​សម្ព័ន្ធ​របស់ Konqueror ដោយ​ដៃ ។ បន្ថែម​"
"បន្ទាត់​ខាងក្រោម​ទៅ <filename>~/.kde/share/config/konquerorrc</filename> ៖"

#. Tag: programlisting
#: filemng.docbook:194
#, no-c-format
msgid ""
"[KonqMainWindow]\n"
"MenuBar=Disabled"
msgstr ""
"[KonqMainWindow]\n"
"MenuBar=Disabled"

#. Tag: para
#: filemng.docbook:197
#, no-c-format
msgid "On restarting &konqueror;, the menubar should be hidden."
msgstr "ពេល​ចាប់ផ្ដើម Konqueror របារ​ម៉ឺនុយ​គួរ​តែ​ត្រូវ​បាន​លាក់ ។"

#. Tag: para
#: filemng.docbook:204
#, no-c-format
msgid ""
"<acronym>JPEG</acronym> files no longer show previews in &konqueror; (and "
"I've installed CrossOver Office)"
msgstr ""

#. Tag: para
#: filemng.docbook:207
#, no-c-format
msgid ""
"CrossOver creates new &MIME; types that will override the default image/jpeg "
"and image/jpg times. In &konqueror;, go to <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure Konqueror</guimenuitem> </menuchoice>, and "
"then to <guilabel>File Associations</guilabel>. Find the application/x-"
"crossover-jpg and application/x-crossover-jpeg entries, and remove them. "
"Then hit <guibutton>OK</guibutton>. This problem is reported fixed in the "
"latest version of CrossOver."
msgstr ""
