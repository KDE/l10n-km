#. Tag: title
#: man-kicker.1.docbook:9
#, no-c-format
msgid "KDE User's Manual"
msgstr "សៀវភៅ​ដៃ​អ្នក​ប្រើ​របស់ KDE"

#. Tag: author
#: man-kicker.1.docbook:10
#, no-c-format
msgid "&Lauri.Watts;&Lauri.Watts.mail;"
msgstr "&Lauri.Watts;&Lauri.Watts.mail;"

#. Tag: refentryinfo
#: man-kicker.1.docbook:10
#, no-c-format
msgid ""
"<date>February 27, 2005</date> <productname>K Desktop Environment</productname>"
msgstr ""
"<date>២៧ កុម្ភៈ ២០០៥</date> <productname>បរិស្ថាន​ផ្ទៃតុ​ K</productname>"

#. Tag: command
#: man-kicker.1.docbook:16 man-kicker.1.docbook:21
#, no-c-format
msgid "kicker"
msgstr "Kicker"

#. Tag: manvolnum
#: man-kicker.1.docbook:17
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>១</manvolnum>"

#. Tag: refpurpose
#: man-kicker.1.docbook:22
#, no-c-format
msgid "&kicker; is the &kde; panel"
msgstr "Kicker គឺ​ជា​បន្ទះ​របស់ KDE"

#. Tag: cmdsynopsis
#: man-kicker.1.docbook:26
#, no-c-format
msgid ""
"<command>kicker</command> <arg choice=\"opt\">KDE Generic Options</arg> "
"<arg choice=\"opt\">Qt Generic Options</arg>"
msgstr ""
"<command>Kicker</command> <arg choice=\"opt\">ជម្រើស​ទូទៅ​របស់ KDE</arg> "
"<arg choice=\"opt\">ជម្រើស​ទូទៅ​របស់ Qt</arg>"

#. Tag: title
#: man-kicker.1.docbook:34
#, no-c-format
msgid "Description"
msgstr "សេចក្ដី​ពិពណ៌នា"

#. Tag: para
#: man-kicker.1.docbook:35
#, no-c-format
msgid ""
"&kicker; is the &kde; panel. It normally contains application starters, "
"applets, and a clock."
msgstr ""
"Kicker ​គឺ​ជា​បន្ទះ​របស់ KDE ។ តាម​ធម្មតា​វា​មាន​កម្មវិធី​ចាប់ផ្ដើម​កម្មវិធី "
"អាប់ភ្លេត និង​នាឡិកា ។"

#. Tag: title
#: man-kicker.1.docbook:41
#, no-c-format
msgid "Files"
msgstr "ឯកសារ"

#. Tag: filename
#: man-kicker.1.docbook:45
#, no-c-format
msgid "$<envar>KDEHOME</envar>/share/apps/kickerrc"
msgstr "$<envar>KDEHOME</envar>/share/apps/kickerrc"

#. Tag: para
#: man-kicker.1.docbook:47
#, no-c-format
msgid ""
"User specific configuration file. This file is not normally intended to be "
"edited directly; Most configuration items can be controlled from &kcontrol;."
msgstr ""
"ឯកសារ​កំណត់​រចនាសម្ព័ន្ធ​ជាក់លាក់​របស់​អ្នក​ប្រើ ។ "
"ឯកសារ​នេះ​តាម​ធម្មតា​មិន​មាន​ត្រូវ​បាន​កែសម្រួល​ដោយ​ផ្ទាល់ទេ "
"ធាតុ​កំណត់​រចនាសម្ព័ន្ធ​ភាគ​ច្រើន​អាច​ត្រូវ​បាន​ត្រួតពិនិត្យ​ពី kcontrol ។"

#. Tag: filename
#: man-kicker.1.docbook:54
#, no-c-format
msgid "$<envar>PREFIX</envar>/share/apps/kickerrc"
msgstr "$<envar>PREFIX</envar>/share/apps/kickerrc"

#. Tag: para
#: man-kicker.1.docbook:56
#, no-c-format
msgid ""
"Global configuration file. This file is not normally intended to be edited "
"directly; Most configuration items can be controlled from &kcontrol;. Global "
"settings may be configured by the system administrator to either set defaults, "
"or lock down options that may not be altered by the users of the system."
msgstr ""
"ឯកសារ​កំណត់​រចនាសម្ព័ន្ធ​សកល ។ "
"ឯកសារ​នេះ​តាម​ធម្មតា​មិន​ត្រូវ​បានកែសម្រួល​ដោយ​ផ្ទាល់​ទេ "
"ធាតុ​កំណត់​រចនាសម្ព័ន្ធ​ភាគ​ច្រើន​អាច​ត្រូវ​បាន​ត្រួតពិនិត្យ​ពី kcontrol ។ "
"ការ​កំណត់​សកល​អាច​ត្រូវ​បាន​កំណត់​រចនាសម្ព័ន្ធ​ដោយ​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​ដើម្ប"
"ី​កំណត់​ជា​លំនាំដើម "
"ឬ​​ជម្រើស​ចាក់សោ​ដែល​​មិន​អាច​ត្រូវ​បា​ន​ត្រង​ដោយ​អ្នក​ប្រើ​របស់​ប្រព័ន្ធ ។"

#. Tag: title
#: man-kicker.1.docbook:68
#, no-c-format
msgid "See Also"
msgstr "សូម​មើល"

#. Tag: para
#: man-kicker.1.docbook:70
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/kicker\">"
"help:/kicker</ulink> (either enter this <acronym>URL</acronym> "
"into &konqueror;, or run <userinput><command>khelpcenter</command> <parameter>"
"help:/kicker</parameter></userinput>)."
msgstr ""
"ឯកសារ​អ្នក​ប្រើ​លម្អិត​បន្ថែម​ទៀត ​អាច​រក​បាន​ពី <ulink url=\"help:/kicker\">"
"help:/kicker</ulink> (បញ្ចូល <acronym>URL</acronym> នេះ​ទៅ​ក្នុង konqueror "
"ឬ​រត់ <userinput><command>​khelpcenter​</command> <parameter>"
"help:/kicker</parameter></userinput>) ។"

#. Tag: title
#: man-kicker.1.docbook:79
#, no-c-format
msgid "Authors"
msgstr "អ្នក​និពន្ធ"

