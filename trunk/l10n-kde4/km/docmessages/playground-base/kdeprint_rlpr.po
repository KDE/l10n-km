#. Tag: title
#: rlpr.docbook:2
#, no-c-format
msgid "Module Built Around <application>rlpr</application> Utility"
msgstr "ឧបករណ៍​ប្រើប្រាស់​ជុំវិញ​ការ​សង់​ម៉ូឌុល <application>rlpr</application>"

#. Tag: title
#: rlpr.docbook:6
#, no-c-format
msgid "Overview of provided features"
msgstr "ទិដ្ឋភាព​ទូទៅ​នៃ​លក្ខណៈ​ពិសេស​ដែល​បាន​ផ្តល់​ឲ្យ​"

#. Tag: para
#: rlpr.docbook:8
#, no-c-format
msgid "Printer management: basic operations are supported (add/remove/modify)."
msgstr "ការ​គ្រប់គ្រង​ម៉ាស៊ីន​បោះពុម្ព ៖ ការ​ប្រតិបត្តិ​មូលដ្ឋាន​ត្រូវ​បាន​គាំទ្រ​ (បន្ថែម​/យកចេញ/កែប្រែ​) ។​"

#. Tag: para
#: rlpr.docbook:11
#, no-c-format
msgid ""
"Each user can predefine the printers he wants to use by specifying the host "
"and related printer queues. Printers are stored on a <quote>per user basis</"
"quote>. This module is built around the <application>rlpr</application> "
"utility <ulink url=\"http://truffula.com/rlpr/\">rlpr</ulink>"
msgstr ""
"អ្នក​ប្រើ​នីមួយៗ​អាច​កំណត់​ម៉ាស៊ីន​បោះពុម្ព​ដែល​អ្នកចង់​ប្រើ​មុន​ដោយ​កំណត់​ម៉ាស៊ីន​ និង​ម៉ាស៊ីនបោះពុម្ព​ដែល​ទាក់ទង​​ជា "
"បន្តបន្ទាប់​។ ម៉ាស៊ីនបោះពុម្ព​ជាច្រើន​ត្រូវ​បាន​ផ្ទុក​លើ​ <quote> មូលដ្ឋាន​អ្នកប្រើ​មុន​ </quote> ។ ម៉ូឌុល​"
"នេះ​ត្រូវ​បាន​សង់​ជុំវិញអត្ថប្រយោជន៍​ <application>rlpr</application>  <ulink url=\"http://"
"truffula.com/rlpr/\">rlpr</ulink>"
