#. Tag: para
#: cups-config.docbook:753
#, no-c-format
msgid ""
"The lines tagged <quote>D</quote> at the beginning are debug level entries, "
"the ones tagged <quote>I</quote> are there in <quote>info</quote> level."
msgstr ""
"បន្ទាត់​ដែល​មាន​ស្លាក <quote>D</quote> នៅ​ដំបូង​គឺ​ជា​ធាតុ​កម្រិត​បំបាត់​កំហុស មួយ​ដែល​មាន​ស្លាក "
"<quote>I</quote> មាន​នៅ​ក្នុង​កម្រិត  <quote>ព័ត៌មាន</quote> ។"

#. Tag: guilabel
#: cups-config.docbook:760
#, no-c-format
msgid "Max log file size"
msgstr "ទំហំ​ឯកសារ​កំណត់ហេតុ​អតិបរមា"

#. Tag: para
#: cups-config.docbook:763
#, no-c-format
msgid ""
"Controls the maximum size of each log file before they are rotated. Defaults "
"to 1048576 (1 Mb). Set this to 0 to disable log rotation."
msgstr ""
"ត្រួតពិនិត្យ​ទំហំ​អតិបរមា​នៃ​ឯកសារ​កំណត់ហេតុនីមួយៗ​មុន​ពួកវា​ត្រូវ​បានបង្វិល ។ លំនាំដើមគឺ ១០៤៨៥៦៧ (១ "
"មេកាបៃ) ។ កំណត់​​ទៅ ០ ដើម្បី​បិទ​ការបង្វិល​កំណត់​ហេតុ ។"

#. Tag: para
#: cups-config.docbook:768
#, no-c-format
msgid "Enter an size in bytes, for example <userinput>1048576</userinput>"
msgstr "បញ្ចូល​ទំហំ​គិត​ជា​បៃ ឧទាហរណ៍ <userinput>១០៤៨៥៦៧</userinput>"

#. Tag: title
#: cups-config.docbook:777
#, no-c-format
msgid "Server Folders Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ថត​ម៉ាស៊ីន​បម្រើ​"

#. Tag: para
#: cups-config.docbook:779
#, fuzzy, no-c-format
#| msgid ""
#| "The dialog to configure the &CUPS; server. Different folders are to be "
#| "set here. Normally you don't need to change anything in this section. In "
#| "case you play around with fancy (TrueType, &PostScript; or other) fonts "
#| "on your system, this qis the place to do the settings for using those "
#| "fonts when printing. Server folder settings include:"
msgid ""
"The dialog to configure the &CUPS; server. Different folders are to be set "
"here. Normally you don't need to change anything in this section. In case "
"you play around with fancy (TrueType, &PostScript; or other) fonts on your "
"system, this is the place to do the settings for using those fonts when "
"printing. Server folder settings include:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ។ ថត​ផ្សេង​គ្នា​មិន​ត្រូវ​បាន​កំណត់​ទីនេះ​ទេ ។ ជា​ធម្មតា​អ្នក​"
"មិន​ត្រូវកា​ផ្លាស់ប្ដូរ​អ្វី​នៅ​ក្នុង​ផ្នែក​នេះ​ទេ ។ ក្នុង​ករណី អ្នក​លេង​ជា​មួយ​ពុម្ព​អក្សរ​ក្បូរក្បាច់ (TrueType "
"PostScript ឬ​ផ្សេង​ទៀត) នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក qis នេះ​ដាក់​ដើម្បី​ធ្វើការ​កំណត់​សម្រាប់​ប្រើ​ពុម្ព​អក្សរ​"
"ទាំងនេះ​ពេល​បោះពុម្ព ។ ការ​កំណត់​ថត​ម៉ាស៊ីន​បម្រើ​រួម​មាន ៖"

#. Tag: para
#: cups-config.docbook:788
#, no-c-format
msgid "<guilabel>Executables</guilabel>: where to find the server executables"
msgstr ""
"<guilabel>អាចប្រត្តិបតិ​បាន</guilabel> ៖ កន្លែង​ដែល​ត្រូវ​រក​ម៉ាស៊ីន​បម្រើ​ដែល​អាច​ប្រតិបត្តិការ"

#. Tag: para
#: cups-config.docbook:792
#, no-c-format
msgid ""
"<guilabel>Configuration</guilabel>: where to find the server configuration "
"files"
msgstr ""
"<guilabel>ការកំណត់​រចនាសម្ព័ន្ធ​</guilabel> ៖ កន្លែង​ដែល​ត្រូវ​រក​ឯកសារ​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​"
"បម្រើ"

#. Tag: para
#: cups-config.docbook:796
#, no-c-format
msgid "<guilabel>Data</guilabel>: where to find the server data files"
msgstr "<guilabel>ទិន្នន័យ</guilabel> ៖ កន្លែង​ដែល​ត្រូវ​រក​ឯកសារ​ទិន្នន័យ​ម៉ាស៊ីនបម្រើ"

#. Tag: para
#: cups-config.docbook:800
#, no-c-format
msgid ""
"<guilabel>Temporary files</guilabel>: where to put the server temporary "
"print files"
msgstr ""
"<guilabel>ឯកសារ​បណ្តោះ​អាស្នន​</guilabel> ៖ កន្លែង​ដែល​ត្រូវ​ដាក់​ឯកសារ​បោះពុម្ព​បណ្ដោះ​អាសន្ន​"
"ម៉ាស៊ីន​បម្រើ"

#. Tag: para
#: cups-config.docbook:804
#, no-c-format
msgid "<guilabel>Temporary Requests</guilabel>: where to find the server"
msgstr "<guilabel>សំណើរ​បណ្តោះអាសន្ន</guilabel> ៖ កន្លែង​ត្រូវ​រក​ម៉ាស៊ីន​បម្រើ"

#. Tag: para
#: cups-config.docbook:808
#, no-c-format
msgid "<guilabel>Font Path</guilabel>: where to find the server fonts"
msgstr "<guilabel>ផ្លូវ​ពុម្ពអក្សរ​</guilabel> ៖ ​កន្លែង​ត្រូវ​រក​ពុម្ព​អក្សរ​ម៉ាស៊ីន​បម្រើ"

#. Tag: screeninfo
#: cups-config.docbook:813
#, no-c-format
msgid "&CUPS; server configuration dialog: &HTTP; configuration"
msgstr "ប្រអប់​ការកំណត់រចនាសម្ព័ន្ធម៉ាស៊ីន​បម្រើ &CUPS; ៖ ការកំណត់ រចនាសម្ព័ន្ធ &HTTP; "

#. Tag: phrase
#: cups-config.docbook:819
#, no-c-format
msgid "The dialog to configure the &CUPS; server: &HTTP; configuration"
msgstr "ប្រអប់​កំណត់រចនសម្ព័ន្ធម៉ាស៊ីនបម្រើ &CUPS; ៖ ការកំណត់​រចនាសម្ព័ន្ធ &HTTP; "

#. Tag: guilabel
#: cups-config.docbook:825
#, no-c-format
msgid "Executables"
msgstr "ដែល​អាច​ប្រត្តិបតិ​បាន"

#. Tag: para
#: cups-config.docbook:827
#, no-c-format
msgid ""
"The root folder for the scheduler executables. By default this is <filename "
"class=\"directory\">/usr/lib/cups</filename> (or <filename class=\"directory"
"\">/usr/lib32/cups</filename> on IRIX 6.5)"
msgstr ""
"ថត​រូត​សម្រាប់​កម្មវិធី​កំណត់​ពេល​វេលា​ដែល​អាច​ប្រតិបត្តិ​បាន ។ តាម​លំនាំដើម​នេះ​ជា <filename class="
"\"directory\">/usr/lib/cups</filename> (ឬ <filename class=\"directory\">/usr/"
"lib32/cups</filename> លើ IRIX 6.5)"

#. Tag: guilabel
#: cups-config.docbook:835
#, no-c-format
msgid "Configuration"
msgstr "ការកំណត់​រចនាសម្ព័ន្ធ"

#. Tag: para
#: cups-config.docbook:837
#, no-c-format
msgid ""
"The root folder for the scheduler. By default, <filename class=\"directory"
"\">/etc/cups</filename>."
msgstr ""
"ថត​រូត​សម្រាប់​កម្មវិធី​កំណត់​ពេលវេលា ។ តាម​លំនាំ​ដើម <filename class=\"directory\">/etc/"
"cups</filename> ។"

#. Tag: para
#: cups-config.docbook:839
#, no-c-format
msgid ""
"On the authors SuSE system, this is <filename class=\"directory\">/usr/share/"
"doc/cups</filename>. It contains all the <acronym>HTML</acronym> or "
"<acronym>PDF</acronym> documentation for &CUPS; which is available through "
"the Web interface at <ulink url=\"http://localhost:631/documentation.html\"> "
"http://localhost:631/documentation.html</ulink>"
msgstr ""
"នៅ​លើ​ប្រព័ន្ធ​អ្នក​និពន្ធ​ស៊ូស៊ី នេះជា <filename class=\"directory\">/usr/share/doc/cups</"
"filename> ។ វា​មានឯកសារ <acronym>HTML</acronym> ឬ <acronym>PDF</acronym> ទាំងអស់​"
"សម្រាប់ CUPS ដែល​អាច​រក​បានតាម​ចំណុច​ប្រទាក់​បណ្តាញនៅ​ឯ <ulink url=\"http://localhost:631/"
"documentation.html\"> http://localhost:631/documentation.html</ulink>"

#. Tag: guilabel
#: cups-config.docbook:849
#, no-c-format
msgid "Data"
msgstr "ទិន្នន័យ"

#. Tag: para
#: cups-config.docbook:851
#, no-c-format
msgid ""
"The root folder for the &CUPS; data files. By default this is <filename "
"class=\"directory\">/usr/share/cups</filename>"
msgstr ""
"ថត​រូត​សម្រាប់​ឯកសារ​ទិន្នន័យ CUPS ។ តាម​លំនាំ​ដើម​នេះជា <filename class=\"directory\">/usr/"
"share/cups</filename>"

#. Tag: para
#: cups-config.docbook:853
#, no-c-format
msgid ""
"It contains such things as banners, charsets, data, drivers, fonts, and "
"<command>pstoraster</command> templates."
msgstr ""
"វា​មាន​ដូចជា វត្ថុ​ជា​បដា សំណុំ​តួអក្សរ ទិន្នន័យ កម្មវិធី​បញ្ជា ពុម្ពអក្សរ និង​ពុម្ព "
"<command>pstoraster</command> ។"

#. Tag: guilabel
#: cups-config.docbook:859
#, no-c-format
msgid "Temporary files"
msgstr "ឯកសារ​បណ្តោះ​អាសន្ន​"

#. Tag: para
#: cups-config.docbook:861
#, no-c-format
msgid ""
"The folder to put temporary files in. This folder must be writable by the "
"user defined on the previous screen. This defaults to either <filename class="
"\"directory\">/var/spool/cups/tmp</filename> or the value of the "
"<envar>TMPDIR</envar> environment variable."
msgstr ""
"ថត​សម្រាប់​ដាក់​ឯកសារ​បណ្តោះអាសន្ន​ក្នុង ។ ថត​នេះ​ត្រូវ​បាន​សរសេរដោយអ្នកប្រើ​ដែលបានកំណត់​លើ​អេក្រង់​មុន ។"
"លំនាំដើម​នេះ​ចំពោះ <filename class=\"directory\">/var/spool/cups/tmp</filename> ឬ​"
"តម្លៃ​នេះ​អថេរបរិស្ថាន <envar>TMPDIR</envar> ។"

#. Tag: guilabel
#: cups-config.docbook:869
#, no-c-format
msgid "Temporary Requests"
msgstr "សំណើរ​បណ្តោះ​អាសន្ន​"

#. Tag: para
#: cups-config.docbook:871
#, no-c-format
msgid ""
"The folder where request files are stored. By default this is <filename "
"class=\"directory\">/var/spool/cups</filename>"
msgstr ""
"ថត​ដែល​ឯកសារ​សំណើ​ត្រូវ​បាន​រក្សា​ទុក ។ ដោយ​លំនាំ​ដើម នេះ​គឺ​ជា <filename class=\"directory\">/"
"var/spool/cups</filename>"

#. Tag: guilabel
#: cups-config.docbook:877
#, no-c-format
msgid "Font path"
msgstr "ផ្លូវ​ពុម្ពអក្សរ​"

#. Tag: para
#: cups-config.docbook:879
#, no-c-format
msgid ""
"The place to configure the &CUPS; server for handling your fancy fonts "
"(TrueType or &PostScript;). &CUPS; will look here for fonts to embed in "
"printfiles. This currently only affects the <command>pstoraster</command> "
"filter, and the default is <filename class=\"directory\">/usr/share/cups/"
"fonts</filename>."
msgstr ""
"ទីតាំង​ដើម្បី​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីនបម្រើ CUPS សម្រាប់ដោះស្រាយ​ពុម្ពអក្សរ (ប្រភេទ​ពិត ឬ "
"PostScript) ។ CUPS មើល​ពុម្ព​អក្សរ​ដែល​បានបង្កប់​ក្នុង​ឯកសារ​បោះពុម្ព ។ នេះបាន​ឥទ្ធិពល​តម្រង "
"<command>pstoraster</command> បច្ចុប្បន្ន​និង​លំនាំដើម​គឺ <filename class=\"directory"
"\">/usr/share/cups/fonts</filename> ។"

#. Tag: para
#: cups-config.docbook:885
#, no-c-format
msgid ""
"To specify more than one folder, list them with double colons as separator. "
"Do it like this:"
msgstr "ដើម្បី​បញ្ជាក់​ថត​ច្រើន​ជាង​មួយ រាយ​ពួក​វា​ដោយ (::) ជា​សញ្ញា​បំបែក ។ ធ្វើ​វា​ដូច​នេះ ៖"

#. Tag: userinput
#: cups-config.docbook:889
#, no-c-format
msgid "/path/to/first/fontdir/:/path/to/second/fontdir/:/path/to/last/fontdir/"
msgstr ""
"/path/to/first/fontdir/:/path/to/second/fontdir/:/path/to/last/fontdir/"

#. Tag: para
#: cups-config.docbook:892
#, no-c-format
msgid ""
"For the Font path directive to work as intended, the application that wants "
"to print needs to:"
msgstr "សម្រាប់​ផ្លូវ​ពុម្ព​អក្សរ​បង្គាប់​ធ្វើ​ការ​ដូច​ដែល​បាន​បម្រុង កម្មវិធី​ដែល​ចង់​បោះពុម្ព​ត្រូវការ ៖"

#. Tag: para
#: cups-config.docbook:897
#, no-c-format
msgid ""
"Either correctly reference its desired fonts in the header of the generated "
"&PostScript;"
msgstr "កែតម្រូវ​សេចក្តីយោង​ពុម្ពអក្សរ​ដែ​ល​អ្នកពេញ​ចិត្ត​​ក្នុងបឋមកថា​នៃ PostScript ដែល​បានបង្កើត ។"

#. Tag: para
#: cups-config.docbook:901
#, no-c-format
msgid "Or embed the font into the &PostScript; file."
msgstr "ឬ​បានបង្កប់​ពុម្ពអក្សរ​ក្នុង​ឯកសារ PostScript ។"

#. Tag: para
#: cups-config.docbook:905
#, no-c-format
msgid ""
"<emphasis>Referencing</emphasis> the font by name leaves it up to the "
"<acronym>RIP</acronym> and print device to respect and actually use it. "
"<acronym>RIP</acronym> or printer <emphasis>can</emphasis> only use the "
"desired font, if it is available on the system."
msgstr ""
"<emphasis>សេចក្តីយោង</emphasis> ពុម្ពអក្សរ​តាម​ឈ្មោះ ទុកវាដល់ <acronym>RIP</acronym> និង​"
"ឧបករណ៍​បោះពុម្ព​ដើម្បី​យោង និង​ពិត​ជា​ប្រើ​វា ។ <acronym>RIP</acronym> ឬ​ម៉ាស៊ីន​បោះពុម្ព "
"<emphasis>អាច​</emphasis> បាន​តែ​ប្រើ​ពុម្ពអក្សរ​ដែល​ពេញ​ចិត្តិ បើ​វា​អាច​រក​បានលើ​ប្រព័ន្ធ ។"

#. Tag: para
#: cups-config.docbook:910
#, no-c-format
msgid ""
"In the case of a &PostScript; printer, this needs to be a printer-resident "
"font. If the printers doesn't have this font, it will try and replace it by "
"an adequately similar font."
msgstr ""
"ក្នុងករណី​​ម៉ាស៊ីន​បោះពុម្ព PostScript ត្រូវ​ការ​ម៉ាស៊ីនបោះពុម្ពពុម្ពអក្សរ​ដែល​មាន ។ បើ​ម៉ាស៊ីន​បោះពុម្ព​ពុំ​មាន​"
"ពុម្ព​អក្សរ​នេះទេ វា​ព្យាយាម​ និង​ជំនួស ដោយ​ពុម្ពអក្សរ​ដែល​មានលក្ខណៈ​ស្រដៀង​គ្នា ។"

#. Tag: para
#: cups-config.docbook:914
#, no-c-format
msgid ""
"In the case of a non &PostScript; printer, this is done by &CUPS; and its "
"<acronym>RIP</acronym>-ing filtering system. &CUPS; will use the font path "
"directive to grab the correct font when <acronym>RIP</acronym>-ing the "
"&PostScript; in the <command>pstoraster</command> filter."
msgstr ""
"ក្នុង​ករណី​គ្មាន​​ម៉ាស៊ីន​បោះពុម្ព PostScript វា​ធ្វើ​រួច​ដោយ CUPS និង​​ប្រព័ន្ធ​តម្រង <acronym>RIP</"
"acronym> របស់​វា ។ CUPS នឹង​ប្រើ​ផ្លូវ​ពុម្ព​អក្សរ​បន្គាប់​ដើម្បី​ចាប់​ពុម្ព​អក្សរ​ត្រឹមត្រូវ​ពេល "
"<acronym>RIP</acronym> PostScript ក្នុង​តម្រង <command>pstoraster</command> ។"

#. Tag: para
#: cups-config.docbook:920
#, no-c-format
msgid ""
"In the case of a &PostScript; output device, &CUPS; is just spooling the "
"file (actually, it is passing it through the <command>pstops</command> "
"filter for accounting or n-up purposes), not <quote>working</quote> on it. "
"Therefore, if you print to a &PostScript; printer it is solely the printer's "
"responsibility to use the font asked for. It can't, if the font is neither "
"loaded into the printer nor embedded in the &PostScript;."
msgstr ""
"ក្នុង​ករណីឧបករណ៍​ទិន្នផល​នៃ PostScript, CUPS គ្រាន់​តែ​ជាស្នូល​ឯកសារ (ជាការពិត វា​កំពុង​ឆ្លងកាត់​តាម​​"
"តម្រង <command>pstops</command> ​សម្រាប់​គណនី ឬ​គោលបំណង) មិន <quote>ធ្វើការ​ងារ </"
"quote> លើ​វា ។ ដូច្នេះ បើអ្នកបោះពុម្ព PostScript ម៉ាស៊ីន​បោះពុម្ព​វា​ជា​ការ​ទទួលខុសត្រូវ​"
"របស់ម៉ាស៊ីនបោះពុម្ព​តែម្នាក់​ឯង ដើម្បី​ប្រើ​ពុម្ព​អក្សរ​ដែលបានស្នើរ ។ វា​មិនអាច​ទៅ​រួច​ទេ បើ​ពុម្ពអក្សរ "
"ផ្សេងទៀត​មិន​ត្រូវ​បាន​ផ្ទុក​ក្នុង​ម៉ាស៊ីនបោះពុម្ព ឬ​បានបង្កប់​ក្នុង PostScript ឡើយ ។"

#. Tag: title
#: cups-config.docbook:934
#, no-c-format
msgid "Server <acronym>HTTP</acronym> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ <acronym>HTTP</acronym>"

#. Tag: para
#: cups-config.docbook:937
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server &HTTP; settings is shown here."
msgstr "ប្រអប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ការកំណត់ HTTP ត្រូវ​បានបង្ហាញ​នៅទី​នេះ ។"

#. Tag: para
#: cups-config.docbook:939
#, no-c-format
msgid "&CUPS; server &HTTP; settings are the following ones:"
msgstr "ការកំណត់ HTTP ម៉ាស៊ីនបម្រើ CUPS ត្រូវ​ដូច​ខាងក្រោម​នេះ ៖"

#. Tag: para
#: cups-config.docbook:941
#, no-c-format
msgid "the <guilabel>Document folder</guilabel>"
msgstr "<guilabel>ថត​ឯកសារ</guilabel>"

#. Tag: para
#: cups-config.docbook:942
#, no-c-format
msgid "the <guilabel>Default Language</guilabel>"
msgstr "<guilabel>ភាសា​លំនាំដើម</guilabel>"

#. Tag: para
#: cups-config.docbook:943
#, no-c-format
msgid "the <guilabel>Default Charset</guilabel>"
msgstr "<guilabel>សំណុំ​តួអក្សរ​លំនាំ​ដើម</guilabel>"

#. Tag: screeninfo
#: cups-config.docbook:947
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; server &HTTP; settings</"
"screeninfo>"
msgstr "<screeninfo>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ការ​កំណត់ HTTP</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:954
#, no-c-format
msgid "<phrase>Dialog to configure the &CUPS; server &HTTP; settings</phrase>"
msgstr "<phrase>ប្រអប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ការកំណត់ HTTP</phrase>"

#. Tag: guilabel
#: cups-config.docbook:961
#, no-c-format
msgid "Document folder"
msgstr "ថត​ឯកសារ"

#. Tag: para
#: cups-config.docbook:963
#, no-c-format
msgid ""
"The root folder for &HTTP; documents that are served. By default the "
"compiled in folder, <filename class=\"directory\">/usr/share/cups/doc</"
"filename>"
msgstr ""
"ថត​រូត​សម្រាប់​ឯកសារ HTTP ដែល​ត្រូវ​បាន​រក្សា​ទុក ។ តាម​​លំនាំ​ដើម​​បាន​ចងក្រង​ក្នុង​ថត <filename class="
"\"directory\">/usr/share/cups/doc</filename>"

#. Tag: guilabel
#: cups-config.docbook:970
#, no-c-format
msgid "Default Language"
msgstr "ភាសា​លំនាំ​ដើម"

#. Tag: para
#: cups-config.docbook:972
#, no-c-format
msgid ""
"The default language, if not specified by the browser. If not specified, the "
"current locale is used."
msgstr ""
"ភាសា​លំនាំ​ដើម បើ​មិនបាន​បញ្ជាក់​តាម​កម្មវិធីរុករក​បណ្តាញ ។ បើ​មិន​បញ្ជាក់ មូលដ្ឋាន​បច្ចុប្បន្ន​ត្រូវ​បាន​ប្រើ ។"

#. Tag: para
#: cups-config.docbook:975
#, no-c-format
msgid ""
"Use the two letter locale codes, for example <userinput>en</userinput> or "
"<userinput>de</userinput>."
msgstr ""
"ប្រើ​កូដ​មូលដ្ឋាន​តួអក្សរ​ពីរ ឧទាហរណ៍ <userinput>km</userinput> ឬ <userinput>de</"
"userinput> ។"

#. Tag: guilabel
#: cups-config.docbook:983
#, no-c-format
msgid "Default charset"
msgstr "សំណុំ​តួ​អក្សរ​លំនាំ​ដើម"

#. Tag: para
#: cups-config.docbook:985
#, no-c-format
msgid ""
"The default character set to use. If not specified, this defaults to UTF-8. "
"This can also be overridden directly in the <acronym>HTML</acronym> "
"documents."
msgstr ""
"សំណុំ​តួ​អក្សរ​លំនាំដើម​ត្រូវ​ប្រើ ។ បើមិនទាន់​បាន​បញ្ជាក់ លំនាំដើម​គឺ UTF-8 ។ ការនេះអាច​បដិសេធ​ដោយ​ផ្ទាល់​"
"ក្នុង​ឯកសារ <acronym>HTML</acronym> ផង​ដែរ ។"

#. Tag: guilabel
#: cups-config.docbook:994
#, no-c-format
msgid "Server encryption support configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​គាំទ្រ​ការ​អ៊ីនគ្រីប​ម៉ាស៊ីន​បម្រើ"

#. Tag: para
#: cups-config.docbook:996
#, no-c-format
msgid ""
"This is the dialog to configure the &CUPS; server security settings. The "
"server encryption support settings are these:"
msgstr ""
"នេះ​ជា​ប្រអប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​សុវត្ថិភាព​ម៉ាស៊ីន​បម្រើ CUPS ។ ការ​កំណត់​គាំទ្រ​ការ​អ៊ីនគ្រីប​ម៉ាស៊ីនបម្រើ​គឺ​"
"ទាំងអស់​នេះ ៖"

#. Tag: para
#: cups-config.docbook:1000
#, no-c-format
msgid ""
"<guilabel>Server certificate</guilabel>: the file to read containing the "
"server's certificate"
msgstr ""
"<guilabel>វិញ្ញាបនបត្រ​ម៉ាស៊ីន​បម្រើ​</guilabel> ៖ ឯកសារ​សម្រាប់​អាន​មាន​វិញ្ញាបនបត្រ​របស់ម៉ាស៊ីនបម្រើ"

#. Tag: para
#: cups-config.docbook:1002
#, no-c-format
msgid "Server key: the file to read containing the server's key"
msgstr "កូនសោ​ម៉ាស៊ីន​បម្រើ ៖ ឯកសារ​សម្រាប់​អាន​មាន​កូនសោ​របស់​ម៉ាស៊ីន​បម្រើ"

#. Tag: screeninfo
#: cups-config.docbook:1006
#, no-c-format
msgid "&CUPS; server configuration dialog: security overview"
msgstr "ប្រអប់​ការកំណត់​រចនាសម្ព័ន្ធ​ម៉ាស៊ីនបម្រើ CUPS ៖ ទិដ្ឋភាពទូទៅ​សុវត្ថិភាព "

#. Tag: phrase
#: cups-config.docbook:1012
#, no-c-format
msgid "The dialog to configure the &CUPS; server: security settings"
msgstr "ប្រអប់​សម្រាប់​កំណត់រចនាសម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ៖ ការកំណត់​សុវត្ថិភាព"

#. Tag: guilabel
#: cups-config.docbook:1018
#, no-c-format
msgid "Server certificate"
msgstr "វិញ្ញាបនបត្រ​ម៉ាស៊ីន​បម្រើ"

#. Tag: para
#: cups-config.docbook:1020
#, no-c-format
msgid ""
"The file to read containing the server's certificate. Defaults to <filename>/"
"etc/cups/ssl/server.crt</filename>."
msgstr ""
"ឯកសារ​សម្រាប់​អាន​មាន​វិញ្ញាបនបត្រ​របស់​ម៉ាស៊ីន​បម្រើ ។ លំនាំដើម <filename>/etc/cups/ssl/server."
"crt</filename> ។"

#. Tag: guilabel
#: cups-config.docbook:1026
#, no-c-format
msgid "Server key"
msgstr "កូនសោ​ម៉ាស៊ីន​បម្រើ​"

#. Tag: para
#: cups-config.docbook:1028
#, no-c-format
msgid ""
"The file to read containing the server's key. Defaults to <filename>/etc/"
"cups/ssl/server.key</filename>"
msgstr ""
"ឯកសារ​សម្រាប់អាន​មាន​កូនសោ​ម៉ាស៊ីន​បម្រើ ។ លំនាំដើម​ទៅ <filename>/etc/cups/ssl/server.key</"
"filename>"

#. Tag: title
#: cups-config.docbook:1037
#, no-c-format
msgid "Server Miscellaneous Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ​ច្រើន"

#. Tag: para
#: cups-config.docbook:1039
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server miscellaneous settings is shown "
"here. The following server settings are done through this screen:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​បម្រើ​ផ្សេងៗ CUPS គឺ​ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។ ការ​កំណត់​ម៉ាស៊ីន​"
"បម្រើ​ខាងក្រោម​នេះ​ត្រូវ​បាន​ធ្វើ​រួច​តាម​រយៈ​អេក្រង់​នេះ ៖"

#. Tag: para
#: cups-config.docbook:1044
#, no-c-format
msgid ""
"<guilabel>Preserve job history</guilabel>: whether to preserve a job history "
"for later re-view"
msgstr ""
"<guilabel>ការពារ​ប្រវត្តិ​ការងារ</guilabel> ៖ ទោះជា​ការពារ​ប្រវត្តិ​ការងារ​សម្រាប់​ទិដ្ឋភាពលើក​"
"ក្រោយ​ឡើង​វិញ "

#. Tag: para
#: cups-config.docbook:1046
#, no-c-format
msgid ""
"<guilabel>Preserve job files</guilabel>: whether to preserve fully "
"<acronym>RIP</acronym>-ed job files for later re-print"
msgstr ""
"<guilabel>ការពារ​ឯកសារ​ការងារ</guilabel> ៖ ទោះ​ជា​ការពារ <acronym>RIP</acronym> "
"ឯកសារ​ការងារ​សម្រាប់​បោះពុម្ព​លើកក្រោយ​ឡើង​វិញ​ក៏​ដោយ"

#. Tag: para
#: cups-config.docbook:1049
#, no-c-format
msgid ""
"<guilabel>Printcap file</guilabel>: setting the name of and the path to a "
"printcap file"
msgstr ""
"<guilabel>ឯកសារ Printcap</guilabel> ៖ ការកំណត់​ឈ្មោះ និង​ផ្លូវ​ទៅ​កាន់​ឯកសារ printcap"

#. Tag: para
#: cups-config.docbook:1051
#, no-c-format
msgid ""
"<guilabel>RIP Cache</guilabel>: setting the size of the <acronym>RIP</"
"acronym> cache in memory"
msgstr ""
"<guilabel>ឃ្លាំងសម្ងាត់ RIP</guilabel> ៖ ការកំណត់​ទំហំនៃ​ឃ្លាំងសម្ងាត់ <acronym>RIP</"
"acronym> ក្នុង​សតិ​"

#. Tag: para
#: cups-config.docbook:1053
#, no-c-format
msgid "<guilabel>Filter Limit</guilabel>: defining a filter limit"
msgstr "<guilabel>ដែន​កំណត់​តម្រង</guilabel> ៖ កំណត់​ដែន​កំណត់​តម្រង​"

#. Tag: screeninfo
#: cups-config.docbook:1058
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; server miscellaneous settings</"
"screeninfo>"
msgstr "<screeninfo>ប្រអប់​កំណត់​​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​បម្រើ CUPS ផ្សេងៗ</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1064
#, no-c-format
msgid ""
"<phrase>Dialog to configure the &CUPS; server miscellaneous settings</phrase>"
msgstr "<phrase>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​បម្រើ CUPS ផ្សេងៗ</phrase>"

#. Tag: guilabel
#: cups-config.docbook:1071
#, no-c-format
msgid "Preserve job history (after completion)"
msgstr "ការពារ​ប្រវត្តិ​ការងារ (បន្ទាប់​ពី​បញ្ចប់)"

#. Tag: para
#: cups-config.docbook:1073
#, no-c-format
msgid ""
"Whether or not to preserve the job history after a job is completed, "
"canceled, or stopped. The default is yes"
msgstr ""
"ទោះបីជា​ការពារ ឬ​មិន​ការពារ​​ប្រវត្តិការងារ​បន្ទាប់​ពី​ការងារ​ត្រូវ​បាន​បញ្ចប់ បោះបង់ ឬ​បញ្ឈប់ ។ លំនាំ​ដើម​គឺ​"
"បាទ/ចាស"

#. Tag: guilabel
#: cups-config.docbook:1079
#, no-c-format
msgid "Preserve job file (after completion)"
msgstr "ការពារឯកសារ​ការងារ (បន្ទាប់​ពី​បញ្ចប់)"

#. Tag: para
#: cups-config.docbook:1081
#, no-c-format
msgid ""
"Whether or not to preserve the job files after a job is completed, canceled, "
"or stopped. The default is no."
msgstr ""
"ទោះបីជា​ការពារ ឬ​មិន​ការពារ​​ប្រវត្តិការងារ​បន្ទាប់​ពី​ការងារ​ត្រូវ​បាន​បញ្ចប់​ក៏ដោយ ​វា​ត្រូវ​បានបោះបង់​ចោល "
"ឬ​បញ្ឈប់ ។ លំនាំ​ដើម​គឺ​ទេ ។"

#. Tag: guilabel
#: cups-config.docbook:1087
#, no-c-format
msgid "Printcap file"
msgstr "ឯកសារ Printcap"

#. Tag: para
#: cups-config.docbook:1089
#, no-c-format
msgid ""
"The name of the printcap file. The default is no filename. Leave this blank, "
"to disable printcap file generation."
msgstr ""
"ឈ្មោះ​ឯកសារ printcap ។ លំនាំ​ដើម​គឺ​គ្មាន​ឈ្មោះ​ឯកសារ ។ ចេញ​ពីកន្លែង​ទទេ​នេះ ដើម្បី​​បិទ​ការបង្កើត​"
"ឯកសារ printcap ។"

#. Tag: para
#: cups-config.docbook:1091
#, no-c-format
msgid ""
"The printcap setting is only needed to satisfy older applications in need of "
"such a file."
msgstr "ការកំណត់ printcap ត្រូវ​ការតែកម្មវិធី​ចាស់ៗចាំបាច់​ត្រូវ​បាន​ឯកសារ ។"

#. Tag: guilabel
#: cups-config.docbook:1097
#, no-c-format
msgid "RIP cache"
msgstr "ឃ្លាំង​សម្ងាត់ RIP"

#. Tag: para
#: cups-config.docbook:1099
#, fuzzy, no-c-format
#| msgid ""
#| "The amount of memory that each <acronym>RIP</acronym> should use to cache "
#| "bitmaps. The value can be any real number, followed by <quote>k</quote> "
#| "for kilobytes, <quote>m</quote> for megabytes, <quote>g</quote>for "
#| "gigabytes, or <quote>t</quote> for tiles, where one tile is 256 x 256 "
#| "pixels. The default value is 8m."
msgid ""
"The amount of memory that each <acronym>RIP</acronym> should use to cache "
"bitmaps. The value can be any real number, followed by <quote>k</quote> for "
"kilobytes, <quote>m</quote> for megabytes, <quote>g</quote> for gigabytes, "
"or <quote>t</quote> for tiles, where one tile is 256 x 256 pixels. The "
"default value is 8m."
msgstr ""
"ចំនួន​សតិ​នៃ <acronym>RIP</acronym> ​នីមួយ​ៗ​ត្រូវ​ការ​ប្រើ​ដើម្បី​ដាក់​រូបភាព​ឃ្លាំសម្ងាត់ ។ តម្លៃ​វា​អាច​"
"ជា​តម្លៃ​ពិត​ណា​មួយ ដែល​នៅ​ពី​ក្រោយ​មាន <quote>k</quote> ​សម្រាប់​គីឡូបៃ <quote>m</quote> "
"មេកាបៃ <quote>g</quote> ជីកាបៃ ឬ <quote>t</quote> ក្រឡា ក្បឿង ក្រឡាក្បឿង​គឺ ២៥៦ x "
"២៥៦ ភីកសែល ។ លំនាំដើម​គឺ ៨ ម៉ែត្រ ។"

#. Tag: guilabel
#: cups-config.docbook:1108
#, no-c-format
msgid "Filter limit"
msgstr "ដែន​កំណត់​តម្រង​"

#. Tag: para
#: cups-config.docbook:1110
#, no-c-format
msgid ""
"Sets the maximum cost of all job filters that can be run at the same time. A "
"limit of 0 means no limit. A typical job may need a filter limit of at least "
"200. Limits less than the minimum required by a job force a single job to be "
"printed at any time. The default limit is 0 (unlimited)."
msgstr ""
"កំណត់​តម្លៃ​អតិបរមា​នៃ​តម្រង​ការងារ​ទាំងអស់ ដែល​អាច​រត់​ក្នុង​ពេល​តែ​មួយ ។ លីមីត​នៃ ០ មានន័យ​ថា​គ្មាន​ដែន​"
"កំណត់ ។ ការងារ​សំខាន់​ប្រហែល​ជា​ត្រូវ​ការ​ដែន​កំណត់​តម្រង​យ៉ាង​ហោច​ណាស់ ២០០ ដែរ ។ ដែន​កំណត់​តិច​ជាង​អប្បបរមា​"
"ដែល​ទាមទារ​ដោយ​ការងារ​បង្ខំការងារ​តែ​មួយ​ឲ្យ​បោះពុម្ព​នៅ​ពេល​ណា​មួយ ។ ដែន​កំណត់​លំនាំ​ដើម​គឺ ០ (គ្មាន​ដែន​"
"កំណត់​) ។"

#. Tag: title
#: cups-config.docbook:1121
#, no-c-format
msgid "Network General Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​​បណ្តាញ​ទូទៅ"

#. Tag: para
#: cups-config.docbook:1123
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server network settings is shown here. It "
"includes:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនាសម្ព័ន្ធ​ការ​កំណត់​​បណ្តាញ​ម៉ាស៊ីនបម្រើ CUPS ត្រូវ​បង្ហាញ​នៅទី​នេះ ។ វា​រួម​មាន ៖"

#. Tag: guilabel
#: cups-config.docbook:1127 cups-config.docbook:1147
#, no-c-format
msgid "Look for hostname on IP addresses"
msgstr "រក​ឈ្មោះ​ម៉ាស៊ីន​នៅ​លើ​អាសយដ្ឋាន IP"

#. Tag: guilabel
#: cups-config.docbook:1129 cups-config.docbook:1156
#, no-c-format
msgid "Port"
msgstr "ច្រក"

#. Tag: guilabel
#: cups-config.docbook:1130 cups-config.docbook:1181
#, no-c-format
msgid "Max request size"
msgstr "ទំហំ​​ស្នើ​អតិបរមា"

#. Tag: guilabel
#: cups-config.docbook:1131 cups-config.docbook:1189
#, no-c-format
msgid "Timeout"
msgstr "អស់​ពេល​"

#. Tag: screeninfo
#: cups-config.docbook:1135
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; server network settings</"
"screeninfo>"
msgstr "<screeninfo>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​បណ្ដាញ​ម៉ាស៊ីន​បម្រើ CUPS</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1141
#, no-c-format
msgid "<phrase>Dialog to configure the &CUPS; server network settings</phrase>"
msgstr "<phrase>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំនត់​បណ្ដាញ​ម៉ាស៊ីន​បម្រើ CUPS</phrase>"

#. Tag: para
#: cups-config.docbook:1149
#, no-c-format
msgid ""
"Whether or not to do lookups on <acronym>IP</acronym> addresses to get a "
"fully-qualified hostname. This defaults to off, for performance reasons."
msgstr ""
"ទោះ​ជា​មិនរក​មើល​លើ​អាសយដ្ឋាន <acronym>IP</acronym> ដើម្បីទទួល​បាន​នូវ​ឈ្មោះ​ម៉ាស៊ីន​​ដែលមាន​គុណភាព​"
"ខ្ពស់​ពេញ​លេញ ។ លំនាំដើម​គឺ បិទ សម្រាប់​ហេតុ​ផល​ដំណើរ​ការ ។"

#. Tag: para
#: cups-config.docbook:1158
#, no-c-format
msgid ""
"Enter here Ports and addresses that the server will listen to. The default "
"port 631 is reserved for the Internet Printing Protocol, and is what we use "
"here."
msgstr ""
"បញ្ចូល​ច្រក និង​អាសយដ្ឋាន​ដែល​ម៉ាស៊ីនបម្រើ​នឹង​ស្តាប់ ។ ច្រក​លំនាំដើម​គឺ ៦៣១ ត្រូវ​បានបម្រុង​ទុក​សម្រាប់​ពិធីការ​"
"ការ​បោះពុម្ព​លើ​អ៊ីនធឺណិត ហើយ​គឺ​ជា​អ្វី​ដែល​យើង​ត្រូវ​ប្រើ​នៅទីនេះ ។"

#. Tag: para
#: cups-config.docbook:1161
#, no-c-format
msgid ""
"You can have multiple entries, to listen to more than one port or address, "
"or to restrict access."
msgstr ""
"អ្នកអាច​មាន​ធាតុ​ច្រើន ដើម្បីស្តាប់​ច្រក​ច្រើន​ជាង​មួយ ឬ​អាសយដ្ឋាន ឬ​ដើម្បី​កម្រិត​ការ​ចូល​ដំណើរ​ការ ។"

#. Tag: para
#: cups-config.docbook:1164
#, no-c-format
msgid ""
"Unfortunately, most web browsers don't support <acronym>TLS</acronym> or "
"&HTTP; upgrades for encryption. If you want to support web-based encryption, "
"you'll probably need to listen on port 443, the <acronym>HTTPS</acronym> "
"port."
msgstr ""
"ជា​អកុសល កម្មវិធី​រុករក​បណ្តាញ​​មិន​គាំទ្រ​ភាព​ទាន់​សម័យ <acronym>TLS</acronym> ឬ HTTP សម្រាប់​​"
"ការអ៊ីនគ្រីប​ឡើយ ។ បើ​អ្នកចង់​គាំទ្រ​ការអ៊ីនគ្រីប អ្នកប្រហែល​ជា​ត្រូវ​ការ​ស្តាប់​ពី​ច្រក ៤៤៣ ច្រក "
"<acronym>HTTPS</acronym> ។"

#. Tag: para
#: cups-config.docbook:1169
#, no-c-format
msgid ""
"Use the <guibutton>Add</guibutton> and <guibutton>Remove</guibutton> buttons "
"to add and remove entries from the list."
msgstr ""
"ប្រើ​ប៊ូតុង <guibutton>បន្ថែម</guibutton> និង <guibutton>យក​ចេញ</guibutton> ដើម្បី​"
"បន្ថែម និង​យក​ចេញ​ធាតុ​ពី​បញ្ជី ។"

#. Tag: para
#: cups-config.docbook:1173
#, no-c-format
msgid ""
"You can enter ports on their own, &eg; <userinput>631</userinput>, or "
"hostnames with ports, &eg; <userinput>myhost:80</userinput> or "
"<userinput>1.2.3.4:631</userinput>."
msgstr ""
"អ្នកអាច​បញ្ចូល​លើច្រក​ផ្ទាល់​របស់​ពួកវា ឧទាហរណ៍ <userinput> ៦៣១</userinput>ឬ​ឈ្មោះ​ម៉ាស៊ីន​​ជា​មួយ​"
"ច្រក ឧទាហរណ៍ <userinput>myhost:80</userinput> ឬ <userinput>1.2.3.4:631</"
"userinput> ។"

#. Tag: para
#: cups-config.docbook:1183
#, no-c-format
msgid ""
"Controls the maximum size of &HTTP; requests and print files. The default "
"setting is 0, which disables this feature."
msgstr ""
"ត្រួតពិនិត្យ​ទំហំ​អតិបរមា​នៃ​សំណើរ HTTP និង​ឯកសារ ​បោះពុម្ព ។ ការកំណត់​លំនាំដើម​គឺ ០ ដែល​បិទលក្ខណៈពិសេស​"
"នេះ ។"

#. Tag: para
#: cups-config.docbook:1191
#, no-c-format
msgid ""
"The timeout (in seconds) before requests time out. The default is 300 "
"seconds."
msgstr "អស់ពេល (គិត​ជាវិនាទី​) មិន​សំណើរ​អស់ពេល ។ លំនាំដើម​គឺ ៣០០ វិនាទី ។"

#. Tag: title
#: cups-config.docbook:1200
#, no-c-format
msgid "Network Clients Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​បណ្តាញ​ម៉ាស៊ីន​ភ្ញៀវ​"

#. Tag: para
#: cups-config.docbook:1202
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; network client settings is shown here. It "
"includes:"
msgstr "ប្រអប់​សម្រាប់​កំណត់​រចនាសម្ព័ន្ធ​ម៉ាស៊ីនភ្ញៀវ​បណ្ដាញ CUPS ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។ វា​រួម​មាន ៖"

#. Tag: guilabel
#: cups-config.docbook:1206 cups-config.docbook:1224
#, no-c-format
msgid "Accept \"Keep Alive\" requests"
msgstr "យល់ព្រម​សំណើរ \"​រក្សា​ដំណើរការ​\" "

#. Tag: para
#: cups-config.docbook:1208
#, no-c-format
msgid "KeepAliveTimeout:"
msgstr "អស់​ពេល​រក្សា​ដំណើរ​ការ ៖​"

#. Tag: para
#: cups-config.docbook:1209
#, no-c-format
msgid "MaxClients:"
msgstr "ម៉ាស៊ីនភ្ញៀវ​អតិ ៖​"

#. Tag: screeninfo
#: cups-config.docbook:1212
#, no-c-format
msgid "dialog to configure the &CUPS; network client settings"
msgstr "ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​ភ្ញៀវ​បណ្ដាញ CUPS"

#. Tag: phrase
#: cups-config.docbook:1218
#, no-c-format
msgid "Dialog to configure the &CUPS; network client settings"
msgstr "ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​ភ្ញៀវ​បណ្ដាញ CUPS"

#. Tag: para
#: cups-config.docbook:1226
#, no-c-format
msgid ""
"Whether or not to support the Keep-Alive connection option. The default is "
"on."
msgstr "ទោះជា​គាំទ្រ​​ជម្រើស​ការតភ្ជាប់ Keep-Alive ។ លំនាំដើម​គឺ បើក ។"

#. Tag: guilabel
#: cups-config.docbook:1232
#, no-c-format
msgid "Keep alive timeout"
msgstr "អស់ពេល​រក្សា​ដំណើរ​ការ​"

#. Tag: para
#: cups-config.docbook:1234
#, no-c-format
msgid ""
"The timeout (in seconds) before Keep-Alive connections are automatically "
"closed. The default is 60 seconds."
msgstr ""
"អស់​ពេល (គិត​ជា​វិនាទី​) មុន​ការតភ្ជាប់​រក្សា​ឲ្យ​​​នូវ​ដំណើរការ​ត្រូវ​បាន​បិទ​ដោយ​ស្វ័យ​ប្រវត្តិ​ ។ លំនាំដើម​គឺ ៦០ "
"វិនាទី"

#. Tag: guilabel
#: cups-config.docbook:1240
#, no-c-format
msgid "Max number of clients"
msgstr "ចំនួន​អតិបរមា​នៃ​ម៉ាស៊ីន​ភ្ញៀវ​"

#. Tag: para
#: cups-config.docbook:1242
#, no-c-format
msgid ""
"Controls the maximum number of simultaneous clients that will be handled. "
"Defaults to 100."
msgstr "ត្រួតពិនិត្យ​ចំនួន​អតិបរមា​​នៃ​ម៉ាស៊ីន​ភ្ញៀវ​ជា​បន្តបន្ទាប់​ដែល​នឹង​ត្រូវ​បាន​ដោះស្រាយ ។ លំនាំដើម ១០០ ។"

#. Tag: title
#: cups-config.docbook:1251
#, no-c-format
msgid "Browsing General Configuration"
msgstr "រក​មើលល​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទូទៅ"

#. Tag: para
#: cups-config.docbook:1253
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; browsing general settings is shown here. "
"It includes:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធការ​រកមើល​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទូទៅ CUPS ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។ វា​រួម​"
"មាន ៖"

#. Tag: guilabel
#: cups-config.docbook:1257 cups-config.docbook:1280
#, no-c-format
msgid "Enable browsing"
msgstr "អនុញ្ញាត​ការរុករក​"

#. Tag: guilabel
#: cups-config.docbook:1258 cups-config.docbook:1288
#, no-c-format
msgid "Use short names when possible"
msgstr "ប្រើ​ឈ្មោះ​ខ្លី​ពេល​ដែល​អាច"

#. Tag: guilabel
#: cups-config.docbook:1260 cups-config.docbook:1299
#, no-c-format
msgid "Use implicit classes"
msgstr "ប្រើ​ថ្នាក់​ទាំងស្រុង​"

#. Tag: screeninfo
#: cups-config.docbook:1266
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; browsing general settings</"
"screeninfo>"
msgstr "<screeninfo>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​រកមើល​ការ​កំណត់​ទូទៅ CUPS</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1273
#, no-c-format
msgid ""
"<phrase>Dialog to configure the &CUPS; browsing general settings</phrase>"
msgstr "<phrase>ប្រអប់​សម្រាប់​កំនត់​រចនា​សម្ព័ន្ធ​ការ​រកមើល​ការ​កំណត់​ទូទៅ CUPS</phrase>"

#. Tag: para
#: cups-config.docbook:1282
#, no-c-format
msgid ""
"Whether or not to broadcast printer information to other &CUPS; servers. "
"Enabled by default."
msgstr ""
"ទោះជា​មិន​បាន​ផ្សាយ​ព័ត៌មាន​ម៉ាស៊ីនបោះពុម្ព​ទៅ​ម៉ាស៊ីន​បម្រើ CUPS ដទៃទៀត​ក៏ដោយ ។ បើក​ដោយ​លំនាំ​ដើម ។​"

#. Tag: para
#: cups-config.docbook:1290
#, no-c-format
msgid ""
"Whether or not to use <quote>short</quote> names for remote printers when "
"possible (&eg; <systemitem class=\"resource\">printer</systemitem> instead "
"of <systemitem class=\"resource\">printer@host</systemitem>). Enabled by "
"default."
msgstr ""
"ទោះ​ជា​មិន​ប្រើ​ឈ្មោះ <quote>ខ្លី</quote> របស់​ម៉ាស៊ីន បោះពុម្ព​ពី​ចម្ងាយ ពេល​ដែល​អាច​រក​បាន (ឧទាហរណ៍ "
"<systemitem class=\"resource\"> ម៉ាស៊ីន​បោះពុម្ព</systemitem> ជំនួស​ឲ្យ <systemitem "
"class=\"resource\">printer@host</systemitem>) ។ លំនាំដើម​ត្រូវ​បានអនុញ្ញាត ។"

#. Tag: para
#: cups-config.docbook:1301
#, no-c-format
msgid "Whether or not to use implicit classes."
msgstr "ទោះជា​មិន​ប្រើ​ថាក់​ទាំងស្រុង​ក៏​ដោយ ។"

#. Tag: para
#: cups-config.docbook:1302
#, no-c-format
msgid ""
"Printer classes can be specified explicitly, in the <filename>classes.conf</"
"filename> file, implicitly based upon the printers available on the "
"<acronym>LAN</acronym>, or both."
msgstr ""
"ថ្នាក់​ម៉ាស៊ីន​បោះពុម្ព​អាច​ត្រូវ​បាន​បញ្ជាក់​​យ៉ាង​ជាក់លាក់​ក្នុង​ឯកសារ <filename>classes.conf</"
"filename> ដែល​មាន​មូលដ្ឋាន​ទាំងស្រុង​នៃ ម៉ាស៊ីន​បោះពុម្ព​ដែល​អាច​រក​បាន​នៅ​លើ <acronym>បណ្តាញ​"
"មូលដ្ឋាន</acronym> ឬ​ទាំងពីរ​តែ​ម្តង​ ។"

#. Tag: para
#: cups-config.docbook:1305
#, no-c-format
msgid ""
"When Implicit classes are enabled, printers on the <acronym>LAN</acronym> "
"with the same name (&eg; <systemitem class=\"resource\">Acme-"
"LaserPrint-1000</systemitem>) will be put into a class with the same name. "
"This allows you to setup multiple redundant queues on a <acronym>LAN</"
"acronym> without a lot of administrative difficulties. If a user sends a job "
"to <systemitem class=\"resource\">Acme-LaserPrint-1000</systemitem>, the job "
"will go to the first available queue."
msgstr ""
"នៅពេល​ដែល​ថ្នាក់​ទាំងស្រុង​ត្រូវ​បាន​អនុញ្ញាត​ម៉ាស៊ីន​បោះពុម្ព​លើ <acronym> បណ្តាញ​មូលដ្ឋាន </acronym> "
"ដែលមានឈ្មោះ​ដូចគ្នា (ឧទាហរណ៍ <systemitem class=\"resource\">Acme-LaserPrint-1000</"
"systemitem>) នឹង​ត្រូវ​បាន​ដាក់​ក្នុង​ថ្នាក់​ដែល​មាន​ឈ្មោះ​ដូចគ្នា ។ ការ​ធ្វើ​របៀប​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​រៀបចំ​"
"ម៉ាស៊ីនបោះពុម្ព​ដែល​មាន​ឈ្មោះ​ដដែល​ៗ​ជា​បន្តបន្ទាប់​លើ <acronym>បណ្តាញ​មូលដ្ឋាន</acronym> ដោយ​"
"បំបាត់នូវ​ផលវិបាក​នៃ​ការគ្រប់គ្រង ។ បើ​អ្នក​ប្រើផ្ញើ​ការងារ​ទៅ <systemitem class=\"resource"
"\">Acme-LaserPrint-1000</systemitem> ការងារត្រឡប់​​​រៀប​ជា​ជួរ​ដែល​អាច​រក​បាន ។"

#. Tag: para
#: cups-config.docbook:1313
#, no-c-format
msgid "This option is enabled by default."
msgstr "ជម្រើស​នេះ​ត្រូវ​បាន​បើក​ដោយ​លំនាំ​ដើម ។"

#. Tag: title
#: cups-config.docbook:1320
#, no-c-format
msgid "Browsing Connection Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​រកមើល​ការ​តភ្ជាប់"

#. Tag: para
#: cups-config.docbook:1322
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server browsing connection is shown here. "
"Browsing connection settings include:"
msgstr ""
"ប្រអប់​ត្រូវ​កំណត់​រចនា​សម្ព័ន្ធ​រកមើល​ការ​តភ្ជាប់​ម៉ាស៊ីន​បម្រើ CUPS ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។ ការ​កំណត់​រកមើល​"
"ការ​តភ្ជាប់​រួម​មាន ៖"

#. Tag: para
#: cups-config.docbook:1326
#, no-c-format
msgid ""
"<guilabel>Broadcast addresses</guilabel>: The (<acronym>UDP</acronym>) "
"broadcast address to transmit printer information to"
msgstr ""
"<guilabel>អាសយដ្ឋាន​ផ្សាយ</guilabel> ៖ (<acronym>UDP</acronym>) ផ្សាយ​អាសយដ្ឋាន​ដើម្បី​"
"បញ្ចូន​​ព័ត៌មាន​​ម៉ាស៊ីន​បោះពុម្ព​ទៅ​កាន់"

#. Tag: para
#: cups-config.docbook:1329
#, no-c-format
msgid ""
"<guilabel>Broadcast Port</guilabel>: The port number to use for broadcasting"
msgstr "<guilabel>ផ្សាយ​ច្រក</guilabel> ៖ លេខ​ច្រក​ត្រូវ​បាន​ប្រើ​សម្រាប់​ការផ្សាយ ។​"

#. Tag: para
#: cups-config.docbook:1331
#, no-c-format
msgid ""
"<guilabel>Poll addresses</guilabel>: The address(es) to poll for information "
"about printers on servers that might not broadcast (or whose broadcasts "
"might not reach your <acronym>LAN</acronym> due to routers in between)."
msgstr ""
"<guilabel>អាសយដ្ឋាន Poll</guilabel> ៖ អាសយដ្ឋាន poll សម្រាប់ព័ត៌មានអំពី​ម៉ាស៊ីនបោះពុម្ព​លើ​"
"ម៉ាស៊ីន​បម្រើតែ​មិនបានផ្សាយទេ (ឬ​ការ​ផ្សាយ​មិន​អាច​ទៅ​ដល់ <acronym>បណ្តាញ​មូលដ្ឋាន</acronym> របស់​"
"អ្នក​ដោយ​សា​តែ​រ៉ោតទ័រ) ។"

#. Tag: screeninfo
#: cups-config.docbook:1338
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; server browsing connection</"
"screeninfo>"
msgstr ""
"<screeninfo>ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​តភ្ជាប់​ការរុករក​ម៉ាស៊ីន​បម្រើ CUPS</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1345
#, no-c-format
msgid ""
"<phrase>Dialog to configure the &CUPS; server browsing connection</phrase>"
msgstr "<phrase>ប្រអប់​សម្រាប់​​កំណត់​រចនា​សម្ព័ន្ធ​រក​មើល​ការ​តភ្ជាប់​ម៉ាស៊ីន​បម្រើ CUPS</phrase>"

#. Tag: guilabel
#: cups-config.docbook:1352
#, no-c-format
msgid "Broadcast addresses"
msgstr "អាសយដ្ឋាន​​ផ្សាយ​"

#. Tag: para
#: cups-config.docbook:1354
#, no-c-format
msgid ""
"After pressing the <guibutton>Add</guibutton> button, you will see the "
"following dialog to enter a new value for outgoing broadcasting browse "
"packets. It is the same kind of dialog as for adding other &CUPS; server "
"addresses to be polled for printer information."
msgstr ""
"បន្ទាប់​ពី​ចុច​ប៊ូតុង <guibutton>បន្ថែម</guibutton> អ្នក​នឹង​ឃើញ​ប្រអប់​ដូច​ខាងក្រោម​ដើម្បី​បញ្ចូល​តម្លៃ​ថ្មី​"
"សម្រាប់​ផ្សាយ​ចេញ​កញ្ចប់​ព័ត៌មាន​ការ​រកមើល ។ វា​គឺ​ជា​ប្រភេទ​ប្រអប់​ដូច​គ្នា​សម្រាប់​ដែល​សម្រាប់​បន្ថែម​អាសយដ្ឋាន​"
"ម៉ាស៊ីន​បម្រើ CUPS ផ្សេង​ទៀត​ឲ្យ​ស្ទង់​មតិ​សម្រាប់​ព័ត៌មាន​ម៉ាស៊ីន​បោះពុម្ព ។"

#. Tag: screeninfo
#: cups-config.docbook:1361
#, no-c-format
msgid ""
"<screeninfo>Dialog to enter a new value for broadcasting browse packets to</"
"screeninfo>"
msgstr "<screeninfo>ប្រអប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​កញ្ចប់​រុករក​ការផ្សាយ</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1368
#, no-c-format
msgid ""
"<phrase>Dialog to enter a new value for broadcasting browse packets to</"
"phrase>"
msgstr "<phrase>ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​ផ្សាយ​កញ្ចប់​ព័ត៌មាន​ការ​រុករក​ទៅ</phrase>"

#. Tag: para
#: cups-config.docbook:1373
#, no-c-format
msgid ""
"This option specifies a broadcast address to be used. By default, browsing "
"information is broadcast to all active interfaces."
msgstr ""
"ជម្រើស​នេះ​បញ្ជាក់​ពី​អសយដ្ឋាន​ផ្សាយ​ដែល​ត្រូវ​បាន​ប្រើ ។ តាម​លំនាំដើមការរុករក​ព័តឥមាន​ផ្សាយ​​ទៅ គ្រប់​ចំណុច​"
"ប្រទាក់​សកម្ម​ទាំងអស់​ ។"

#. Tag: para
#: cups-config.docbook:1378
#, no-c-format
msgid ""
"&HP-UX; 10.20 and earlier do not properly handle broadcast unless you have a "
"Class A, B, C or D netmask (&ie;, there is no <acronym>CIDR</acronym> "
"support)."
msgstr ""
"HP-UX 10.20 និង​ពី​ដំបូង​មិន​ទាន់​បាន​ដោះស្រាយ​ការ​ផ្សាយ​ត្រឹមត្រូវ ទាល់តែ​អ្នក​មាន​ថ្នាក់​របាំង​បណ្ដាញ A, "
"B, C ឬ D netmask (ឧ. មិន​គាំទ្រ <acronym>CIDR</acronym>) ។"

#. Tag: guilabel
#: cups-config.docbook:1386
#, no-c-format
msgid "Broadcast port"
msgstr "ច្រក​ផ្សាយ"

#. Tag: para
#: cups-config.docbook:1388
#, no-c-format
msgid ""
"The port used for <acronym>UDP</acronym> broadcasts. By default this is the "
"<acronym>IPP</acronym> port; if you change this, you need to do it on all "
"servers. Only one BrowsePort is recognized."
msgstr ""
"ច្រក​ដែល​ប្រើ​សម្រាប់​ការ​ផ្សាយ <acronym>UDP</acronym> ។ ដោយ​លំនាំ​ដើម នេះ​គឺ​ជា​ច្រក "
"<acronym>IPP</acronym> បើ​អ្នក​ផ្លាស់ប្ដូរ​នេះ អ្នក​ត្រូវ​ការ​ធ្វើ​វា​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទាំងអស់ ។ មាន​"
"តែ BrowsePort ដែល​ត្រូវ​បាន​ស្គាល់ ។"

#. Tag: guilabel
#: cups-config.docbook:1395
#, no-c-format
msgid "Poll addresses"
msgstr "អាសយដ្ឋាន​កន្លែង​ស្ទង់​មតិ"

#. Tag: para
#: cups-config.docbook:1397
#, no-c-format
msgid "Poll the named server(s) for printers."
msgstr "បន្ទាត់បញ្ចូល​ត្រូវ​បាន​ដាក់​ឈ្មោះ​ម៉ាស៊ីនបម្រើ​សម្រាប់​ម៉ាស៊ីន​បោះពុម្ព ។"

#. Tag: title
#: cups-config.docbook:1404
#, no-c-format
msgid "Browsing Masks Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​រកមើល​របាំង"

#. Tag: para
#: cups-config.docbook:1406
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server allowed and/or denied browse "
"packets from other servers is shown here."
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ដែល​អនុញ្ញាត និង/ឬ​បដិសេធ​កញ្ចប់​ព័ត៌មាន​រក​មើល​ពី​សេវា​ផ្សេង​"
"ទៀត​ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។"

#. Tag: para
#: cups-config.docbook:1410
#, no-c-format
msgid "<guilabel>Browse allow</guilabel>:"
msgstr "<guilabel>អនុញ្ញាត​រក​មើល</guilabel> ៖"

#. Tag: para
#: cups-config.docbook:1411
#, no-c-format
msgid "<guilabel>Browse deny</guilabel>:"
msgstr "<guilabel>បដិសេធ​រកមើល</guilabel> ៖"

#. Tag: para
#: cups-config.docbook:1412
#, no-c-format
msgid "<guilabel>Browse order</guilabel>:"
msgstr "<guilabel>លំដាប់​រក​មើល</guilabel> ៖"

#. Tag: screeninfo
#: cups-config.docbook:1416
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; server allowed and/or denied "
"browse packets from other servers</screeninfo>"
msgstr ""
"<screeninfo>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ដែល​អនុញ្ញាត និង/ឬ​បដិសេធ​កញ្ចប់​ព័ត៌មាន​"
"រកមើល​ពី​ម៉ាស៊ីន​បម្រើ​ផ្សេង​ទៀត</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1423
#, no-c-format
msgid ""
"<phrase>Dialog to configure the &CUPS; server allowed and/or denied browse "
"packets from other servers</phrase>"
msgstr ""
"<phrase>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ដែល​អនុញ្ញាត និង/ឬ​បដិសេធ​ពី​ម៉ាស៊ីន​បម្រើ​ផ្សេង​"
"ទៀត</phrase>"

#. Tag: term
#: cups-config.docbook:1430
#, no-c-format
msgid "<guilabel>Add Browse Address</guilabel> dialog"
msgstr "ប្រអប់ <guilabel>បន្ថែម​អាសយដ្ឋាន​រកមើល</guilabel>"

#. Tag: para
#: cups-config.docbook:1432
#, no-c-format
msgid ""
"The dialog to enter a new value for the address of another &CUPS; server to "
"accept browse packets from is shown here. It is opened by clicking on the "
"<guibutton>Add...</guibutton> button beside the field named <guilabel>Browse "
"Allow:</guilabel>. It is the same dialog as for adding <quote>denied</quote> "
"broadcast sending addresses."
msgstr ""

#. Tag: para
#: cups-config.docbook:1439
#, no-c-format
msgid ""
"The dialog to enter a new value for the address of another &CUPS; server to "
"accept browse packets from is shown here."
msgstr ""
"ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​អាសយដ្ឋាន​នៃ​ម៉ាស៊ីន​បម្រើ CUPS មួយ​ផ្សេង​ទៀត​ដើម្បី​ទទួល​កញ្ចប់​ព័ត៌មាន​"
"រកមើល​ពី​ត្រូវ​បង្ហាញ​នៅ​ទីនេះ ។"

#. Tag: screeninfo
#: cups-config.docbook:1443
#, no-c-format
msgid ""
"<screeninfo>Dialog to enter a new value for the address of another &CUPS; "
"server to accept browse packets from</screeninfo>"
msgstr ""
"<screeninfo>ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​អាសយដ្ឋាន​នៃ​ម៉ាស៊ីន​បម្រើ CUPS ដើម្បី​ទទួល​កញ្ចប់​ព័ត៌មាន​"
"រកមើល​ពី</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1450
#, no-c-format
msgid ""
"<phrase>Dialog to enter a new value for the address of another &CUPS; server "
"to accept browse packets from</phrase>"
msgstr ""
"<phrase>ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​អាសយដ្ឋាន​ម៉ាស៊ីន​បម្រើ CUPS មួយ​ផ្សេង​ទៀត​ដើម្បី​ទទួល​កញ្ចប់​"
"ព័ត៌មាន​រកមើល​ពី</phrase>"

#. Tag: term
#: cups-config.docbook:1458
#, no-c-format
msgid "<guilabel>Browse allow</guilabel> and <guilabel>Browse deny</guilabel>"
msgstr "<guilabel>អនុញ្ញាត​រកមើល</guilabel> និង <guilabel>បដិសេធ​រកមើល</guilabel>"

#. Tag: para
#: cups-config.docbook:1461
#, no-c-format
msgid ""
"<guilabel>Browse allow</guilabel> specifies an address mask to allow for "
"incoming browser packets. The default is to allow packets from all addresses."
msgstr ""
"<guilabel>អនុញ្ញាត​រក​មើល</guilabel> បញ្ជាក់​របាំង​អាសយដ្ឋាន​ដើម្បី​អនុញ្ញាត​សម្រាប់​កញ្ចប់​ព័ត៌មាន​"
"កម្មវិធី​រុករក​ចូល ។ លំនាំ​ដើម​គឺ​ត្រូវ​អនុញ្ញាត​កញ្ចប់​ព័ត៌មាន​ពី​អាសមយដ្ឋាន​ទាំងអស់ ។"

#. Tag: para
#: cups-config.docbook:1464
#, no-c-format
msgid ""
"<guilabel>Browse deny</guilabel> specifies an address mask to deny for "
"incoming browser packets. The default is to deny packets from no addresses."
msgstr ""
"<guilabel> បដិសេធ​រុករក </guilabel> បញ្ចាក់​​របាំង​អាសយដ្ឋាន​ដើម្បីបដិសេធ​កញ្ចប់​ព័ត៌មាន​​កម្មវិធី​រុករក​​"
"ដែល​កំពុង​មក​ដល់  ។ លំនាំដើម​បដិសេធ​កញ្ចប់​ព័ត៌មាន​ពី​កញ្ចប់ព័ត៌មាន​ដែល​គ្មាន​អាសយដ្ឋាន ។"

#. Tag: para
#: cups-config.docbook:1467
#, no-c-format
msgid ""
"Both <guilabel>Browse allow</guilabel> and <guilabel>Browse deny</guilabel> "
"accept the following notations for addresses:"
msgstr ""
"ទាំង <guilabel>អនុញ្ញាត​រក​មើល</guilabel> និង <guilabel>បដិសេធ​រកមើល</guilabel> ទទួល​"
"ការ​ចំណាំ​ខាងក្រោម​សម្រាប់​ជា​អាសយដ្ឋាន ។"

#. Tag: userinput
#: cups-config.docbook:1473 cups-config.docbook:1820 cups-config.docbook:1868
#, no-c-format
msgid "<userinput>All</userinput>"
msgstr "<userinput>ទាំងអស់</userinput>"

