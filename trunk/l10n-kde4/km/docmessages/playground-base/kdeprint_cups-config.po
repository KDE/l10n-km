msgstr "nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm"

#. Tag: para
#: cups-config.docbook:1508
#, no-c-format
msgid ""
"The hostname/domain name restrictions will only work if you have turned "
"hostname lookups on!"
msgstr "ការ​កំណត់​ឈ្មោះ ឈ្មោះ​ម៉ាស៊ីន/ដែន នឹង​ធ្វើការ​បើ​អ្នក​បាន​បើក​ការ​រកមើល​ឈ្មោះ​ម៉ាស៊ីន!"

#. Tag: guilabel
#: cups-config.docbook:1514
#, no-c-format
msgid "Browse order"
msgstr "លំដាប់​រកមើល"

#. Tag: para
#: cups-config.docbook:1516
#, no-c-format
msgid "Specifies the order of the allow/deny comparisons."
msgstr "បញ្ជាក់​លំដាប់​នៃ​ការ​ប្រៀបធៀប​អនុញ្ញាត/បដិសេធ ។"

#. Tag: title
#: cups-config.docbook:1524
#, no-c-format
msgid "Browsing Timeouts Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​រកមើល​អស់​ពេល"

#. Tag: para
#: cups-config.docbook:1526
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server browse timeout settings is shown "
"here. Browse timeout settings include:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​អស់​ពេល​រកមើល​ម៉ាស៊ីន​បម្រើ CUPS ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។ ការ​កំណត់​"
"អស់​ពេល​រកមើល​រួម​មាន ៖"

#. Tag: guilabel
#: cups-config.docbook:1529
#, no-c-format
msgid "Browse Interval"
msgstr "ចន្លោះ​ពេល​រក​មើល"

#. Tag: guilabel
#: cups-config.docbook:1530
#, no-c-format
msgid "Browse Timeout"
msgstr "អស់​ពេល​រក​មើល"

#. Tag: screeninfo
#: cups-config.docbook:1533
#, no-c-format
msgid "Dialog to configure the &CUPS; server browse timeout settings"
msgstr "ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​អស់​ពេល​រកមើល​ម៉ាស៊ីន​បម្រើ CUPS"

#. Tag: phrase
#: cups-config.docbook:1540
#, no-c-format
msgid "dialog to configure the &CUPS; server browse timeout settings"
msgstr "ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​អស់​ពេល​រកមើល​ម៉ាស៊ីន​បម្រើ CUPS"

#. Tag: guilabel
#: cups-config.docbook:1547
#, no-c-format
msgid "Browse interval"
msgstr "ចន្លោះ​ពេល​រក​មើល"

#. Tag: para
#: cups-config.docbook:1549
#, no-c-format
msgid ""
"The time between browsing updates in seconds. The default is 30 seconds."
msgstr "ពេលវេលា​រវាង​ការរកមើល​ធ្វើ​ឲ្យ​ទាន់សម័យ​គិតជា​វិនាទី ។ លំនាំដើម​គឺ ៣០វិនាទី ។"

#. Tag: para
#: cups-config.docbook:1551
#, no-c-format
msgid ""
"Note that browsing information is sent whenever a printer's state changes as "
"well, so this represents the maximum time between updates."
msgstr ""
"ចំណាំ​ថា​រកមើល​ព័ត៌មាន​គឺ​ត្រូវ​បាន​ផ្ញើ​ពេល​ពា​សភាព​របស់​ម៉ាស៊ីន​បោះពុម្ព​ផ្លាស់ប្ដូរ​ផង​ដែរ ដូច្នេះ​នេះ​តំណាង​ពេល​"
"វេលា​អតិបរមា​ចន្លោះ​ភាព​ទាន់​សម័យ ។"

#. Tag: para
#: cups-config.docbook:1554
#, no-c-format
msgid ""
"Set this to 0 to disable outgoing broadcasts so your local printers are not "
"advertised, but you can still see printers on other hosts."
msgstr ""
"កំណត់​វា​ទៅ ០ ដើម្បី​បិទ​ការ​ផ្សាយ​ចេញ ដូច្នេះ​ម៉ាស៊ីន​បោះពុម្ព​មូលដ្ឋាន​របស់​អ្នក​មិន​ត្រូវ​បាន​ផ្សាយ​ពាណិជ្ជកម្ម​ទេ "
"ប៉ុន្តែ​អ្នក​នៅ​តែ​ឃើញ​ម៉ាស៊ីន​បោះពុម្ព​របស់​អ្នក​នៅ​លើ​ម៉ាស៊ីន​ផ្សេង​ទៀត ។"

#. Tag: term
#: cups-config.docbook:1561
#, no-c-format
msgid "Browse timeouts"
msgstr "អស់​ពេល​រក​មើល​"

#. Tag: para
#: cups-config.docbook:1563
#, no-c-format
msgid ""
"The timeout (in seconds) for network printers - if we don't get an update "
"within this time, the printer will be removed from the printer list."
msgstr ""
"អស់ពេល (គិត​ជា​វិនាទី​) សម្រាប់​ម៉ាស៊ីន​បោះពុម្ព​បណ្តាញ - បើ​យើង​មិន​ទទួល​បាន​ភាព​ទាន់​សម័យ​នៅ​ក្នុង​ពេល​នេះ​ទេ "
"ម៉ាស៊ីន​បោះពុម្ព​នឹង​ត្រូវ​បាន​យក​ចេញ​ពី​បញ្ជី​ម៉ាស៊ីន​បោះពុម្ព ។"

#. Tag: para
#: cups-config.docbook:1566
#, no-c-format
msgid ""
"This number definitely should not be less than the browse interval period, "
"for obvious reasons. Defaults to 300 seconds."
msgstr ""
"ចំនួន​នេះ​គួរ​តែ​តិច​ជាង​ថេរ​វេលា​ចន្លោះ​ពេល​រកមើល​ដោយ​កំណត់ សម្រាប់​ហេតុ​ផល​ច្បាស់លះ ។ លំនាំ​ដើម​គឺ ៣០០ "
"វិនាទី ។"

#. Tag: title
#: cups-config.docbook:1574
#, no-c-format
msgid "Browsing Relay Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​បញ្ចូន​បន្ត​ការ​រក​មើល"

#. Tag: para
#: cups-config.docbook:1576
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server as a browsing relay is shown here. "
"Browsing relay settings include:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ពេល​បញ្ជូន​ត​រក​មើល​ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។ ការ​កំណត់​"
"បញ្ជូន​ត​រក​មើល​រួម​មាន ៖"

#. Tag: guilabel
#: cups-config.docbook:1580 cups-config.docbook:1622
#, no-c-format
msgid "Browser packets relay"
msgstr "ការ​បញ្ជូន​ត​កញ្ចប់​ព័ត៌មាន​កម្មវិធី​រុករក"

#. Tag: screeninfo
#: cups-config.docbook:1584
#, no-c-format
msgid ""
"<screeninfo>Dialog to configure the &CUPS; server as a browsing relay</"
"screeninfo>"
msgstr ""
"<screeninfo>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ពេល​ការ​បញ្ជូន​ត​រក​មើល</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1591
#, no-c-format
msgid ""
"<phrase>Dialog to configure the &CUPS; server as a browsing relay</phrase>"
msgstr "<phrase>ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ពេល​ការ​បញ្ជូន​ត​រកមើល</phrase>"

#. Tag: term
#: cups-config.docbook:1598
#, no-c-format
msgid "Add Browse Relay dialog"
msgstr "បន្ថែម​ប្រអប់​បញ្ជូន​ត​រក​មើល"

#. Tag: para
#: cups-config.docbook:1600
#, no-c-format
msgid ""
"The dialog to enter a new value for an address pair to define browsing "
"relaying between a &CUPS; server and a network is shown here."
msgstr ""
"ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​អាសយដ្ឋាន​មួយ​គូ​ដើម្បី​កំណត់​ការ​បញ្ជូន​ត​រក​មើល​​រវាង​ម៉ាស៊ីន​បម្រើ CUPS និង​"
"បណ្ដាញ​ត្រូវ​បាន​បង្ហាញ​នៅ​ទីនេះ ។"

#. Tag: screeninfo
#: cups-config.docbook:1605
#, no-c-format
msgid ""
"<screeninfo>The dialog to enter a new value for an address pair to define "
"browsing relaying between a &CUPS; server and a network</screeninfo>"
msgstr ""
"<screeninfo>ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​អាសយដ្ឋាន​មួយ​គូ​ដើម្បី​កំណត់​ការ​បញ្ជូន​ត​ការ​រកមើល​រវាង​"
"ម៉ាស៊ីន​បម្រើ CUPS និង​បណ្ដាញ</screeninfo>"

#. Tag: phrase
#: cups-config.docbook:1613
#, no-c-format
msgid ""
"<phrase>The dialog to enter a new value for an address pair to define "
"browsing relaying between a &CUPS; server and a network</phrase>"
msgstr ""
"<phrase>ប្រអប់​សម្រាប់​បញ្ចូល​តម្លៃ​ថ្មី​សម្រាប់​អាសយដ្ឋាន​មួយ​គូ​ដើម្បី​កំណត់​ការ​បញ្ជូន​ត​រក​មើល​រវាង​ម៉ាស៊ីន​បម្រើ "
"CUPS និង​បណ្ដាញ</phrase>"

#. Tag: para
#: cups-config.docbook:1624
#, no-c-format
msgid "Relay browser packets from one address or network to another."
msgstr "បញ្ជូន​ត​កញ្ចប់​ព័ត៌មាន​កម្មវិធី​រុករក​ពី​អាសយដ្ឋាន​មួយ ឬ​បណ្ដាញ​មួយ​ទៅ​មួយ​ផ្សេង​ទៀត ។"

#. Tag: title
#: cups-config.docbook:1633
#, no-c-format
msgid "Security Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​សុវត្ថិភាព​"

#. Tag: para
#: cups-config.docbook:1635
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server security settings for any of the "
"defined server locations is shown here. It contains the following settings, "
"which may be defined separately for any valid resource (or location) of the "
"&CUPS; server:"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​សុវត្ថិភាព​ម៉ាស៊ីន​បម្រើ CUPS សម្រាប់​ទីតាំង​ម៉ាស៊ីន​បម្រើ​ដែល​បាន​កំណត់​ត្រូវ​"
"បាន​បង្ហាញ​នៅ​ទីនេះ ។ វា​មាន​ការ​កំណត់​ដូច​ខាងក្រោម ដែល​ប្រហែល​ជា​ត្រូវ​បាន​កំណត់​ដោយ​ឡែក​ពី​គ្នា​សម្រាប់​ធនធាន​"
"ត្រឹមត្រូវ​ណា​មួយ (ឬ​ទីតាំង) នៃ​ម៉ាស៊ីន​បម្រើ CUPS ៖"

#. Tag: para
#: cups-config.docbook:1641
#, no-c-format
msgid "System Group:"
msgstr "ក្រុម​ប្រព័ន្ធ ៖"

#. Tag: para
#: cups-config.docbook:1642
#, no-c-format
msgid "Access Permissions:"
msgstr "សិទ្ធ​ចូល​ដំណើរ​ការ ៖"

#. Tag: para
#: cups-config.docbook:1643
#, no-c-format
msgid "Auth Type:"
msgstr "ប្រភេទ​អ្នកនិពន្ធ ៖"

#. Tag: para
#: cups-config.docbook:1644
#, no-c-format
msgid "Auth Class:"
msgstr "ថ្នាក់​អ្នកនិពន្ធ ៖​"

#. Tag: para
#: cups-config.docbook:1645
#, no-c-format
msgid "Auth Group Name:"
msgstr "ឈ្មោះ​ក្រុម​អ្នក​និពន្ធ៖"

#. Tag: para
#: cups-config.docbook:1646
#, no-c-format
msgid "Encryption:"
msgstr "ការ​អ៊ីនគ្រីប ៖"

#. Tag: para
#: cups-config.docbook:1647
#, no-c-format
msgid "Allow:"
msgstr "អនុញ្ញាត ៖"

#. Tag: para
#: cups-config.docbook:1648
#, no-c-format
msgid "Deny:"
msgstr "បដិសេធ ៖"

#. Tag: para
#: cups-config.docbook:1649
#, no-c-format
msgid "Order:"
msgstr "លំដាប់ ៖"

#. Tag: para
#: cups-config.docbook:1652
#, no-c-format
msgid "Valid resources (or locations) of the &CUPS; server are:"
msgstr "ធនធាន​ត្រឹមត្រូវ (ឬ​ទីតាំង) នៃ​ម៉ាស៊ីន​បម្រើ CUPS គឺ ៖"

#. Tag: para
#: cups-config.docbook:1655
#, no-c-format
msgid "Server Root Location: <systemitem class=\"resource\">/</systemitem>"
msgstr "ទីតាំង​ម៉ាស៊ីនបម្រើ​រ៉ូត ៖ <systemitem class=\"resource\">/</systemitem>"

#. Tag: para
#: cups-config.docbook:1657
#, no-c-format
msgid ""
"Server Administration Location: <systemitem class=\"resource\">/admin</"
"systemitem>"
msgstr ""
"ទីតាំង​ការគ្រប់គ្រង​ម៉ាស៊ីនបម្រើ ៖ <systemitem class=\"resource\">/admin</systemitem>"

#. Tag: para
#: cups-config.docbook:1659
#, no-c-format
msgid ""
"All printers on the server: <systemitem class=\"resource\">/printers</"
"systemitem>"
msgstr ""
"គ្រប់​ម៉ាស៊ីន​បោះពុម្ព​ទាំងអស់​លើ​ម៉ាស៊ីន​បម្រើ <systemitem class=\"resource\">/printers</"
"systemitem>"

#. Tag: para
#: cups-config.docbook:1661
#, no-c-format
msgid ""
"Any individual printer on the server: &eg; <systemitem class=\"resource\">/"
"printers/infotec_P320</systemitem>"
msgstr ""
"ម៉ាស៊ីន​បោះពុម្ព​មួយ​ចំនួន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ ៖ ឧទាហរណ៍ <systemitem class=\"resource\">/"
"printers/infotec_P320</systemitem>"

#. Tag: para
#: cups-config.docbook:1664
#, no-c-format
msgid ""
"All printer classes on the server: <systemitem class=\"resource\">/classes</"
"systemitem>:"
msgstr ""
"​ថ្នាក់​ម៉ាស៊ីន​បោះពុម្ព​ទាំងអស់​លើ​ម៉ាស៊ីន​បម្រើ ៖ <systemitem class=\"resource\">/classes</"
"systemitem> ៖​"

#. Tag: para
#: cups-config.docbook:1666
#, no-c-format
msgid ""
"Any individual printer class on the server: &eg; <systemitem class=\"resource"
"\">/classes/all_infotecs_P320_or_P450</systemitem>"
msgstr ""
"ថ្នាក់​ម៉ាស៊ីន​បោះពុម្ពឯកជន​មួយ​ចំនួន​លើ​ម៉ាស៊ីន​បម្រើ ៖ ឧទាហរណ៍ <systemitem class=\"resource\">/"
"classes/all_infotecs_P320_or_P450</systemitem>"

#. Tag: screeninfo
#: cups-config.docbook:1672
#, no-c-format
msgid ""
"Dialog to configure the &CUPS; server security settings for any of the "
"defined server locations"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​សុវត្ថិភាព​ម៉ាស៊ីន​បម្រើ CUPS សម្រាប់​ទីតាំង​ម៉ាស៊ីន​បម្រើ​ដែល​បាន​កំណត់​មួយ​"
"ចំនួន"

#. Tag: phrase
#: cups-config.docbook:1679
#, no-c-format
msgid ""
"dialog to configure the &CUPS; server security settings for any of the "
"defined server locations"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនាស​ម្ព័ន្ធ​ការ​កំណត់​សុវត្ថិភាព​ម៉ាស៊ីន​បម្រើ CUPS សម្រាប់​ទីតាំង​ម៉ាស៊ីន​បម្រើ​ដែល​បាន​កំណត់​មួយ​"
"ចំនួន"

#. Tag: para
#: cups-config.docbook:1686
#, no-c-format
msgid ""
"For all locations that are not defined separately the setting of the "
"location <quote>above</quote> it is valid."
msgstr ""
"ចំពោះ​ទីតាំង​ទាំងអស់​ដែល​មិន​បាន​កំណត់​ការ​កំណត់​នៃ​ទីតាំង <quote>ខាងលើ</quote> ដោយ​ឡែក វា​ត្រឹមត្រូវ ។"

#. Tag: para
#: cups-config.docbook:1689
#, no-c-format
msgid ""
"For example, you have a printer named <systemitem class=\"resource"
"\">infotec_P450</systemitem> with no set security options. Then the security "
"of the location <systemitem class=\"resource\">/printers</systemitem> will "
"take the responsibility for this printer as it is a sub-location "
"of<systemitem class=\"resource\">/printers</systemitem>. If, in turn there "
"is no security set for <systemitem class=\"resource\">/printers</"
"systemitem>, then the security for <systemitem class=\"resource\">/</"
"systemitem> (the general security) of the server takes responsibility. "
"Either you have set this for your purpose or the compiled-in default value "
"takes over."
msgstr ""
"ឧទាហរណ៍ អ្នក​បាន​ដាក់​ឈ្មោះឲ្យ​ម៉ាស៊ីន​បោះពុម្ព  <systemitem class=\"resource"
"\">infotec_P450</systemitem> តែ​មិន​ទាន់​បាន​កំណត់​ជម្រើស​សុវត្ថិភាព​នូវ​ឡើយ​ទេ ។ បន្ទាប់​"
"មកសុវត្ថិភាព​ទីតាំង <systemitem class=\"resource\">/printers</systemitem> ទទួល​"
"ខុសត្រូវចំពោះ​ម៉ាស៊ីនបោះពុម្ពនេះ​ជា​ទីតាំងរង​<systemitem class=\"resource\">/printers</"
"systemitem> ។បើ​មិនទាន់​បាន​កំណត់​សុវត្ថិភាពសម្រាប់​េ <systemitem class=\"resource\">/"
"printers</systemitem>ទេ ​ហើយ​សុវត្ថិភាព​សម្រាប់​រ៉ូត​r <systemitem class=\"resource\">/</"
"systemitem> សុវត្ថិភាពទូទៅy)របស់​ម៉ាស៊ីន​បម្រើ​ដែល​ទទួល​ខុសត្រូវ ។  អ្នកអាច​កំណត់​តាម​របៀប​នេះ​សម្រាប់​"
"គោលបំណង ឬបានចង​ក្រង​តម្លៃ​លំនាំដើម ។."

#. Tag: term
#: cups-config.docbook:1704
#, no-c-format
msgid "SystemGroup"
msgstr "ក្រុម​ប្រព័ន្ធ​"

#. Tag: para
#: cups-config.docbook:1706
#, no-c-format
msgid ""
"The group name for <systemitem class=\"groupname\">System</systemitem> or "
"printer administration access. The default varies depending on the operating "
"system, but will be <systemitem class=\"groupname\">sys</systemitem>, "
"<systemitem class=\"groupname\">system</systemitem> or <systemitem class="
"\"groupname\">root</systemitem> (checked for in that order)."
msgstr ""
"ឈ្មោះ​ក្រុម​សម្រាប់ <systemitem class=\"groupname\">ប្រព័ន្ធ</systemitem> ឬ​ចូល​ដំណើរ​ការ​ការ​"
"គ្រប់គ្រង់​ម៉ាស៊ីន​បោះពុម្ព ។ លំនាំដើម​ខុសៗគ្នា​ពឹងផ្នែកលើ​ប្រព័ន្ធ​ដំណើរការ ប៉ុន្តែ​វា​ជា <systemitem "
"class=\"groupname\">sys</systemitem> <systemitem class=\"groupname\">ប្រព័ន្ធ</"
"systemitem> ឬ <systemitem class=\"groupname\">រូត</systemitem> (ដែលបាន​ពិនិត្យ​តាម​"
"លំដាប់​) ។"

#. Tag: term
#: cups-config.docbook:1716
#, no-c-format
msgid "Access Permissions"
msgstr "សិទ្ធិ​ចូល​ដំណើរ​ការ"

#. Tag: para
#: cups-config.docbook:1718
#, no-c-format
msgid ""
"Access permissions for each folder served by the scheduler. Locations are "
"relative to the document root."
msgstr ""
"សិទ្ធចូលដំណើរការ​​ចំពោះថត​នីមួយៗផ្តល់ឲ្យ​ដោយ​កម្មវិធី​កំណត់​ពេលវេលា ។ ទីតាំង​ជាប់​ទាក់ទង​ទៅ​រូត​ឯកសារ ។"

#. Tag: term
#: cups-config.docbook:1724
#, no-c-format
msgid "Authorization Type"
msgstr "ប្រភេទ​សេចក្តី​អនុញ្ញាត​"

#. Tag: para
#: cups-config.docbook:1726
#, no-c-format
msgid "The authorization to use:"
msgstr "សេចក្តី​អនុញ្ញាត​សម្រាប់​ប្រើ ៖"

#. Tag: term
#: cups-config.docbook:1730
#, no-c-format
msgid "<term>None</term>"
msgstr "<term>គ្មាន</term>"

#. Tag: para
#: cups-config.docbook:1732
#, no-c-format
msgid "Perform no authentication."
msgstr "ធ្វើ​ដំណើរ​ការ​ដោយ​គ្មាន​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ។"

#. Tag: term
#: cups-config.docbook:1736
#, no-c-format
msgid "Basic"
msgstr "មូល​ដ្ឋាន"

#. Tag: para
#: cups-config.docbook:1738
#, no-c-format
msgid "Perform authentication using the &HTTP; Basic method."
msgstr "ដំណើរ​ការ​​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដោយ​ប្រើ​វិធីសាស្ត្រ​មូលដ្ឋាន HTTP ។"

#. Tag: term
#: cups-config.docbook:1742
#, no-c-format
msgid "Digest"
msgstr "​"

#. Tag: para
#: cups-config.docbook:1744
#, no-c-format
msgid "Perform authentication using the &HTTP; Digest method."
msgstr "បង្ហាញ​សេចក្តីអនុញ្ញាត​ដោយ​ប្រើ​វិធីសាស្ត្រ​​កំរង​អត្ថបទ​សង្ខេប​របស់ &HTTP; ។"

#. Tag: para
#: cups-config.docbook:1750
#, no-c-format
msgid ""
"Local certificate authentication can be substituted by the client for Basic "
"or Digest, when connecting to the localhost interface."
msgstr ""
"ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​វិញ្ញាបនបត្រ​មូលដ្ឋាន​អាច​ត្រូវ​បាន​ជំនួស​ដោយ​ម៉ាស៊ីន​ភ្ញៀវ សម្រាប់​មូលដ្ឋាន ឬ​"
"សង្ខេប ពេល​តភ្ជាប់​ទៅ​ចំណុច​ប្រទាក់​ម៉ាស៊ីន​មូលដ្ឋាន ។"

#. Tag: term
#: cups-config.docbook:1758
#, no-c-format
msgid "Authorization Class"
msgstr "ថ្នាក់​សេចក្តី​អនុញ្ញាត​"

#. Tag: para
#: cups-config.docbook:1760
#, no-c-format
msgid ""
"The authorization class. Currently only <quote>Anonymous</quote>, "
"<quote>User</quote>, <quote>System</quote> (valid user belonging to the "
"group set as system group), and <quote>group</quote> (valid user belonging "
"to the specified group) are supported."
msgstr ""
"ថ្នាក់​សេចក្តីអនុញ្ញាត ។ បច្ចុប្បន្ន​បាន​តែ <quote>អនាមិក</quote> <quote>អ្នកប្រើ</quote> "
"<quote>ប្រព័ន្ធ</quote> (អ្នកប្រើ​​ត្រឹមត្រូវ​ជា​កម្មសិទ្ធ​ក្រុមដែលបាន​កំណត់​ជា​ក្រុម​ប្រព័ន្ធ​) និង "
"<quote>ក្រុម</quote> (អ្នកប្រើត្រឹមត្រូវ​ជា​ម្ចាស់​ក្រុម​ដែលបាន​បញ្ជាក់​) ត្រូវ​បាន​គាំទ្រ ។"

#. Tag: term
#: cups-config.docbook:1769
#, no-c-format
msgid "Authorization Group Name"
msgstr "ឈ្មោះ​ក្រុម​សេក្ដី​អនុញ្ញាត"

#. Tag: para
#: cups-config.docbook:1771
#, no-c-format
msgid "The group name for <quote>Group</quote> authorization"
msgstr "ឈ្មោះ​ក្រុម​សម្រាប់​សេក្ដី​អនុញ្ញាត <quote>ក្រុម</quote>"

#. Tag: term
#: cups-config.docbook:1776
#, no-c-format
msgid "Encryption"
msgstr "​ការ​អ៊ីនគ្រីប"

#. Tag: para
#: cups-config.docbook:1778
#, no-c-format
msgid ""
"Whether or not to use encryption. This depends on having the "
"<application>OpenSSL</application> linked into the &CUPS; library and "
"scheduler."
msgstr ""
"ទោះជា​មិន​ប្រើ​ការអ៊ីនគ្រីប ។ វា​ពឹង​ផ្នែក​លើ​ការ​ដែល​មាន <application>OpenSSL</application> "
"តភ្ជាប់​នៅ​ក្នុង​បណ្ណាល័យ CUPS និង​កម្មវិធី​កំណត់​ពេលវេលា ។"

#. Tag: para
#: cups-config.docbook:1781
#, no-c-format
msgid "Possible values are:"
msgstr "តម្លៃ​ដែល​អាច​គឺ ៖"

#. Tag: term
#: cups-config.docbook:1784
#, no-c-format
msgid "Always"
msgstr "ជានិច្ច"

#. Tag: para
#: cups-config.docbook:1786
#, no-c-format
msgid "Always use encryption (<acronym>SSL</acronym>)"
msgstr "ប្រើ​អ៊ីនគ្រីប (<acronym>SSL</acronym>) ជា​និច្ច​"

#. Tag: term
#: cups-config.docbook:1790
#, no-c-format
msgid "Never"
msgstr "កុំ"

#. Tag: para
#: cups-config.docbook:1792
#, no-c-format
msgid "Never use encryption."
msgstr "​កុំ​ប្រើ​ការអ៊ីនគ្រីប"

#. Tag: term
#: cups-config.docbook:1796
#, no-c-format
msgid "Required"
msgstr "បាន​ទាមទារ"

#. Tag: para
#: cups-config.docbook:1798
#, no-c-format
msgid "Use <acronym>TLS</acronym> encryption upgrade."
msgstr "ប្រើ​ការ​ធ្វើ​ឲ្យ​ប្រសើរ​អ៊ីនគ្រីប <acronym>TLS</acronym> ។"

#. Tag: term
#: cups-config.docbook:1802
#, no-c-format
msgid "IfRequested"
msgstr "IfRequested"

#. Tag: para
#: cups-config.docbook:1804
#, no-c-format
msgid "Use encryption if the server requests it."
msgstr "ប្រើ​ការអ៊ីនគ្រីប បើ​ម៉ាស៊ីន​បម្រើ​ស្នើ​វា ។"

#. Tag: guilabel
#: cups-config.docbook:1812
#, no-c-format
msgid "Allow"
msgstr "អនុញ្ញាត"

#. Tag: para
#: cups-config.docbook:1814
#, no-c-format
msgid ""
"Allows access from the specified hostname, domain, <acronym>IP</acronym> "
"address or network. Possible values are:"
msgstr ""
"អនុញ្ញាត​ឲ្យ​ចូល​ដំណើរ​ការ​​ពី​ឈ្មោះ​ម៉ាស៊ីន​ ដែន <acronym>IP</acronym> ឬ​បណ្តាញ​ដែល​បាន​បញ្ជាក់ ។ តម្លៃ​"
"ដែល​អាច​គឺ ៖"

#. Tag: para
#: cups-config.docbook:1855 cups-config.docbook:1902
#, no-c-format
msgid ""
"The host and domain address require that you enable hostname lookups, as "
"described earlier."
msgstr "អាសយដ្ឋាន​ម៉ាស៊ីន និង​ដែន​ទាមទារ​ឲ្យ​អ្នក​អនុញ្ញាត​ការ​រកមើល​ឈ្មោះ​ម៉ាស៊ីន​ដែល​បាន​ពិពណ៌នា​ពី​មុន ។"

#. Tag: guilabel
#: cups-config.docbook:1861
#, no-c-format
msgid "Deny"
msgstr "បដិសេធ"

#. Tag: para
#: cups-config.docbook:1863
#, no-c-format
msgid ""
"Denies access from the specified hostname, domain, <acronym>IP</acronym> "
"address or network. Possible values are:"
msgstr ""
"បដិសេធ​ការ​ចូល​ដំណើរ​ការ​ពី​ឈ្មោះ​ម៉ាស៊ីន ដែន អាសយដ្ឋាន <acronym>IP</acronym> ឬ​បណ្តាញ ។ តម្លៃ​"
"ដែល​អាច​គឺ ៖"

#. Tag: term
#: cups-config.docbook:1908
#, no-c-format
msgid "Order"
msgstr "បញ្ជា​"

#. Tag: para
#: cups-config.docbook:1910
#, no-c-format
msgid "The order of the allow and deny processing."
msgstr "លំដាប់​នៃ​ការ​អនុញ្ញាត និង​បដិសេធ​ដំណើរ​ការ ។"

#. Tag: title
#: cups-config.docbook:1917
#, no-c-format
msgid "Example: How To Define The Security For All Printers"
msgstr "ឧទាហរណ៍ ៖ របៀប​កំណត់​សុវត្ថិភាព​សម្រាប់​ម៉ាស៊ីន​បោះពុម្ព​ទាំងអស់"

#. Tag: para
#: cups-config.docbook:1919
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server security settings is discussed "
"here. We use the example to add security definitions other than the default "
"ones for the resource named <systemitem class=\"resource\">all printers</"
"systemitem>. For the &CUPS; web server, this is the location you access "
"through <ulink url=\"http://localhost:631/printers/\"> http://localhost:631/"
"printers/</ulink> or (remotely) through <ulink url=\"http://cups.server."
"name:631/printers/\"> http://cups.server.name:631/printers/</ulink>"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​ការ​កំណត់​សុវត្ថិភាព​ម៉ាស៊ីន​បម្រើ​ត្រូវ​បាន​ពិភាក្សា​នៅ​ទីនេះ ។ យើង​ប្រើ​ឧទាហរណ៍​ដើម្បី​បន្ថែម​"
"ការ​កំណត់​សុវត្ថិភាព​ផ្សេង​ទៀត​ជាងលំនាំ​ដើម​មួយ​សម្រាប់​ធនធាន​ដែល​មាន​ឈ្មោះ <systemitem class="
"\"resource\">ម៉ាស៊ីន​បោះពុម្ព​ទាំងអស់</systemitem> ។ សម្រាប់​ម៉ាស៊ីន​បម្រើ​តំបន់​បណ្ដាញ CUPS នេះ​គឺ​ជា​"
"ទីតាំង​ដែល​អ្នក​ចូល​ដំណើរ​ការ​កាត់ <ulink url=\"http://localhost:631/printers/\"> http://"
"localhost:631/printers/</ulink> ឬ (ដោយ​ពី​ចម្ងាយ) កាត់ <ulink url=\"http://cups."
"server.name:631/printers/\"> http://cups.server.name:631/printers/</ulink>"

#. Tag: para
#: cups-config.docbook:1929
#, no-c-format
msgid ""
"The first screenshot shows the general location for this setting. "
"<guilabel>Select</guilabel> <guibutton>Add</guibutton> or <guibutton>Modify</"
"guibutton> a resource for which you want to decide about its security "
"settings."
msgstr ""
"រូប​ថត​អេក្រង់​ដំបូង​បង្ហាញ​ទីតាំង​ទូទៅ​សម្រាប់​ការ​កំណត់​នេះ ។ <guilabel>ជ្រើស</guilabel> "
"<guibutton>បន្ថែម</guibutton> ឬ <guibutton>កែប្រែ</guibutton> ធនធាន​សម្រាប់​អ្វី​ដែល​"
"អ្នក​សម្រេច​ចិត្ត​អំពី​ការ​កំណត់​សុវត្ថិភាព​របស់​វា ។"

