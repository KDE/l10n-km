#: cups-config.docbook:308
#, no-c-format
msgid "Server <guilabel>Folders</guilabel> and Path Definitions"
msgstr "<guilabel>ថត​</guilabel> ម៉ាស៊ីន​បម្រើ និង​ការ​កំណត់​ផ្លូវ"

#. Tag: link
#: cups-config.docbook:312
#, no-c-format
msgid "Server <guilabel>HTTP</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ <guilabel>HTTP</guilabel> ម៉ាស៊ីន​បម្រើ"

#. Tag: link
#: cups-config.docbook:316
#, no-c-format
msgid ""
"Server <guilabel>Encryption</guilabel> and Certificate Support Configuration"
msgstr ""
"<guilabel>ការ​អ៊ីនគ្រីប</guilabel> ម៉ាស៊ីន​បម្រើ និង​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​គាំទ្រ​វិញ្ញាបនបត្រ"

#. Tag: link
#: cups-config.docbook:321
#, no-c-format
