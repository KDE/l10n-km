msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ <guilabel>ផ្សេងៗ</guilabel> របស់​ម៉ាស៊ីន​បម្រើ"

#. Tag: para
#: cups-config.docbook:325
#, no-c-format
msgid "<guilabel>Network</guilabel> General Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ <guilabel>បណ្តាញ</guilabel> ទូទៅ"

#. Tag: link
#: cups-config.docbook:328
#, no-c-format
msgid "Network <guilabel>Clients</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនាសម្ព័ន្ធ​បណ្តាញ <guilabel>ម៉ាស៊ីន​ភ្ញៀវ​</guilabel> បណ្ដាញ"

#. Tag: link
#: cups-config.docbook:333
#, no-c-format
msgid "<guilabel>Browsing</guilabel> General Configuration"
msgstr "<guilabel>ការ​រកមើល​</guilabel> ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទូទៅ​"

#. Tag: link
#: cups-config.docbook:337
#, no-c-format
msgid "Browsing <guilabel>Connection</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​រក​មើល <guilabel>ការ​តភ្ជាប់</guilabel>"

#. Tag: link
#: cups-config.docbook:342
#, no-c-format
msgid "Browsing <guilabel>Masks</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​រក​មើល <guilabel>របាំង</guilabel>"

#. Tag: link
#: cups-config.docbook:346
#, no-c-format
msgid "Browsing <guilabel>Timeouts</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​រក​មើល <guilabel>អស់​ពេល</guilabel>"

#. Tag: link
#: cups-config.docbook:350
#, no-c-format
msgid "Browsing <guilabel>Relay</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​រក​មើល <guilabel>បញ្ជូល​បន្ត</guilabel>"

#. Tag: link
#: cups-config.docbook:355
#, no-c-format
msgid "<guilabel>Security</guilabel> Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ <guilabel>សុវត្ថិភាព​</guilabel>"

#. Tag: para
#: cups-config.docbook:360
#, no-c-format
msgid ""
"Each of these configuration items will be described in the following "
"sections of the manual."
msgstr "ធាតុ​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទាំងនេះ​នីមួយៗ​នឹង​ត្រូវ​បាន​ពណ៌នា​ក្នុង​ភាគ​របស់​សៀវភៅ​ដៃ​ខាងក្រោម ។"

#. Tag: title
#: cups-config.docbook:366
#, no-c-format
msgid "Server General Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ​ទូទៅ"

#. Tag: para
#: cups-config.docbook:368
#, no-c-format
msgid "The server general configuration is done on this screen. It includes:"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ​ទូទៅ ត្រូវ​បាន​ធ្វើ​រួច​លើ​អេក្រង់​នេះ ។ វា​រួម​បញ្ចូល​ទាំង ៖"

#. Tag: guilabel
#: cups-config.docbook:372
#, no-c-format
msgid "Server name"
msgstr "ឈ្មោះ​ម៉ាស៊ីន​បម្រើ"

#. Tag: guilabel
#: cups-config.docbook:373 cups-config.docbook:432
#, no-c-format
msgid "Administrators email"
msgstr "អ៊ីមែល​អ្នកគ្រប់គ្រង​"

#. Tag: guilabel
#: cups-config.docbook:374
#, no-c-format
msgid "Server user"
msgstr "អ្នកប្រើ​ម៉ាស៊ីន​បម្រើ​"

#. Tag: guilabel
#: cups-config.docbook:375 cups-config.docbook:487
#, no-c-format
msgid "Server group"
msgstr "ក្រុម​ម៉ាស៊ីន​បម្រើ​"

#. Tag: guilabel
#: cups-config.docbook:376 cups-config.docbook:500
#, no-c-format
msgid "Remote user name"
msgstr "ឈ្មោះ​អ្នកប្រើ​ពី​ចម្ងាយ​"

#. Tag: para
#: cups-config.docbook:379
#, no-c-format
msgid ""
"The tab window to configure the &CUPS; server general settings lets you the "
"change the default values. Click on the little question mark and then on one "
"of the fields to get a <quote>Quick Help</quote> about the meaning of the "
"setting."
msgstr ""
"បង្អួច​ថេប​ត្រូវ​កំណត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​បម្រើ​ទូទៅ CUPS អនុញ្ញាត​ឲ្យ​អ្នក​ផ្លាស់ប្ដូរ​តម្លៃ​លំនាំ​ដើម ។ "
"ចុច​លើ​សញ្ញា​សួរ​តូច និង​បន្ទាប់​លើ​វាល​មួយ​ដើម្បី​យក <quote>ជំនួយ​រហ័ស</quote> អំពី​អត្ថន័យ​នៃ​ការ​កំណត់ ។"

#. Tag: para
#: cups-config.docbook:384
#, no-c-format
msgid ""
"If you are unsure, leave alone and turn to the original &CUPS; documentation "
"first. If your &CUPS; daemon is already running, it is readable from the "
"&konqueror; by pointing it to &URL; <ulink url=\"http://localhost:631/"
"documentation.html\"> http://localhost:631/documentation.html</ulink>."
msgstr ""
"បើ​អ្នក​មិន​ច្បាស់ កុំប៉ះពាល់​វា​ហើយ​ត្រឡប់​ទៅ​កាន់​ឯកសារ​ដើម​ដំបូង​របស់ CUPS វិញ ។ បើ​ដេមិន CUPS របស់​អ្នក​"
"កំពុង​រត់​រួច​ហើយ វា​អាច​អាន​បាន​ពី Konqueror ដោយ​ចង្អុល​វា​ទៅ​កាន់ URL <ulink url=\"http://"
"localhost:631/documentation.html\"> http://localhost:631/documentation.html</"
"ulink> ។"

#. Tag: para
#: cups-config.docbook:390
#, no-c-format
msgid ""
"There, first <quote>make friends</quote> with the Software Administrator "
"Manual. Otherwise, for example, if the &CUPS; daemon is not running, try "
"looking in your local file system, by default at <filename class=\"directory"
"\">/usr/share/doc/cups/</filename> or <filename>/usr/share/doc/cups/"
"documentation.html</filename>."
msgstr ""
"ទីនោះ ដំបូង <quote>បង្កើត​ទំនាក់ទំនង</quote> ជាមួយ​សៀវភៅ​ដៃ​អ្នក​គ្រប់គ្រង​កម្មវិធី ។ មិន​ដូច្នោះ​ទេ "
"ឧទាហរណ៍ បើ​ដេមិន CUPS មិន​កំពុង​រត់ ព្យាយាម​រក​មើល​ក្នុង​ប្រព័ន្ធ​ឯកសារ​មូលដ្ឋាន​របស់​អ្នក ដោយ​លំនាំ​ដើម​នៅ "
"<filename class=\"directory\">/usr/share/doc/cups/</filename> ឬ <filename>/"
"usr/share/doc/cups/documentation.html</filename> ។"

#. Tag: screeninfo
#: cups-config.docbook:397
#, no-c-format
msgid ""
"&CUPS; server general configuration dialog: ServerName, AdminMail, "
"ServerUser, ServerGroup, RemoteUserName"
msgstr ""
"ប្រអប់​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ទូទៅ​ម៉ាស៊ីន​បម្រើ CUPS ៖ ServerName, AdminMail, ServerUser, "
"ServerGroup, RemoteUserName"

#. Tag: phrase
#: cups-config.docbook:404
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server general settings: ServerName, "
"AdminMail, ServerUser, ServerGroup, RemoteUserName"
msgstr ""
"ប្រអប់​សម្រាប់​កំនត់​រចនា​សម្ព័ន្ធ​ការ​កំណត់​ម៉ាស៊ីន​បម្រើ​ទូទៅ CUPS ៖ ServerName, AdminMail, "
"ServerUser, ServerGroup, RemoteUserName"

#. Tag: guilabel
#: cups-config.docbook:412
#, no-c-format
msgid "Server Name"
msgstr "ឈ្មោះ​ម៉ាស៊ីន​បម្រើ"

#. Tag: para
#: cups-config.docbook:414
#, no-c-format
msgid ""
"The hostname of your server, as advertised to the world. By default, &CUPS; "
"will use the hostname of the system. To set the default server usd by "
"clients, see the <filename>client.conf</filename> file."
msgstr ""
"ឈ្មោះម៉ាស៊ីន​នៃម៉ាស៊ីន​បម្រើ​របស់​អ្នក ត្រូវ​បាន​ផ្សព្វផ្សាយ​លើ​ពិភព​លោក ។ តាម​លំនាំដើម CUPS នឹង​ប្រើ​ឈ្មោះ​"
"ម៉ាស៊ីន​នៃ​ប្រព័ន្ធ ។ ដើម្បី​កំណត់​ម៉ាស៊ីន​បម្រើ usd លំនាំ​ដើម​ដោយ​ម៉ាស៊ីន​ភ្ញៀវ សូម​មើល​ឯកសារ "
"<filename>client.conf</filename> ។"

#. Tag: para
#: cups-config.docbook:420
#, no-c-format
msgid "For example, enter <userinput>myhost.domain.com</userinput>"
msgstr "ឧទាហរណ៍ បញ្ចូល <userinput>myhost.domain.com</userinput>"

#. Tag: para
#: cups-config.docbook:423
#, no-c-format
msgid ""
"This is the hostname that is reported to clients. Should you ever encounter "
"strange problems in accessing the server, put here its <acronym>IP</acronym> "
"address for troubleshooting. This way you eliminate any potential name "
"resolution problems; and you can more easily nail the real problem down."
msgstr ""
"នេះ​ជា​ឈ្មោះ​ម៉ាស៊ីន​ដែល​បានធ្វើ​​របាយការណ៍​ទៅ​កាន់​ម៉ាស៊ីន​ភ្ញៀវ ។ តើ​អ្នក​ធ្លាប់ជួបប្រទះ​បញ្ហា​ចំឡែក​ក្នុង​ការចូល​"
"ដំណើរការ​ម៉ាស៊ីន​បម្រើដែរ​ឬ​ទេ ដាក់​អាសយដ្ឋាន <acronym>IP</acronym> នៅទី​នេះសម្រាប់​ដោះស្រាយ​"
"បញ្ហា ។ វិធី​នេះ​អ្នក​កំចាត់​បញ្ហា​កំណត់​ឈ្មោះ​មាន​អនុភាព​ណាមួយ ហើយ​អ្នក​អាច​ងាយស្រួល​ក្នុង​ការ​ដោះស្រាយ​បញ្ហា​ពិត​"
"ប្រាកដ ។​"

#. Tag: para
#: cups-config.docbook:434
#, no-c-format
msgid ""
"This is the email address to send all complaints or problems to. By default "
"&CUPS; will use <quote>root@hostname</quote>."
msgstr ""
"នេះ​គឺ​ជា​អាសយដ្ឋាន​អ៊ីមែល​ដែល​ត្រូវ​ផ្ញើ​បញ្ហា ឬ​ការ​តវ៉ា​ទៅ ។ ដោយ​លំនាំ​ដើម CUPS នឹង​ប្រើ "
"<quote>root@hostname</quote> ។"

#. Tag: para
#: cups-config.docbook:438
#, no-c-format
msgid "For example, enter <userinput>root@myhost.com</userinput>."
msgstr "ឧទាហរណ៍ ​បញ្ចូល <userinput>root@myhost.com</userinput> ។"

#. Tag: para
#: cups-config.docbook:443
#, no-c-format
msgid ""
"Contrary to what the quickhelp suggests, it is also legal to send an email "
"full of praise and enthusiasm about &CUPS; and &kdeprint; to the server "
"administrator."
msgstr ""
"ផ្ទុយ​ពី​អ្វី​ដែល​ជំនួយ​រហ័ស​ផ្ដល់​យោបល់ វា​គឺ​ជា​ការ​ស្រប​ច្បាប់​ក្នុង​ការ​ផ្ញើ​អ៊ីមែល​សរសើរ និង​រីករាយ​អំពី CUPS និង "
"Kdeprint ទៅ​កាន់​អ្នក​គ្រប់គ្រង​ម៉ាស៊ីន​បម្រើ ។"

#. Tag: guilabel
#: cups-config.docbook:451
#, no-c-format
msgid "Server User"
msgstr "អ្នកប្រើ​ម៉ាស៊ីន​បម្រើ​"

#. Tag: para
#: cups-config.docbook:453
#, no-c-format
msgid ""
"The user the server runs under. Normally this must be <systemitem class="
"\"username\">lp</systemitem>, however you can configure things for another "
"user if needed."
msgstr ""
"អ្នក​ប្រើ​ដែល​ម៉ាស៊ីន​បម្រើ​រត់​ពី​ក្រោម ។ ជា​ធម្មតា​នេះ​ត្រូវ​តែ​ជា <systemitem class=\"username"
"\">lp</systemitem> ទោះ​យ៉ាងណា អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​អ្វី​សម្រាប់​អ្នក​ប្រើ​មួយ​ផ្សេង​ទៀត​បើ​"
"ត្រូវការ ។"

#. Tag: para
#: cups-config.docbook:458
#, no-c-format
msgid ""
"The server must be initially run as root to support the default "
"<acronym>IPP</acronym> port of 631. It changes users whenever an external "
"program is run."
msgstr ""
"ម៉ាស៊ីនបម្រើត្រូវ​តែ​ចាប់ផ្តើម​រត់​ជា រូត ដើម្បី​គាំទ្រ​ច្រក​លំនាំដើម <acronym>IPP</acronym> ៦៣១ ។ វា​"
"ផ្លាស់ប្តូរ​អ្នកប្រើ​ពេល​មាន​កម្មវិធី​ខាងក្រៅ​ត្រូវ​បាន​រត់ ។"

#. Tag: para
#: cups-config.docbook:464
#, no-c-format
msgid "Enter for example <userinput>lp</userinput>."
msgstr "បញ្ចូល ឧទាហរណ៍ <userinput>lp</userinput> ។"

#. Tag: para
#: cups-config.docbook:467
#, fuzzy, no-c-format
#| msgid ""
#| "This is the &UNIX; user account for filters and <acronym>CGI</acronym> "
#| "programs to run under. <acronym>CGI</acronym> programs are responsible "
#| "for showing you the nice web administration interface accessible via "
#| "<ulink url=\"http://localhost:631/\">http://localhost:631/</ulink>)."
msgid ""
"This is the &UNIX; user account for filters and <acronym>CGI</acronym> "
"programs to run under. (<acronym>CGI</acronym> programs are responsible for "
"showing you the nice web administration interface accessible via <ulink url="
"\"http://localhost:631/\">http://localhost:631/</ulink>)."
msgstr ""
"នេះជា​គណនី​អ្នកប្រើ យូនីក សម្រាប់​តម្រង និង​កម្មវិធី <acronym>CGI</acronym> ដើម្បី​រត់​ពី​ក្រោម ។ "
"កម្មវិធី <acronym>CGI</acronym> ត្រូវ​បាន​ទទួល​ខុសត្រូវ​ក្នុង​ការ​បង្ហាញ​ចំណុច​ប្រទាក់​ការ​គ្រប់គ្រង​តំបន់​"
"បណ្ដាញ​ស្រស់​ស្អាត​ដែល​អាច​ចូល​ដំណើរ​ការ​បាន​តាម​រយៈ <ulink url=\"http://localhost:631/"
"\">http://localhost:631/</ulink>) ។"

#. Tag: para
#: cups-config.docbook:474
#, no-c-format
msgid ""
"There is no need to set the <guilabel>User</guilabel> directive to "
"<systemitem class=\"username\">root</systemitem>, so never do this, as it "
"only involves dangers. Should anyone discover security vulnerabilities in "
"one of the used file filters, printer drivers or <acronym>CGI</acronym> "
"programs, he could remotely execute arbitrary commands on your system with "
"root user privileges. Always use an unprivileged account for the server "
"directive <guilabel>User</guilabel>."
msgstr ""
"មិន​ត្រូវការ​កំណត់​ការ​បង្គាប់ <guilabel>អ្នក​ប្រើ</guilabel> ទៅ <systemitem class="
"\"username\">root</systemitem> ដូច្នេះ​កុំ​ធ្វើ​នេះ ដែល​វា​មាន​គ្រោះថ្នាក់ ។ នរណា​ម្នាក់​គួរ​តែ​"
"រកឃើញ​ការ​ងាយស្រួល​ប៉ះពាល់​សុវត្ថិភាព​នៅ​ក្នុង​តម្រង​ឯកសារ​ដែល​ប្រើ កម្មវិធី​បញ្ជា​ម៉ាស៊ីន​បោះពុម្ព ឬ​កម្មវិធី "
"<acronym>CGI</acronym> គាត់​អាច​ប្រតិបត្តិ​ពាក្យ​បញ្ជា​ដែល​បំពាន​នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក​ដែល​មាន​សិទ្ធិ​អ្នក​"
"ប្រើ​រូត ។ ប្រើ​ជានិច្ច​គណនី​ដែល​គ្មាន​សិទ្ធិ​សម្រាប់​​ម៉ាស៊ីន​បម្រើ​បង្គាប់ <guilabel>អ្នក​ប្រើ</guilabel> ។"

#. Tag: para
#: cups-config.docbook:489
#, no-c-format
msgid ""
"The group the server runs under. Normally this must be <systemitem class="
"\"groupname\">sys</systemitem>, however you can configure things for another "
"group as needed."
msgstr ""
"ក្រុម​ដែល​ម៉ាស៊ីនបម្រើ​រត់​ពីក្រោម ។ ជា​ធម្មតា​នេះ​ត្រូវ​តែ​ជា <systemitem class=\"groupname"
"\">sys</systemitem> ទោះ​យ៉ាងណា អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​អ្វី​សម្រាប់​ក្រុម​មួយ​ផ្សេង​ទៀត​ដែល​ត្រូវការ ។"

#. Tag: para
#: cups-config.docbook:494
#, no-c-format
msgid "Enter for example <userinput>sys</userinput>."
msgstr "បញ្ចូល ឧទាហរណ៍ <userinput>sys</userinput> ។"

#. Tag: para
#: cups-config.docbook:502
#, no-c-format
msgid ""
"The name of the user assigned to unauthenticated accesses from remote "
"systems. By default <userinput>remroot</userinput>."
msgstr ""
"ឈ្មោះ​អ្នក​ប្រើ​ត្រូវ​បាន​ផ្ដល់​តម្លៃ​ឲ្យ​ចូល​ដំណើរ​ការ​ដែល​មិន​ផ្ទៀតផ្ទាត់​ភាព​ត្រឹមត្រូវ​ពី​ប្រព័ន្ធ​ពី​ចម្ងាយ ។ ដោយ​លំនាំ​"
"ដើម <userinput>remroot</userinput> ។"

#. Tag: para
#: cups-config.docbook:505
#, no-c-format
msgid ""
"This name will appear in log files and in queries about the job owner &etc;, "
"for all resources and locations of the &CUPS; server that are configured to "
"allow access <emphasis>without</emphasis> authentication. Authenticated "
"entries will carry the authenticated names."
msgstr ""
"ឈ្មោះ​នេះ នឹង​ត្រូវ​បានលេចឡើង​ក្នុង​ឯកសារ​កំណត់ហេតុ​ និង​ក្នុង​សំណួរ​អំពី​ការងារ​ផ្ទាល់​ខ្លួន ។ល។ ចំពោះ​គ្រប់​"
"ធនធាន និង​ទីតាំង​ទាំងអស់​​នៃ​ម៉ាស៊ីនបម្រើ CUPS ដែល​ត្រូវ​បាន​កំណត់​រចនាសម្ព័ន្ធ​ដើម្បី​អនុញ្ញាត​ឲ្យ​ចូល​ដំណើរការ "
"<emphasis>ដោយ​គ្មាន ​</emphasis> ការ​ផ្ទៀងផ្ទាត់​ភាពត្រឹមត្រូវ ។ ធាតុ​ដែលបាន​ផ្ទៀងផ្ទាត់​"
"ភាពត្រឹមត្រូវ​នឹង​យក​ឈ្មោះ​ដែល​បានផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ។"

#. Tag: title
#: cups-config.docbook:516
#, no-c-format
msgid "Server Logging Configuration"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​កំណត់​ហេតុ​ម៉ាស៊ីន​បម្រើ​"

#. Tag: para
#: cups-config.docbook:518
#, no-c-format
msgid "The server logging configuration is done on this screen. It includes:"
msgstr "ការ​កំណត់​រចនា​សម្ព័ន្ធ​​កំណត់​ហេតុ​ម៉ាស៊ីន​បម្រើ​​ត្រូវ​បាន​ធ្វើ​រួច​នៅ​លើ​អេក្រង់​នេះ ។ វា​រួម​បញ្ចូល​ទាំង ៖"

#. Tag: para
#: cups-config.docbook:522
#, no-c-format
msgid "<guilabel>Access log file</guilabel> setting"
msgstr "ការ​កំណត់ <guilabel>ចូល​ដំណើរ​ការ​ឯកសារ​កំណត់​ហេតុ </guilabel> "

#. Tag: para
#: cups-config.docbook:523
#, no-c-format
msgid "<guilabel>Error log file</guilabel> setting"
msgstr "ការ​កំណត់ <guilabel>ឯកសារ​កំណត់​ហេតុ​កំហុស</guilabel>"

#. Tag: para
#: cups-config.docbook:524
#, no-c-format
msgid "<guilabel>Page log</guilabel> file setting"
msgstr "ការ​កំណត់​ឯកសារ <guilabel>កំណត់​ហេតុ​ទំព័រ</guilabel>"

#. Tag: para
#: cups-config.docbook:525
#, no-c-format
msgid "<guilabel>Log level</guilabel> setting"
msgstr "ការ​កំណត់ <guilabel>កម្រិត​កំណត់​ហេតុ</guilabel>"

#. Tag: para
#: cups-config.docbook:526
#, no-c-format
msgid "<guilabel>Max log file size</guilabel> setting"
msgstr "ការ​កំណត់ <guilabel>ទំហំ​ឯកសារ​កំណត់​ហេតុ​អតិ​បរមា</guilabel>"

#. Tag: para
#: cups-config.docbook:530
#, no-c-format
msgid ""
"This is an important screen for you. Should you ever encounter problems: "
"here is the place to set the Log level to <quote>debug</quote>, restart the "
"&CUPS; daemon and then look at the Error log file defined here for entries "
"that might give you an insight to the trouble."
msgstr ""
"នេះ​ជា​អេក្រង់​ដ៏សំខាន់​សម្រាប់​អ្នក ។ អ្នក​គួរ​តែ​ធ្លាប់​ជួប​ប្រទះ​បញ្ហា​នេះ ៖ ទីនេះ​ជា​កន្លែង​កំណត់​កម្រិត​កំណត់​ហេតុ​​"
"ដើម្បី <quote>បំបាត់កំហុស</quote> ចាប់ផ្តើម​ដេមិន CUPS ឡើងវិញ ហើយ​បន្ទាប់មើល​ឯកសារ​កំណត់​ហេតុ​កំហុស​"
"ដែល​បាន​កំណត់ទីនេះ​សម្រាប់ធាតុ​ដែល​បាន​ផ្តល់​ឲ្យ​អ្នក​នូវ​បញ្ហា​យ៉ាង​ច្បាស់ ។"

#. Tag: screeninfo
#: cups-config.docbook:537
#, no-c-format
msgid "&CUPS; server configuration dialog: <guilabel>Server logging</guilabel>"
msgstr ""
"ប្រអប់​ការកំណត់​រចនាសម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ៖ <guilabel>ការ​ចុះកំណត់ហេតុ​ម៉ាស៊ីនបម្រើ​</guilabel>"

#. Tag: phrase
#: cups-config.docbook:544
#, no-c-format
msgid ""
"The dialog to configure the &CUPS; server: <guilabel>Server logging</"
"guilabel>"
msgstr ""
"ប្រអប់​សម្រាប់​កំណត់​រចនាសម្ព័ន្ធ​ម៉ាស៊ីន​បម្រើ CUPS ៖ <guilabel>កំណត់​ហេតុ​ម៉ាស៊ីនបម្រើ</guilabel>"

#. Tag: guilabel
#: cups-config.docbook:551
#, no-c-format
msgid "Access log file"
msgstr "ចូល​ដំណើរការ​ឯកសារ​កំណត់​ហេតុ​"

#. Tag: para
#: cups-config.docbook:553
#, no-c-format
msgid ""
"This is where accesses to the server are logged. If this does not start with "
"a leading <literal>/</literal>, then it is assumed to be relative to the "
"server root."
msgstr ""
"នេះ​គឺ​ជា​កន្លែង​ដែល​ការ​ចូល​ដំណើរ​ការ​ត្រូវ​បាន​ចុះ​កំណត់​ហេតុ ។ បើ​នេះ​មិន​ចាប់ផ្ដើម​ដោយ <literal>/</"
"literal> ដូច្នេះ​វា​ត្រូវ​បាន​សន្មត​ថាជាប់ទាក់​និង​ម៉ាស៊ីន​បម្រើ​រូត ។"

#. Tag: para
#: cups-config.docbook:557 cups-config.docbook:597 cups-config.docbook:621
#, no-c-format
msgid ""
"You can also use the special name <userinput>syslog</userinput> to send the "
"output to the syslog file or daemon."
msgstr ""
"អ្នកក៏​អាច​ប្រើ​ឈ្មោះ​ពិសេស <userinput>syslog</userinput> ដើម្បី​ផ្ញើ​ទិន្នផល​ទៅ​ឯកសារ syslog "
"ឬដេមិន ។"

#. Tag: para
#: cups-config.docbook:561
#, no-c-format
msgid ""
"Enter a path, for example <userinput><filename>/var/log/cups/acces_log</"
"filename></userinput>."
msgstr ""
"បញ្ចូល​ផ្លូវ ឧទាហរណ៍<userinput><filename>/var/log/cups/acces_log</filename></"
"userinput> ។"

#. Tag: para
#: cups-config.docbook:565
#, no-c-format
msgid ""
"The format of this file is stored in the so-called <quote>Common Log Format</"
"quote>. This way you can use programs such as <application>Webalyzer</"
"application> or any other Web access reporting tool to generate reports on "
"the &CUPS; server activities."
msgstr ""
"ទ្រង់ទ្រាយ​នៃ​ឯកសារ​នេះ​ត្រូវ​បាន​ផ្ទុក​ក្នុង <quote>ទ្រង់ទ្រាយ​កំណត់ហេតុ​ធម្មតា​</quote>ដែល​បាន​ធ្លាប់​"
"ហៅ ។ វិធីនេះ​អ្នកអាច​ប្រើ​កម្មវិធី​ដូចជា <application>Webalyzer</application> ឬ​ឧបករណ៍​"
"រាយការណ៍​ចូល​ដំណើរ​ការ​តំបន់​បណ្ដាញ​មួយ​ផ្សេង​ទៀត​នៅ​លើ​សកម្មភាព​ម៉ាស៊ីន​បម្រើ CUPS ។"

#. Tag: para
#: cups-config.docbook:570
#, no-c-format
msgid ""
"To include the server name in the file name use a <token>%s</token> in the "
"name. Example: <userinput><filename>/var/log/cups/access_log-%s</filename></"
"userinput>."
msgstr ""
"ដើម្បី​រួម​បញ្ចូល​ឈ្មោះ​ម៉ាស៊ីន​បម្រើ​ក្នុង​ឈ្មោះ​ឯកសារ​ប្រើ <token>%s</token> នៅ​ក្នុង​ឈ្មោះ ។ ឧទាហរណ៍ ៖ "
"<userinput><filename>/var/log/cups/access_log-%s</filename></userinput> ។"

#. Tag: screen
#: cups-config.docbook:574
#, no-c-format
msgid ""
"<prompt>kurt@transmeta:~ ></prompt><userinput><command>tail</command> "
"<parameter>/var/log/cups/access_log</parameter></userinput>\n"
"<computeroutput>\n"
"127.0.0.1    - - [04/Aug/2001:20:11:39 +0100] \"POST /printers/ HTTP/1.1\" "
"200 109\n"
"127.0.0.1    - - [04/Aug/2001:20:11:39 +0100] \"POST /admin/ HTTP/1.1\" 401 "
"0\n"
