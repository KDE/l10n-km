#. Tag: title
#: oilpaint.docbook:4
#, no-c-format
msgid "Oil Paint"
msgstr "គំនូរ​ប្រេង​"

#. Tag: author
#: oilpaint.docbook:7
#, no-c-format
msgid "<firstname>Gerhard</firstname><surname>Kulzer</surname>"
