#. Tag: title
#: keybindings.docbook:2
#, no-c-format
msgid "Key bindings"
msgstr "ការ​ចង​គ្រាប់​ចុច"

#. Tag: para
#: keybindings.docbook:4
#, no-c-format
msgid ""
"&kappname; comes with a range of keyboard shortcuts, all of which can be viewed "
"and remapped by selecting <menuchoice><guimenu>Settings</guimenu><guimenuitem>"
"Configure Shortcuts...</guimenuitem></menuchoice>. Note that in the Files and "
"Folders windows, all the normal KDE shortcuts are functional, unless otherwise "
"remapped."
msgstr ""
"Kappname មក​ជាមួយ​ផ្លូវកាត់​គ្រាប់​ចុច​មួយ​ចំនួន ដែល​ទាំងអស់​អាច​ត្រូវ​បាន​មើល "
"និង​កំណត់​ដោយ​ជ្រើស <menuchoice><guimenu>ការ​កំណត់</guimenu><guimenuitem>"
"កំណត់​រចនា​សម្ព័ន្ធ​ផ្លូវកាត់...</guimenuitem></menuchoice>"
" ។ ចំណាំ​ថា​ក្នុង​បង្អួច​ឯកសារ និង​ថត ផ្លូវ​កាត់ KDE ធម្មតា​ទាំង​អស់​មាន​មុខងារ "
"បើ​មិន​កំណត់​វា​ឡើង​វិញ​ទេ ។"

#. Tag: para
#: keybindings.docbook:9
#, no-c-format
msgid "A few of the most useful default bindings are:"
msgstr "ការ​ចង​លំនាំ​ដើម​ដែល​មាន​ប្រយោជន៍​បំផុត​មួយ​ចំនួន​គឺ ៖"

#. Tag: para
#: keybindings.docbook:12
#, no-c-format
msgid "<keycap>Space</keycap>: Displays the next image in the directory."
msgstr "<keycap>ដក​ឃ្លា</keycap> ៖ បង្ហាញ​រូបភាព​បន្ទាប់​ក្នុង​ថត ។"

#. Tag: para
#: keybindings.docbook:13
#, no-c-format
msgid ""
"<keycap>Backspace</keycap>: Displays the previous image in the directory."
msgstr "<keycap>លុប​ថយ​ក្រោយ</keycap> ៖ បង្ហាញ​រូបភាព​មុន​ក្នុង​ថត ។"

#. Tag: para
#: keybindings.docbook:14
#, no-c-format
msgid ""
"<keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></keycombo>"
": Toggles between Browse and View modes."
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl)<keycap>ត្រឡប់</keycap></keycombo>"
" ៖ បិទ/បើក​រវាង​របៀប​រុករក និង​មើល ។"

#. Tag: para
#: keybindings.docbook:16
#, no-c-format
msgid ""
"<keycombo action=\"simul\">&Ctrl; &Shift;<keycap>F</keycap></keycombo>"
": Activates Full Screen mode."
msgstr ""
"<keycombo action=\"simul\">បញ្ជា(Ctrl) ប្ដូរ(Shift)<keycap>F</keycap></keycombo>"
" ៖ ធ្វើ​ឲ្យ​សកម្ម​របៀប​អេក្រង់​ពេញ ។"

#. Tag: para
#: keybindings.docbook:18
#, no-c-format
msgid "<keycap>Escape</keycap>: Exits from Full Screen mode."
msgstr "<keycap>គេច</keycap> ៖ បិទ​ពី​របៀប​អេក្រង់​ពេញ ។"
