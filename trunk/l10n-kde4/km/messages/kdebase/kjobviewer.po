#: kjobviewer.cpp:134
msgid "All Printers"
msgstr "ម៉ាស៊ីន​បោះពុម្ព​ទាំង​អស់"

#: kjobviewer.cpp:141
msgid "There is no default printer. Start with --all to see all printers."
msgstr "គ្មាន​ម៉ាស៊ីន​បោះពុម្ព​លំនាំ​ដើម ។ ចាប់​ផ្ដើម​ជាមួយ --ទាំង​អស់ ដើម្បី​មើល​ម៉ាស៊ីន​បោះពុម្ព​ទាំង​អស់ ។"

#: kjobviewer.cpp:141
msgid "Print Error"
msgstr "កំហុស​បោះពុម្ព"

#: main.cpp:29
msgid "The printer for which jobs are requested"
msgstr "ម៉ាស៊ីន​បោះពុម្ព​ដែល​បាន​ស្នើ​សម្រាប់​ការងារ​បោះពុម្ព"

#: main.cpp:30
msgid "Show job viewer at startup"
msgstr "បង្ហាញ​ឧបករណ៍​​មើល​ការងារ​បោះពុម្ព នៅ​ពេល​ចាប់​ផ្ដើម"

#: main.cpp:31
msgid "Show jobs for all printers"
msgstr "បង្ហាញ​ការ​ងារ​សម្រាប់​ម៉ាស៊ីន​បោះពុម្ព​ទាំង​អស់"

#: main.cpp:38
msgid "KJobViewer"
msgstr "KJobViewer"

#: main.cpp:38
msgid "A print job viewer"
msgstr "ឧបករណ៍​​មើល​ការ​ងារ​បោះពុម្ព​មួយ"

