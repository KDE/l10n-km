msgstr "KDialog"

#: kdialog.cpp:645
msgid "KDialog can be used to show nice dialog boxes from shell scripts"
msgstr "KDialog អាច​ត្រូវ​បាន​ប្រើ ដើម្បី​បង្ហាញ​ប្រអប់​ស្អាត​ពី​ស្គ្រីប​សែល"

#: kdialog.cpp:647
