#: dashboardview.cpp:61
msgid "Hide Dashboard"
msgstr "លាក់​ប៉ាណ្ណូ​នាឡិកា"

#: dashboardview.cpp:93
msgid "Plasma Dashboard"
msgstr "លាក់​ប៉ាណ្ណូ​ប្លាស្មា"

#: dashboardview.cpp:136 plasmaapp.cpp:408
msgid "Add Widgets"
msgstr "បន្ថែម​ធាតុ​ក្រាហ្វិក"

#: desktopview.cpp:55
msgid "Next Activity"
msgstr "សកម្មភាព​បន្ទាប់"

#: desktopview.cpp:60
msgid "Previous Activity"
msgstr "សកម្មភាព​មុន"

#: main.cpp:29
msgid "The KDE desktop, panels and widgets workspace application."
msgstr "ផ្ទៃតុ KDE កម្មវិធី​របស់​តំបន់​ធ្វើការ​ធាតុ​ក្រាហ្វិក និង​បន្ទះ ។"

#: main.cpp:35
msgid "Plasma Workspace"
msgstr "តំបន់​ធ្វើការ​របស់​ប្លាស្មា"

#: main.cpp:37
msgid "Copyright 2006-2007, The KDE Team"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៦-២០០៧ ដោយ​ក្រុម KDE"

#: main.cpp:38
msgid "Aaron J. Seigo"
msgstr "Aaron J. Seigo"

#: main.cpp:39
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: main.cpp:41
msgid "John Lions"
msgstr "John Lions"

#: main.cpp:42
msgid "In memory of his contributions, 1937-1998."
msgstr "នៅ​ក្នុង​ការ​ចងចាំ​​នៃ​កា​រចែកចាយ​របស់ ១៩៣៧-១៩៩៨ ។"

#: main.cpp:48
msgid "Starts plasma as an ordinary window rather than as the desktop."
msgstr "ចាប់ផ្ដើម​ប្លាស្មា​ជា​បង្អួច​ធម្មតា​ ប្រសើរ​ជាង​ជា​ផ្ទៃតុ ។"

#: panelcontroller.cpp:345
msgid "Align panel to left"
msgstr "កំណត់​បន្ទះ​ទៅ​ឆ្វេង"

#: panelcontroller.cpp:350
msgid "Align panel to center"
msgstr "កំណត់​បន្ទះ​ទៅ​កណ្ដាល"

#: panelcontroller.cpp:354
msgid "Align panel to right"
msgstr "កំណត់​បន្ទះ​ទៅស្ដាំ"

#: panelcontroller.cpp:362
msgid "Close this configuration window"
msgstr "បិទ​បង្អួច​កំណត់រចនា​សម្ព័ន្ធ​នេះ"

#: plasmaapp.cpp:207
msgid "Show Dashboard"
msgstr "បង្ហាញ​ប៉ាណ្ណូ​នាឡិកា"

#: positioningruler.cpp:453
msgid "Move this slider to set the panel position"
msgstr "ផ្លាស់ទី​គ្រាប់រំកិល​នេះ​ ដើម្បី​កំណត់​ទីតាំង​បន្ទះ"

#: positioningruler.cpp:456
msgid "Move this slider to set the maximum panel size"
msgstr "ផ្លាស់ទី​គ្រប់រំកិល​នេះ​ដើម្បី​កំណត់​ទំហំ​បន្ទះ​អតិបរមា"

#: positioningruler.cpp:459
msgid "Move this slider to set the minimum panel size"
msgstr "ផ្លាស់ទី​គ្រាប់រំកិលនេះ​ដើម្បី​កំណត់​ទំហំ​បន្ទះ​អប្បបរមា"

