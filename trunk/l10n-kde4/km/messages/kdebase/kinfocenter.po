msgstr "របាយការណ៍​កំហុស​អំពី​ម៉ូឌុល %1..."

#~ msgid "KDE Control Center"
#~ msgstr "ការ​កំណត់​ផ្ទាល់​ខ្លួន​របស់ KDE"

#~ msgid "Configure your desktop environment"
#~ msgstr "កំណត់​រចនាសម្ព័ន្ធ​បរិស្ថាន​ផ្ទៃតុ​របស់​អ្នក"

#~ msgid ""
#~ "Welcome to the \"KDE Control Center\", a central place to configure your "
#~ "desktop environment. Select an item from the index on the left to load a "
#~ "configuration module."
#~ msgstr ""
#~ "សូម​ស្វាគមន៍​មក​កាន់ \"ការ​កំណត់​ផ្ទាល់​ខ្លួន​របស់ KDE\" ជា​មជ្ឈមណ្ឌល​សម្រាប់​​កំណត់​រចនាសម្ព័ន្ធ​បរិស្ថាន​"
#~ "ផ្ទៃតុ​របស់​អ្នក ។ ជ្រើស​ធាតុ​មួយ​ពី​លិបិក្រម​នៅ​ខាង​ឆ្វេង ដើម្បី​ផ្ទុក​ម៉ូឌុល​កំណត់​រចនាសម្ព័ន្ធ ។"

#~ msgid ""
#~ "<p>Use the \"Whats This\" (Shift+F1) to get help on specific options.</"
#~ "p><p>To read the full manual click <a href=\"%1\">here</a>.</p>"
#~ msgstr ""
#~ "<p>ប្រើ \"នេះ​ជា​អ្វី?\" (ប្ដូរ (Shift) + F1) ដើម្បី​ទទួល​ជំនួយ​អំពី​ជម្រើស​ជាក់​លាក់ ។</"
#~ "p><p>ដើម្បី​អាន​សៀវភៅ​ពេញលេញ ចុច​ <a href=\"%1\">ទីនេះ</a> ។</p>"

#~ msgid ""
#~ "<big>You need super user privileges to run this control module.</big><br /"
#~ ">Click on the \"Administrator Mode\" button below."
#~ msgstr ""
#~ "<big>អ្នក​ត្រូវ​ការ​សិទ្ធិ​អ្នក​ប្រើ​ជាន់​ខ្ពស់ ដើម្បី​រត់​ម៉ូឌុល​បញ្ជា​នេះ ។</big><br>ចុច​លើ​ប៊ុតុង \"របៀប​"
#~ "អ្នក​គ្រប់​គ្រង\" ខាង​ក្រោម ។"

#~ msgctxt "go back"
#~ msgid "Back"
#~ msgstr "ថយក្រោយ​"

#~ msgid "<big>Loading...</big>"
#~ msgstr "<big>កំពុង​ផ្ទុក...</big>"

#~ msgid "The %1 configuration group. Click to open it."
#~ msgstr "ក្រុម​កំណត់​រចនាសម្ព័ន្ធ %1 ។ ចុច​ដើម្បី​បើក​វា ។"

#~ msgid ""
#~ "This treeview displays all available control modules. Click on one of the "
#~ "modules to receive more detailed information."
#~ msgstr ""
#~ "ទិដ្ឋភាព​មែកធាង​នេះ​បង្ហាញ​ម៉ូឌុល​បញ្ជា​ដែល​មាន​ទាំង​អស់ ។ ចុច​លើ​ម៉ូឌុល​មួយ​ក្នុង​ចំណោម​ម៉ូឌុល​ទាំង​នេះ ដើម្បី​ទទួល​"
#~ "ព័ត៌មាន​លម្អិត​បន្ថែម​ទៀត ។"

#~ msgid ""
#~ "<b>Changes in this module require root access.</b><br />Click the "
#~ "\"Administrator Mode\" button to allow modifications in this module."
#~ msgstr ""
#~ "<b>ផ្លាស់​ប្ដូរ​ក្នុង​ម៉ូឌុល​នេះ ត្រូវ​ការ​សិទ្ធិ​ចូល​ដំណើរ​ការ​ជា root ។</b><br>ចុច​ប៊ូតុង \"របៀប​អ្នក​គ្រប់​"
#~ "គ្រង\" ដើម្បី​អនុញ្ញាត​ឲ្យ​កែប្រែ​ក្នុង​ម៉ូឌុល​នេះ ។"

#~ msgid ""
#~ "This module requires special permissions, probably for system-wide "
#~ "modifications; therefore, it is required that you provide the root "
#~ "password to be able to change the module's properties.  If you do not "
#~ "provide the password, the module will be disabled."
#~ msgstr ""
#~ "ម៉ូឌុល​នេះ​ត្រូវ​ការ​សិទ្ធិ​ពិសេស សម្រាប់​ការ​កែប្រែ​ប្រព័ន្ធ​ទាំងមូល ដូច្នេះ​វា​តម្រូវ​ឲ្យ​អ្នក​បញ្ចូល​​​ពាក្យ ​សម្ងាត់​"
#~ "ជា root ​ដើម្បី​ឲ្យ​​មាន​លទ្ធភាព​ផ្លាស់ប្ដូរ​លក្ខណៈ​សម្បត្តិ​របស់​ម៉ូឌុល ។  ​បើ​អ្នក​មិន​ផ្ដល់​ពាក្យ​សម្ងាត់​ទេ "
#~ "ម៉ូឌុល​នេះ​នឹង​មិន​អាច​ប្រើ​បាន​ឡើយ ។"

