#: appletproxy.cpp:55 appletproxy.cpp:57
msgid "Panel applet proxy."
msgstr "ប្រូកស៊ី​របស់​បន្ទះ​អាប់​ភ្លេត ។"

#: appletproxy.cpp:59
msgid "(c) 2000, The KDE Developers"
msgstr ""

#: appletproxy.cpp:61
msgid "Matthias Elter"
msgstr ""

#: appletproxy.cpp:62
msgid "Matthias Ettrich"
msgstr ""

#: appletproxy.cpp:66
msgid "The applet's desktop file"
msgstr "ឯកសារ​ផ្ទៃតុ​របស់​អាប់ភ្លេត"

#: appletproxy.cpp:67
msgid "The config file to be used"
msgstr "ឯកសារ​កំណត់​រចនាសម្ព័ន្ធ​ដែល​ត្រូវ​ប្រើ"

#: appletproxy.cpp:82
msgid "No desktop file specified"
msgstr "គ្មាន​ឯកសារ​ផ្ទៃតុ​ត្រូវ​បាន​បញ្ជាក់​លម្អិត"

#: appletproxy.cpp:115
msgid "The applet proxy could not be started due to DCOP communication problems."
msgstr "មិន​អាច​ចាប់ផ្ដើម​ប្រូកស៊ី​អាប់ភ្លេត ដោយ​សារ​តែ​បញ្ហា​ទំនាក់ទំនង DCOP ។"

#: appletproxy.cpp:116 appletproxy.cpp:124 appletproxy.cpp:158
#: appletproxy.cpp:179
msgid "Applet Loading Error"
msgstr "កំហុស​ផ្ទុក​អាប់ភ្លេត"

#: appletproxy.cpp:123
msgid "The applet proxy could not be started due to DCOP registration problems."
msgstr "មិន​អាច​ចាប់ផ្ដើម​ប្រូកស៊ី​អាប់ភ្លេត ដោយ​សារ​តែ​បញ្ហា​ចុះឈ្មោះ DCOP ។"

#: appletproxy.cpp:157
#, qt-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "ប្រូកស៊ីអាប់ភ្លេត​មិន​អាច​ផ្ទុក​ព័ត៌មាន​អាប់ភ្លេត​ពី %1 ។"

#: appletproxy.cpp:178
#, qt-format
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "មិន​អាច​ផ្ទុក​អាប់ភ្លេត %1 តាម​រយៈ​ប្រូកស៊ី​អាប់ភ្លេត ។"

