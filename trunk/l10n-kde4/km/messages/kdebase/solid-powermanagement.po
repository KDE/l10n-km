#: solid-powermanagement.cpp:197
msgid "Syntax:"
msgstr "វាក្យសម្ពន្ធ ៖"

#: solid-powermanagement.cpp:200
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # រាយ​សំណុំ​ជាក់លាក់​របស់​ព័ត៌មាន​ទាក់ទង​នឹង​ការ​គ្រប់គ្រង​ថាមពល ។\n"
"             # - ប្រសិន​បើ​ជម្រើស 'ផ្អាក' ត្រូវ​បាន​បញ្ជាក់ ផ្ដល់​បញ្ជី​​កា​រផ្អាក\n"
"             # វិធីសាស្ត្រ​បានគាំទ្រ​ដោយ​ប្រព័ន្ធ\n"
"             # - ប្រសិន​បើ​ជម្រើស 'គោងការណ៍' ត្រូវ​បាន​បញ្ជាក់ ផ្ដល់​នូវ​បញ្ជី\n"
"             # គ្រោងការណ៍​គ្រប់គ្រង​ថាមពល​ដែល​បានគាំទ្រដោយ​ប្រព័ន្ធ​នេះ\n"
"             # - ប្រសិនបើ​ជម្រើស 'cpufreq' ត្រូវ​បាន​បញ្ជាក់ ផ្ដល់​នូវ​បញ្ជី\n"
"             # គោលនយោបាយ​ប្រេកង់​ស៊ីភីយូ​ដែល​បាន​គាំទ្រ\n"

#: solid-powermanagement.cpp:209
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # កំណត់​ជម្រើស​គ្រប់គ្រង​ថាមពល​របស់​ប្រព័ន្ធ ។\n"
"             # - ប្រសិន​បើ​បាន​បញ្ជាក់​ជម្រើស 'គ្រោងការណ៍' នោះ​សំណុំ​គ្រោងការណ៍​\n"
"             # ការគ្រប់គ្រង​ថាមពល​ទាក់ទង​នឹង 'តម្លៃ'\n"
"             # - ប្រសិន​បើ​បានបញ្ជាក់​ជម្រើស 'cpufreq' នោះ​សំណុំ​គោលការណ៍​ប្រេកង់ CPU\n"
"             # ទាក់ទង​នឹង 'តម្លៃ'\n"

#: solid-powermanagement.cpp:216
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # ផ្អាក​កុំព្យូទ័រ​ដោយប្រើ 'វិធីសាស្ដ្រ​' ដែលបាន​ផ្ដល់ ។\n"

