msgstr "KWin"

#: main.cpp:271
msgid "KWin helper utility"
msgstr "ឧបករណ៍​ប្រើប្រាស់​កម្មវិធី​ជំនួយ KWin"

#: main.cpp:274
msgid "WId of the window for special window settings."
