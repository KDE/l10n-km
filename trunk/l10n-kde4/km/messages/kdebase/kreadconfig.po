#: kreadconfig.cpp:36
msgid "KReadConfig"
msgstr "KReadConfig"

#: kreadconfig.cpp:38
msgid "Read KConfig entries - for use in shell scripts"
msgstr "អាន​ធាតុ​បញ្ចូល KConfig - ដែលត្រូវ​ប្រើ​ក្នុងស្គ្រីប​សែល"

