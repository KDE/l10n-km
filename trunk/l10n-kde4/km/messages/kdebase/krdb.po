#: krdb.cpp:353
#, kde-format
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the "
"checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# បាន​បង្កើត​ដោយ KDE %1\n"
"#\n"
"# បើ​អ្នក​មិន​ចង់​ឲ្យ KDE បដិសេធ​ការ​កំណត់ GTK របស់​អ្នក សូម​ជ្រើស\n"
"# រូបរាង & ស្បែក -> ពណ៌ នៅ​ក្នុង​ការ​កំណត់​ផ្ទាល់ខ្លួន ហើយបិទ​ប្រអប់​ធីក\n"
"# \"អនុវត្ត​ពណ៌​ទៅ​កម្មវិធី​មិនមែន KDE\"\n"
"#\n"
"#\n"

