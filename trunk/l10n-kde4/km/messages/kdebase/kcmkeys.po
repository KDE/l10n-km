#: globalshortcuts.cpp:65
msgid "Import scheme ..."
msgstr "នាំចូល​​គ្រោងការណ៍..."

#: globalshortcuts.cpp:70
msgid "Export scheme ..."
msgstr "នាំចេញ​គ្រោងការណ៍..."

#: globalshortcuts.cpp:165
msgid ""
"Your current changes will be lost if you load another scheme before saving "
"this one"
msgstr ""
"ការ​ផ្លាស់ប្តូរ​បច្ចុប្បន្ន​របស់​អ្នក​នឹង​ត្រូវ​បាត់បង់ បើ​អ្នក​ផ្ទុក​គ្រោងការណ៍​មួយ​ផ្សេង​មុន​ពេល​រក្សា​ទុក​មួយ​នេះ"

#: globalshortcuts.cpp:166
msgid "Load shortcurt scheme"
msgstr "ផ្ទុក​គ្រោងការណ៍​ផ្លូវកាត់"

#: globalshortcuts.cpp:167
msgid "Load"
msgstr "ផ្ទុក"

#: globalshortcuts.cpp:180
#, kde-format
msgid "This file (%1) does not exist. You can just select local file."
msgstr "មិន​​ទាន់​មាន​ឯកសារ (%1) នៅ​ឡើយ​ទេ ។ អ្នក​គ្រាន់​តែ​ជ្រើស​ឯកសារ​មូលដ្ឋាន ។"

#. i18n: tag string
#. i18n: file kglobalshortcutseditor.ui line 16
#: rc.cpp:3
msgid "KDE component:"
msgstr "សមាសភាគ KDE ៖"

#. i18n: tag string
#. i18n: file kglobalshortcutseditor.ui line 26
#: rc.cpp:6
msgid "Shortcuts:"
msgstr "ផ្លូវ​កាត់ ៖"

#. i18n: tag string
#. i18n: file select_scheme_dialog.ui line 20
#: rc.cpp:9
msgid "Select a schortcut scheme"
msgstr "ជ្រើស​គ្រោងការណ៍​ផ្លូវកាត់"

#. i18n: tag string
#. i18n: file select_scheme_dialog.ui line 47
#: rc.cpp:12
msgid "Select one of the standard shortcut schemes of KDE"
msgstr "ជ្រើស​គ្រោងការណ៍​ផ្លូវកាត់​ស្តង់ដារ​របស់ KDE មួយ"

#. i18n: tag string
#. i18n: file select_scheme_dialog.ui line 50
#: rc.cpp:15
msgid "&Standard Scheme"
msgstr "គ្រោងការណ៍​ស្តង់ដារ"

#. i18n: tag string
#. i18n: file select_scheme_dialog.ui line 100
#: rc.cpp:18
msgid "Select a shortcut scheme file"
msgstr "ជ្រើស​ឯកសារ​គ្រោងការណ៍​ផ្លូវកាត់"

#. i18n: tag string
#. i18n: file select_scheme_dialog.ui line 103
#: rc.cpp:21
msgid "&Path"
msgstr "ផ្លូវ"
