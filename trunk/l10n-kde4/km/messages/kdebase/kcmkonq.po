#~ msgstr ""
#~ "ជម្រើស​នេះ​​អាច​ជ្រើស ពេល​មើល​ឯកសារ​ជា​មុន រូប​តំណាង​ថត និង​ទិន្នន័យ​​មេតា ក្នុង​កម្មវិធី​គ្រប់គ្រង​ឯកសារ​គួរ​"
#~ "ត្រូវ​បាន​ធ្វើ​ឲ្យ​សកម្ម ។\n"
#~ "នៅ​ក្នុង​បញ្ជី​ពិធីការ​ដែល​លេច​ឡើង ជ្រើស​ពិធីការ​មួយ​ណា​ដែល​លឿន​ល្មម​សម្រាប់​អ្នក ​ដើម្បី​អនុញ្ញាត​ឲ្យ​ការមើល​ជា​"
#~ "មុន​អាច​ត្រូវ​បាន​បង្កើត ។"

#~ msgid "&Maximum file size:"
#~ msgstr "ទំហំ​ឯកសារ​អតិបរមា ៖"

#~ msgid " MB"
#~ msgstr " មេកាបៃ"

#~ msgid "&Increase size of previews relative to icons"
#~ msgstr "បង្កើន​ទំហំ​ការ​មើល​ជាមុន​ដែល​ទាក់ទង​នឹង​រូប​តំណាង"

#~ msgid "&Use thumbnails embedded in files"
#~ msgstr "ប្រើ​រូបភាព​តូច​ដែល​បង្កប់​ក្នុង​ឯកសារ"

#~ msgid ""
#~ "Select this to use thumbnails that are found inside some file types (e.g. "
#~ "JPEG). This will increase speed and reduce disk usage. Deselect it if you "
#~ "have files that have been processed by programs which create inaccurate "
#~ "thumbnails, such as ImageMagick."
#~ msgstr ""
#~ "ជ្រើស​វា ដើម្បី​ប្រើ​រូបភាព​តូចៗ​​ដែល​បាន​រក​ឃើញ​ខាង​ក្នុង​ប្រភេទ​ឯកសារ​មួយ​ចំនួន (ដូចជា JPEG) ។ ការ​"
#~ "នេះ​នឹង​បង្កើន​ល្បឿន ហើយ​បន្ថយ​ការ​ប្រើប្រាស់​ថាស ។ ដោះ​ជ្រើស​វា បើ​អ្នក​មាន​ឯកសារ​ដែល​បាន​ដំណើរ​ការ​"
#~ "ដោយ​កម្មវិធី​ដែល​បង្កើត​រូបភាព​តូច​មិន​ត្រឹមត្រូវ ដូចជា ImageMagick ។"
