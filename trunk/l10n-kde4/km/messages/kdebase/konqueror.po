#: settings/konqhtml/jspolicies.cpp:185
msgid "Deny"
msgstr "បដិសេធ"

#: settings/konqhtml/jspolicies.cpp:186
msgid "Reject all popup window requests."
msgstr "ច្រានចោល​រាល់​សំណើ​បង្អួច​លេចឡើង"

#  i18n: file iconview/konq_multicolumnview.rc line 25
#: settings/konqhtml/jspolicies.cpp:191
msgid "Smart"
msgstr "ឆ្លាត"

#: settings/konqhtml/jspolicies.cpp:192
msgid ""
"Accept popup window requests only when links are activated through an "
"explicit mouse click or keyboard operation."
msgstr ""
"ព្រមទទួល​សំណើ​បង្អួច​លេច​ឡើង បាន​តែ​ពេល​តំណ​ត្រូវ​បាន​ធ្វើ​ឲ្យ​សកម្ម​តាម​រយៈ​ការ​ចុច​កណ្ដុរ ឬ ប្រតិបត្តិការ​"
"ក្ដារចុចតែ​ប៉ុណ្ណោះ ។"

#: settings/konqhtml/jspolicies.cpp:199
msgid ""
"If you disable this, Konqueror will stop interpreting the <i>window.open()</"
"i> JavaScript command. This is useful if you regularly visit sites that make "
"extensive use of this command to pop up ad banners.<br /><br /><b>Note:</b> "
"Disabling this option might also break certain sites that require <i>window."
"open()</i> for proper operation. Use this feature carefully."
msgstr ""
"បើ​អ្នក​មិន​អនុញ្ញាត​ជម្រើស​នេះ​ទេ នោះ Konqueror នឹង​ឈប់​បក​ប្រែ​ពាក្យ​បញ្ជា ​JavaScript ភ្លាម "
"<i>window.open()</i> ។ វា​មាន​ប្រយោជន៍ បើ​អ្នក​ទស្សនា​តំបន់​ប្រើ​ពាក្យ​បញ្ជា​នោះ ដើម្បី​បង្ហាញ​ផ្ទាំង​"
"ផ្សាយ​ពាណិជ្ជកម្ម ។<br /><br /><b>ចំណាំ ៖</b>ការ​ធ្វើ​ឲ្យ​ជម្រើស​នេះ​មិន​អាច​ប្រើ​បាន អាច​នឹង​បញ្ឈប់​"
"តំបន់​បណ្តាញ​ជាក់លាក់​ដែលទាមទា​ប្រតិបត្តិការ <i>window.open()</i> ឲ្យ​បាន​ត្រឹមត្រូវ  ប្រើ​លក្ខណៈ​"
"ពិសេស​នេះ​ដោយ​ប្រុង​ប្រយ័ត្ន ។"

#: settings/konqhtml/jspolicies.cpp:213
msgid "Resize window:"
msgstr "ប្តូរ​ទំហំ​បង្អួច ៖"

#: settings/konqhtml/jspolicies.cpp:229
msgid "Allow scripts to change the window size."
msgstr "អនុញ្ញាត​ឲ្យ​ស្គ្រីប​ផ្លាស់ប្តូរ​ទំហំ​បង្អួច ។"

#: settings/konqhtml/jspolicies.cpp:234 settings/konqhtml/jspolicies.cpp:272
#: settings/konqhtml/jspolicies.cpp:310 settings/konqhtml/jspolicies.cpp:351
msgid "Ignore"
msgstr "មិន​អើពើ"

#: settings/konqhtml/jspolicies.cpp:235
msgid ""
"Ignore attempts of scripts to change the window size. The web page will "
"<i>think</i> it changed the size but the actual window is not affected."
msgstr ""
"មិន​អើពើ​ការ​ប៉ុនប៉ងរបស់ស្គ្រីប ដើម្បី​ផ្លាស់​ប្តូរ​ទំហំ​បង្អួច ។ ទំព័រ​បណ្ដាញ​នឹង <i>គិតថា</i> វា​បាន​ប្តូរ ​ទំហំ "
"ប៉ុន្តែ​បង្អួច​ពិតប្រាកដ​មិន​ត្រូវ​បាន​ប៉ះពាល់​ឡើយ ។"

#: settings/konqhtml/jspolicies.cpp:242
msgid ""
"Some websites change the window size on their own by using <i>window.resizeBy"
"()</i> or <i>window.resizeTo()</i>. This option specifies the treatment of "
"such attempts."
msgstr ""
"តំបន់​បណ្ដាញ​មួយ​ចំនួន​ ផ្លាស់ប្ដូរ​ទំហំ​បង្អួច​ដោយ​ខ្លួន​វា​ផ្ទាល់ ដោយ​ប្រើ<i>window.resizeBy()</i> ឬ "
"<i>window.resizeTo()</i> ។ ជម្រើស​នេះ​បញ្ជាក់​ពី​ការប្រព្រឹត្ត ។"

#: settings/konqhtml/jspolicies.cpp:251
msgid "Move window:"
msgstr "ផ្លាស់ទី​បង្អួច ៖"

#: settings/konqhtml/jspolicies.cpp:267
msgid "Allow scripts to change the window position."
msgstr "អនុញ្ញាត​ឲ្យ​ស្គ្រីប​ផ្លាស់ប្តូរ​ទីតាំង​បង្អួច ។"

#: settings/konqhtml/jspolicies.cpp:273
msgid ""
"Ignore attempts of scripts to change the window position. The web page will "
"<i>think</i> it moved the window but the actual position is not affected."
msgstr ""
"មិនអើពើ​ការ​ប៉ុនប៉ង​របស់​ស្គ្រីប ដើម្បី​ផ្លាស់​ប្តូរ​ទីតាំង​របស់​បង្អួច ។ ទំព័រ​បណ្ដាញ​នឹង <i>គិតថា</i> វា​បាន​"
"ផ្លាស់ទី​បង្អួច ប៉ុន្តែ​ទីតាំងពិតប្រាកដ​មិន​ត្រូវ​បានប៉ះពាល់​ឡើយ ។"

#: settings/konqhtml/jspolicies.cpp:280
msgid ""
"Some websites change the window position on their own by using <i>window."
"moveBy()</i> or <i>window.moveTo()</i>. This option specifies the treatment "
"of such attempts."
msgstr ""
"តំបន់​បណ្ដាញ​មួយ​ចំនួន​ផ្លាស់​​ប្ដូរទីតាំង​របស់​បង្អួច​ដោយ​ខ្លួន​វា​ផ្ទាល់ ដោយ​ប្រើ<i>window.moveBy()</i> ឬ "
"<i>window.moveTo()</i> ។ ជម្រើស​នេះ​បញ្ជាក់​ពី​ការប្រព្រឹត្ត ។"

#: settings/konqhtml/jspolicies.cpp:289
msgid "Focus window:"
msgstr "ផ្តោត​អារម្មណ៍​លើ​បង្អួច ៖"

#: settings/konqhtml/jspolicies.cpp:305
msgid "Allow scripts to focus the window."
msgstr "អនុញ្ញាត​ឲ្យ​ស្គ្រីបផ្តោតអារម្មណ៍លើ​បង្អួច ។"

#: settings/konqhtml/jspolicies.cpp:311
msgid ""
"Ignore attempts of scripts to focus the window. The web page will <i>think</"
"i> it brought the focus to the window but the actual focus will remain "
"unchanged."
msgstr ""
"មិនអើពើ​ការ​ប៉ុនប៉ង​ស្គ្រីប ដើម្បីផ្ដោតអារម្មណ៍​​បង្អួច ។ ទំព័រ​បណ្ដាញ​នឹង <i>គិតថា</i> វា​បាន​នាំ​ការ​ផ្ដោត​"
"អារម្មណ៍​ទៅ​បង្អួច ប៉ុន្តែ​ការ​ផ្ដោតពិតប្រាកដ​នឹង​នៅ​ដដែល ។"

#: settings/konqhtml/jspolicies.cpp:319
msgid ""
"Some websites set the focus to their browser window on their own by using "
"<i>window.focus()</i>. This usually leads to the window being moved to the "
"front interrupting whatever action the user was dedicated to at that time. "
"This option specifies the treatment of such attempts."
msgstr ""
"តំបន់​បណ្ដាញ​មួយ​ចំនួន​ផ្លាស់​ប្ដូរការ​កំណត់ផ្ដោត​ទៅ​បង្អួច​កម្មវិធី​រុករក​របស់​ពួក​គេដោយ​ខ្លួនគេផ្ទាល់ ដោយ​"
"ប្រើ<i>window.focus()</i> ។ ជា​ទូទៅ វា​ធ្វើ​ឲ្យ​បង្អួច​ផ្លាស់ទី​ទៅ​មុខ និង​​បង្អាក់​អំពើ​ដែល​អ្នក​ប្រើ​កំពុង​"
"ធ្វើ​ក្នុង​ពេល​នោះ ។  ជម្រើស​នេះ​បញ្ជាក់​ពី​ការប្រព្រឹត្ត ។"

#: settings/konqhtml/jspolicies.cpp:330
msgid "Modify status bar text:"
msgstr "កែសម្រួល​អត្ថបទ​របស់​របារ​ស្ថានភាព ៖"

#: settings/konqhtml/jspolicies.cpp:346
msgid "Allow scripts to change the text of the status bar."
msgstr "អនុញ្ញាត​ឲ្យ​ស្គ្រីប​ប្តូរ​អត្ថបទ​របស់​របារ​ស្ថានភាព ។"

#: settings/konqhtml/jspolicies.cpp:352
msgid ""
"Ignore attempts of scripts to change the status bar text. The web page will "
"<i>think</i> it changed the text but the actual text will remain unchanged."
msgstr ""
"មិនអើពើ​ការ​ប៉ុនប៉ង​នៃ​ស្គ្រីប ដើម្បី​ផ្លាស់​ប្តូរ​អត្ថបទ​របារ​ស្ថានភាព ។ ទំព័រ​បណ្ដាញ​នឹង <i>គិតថា</i> វា​"
"បាន​ប្តូរអត្ថបទ ប៉ុន្តែ​អត្ថបទពិតប្រាកដ​នឹង​នៅ​ដដែល ។"

#: settings/konqhtml/jspolicies.cpp:360
msgid ""
"Some websites change the status bar text by setting <i>window.status</i> or "
"<i>window.defaultStatus</i>, thus sometimes preventing displaying the real "
"URLs of hyperlinks. This option specifies the treatment of such attempts."
msgstr ""
"តំបន់​បណ្តាញ​មួយ​ចំនួន​ប្ដូរ​របារ​ស្ថានភាព​អត្ថបទ​ដោយ​ការ​កំណត់​ <i>window.status</i> ឬ<i>window."
"defaultStatus</i> ដូច្នេះ​ពេល​ខ្លះ​អាច​ការពារ​ការ​បង្ហាញ​ URLs របស់​តណ​ខ្ពស់ ។ ជម្រើស​នេះ​បញ្ជាក់​"
"ការ​តាមដាន​នៃ​ការ​ប៉ុនប៉ង ។"

