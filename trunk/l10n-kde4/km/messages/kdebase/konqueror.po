#: settings/filetypes/filetypesview.cpp:113
msgid "Click here to add a new file type."
msgstr "ចុច​ទីនេះ ដើម្បី​បន្ថែម​ប្រភេទ​ឯកសារ​ថ្មី​មួយ ។"

#: settings/filetypes/filetypesview.cpp:115
msgid "&Remove"
msgstr "យក​ចេញ​"

#: settings/filetypes/filetypesview.cpp:120
msgid "Click here to remove the selected file type."
msgstr "ចុច​ទីនេះ ដើម្បី​យក​ប្រភេទ​ឯកសារ​ដែល​បាន​ជ្រើស​ចេញ ។"

#: settings/filetypes/filetypesview.cpp:142
msgid "Select a file type by name or by extension"
msgstr "ជ្រើស​ប្រភេទ​ឯកសារ​មួយ តាម​រយៈ​ឈ្មោះ ឬកន្ទុយឯកសារ​"

#: settings/filetypes/filetypedetails.cpp:49
msgid ""
"This button displays the icon associated with the selected file type. Click "
"on it to choose a different icon."
msgstr ""
"ប៊ូតុង​នេះ​បង្ហាញ​រូបតំណាង ដែល​ភ្ជាប់នឹង​ប្រភេទ​ឯកសារ​ដែល​បាន​ជ្រើស ។ ចុច​វា ដើម្បី​ជ្រើស​រូបតំណាង​ផ្សេង​"
"ទៀត ។"

#: settings/filetypes/filetypedetails.cpp:52
msgid "Filename Patterns"
msgstr "លំនាំ​របស់​ឈ្មោះឯកសារ"

#: settings/filetypes/filetypedetails.cpp:65
msgid ""
"This box contains a list of patterns that can be used to identify files of "
"the selected type. For example, the pattern *.txt is associated with the "
"file type 'text/plain'; all files ending in '.txt' are recognized as plain "
"text files."
msgstr ""
"ប្រអប់​នេះ​មាន​បញ្ជី​របស់​លំនាំ​ដែល​អាច​ត្រូវ​បាន​ប្រើ ដើម្បី​កំណត់​អត្តសញ្ញាណ​ឯកសារ​របស់​ប្រភេទ​ដែល​បាន​ជ្រើស ។ "
"ឧទាហរណ៍ លំនាំ *.txt គឺ​ជា​ប្រភេទឯកសារ 'text/plain'; ឯកសារ​ទាំងអស់​ដែល​បញ្ចប់​ដោយ '.txt' ត្រូវ​"
"បាន​ទទួល​ស្គាល់​ជា​ឯកសារ​អត្ថបទ​ធម្មតា ។"

#: settings/filetypes/filetypedetails.cpp:76
msgid "Add a new pattern for the selected file type."
msgstr "បន្ថែម​លំនាំ​ថ្មី​មួយ សម្រាប់​ប្រភេទ​ឯកសារ​ដែល​បាន​ជ្រើស ។"

#: settings/filetypes/filetypedetails.cpp:84
msgid "Remove the selected filename pattern."
msgstr "យក​លំនាំ​របស់​ឈ្មោះ​ឯកសារ​ដែល​បាន​ជ្រើស​ចេញ ។"

#  i18n: file iconview/konq_iconview.rc line 5
#: settings/filetypes/filetypedetails.cpp:86
#: settings/konqhtml/pluginopts.cpp:602
msgid "Description"
msgstr "ការពិពណ៌នា"

#: settings/filetypes/filetypedetails.cpp:97
msgid ""
"You can enter a short description for files of the selected file type (e.g. "
"'HTML Page'). This description will be used by applications like Konqueror "
"to display directory content."
msgstr ""
"អ្នក​អាច​បញ្ចូល​ការពិពណ៌នា​សង្ខេប ទៅឲ្យឯកសារ​របស់​ប្រភេទ​ឯកសារ​ដែល​បាន​ជ្រើស (ឧ. ទំព័រ 'HTML') ។ "
"ការ​ពិពណ៌នា​នេះ​នឹង​ត្រូវ​បាន​ប្រើ​ដោយ​កម្មវិធី​ដូចជា Konqueror ជាដើម ដើម្បី ​បង្ហាញ​មាតិការបស់​ថត ។"

#: settings/filetypes/filetypedetails.cpp:128
msgid "Ask whether to save to disk instead"
msgstr "សួរ​ថា​តើ​រក្សាទុក​ទៅ​ថាសជំនួស​វិញ​ឬ​អត់"

#: settings/filetypes/filetypedetails.cpp:143
msgid ""
"Here you can configure what the Konqueror file manager will do when you "
"click on a file of this type. Konqueror can display the file in an embedded "
"viewer or start up a separate application. If set to 'Use settings for G "
"group', Konqueror will behave according to the settings of the group G this "
"type belongs to, for instance 'image' if the current file type is image/png."
msgstr ""
"នៅ​ទីនេះ អ្នក​អាច​កំណត់​រចនាសម្ព័ន្ធអ្វី​ខ្លះ​ដែល​​កម្មវិធី​គ្រប់គ្រង​ឯកសារ Konqueror នឹង​ធ្វើ ពេល​អ្នក​ចុច​"
"ឯកសារ​របស់​ប្រភេទ​នេះ ។ Konqueror អាច​បង្ហាញ​ឯកសារ​ក្នុង​កម្មវិធី​មើល​ដែល​បាន​បង្កប់ ឬ​ចាប់ផ្ដើម​កម្មវិធី​"
"មួយ​ដាច់​ដោយ​ឡែក ។ បើ​កំណត់​ទៅ​ 'ប្រើ​ការ​កំណត់​សម្រាប់​ក្រុម G' នោះ Konqueror នឹង​អនុវត្ត​ទៅ​តាម​ការ​កំណត់​"
"របស់​ក្រុម G ដែល​ក្រុម​ប្រភេទ​នេះ​ជា​របស់ក្រុម G ផ្ទាល់​ឧទាហរណ៍ 'រូបភាព' បើ​ប្រភេទ​ឯកសារ​បច្ចុប្បន្ន​ជា "
"image/png ។"

