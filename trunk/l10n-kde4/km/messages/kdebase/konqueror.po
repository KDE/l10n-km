msgstr "ផ្លាស់ប្តូរ​ករណី​លើកលែង"

#: settings/kio/kmanualproxydlg.cpp:441
msgid "Invalid Entry"
msgstr "ធាតុបញ្ចូលមិន​ត្រឹមត្រូវ"

#: settings/kio/kmanualproxydlg.cpp:444
msgid "The address you have entered is not valid."
msgstr "អាសយដ្ឋាន​ដែល​អ្នក​បាន​បញ្ចូល គឺ​មិន​ត្រឹមត្រូវ​ទេ ។"

#: settings/kio/kmanualproxydlg.cpp:446
msgid ""
"<qt>Make sure none of the addresses or URLs you specified contain invalid or "
"wildcard characters such as spaces, asterisks (*), or question marks(?).<br /"
"><br /><u>Examples of VALID entries:</u><br /><code>http://mycompany.com, "
"192.168.10.1, mycompany.com, localhost, http://localhost</code><br /><br /"
"><u>Examples of INVALID entries:</u><br /><code>http://my company.com, http:/"
"mycompany,com file:/localhost</code></qt>"
msgstr ""
"<qt>សូម​ឲ្យ​ប្រាកដ​ថា​គ្មាន​អាសយដ្ឋាន ឬ URLs ណាមួយ​ដែល​អ្ន​ក​បាន​បញ្ជាក់មិន​ត្រឹមត្រូវ ឬ​មាន​តួអក្សរ​ជំនួស​"
"ឡើយ ដូចជា ដកឃ្លា សញ្ញា​ផ្កាយ  (*) ឬ​សញ្ញា​សួរ (?) ជាដើម​ ។<br /><br /><u>ឧទាហរណ៍ធាតុ​​ដែល​"
"ត្រឹមត្រូវ ៖</u><br /><code>http://mycompany.com, 192.168.10.1, mycompany.com, "
"localhost, http://localhost</code><br /><br /><u>ឧទាហរណ៍​ ធាតុ​មិន​ត្រឹមត្រូវ ៖</"
"u><br /><code>http://my company.com, http:/mycompany,com file:/localhost</"
"code></qt>"

#: settings/kio/kmanualproxydlg.cpp:467
msgid "Enter the URL or address that should use the above proxy settings:"
msgstr "បញ្ចូល URL ឬ​អាសយដ្ឋាន​ដែល​គួរ​ប្រើ​ការ​កំណត់​ប្រូកស៊ី​ខាងលើ ៖"

#: settings/kio/kmanualproxydlg.cpp:470
msgid ""
"Enter the address or URL that should be excluded from using the above proxy "
