msgstr "មិន​ប្រើ​អន្តរសកម្ម ៖ គ្មាន​ប្រអប់​សារ"

#: client/kfmclient.cpp:76
msgid "Show available commands"
msgstr "បង្ហាញ​ពាក្យ​បញ្ជា​ទាំងឡាយ​ណា​ដែល​អាច​ប្រើបាន​"

#: client/kfmclient.cpp:78
msgid "Command (see --commands)"
msgstr "ពាក្យ​បញ្ជា (មើល​ --ពាក្យ​បញ្ជា)"

#: client/kfmclient.cpp:80
msgid "Arguments for command"
msgstr "អាគុយម៉ង់​សម្រាប់​ពាក្យ​បញ្ជា"

#: client/kfmclient.cpp:90
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"វាក្យ​សម្ពន្ធ ៖\n"

#: client/kfmclient.cpp:91
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, $HOME is used instead.\n"
"\n"
msgstr ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # បើក​បង្អួច​បង្ហាញ​  'url' ។\n"
"            #  'url' អា​ចជាផ្លូវទាក់ទង​​\n"
"            #   ឬ​ឈ្មោះ​ឯកសារ​ ដូចជា  . ឬ subdir/\n"
"            #   បើ​ 'url' ត្រូវ​បាន​លុប $HOME ត្រូវ​បាន​ប្រើ​ជំនួស​វិញ​ម្តង ។\n"
"\n"

#: client/kfmclient.cpp:96
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it "
"to\n"
"            #   text/html for a web page, to make it appear faster\n"
"\n"
msgstr ""
"            # បើ​ 'mimetype' បាន​បញ្ជាក់ វា​នឹង​ត្រូវ​បាន​ប្រើ​សម្រាប់​កំណត់\n"
"            #   សមាសភាគ​ដែល​ Konqueror គួរ​តែ​ប្រើ ។ ឧទាហរណ៍ កំណត់​វា​ទៅ​\n"
"            #   text/html សម្រាប់​ទំព័រ​បណ្តាញ​ ដើម្បី​ធ្វើ​ឲ្យ​វា​បើក​បាន​លឿន\n"
"\n"

#: client/kfmclient.cpp:100
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing "
"Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient ផ្ទាំង​ថ្មី​ 'url' ['mimetype']\n"
"            # បង្ហាញ​ដូច​ខាង​លើ​ ប៉ុន្តែ​វា​បើក​ផ្ទាំង​ថ្មី​ជាមួយបង្អួច​ 'url' Konqueror\n"
" ដែល​មាន​ស្រាប់​            #   នៅ​លើ​ផ្ទៃ​តុ​សកម្ម​ បើ​អាច​ធ្វើ​បាន​ ។\n"
"\n"

#: client/kfmclient.cpp:104
msgid ""
"  kfmclient openProfile 'profile' ['url']\n"
"            # Opens a window using the given profile.\n"
"            #   'profile' is a file under ~/.kde/share/apps/konqueror/"
"profiles.\n"
"            #   'url' is an optional URL to open.\n"
"\n"
msgstr ""
"  kfmclient បើក​ទម្រង់​ 'profile' ['url']\n"
"            # បើក​បង្អួ​ច​ប្រើ​ទម្រង់​ដែល​បាន​ផ្តល់​ឲ្យ ។\n"
"            #   'profile' ជា​ឯកសារ​នៅ​ក្រោម​ទម្រង់ ~/.kde/share/apps/konqueror/ ។\n"
"            #   'url' ជា​ URL ដែល​អាច​ប្រើ​ស្រេច​ចិត្ត ។\n"
"\n"

