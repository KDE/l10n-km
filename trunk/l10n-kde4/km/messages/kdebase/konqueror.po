#: settings/filetypes/kservicelistwidget.cpp:66
msgid "Application Preference Order"
msgstr "លំដាប់​ចំណូល​ចិត្ត​កម្មវិធី​"

#: settings/filetypes/kservicelistwidget.cpp:67
msgid "Services Preference Order"
msgstr "លំដាប់​ចំណូល​ចិត្ត​សេវា​"

#: settings/filetypes/kservicelistwidget.cpp:89
msgid ""
"This is a list of applications associated with files of the selected file "
"type. This list is shown in Konqueror's context menus when you select \"Open "
"With...\". If more than one application is associated with this file type, "
"then the list is ordered by priority with the uppermost item taking "
"precedence over the others."
msgstr ""
"នេះ​ជា​បញ្ជី​របស់​កម្មវិធី​ដែល​បាន​ភ្ជាប់​ជាមួយ​នឹង​ឯកសារ នៃ​ប្រភេទ​ឯកសារ​ដែល​បាន​ជ្រើស ។ បញ្ជី​នេះ​ត្រូវ​បាន​"
"បង្ហាញ​ក្នុង​ម៉ឺនុយ​បរិបទ​របស់ Konqueror ពេល​អ្នក​ជ្រើស​ជម្រើស \"បើក​ជាមួយ...\" ។ បើ​មាន​កម្មវិធី​ច្រើន​"
"ជាង​មួយ​ត្រូវ​បាន​ភ្ជាប់​ជាមួយ​ប្រភេទ ​ឯកសារ​នេះ នោះ​បញ្ជី​ត្រូវ​បាន​តម្រៀប​តាម​អាទិភាព ដោយ​ដាក់​ធាតុដែល​​នៅ​លើ​"
"គេបំផុត មាន​អាទិភាព​ជាង​ធាតុ​ផ្សេង​ទៀត ។"

#: settings/filetypes/kservicelistwidget.cpp:94
msgid ""
"This is a list of services associated with files of the selected file type. "
"This list is shown in Konqueror's context menus when you select a \"Preview "
"with...\" option. If more than one application is associated with this file "
"type, then the list is ordered by priority with the uppermost item taking "
"precedence over the others."
msgstr ""
"នេះ​ជា​បញ្ជី​របស់​កម្មវិធី​ដែល​បាន​ភ្ជាប់​ជាមួយ​នឹង​ឯកសារ នៃ​ប្រភេទ​ឯកសារ​ដែល​បាន​ជ្រើស ។ បញ្ជី​នេះ​ត្រូវ​បាន​"
"បង្ហាញ​ក្នុង​ម៉ឺនុយ​បរិបទ​របស់ Konqueror ពេល​អ្នក​ជ្រើស​ជម្រើស \"បើក​ជាមួយ...\" ។ បើ​មាន​កម្មវិធី​ច្រើន​"
"ជាង​មួយ​ត្រូវ​បាន​ភ្ជាប់​ជាមួយ​ប្រភេទ ​ឯកសារ​នេះ នោះ​បញ្ជី​ត្រូវ​បាន​តម្រៀប​តាម​អាទិភាព ដោយ​ដាក់​ធាតុដែល​​នៅ​លើ​"
"គេបំផុត មាន​អាទិភាព​ជាង​ធាតុ​ផ្សេង​ទៀត ។"

#: settings/filetypes/kservicelistwidget.cpp:103
msgid "Move &Up"
msgstr "​ផ្លាស់ទី​ឡើង​លើ"

#: settings/filetypes/kservicelistwidget.cpp:109
msgid ""
"Assigns a higher priority to the selected\n"
"application, moving it up in the list. Note:  This\n"
"only affects the selected application if the file type is\n"
"associated with more than one application."
msgstr ""
"ផ្តល់​តម្លៃ​អាទិភាព​ខ្ពស់​ជាង​ទៅ​ឲ្យ​កម្មវិធី​ដែល​បាន​ជ្រើស​\n"
"ដោយ​ផ្លាស់ទី​វា​ឡើង​លើ​ក្នុង​បញ្ជី ។ ចំណាំ ៖ អំពើ​នេះ \n"
"មាន​ឥទ្ធិពល​ចំពោះ​តែកម្មវិធី​ដែល​បាន​ជ្រើស តែ​ក្នុង​ករណី​ប្រភេទ​ឯកសារ\n"
"ត្រូវ​បាន​ភ្ជាប់​ជាមួយ​កម្មវិធី​ច្រើន​ជាង​មួយតែ​ប៉ុណ្ណោះ ។"

#: settings/filetypes/kservicelistwidget.cpp:113
msgid ""
"Assigns a higher priority to the selected\n"
"service, moving it up in the list."
msgstr ""
"ផ្ដល់តម្លៃអាទិភាព​ខ្ពស់​ជាង​ទៅ​សេវា​ដែល​បាន​ជ្រើស\n"
"ដោយ​ផ្លាស់ទី​វា​ឡើង​លើ​ក្នុង​បញ្ជី ។"

#: settings/filetypes/kservicelistwidget.cpp:116
msgid "Move &Down"
msgstr "ផ្លាស់ទី​ចុះ​ក្រោម"

#: settings/filetypes/kservicelistwidget.cpp:122
msgid ""
"Assigns a lower priority to the selected\n"
"application, moving it down in the list. Note: This \n"
"only affects the selected application if the file type is\n"
"associated with more than one application."
msgstr ""
"ផ្ដល់តម្លៃ​អាទិភាព​ទាប​ជាង​ទៅ​កម្មវិធី​ដែល​បាន​ជ្រើស\n"
"ដោយ​ផ្លាស់ទី​វា​ចុះក្រោម​ក្នុង​បញ្ជី ។ ចំណាំ ៖ អំពើ​នេះ \n"
"មាន​ឥទ្ធិពល​ចំពោះ​តែ​កម្មវិធី​ដែល​បាន​ជ្រើស តែ​ក្នុង​ករណី​ប្រភេទ​ឯកសារ\n"
"ត្រូវ​បាន​ភ្ជាប់​ជាមួយ​កម្មវិធី​ច្រើន​ជាង​មួយតែ​ប៉ុណ្ណោះ ។"

#: settings/filetypes/kservicelistwidget.cpp:126
msgid ""
"Assigns a lower priority to the selected\n"
"service, moving it down in the list."
msgstr ""
"ផ្ដល់តម្លៃ​អាទិភាព​ទាប​ជាង​ទៅ​សេវា​ដែលបាន​ជ្រើស\n"
"ដោយ​ផ្លាស់ទី​វា​ចុះក្រោម​ក្នុង​បញ្ជី ។"

#: settings/filetypes/kservicelistwidget.cpp:134
msgid "Add a new application for this file type."
msgstr "បន្ថែម​កម្មវិធី​ថ្មី​មួយ ទៅ​ឲ្យ​ប្រភេទ​ឯកសារ​នេះ ។"

#: settings/filetypes/kservicelistwidget.cpp:137
msgid "Edit..."
msgstr "កែសម្រួល..."

#: settings/filetypes/kservicelistwidget.cpp:142
msgid "Edit command line of the selected application."
msgstr "កែសម្រួល​បន្ទាត់​បញ្ជា​របស់​កម្មវិធី​ដែល​បាន​ជ្រើស ។"

#: settings/filetypes/kservicelistwidget.cpp:150
msgid "Remove the selected application from the list."
msgstr "យក​កម្មវិធី​ដែល​បាន​ជ្រើស​ចេញ​ពី​បញ្ជី ។ ។"

#: settings/filetypes/kservicelistwidget.cpp:177
#: settings/filetypes/kservicelistwidget.cpp:269
msgid "None"
msgstr "គ្មាន"

#: settings/filetypes/kservicelistwidget.cpp:366
msgid "You are not authorized to remove this service."
msgstr "អ្នក​គ្មានសិទ្ធិ ក្នុង​ការ​យក​សេវា​នេះ​ចេញ​ឡើយ ។"

#: settings/filetypes/kservicelistwidget.cpp:371
#, kde-format
msgid "The service <b>%1</b> can not be removed."
msgstr "មិន​អាច​យក​សេវា <b>%1</b> ចេញ​បាន​ឡើយ ។"

#: settings/filetypes/kservicelistwidget.cpp:373
#, kde-format
msgid ""
"The service is listed here because it has been associated with the <b>%1</b> "
"(%2) file type and files of type <b>%3</b> (%4) are per definition also of "
"type <b>%5</b>."
msgstr ""
"សេវា​ត្រូវ​បាន​រាយ​នៅ​ទីនេះ ពីព្រោះ​វា​បាន​ភ្ជាប់​ជាមួយនឹង​ប្រភេទ​ឯកសារ <b>%1</b> (%2) ហើយ​"
"ឯកសារប្រភេទ <b>%3</b> (%4) ក៏​ជា​និយមន័យ​មួយ​ផងដែរ​របស់​ប្រភេទ <b>%5</b>។"

#: settings/filetypes/kservicelistwidget.cpp:379
#, kde-format
msgid ""
"Either select the <b>%1</b> file type to remove the service from there or "
"move the service down to deprecate it."
msgstr ""
"ជ្រើស​ប្រភេទ​ឯកសារ <b>%1</b> ដើម្បី​យក​សេវា​ចេញ​ពី​ទីនោះ ឬក៏ ផ្លាស់ទី​សេវា​ចុះក្រោម ដើម្បី​បន្ទាប​វា ។"

#: settings/konqhtml/pluginopts.cpp:69 settings/konqhtml/jsopts.cpp:51
#: settings/konqhtml/javaopts.cpp:72
msgid "Global Settings"
msgstr "ការ​កំណត់​សកល"

#: settings/konqhtml/pluginopts.cpp:71
msgid "&Enable plugins globally"
msgstr "អនុញ្ញាត​កម្មវិធី​ជំនួយជា​សកល"

