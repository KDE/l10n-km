#: client/kfmclient.cpp:56
msgid "KDE tool for opening URLs from the command line"
msgstr "ឧបករណ៍ KDE សម្រាប់​បើក​ URLs តាម​បន្ទាត់​ពាក្យ​បញ្ជា"

