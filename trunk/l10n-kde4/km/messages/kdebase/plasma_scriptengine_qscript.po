#: javascriptdataengine.cpp:93
msgid "setData() takes at least two arguments"
msgstr "setData() យក​អាគុយម៉ង់​យ៉ាង​ហោចណាស់​ពីរ"

#: javascriptdataengine.cpp:124
msgid "Could not extract the DataEngineObject"
msgstr "មិនអាច​ស្រង់ចេញ DataEngineObject បានទេ"

#: javascriptdataengine.cpp:128
msgid "Could not extract the DataEngine"
msgstr "មិន​ស្រង់ចេញ​ម៉ាស៊ីន​ទិន្នន័យ​​​​បានទេ"

#: javascriptdataengine.cpp:138
msgid "removeAllData() takes at least one argument (the source name)"
msgstr "removeAllData() ត្រូវ​ការ​អាគុយម៉ង់​យ៉ាង​ហោចណាស់​មួយ (ឈ្មោះ​ប្រភព)"

#: javascriptdataengine.cpp:156
msgid "removeData() takes at least two arguments (the source and key names)"
msgstr "removeData() ត្រូវ​ការ​អាគុយម៉ង់​យ៉ាង​ហោចណាស់​ពីរ (ឈ្មោះ​ប្រភព និង​សោ)"

#: simplejavascriptapplet.cpp:127
#, kde-format
msgid ""
"Script failure on line %1:\n"
"%2"
msgstr ""
"ស្គ្រីប​បរាជ័យ​នៅ​លើបន្ទាត់ %1 ៖\n"
"%2"

#: simplejavascriptapplet.cpp:276
#, kde-format
msgid "Unable to load script file: %1"
msgstr "មិនអាច​ផ្ទុក​ឯកសារ​ស្គ្រីប​ ៖ %1"

#: simplejavascriptapplet.cpp:463
#, kde-format
msgid "Authorization for required extension '%1' was denied."
msgstr "កា​រអនុញ្ញាត​សម្រាប់​ផ្នែកបន្ថែម​ដែល​ទាមទារ '%1' ត្រូវ​បានបដិសេធ ។"

#: simplejavascriptapplet.cpp:600
msgid "dataEngine() takes one argument"
msgstr "dataEngine() ត្រូវការ​អាគុយម៉ង់​មួយ"

#: simplejavascriptapplet.cpp:605 simplejavascriptapplet.cpp:623
msgid "Could not extract the Applet"
msgstr "មិន​ស្រង់ចេញអាប់ភ្លេត​បានទេ"

#: simplejavascriptapplet.cpp:616
msgid "service() takes two arguments"
msgstr "service() ត្រូវការ​អាគុយម៉ង់​ពីរ"

#: simplejavascriptapplet.cpp:636
msgid "animation() takes one argument"
msgstr "animation() យក​អាគុយម៉ង​មួយ"

#: simplejavascriptapplet.cpp:643 simplejavascriptapplet.cpp:662
#, kde-format
msgid "%1 is not a known animation type"
msgstr "%1 មិនមែនជា​ប្រភេទ​ចលនា​ដែល​បានស្គាល់​ទេ"

#: simplejavascriptapplet.cpp:682
msgid "loadui() takes one argument"
msgstr "loadui() ត្រូវ​ការ​អាគុយម៉ង់​មួយ"

#: simplejavascriptapplet.cpp:688
#, kde-format
msgid "Unable to open '%1'"
msgstr "មិនអាច​បើក '%1'"

#: simplejavascriptapplet.cpp:730 simplejavascriptapplet.cpp:744
msgid "Constructor takes at least 1 argument"
msgstr "កម្មវិធី​ស្ថាបនា​យក​អាគុយម៉ង់យ៉ាង​ហោចណាស់ ១"

#: simplejavascriptapplet.cpp:838
#, kde-format
msgid "This operation was not supported, %1"
msgstr "ប្រតិបត្តិការ​នេះ​មិន​ត្រូវ​បានគាំទ្រ %1"

#: simplejavascriptapplet.cpp:845
msgid "print() takes one argument"
msgstr "print() ត្រូវការ​អាគុយម៉ង់​មួយ"

#: simplebindings/anchorlayout.cpp:75 simplebindings/gridlayout.cpp:104
#: simplebindings/linearlayout.cpp:74
msgid "The parent must be a QGraphicsLayoutItem"
msgstr "មេ​ត្រូវតែ​ជា QGraphicsLayoutItem"
