#: main.cpp:50
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"កម្មវិធី​គ្រប់គ្រង​សម័យ KDE គួរ​ឲ្យ​ទុកចិត្ត ដែលប្រើ X11R6 \n"
"session management protocol (XSMP) ខ្នាត​គំរូ ។"

#: main.cpp:197
msgid "The KDE Session Manager"
msgstr "កម្មវិធី​គ្រប់គ្រង​សម័យ KDE"

#: main.cpp:199
msgid "(C) 2000, The KDE Developers"
msgstr "រក្សា​សិទ្ធិ​ឆ្នាំ ២០០០ ដោយ​អ្នក​អភិវឌ្ឍន៍ KDE"

#: main.cpp:200
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:201
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:201
msgid "Maintainer"
msgstr "អ្នក​ថែទាំ"

#: main.cpp:207
msgid "Restores the saved user session if available"
msgstr "ស្ដារ​សម័យ​របស់​អ្នក​ប្រើ​ដែល​បាន​រក្សា​ទុក ប្រសិន​បើ​មាន"

#: main.cpp:209
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"ចាប់ផ្ដើម 'wm' ក្នុង​ករណី​ដែល​គ្មាន​កម្មវិធី​គ្រប់គ្រង​បង្អួច​ផ្សេង​ទៀត​កំពុង \n"
"ចូលរួម​ក្នុង​សម័យ ។ លំនាំ​ដើម​គឺ 'kwin'"

#: main.cpp:210
msgid "Also allow remote connections"
msgstr "អនុញ្ញាត​ឲ្យ​មាន​ការ​តភ្ជាប់​ពី​ចម្ងាយ​ផង​ដែរ"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ប៉ុច សុគន្ធ, អេង វណ្ណៈ, អោក ពិសិដ្ឋ"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ""
"khoemsokhem@khmeros.info,sokun_poch@khmeros.info,evannak@khmeros.info,"
"piseth_dv@khmeros.info"

#: shutdown.cpp:354
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "ការ​ចេញ​ត្រូវ​បាន​បោះបង់​ដោយ '%1'"

#: shutdowndlg.cpp:326
#, kde-format
msgid "End Session for %1"
msgstr "បញ្ចប់​សម័យ​របស់ %1"

#: shutdowndlg.cpp:328
#, kde-format
msgid "End Session for %1 (%2)"
msgstr "បញ្ចប់​សម័យ​របស់ %1 (%2)"

#: shutdowndlg.cpp:345
msgid "Logout"
msgstr "ចេញ​"

#: shutdowndlg.cpp:353
msgid "Turn Off Computer"
msgstr "បិទ​កុំព្យូទ័រ"

#: shutdowndlg.cpp:365
msgid "Standby"
msgstr "រង់ចាំ​"

#: shutdowndlg.cpp:367
msgid "Suspend to RAM"
msgstr "ផ្អាក​ទៅ RAM"

#: shutdowndlg.cpp:369
msgid "Suspend to Disk"
msgstr "ផ្អាក​ទៅ​ឌីស"

#: shutdowndlg.cpp:372
msgid "Restart Computer"
msgstr "ចាប់ផ្ដើម​កុំព្យូទ័រ​ឡើង​វិញ"

#: shutdowndlg.cpp:394
msgctxt "current option in boot loader"
msgid " (current)"
msgstr " (បច្ចុប្បន្ន)"

#: shutdowndlg.cpp:403
msgid "Cancel"
msgstr "បោះបង់​"
