#: kwriteconfig.cpp:21
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:23
msgid "Write KConfig entries - for use in shell scripts"
msgstr "សរសេរធាតុ​បញ្ចូល KConfig - សម្រាប់​ប្រើ​ក្នុង​ស្គ្រីប​សែល"

#: kwriteconfig.cpp:25
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c)រក្សា​សិទ្ធ​ឆ្នាំ ២០០១ ដោយ Red Hat, Inc. & Luís Pedro Coelho"

#: kwriteconfig.cpp:26
msgid "Luís Pedro Coelho"
msgstr "Luís Pedro Coelho"

#: kwriteconfig.cpp:27
msgid "Bernhard Rosenkraenzer"
msgstr "Bernhard Rosenkraenzer"

#: kwriteconfig.cpp:27
msgid "Wrote kreadconfig on which this is based"
msgstr "បាន​សរសេរ kreadconfig នៅ​លើ​មូល​ដ្ឋាន​នេះ"

#: kwriteconfig.cpp:31
msgid "Use <file> instead of global config"
msgstr "ប្រើ <file> ជំនួស​ឲ្យ​ការ​កំណត់​ជា​សកល"

#: kwriteconfig.cpp:32
msgid "Group to look in"
msgstr "ក្រុម​ដែល​ត្រូវ​រក​មើល​ក្នុង"

#: kwriteconfig.cpp:33
msgid "Key to look for"
msgstr "ពាក្យ​គន្លឹះ​ដែល​ត្រូវស្វែងរក"

#: kwriteconfig.cpp:34
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr "ប្រភេទ​អថេរ ។ ប្រើ \"bool\" សម្រាប់​ប៊ូលីន បើ​ពុំ​នោះ​សោត វា​ត្រូវ​បាន​ចាត់​ទុក​ជា​ខ្សែ​អក្សរ ។"

#: kwriteconfig.cpp:35
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "តម្លៃ​ដែល​ត្រូវ​សរសេរ ។ ដែល​ចាំបាច់ ការប្រើ​នៅ​លើ​សែល​មួយ '' គឺ​ទទេ"

