#: khtmlkttsd.cpp:51
msgid "&Speak Text"
msgstr "និយាយ​អត្ថបទ "

#: khtmlkttsd.cpp:66
msgid "Cannot Read source"
msgstr "មិន​អាច​អាន​ប្រភព"

#: khtmlkttsd.cpp:67
msgid ""
"You cannot read anything except web pages with\n"
"this plugin, sorry."
msgstr ""
"សូមទោស អ្នកមិន​អាច​អាន​អ្វី​ទាំង​អស់ជាមួយ​នឹង​កម្មវិធី​ជំនួយ​នេះ\n"
"លើកលែង​តែ​ទំព័រ​បណ្ដាញ ។"

#: khtmlkttsd.cpp:75
msgid "Starting KTTSD Failed"
msgstr "ការ​ចាប់​ផ្ដើម KTTSD បាន​បរាជ័យ"

#: khtmlkttsd.cpp:85 khtmlkttsd.cpp:121 khtmlkttsd.cpp:125
msgid "D-Bus Call Failed"
msgstr "ការ​ហៅ DCOP បាន​បរាជ័យ"

#: khtmlkttsd.cpp:86
msgid "The D-Bus call supportsMarkup failed."
msgstr "ការ​ហៅ DCOP supportsMarkup បាន​បរាជ័យ ។"

#: khtmlkttsd.cpp:122
msgid "The D-Bus call setText failed."
msgstr "ការ​ហៅ DCOP setText បាន​បរាជ័យ ។"

#: khtmlkttsd.cpp:126
msgid "The D-Bus call startText failed."
msgstr "ការ​ហៅ DCOP startText បាន​បរាជ័យ ។"

