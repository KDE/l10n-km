#: reportassistantpages_bugzilla.cpp:829
msgctxt "@info"
msgid "The title does not provide enough information."
msgstr "ចំណង​ជើង​មិន​ផ្ដល់​នូវ​ព័ត៌មាន​គ្រប់គ្រាន់​ទេ ។"

#: reportassistantpages_bugzilla.cpp:831
msgctxt "@info"
msgid ""
"The description about the crash details does not provide enough information."
msgstr "សេចក្ដីពិពណ៌​នា​អំពី​សេចក្ដី​លម្អិត​នៃ​ការគាំង ដែល​មិន​ផ្ដល់​នូវ​ព័ត៌មាន​គ្រប់គ្រាន់ ។"

#: reportassistantpages_bugzilla.cpp:834
msgctxt "@info"
msgid ""
"Both the title and the description about the crash details do not provide "
"enough information."
msgstr "ទាំង​ចំណង​ជើង និង​សេចក្ដី​ពិពណ៌នា​អំពី​សេចក្ដីលម្អិត​នៃ​ការ​គាំង​មិន​ផ្ដល់​នូវ​ព័ត៌មាន​គ្រប់គ្រាន់​ទេ ។"

#: reportassistantpages_bugzilla.cpp:838
msgctxt "@info"
msgid "Can you tell us more?"
msgstr "តើ​អ្នក​អាច​ប្រាប់យើង​បន្ថែម​ទៀត​បានទេ ?"

#: reportassistantpages_bugzilla.cpp:842
msgctxt "@title:window"
msgid "We need more information"
msgstr "យើង​ត្រូវ​ការ​ព័ត៌មាន​បន្ថែម​ទៀត"

#: reportassistantpages_bugzilla.cpp:895
msgctxt "@info question"
msgid "Are you ready to submit this report?"
msgstr "តើ​អ្នក​រួចរាល់​ដើម្បី​ដាក់ស្នើ​របាយការណ៍​នេះ​ហើយ​ឬនៅ ?"

#: reportassistantpages_bugzilla.cpp:896
msgctxt "@title:window"
msgid "Are you sure?"
msgstr "តើ​អ្នក​ប្រាកដទេ ?"

#: reportassistantpages_bugzilla.cpp:913
msgctxt "@action:button"
msgid "Retry..."
msgstr "ព្យាយាម​ម្ដង​ទៀត..."

#: reportassistantpages_bugzilla.cpp:915
msgctxt "@info:tooltip"
msgid "Use this button to retry sending the crash report if it failed before."
msgstr "ប្រើ​ប៊ូតុង​នេះ ដើម្បី​ព្យាយាម​ផ្ញើ​របាយការណ៍​គាំង​នេះ​ម្ដង​ទៀត ប្រសិនបើ​វា​បរាជ័យ​ពីមុន ។"

#: reportassistantpages_bugzilla.cpp:942
msgctxt "@info:status"
msgid "Sending crash report... (please wait)"
msgstr "ផ្ញើ​របាយការណ៍​គាំង... (សូម​រង់ចាំ)"

#: reportassistantpages_bugzilla.cpp:959
#, fuzzy, kde-format
