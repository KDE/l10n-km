msgid ""
"Crash report sent.<nl/>URL: <link>%1</link><nl/>Thanks for contributing to "
"KDE. You can now close this window."
msgstr ""
"របាយការណ៍​គាំង​បានផ្ញើ​ហើយ ។<nl/>លេខ​កំហុស :: <numid>%1</numid><nl/>URL :: <link>%2</"
"link><nl/>សូមអរគុណ​ចំពោះ​ការ​ចូលរួម​ក្នុង KDE ។ ឥឡូវ​អ្នក​អាច​បិទ​បង្អួច​នេះ​បាន ។"

#: reportassistantpages_bugzilla.cpp:969
#, kde-format
msgctxt "@info:status"
msgid "Error sending the crash report:  <message>%1.</message>"
msgstr "កំហុស​ក្នុងកា​រផ្ញើ​របាយការណ៍គាំង ៖  <message>%1 ។</message>"

#: reportinfo.cpp:142
msgctxt "@info/plain"
msgid ""
"<placeholder>In detail, tell us what you were doing  when the application "
"crashed.</placeholder>"
msgstr ""
"<placeholder>ជា​សេចក្ដី​លម្អិត ប្រាប់​យើង​នូវ​អ្វី​ដែល​អ្នក​កំពុង​ធ្វើ នៅពេល​កម្មវិធី​បានគាំង ។</"
"placeholder>"

