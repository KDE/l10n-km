msgstr "តើ​អ្នក​ពិត​ជា​ចង់​បិទ​អ្នកជំនួយការ​កំហុស​​ ដោយ​មិន​ដាក់​ស្នើ​​របាយការណ៍​នេះ​ឬ ?"

#: reportassistantdialog.cpp:301
msgctxt "@title:window"
msgid "Close Crash Reporting Assistant"
msgstr "បិទ​អ្នក​ជំនួយការ​រាយការណ៍​កំហុស"

#: reportassistantpages_base.cpp:84
msgctxt "@info"
msgid ""
"This crash information is not useful enough, do you want to try to improve "
"it? You will need to install some debugging packages."
msgstr "ព័ត៌មានគាំង​មិន​មានប្រយោជន៍​គ្រប់គ្រាន់ទេ តើ​អ្នក​ចង់​ព្យាយាម​បង្កើន​វា​ដែរឬទេ ? "

#: reportassistantpages_base.cpp:87
msgctxt "@title:window"
msgid "Crash Information is not useful enough"
msgstr "ព័ត៌មានគាំង​មិនមាន​ប្រយោជន៍​គ្រប់គ្រាន់​ទេ"

#: reportassistantpages_base.cpp:140 reportassistantpages_bugzilla.cpp:919
msgctxt "@action:button"
msgid "Sho&w Contents of the Report"
msgstr "បង្ហាញ​មាតិកា​របស់​របាយការណ៍"

#: reportassistantpages_base.cpp:142 reportassistantpages_bugzilla.cpp:921
msgctxt "@info:tooltip"
msgid ""
"Use this button to show the generated report information about this crash."
msgstr "ប្រើ​ប៊ូតុង​នេះ ដើម្បី​បង្ហាញ​ព័ត៌មាន​របាយការណ៍​ដែល​បានបង្កើត​អំពី​ការ​គាំង​នេះ ។"

#: reportassistantpages_base.cpp:172 reportassistantpages_base.cpp:343
#: reportassistantpages_bugzilla.cpp:991
#, kde-format
msgctxt "@info/plain"
msgid "Report to %1"
msgstr "រាយការណ៍​ទៅ %1"

#: reportassistantpages_base.cpp:203
msgctxt "@info"
msgid "The automatically generated crash information is useful."
msgstr "ព័ត៌មាន​ការ​គាំង​ដែលបាន​បង្កើត​ដោយ​ស្វ័យ​ប្រវត្តិ​មាន​ប្រយោជន៍​ណាស់ ។ "

#: reportassistantpages_base.cpp:208
msgctxt "@info"
msgid ""
"The automatically generated crash information lacks some details but may be "
"still be useful."
msgstr ""
"ព័ត៌មាន​គាំង​ដែលបាន​បង្កើត​ដោយ​ស្វ័យ​ប្រវត្តិ ខ្វះ​សេចក្ដីលម្អិត​មួយ​ចំនួន ប៉ុន្តែ​នៅតែ​អាច​មាន​ប្រយោជន៍ ។"

#: reportassistantpages_base.cpp:215
msgctxt "@info"
msgid ""
"The automatically generated crash information lacks important details and it "
"is probably not helpful."
msgstr ""
"ព័ត៌មានគាំង​ដែលបានបង្កើត​ដោយ​ស្វ័យប្រវត្តិ​ ខ្វះ​សេចក្ដីលម្អិត​សំខាន់ ហើយ​​វា​ប្រហែលជា​មិនមានប្រយោជន៍​ទេ ។ "

#: reportassistantpages_base.cpp:224
#, fuzzy
#| msgctxt "@info:status"
#| msgid "The crash information could not be generated."
msgctxt "@info"
msgid "The crash information was not generated because it was not needed."
msgstr "ព័ត៌មានគាំង​មិនអាច​ត្រូវ​បានបង្កើត​ទេ ។"

#: reportassistantpages_base.cpp:228
msgctxt "@info"
msgid ""
"The automatically generated crash information does not contain enough "
"information to be helpful."
msgstr "ព័ត៌មាន​គាំង​ដែល​បានបង្កើត​ដោយ​ស្វ័យ​ប្រវត្តិ​មិនមាន​ប្រយោជន៍​គ្រប់គ្រាន់​ទេ ។ "

#: reportassistantpages_base.cpp:231
msgctxt "@info"
msgid ""
"<note>You can improve it by installing debugging packages and reloading the "
"crash on the Crash Information page. You can get help with the Bug Reporting "
"Guide by clicking on the <interface>Help</interface> button.</note>"
msgstr ""
"<note>អ្នក​អាច​បង្កើន​វា ដោយ​ដំឡើង​កញ្ចប់​បំបាត់​កំហុស ហើយ​ផ្ទុក​ការ​គាំង​ឡើងវិញ​នៅ​លើ​ទំព័រ​ព័ត៌មាន​គាំង ។ អ្នក​"
"អាច​ទទួល​ជំនួយ​​ពី​មគ្គុទ្ទេសក៏​រាយការណ៍​កំហុស​ ដោយ​ចុច​ប៊ូតុង <interface>ជំនួយ</interface> ។</note>"

#: reportassistantpages_base.cpp:246
msgctxt "@info"
msgid ""
"You can provide crash details, and the developers can contact you if "
"required."
msgstr "អ្នក​អាច​ផ្ដល់​សេចក្ដីលម្អិតនៃ​ការ​គាំង ហើយ​អ្នក​អភិវឌ្ឍន៍​អាច​ទាក់ទង​អ្នក ប្រសិន​បើ​ចាំបាច់ ។"

#: reportassistantpages_base.cpp:250
msgctxt "@info"
msgid ""
"You can provide crash details, but do not want developers to contact you for "
"more information if required."
msgstr ""
"អ្នក​អាច​ផ្ដល់​សេចក្ដីលម្អិត​នៃ​ការគាំង ប៉ុន្តែ​មិនចង់​ឲ្យ​អ្នកអភិវឌ្ឍន៍​ទាក់ទង​ចំពោះ​ព័ត៌មាន​បន្ថែម​ ប្រសិនបើ​"
"ចាំបាច់ ។"

#: reportassistantpages_base.cpp:256
msgctxt "@info"
msgid ""
"You are not sure what you were doing when the application crashed, but the "
"developers can contact you for more information if required."
msgstr ""
"អ្នក​មិន​ប្រាកដ​នូវ​អ្វី​ដែល​អ្នកកំពុង​ធ្វើ នៅពេល​កម្មវិធី​គាំង ប៉ុន្តែ​អ្នកអភិវឌ្ឍន៍​អាចទាក់ទងអ្នក​រក​ព័ត៌មាន​បន្ថែម​"
"ប្រសិនបើចាំបាច់ ។"

#: reportassistantpages_base.cpp:260
msgctxt "@info"
msgid ""
"You are not sure what you were doing when the application crashed, and do "
"not want the developers to contact you for more information if required."
msgstr ""
"អ្នក​មិន​ប្រាកដ​នូវ​អ្វី​ដែល​អ្នកកំពុង​ធ្វើ នៅពេល​កម្មវិធី​គាំង ប៉ុន្តែ​អ្នកអភិវឌ្ឍន៍​មិន​ចង់​ទាទាក់​ទងអ្នក​រក​ព័ត៌មាន​"
"បន្ថែម​ប្រសិន​ត្រូវការច់ ។"

#: reportassistantpages_base.cpp:271
msgctxt "@info"
msgid "This report is considered helpful."
msgstr "របាយការណ៍​នេះ​គិត​ថា​មាន​ប្រយោជន៍ ។"

#: reportassistantpages_base.cpp:276
#, kde-format
msgctxt "@info"
msgid ""
"This application's bugs are reported to the KDE bug tracking system: click "
"<interface>Next</interface> to start the reporting process. You can manually "
"report at <link>%1</link>"
msgstr ""
"កំហុស​របស់​កម្មវិធី​នេះ ត្រូវ​បានរាយការណ៍​ទៅ​ប្រព័ន្ធ​តាមដាន​កំហុស​របស់ KDE  ៖ ចុច​<interface>បន្ទាប់</"
"interface> ដើម្បី​ចាប់ផ្ដើម​​ដំណើរការ​រាយការណ៍ ។ អ្នក​អាច​រារការណ៍​ដោយ​ដៃ​នៅ <link>%1</link>"

#: reportassistantpages_base.cpp:287
#, kde-format
msgctxt "@info"
msgid ""
"This application is not supported in the KDE bug tracking system. Click "
"<interface>Finish</interface> to report this bug to the application "
"maintainer. Also, you can manually report at <link>%1</link>."
msgstr ""
"កម្មវិធី​នេះ​មិន​ត្រូវ​បាន​គាំទ្រ​នៅ​ក្នុង​ប្រព័ន្ធ​តាមដាន​កំហុស​របស់ KDE ទេ ។ ចុច<interface>បញ្ចប់</"
"interface> ដើម្បី​រាយការណ៍​កំហុស​នេះ​ទៅ​អ្នក​ថែទាំ​កម្មវិធី ។ អ្នក​ក៏​អាច​រាយការណ៍​ដោយ​បាន​ផងដែរ​នៅ "
"<link>%1</link> ។"

#: reportassistantpages_base.cpp:303
msgctxt "@info"
msgid ""
"This report does not contain enough information for the developers, so the "
"automated bug reporting process is not enabled for this crash."
msgstr ""
"របាយការណ៍​នេះ​មិនមាន​ព័ត៌មាន​គ្រប់គ្រាន់​សម្រាប់​អ្នក​អភិវឌ្ឍន៍ទេ ដូច្នេះ​ដំណើរការ​ថាយការណ៍​កំហុស​ដោយ​ស្វ័យ​"
"ប្រវត្តិ​មិន​ត្រូវ​បាន​បើក​សម្រាប់​ការ​គាំង​នេះ​ទេ ។"

#: reportassistantpages_base.cpp:306
msgctxt "@info"
msgid "If you wish, you can go back and change your answers. "
msgstr "ប្រសិនបើ​អ្នកចង់ អ្នក​អាច​ត្រឡប់​ក្រោយ ហើយ​ផ្លាស់ប្ដូរ​ចម្លើយ​របស់​អ្នក ។ "

#: reportassistantpages_base.cpp:310
#, kde-format
msgctxt "@info"
msgid ""
"This application is supported in the KDE bug tracking system. You can "
"manually report this bug at <link>%1</link>. Click <interface>Finish</"
"interface> to close the assistant."
msgstr ""
"កម្មវិធី​ត្រូវ​បានគាំទ្រ​នៅ​ក្នុង​ប្រព័ន្ធ​តាមដាន​កំហុស​របស់ KDE ។ អ្នក​អាច​រាយការណ៍​កំហុស​នេះ​ដោយ​ដៃ​នៅ <link>"
"%1</link> ។ ចុច <interface>បញ្ចប់</interface> ដើម្បី​បិទ​អ្នក​ជំនួយការ ។"

#: reportassistantpages_base.cpp:317
#, kde-format
msgctxt "@info"
msgid ""
"This application is not supported in the KDE bug tracking system. You can "
"manually report this bug to its maintainer at <link>%1</link>. Click "
"<interface>Finish</interface> to close the assistant."
msgstr ""
"កម្មវិធី​នេះ​មិន​ត្រូវ​បានគាំទ្រ​នៅ​ក្នុង​ប្រព័ន្ធ​តាមដាន​កំហុស​របស់ KDE ទេ ។ អ្នក​អាចរាយការណ៍​កំហុស​នេះ​ដោយ​ដៃ​"
"ទៅ​កាន់​អ្នក​ថែទាំ​របស់​វា​នៅ <link>%1</link> ។ ចុច<interface>បញ្ចប់</interface> ដើម្បី​បិទ​អ្នក​"
"ជំនួយការ ។"

#: reportassistantpages_base.cpp:369
msgctxt "@title:window"
msgid "Contents of the Report"
msgstr "មាតិកា​របស់​របាយការណ៍"

