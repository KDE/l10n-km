#: reportassistantdialog.cpp:115
msgctxt "@title"
msgid "Details of the Bug Report"
msgstr "សេចក្ដី​លម្អិត​របស់​របាយការណ៍​កំហុស"

#: reportassistantdialog.cpp:124
msgctxt "@title"
