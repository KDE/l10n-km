#: kcm/nepomukserverkcm.cpp:144
#, fuzzy
#| msgid ""
#| "The Nepomuk Server KDED module is not running. The settings have been "
#| "saved and will be used the next time the server is started."
msgid ""
"The Nepomuk Server is not running. The settings have been saved and will be "
"used the next time the server is started."
msgstr ""
"ម៉ូឌុល KDED របស់​ម៉ាស៊ីន​បម្រើ Nepomuk មិនកំពុង​រត់ទេ ។ ការ​កំណត់​ត្រូវបាន​រក្សាទុក និង​ប្រើ​នៅពេល​ដែល​ម៉ាស៊ីន​"
"បម្រើ​ចាប់ផ្ដើម​លើក្រោយ ។"

