#: lock/autologout.cc:44
msgid "<qt><nobr><b>Automatic Log Out</b></nobr></qt>"
msgstr "<qt><nobr><b>ចេញ​ដោយ​ស្វ័យប្រវត្តិ</b></nobr></qt>"

#: lock/autologout.cc:45
msgid ""
"<qt>To prevent being logged out, resume using this session by moving the "
"mouse or pressing a key.</qt>"
msgstr "<qt>ដើម្បី​ទប់ស្កាត់​ការ​ចេញ បន្ដ​ប្រើ​សម័យ​ដោយ​ផ្លាស់​ទី​កណ្ដុរ ឬ​ចុច​គ្រាប់​ចុច​មួយ ។</qt>"

#: lock/autologout.cc:50
msgid "Time Remaining:"
msgstr "ពេល​នៅសល់ ៖"

#: lock/autologout.cc:86
#, kde-format
msgid "<qt><nobr>You will be automatically logged out in 1 second</nobr></qt>"
msgid_plural ""
"<qt><nobr>You will be automatically logged out in %1 seconds</nobr></qt>"
msgstr[0] "<qt><nobr>អ្នកនឹង​ត្រូវ​បាន​ចេញ​ដោយ​ស្វ័យប្រវត្តិ​ក្នុង​រយៈពេល %1 វិនាទី</nobr></qt>"

#: lock/main.cc:60
msgid "KRunner Locker"
msgstr "កម្មវិធី​ចាក់សោ KRunner"

#: lock/main.cc:60
msgid "Session Locker for KRunner"
msgstr "កម្មវិធី​ចាក់សោ​សម័យ​សម្រាប់ KRunner"

#: lock/main.cc:63
msgid "Force session locking"
msgstr "បង្ខំ​ឲ្យ​ចាក់សោ​សម័យ"

#: lock/main.cc:64
msgid "Only start screensaver"
msgstr "ចាប់​ផ្ដើម​តែធាតុ​រក្សា​អេក្រង់​"

#: lock/main.cc:65
msgid "Only use the blank screensaver"
msgstr "ប្រើ​តែ​ធាតុ​រក្សា​អេក្រង់​ទទេ"

#: lock/lockprocess.cc:739
msgid "Will not lock the session, as unlocking would be impossible:\n"
msgstr "នឹង​មិន​ចាក់​សោ​សម័យ ព្រោះថា​ការ​ដោះសោ​នឹង​មិន​អាច​ធ្វើ​ទៅបាន ៖\n"

#: lock/lockprocess.cc:743
msgid "Cannot start <i>kcheckpass</i>."
msgstr "មិន​អាច​ចាប់​ផ្ដើម <i>kcheckpass</i> ។"

#: lock/lockprocess.cc:744
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not SetUID root."
msgstr "<i>kcheckpass</i> មិន​អាច​ប្រតិបត្តិ ។ ប្រហែល​ជា​វា​មិន​មែន​ជា SetUID root ។"

#: lock/lockprocess.cc:787
msgid "No appropriate greeter plugin configured."
msgstr "គ្មាន​កម្មវិធី​ជំនួយ​វន្ទនាការសមរម្យ ត្រូវបាន​កំណត់​រចនាសម្ព័ន្ធ ។"

#: lock/lockdlg.cc:94
msgid "<nobr><b>The session is locked</b></nobr><br />"
msgstr "<nobr><b>សម័យ​ត្រូវបាន​ចាក់សោ</b></nobr><br />"

#: lock/lockdlg.cc:95
#, kde-format
msgid "<nobr><b>The session was locked by %1</b></nobr><br />"
msgstr "<nobr><b>សម័យ​ត្រូវបាន​ចាក់សោ​ដោយ %1</b></nobr><br />"

#: lock/lockdlg.cc:106
msgid "Unl&ock"
msgstr "ដោះសោ"

#: lock/lockdlg.cc:108
msgid "Sw&itch User..."
msgstr "ប្ដូរ​អ្នក​ប្រើ..."

#: lock/lockdlg.cc:178
msgid "<b>Unlocking failed</b>"
msgstr "<b>ការ​ដោះ​សោ​បាន​បរាជ័យ</b>"

#: lock/lockdlg.cc:186
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>ព្រមាន ៖ ប្តូរ​ជាប់​បាន​បើក​ហើយ</b>"

#: lock/lockdlg.cc:418
#, kde-format
msgid ""
"Cannot unlock the session because the authentication system failed to work;\n"
"you must kill krunner_lock (pid %1) manually."
msgstr ""
"មិនអាច​ដោះសោ​សម័យបានទេ ព្រោះ​បរាជ័យ​ក្នុង​ការ​ផ្ទៀងផ្ទាត់​ភាពត្រឹមត្រូវ​ប្រព័ន្ធ ។\n"
"អ្នក​ត្រូវ​តែ​បិទ krunner_lock (លេខ​សម្គាល់​កម្មវិធី ៖ %1) ដោយ​ដៃ ។"

#: lock/lockdlg.cc:503
msgid "&Start New Session"
msgstr "ចាប់ផ្ដើម​សម័យ​ថ្មី"

#: lock/lockdlg.cc:511
#, kde-format
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one.\n"
"The current session will be hidden and a new login screen will be "
"displayed.\n"
"An F-key is assigned to each session; F%1 is usually assigned to the first "
"session, F%2 to the second session and so on. You can switch between "
"sessions by pressing Ctrl, Alt and the appropriate F-key at the same time. "
"Additionally, the KDE Panel and Desktop menus have actions for switching "
"between sessions."
msgstr ""
"អ្នក​បាន​ជ្រើស​បើក​សម័យ​ផ្ទៃតុ​ផ្សេងទៀត ជំនួស​ការ​ធ្វើ​បន្ត​សម័យ​ផ្ទៃតុ​បច្ចុប្បន្ន ។\n"
"សម័យ​បច្ចុប្បន្ន នឹង​ត្រូវ​បាន​លាក់ ហើយ​អេក្រង់​ចូល​ថ្មី​នឹង​ត្រូវបាន​បង្ហាញ ។\n"
"គ្រាប់ចុច F គឺ​ត្រូវបាន​ផ្ដល់ទៅ​ឲ្យសម័យ​នីមួយៗ ។ ជាទូទៅ F%1 គឺ​ត្រូវបាន​ផ្ដល់​ដល់​សម័យ​ដំបូង F%2 ផ្ដល់​ទៅឲ្យ​សម័យ​"
"ទី ពីរ ហើយ​បន្តបន្ទាប់​មកទៀត ។ អ្នក​អាច​ប្ដូរ​ពី​សម័យ​មួយ ទៅ​សម័យ​មួយ​ដោយ​ចុច បញ្ជា​(Ctrl) ជំនួស​(Alt) "
"និងគ្រាប់ចុច F ដែល​ត្រឹមត្រូវ​នៅពេល​តែមួយ ។ បន្ថែម​ពីនេះ ម៉ឺនុយ​បន្ទះ និង​ផ្ទៃតុ KDE មាន​អំពើ​សម្រាប់​ការ​"
"ប្ដូរ​​ពី​សម័យ​មួយទៅ​សម័យ​មួយ ។"

