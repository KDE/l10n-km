#: deviceitem.cpp:249
msgid "Click to safely remove this device from the computer."
msgstr "ចុច​ដើម្បី​យក​ឧបករណ៍​នេះ​ចេញ​ពី​កុំព្យូទ័រ ។"

#: deviceitem.cpp:250
msgid "Device is plugged in and can be accessed by applications."
msgstr "ឧបករណ៍​ត្រូវ​បាន​ដោត​ ហើយ​អាច​ត្រូវ​បាន​ចូលដំណើរការ​ដោយ​កម្មវិធី ។"

#: deviceitem.cpp:252
msgid "Click to access this device from other applications."
msgstr "ចុច​ដើម្បី​ចូលដំណើរការ​ឧបករណ៍​នេះ​ពី​កម្មវិធី​ផ្សេង ។"

#: deviceitem.cpp:253
msgid "Device is plugged in, but not mounted for access yet."
msgstr "ឧបករណ៍​ត្រូវ​បានដោត ប៉ុន្តែ​មិនបាន​ម៉ោន​ដើម្បី​ដំណើរការ​នៅ​ឡើយ​ទេ ។"

#: deviceitem.cpp:344
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "ទំនេរ %1"

#: devicenotifier.cpp:187
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "សកម្មភាព​ %1 សម្រាប់​ឧបករណ៍នេះ"

#: devicenotifier.cpp:254
msgid "No devices plugged in"
msgstr "មិន​មាន​ឧបករណ៍​បាន​ដោត​ទេ"

#: devicenotifier.cpp:258
#, kde-format
msgid "Last plugged in device: %1"
msgstr "បាន​ដោត​ឧបករណ៍​ចុងក្រោយ ៖ %1"

#: devicenotifier.cpp:360
msgctxt "General options page"
msgid "General"
msgstr "ទូទៅ"

#: notifierdialog.cpp:65
msgid "Show hidden devices"
msgstr "បង្ហាញ​ឧបករណ៍​ដែលបាន​លាក់"

#: notifierdialog.cpp:503
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"មិន​អាច​អាន់ម៉ោន​ឧបករណ៍​បាន​ទេ ។\n"
"ឯកសារ​មួយ ឬ​ច្រើន​នៅ​លើ​ឧបករណ៍​នេះ​ត្រូវ​បានបើក​នៅ​ក្នុង​កម្មវិធី ។"

#: notifierdialog.cpp:522
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"មិន​អាច​ច្រាន​ថាស​ចេញ ។\n"
"ឯកសារ​មួយ ឬ​ច្រើន​នៅ​លើ​ថាស​នេះ​ត្រូវ​បាន​បើក​នៅ​ក្នុង​កម្មវិធី ។"

#: notifierdialog.cpp:537
msgid "Cannot mount the disc."
msgstr "មិនអាច​ម៉ោន​ថាស​បានទេ ។"

#: notifierdialog.cpp:746
#, kde-format
msgctxt "Hide a device"
msgid "Hide %1"
msgstr "លាក់ %1"

#: notifierdialog.cpp:810
msgid "No devices plugged in."
msgstr "គ្មាន​ឧបករណ៍​បាន​ដោត​ទេ ។"

#: notifierdialog.cpp:812
msgid "Devices recently plugged in:"
msgstr "ឧបករណ៍​ដែលបានដោត​ថ្មីៗ ៖"

#. i18n: file: configurationpage.ui:23
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:3 rc.cpp:15
msgid "Display:"
msgstr "បង្ហាញ ៖"

#. i18n: file: configurationpage.ui:37
#. i18n: ectx: property (text), item, widget (KComboBox, showDevices)
#: rc.cpp:6 rc.cpp:18
msgid "Removable devices only"
msgstr "មានតែ​ឧបករណ៍​ចល័ត"

#. i18n: file: configurationpage.ui:42
#. i18n: ectx: property (text), item, widget (KComboBox, showDevices)
#: rc.cpp:9 rc.cpp:21
msgid "Non-removable devices only"
msgstr "គ្មាន​ឧបករណ៍​ចល័ត"

#. i18n: file: configurationpage.ui:47
#. i18n: ectx: property (text), item, widget (KComboBox, showDevices)
#: rc.cpp:12 rc.cpp:24
msgid "All devices"
msgstr "ឧបករណ៍​ទាំងអស់"
