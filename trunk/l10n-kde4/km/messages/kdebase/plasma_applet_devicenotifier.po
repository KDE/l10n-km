#: devicenotifier.cpp:97
msgid "<font color=\"white\">Recently plugged devices:</font>"
msgstr "<font color=\"white\">ឧបករណ៍​ដែល​បាន​ដោត​ថ្មីៗ ៖</font>"

#: devicenotifier.cpp:281
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "សកម្មភាព​ %1 សម្រាប់​ឧបករណ៍នេះ"

#: devicenotifier.cpp:396
msgid "Configure New Device Notifier"
msgstr "កំណត់​រចនា​សម្ព័ន្ធ​កម្មវិធី​កំណត់​អត្តសញ្ញាណ​ឧបករណ៍​ថ្មី"

#: devicenotifier.cpp:474
msgid ""
"Cannot unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""

#: devicenotifier.cpp:485
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""

