#: devicewrapper.cpp:127
msgid "Mount the device"
msgstr "ម៉ោន​ឧបករណ៍"

#: devicewrapper.cpp:129
msgid "Unmount the device"
msgstr "អាន់ម៉ោន​ឧបករណ៍"

#: devicewrapper.cpp:133
msgctxt ""
"Unlock the encrypted container; will ask for a password; partitions inside "
"will appear as they had been plugged in"
msgid "Unlock the container"
msgstr "ដោះសោ​ឧបករណ៍​ផ្ទុក"

#: devicewrapper.cpp:135
msgctxt ""
"Close the encrypted container; partitions inside will disappear as they had "
"been unplugged"
msgid "Lock the container"
msgstr "ចាក់សោ​ឧបករណ៍"

#: devicewrapper.cpp:139
msgid "Eject medium"
msgstr "ច្រាន​ឧបករណ៍​ចេញ"

#: devicewrapper.cpp:218
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"មិនអាច​អាន់ម៉ោន​ឧបករណ៍​បាន​ទេ ។\n"
"ឯកសារ​មួយ ឬ​ច្រើន​នៅ​លើ​ឧបករណ៍​​ត្រូ​វបាន​បើក​នៅ​ក្នុង​កម្មវិធី ។"

#: devicewrapper.cpp:223
msgid ""
"Could not eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"មិនអាច​ច្រាន​ថាស​ចេញ​បាន​ទេ ។\n"
"ឯកសារ​មួយ ឬ​ច្រើន​នៅ​លើ​ថាស​នេះ​ត្រូវ​បានបើក​នៅ​ក្នុង​កម្មវិធី ។"

#: devicewrapper.cpp:228
msgid "Could not mount the disc."
msgstr "មិនអាច​ម៉ោន​ថាស​បាន​ទេ ។"

#: solidrunner.cpp:48
msgid "Finds devices whose name match :q:"
msgstr "រក​ឧបករណ៍​​ដែល​ឈ្មោះ​របស់​វា​ត្រូវ​គ្នា :q:"

#: solidrunner.cpp:50 solidrunner.cpp:131
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "ឧបករណ៍"

#: solidrunner.cpp:51
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr "រាយ​ឧបករណ៍​ទាំងអស់​ ហើយ​អនុញ្ញាត​ឲ្យ​ម៉ោន​ពួកវា អាន់ម៉ោន ឬ​ច្រាន​ចេញ ។"

#: solidrunner.cpp:52 solidrunner.cpp:137
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "ម៉ោន"

#: solidrunner.cpp:53
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr "រាយ​ឧបករណ៍​ទាំងអស់​ដែល​អាច​ត្រូវ​បានម៉ោន ហើយ​អនុញ្ញាត​ឲ្យ​ម៉ោន​ពួកវា ។"

#: solidrunner.cpp:54 solidrunner.cpp:141
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "អាន់ម៉ោន"

#: solidrunner.cpp:55
msgid "Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr "រាយ​ឧបករណ៍​ដែល​អាច​ត្រូវ​បាន​អាន់ម៉ោន ហើយ​អនុញ្ញាត​ឲ្យ​អាន់ម៉ោន ។"

#: solidrunner.cpp:56
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "ច្រានចេញ"

#: solidrunner.cpp:57
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr "រាយ​ឧបករណ៍​ទាំងអស់​ដែលអាច​ត្រូ​វបាន​ច្រានចេញ ហើយ​អនុញ្ញា​ឲ្យ​ច្រាន​ពួកវា​ចេញ ។"

