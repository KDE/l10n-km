msgstr "បន្ថែម​ឆ្នាំ​ទៅ​ខ្សែអក្សរ​កាលបរិច្ឆេទ ។"

#. i18n: file: clockConfig.ui:264
#. i18n: ectx: property (text), widget (QCheckBox, showYear)
#: rc.cpp:69 rc.cpp:165
msgid "Show &year"
msgstr "បង្ហាញ​ឆ្នាំ"

#. i18n: file: clockConfig.ui:291
