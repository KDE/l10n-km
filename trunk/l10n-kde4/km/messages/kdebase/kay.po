#: medianotifier.cpp:207
#, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"ឯកសារ​រត់​​ស្វ័យ​ប្រវត្តិ​បាន​រក​ឃើញ​នៅ​លើ %1' របស់​អ្នក ។ តើ​អ្នក​ចង់​ប្រតិបត្តិ​វា​ឬ​ទេ ?\n"
"សូម​ចំណាំ​ថា ការ​ប្រតិបត្តិ​ឯកសារ​នៅ​លើ​ឧបករណ៍​ផ្ទុក​អាច​សម្របសម្រួល​សុវត្ថិភាព​ប្រព័ន្ធ​របស់​អ្នក​ ។"

#: medianotifier.cpp:211
#, qt-format
msgid "Autorun - %1"
msgstr "រត់​ស្វ័យប្រវត្តិ - %1"

#: medianotifier.cpp:276
#, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"បើក​ឯកសារ​ស្វ័យប្រវត្តិ​ដែល​បាន​រក​ឃើញ​នៅ​លើ​ '%1' របស់​អ្នក ។ តើ​អ្នក​ចង់​បើក​ '%2' ដែរ​ឬ​ទេ?\n"
"ចំណាំ​ថា បើក​ឯកសារ​ណា​មួយ​ពី​ឧបករណ៍​ផ្ទុក​អាច​ព្រមព្រៀង​ជាមួយ​សុវត្ថិភាព​របស់​ប្រព័ន្ធ​របស់​អ្នក ។"

#: medianotifier.cpp:280
#, qt-format
msgid "Autoopen - %1"
msgstr "បើក​ស្វ័យប្រវត្តិ - %1"

#: notificationdialog.cpp:56
msgid "<b>Medium Type:</b>"
msgstr "<b>ប្រភេទ​ឧបករណ៍​ផ្ទុក ៖</b>"

#: notificationdialog.cpp:69
msgid "Configure"
msgstr "កំណត់​រចនា​សម្ព័ន្ធ"

#. i18n: tag string
#. i18n: file notificationdialogview.ui line 69
#: rc.cpp:3
msgid "A new medium has been detected.<br><b>What do you want to do?</b>"
msgstr "ឧបករណ៍​ផ្ទុក​ថ្មី​ត្រូ​វបាន​រក​ឃើញ ។<br><b>តើ​អ្នក​ចង់​ធ្វើ​អ្វី?</b>"

#. i18n: tag string
#. i18n: file notificationdialogview.ui line 90
#: rc.cpp:6
msgid "..."
msgstr "..."

#. i18n: tag string
#. i18n: file notificationdialogview.ui line 103
#: rc.cpp:9
msgid "&Always do this for this type of media"
msgstr "ធ្វើ​បែប​នេះ​ជានិច្ច​ចំពោះ​ប្រភេទ​មេឌៀ​ប្រភេទ​នេះ"

