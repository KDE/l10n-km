msgid "Layout variant:"
msgstr "វ៉ារ្យង់​ប្លង់ ៖"

#  i18n: file kcmlayoutwidget.ui line 217
#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 252
#: rc.cpp:30
msgid ""
"Here you can choose a variant of selected keyboard layout. Layout variants "
"usually represent different key maps for the same language. For example, "
"Ukrainian layout might have four variants: basic, winkeys (as in Windows), "
"typewriter (as in typewriters) and phonetic (each Ukrainian letter is placed "
"on a transliterated latin one).\n"
msgstr ""
"នៅ​ទីនេះ អ្នក​អាច​ជ្រើស​ប្លង់​ក្ដារចុច​ដែល​បាន​ជ្រើស​ផ្សេងៗ ។ វ៉ារ្យ៉ង់​ប្លង់​តាម​ធម្មតា​តំណាង​ឲ្យ​ផែនទី​គ្រាប់ចុច​"
"សម្រាប់​ភាសា​ដូច​គ្នា ។ ឧទាហរណ៍ ប្លង់​អ៊ុយ​ក្រែន​អាច​មាន​ប្លង់​ផ្សេងៗ​ចំនួន​បួន ៖ មូលដ្ឋាន winkeys (ដូច​ក្នុង "
"វីនដូ) ម៉ាស៊ីន​អង្គុលីលេខ (ដូច​ក្នុង​ម៉ាស៊ីន​អង្គុលីលេខ) និង​សូរសព្ទ (អក្សរ​អ៊ុយក្រែន​នីមួយៗ​ត្រូវ​បាន​ជំនួស​អក្សរ​ឡាតាំង​"
"ដែល​បាន​សរសេរ​ជា​ភាសា​មួយ) ។\n"

