#: medianotifier/medianotifier.cpp:207
#, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"ឯកសារ​រត់​ស្វ័យប្រវត្តិ​ត្រូវ​បាន​រក​ឃើញ​នៅ​លើ​ '%1' របស់​អ្នក ។ តើ​អ្នកចង់​ប្រតិបត្តិ​វា​ឬ​ ?\n"
"ចំណាំ​ថា​ ការ​ប្រតិបត្តិឯកសារ​នៅ​លើ​ឧបករណ៍​អាចព្រមព្រៀង​សុវត្ថិភាព​ប្រព័ន្ធ​របស់​អ្នក "

#: medianotifier/medianotifier.cpp:211
#, qt-format
msgid "Autorun - %1"
msgstr "រត់ - %1 ស្វ័យប្រវត្តិ"

#: medianotifier/medianotifier.cpp:276
#, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"ឯកសារ​រត់​ស្វ័យប្រវត្តិ​ត្រូវ​បាន​រក​ឃើញ​នៅ​លើ '%1' របស់​អ្នក ។ តើ​អ្នក​ចង់បើក '%2' ដែល​ឬ​ទេ ?\n"
"ចំណាំ​ថា ការ​បើក​ឯកសារ​នៅ​លើ​ឧបករណ៍​ផ្ទុកអាច​សម្រមសម្រួល​សុវត្ថិភាព​របស់​ប្រព័ន្ធ​របស់​អ្នក"

#: medianotifier/medianotifier.cpp:280
#, qt-format
msgid "Autoopen - %1"
msgstr "បើក​ - %1 ស្វ័យប្រវត្តិ"
