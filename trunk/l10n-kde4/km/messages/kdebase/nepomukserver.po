#: nepomukserverkcm.cpp:45
msgid "Nepomuk Configuration Module"
msgstr "ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ Nepomuk"

#: nepomukserverkcm.cpp:47
msgid "Copyright 2007 Sebastian Trüg"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៧ ដោយ Sebastian Trüg"

#: nepomukserverkcm.cpp:48
msgid "Sebastian Trüg"
msgstr "Sebastian Trüg"

#: nepomukserverkcm.cpp:84
msgid ""
"The Nepomuk Server KDED module is not running. The settings will be used the "
"next time the server is started."
msgstr "ម៉ូឌុល KDED របស់​ម៉ាស៊ីន​បម្រើ Nepomuk គឺ​មិនកំពុង​រត់​ទេ ។ ការ​កំណត់​នឹង​ត្រូវប្រើ​​នៅពេល​ដែល​ម៉ាស៊ីន​បម្រើ​ចាប់ផ្ដើម​លើកក្រោយ ។"

#: nepomukserverkcm.cpp:86 nepomukserverkcm.cpp:147
msgid "Nepomuk server not running"
msgstr "ម៉ាស៊ីន​បម្រើ Nepomuk មិន​កំពុង​រត់​ទេ"

#: nepomukserverkcm.cpp:145
msgid ""
"The Nepomuk Server KDED module is not running. The settings have been saved "
"and will be used the next time the server is started."
msgstr "ម៉ូឌុល KDED របស់​ម៉ាស៊ីន​បម្រើ Nepomuk មិនកំពុង​រត់ទេ ។ ការ​កំណត់​ត្រូវបាន​រក្សាទុក និង​ប្រើ​នៅពេល​ដែល​ម៉ាស៊ីន​បម្រើ​ចាប់ផ្ដើម​លើក្រោយ ។"

#: nepomukserverkcm.cpp:185
msgid "Strigi is running"
msgstr "Strigi កំពុង​រត់"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 76
#: nepomukserverkcm.cpp:189 rc.cpp:15
msgid "Strigi not running"
msgstr "Strigi មិន​កំពុង​រត់​ទេ"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 21
#: rc.cpp:3
msgid "Basic Settings"
msgstr "ការ​កំណត់​មូលដ្ឋាន"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 27
#: rc.cpp:6 strigicontroller.cpp:198
msgid "Strigi Desktop Search"
msgstr "ស្វែងរក​ផ្ទៃតុ Strigi"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 33
#: rc.cpp:9
msgid ""
"Strigi desktop search allows to search files by content instead of just by "
"name."
msgstr "ការ​ស្វែងរក​ផ្ទៃតុ Strigi អនុញ្ញាត​ឲ្យ​ស្វែងរក​ឯកសារ​តាម​មាតិកា ជំនួស​ឲ្យ​ឈ្មោះ ។"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 45
#: rc.cpp:12
msgid "Enable Strigi Desktop Search"
msgstr "អនុញ្ញាត​ការ​ស្វែងរក​ផ្ទៃតុ Strigi"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 90
#: rc.cpp:18
msgid "Nepomuk Semantic Desktop"
msgstr "ផ្ទៃតុ Nepomuk Semantic"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 96
#: rc.cpp:21
msgid ""
"Nepomuk Semantic Desktop enables tagging and rating of files integrated with "
"the Strigi Desktop Search."
msgstr "ផ្ទៃតុ Nepomuk Semantic អនុញ្ញាត​ការ​ដាក់ស្លាក និង​វាយតម្លៃ​នៃ​​ឯកសារ​ដែល​បាន​រួមបញ្ចូល​ជាមួយ​ការស្វែងរក​ផ្ទៃតុ Strigi ។"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 106
#: rc.cpp:24
msgid "Enable Nepomuk Semantic Desktop"
msgstr "អនុញ្ញាត​ផ្ទៃតុ Nepomuk Semantic"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 130
#: rc.cpp:27
msgid "Advanced Settings"
msgstr "ការ​កំណត់​កម្រិត​ខ្ពស់"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 136
#: rc.cpp:30
msgid "The folders Strigi scans for indexable files"
msgstr "ថត​ដែល Strigi វិភាគ​រក​ឯកសារ​ដែល​អាច​ចង​ជា​លិបិក្រម​បាន"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 142
#: rc.cpp:33
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Select the folders that "
"Strigi should scan for files to index. The files in these folders will be "
"searchable through Strigi Desktop Search.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ជ្រើស​ថត​ដែល Strigi គួរតែ​វិភាគ​រក​ឯកសារ​ដើម្បី​ចងក្រង​ជា​លិបិក្រម ។ ឯកសារ​ក្នុង​ថត​ទាំងនេះ​នឹង​អាច​ស្វែងរក​បាន​តាម​ការ​ស្វែងរក​ផ្ទៃតុ Strigi ។</p></body></html>"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 145
#: rc.cpp:39
msgid "Strigi Index Folders"
msgstr "ថត​លិបិក្រម Strigi"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 152
#: rc.cpp:42
msgid "Filters which define the files that Strigi should ignore"
msgstr "តម្រង​ដែល​កំណត់​ឯកសារ​ដែល Strigi គួរតែ​មិនអើពើ"

#. i18n: tag string
#. i18n: file nepomukconfigwidget.ui line 158
#: rc.cpp:45
msgid "Strigi Index Exclude Filters"
msgstr "តម្រង​មិនរាប់បញ្ចូល​លិបិក្រម Strigi"

