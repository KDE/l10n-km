#: web/webstyle.cpp:1604
msgid "modified"
msgstr "បាន​កែប្រែ​"

#: web/plugin.cpp:9
msgid "Web style plugin"
msgstr "កម្មវិធី​ជំនួយ​រចនាប័ទ្ម​បណ្តាញ​"

#: highcontrast/config/highcontrastconfig.cpp:49
msgid "Use wider lines"
msgstr "ប្រើ​បន្ទាត់​ទូលាយ​ជាង"

#: oxygen/config/oxygenconf.cpp:61 plastik/config/plastikconf.cpp:61
msgid "Animate progress bars"
msgstr "ធ្វើ​ឲ្យ​របារ​វឌ្ឍនភាព​មាន​ចលនា"

#: oxygen/config/oxygenconf.cpp:62 plastik/config/plastikconf.cpp:62
msgid "Draw toolbar separator"
msgstr "បន្ទាត់​ខណ្ឌ​ចែក​របារ​ឧបករណ៍​គូរ"

#: oxygen/config/oxygenconf.cpp:63 plastik/config/plastikconf.cpp:63
msgid "Draw toolbar item separators"
msgstr "បន្ទាត់​ខណ្ឌ​ចែក​វត្ថុ​របារ​ឧបករណ៍​គូរ"

#: oxygen/config/oxygenconf.cpp:65 plastik/config/plastikconf.cpp:65
msgid "Triangular tree expander"
msgstr "អ្នក​ពង្រីក​មែកធាង​ត្រីកោណ"

#: oxygen/config/oxygenconf.cpp:66 plastik/config/plastikconf.cpp:66
msgid "Highlight focused text input fields"
msgstr "បន្លិច​វាល​បញ្ចូល​អត្ថបទ​ដែល​ផ្តោត"

#: oxygen/config/oxygenconf.cpp:68 plastik/config/plastikconf.cpp:68
msgid "Custom text input highlight color:"
msgstr "ពណ៌​បន្លិច​ការ​បញ្ចូល​អត្ថបទ​ផ្ទាល់ខ្លួន"

#: oxygen/config/oxygenconf.cpp:73 plastik/config/plastikconf.cpp:73
msgid "Custom mouseover highlight color:"
msgstr "ពណ៌​បន្លិច​កណ្តុរ​លើ​ផ្ទាល់​ខ្លួន ៖"

#: oxygen/config/oxygenconf.cpp:78 plastik/config/plastikconf.cpp:78
msgid "Custom checkmark color:"
msgstr "ពណ៌​សម្គាល់​ធីក​ផ្ទាល់​ខ្លួន ៖"

