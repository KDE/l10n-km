#. i18n: file: shellOptions.ui:90
#. i18n: ectx: property (whatsThis), widget (QCheckBox, cbRealtime)
#: rc.cpp:3
msgid ""
"<qt>Select whether realtime scheduling should be enabled for the "
"application. The scheduler governs which process will run and which will "
"have to wait. Two schedulers are available:\n"
"<ul>\n"
"<li><em>Normal:</em> This is the standard, timesharing scheduler. It will "
"divide fairly the available processing time between all processes.</li>\n"
"<li><em>Realtime:</em>This scheduler will run your application uninterrupted "
"until it gives up the processor. This can be dangerous. An application that "
"does not give up the processor might hang the system. You need root's "
"password to use the scheduler.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>ជ្រើស​ថាតើ​កម្មវិធី​ realtime គួរ​ត្រូវបានបើក​សម្រាប់​កម្មវិធីដែរ​ឬទេ ។ កម្មវិធី​កំណត់​ពេលវេលា​"
"គ្រប់គ្រង​ដំណើរណាមួយ​ដែល​នឹង​រត់ និង​ដំណើរការ​ណាមួយ​ដែល​នឹង​ត្រូវ​រង់ចាំ ។ កម្មវិធី​កំណត់ពេល​ទាំងពីរ​អាច​"
"ប្រើបាន ៖\n"
"<ul>\n"
"<li><em>ធម្មតា ៖</em> នេះ​គឺ​ជា​ស្តង់ដារ កម្មវិធី​កំណត់ពេល​ចែករំលែក​ពេលវេលា ។ វា​នឹង​ចែក​ពេល​"
"ដំណើរការ​ដែល​មាន​ស្មើៗ​គ្នា​រវាង​ដំណើរការ​ទាំងអស់ ។</li>\n"
"<li><em>Realtime ៖</em>កម្មវិធី​កំណត់ពេល​នេះ​នឹង​រត់​កម្មវិធី​របស់​អ្នក​ដោយ​មិន​ផ្អាក​រហូត​ដល់វា​បោះបង់​"
"កម្មវិធី​ដំណើរការ ។ វាអាច​មានគ្រោះថ្នាក់ ។ កម្មវិធី​មួយ​ដែល​មិនបោះបង់​​កម្មវិធី​ដំណើរការ​អាច​ព្យួរ​ប្រព័ន្ធ ។ "
"អ្នក​ត្រូវការ​ពាក្យ​សម្ងាត់​របស់ root ដើម្បីប្រើ​កម្មវិធី​កំណត់​ពេល​នេះ ​។</li>\n"
"</ul>\n"
"</qt>"

