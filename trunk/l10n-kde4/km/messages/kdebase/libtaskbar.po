#  i18n: file taskbar.kcfg line 11
#. i18n: tag label
#. i18n: file taskbar.kcfg line 11
#: rc.cpp:4
#, no-c-format
msgid "Show windows from all desktops"
msgstr "បង្ហាញ​បង្អួច​ពី​ផ្ទៃតុ​ទាំងអស់"

#  i18n: file taskbar.kcfg line 12
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 12
#: rc.cpp:8
#, no-c-format
msgid ""
"Turning this option off will cause the taskbar to display <b>only</b> the "
"windows on the current desktop. \\n\\nBy default, this option is selected "
"and all windows are shown."
msgstr ""
"ការ​បិទ​ជម្រើស​នេះ​នឹង​ធ្វើ​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​<b>តែ</b>​បង្អួច​ដែល​នៅ​លើ​ផ្ទៃតុ​បច្ចុប្បន្ន​ប៉ុណ្ណោះ ។\\n"
"\\nតាម​លំនាំ​ដើម ជម្រើស​នេះ​ត្រូវ​ជ្រើស ហើយ​បង្អួច​ទាំងអស់​ត្រូវ​បាន​បង្ហាញ ។"

#  i18n: file taskbar.kcfg line 16
#. i18n: tag label
#. i18n: file taskbar.kcfg line 16
#: rc.cpp:12
#, no-c-format
msgid "Show only minimized windows"
msgstr "បង្ហាញ​តែ​បង្អួច​ដែល​បង្រួម​អប្បបរមា"

#  i18n: file taskbar.kcfg line 17
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 17
#: rc.cpp:16
#, no-c-format
msgid ""
"Select this option if you want the taskbar to display <b>only</b> minimized "
"windows. \\n\\nBy default, this option is not selected and the taskbar will "
"show all windows."
msgstr ""
"ជ្រើស​ជម្រើស​នេះ បើ​អ្នក​ចង់​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​<b>តែ</b>​បង្អួច ដែល​បាន​បង្រួម​អប្បបរមា​ប៉ុណ្ណោះ ។"
"\\n\\nតាម​លំនាំដើម ជម្រើស​នេះ​មិន​ត្រូវ​បាន​ជ្រើស​ទេ ហើយ​របារ​ភារកិច្ច​នឹង​បង្ហាញ​បង្អួច​ទាំងអស់ ។"

#  i18n: file taskbar.kcfg line 22
#. i18n: tag label
#. i18n: file taskbar.kcfg line 22
#: rc.cpp:20
#, no-c-format
msgid "Never"
msgstr "កុំ"

#  i18n: file taskbar.kcfg line 25
#. i18n: tag label
#. i18n: file taskbar.kcfg line 25
#: rc.cpp:24
#, no-c-format
msgid "When Taskbar Full"
msgstr "ពេល​របារ​ភារកិច្ច​ពេញ"

#  i18n: file taskbar.kcfg line 28
#. i18n: tag label
#. i18n: file taskbar.kcfg line 28
#: rc.cpp:28
#, no-c-format
msgid "Always"
msgstr "ជានិច្ច"

#  i18n: file taskbar.kcfg line 32
#. i18n: tag label
#. i18n: file taskbar.kcfg line 32
#: rc.cpp:32
#, no-c-format
msgid "Group similar tasks:"
msgstr "ដាក់​ភារកិច្ច​ស្រដៀង​គ្នា​ជា​ក្រុម ៖"

#  i18n: file taskbar.kcfg line 33
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 33
#: rc.cpp:36
#, no-c-format
msgid ""
"The taskbar can group similar windows into single buttons. When one of these "
"window group buttons are clicked on a menu appears showing all the windows "
"in that group. This can be especially useful with the <em>Show all windows</"
"em> option.\\n\\nYou can set the taskbar to <strong>Never</strong> group "
"windows, to <strong>Always</strong> group windows or to group windows only "
"<strong>When the Taskbar is Full</strong>.\\n\\nBy default the taskbar "
"groups windows when it is full."
msgstr ""
"របារ​ភារកិច្ច​អាច​ដាក់​បង្អួច​ដែល​ស្រដៀង​គ្នា​ជា​ក្រុម ទៅ​ជា​ប៊ូតុង​តែ​មួយ ។ ពេល​ចុច​ប៊ូតុង​ដាក់​ក្រុម​បង្អួច​មួយ​ក្នុង​"
"ចំណោម​ប៊ូតុង​ក្រុម​បង្អួច​ទាំងអស់ ម៉ឺនុយ​មួយ​នឹង​លេចឡើង​ដែល​បង្ហាញ​នូវ​បង្អួច​ទាំងអស់​ក្នុង​ក្រុម​នោះ ។ អំពើ​នេះ​អាច​មាន​"
"ប្រយោជន៍​យ៉ាង​ពិសេស​ជាមួយ​ជម្រើស <em>បង្ហាញ​បង្អួច​ទាំងអស់</em> ។\\n\\nអ្នក​អាច​កំណត់​<strong>កុំ</"
"strong>​ឲ្យ​របារ​ភារកិច្ច​ដាក់​បង្អួច​ជា​ក្រុម ឲ្យ​ដាក់​បង្អួច​ជា​ក្រុម​<strong>ជានិច្ច</strong> ឬ​ដាក់​បង្អួច​"
"ជា​ក្រុម​តែ​នៅ​<strong>ពេល​របារ​ភារកិច្ច​ពេញ</strong> ។\\n\\nតាម​លំនាំដើម របារ​ភារកិច្ច​នឹង​ដាក់​"
"បង្អួច​ជា​ក្រុម​នៅ​ពេល​វា​ពេញ ។"

#  i18n: file taskbar.kcfg line 37
#. i18n: tag label
#. i18n: file taskbar.kcfg line 37
#: rc.cpp:40
#, no-c-format
msgid "Sort windows by desktop"
msgstr "តម្រៀប​បង្អួច​តាម​ផ្ទៃតុ"

#  i18n: file taskbar.kcfg line 38
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 38
#: rc.cpp:44
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to show windows in order of the "
"desktop they appear on.\\n\\nBy default this option is selected."
msgstr ""
"ការ​ជ្រើស​ជម្រើស​នេះ​នឹង​ធ្វើ​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​បង្អួច​តាម​លំដាប់​ផ្ទៃតុ ដែល​ពួកវា​ស្ថិត​នៅ ។\\n\\nតាម​"
"លំនាំដើម ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស ។"

#  i18n: file taskbar.kcfg line 42
#. i18n: tag label
#. i18n: file taskbar.kcfg line 42
#: rc.cpp:48
#, no-c-format
msgid "Sort windows by application"
msgstr "តម្រៀប​បង្អួច​តាម​កម្មវិធី"

#  i18n: file taskbar.kcfg line 43
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 43
#: rc.cpp:52
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to show windows ordered by "
"application.\\n\\nBy default this option is selected."
msgstr ""
"ការ​ជ្រើស​ជម្រើស​នេះ​នឹង​ធ្វើ​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​បង្អួច​តាម​លំដាប់​កម្មវិធី ។\\n\\nតាម​លំនាំដើម ជម្រើស​"
"នេះ​ត្រូវ​បាន​ជ្រើស ។"

#  i18n: file taskbar.kcfg line 47
#. i18n: tag label
#. i18n: file taskbar.kcfg line 47
#: rc.cpp:56
#, no-c-format
msgid "Show application icons"
msgstr "បង្ហាញ​រូប​តំណាង​កម្មវិធី"

#  i18n: file taskbar.kcfg line 48
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 48
#: rc.cpp:60
#, no-c-format
msgid ""
"Select this option if you want window icons to appear along with their "
"titles in the taskbar.\\n\\nBy default this option is selected."
msgstr ""
"ជ្រើស​ជម្រើស​នេះ បើ​អ្នក​ចង់​ឲ្យ​រូប​តំណាង​បង្អួច​លេចឡើង​ជាមួយ​ចំណង​ជើង​របស់​ពួក​វា នៅ​ក្នុង​របារ​ភារកិច្ច ។\\n"
"\\nតាម​លំនាំដើម ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស ។"

#. i18n: tag label
#. i18n: file taskbar.kcfg line 53
#: rc.cpp:64
#, no-c-format
msgid "The maximum width of a task button"
msgstr "ទទឹង​អតិបរមា​នៃ​ប៊ូតុង​ភារកិច្ច"

#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 54
#: rc.cpp:68
#, no-c-format
msgid "If set to 0 then the hardcoded default is used."
msgstr "បើ​កំណត់​វា​ស្មើ ០ លំនាំដើម​កូដ​ដែល​ស្មុគស្មាញ​ត្រូវ​បាន​ប្រើ ។"

#  i18n: file taskbar.kcfg line 141
#. i18n: tag label
#. i18n: file taskbar.kcfg line 58
#: rc.cpp:72
#, no-c-format
msgid "The minimum height of a task buttons in pixels"
msgstr "កម្ពស់​អប្បរមា​នៃ​ប៊ូតុង​ភារកិច្ច​គិត​ជា​ភីកសែល "

#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 60
#: rc.cpp:76
#, no-c-format
msgid "This value must be at least 18 due to icons being 16 pixels high."
msgstr "តម្លៃ​នេះ​យ៉ាងហោច​ណាស់​ក៏ ១៨ ភីកសែល ដោយសារ​តែ​រូប​តំណាង​វា​ចាប់​ផ្តើម​ឡើង​ខ្ពស់​បំផុត ១៦ ភីកសែល ។"

#  i18n: file taskbar.kcfg line 64
#. i18n: tag label
#. i18n: file taskbar.kcfg line 64
#: rc.cpp:80
#, no-c-format
msgid "Show windows from all screens"
msgstr "បង្ហាញ​បង្អួច​ពី​អេក្រង់​ទាំងអស់"

#  i18n: file taskbar.kcfg line 65
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 65
#: rc.cpp:84
#, no-c-format
msgid ""
"Turning this option off will cause the taskbar to display <b>only</b> "
"windows which are on the same Xinerama screen as the taskbar.\\n\\nBy "
"default, this option is selected and all windows are shown."
msgstr ""
"ការ​បិទ​ជម្រើស​នេះ​នឹង​ធ្វើ​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ<b>តែ</b>បង្អួច ដែល​ស្ថិត​នៅ​លើ​អេក្រង់ Xinerama ដូច​"
"គ្នា​នឹង​របារ​ភារកិច្ច​ប៉ុណ្ណោះ ។\\n\\nតាម​លំនាំដើម ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស ហើយ​បង្អួច​ទាំងអស់​ត្រូវ​បាន​"
"បង្ហាញ ។"

#. i18n: tag label
#. i18n: file taskbar.kcfg line 69
#: rc.cpp:88
#, no-c-format
msgid "The font used in task buttons"
msgstr "ពុម្ពអក្សរ​ដែល​ប្រើ​ក្នុង​ប៊ូតុង​ភារកិច្ច"

#  i18n: file taskbar.kcfg line 74
#. i18n: tag label
#. i18n: file taskbar.kcfg line 74
#: rc.cpp:93
#, no-c-format
msgid "Show window list button"
msgstr "បង្ហាញ​ប៊ូតុង​បញ្ជី​បង្អួច"

#  i18n: file taskbar.kcfg line 75
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 75
#: rc.cpp:97
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to display a button that, when "
"clicked, shows a list of all windows in a popup menu."
msgstr ""
"ការ​ជ្រើស​ជម្រើស​នេះ​នឹង​ធ្វើ​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​តែ​ប៊ូតុង​មួយ ដែល​នៅ​ពេល​ចុច នឹង​បង្ហាញ​បញ្ជី​របស់​បង្អួច​"
"ទាំងអស់​ក្នុង​ម៉ឺនុយ​លេច​ឡើង ។"

#  i18n: file taskbar.kcfg line 87
#. i18n: tag label
#. i18n: file taskbar.kcfg line 87
#: rc.cpp:101
#, no-c-format
msgid "Show Task List"
msgstr "បង្ហាញ​បញ្ជី​ភារកិច្ច"

#  i18n: file taskbar.kcfg line 90
#. i18n: tag label
#. i18n: file taskbar.kcfg line 90
#: rc.cpp:105
#, no-c-format
msgid "Show Operations Menu"
msgstr "បង្ហាញ​ម៉ឺនុយ​ប្រតិបត្តិការ"

#  i18n: file taskbar.kcfg line 93
#. i18n: tag label
#. i18n: file taskbar.kcfg line 93
#: rc.cpp:109
#, no-c-format
msgid "Activate, Raise or Minimize Task"
msgstr "ធ្វើ​ឲ្យ​សកម្ម លើក​ឡើង​លើ ឬ​បង្រួម​ភារកិច្ច​អប្បបរមា"

#  i18n: file taskbar.kcfg line 96
#. i18n: tag label
#. i18n: file taskbar.kcfg line 96
#: rc.cpp:113
#, no-c-format
msgid "Activate Task"
msgstr "ធ្វើ​ឲ្យ​ភារកិច្ច​សកម្ម"

#  i18n: file taskbar.kcfg line 99
#. i18n: tag label
#. i18n: file taskbar.kcfg line 99
#: rc.cpp:117
#, no-c-format
msgid "Raise Task"
msgstr "លើក​ភារកិច្ច​ឡើង​លើ"

#  i18n: file taskbar.kcfg line 102
#. i18n: tag label
#. i18n: file taskbar.kcfg line 102
#: rc.cpp:121
#, no-c-format
msgid "Lower Task"
msgstr "បន្ទាប​ភារកិច្ច​ចុះក្រោម"

#  i18n: file taskbar.kcfg line 105
#. i18n: tag label
#. i18n: file taskbar.kcfg line 105
#: rc.cpp:125
#, no-c-format
msgid "Minimize Task"
msgstr "បង្រួម​ភារកិច្ច​អប្បបរមា"

#  i18n: file taskbar.kcfg line 108
#. i18n: tag label
#. i18n: file taskbar.kcfg line 108
#: rc.cpp:129
#, no-c-format
msgid "Move To Current Desktop"
msgstr "ផ្លាស់ទី​ទៅ​ផ្ទៃតុ​បច្ចុប្បន្ន"

#  i18n: file taskbar.kcfg line 114
#. i18n: tag label
#. i18n: file taskbar.kcfg line 114
#: rc.cpp:133
#, no-c-format
msgid "Mouse button actions"
msgstr "អំពើ​របស់​ប៊ូតុង​កណ្ដុរ"

#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 115
#: rc.cpp:137
#, no-c-format
msgid ""
"You can set the actions that occur when using the left, right and middle "
"mouse buttons on task buttons. These include bringing the associated window "
"to the front, minimizing it, showing the context (or operations) menu, etc."
msgstr ""
"អ្នកអាច​កំណត់​អំពើរ​ដែល​កើត​ឡើង ពេល​ប្រើ​កណ្ដុរ​ប៊ូតុង ឆ្វេង ស្តាំ និង​កណ្ដាលនៅ​លើ​ប៊ូតុង​ភាកិច្ច ។ ទាំងនេះ​រួម​"
"បញ្ចូល​ការ​នាំ​បង្អួច​ដែល​មាន​ទំនាក់ទំនង​ទៅ​ខាងមុខ បង្រួម​វា​អប្បបរមា បង្ហាញ​ម៉ឺនុយ​បរិបទ (ឬ​ប្រតិបត្តិការ) ។ល។"

#  i18n: file taskbar.kcfg line 122
#. i18n: tag label
#. i18n: file taskbar.kcfg line 122
#: rc.cpp:141
#, no-c-format
msgid "Draw taskbar entries \"flat\" and not as a button"
msgstr "គូរ​ធាតុ​របស់​របារ​ភារកិច្ច \"រាបស្មើ\" ហើយ​មិន​មែន​ជា​ប៊ូតុង"

#  i18n: file taskbar.kcfg line 123
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 123
#: rc.cpp:145
#, no-c-format
msgid ""
"Turning this option on will cause the taskbar to draw visible button frames "
"for each entry in the taskbar. \\n\\nBy default, this option is off."
msgstr ""
"បើក​ជម្រើស​នេះ​នឹង​នាំ​ឲ្យ​របារ​ភារកិច្ច​គូរ​ស៊ុម​ប៊ូតុង​ដែល​មើល​ឃើញ ទៅឲ្យ​ធាតុ​បញ្ចូល​នីមួយៗ​ក្នុង​របារ​ភារកិច្ច ។\\n"
"\\nតាម​លំនាំដើម ជម្រើស​នេះ​គឺបិទ ។"

#  i18n: file taskbar.kcfg line 127
#. i18n: tag label
#. i18n: file taskbar.kcfg line 127
#: rc.cpp:149
#, no-c-format
msgid "Draw taskbar text with a halo around it"
msgstr "គូរ​អត្ថបទ​របស់​របារ​ភារកិច្ច​ដែល​មាន​ឆ័ត្រ​បាំង​ជុំវិញ​វា"

#  i18n: file taskbar.kcfg line 128
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 128
#: rc.cpp:153
#, no-c-format
msgid ""
"Turning this option on will cause the taskbar to draw fancier text that has "
"an outline around it. While this is useful for transparent panels or "
"particularly dark panel backgrounds, it is slower."
msgstr ""
"បើក​ជម្រើស​នេះ​នឹង​នាំ​ឲ្យ​របារ​ភារកិច្ច​គូរ​អត្ថបទ​ដែល​អ្នក​ពេញ​ចិត្ត និង ​មានគ្រោងនៅ​ជុំវិញវា ។ វា​មាន​"
"ប្រយោជន៍​សម្រាប់​បន្ទះ​ថ្លា ឬ ផ្ទៃ​ខាងក្រោយ​ខ្មៅ​ពិសេស​របស់​បន្ទះ ប៉ុន្តែ​វា​គឺ​យឺតជាង ។"

#  i18n: file taskbar.kcfg line 132
#. i18n: tag label
#. i18n: file taskbar.kcfg line 132
#: rc.cpp:157
#, no-c-format
msgid "Show a visible button frame on the task the cursor is positioned over"
msgstr "បង្ហាញ​ស៊ុម​ប៊ូតុង​មើលឃើញ លើ​ភារកិច្ច​ដែល​ទស្សន៍​ទ្រនិច​ស្ថិត​នៅ​លើ"

#  i18n: file taskbar.kcfg line 136
#. i18n: tag label
#. i18n: file taskbar.kcfg line 136
#: rc.cpp:161
#, no-c-format
msgid "Show thumbnails instead of icons in the mouse-over effects"
msgstr "បង្ហាញ​រូបភាព​តូច​ជំនួស​ឲ្យ​រូបតំណាង ក្នុង​បែបផែន​កណ្ដុរ​លើ"

#  i18n: file taskbar.kcfg line 137
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 137
#: rc.cpp:165
#, no-c-format
msgid ""
"Enabling this option will draw a thumbnail of the window in its mouse-over "
"effect.<p>If a window is minimized or resides on a different desktop while "
"the taskbar is starting, an icon is shown until the window is restored or "
"the appropriate desktop is activated, respectively.</p>"
msgstr ""
"ធ្វើ​ឲ្យ​ជម្រើស​នេះ​សកម្ម នឹង​គូរ​រូបភាព​តូច​មួយ​របស់​បង្អួច​ក្នុង​បែបផែន​កណ្តុរ​លើ​របស់​វា ។ <p>ប្រសិន​បើ​បង្អួច​មួយ​"
"ត្រូវ​បាន​បង្រួម​អប្បបរមា ឬ​ស្ថិត​នៅ​លើ​ផ្ទៃតុ​ផ្សេង​គ្នា កំឡុង​ពេល​របារ​ភារកិច្ច​កំពុង​ចាប់​ផ្តើម នោះ​រូប​តំណាង​មួយ​"
"នឹង​បង្ហាញ លុះត្រា​តែ​បង្អួច​ត្រូវ​បាន​ស្តារ ឬ​ផ្ទៃតុ​សមរម្យ​ត្រូវ​បាន​ធ្វើ​ឲ្យ​សកម្ម​រៀងៗ​ខ្លួន ។</p>"

#  i18n: file taskbar.kcfg line 141
#. i18n: tag label
#. i18n: file taskbar.kcfg line 141
#: rc.cpp:169
#, no-c-format
msgid "Maximum width/height of the thumbnail in pixels"
msgstr "ទទឹង/កម្ពស់ អតិបរមា​របស់​រូបភាព​តូច​គិត​ជា​ភីកសែល"

#  i18n: file taskbar.kcfg line 142
#. i18n: tag whatsthis
#. i18n: file taskbar.kcfg line 142
#: rc.cpp:173
#, no-c-format
msgid ""
"A thumbnail is created by resizing the window. The scaling factor is "
"determined by its largest dimension and this value. In doing so, the "
"thumbnail's size will not exceed this value in any dimension."
msgstr ""
"រូបភាព​តូច​មួយ​ត្រូវ​បាន​បង្កើត​ដោយ​ផ្លាស់ប្តូរ​ទំហំ​របស់​បង្អួច ។ កត្តាមាត្រ​ដ្ឋានគឺ​ត្រូវ​បាន​កំណត់ ដោយ​វិមាត្រធំ​បំផុត​"
"របស់​វា និង​តម្លៃ​នេះ ។ ដោយ​ធ្វើ​បែប​នេះ ទំហំ​របស់​រូប​ភាព​តូច​នឹង​មិន​លើស​តម្លៃ​នេះ​ក្នុង​វិមាត្រ​ណាមួយ​ឡើយ ។"

#: taskbarbindings.cpp:36
msgid "Next Taskbar Entry"
msgstr "ធាតុ​របារ​ភារកិច្ច​បន្ទាប់"

#: taskbarbindings.cpp:37
msgid "Previous Taskbar Entry"
msgstr "ធាតុ​របារ​ភារកិច្ច​មុន"

