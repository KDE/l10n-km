#: completionmodel.cpp:137 completionmodel.cpp:259
#, kde-format
msgid ""
"<qt>The error <b>%4</b><br /> has been detected in the file %1 at %2/%3</qt>"
msgstr "<qt>កំហុស <b>%4</b><br /> ត្រូវ​បាន​រក​ឃើញ​នៅ​ក្នុង​ឯកសារ %1 នៅ %2/%3</qt>"

#: completionmodel.cpp:142 completionmodel.cpp:264
#, kde-format
msgid "Unable to open %1"
msgstr "មិន​អាច​បើក %1បាន​ទេ"

#: completionmodel.cpp:147 completionmodel.cpp:269
#, kde-format
msgid "Not a valid snippet file: %1"
msgstr "មិនមែន​ជា​ឯកសារ​អត្ថបទ​ខ្លីៗ​ត្រឹមត្រូវទេ ៖ %1"

#: completionmodel.cpp:339 completionmodel.cpp:978
msgid "Snippets"
msgstr "អត្ថបទ​ខ្លីៗ"

#: completionmodel.cpp:554
msgid ""
"You have edited a data file not located in your personal data directory, but "
"a suitable filename could not be generated for storing a clone of the file "
"within your personal data directory."
msgstr ""
"អ្នក​បាន​កែសម្រួល​ឯកសារ​ទិន្នន័យ​ដែល​មិន​នៅ​ក្នុង​ថត​ទិន្នន័យ​ផ្ទាល់​ខ្លួន​របស់​អ្នក ប៉ុន្តែ​ឈ្មោះ​ឯកសារ​ដែល​សមស្រប​"
"មិនអាច​ត្រូវ​បានបង្កើត​ ដើម្បី​រក្សាទុក​ក្លូន​ឯកសារ​នៅ​ក្នុង​ថត​ទិន្នន័យ​ផ្ទាល់​ខ្លួន​បាន​ទេ ។"

#: completionmodel.cpp:556
msgid ""
"You have edited a data file not located in your personal data directory; as "
"such, a renamed clone of the original data file has been created within your "
"personal data directory."
msgstr ""
"អ្នក​បាន​កែសម្រួល​​ឯកសារ​ទិន្នន័យ​ដែល​មិន​ស្ថិត​នៅ​ក្នុង​ថត​ទិន្នន័យ​ផ្ទាល់​របស់​អ្នក​ទេ ដូចជា ក្លូន​ដែល​បាន​ប្ដូរ​ឈ្មោះ​"
"នៃ​ឯកសារ​ទិន្នន័យ​ដើម ត្រូវ​បានបង្កើត​នៅ​ក្នុង​ថត​ទិន្នន័យ​ផ្ទាល់​ខ្លួន​របស់​អ្នក ។"

#: completionmodel.cpp:562 completionmodel.cpp:599
#, kde-format
msgid "Output file '%1' could not be opened for writing"
msgstr "ឯកសារ​លទ្ធផល​ '%1' មិនអាច​ត្រូវ​បាន​បើក​​សរសេរ​បាន​ទេ"

#: completionmodel.cpp:593
msgid ""
"It was not possible to create a unique file name for the given snippet "
"collection name"
msgstr "មិន​អាច​បង្កើត​ឈ្មោះ​ឯកសារ​សម្រាប់​ឈ្មោះ​សម្រាំងអត្ថបទ​ខ្លីៗ​បាន​ទេ ។"

#: completionmodel.cpp:751
msgid "New Snippet"
msgstr "អត្ថបទ​ខ្លីៗ​ថ្មី"

#. i18n: file: snippet_repository.ui:17
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:3
msgid "Snippet Repository:"
msgstr "ឃ្លាំង​អត្ថបទ​ខ្លីៗ ៖"

#. i18n: file: snippet_repository.ui:34
#. i18n: ectx: property (text), widget (KPushButton, btnNew)
#: rc.cpp:6
msgid "New Snippet File..."
msgstr "ឯកសារ​អត្ថបទ​ខ្លីៗ​ថ្មី..."

#. i18n: file: snippet_repository.ui:41
#. i18n: ectx: property (text), widget (KPushButton, btnGHNS)
#: rc.cpp:9
msgid "Get New Snippets..."
msgstr "យក​អត្ថបទ​ខ្លីៗ​ថ្មី..."

#. i18n: file: snippet_repository.ui:53
#. i18n: ectx: property (text), widget (KPushButton, btnCopy)
#: rc.cpp:12
msgid "Copy to repository"
msgstr "ចម្លង​ទៅ​ឃ្លាំង"

#: repository.cpp:181
msgid "all file types"
msgstr "គ្រប់​ប្រភេទ​ឯកសារ"

#: repository.cpp:185
#, kde-format
msgid "!TAINTED!:%1"
msgstr "!TAINTED! ៖%1"

#: repository.cpp:195
#, kde-format
msgid ""
"%1 (%2)\n"
"content license: %3\n"
"repository license: %4 authors: %5"
msgstr ""
"%1 (%2)\n"
"អាជ្ញាបណ្ណ​ខ្លឹមសារ ៖ %3\n"
"អាជ្ញាបណ្ណ​ឃ្លាំង ៖ %4 អ្នក​និពន្ធ ​៖ %5"

#: repository.cpp:356
#, kde-format
msgid ""
"Do you really want to delete the file '%1' from the repository? This action "
"is irreversible."
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​លុប​ឯកសារ '%1' ពីឃ្លាំង​ដែរ​ឬទេ ? សកម្ម​ភាព​នេះ​មិន​អាច​កែប្រែ​បាន​ទេ ។"

#: repository.cpp:357
msgid "Deleting snippet file"
msgstr "លុប​​ឯកសារ​អត្ថបទ​ខ្លីៗ"

#: repository.cpp:367
#, kde-format
msgid ""
"Editor application for file '%1' with mimetype 'application/x-ktesnippets' "
"could not be started"
msgstr ""
"កម្មវិធី​កែសម្រួល​សម្រាប់ '%1' ដែល​មាន mimetype 'application/x-ktesnippets' មិនអាច​ត្រូវ​បាន​"
"ចាប់ផ្ដើម​ទេ"

#: repository.cpp:394 repository.cpp:401 repository.cpp:557 repository.cpp:585
msgid ""
"Editor application for new file with mimetype 'application/x-ktesnippets' "
"could not be started"
msgstr ""
"កម្មវិធី​កែសម្រួល​សម្រាប់​ឯកសារ​ថ្មី​ដែល​មាន mimetype 'application/x-ktesnippets' មិន​អាច​ត្រូវ​"
"បាន​ចាប់ផ្ដើម​បាន​ទេ"

#: repository.cpp:409
msgid "No file specified"
msgstr "គ្មាន​ឯកសារ​បាន​បញ្ជាក់"

#: repository.cpp:423
msgid "It was not possible to create a unique file name for the imported file"
msgstr "មិន​អាច​បង្កើត​ឈ្មោះ​ឯកសារ​តែ​​មួយ​សម្រាប់​ឯកសារ​ដែល​បាន​នាំចូល​បាន​ទេ"

#: repository.cpp:426
msgid "Imported file has been renamed because of a name conflict"
msgstr "ឯកសារ​ដែល​បាននាំចូល​ត្រូវ​បាន​ប្ដូរ​ឈ្មោះ​ ដោយ​សារ​តែ​ឈ្មោះ​ជាន់​គ្នា"

#: repository.cpp:433
msgid "File could not be copied to repository"
msgstr "មិន​អាច​ចម្លង​ឯកសារ​ទៅ​ឃ្លាំង​បាន​ទេ"
