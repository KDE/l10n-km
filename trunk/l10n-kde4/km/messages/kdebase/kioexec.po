#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - បើក​ឯកសារ​ឆ្ងាយ មើល​ការ​កែប្រែ ស្នើ​ឲ្យ​ផ្ទុក​ឡើង"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr "ចាត់ទុក URLs ជា​ឯកសារ​មូលដ្ឋាន ហើយ​បន្ទាប់​មក​លុប​ពួក​វា"

#: main.cpp:51
msgid "Suggested file name for the downloaded file"
msgstr "ឈ្មោះ​ឯកសារ​ដែល​បាន​ស្នើ សម្រាប់​ឯកសារ​ដែល​បាន​ទាញយក"

#: main.cpp:52
msgid "Command to execute"
msgstr "ពាក្យ​បញ្ជា​ដែល​ត្រូវ​ប្រតិបត្តិ"

#: main.cpp:53
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL(s) ឬ ឯកសារ​មូលដ្ឋាន​ដែល​ប្រើ​សម្រាប់ 'ពាក្យ​បញ្ជា'"

#: main.cpp:62
msgid "'command' expected.\n"
msgstr "'ពាក្យ​បញ្ជា' ដែល​រំពឹង ។\n"

#: main.cpp:91
#, qt-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"ឺ​មិន​ត្រឹមត្រូវ"

#: main.cpp:93
#, qt-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"URL ឆ្ងាយ %1\n"
"មិន​ត្រូវ​បាន​អនុញ្ញាត​ជាមួយ​នឹង --tempfiles"

#: main.cpp:222
#, qt-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"ឯកសារ​បណ្តោះ​អាសន្ន​\n"
"%1\n"
"ប្រហែល​ជា​ត្រូវ​បាន​កែប្រែ ។\n"
"តើ​អ្នក​ចង់​លុប​ពួក​វា​ឬ​ទេ ?"

#: main.cpp:223 main.cpp:230
msgid "File Changed"
msgstr "ឯកសារ​បាន​ផ្លាស់ប្តូរ"

#: main.cpp:223
msgid "Do Not Delete"
msgstr "កុំ​លុប"

#: main.cpp:229
#, qt-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"ឯកសារ\n"
"%1\n"
"ត្រូវ​បាន​កែប្រែ​ហើយ ។\n"
"តើ​អ្នក​ចង់​ផ្ទុក​ការ​ផ្លាស់ប្តូរ​ឡើង​ឬ​ទេ ?"

#: main.cpp:230
msgid "Upload"
msgstr "ផ្ទុក​ឡើង"

#: main.cpp:230
msgid "Do Not Upload"
msgstr "កុំ​ផ្ទុក​ឡើង"

#: main.cpp:258
msgid "KIOExec"
msgstr "KIOExec"

