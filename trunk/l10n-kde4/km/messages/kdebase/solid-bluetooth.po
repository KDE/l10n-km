#: solid-bluetooth.cpp:52
msgid "solid-bluetooth"
msgstr "ប៊្លូធូស​​មិន​ប្រែប្រួល"

#: solid-bluetooth.cpp:54
msgid ""
"KDE tool for querying and controlling your hardware from the command line"
msgstr "ឧបករណ៍ KDE សម្រាប់​សួរ និង​​ត្រួតពិនិត្យ​ថាសរឹង​របស់​អ្នក​ពី​បន្ទាត់​ពាក្យ​បញ្ជា"

#: solid-bluetooth.cpp:166
msgid "Syntax Error: Not enough arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ គ្មាន​អាគុយម៉ង់​គ្រប់គ្រាន់"

#: solid-bluetooth.cpp:172
msgid "Syntax Error: Too many arguments"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ អាគុយម៉ង់​ច្រើន​ពេក"

#: solid-bluetooth.cpp:184
msgid "Show available commands by domains"
msgstr "បង្ហាញ​ពាក្យ​បញ្ជា​ដែលអាច​ប្រើ​បាន​ដោយ​ដែន"

#: solid-bluetooth.cpp:186
msgid "Command (see --commands)"
msgstr "ពាក្យបញ្ជា (សូម​មើល --commands)"

#: solid-bluetooth.cpp:188
msgid "Arguments for command"
msgstr "អាគុយម៉ង់​សម្រាប់​ពាក្យ​បញ្ជា"

#: solid-bluetooth.cpp:200
msgid "Syntax:"
msgstr "វាក្យសម្ពន្ធ ៖"

#: solid-bluetooth.cpp:203
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # រាយ​ចំណុចប្រទាក់​/អាដាប់ទ័រ​ប្ល៊ូធូស\n"

#: solid-bluetooth.cpp:206
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # រាយ​ចំណុចប្រទាក់/អាដាប់ទ័រ​​លំនាំដើម​របស់​ប្ល៊ូធូស\n"

#: solid-bluetooth.cpp:209
#, fuzzy
#| msgid ""
#| "             # Query information about the bluetooth adapter/interface "
#| "with 'ubi'\n"
msgid "             # Request to create a remote bluetooth device on the bus\n"
msgstr "             # ព័ត៌មាន​សំណួរ​អំពី​ចំណុចប្រទាក់​/អាដាប់ទ័រ​ប្ល៊ូធូស​ដែលមាន 'ubi'\n"

#: solid-bluetooth.cpp:212
#, fuzzy
#| msgid ""
#| "             # Query the name from the remote device 'remote-mac' with "
#| "'ubi'\n"
msgid ""
"             # Request to remove the remote bluetooth device from the bus\n"
msgstr "             # ស្រង់​ឈ្មោះ​ពី​ឧបករណ៍​ពី​ចម្ងាយ 'remote-mac' ដោយ​ប្រើ 'ubi'\n"

#: solid-bluetooth.cpp:215
#, fuzzy
#| msgid "             # List bluetooth adapters/interfaces\n"
msgid "             # Request the properties from the bluetooth adapter\n"
msgstr "             # រាយ​ចំណុចប្រទាក់​/អាដាប់ទ័រ​ប្ល៊ូធូស\n"

#: solid-bluetooth.cpp:407
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "កំហុស​វាក្យសម្ពន្ធ ៖ មិន​ស្គាល់​ពាក្យ​បញ្ជា '%1'"

#: solid-bluetooth.cpp:614
msgid "Error: unsupported operation!"
msgstr "កំហុស ៖ ប្រតិបត្តិការ​ដែល​មិន​បាន​គាំទ្រ !"

#: solid-bluetooth.cpp:625 solid-bluetooth.cpp:676
#, kde-format
msgid "Error: %1"
msgstr "កំហុស ៖ %1"

#: solid-bluetooth.cpp:722
#, kde-format
msgid "Progress: %1%"
msgstr "វឌ្ឍនភាព ៖ %1%"

#: solid-bluetooth.cpp:727
#, kde-format
msgid "Info: %1"
msgstr "ព័ត៌មាន ៖ %1"

#~ msgid ""
#~ "             # Set the bluetooth adapter name.\n"
#~ "             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
#~ "             # off|connectable|discoverable\n"
#~ msgstr ""
#~ "             # កំណត់​ឈ្មោះ​អាដាប់ទ័រ​ប៊្លូធូស ។\n"
#~ "             # កំណត់​របៀប​​អាដាប់ទ័រ​ប្ល៊ូធូស ។ ដែល​ 'តម្លៃ' គឺ​ ៖\n"
#~ "             # off|connectable|discoverable\n"

#~ msgid "             # Scan for bluetooth remote devices.\n"
#~ msgstr "             # វិភាគ​រក​ឧបករណ៍​ពីចម្ងាយ​របស់​ប្ល៊ូធូស ។\n"

#~ msgid "             # List configured input devices.\n"
#~ msgstr "             # រាយ​ឧបករណ៍​បញ្ចូល​ដែលបាន​កំណត់​រចនា​សម្ព័ន្ធ ។\n"

#~ msgid ""
#~ "             # Setup bluetooth input device.\n"
#~ "             # Remove configuration of remote input device.\n"
#~ "             # Connect or disconnect bluetooth input device.\n"
#~ msgstr ""
#~ "             # ដំឡើង​ឧបករណ៍​បញ្ចូល​របស់​ប្ល៊ូធូស ។\n"
#~ "             # យក​ការ​កំណត់​រចនាសម្ព័ន្ធ​នៃ​ឧបករណ៍​បញ្ចូល​ពី​ចម្ងាយ​ចេញ ។\n"
#~ "             # ភ្ជាប់ ឬ​ផ្ដាច់​​ឧបករណ៍​បញ្ចូល​របស់​ប្ល៊ូធូស ។\n"

