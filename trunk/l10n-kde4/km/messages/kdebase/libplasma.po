#: appletbrowser.cpp:314
msgid "Widgets"
msgstr "ធាតុក្រាហ្វិក"

#: appletbrowser.cpp:321
msgid "Close the dialog"
msgstr "បិទ​ប្រអប់"

#: appletbrowser.cpp:322
msgid ""
"<qt>When clicking <b>Close</b>, this dialog will be closed with no further "
"action taken.</qt>"
msgstr "<qt>នៅពេល​ចុច <b>បិទ</b> ប្រអប់​នេះ​នឹង​ត្រូវបាន​បិទ​ដោយ​មិនមាន​អំពើ​អ្វី​បន្ថែម​ទៀត​ទេ ។</qt>"

#: appletbrowser.cpp:323
msgid "Add selected widgets"
msgstr "បន្ថែម​ធាតុក្រាហ្វិក​ដែលបាន​ជ្រើស"

#: appletbrowser.cpp:324
msgid ""
"<qt>When clicking <b>Add Widget</b>, the selected widgets will be added to "
"your desktop.</qt>"
msgstr ""
"<qt>នៅពេល​ដែល​អ្នក​ចុច <b>បន្ថែម​ធាតុក្រាហ្វិក</b> នោះ​ធាតុក្រាហ្វិក​ដែលបាន​ជ្រើស នឹង​ត្រូវបាន​បន្ថែម​"
"ទៅ​ផ្ទៃតុ​របស់​អ្នក ។</qt>"

#: appletbrowser.cpp:325
msgid "Download new widgets"
msgstr "ទាញយក​ធាតុក្រាហ្វិក​ថ្មី"

#: appletbrowser.cpp:326
msgid ""
"<qt>When clicking <b>Get New Widgets</b>, a dialog will open to allow you to "
"download new widgets. You need to be connected to the Internet.</qt>"
msgstr ""
"<qt>នៅពេល​ដែល​អ្នក​ចុច <b>យក​ធាតុក្រាហ្វិក​ថ្មី</b> នោះ​ប្រអប់​នឹង​បើក ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​ទាញយក​"
"ធាតុក្រាហ្វិក​ថ្មី ។ អ្នក​ត្រូវភ្ជាប់​ទៅកាន់​អ៊ីនធឺណិត​សិន ។</qt>"

