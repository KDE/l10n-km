msgid "Add selected widgets"
msgstr "បន្ថែម​ធាតុក្រាហ្វិក​ដែលបាន​ជ្រើស"

#: appletbrowser.cpp:365
msgid ""
"<qt>When clicking <b>Add Widget</b>, the selected widgets will be added to "
"your desktop.</qt>"
msgstr ""
"<qt>នៅពេល​ដែល​អ្នក​ចុច <b>បន្ថែម​ធាតុក្រាហ្វិក</b> នោះ​ធាតុក្រាហ្វិក​ដែលបាន​ជ្រើស នឹង​ត្រូវបាន​បន្ថែម​"
"ទៅ​ផ្ទៃតុ​របស់​អ្នក ។</qt>"

#: appletbrowser.cpp:366
