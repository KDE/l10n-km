#. i18n: ectx: label, entry (UseGUIRegExpEditor), group (General)
#: rc.cpp:134
msgid "Use graphical regexp editor"
msgstr "ប្រើ​កម្មវិធីនិពន្ធ​ regexp ក្រាហ្វិក"

