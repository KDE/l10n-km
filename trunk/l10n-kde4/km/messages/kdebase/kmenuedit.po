#: basictab.cpp:513
#, qt-format
msgid ""
"<qt>The key <b>%1</b> can not be used here because it is already used to "
"activate <b>%2</b>.</qt>"
msgstr ""
"<qt>គ្រាប់​ចុច <b>%1</b> មិន​អាច​ប្រើ​បានទេ​​នៅ​ទីនេះ​ ពីព្រោះ​វា​ត្រូវ​បាន​ដើម្បី​ធ្វើ​ឲ្យសកម្ម​រួច​ហើយ <b>%"
"2</b> ។"

#: basictab.cpp:518
#, qt-format
msgid ""
"<qt>The key <b>%1</b> can not be used here because it is already in use.</qt>"
msgstr ""
"<qt>គ្រាប់​ចុច <b>%1</b> មិន​អាច​ប្រើ​បាន​នៅទីនេះ​ទេ ពីព្រោះ​វា​បាន​ស្ថិត​នៅ​ក្នុង​ការ​ប្រើប្រាស់ ។"

