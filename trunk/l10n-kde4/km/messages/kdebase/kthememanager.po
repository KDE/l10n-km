#: knewthemedlg.cpp:31
msgid "New Theme"
msgstr "ស្បែកថ្មី"

#: kthememanager.cpp:61
msgid "KDE Theme Manager"
msgstr "កម្មវិធី​គ្រប់គ្រងស្បែក KDE"

#: kthememanager.cpp:62 kthememanager.cpp:68
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr "ម៉ូឌុល​បញ្ជា​នេះ​ដោះស្រាយ​រាល់​ការ​ដំឡើង យកចេញ និង​បង្កើតស្បែក KDE ដែល​មើល​ឃើញ ។"

#: kthememanager.cpp:64
msgid "(c) 2003, 2004 Lukáš Tinkl"
msgstr "(c) រក្សា​សិទ្ធ​ឆ្នាំ ២០០៣-២០០៤ Lukáš Tinkl"

#: kthememanager.cpp:221
msgid "Theme Files"
msgstr "ឯកសារ​ស្បែក"

#: kthememanager.cpp:222
msgid "Select Theme File"
msgstr "ជ្រើសឯកសារស្បែក"

#: kthememanager.cpp:256
#, qt-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​យក​ស្បែក <b>%1</b> ចេញ​ឬ ?"

#: kthememanager.cpp:257
msgid "Remove Theme"
msgstr "យក​ស្បែកចេញ"

#: kthememanager.cpp:279
msgid "My Theme"
msgstr "ស្បែករបស់​ខ្ញុំ"

#: kthememanager.cpp:290
#, qt-format
msgid "Theme %1 already exists."
msgstr "ស្បែក %1 មាន​រួច​ហើយ ។"

#: kthememanager.cpp:310
#, qt-format
msgid "Your theme has been successfully created in %1."
msgstr "ស្បែករបស់​អ្នកបាន​បង្កើត​ដោយ​ជោគជ័យ​ក្នុង %1 ។"

#: kthememanager.cpp:311
msgid "Theme Created"
msgstr "ស្បែកត្រូវ​បាន​បង្កើត"

#: kthememanager.cpp:313
msgid "An error occurred while creating your theme."
msgstr "កំហុស​មួយ​បាន​កើតឡើង ខណៈ​ពេល​បង្កើត​ស្បែករបស់​អ្នក ។"

#: kthememanager.cpp:314
msgid "Theme Not Created"
msgstr "មិន​បាន​បង្កើត​ស្បែក​ឡើយ"

#: kthememanager.cpp:341
msgid "This theme does not contain a preview."
msgstr "ស្បែក​នេះ​មិន​មាន​ទិដ្ឋភាព​សម្រាប់​មើល​ជាមុន​ឡើយ ។"

#: kthememanager.cpp:345
#, qt-format
msgid "Author: %1<br />Email: %2<br />Version: %3<br />Homepage: %4"
msgstr "អ្នក​និពន្ធ ៖ %1<br>អ៊ីមែល ៖ %2<br>កំណែ ៖ %3<br>គេហទំព័រ ៖ %4"

