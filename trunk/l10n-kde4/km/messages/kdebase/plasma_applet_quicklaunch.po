#: icongrid.cpp:455
msgid "Quicklaunch"
msgstr "​ចាប់ផ្ដើម​រហ័ស"

#: icongrid.cpp:456
msgid "Add launchers by Drag and Drop or by using the context menu."
msgstr "បន្ថែម​កម្មវិធី​ចាប់ផ្ដើម ដោយ​អូស​ និង​ទម្លាក់​ ឬ​ដោយ​ប្រើម៉ឺនុយ​បរិបទ ។"

