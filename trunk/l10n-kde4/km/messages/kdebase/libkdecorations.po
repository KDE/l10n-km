#: kdecoration_plugins_p.cpp:109
msgid "Loading of window decoration plugin library disabled in configuration."
msgstr "ការ​បិទ​បណ្ណាល័យ​កម្មវិធី​ជំនួយ​តុបតែង​បង្អួច​បាន​បិទ​នៅ​ក្នុង​ការ​កំណត់​រចនាសម្ព័ន្ធ ។"

