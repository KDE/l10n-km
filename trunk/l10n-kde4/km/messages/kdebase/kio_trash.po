#: ktrash.cpp:34
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:36
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kfmclient move "
"'url' trash:/\""
msgstr ""
"កម្មវិធី​ជំនួយ​ក្នុង​ការ​ប្រើ​ធុង​សំរាម​របស់ KDE\n"
"ចំណាំ ៖ ដើម្បី​ផ្លាស់ទី​ឯកសារ​ទៅ​ធុង​សំរាម សូម​កុំប្រើ ktrash ប៉ុន្ដែ​ប្រើ \"kfmclient move 'url' "
"trash:/\""

#: ktrash.cpp:40
msgid "Empty the contents of the trash"
msgstr "សម្អាត​មាតិកា​របស់​ធុង​សំរាម"

#: ktrash.cpp:42
msgid "Restore a trashed file to its original location"
msgstr "ស្ដារ​ឯកសារដែលមានក្នុង​ធុង​សំរាម ទៅ​ទីតាំង​ដើម​របស់​វា"

#: ktrash.cpp:44
msgid "Ignored"
msgstr "មិនអើពើ"

#: kio_trash.cpp:52
msgid "Protocol name"
msgstr "ឈ្មោះ​ពិធីការ"

#: kio_trash.cpp:53 kio_trash.cpp:54
msgid "Socket name"
msgstr "ឈ្មោះ​រន្ធ"

#: kio_trash.cpp:102 kio_trash.cpp:165 kio_trash.cpp:313 kio_trash.cpp:345
#: kio_trash.cpp:509 kio_trash.cpp:521
#, kde-format
msgid "Malformed URL %1"
msgstr "URL %1 មិន​ត្រឹមត្រូវ"

#: kio_trash.cpp:121
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"ថត %1 លែង​មាន​តទៅ​ទៀត​ហើយ ដូច្នេះ​វា​មិន​អាច​ស្តារ​ធាតុ​នេះ​ទៅ​ទីតាំង​ដើម​របស់​វា​ឡើយ ។ អ្នក​អាច​បង្កើត​ថត​"
"នោះ​ឡើង​វិញ និង ប្រើ​ប្រតិបត្តិការ​ស្តារ​ឡើង​វិញ​ម្តងទៀត ឬ អូស​ធាតុទៅកន្លែង​ផ្សេង ដើម្បី​ស្ដារ​វា​ឡើង​វិញ ។"

#: kio_trash.cpp:150
msgid "This file is already in the trash bin."
msgstr "ឯកសារ​នេះ​មាន​នៅ​ក្នុង​ធុង​សំរាម​រួច​ហើយ ។"

