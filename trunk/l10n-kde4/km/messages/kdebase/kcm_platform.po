#: platform.cpp:39
msgid "Platform"
msgstr "វេទិកា"

#. i18n: file: platform.ui:20
#. i18n: ectx: property (windowTitle), widget (QWidget, PlatformThing)
#: rc.cpp:3
msgid "Platform Specific Configuration Module"
msgstr "ម៉ូឌុល​កំណត់​រចនាសម្ព័ន្ធ​ជាក់លាក់​របស់​វេទិកា"

