msgstr "ប្ដូរ​ទំហំ និង​បង្វិល​កម្មវិធី​ថាស​ប្រព័ន្ធ"

#: randrscreen.cpp:162
msgid "Confirm Display Setting Change"
msgstr "អះអាង​ប្ដូរ​ការ​កំណត់​ការ​បង្ហាញ"

#: randrscreen.cpp:166
msgid "&Accept Configuration"
msgstr "ព្រម​ទទួល​ការ​កំណត់​រចនាសម្ព័ន្ធ"

#: randrscreen.cpp:167
msgid "&Return to Previous Configuration"
msgstr "ត្រឡប់​ទៅ​ការ​កំណត់​រចនាសម្ព័ន្ធ​មុន "

#: randrscreen.cpp:169
msgid ""
"Your screen orientation, size and refresh rate have been changed to the "
"requested settings. Please indicate whether you wish to keep this "
"configuration. In 15 seconds the display will revert to your previous "
"settings."
msgstr ""
"ទិស ទំហំ និង​អត្រា​ធ្វើ​ឲ្យ​ស្រស់​នៃ​អេក្រង់​របស់​អ្នក ត្រូវ​បាន​ប្ដូរ​ទៅ​តាម​ការ​កំណត់​ដែល​បាន​ស្នើ ។ សូម​ចង្អុល​បង្ហាញ​"
"ថា​តើ អ្នក​ចង់​រក្សា​ការ​កំណត់​រចនាសម្ព័ន្ធ​នេះ​ឬ​ទេ ។ ក្នុង​រយៈពេល ១៥ វិនាទី ការ​បង្ហាញ​នឹង​ត្រឡប់​ទៅ​ការ​"
"កំណត់​មុន​វិញ ។"

