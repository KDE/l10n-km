#: main.cpp:38
msgid "Resize and Rotate System Tray App"
msgstr "ប្ដូរ​ទំហំ និង​បង្វិល​កម្មវិធី​ថាស​ប្រព័ន្ធ"

#: main.cpp:39
msgid "Maintainer"
