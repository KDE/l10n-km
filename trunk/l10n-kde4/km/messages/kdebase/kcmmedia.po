#: main.cpp:54
msgid "&Notifications"
msgstr "ការ​ជូនដំណឹង​"

#: main.cpp:60
msgid "&Advanced"
msgstr "កម្រិត​ខ្ពស់"

#: main.cpp:67
msgid "Storage Media"
msgstr "ឧបករណ៍​ផ្ទុក"

#: main.cpp:69
msgid "Storage Media Control Panel Module"
msgstr "មូ៉ឌុល​បន្ទះ​បញ្ជា​ឧបករណ៍​ផ្ទុក"

