#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 101
#: rc.cpp:33
msgid "&Delete"
msgstr "លុប​"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 104
#: rc.cpp:36
msgid "Click here to delete the selected action if possible."
msgstr "ចុច​ទីនេះ​ដើម្បីលុប​សកម្មភាពដែល​បាន​ជ្រើស បើ​អាចធ្វើ​បាន​ ។"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 112
#: rc.cpp:39
msgid "&Edit..."
msgstr "កែសម្រួល..."

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 115
#: rc.cpp:42
msgid "Click here to edit the selected action if possible."
msgstr "ចុច​ទីនេះ​ដើម្បី​កែសម្រួល​សកម្មភាព​ដែល​បាន​ជ្រើស បើ​អាចធ្វើ​បាន​ ។"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 123
#: rc.cpp:45
msgid "&Toggle as Auto Action"
msgstr "បិទ ឬ​បើក​អំពើ​ស្វ័យប្រវត្តិ"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 126
#: rc.cpp:48
msgid ""
"Click here to perform automaticly this action on detection of the selected "
"medium type (this option is disabled when \"All Mime Types\" is selected)."
msgstr "ចុច​ទី​នេះ​ដើម្បី​អនុវត្ត​សកម្មភាព​នេះ​ស្វ័យប្រវត្តិ ពេល​រក​ឃើញ​ប្រភេទ​ឧបករណ៍​ផ្ទុកដែល​បាន​ជ្រើស (ជម្រើស​នេះ​មិន​ត្រូវ​បាន​អនុញ្ញាត​នៅពេល\"ប្រភេទ Mime ទាំងអស់\" ត្រូវ​បាន​ជ្រើស) ។"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 153
#: rc.cpp:51
msgid ""
"Here is the list of the available actions. You can modify them by using the "
"buttons on your right."
msgstr "នេះ​ជា​បញ្ជី​អំពើ​​ដែល​អាច​ប្រើ​បាន ។ អ្នក​អាច​កែសម្រួល​ពួកវា​ដោយ​ប្រើ​ប៊ូតុង​ខាង​ស្ដាំរបស់​អ្នក ។"

