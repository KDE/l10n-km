msgstr "ប្រភេទ Mime ទាំងអស់"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 24
#: rc.cpp:3
msgid "Enable HAL backend"
msgstr "អនុញ្ញាត HAL ផ្នែក​ក្រោយ"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 27
#: rc.cpp:6
msgid ""
"Select this if you want to enable the Hardware Abstraction Layer (http://hal."
"freedesktop.org/wiki/Software/hal) support."
msgstr ""
"ជ្រើស​វា​នេះ ប្រសិនបើ​អ្នក​ចង់​អនុញ្ញាតឲ្យ​មាន​ការ​គាំទ្រ Hardware Abstraction Layer (http://"
"hal.freedesktop.org/wiki/Software/hal) ។"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 35
#: rc.cpp:9
msgid "Enable CD polling"
msgstr "អាច​ច្រឹប CD"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 38
#: rc.cpp:12
msgid "Select this to enable the CD polling."
msgstr "ជ្រើស​វា​នេះ ដើម្បី​អាច​ច្រឹប CD ។"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 46
#: rc.cpp:15
msgid "Enable medium application autostart after mount"
msgstr "អនុញ្ញាត​ឲ្យ​កម្មវិធី​របស់​ឧបករណ៍​ផ្ទុក​ចាប់ផ្តើម​ដោយ​ស្វ័យប្រវត្តិ បន្ទាប់​ពី​ម៉ោនរួច"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 49
#: rc.cpp:18
msgid ""
"Select this if you want to enable application autostart after mounting a "
"device."
msgstr "ជ្រើស​វា បើ​អ្នក​ចង់​អនុញ្ញាត​ឲ្យ​កម្មវិធី​ចាប់ផ្តើម​ដោយ​ស្វ័យ​ប្រវត្តិ បន្ទាប់​ពី​ម៉ោន​ឧបករណ៍រួច ។"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 48
#: rc.cpp:21
msgid "Medium types:"
msgstr "ប្រភេទ​ឧបករណ៍ ៖"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 64
#: rc.cpp:24
msgid ""
"Here is the list of the availables type of medium which can be monitored. "
"You can filter the availables action by selecting a kind of medium. If you "
"want to see all the actions, select \"All Mime Types\"."
msgstr ""
"នៅទីនេះ​មាន​បញ្ជី​ប្រភេទ​ឧបករណ៍​ផ្ទុក​ដែល​អាច​រក​បាន​ឧបករណ៍​ដែល​បាន​ម៉ោនរួច ។ "
"អ្នកអាច​ត្រង​យកអំពើ​ដែល​អាច​រក​បាន​ដោយ​គ្រាន់​តែ​ជ្រើស​ប្រភេទ​ឧបករណ៍​ផ្ទុក​ជាការស្រេច ។ "
"បើ​អ្នក​ចង់​មើល​អំពើ​ទាំងអស់ ជ្រើស​  \"ប្រភេទ Mime ទាំងអស់\" ។"

