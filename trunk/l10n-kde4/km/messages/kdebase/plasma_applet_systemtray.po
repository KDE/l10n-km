#: ui/applet.cpp:444
msgid "Information"
msgstr "ព័ត៌មាន"

#: ui/applet.cpp:446
msgid "Choose which information to show"
msgstr "ជ្រើស​ព័ត៌មាន​ណាមួយ​ដែល​អ្នកចង់​បង្ហាញ"

#: ui/applet.cpp:447
msgid "Auto Hide"
msgstr "លាក់​ដោយ​ស្វ័យ​ប្រវត្តិ"

#: ui/applet.cpp:494
msgctxt "Item will be automatically shown or hidden from the systray"
msgid "Auto"
msgstr "ោយ​ស្វ័យ​ប្រវត្តិ"

#: ui/applet.cpp:495
msgctxt "Item is never visible in the systray"
msgid "Hidden"
msgstr "ដែល​បានលាក់"

#: ui/applet.cpp:496
msgctxt "Item is always visible in the systray"
msgid "Always Visible"
msgstr "តែងតែ​មើលឃើញជា​និច្ច"

#: ui/applet.cpp:514
msgctxt "Categories of items in the systemtray that will be shown or hidden"
msgid "Shown item categories"
msgstr "បង្ហាញ​ប្រភេទ​ធាតុ"

#: ui/applet.cpp:517
msgctxt "Systemtray items that describe the status of a generic application"
msgid "Application status"
msgstr "ស្ថានភាព​កម្មវិធី"

#: ui/applet.cpp:527
msgctxt "Items communication related, such as chat or email clients"
msgid "Communications"
msgstr "ការ​ទំនាក់ទំនង"

#: ui/applet.cpp:537
msgctxt "Items about the status of the system, such as a filesystem indexer"
msgid "System services"
msgstr "សេវា​ប្រព័ន្ធ"

#: ui/applet.cpp:547
msgctxt "Items about hardware, such as battery or volume control"
msgid "Hardware control"
msgstr "ការ​ត្រួតពិនិត្យ​ផ្នែក​រឹង"

#: ui/applet.cpp:557
msgctxt "Other uncategorized systemtray items"
msgid "Miscellaneous"
msgstr "ផ្សេងៗ"

#: ui/applet.cpp:576
msgctxt ""
"Extra items to be manually added in the systray, such as little Plasma "
"widgets"
msgid "Extra items"
msgstr "ធាតុ​បន្ថែម"

#: ui/taskarea.cpp:609
msgid "Hide icons"
msgstr "លាក់​រូបតំណាង"

#: ui/taskarea.cpp:611
msgid "Show hidden icons"
msgstr "បង្ហាញ​រូបតំណាង​ដែលបាន​លាក់"

#. i18n: file: ui/autohide.ui:36
#. i18n: ectx: property (text), widget (QTreeWidget, icons)
#: rc.cpp:3
msgid "1"
msgstr "១"

#. i18n: file: ui/autohide.ui:41
#. i18n: ectx: property (text), widget (QTreeWidget, icons)
#: rc.cpp:6
msgid "2"
msgstr "២"

#. i18n: file: ui/visibleitems.ui:20
#. i18n: ectx: property (text), widget (QLabel, unlockLabel)
#: rc.cpp:9
msgid ""
"Widgets are currently locked. To change which items are shown, please unlock "
"the widgets first."
msgstr ""
"ធាតុក្រាហ្វិក​បច្ចុប្បន្ន​ជាប់សោ ។ ដើម្បី​ផ្លាស់ប្ដូរ​ធាតុក្រាហ្វិក​ណាមួយ​ដែល​ត្រូវ​បង្ហាញ សូម​ដោះសោ​ធាតុក្រាហ្វិក​"
"នោះ​សិន ។"

#. i18n: file: ui/visibleitems.ui:30
#. i18n: ectx: property (text), widget (QPushButton, unlockButton)
#: rc.cpp:12
msgid "Unlock widgets"
msgstr "ដោះសោ​ធាតុក្រាហ្វិក"
