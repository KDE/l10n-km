#: ui/applet.cpp:142
msgid "No notifications and no jobs"
msgstr "គ្មាន​ការ​ជូនដំណឹង និង​គ្មានការងារ"

#: ui/applet.cpp:311
msgid "Visible icons:"
msgstr "រូបតំណាង​ដែលមើល​ឃើញ ៖"

#: ui/applet.cpp:312
msgid "Hidden icons:"
msgstr "រូបតំណាង​ដែល​បានលាក់ ៖"

#: ui/extendertask.cpp:77
msgid "Show or hide notifications and jobs"
msgstr "បង្ហាញ ឬ​លាក់​កា​រជូនដំណឹង និង​ការងារ"

#: ui/extendertask.cpp:105
msgid "toggle visibility of notifications and jobs"
msgstr "បិទ/បើក​ភាព​មើលឃើញ​​នៃ​ការ​ជូនដំណឹង និង​ការងារ"

#: ui/jobwidget.cpp:76
msgid "Pause job"
msgstr "ផ្អាក​ការងារ"

#: ui/jobwidget.cpp:86
msgid "Resume job"
msgstr "បន្ត​ការងារ"

#: ui/jobwidget.cpp:96
msgid "Cancel job"
msgstr "បោះបង់​ការ​ងារ"

#: ui/jobwidget.cpp:160
#, kde-format
msgctxt ""
"%1 is the name of the job, can be things like Copying, deleting, moving"
msgid "(paused) %1"
msgstr "(បាន​ផ្អាក) %1"

#: ui/jobwidget.cpp:164
#, kde-format
msgctxt ""
"%1 is the name of the job, can be things like Copying, deleting, moving"
msgid "(finished) %1"
msgstr "(បាន​បញ្ចប់) %1"

#: ui/notificationwidget.cpp:137
#, kde-format
msgid "Notification from %1"
msgstr "ការ​ជូនដំណឹង​ពី %1"
