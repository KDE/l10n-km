#: kio_nepomuksearch.cpp:71
msgid "Query folder"
msgstr "ថត​សំណួរ"

#: kio_nepomuksearch.cpp:145
msgid ""
"The Nepomuk system is not activated. Unable to answer queries without it."
msgstr "ប្រព័ន្ធ Nepomuk មិនត្រូវ​បាន​​ធ្វើ​ឲ្យ​សកម្មទេ ។ មិនអាច​ឆ្លើយ​នឹង​សំណួរ​ដោយ​គ្មាន​វា​ទេ ។"

#: kio_nepomuksearch.cpp:151
msgid ""
"The Nepomuk query service is not running. Unable to answer queries without "
"it."
msgstr "សេវា​សំណួរ​របស់ Nepomuk មិន​កំពុង​រត់​ទេ ។ មិនអាច​ឆ្លើយ​នឹង​សំណួរ​ដោយ​គ្មាន​វា​បានទេ ។"

#: kio_nepomuksearch.cpp:261
msgid "Desktop Queries"
msgstr "សំណួរ​ផ្ទៃតុ"

#: kio_nepomuksearch.cpp:447
msgid "Saved Query"
msgstr "សំណួរ​ដែលបានរក្សាទុក"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, អេង វណ្ណៈ, អោក ពិសិដ្ឋ"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
