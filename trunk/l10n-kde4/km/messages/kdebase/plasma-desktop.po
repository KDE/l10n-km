#: activity.cpp:113
#, kde-format
msgctxt "%1 is the name of the activity"
msgid "Do you really want to remove %1?"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​យក %1 ចេញ​ឬ ?"

#: activity.cpp:114
#, kde-format
msgctxt "@title:window %1 is the name of the activity"
msgid "Remove %1"
msgstr "យក %1 ចេញ"

