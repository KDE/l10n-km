msgstr "កា​រកំណត់​ផ្សេងៗ​ទៀត"

#: panelcontroller.cpp:513
msgid "Maximize Panel"
msgstr "បន្ទះ​អតិបរមា"

#: panelcontroller.cpp:519
msgid "Close this configuration window"
msgstr "បិទ​បង្អួច​កំណត់រចនា​សម្ព័ន្ធ​នេះ"

#: panelcontroller.cpp:569
msgid "Add Spacer"
msgstr "បន្ថែម​កម្មវិធី​ដាក់ចន្លោះ"

#: panelcontroller.cpp:696
msgid "Width"
msgstr "ទទឹង"

#: panelcontroller.cpp:699
msgid "Top"
msgstr "កំពូល"

#: panelcontroller.cpp:700
msgid "Bottom"
msgstr "បាត"

#: plasmaapp.cpp:175
msgid "Show Dashboard"
msgstr "បង្ហាញផ្ទាំងគ្រប់គ្រង"

#: plasmaapp.cpp:500
msgid "Add Activity"
msgstr "បន្ថែម​សកម្មភាព"

#: plasmaapp.cpp:509
msgid "Zoom Out"
msgstr "បង្រួម"

#: plasmaapp.cpp:893
msgid "Different activity for each desktop"
msgstr "សកម្មភាព​ខុសគ្នា​សម្រាប់​ផ្ទៃតុ​នីមួយៗ"

#: plasmaapp.cpp:898
msgid "Use a separate dashboard"
msgstr "ប្រើ​ផ្ទាំង​គ្រប់គ្រង​ដោយ​ឡែក​"

#: positioningruler.cpp:462
msgid "Move this slider to set the panel position"
msgstr "ផ្លាស់ទី​គ្រាប់រំកិល​នេះ​ ដើម្បី​កំណត់​ទីតាំង​បន្ទះ"

#: positioningruler.cpp:465
msgid "Move this slider to set the maximum panel size"
msgstr "ផ្លាស់ទី​គ្រប់រំកិល​នេះ​ដើម្បី​កំណត់​ទំហំ​បន្ទះ​អតិបរមា"

#: positioningruler.cpp:468
msgid "Move this slider to set the minimum panel size"
msgstr "ផ្លាស់ទី​គ្រាប់រំកិលនេះ​ដើម្បី​កំណត់​ទំហំ​បន្ទះ​អប្បបរមា"

