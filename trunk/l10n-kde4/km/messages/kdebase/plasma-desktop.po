#: backgrounddialog.cpp:371
msgid "Desktop Settings"
msgstr "កា​រកំណត់​ផ្ទៃតុ"

#: backgrounddialog.cpp:386
msgid ""
"This picture of a monitor contains a preview of what the current settings "
"will look like on your desktop."
msgstr ""
"រូបភាព​​របស់​មូនីទ័រ​នេះ​មាន​កា​រមើលជា​មុន​នូវ​ការ​កំណត់​បច្ចុប្បន្ន​នឹង​មាន​រូបរាង​យ៉ាង​ដូចម្ដេច​​នៅ​លើ​ផ្ទៃតុ​របស់​"
"អ្នក ។"

#: backgrounddialog.cpp:408
msgid "Appearance"
msgstr "រូបរាង"

#: dashboardview.cpp:63
msgid "Hide Dashboard"
msgstr "លាក់ផ្ទាំង​គ្រប់គ្រង"

#: dashboardview.cpp:95
msgid "Widget Dashboard"
msgstr "ផ្ទាំង​គ្រប់គ្រង​ធាតុ​ក្រាហ្វិក"

#: dashboardview.cpp:142 plasmaapp.cpp:554
msgid "Add Widgets"
msgstr "បន្ថែម​ធាតុ​ក្រាហ្វិក"

#: desktopcorona.cpp:127
msgid "Desktop"
msgstr "ផ្ទៃតុ"

#: desktopview.cpp:88
msgid "Next Activity"
msgstr "សកម្មភាព​បន្ទាប់"

#: desktopview.cpp:92
msgid "Previous Activity"
msgstr "សកម្មភាព​មុន"

#: main.cpp:29
msgid "The KDE desktop, panels and widgets workspace application."
msgstr "ផ្ទៃតុ KDE កម្មវិធី​របស់​តំបន់​ធ្វើការ​ធាតុ​ក្រាហ្វិក និង​បន្ទះ ។"

#: main.cpp:35
msgid "Plasma Workspace"
msgstr "តំបន់​ធ្វើការ​របស់​ប្លាស្មា"

#: main.cpp:37
msgid "Copyright 2006-2009, The KDE Team"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៦-២០០៩ ដោយ​ក្រុម KDE"

#: main.cpp:38
msgid "Aaron J. Seigo"
msgstr "Aaron J. Seigo"

#: main.cpp:39
msgid "Author and maintainer"
msgstr "​អ្នក​និពន្ធ និង​អ្នក​ថែទាំ​"

#: main.cpp:41
msgid "John Lions"
msgstr "John Lions"

#: main.cpp:42
msgid "In memory of his contributions, 1937-1998."
msgstr "នៅ​ក្នុង​ការ​ចងចាំ​​នៃ​កា​រចែកចាយ​របស់ ១៩៣៧-១៩៩៨ ។"

