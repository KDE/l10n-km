#: kio_nfs.cpp:991
msgid "Filename too long"
msgstr "ឈ្មោះ​ឯកសារ​វែង​ពេក"

#: kio_nfs.cpp:998
msgid "Disk quota exceeded"
msgstr "លើស​កូតា​ថាស​"
