#: desktopthemedetails.cpp:290 desktopthemedetails.cpp:430 rc.cpp:3
msgid "Desktop Theme Details"
msgstr "សេចក្ដី​លម្អិត​ស្បែក​ផ្ទៃតុ"

#: desktopthemedetails.cpp:405 desktopthemedetails.cpp:420
#: desktopthemedetails.cpp:481 desktopthemedetails.cpp:560
#: desktopthemedetails.cpp:593
msgid "(Customized)"
msgstr "(ផ្ទាល់ខ្លួន)"

#: desktopthemedetails.cpp:420
msgid "User customized theme"
msgstr "ស្បែក​ផ្ទាល់ខ្លួន​របស់​អ្នក​ប្រើ"

#: desktopthemedetails.cpp:430
msgid "Unable to save theme."
msgstr "មិនអាច​រក្សាទុក​ស្បែក​បានទេ ។"

#: desktopthemedetails.cpp:442
#, kde-format
msgid ""
"To change your desktop theme to \"%1\", open\n"
"Desktop Settings and select \"%2\" from the droplist."
msgstr ""
"ដើម្បី​ផ្លាស់ប្ដូរ​ស្បែក​ផ្ទៃតុ​របស់​អ្នក​ទៅ \"%1\" បើក\n"
"កា​រកំណត់​ផ្ទៃតុ ហើយ​​ជ្រើស \"%2\" ពី​បញ្ជី​ទម្លាក់ចុះ ។"

#: desktopthemedetails.cpp:442
msgid "How to Change Desktop Theme"
msgstr "វិធី​ផ្លាស់ប្ដូរ​ស្បែក​ផ្ទៃតុ"

#: desktopthemedetails.cpp:453
#, kde-format
msgid ""
"Theme items have been changed.  Do you still wish remove the \"%1\" theme?"
msgstr "ធាតុ​ស្បែក​ត្រូវ​បាន​ផ្លាស់ប្ដូរ ។  តើ​អ្នកនៅ​តែ​ចង់​យកស្បែក \"%1\" ចេញ​ឬ ?"

#: desktopthemedetails.cpp:453 desktopthemedetails.cpp:458
#: desktopthemedetails.cpp:461
msgid "Remove Desktop Theme"
msgstr "យក​ស្បែក​ផ្ទៃតុ​ចេញ"

#: desktopthemedetails.cpp:458
msgid "Removal of the default KDE theme is not allowed."
msgstr "មិនអនុញ្ញាត​ឲ្យ​​យក​ស្បែក​របស់ KDE លំនាំដើម​​ចេញ​​ទេ ។"

#: desktopthemedetails.cpp:461
#, kde-format
msgid "Are you sure you wish remove the \"%1\" theme?"
msgstr "តើ​អ្នក​ប្រាកដ​ជា​ចង់​យកស្បែក \"%1\" ចេញឬ ?"

#: desktopthemedetails.cpp:482
msgid ""
"Please apply theme item changes (with a new theme name) before attempting to "
"export theme."
msgstr "សូម​អនុវត្ត​ការ​ផ្លាស់ប្ដូរ​ធាតុ (ជា​មួយ​នឹង​ឈ្មោះ​ស្បែក​ថ្មី) មុននឹង​ប៉ុនប៉ង​នាំចេញ​ស្បែក ។"

#: desktopthemedetails.cpp:482
msgid "Export Desktop Theme"
msgstr "នាំចេញ​ស្បែក​ផ្ទៃតុ"

#: desktopthemedetails.cpp:498
msgid "Export theme to file"
msgstr "នាំចេញ​ស្បែក​ទៅ​កាន់ឯកសារ"

#: desktopthemedetails.cpp:533
msgid "Theme Item"
msgstr "ធាតុ​ស្បែក"

#: desktopthemedetails.cpp:533
msgid "Source"
msgstr "ប្រភព"

#: desktopthemedetails.cpp:594
#, kde-format
msgid "%1 %2"
msgstr "%1 %2"

#: desktopthemedetails.cpp:603 desktopthemedetails.cpp:621
msgid "File..."
msgstr "ឯកសារ..."

#: desktopthemedetails.cpp:623
#, kde-format
msgid "Select File to Use for %1"
msgstr "ជ្រើស​ឯកសារ​ត្រូវ​ប្រើ​សម្រាប់ %1"

#: desktopthemedetails.cpp:660
#, kde-format
msgid " Author: %1"
msgstr " អ្នកនិពន្ធ ៖ %1"

#: desktopthemedetails.cpp:667
#, kde-format
msgid "Version: %1"
msgstr "កំណែ ៖ %1"

