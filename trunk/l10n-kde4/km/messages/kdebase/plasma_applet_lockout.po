msgid "Start a parallel session as a different user"
msgstr "ចាប់ផ្ដើម​សម័យ​ដំណាលគ្នា​ជា​អ្នកប្រើ​ផ្សេង"

#: lockout.cpp:399
msgid "Leave..."
msgstr "ចេញ..."

#: lockout.cpp:399
msgid "Logout, turn off or restart the computer"
msgstr "ចេញ បិទ​ ឬ​ចាប់ផ្ដើម​កុំព្យូទ័រ​ឡើង​វិញ"

#: lockout.cpp:407
