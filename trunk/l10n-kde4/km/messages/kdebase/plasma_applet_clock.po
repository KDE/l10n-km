#. i18n: tag string
#. i18n: file clockConfig.ui line 24
#: rc.cpp:3
msgid "Appearance"
msgstr "បង្ហាញ​វិនាទី​ជា​រូបដៃ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 35
#: rc.cpp:6
msgid "Show the seconds"
msgstr "គូស​ធីក​វា ប្រសិន​បើ​អ្នកចង់​បង្ហាញ​វិនាទី​ជា​រូបដៃ ដើម្បី​មើល​វិនាទី ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 38
#: rc.cpp:9
msgid "Check this if you want to show the seconds."
msgstr "បង្ហាញ​វិនាទី"

#. i18n: tag string
#. i18n: file clockConfig.ui line 41
#: rc.cpp:12
msgid "Show &seconds"
msgstr "បង្ហាញ​ពេលវេលា​ជា​ខ្សែអក្សរ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 48
#: rc.cpp:15
msgid "Show the time in text"
msgstr "គូស​ធីកវា ប្រសិន​បើ​អ្នក​ចង់​បង្ហាញ​ពេលវេលា​ជា​ខ្សែអក្សរ​នៅ​ក្នុង​នាឡិកា ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 51
#: rc.cpp:18
#| msgid "Check this if you want to show the time as a text within the clock."
msgid "Check this if you want to display the time as text within the clock."
msgstr "ពិនិត្យ​មើល​ថាតើ​អ្នក​ចង់​បង្ហាញ​ពេលវេលា​ជា​អត្ថបទ​នៅ​ក្នុង​នាឡិកា​ឬ​អត់ ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 54
#: rc.cpp:21
#| msgid "Also show the time in text"
msgid "Also show the time as text"
msgstr "បង្ហាញ​ពេលវេលា​ជា​អត្ថបទ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 66
#: rc.cpp:24
msgid "Timezones"
msgstr "តំបន់​ពេលវេលា"

#. i18n: tag string
#. i18n: file clockConfig.ui line 77
#: rc.cpp:27
msgid "Use &local timezone"
msgstr "ប្រើ​តំបន់​ពេលវេលា​មូលដ្ឋាន"

#. i18n: tag string
#. i18n: file clockConfig.ui line 91
#: rc.cpp:30
msgid "Area"
msgstr "ផ្ទៃ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 96
#: rc.cpp:33
msgid "Region"
msgstr "តំបន់"

#. i18n: tag string
#. i18n: file clockConfig.ui line 101
#: rc.cpp:36
msgid "Comment"
msgstr "សេចក្ដី​អធិប្បាយ"

