#: main.cpp:171
msgid "No Action"
msgstr "គ្មាន​សកម្មភាព"

#: main.cpp:172
msgid "Show Dashboard"
msgstr "បង្ហាញ​ផ្ទាង​គ្រប់គ្រង"

#: main.cpp:187
msgid "All Desktops"
msgstr "ផ្ទៃតុ​ទាំងអស់"

#: main.cpp:188
msgid "Current Desktop"
msgstr "ផ្ទៃតុ​បច្ចុប្បន្ន"

#: main.cpp:212
msgid "Cube"
msgstr "គូប"

#: main.cpp:213
msgid "Cylinder"
msgstr "ស៊ីឡាំង"

#: main.cpp:214
msgid "Sphere"
msgstr "ស្វ៊ែរ"

#. i18n: file: main.ui:20
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:3 rc.cpp:45
msgid "Other Settings"
msgstr "ការ​កំណត់​ផ្សេងៗ"

#. i18n: file: main.ui:29
#. i18n: ectx: property (toolTip), widget (QLabel, desktopSwitchLabel)
#: rc.cpp:6 rc.cpp:48
msgid ""
"Change desktop when the mouse cursor is pushed against the edge of the screen"
msgstr "ផ្លាស់ប្ដូរ​ផ្ទៃតុ នៅពេលចុច​​​ទស្សន៍​ទ្រនិច្ច​កណ្ដុរ​​នៅ​ជ្រុង​របស់​អេក្រង់"

#. i18n: file: main.ui:32
#. i18n: ectx: property (text), widget (QLabel, desktopSwitchLabel)
#: rc.cpp:9 rc.cpp:51
msgid "&Switch desktop on edge:"
msgstr "ប្ដូរ​ផ្ទៃតុ​នៅគែ​ម ៖"

#. i18n: file: main.ui:46
#. i18n: ectx: property (text), item, widget (QComboBox, desktopSwitchCombo)
#: rc.cpp:12 rc.cpp:54
msgid "Disabled"
msgstr "បាន​បិទ"

#. i18n: file: main.ui:51
#. i18n: ectx: property (text), item, widget (QComboBox, desktopSwitchCombo)
#: rc.cpp:15 rc.cpp:57
msgid "Only When Moving Windows"
msgstr "តែ​នៅពេល​ផ្លាស់ទី​បង្អួច​ប៉ុណ្ណោះ"

#. i18n: file: main.ui:56
#. i18n: ectx: property (text), item, widget (QComboBox, desktopSwitchCombo)
#: rc.cpp:18 rc.cpp:60
msgid "Always Enabled"
msgstr "បើក​ជា​និច្ច"

#. i18n: file: main.ui:64
#. i18n: ectx: property (toolTip), widget (QLabel, label)
#: rc.cpp:21 rc.cpp:63
msgid ""
"Amount of time required for the mouse cursor to be pushed against the edge "
"of the screen before the action is triggered"
msgstr "ចំនួន​ពេលវេលា​ដែល​ត្រូវ​ការ​សម្រាប់​ចុច​ទស្សន៍ទ្រនិច្ច​លើ​ជ្រុង​នៃ​អេក្រង់​មុននឹង​សកម្មភាពត្រូវ​បាន​កេះ"

#. i18n: file: main.ui:67
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:24 rc.cpp:66
msgid "Activation &delay:"
msgstr "ការ​ពន្យារ​កា​រធ្វើ​ឲ្យ​សកម្ម ៖"

#. i18n: file: main.ui:80
#. i18n: ectx: property (suffix), widget (QSpinBox, activationDelaySpin)
#. i18n: file: main.ui:118
#. i18n: ectx: property (suffix), widget (QSpinBox, triggerCooldownSpin)
#. i18n: file: main.ui:80
#. i18n: ectx: property (suffix), widget (QSpinBox, activationDelaySpin)
#. i18n: file: main.ui:118
#. i18n: ectx: property (suffix), widget (QSpinBox, triggerCooldownSpin)
#: rc.cpp:27 rc.cpp:36 rc.cpp:69 rc.cpp:78
msgid " ms"
msgstr " មិល្លីវិនាទី"

#. i18n: file: main.ui:99
#. i18n: ectx: property (toolTip), widget (QLabel, label_2)
#: rc.cpp:30 rc.cpp:72
msgid ""
"Amount of time required after triggering an action until the next trigger "
"can occur"
msgstr "ចំនួន​ពេលវេលា​ដែល​ត្រូវការ​សម្រាប់កេះ​សកម្មភាព រហូត​ដល់​ការ​កេះ​លើកក្រោយ​កើត​ឡើង"

#. i18n: file: main.ui:102
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:33 rc.cpp:75
msgid "&Reactivation delay:"
msgstr "​ពន្យារ​កា​រធ្វើ​ឲ្យ​សកម្ម​ឡើង​វិញ ៖"

#. i18n: file: main.ui:163
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: rc.cpp:39 rc.cpp:81
msgid "Active Screen Edge Actions"
msgstr "សកម្មភាព​គែម​អេក្រង់​សកម្ម"

#. i18n: file: main.ui:182
#. i18n: ectx: property (text), widget (QLabel, label_7)
#: rc.cpp:42 rc.cpp:84
msgid ""
"To trigger an action push your mouse cursor against the edge of the screen "
"in the action's direction."
msgstr "ដើម្បីកេះ​សកម្មភាព​ចុចកណ្ដុររបស់​អ្នក​នៅ​គែម​អេក្រង់​នៅ​ក្នុង​ទិស​សកម្មភាព ។"
