msgid "Clears the content of the selected cells"
msgstr "សម្អាត​មាតិកា​ក្រឡា​ដែលបានជ្រើស"

#: kwordquiz.cpp:185
msgid "&Insert Row"
msgstr "បញ្ចូល​ជួរ​ដេក"

#: kwordquiz.cpp:187
msgid "Inserts a new row above the current row"
