msgid "&Mark as Blank"
msgstr "សម្គាល់​ថា​ទទេ"

#: kwordquiz.cpp:205
msgid "Marks the current or selected word as a blank for Fill-in-the-blank"
msgstr "សម្គាល់​ពាក្យ​បច្ចុប្បន្ន ឬ ពាក្យ​ដែលបានជ្រើស​ថា​ជា​ទទេ សម្រាប់​ការបំពេញ​ចន្លោះ​ទទេ"

