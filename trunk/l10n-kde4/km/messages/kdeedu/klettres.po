#: klettres.cpp:152
msgid ""
"The file sounds.xml was not found in\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"Please install this file and start KLettres again.\n"
"\n"
msgstr ""
"បាន​រកឃើញ​ឯកសារ​សម្លេង sounds.xml នៅក្នុង\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"សូម​ដំឡើង​ឯកសារ​នេះ ហើយ ចាប់ផ្ដើម KLettres ។\n"
"\n"

#: klettres.cpp:174
msgid "New Sound"
msgstr "សម្លេងថ្មី"

#: klettres.cpp:178
msgid "Play a new sound"
msgstr "ចាក់​សម្លេង​ថ្មី"

#: klettres.cpp:179
msgid ""
"You can play a new sound by clicking this button or using the File menu, New "
"Sound."
msgstr "អ្នក​អាច​ចាក់​សម្លេង​ថ្មី ដោយ​ចុច​ប៊ូតុង​នេះ ឬ ប្រើ​ម៉ឺនុយ​ឯកសារ សម្លេងថ្មី ។"

#: klettres.cpp:182
msgid "Get Alphabet in New Language..."
msgstr "យក​អក្សរ​ក្រម​ជា​ភាសា​ថ្មី..."

#: klettres.cpp:186
msgid "Replay Sound"
msgstr "ចាក់​សម្លេង​ម្ដងទៀត"

#: klettres.cpp:189
msgid "Play the same sound again"
msgstr "ចាក់​សម្លេង​ដូចគ្នា​ម្ដងទៀត"

#: klettres.cpp:191
msgid ""
"You can replay the same sound again by clicking this button or using the "
"File menu, Replay Sound."
msgstr ""
"អ្នកអាច​ចាក់​សម្លេង​ដូច​គ្នា​ម្ដង​ទៀត​ដោយចុច​ប៊ូតុង​នេះ ឬ ដោយប្រើ​ម៉ឺនុយ ឯកសារ ចាក់​សម្លេង​ម្ដងទៀត ។"

#: klettres.cpp:195
#, fuzzy
msgid "Show &Menubar"
msgstr "បង្ហាញ​របារ​ម៉ឺនុយ"

#: klettres.cpp:199
msgid "Hide &Menubar"
msgstr "លាក់​ របារ​ម៉ឺនុយ"

#: klettres.cpp:201
msgid "You can show or hide the menubar as you wish by clicking this button."
msgstr "អ្នក​អាច​បង្ហាញ ឬ លាក់​របារ​ម៉ឺនុយ​ ទៅតាម​ដែលអ្នក​ចង់ ដោយចុច​ប៊ូតុង​នេះ ។"

#: klettres.cpp:204
msgid "L&evel"
msgstr "កម្រិត"

#: klettres.cpp:205
msgid "Select the level"
msgstr "ជ្រើស​កម្រិត"

#: klettres.cpp:206
msgid ""
"You can select the level: level 1 displays a letter and you hear it; level 2 "
"does not display the letter, you only hear it; level 3 displays a syllable "
"and you hear it; level 4 does not display the syllable, you only hear it."
msgstr ""
"អ្នក​អាច​ជ្រើស​កម្រិត ៖ កម្រិត ១ បង្ហាញ​អក្សរ​មួយ ហើយ ឮ​វា ។ កម្រិត ២ មិនបង្ហាញ​អក្សរ​ទេ ប៉ុន្តែ​អ្នក​"
"បានតែ​ឮទេ ។ កម្រិត ៣ បង្ហាញព្យាង្គ ហើយ​ឮវា ។ កម្រិត ៤ មិនបង្ហាញ​ព្យាង្គ​ទេ ប៉ុន្តែអ្នក​ឮវា ។"

