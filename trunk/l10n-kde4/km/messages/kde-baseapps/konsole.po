#: main.cpp:163
msgid "Create a new tab in an existing window rather than creating a new window"
msgstr "បង្កើត​ផ្ទាំង​ថ្មី​នៅ​ក្នុង​បង្អួច​ដែល​មាន​ស្រាប់​ ប្រសើរ​ជាង​បង្កើត​បង្អួច​ថ្មី"

#: main.cpp:166
msgid "Create tabs as specified in given tabs configuration file"
msgstr "បង្កើត​ផ្ទាំង​ដូច​បានបញ្ជាក់​នៅ​ក្នុង​ឯកសារ​កំណត់​រចនាសម្ព័ន្ធ​ផ្ទាំង​ដែល​បាន​ផ្ដល់"

#: main.cpp:169
#| msgid ""
#| "Start Konsole in the background and bring to the front when the F12 key "
#| "is pressed"
