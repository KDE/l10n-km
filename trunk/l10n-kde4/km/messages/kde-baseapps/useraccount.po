#: main.cpp:107
msgid ""
"<qt>Here you can change your personal information, which will be used, for "
"instance, in mail programs and word processors. You can change your login "
"password by clicking <em>Change Password...</em>.</qt>"
msgstr ""
"<qt>ទីនេះ​អ្នក​អាច​ផ្លាស់ប្ដូរ​​ព័ត៌មាន​ផ្ទាល់ខ្លួន​របស់​អ្នក ដែល​នឹង​ប្រើ​ក្នុង​កម្មវិធី​អ៊ីមែល និង​កម្មវិធី​វាយ​អត្ថបទ "
"។ អ្នក​អាច​ផ្លាស់ប្ដូរ​ពាក្យ​សម្ងាត់​ចូល​របស់​អ្នក​ដោយ​ចុច <em>ផ្លាស់ប្ដូរ​ពាក្យ​សម្ងាត់...</em> ។</qt>"

#: main.cpp:121
msgid ""
"A program error occurred: the internal program 'kdepasswd' could not be "
"found. You will not be able to change your password."
msgstr ""
"កំហុស​កម្មវិធី​បាន​កើតឡើង ៖ រក​មិន​ឃើញ​កម្មវិធី​ខាង​ក្នុង \"kdepasswd\" ។ អ្នក​មិន​អាច​ផ្លាស់​ប្ដូរ​ពាក្យ​"
"សម្ងាត់​របស់​អ្នក​បាន​ឡើយ ។"

#: main.cpp:182
msgid "Please enter your password in order to save your settings:"
msgstr "សូម​បញ្ចូល​ពាក្យ​សម្ងាត់​របស់​អ្នក ដើម្បី​រក្សាទុក​ការ​កំណត់​របស់​អ្នក ៖"

#: main.cpp:185
msgid "You must enter your password in order to change your information."
msgstr "អ្នក​ត្រូវ​តែ​បញ្ចូល​ពាក្យ​សម្ងាត់​របស់​អ្នក ដើម្បី​ផ្លាស់ប្តូរ​ព័ត៌មាន​របស់​អ្នក ។"

#: main.cpp:195
msgid "You must enter a correct password."
msgstr "អ្នក​ត្រូវ​តែ​បញ្ចូល​ពាក្យ​សម្ងាត់​ត្រឹមត្រូវ​មួយ ។"

#: main.cpp:199
#, kde-format
msgid ""
"An error occurred and your name has probably not been changed. The error "
"message was:\n"
"%1"
msgstr ""
"កំហុស​មួយ​បាន​កើត​ឡើង ហើយ​ឈ្មោះ​របស់​អ្នក​ប្រហែល​ជា​មិន​ត្រូវបាន​ផ្លាស់ប្ដូរ​ទេ ។ សារ​កំហុសគឺ ៖\n"
"%1"

#: main.cpp:219
#, kde-format
msgid "There was an error saving the image: %1"
msgstr "មាន​កំហុស​ក្នុង​ការ​រក្សា​ទុក​រូបភាព ៖ %1"

#: main.cpp:225
#, kde-format
msgid "There was an error deleting the image: %1"
msgstr "មាន​កំហុស​ក្នុង​ការ​លុប​រូបភាព ៖ %1"

#: main.cpp:304
#, kde-format
msgid ""
"%1 does not appear to be an image file.\n"
"Please use files with these extensions:\n"
"%2"
msgstr ""
"%1 ទំនង​ជា​មិន​មែន​ឯកសារ​រូបភាព​ឡើយ ។\n"
"សូម​ប្រើ​ឯកសារ​ដែល​មាន​កន្ទុយ​ទាំងនេះ ៖\n"
"%2"

