#: main.cpp:31
msgid "Dekoroom"
msgstr "Dekoroom"

#: main.cpp:31
msgid "My personal and sexy home designer"
msgstr "កម្មវិធី​រចនា​ផ្ទះ​ដ៏​ស្អាត និង​ផ្ទាល់ខ្លួន​របស់​ខ្ញុំ"

#: mainwidget.cpp:106
msgid "&New Contact..."
msgstr "ទំនាក់ទំនង​ថ្មី..."

#: mainwidget.cpp:109
msgid ""
"Create a new contact<p>You will be presented with a dialog where you can add "
"all data about a person, including addresses and phone numbers.</p>"
msgstr ""
"បង្កើត​ទំនាក់ទំនង​ថ្មី​<p>អ្នកនឹង​ត្រូវ​បាន​បង្ហាញ​ដោយ​ប្រអប់​មួយ ដែលអ្នក​អាច​បន្ថែម​ទិន្នន័យ​ទាំង​អស់​ខាង​លើ​មនុស្ស "
"រួមមាន អាសយដ្ឋាន និង​លេខ​ទូរស័ព្ទ ។</p>"

#: mainwidget.cpp:113
msgid "&New Group..."
msgstr "ក្រុម​ថ្មី..."

#: mainwidget.cpp:116
msgid ""
"Create a new group<p>You will be presented with a dialog where you can add a "
"new group of contacts.</p>"
msgstr ""
"បង្កើត​ក្រុម​ថ្មី​<p>អ្នក​នឹង​ត្រូ​វបា​ន​បង្ហាញ​ដោយ​ប្រអប់​មួយ ដែល​អ្នក​អាច​បន្ថែម​ក្រុម​ទំនាក់ទំនង​ថ្មី ។</p>"

