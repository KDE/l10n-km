#: application.cpp:73 globals.cpp:66
msgid ""
"<qt>Unable to find LDraw part library. If you have installed LDraw, please "
"specify your installation path.  If you have not installed it, it can be "
"obtained from <a href=\"http://www.ldraw.org\">http://www.ldraw.org</a>.</qt>"
msgstr ""
"<qt>មិន​អាច​រក​បណ្ណាល័យ​ផ្នែក LDraw ។ ប្រសិន​បើ​អ្នក​បាន​ដំឡើង LDraw សូម​បញ្ជាក់​ផ្លូវ​ដំឡើង​របស់​អ្នក ។  "
"ប្រសិនបើ​អ្នក​មិន​ទាន់​បាន​ដំឡើង​ទេ វា​អាច​ទៅ​យក​មកពី <a href=\"http://www.ldraw.org\">http://"
"www.ldraw.org</a> ។</qt>"

#: application.cpp:75 globals.cpp:68
msgid "Choose LDraw installation directory"
msgstr "ជ្រើស​ថត​ដំឡើង LDraw"

#: application.cpp:147 globals.cpp:164
msgid ""
"Could not execute POV-Ray. Raytracing feature is temporarily disabled. "
"Please make sure that POV-Ray is properly installed."
msgstr ""
"មិន​អាច​ប្រតិបត្តិ POV-Ray ។ ធាតុ Raytracing ត្រូវ​បាន​បិទ​ជា​បណ្ដោះអាសន្ន ។ សូម​ប្រាកដ​ថា​ POV-"
"Ray ត្រូវ​បាន​ដំឡើង​ដោយ​ត្រឹមត្រូវ ។"

