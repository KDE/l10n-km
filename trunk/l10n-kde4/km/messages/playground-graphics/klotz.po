msgid "Scanning"
msgstr "អំណាន​ត្រួសៗ"

#: application.cpp:172 application.cpp:188 globals.cpp:189 globals.cpp:205
#, kde-format
msgid ""
"<qt><p align=center>Klotz is now creating database from LDraw part library "
"in your system. Please wait...<br/>%1</p></qt>"
msgstr ""
"<qt><p align=center>ឥឡូវនេះ Klotz កំពុង​បង្កើត​មូលដ្ឋាន​ទិន្នន័យ​ចេញ​ពី​ផ្នែក​បណ្ណាល័យ LDraw ក្នុង​"
"ប្រព័ន្ធ​របស់​អ្នក ។ សូម​រង់ចាំ...<br/>%1</p></qt>"

