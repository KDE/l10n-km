msgid "Save"
msgstr "រក្សាទុក"

#: glimpse.cpp:220
#, kde-format
msgid ""
"About to overwrite file \"%1\"\n"
"Are you sure?"
msgstr ""
"រៀប​នឹង​សរសេរ​ជាន់​លើ​ឯកសារ \"%1\"\n"
"តើ​អ្នក​ប្រាកដ​ឬ ?"

