#: KreaToolManager.cpp:195
#, kde-format
msgid "Activate %1"
msgstr "ធ្វើ​ឲ្យ %1 សកម្ម"

#: KreaToolManager.cpp:344
#, kde-format
msgid "Active tool: %1"
msgstr "ឧបករណ៍​សកម្ម ៖ %1"

#: kreative3d.cpp:116 kreative3d.cpp:272 kreative3d.cpp:307 kreative3d.cpp:412
msgid ""
"The design has been modified.\n"
"Do you want to save it?"
msgstr ""
"ការ​រចនា​ត្រូវ​បានកែប្រែ ។\n"
"តើ​អ្នក​ពិត​ជា​ចង់​រក្សាទុក​វា​ឬ ?"

#: kreative3d.cpp:184
msgid "Create a new design"
msgstr "បង្កើត​ការ​រចនា​ថ្មី"

#: kreative3d.cpp:187
msgid "Open an existing design"
msgstr "បើក​ការ​រចនា​ដែល​មាន​ស្រាប់"

#: kreative3d.cpp:195
msgid "Save the design"
msgstr "រក្សាទុក​ការ​រចនា"

#: kreative3d.cpp:200
msgid "Dialog to print"
msgstr "ប្រអប់​ត្រូវ​បោះពុម្ព"

#: kreative3d.cpp:207
msgid "Cut the selection out and to the clipboard"
msgstr "កាត់​ជម្រើស​ចេញ និង​ទៅ​ក្នុង​ក្ដារតម្បៀតខ្ទាស់"

#: kreative3d.cpp:210
msgid "Copy the selection to the clipboard"
msgstr "ចម្លង​ជម្រើស​ទៅ​ក្ដារតម្បៀតខ្ទាស់"

#: kreative3d.cpp:213
msgid "Paste the contents of the clipboard into the design"
msgstr "បិទភ្ជាប់​មាតិកា​របស់​ក្ដារតម្បៀតខ្ទាស់​ទៅ​ក្នុង​ការ​រចនា"

#: kreative3d.cpp:334
msgid "Open Design"
msgstr "បើក​កា​ររចនា"

#: main.cpp:34
msgid "Parametric Solid CAD package for KDE"
msgstr "កញ្ចប់ CAD តាន់​សម្រាប់ KDE"

#: main.cpp:38
msgid "Kreative3D"
msgstr "Kreative3D"

#: main.cpp:40
