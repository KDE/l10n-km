#: beaglesearch.cpp:74
#, kde-format
msgid "Beagle search service is not running."
msgstr "សេវា​ស្វែងរក​ Beagle មិន​កំពុង​រត់​ទេ ។"

#: beaglesearch.cpp:106
#, kde-format
msgid "Error in querying beagle search service."
msgstr "កំហុស​ក្នុងការ​រក​សេវា​ស្វែងរក beagle ។"

#: kio_beagle.cpp:479
#, kde-format
msgid "Searching via libbeagle for %1 ..."
msgstr "ស្វែង​រក​តាមរយៈ libbeagle សម្រាប់ %1 ..."

#: kio_beagle.cpp:562
#, kde-format
msgid "Found 1 search result"
msgid_plural "Found %1 search results"
msgstr[0] "រក​ឃើញ​លទ្ធផល​ស្វែងរក %1"
