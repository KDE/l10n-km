#: dbusinterface.cpp:215
#, kde-format
msgid "Starting <b>%1</b>..."
msgstr ""

#: iraction.cpp:127
msgid "Exit mode"
msgstr "របៀប​ចេញ​"

#: iraction.cpp:129
#, kde-format
msgid "Switch to %1"
msgstr "ប្តូរ​ទៅ %1"

#: iraction.cpp:132
msgid "Just start"
msgstr "គ្រាន់​តែ​ចាប់​ផ្តើម"

#: iraction.cpp:146
msgid "Do actions before. "
msgstr "ធ្វើ​សកម្មភាព​​មុន ។ "

#: iraction.cpp:147
msgid "Do actions after. "
msgstr "ធ្វើ​សកម្មភាព​បន្ទាប់ ។ "

#: iraction.cpp:151
msgid "Auto-start. "
msgstr "ចាប់ផ្តើម​ស្វ័យប្រវត្តិ"

#: iraction.cpp:152
msgid "Repeatable. "
msgstr "អាច​ធ្វើ​ដដែល ។ "

#: iraction.cpp:153
msgid "Do nothing if many instances. "
msgstr "មិន​ធ្វើ​អ្វី​ទាំងអស់ ​ប្រសិន​បើ​មាន​វត្ថុ​ច្រើ​ន ។ "

#: iraction.cpp:154
msgid "Send to top instance. "
msgstr "ផ្ញើ​ទៅ​កាន់​​វត្ថុ​កំពូល ។ "

#: iraction.cpp:155
msgid "Send to bottom instance. "
msgstr "ផ្ញើ​ទៅ​​កាន់​វត្ថុ​បាត ។"

#: iraction.cpp:155
msgid "Send to all instances. "
msgstr "ផ្ញើ​ទៅ​កាន់​វត្ថុ​ទាំង​អស់ ។"
