#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ម៉ន ម៉េត, សេង សុត្ថា, ចាន់ សម្បត្តិរតនៈ, សុខ សុភា"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ""
"khoemsokhem@khmeros.info,​​mornmet@khmeros.info,sutha@khmeros.info,"
"ratanak@khmeros.info,sophea@khmeros.info"

#: main.cpp:45
#, kde-format
msgid "khtml_userscript"
msgstr "khtml_userscript"

#: main.cpp:45
#, kde-format
msgid "KHTML Userscript Installer"
msgstr "កម្មវិធី​ដំឡើង​ស្គ្រីប​អ្នក​ប្រើ KHTML"

#: main.cpp:45
#, kde-format
msgid "(c) 2007"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៧"

#: main.cpp:46
#, kde-format
msgid "Mathieu Ducharme"
msgstr "Mathieu Ducharme"

#: main.cpp:46
#, kde-format
msgid "Main developer and maintainer"
msgstr "អ្នក​ថែទាំ និង​អ្នក​អភិវឌ្ឍន៍​ចម្បង"

#: main.cpp:51
#, kde-format
msgid "Location of the userscript to install"
msgstr "ទីតាំង​របស់​ស្គ្រីប​អ្នក​ប្រើ​ដែល​ត្រូវ​ដំឡើង"

#: main.cpp:52
#, kde-format
msgid "Force installation (do not validate userscript)"
msgstr "បង្ខំ​ក្នុង​ការ​ដំឡើង (កុំ​ធ្វើ​ឲ្យ​ស្គ្រីប​អ្នក​ប្រើ​មាន​សុពលភាព)"

#: main.cpp:65
#, kde-format
msgid "*.user.js|Userscripts"
msgstr "*.user.js|Userscripts"

#: main.cpp:65
#, kde-format
msgid "Select Userscript file"
msgstr "ជ្រើស​ឯកសារ​ស្គ្រីប​អ្នក​ប្រើ"

#: main.cpp:78
#, kde-format
msgid "The userscript \"%1\" does not appear to be a valid userscript"
msgstr "ស្គ្រីប​អ្នក​ប្រើ \"%1\" អាច​មិន​លេចឡើង​ស្គ្រីប​អ្នក​ប្រើ​​​ដែល​ត្រឹមត្រូវ​ឡើយ"

#: scriptinstallerdialog.cpp:62
#, kde-format
msgid " v."
msgstr " v."

#: scriptinstallerdialog.cpp:81
#, kde-format
msgid "Script successfully installed. You will need to restart Konqueror"
msgstr "បាន​ដំឡើង​ស្គ្រីប​ដោយ​ជោគជ័យ ។ អ្នក​ចាំបាច់​ចាប់ផ្ដើម Konqueror ឡើង​វិញ"

#: scriptinstallerdialog.cpp:81
#, kde-format
msgid "Userscript installed"
msgstr "បាន​ដំឡើង​ស្គ្រីប​អ្នក​ប្រើ"

#: scriptinstallerdialog.cpp:87
#, kde-format
msgid ""
"Script could not be saved. Please make sure a script with the same name is "
"not already installed"
msgstr "មិន​អាច​រក្សាទុក​ស្គ្រីប​បាន​ទេ ។ សូម​ប្រាកដ​ថា​មិន​​​​ដំឡើង​​ស្គ្រីប​ដែល​មាន​ឈ្មោះ​ដូច​គ្នា​​ឡើយ"

#: scriptinstallerdialog.cpp:87
#, kde-format
msgid "Could not install Userscript"
msgstr "មិន​អាច​ដំឡើង​ស្គ្រីប​អ្នក​ប្រើ​បាន​ទេ"

#. i18n: ectx: property (windowTitle), widget (QDialog, ScriptInstallerDialog)
#: scriptinstallerdialog.ui:13
#, kde-format
msgid "Install this script?"
msgstr "តើ​ដំឡើង​ស្គ្រីប​នេះ​ឬ ?"

#. i18n: ectx: property (text), widget (QLabel, nameLabel)
#: scriptinstallerdialog.ui:32
#, kde-format
msgid "Name of the script v.0.1"
msgstr "ឈ្មោះ​របស់​ស្គ្រីប v.0.1"

#. i18n: ectx: property (text), widget (QLabel, authorLabel)
#: scriptinstallerdialog.ui:50
#, kde-format
msgid "By John Smith"
msgstr "By John Smith"

#. i18n: ectx: property (text), widget (QLabel, descriptionLabel)
#: scriptinstallerdialog.ui:63
#, kde-format
msgid ""
"This is a description of the user script as defined by its metadata "
"information. Description should usually be fairly short (3 lines max.)"
msgstr ""
"នេះ​ជា​សេចក្ដី​ពិពណ៌នា​អំពី​ស្គ្រីប​អ្នក​​ប្រើ ដូច​ដែល​បាន​កំណត់​ដោយ​ព័ត៌មាន​ទិន្នន័យ​​មេតា​របស់​​វា ។ សេចក្ដី​ពិពណ៌នា​គួរ​"
"តែ​​​​ត្រឹមត្រូវ (អតិបរមា ៣ បន្ទាត់)"

#. i18n: ectx: property (whatsThis), widget (QTextEdit, scriptContent)
#: scriptinstallerdialog.ui:79
#, kde-format
msgid "Make sure to carefully review the script before installing."
msgstr "សូម​ប្រុងប្រយ័ត្ន​ក្នុង​ការ​ពិនិត្យមើល​ស្គ្រីប​ មុន​ពេល​ដំឡើង ។"

