msgstr "Spiros Georgaras"

#: main.cpp:56
msgid "Disable profiles"
msgstr "បិទ​ទម្រង់"

#: main.cpp:57
msgid "File(s) to be renamed, or"
msgstr "ឯកសារ​ត្រូវ​បាន​ប្ដូរ​ឈ្មោះ ​ឬ"

#: main.cpp:58
msgid "Folders to be renamed, or"
msgstr "ថត​ត្រូវ​បាន​ប្ដូរ​ឈ្មោះ ឬ"

#: main.cpp:59
msgid "Location of files to rename"
msgstr "ទីតាំង​ឯកសារ​ត្រូវ​ប្ដូរ​ឈ្មោះ"

#: main.cpp:127 main.cpp:243 main.cpp:254 main.cpp:258 rename.cpp:1503
msgid ""
"Memory allocation error\n"
"\n"
"The program could not allocate memory needed for its execution. Close some "
"applications and try again"
msgstr ""
"កំហុស​ក្នុង​ការ​​បម្រុង​ទុក​​អង្គ​ចងចាំ\n"
"\n"
"កម្មវិធី​​មិន​អាច​បម្រុងទុក​អង្គ​ចងចាំ​ដែល​ត្រូវ​ការ​ប្រតិបត្តិ​របស់​វា​បាន​ទេ ។ បិទ​កម្មវិធី​ ហើយ​ព្យាយាម​ម្ដងទៀត"

#: main.cpp:141
#, kde-format
msgid ""
"Directory '%1' can not be renamed\n"
"You don't have write permission to this directory"
msgstr ""
"មិន​អាច​ប្ដូរ​ឈ្មោះ​ថត '%1' បាន​​ឡើយ\n"
"អ្នក​គ្មាន​​​​សិទ្ធិ​សរសេរ​​ទៅកាន់​ថត​នេះ​ឡើយ"

#: main.cpp:181
#, kde-format
msgid ""
"File '%1' does not exist\n"
"Please check your selection and try again"
msgstr ""
"គ្មាន​ឯកសារ '%1' ឡើយ\n"
"សូម​ពិនិត្យមើល​ជម្រើស​របស់​អ្នក ហើយ​ព្យាយាម​ម្ដងទៀត"

#: main.cpp:189
#, kde-format
msgid ""
"File '%1' can not be renamed\n"
"You don't have write permission to this file"
msgstr ""
"មិន​អាច​ប្ដូរ​ឈ្មោះ​ឯកសារ '%1' បាន​ទេ\n"
"អ្នក​មិន​មាន​សិទ្ធិ​សរសេរ​ទៅកាន់​ឯកសារ​នេះ​បាន​ទេ"

#: main.cpp:198
msgid ""
"Invalid file type selected\n"
"You can rename normal files or directories"
msgstr ""
"បាន​ជ្រើស​ប្រភេទ​ឯកសារ​​មិន​ត្រឹមត្រូវ\n"
"អ្នក​អាច​ប្ដូរ​ឈ្មោះ​ធម្មតា​ ឬ​ថត​បាន"

#: main.cpp:202
msgid ""
"Invalid selection\n"
"You can not mix files and directories in the same renaming function"
msgstr ""
"ជ្រើស​ឯកសារ​មិន​ត្រឹមត្រូវ\n"
"អ្នក​​​មិន​អាច​ដាក់​ឯកសារ និង​ថត​ចូល​គ្មាន​នៅ​ក្នុង​​ការ​ប្ដូរ​ឈ្មោះ​មុន​ងារ​ដូច​គ្នា​បាន​ទេ"

#: main.cpp:207
msgid ""
"Invalid selection\n"
"The files must be in the same directory"
msgstr ""
"ជម្រើស​មិន​ត្រឹមត្រូវ\n"
"ឯកសារ​ត្រូវ​បាន​ដាក់​នៅ​ក្នុង​ថត​ដូច​គ្នា"

#: main.cpp:214
msgid ""
"Invalid selection\n"
"You can't rename the current or parent directory"
msgstr ""
"ជម្រើស​មិន​ត្រឹមត្រូវ\n"
"អ្នក​មិន​អាច​ប្ដូរ​ឈ្មោះ​ថត​មេ ឬ​ថត​បច្ចុប្បន្ន​បាន​ឡើយ"

#: main.cpp:250
#, kde-format
msgid "<p>Folder <b>%1</b> is empty!!!</p>"
msgstr "<p>ថត <b>%1</b> ទទេ !!!</p>"

