#: initaskmode.cpp:33 initaskmode.cpp:42
msgid "Mode selection"
msgstr "ជម្រើស​របៀប"

#: initaskmode.cpp:48 initaskmode.cpp:75
#, kde-format
msgid ""
"<p>The folder <b>%1</b> is the only parameter passed to <b>GwenRename</b>."
"<br/><br/>Do you want to rename this folder, or the files contained in it?</"
"p>"
msgstr ""
"<p>ថត <b>%1</b> ត្រូវ​បាន​ហុច​​តែ​ប៉ារ៉ាម៉ែត្រ​ទៅកាន់ <b>GwenRename</b> ។<br/><br/>តើ​អ្នក​ចង់​"
"ប្ដូរ​ឈ្មោះ​ថត​​នេះ ឬ​ឯកសារ​ដែល​មាន​​នៅ​ក្នុង​ថត​នេះ​ដែរ​ឬ​ទេ ?</p>"

