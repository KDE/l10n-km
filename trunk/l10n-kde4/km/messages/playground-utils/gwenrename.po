#. i18n: file: multiselecttool.ui:122
#. i18n: ectx: property (whatsThis), widget (QCheckBox, chkInvert)
#: rc.cpp:273
msgid ""
"<p><b>Invert selection in item list</b><br/><br/>\n"
"When checked, only items that do <b>not</b> match the search string will be "
"selected</p>"
msgstr ""
"<p><b>ជម្រើស​ដាក់​បញ្ច្រាស​នៅ​ក្នុង​បញ្ជី​ធាតុ</b><br/><br/>\n"
"នៅ​ពេល​ដែល​បាន​គូស​ធីក តែ​ធាតុ​ដែល​បាន​ធ្វើ​ប៉ុណ្ណោះ <b>មិន</b> ផ្គូផ្គង​ឃ្លា​ស្វែងរក​នឹង​ត្រូវ​បាន​ជ្រើស</p>"

#. i18n: file: multiselecttool.ui:125
#. i18n: ectx: property (text), widget (QCheckBox, chkInvert)
#: rc.cpp:277
