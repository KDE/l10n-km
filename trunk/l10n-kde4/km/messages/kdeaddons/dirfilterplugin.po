#: dirfilterplugin.cpp:146
msgid "View F&ilter"
msgstr "មើល​តម្រង"

#: dirfilterplugin.cpp:150
msgid "Allow to filter the currently displayed items by filetype."
msgstr "អនុញ្ញាត​​​ត្រង​ធាតុ​ដែល​បាន​បង្ហាញ​​ថ្មីៗ​តាម​​ប្រភេទ​ឯកសារ ។​"

#: dirfilterplugin.cpp:168
msgid "Clear Filter Field"
msgstr "ជម្រះ​វាល​តម្រង"

#: dirfilterplugin.cpp:170
msgid "Clear filter field<p>Clears the content of the filter field."
msgstr "ជម្រះ​វាល​តម្រង <p>ជម្រះ​មាតិកា​របស់​វាលតម្រង ។"

#: dirfilterplugin.cpp:187
msgid ""
"Enter here a text which an item in the view must contain anywhere to be "
"shown."
msgstr "នៅ​ទីនេះ​ បញ្ចូល​អត្ថបទ​ដែល​មាន​​ធាតុ​មួយ​ក្នុង​ទិដ្ឋភាព​​ត្រូវ​តែ​មាន​កន្លែង​ណា​មួយ​ត្រូវ​បាន​បង្ហាញ ។"

#: dirfilterplugin.cpp:192
msgid "Filter Field"
msgstr "វាល​តម្រង"

#: dirfilterplugin.cpp:232
msgid "Only Show Items of Type"
msgstr "បង្ហាញ​តែ​ធាតុ​របស់​ប្រភេទ​"

#: dirfilterplugin.cpp:293
msgid "Use Multiple Filters"
msgstr "ប្រើ​តម្រង​ច្រើន​"

#: dirfilterplugin.cpp:298
msgid "Show Count"
msgstr "ចំនួន​បង្ហាញ"

#: dirfilterplugin.cpp:302
msgid "Reset"
msgstr "កំណត់​ឡើង​វិញ"

