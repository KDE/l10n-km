#: audio_plugin.cpp:71
#, qt-format
msgid "An older file named '%1' already exists.\n"
msgstr "ឯកសារ​ចាស់​មួយ​ដែល​មាន​ឈ្មោះ '%1' មាន​រួច​ហើយ ។\n"

#: audio_plugin.cpp:73
#, qt-format
msgid "A similar file named '%1' already exists.\n"
msgstr "ឯកសារ​ដូច​គ្នា​ដែល​មាន​ឈ្មោះ '%1' មាន​រួច​ហើយ​ ។\n"

#: audio_plugin.cpp:75
#, qt-format
msgid "A newer file named '%1' already exists.\n"
msgstr "ឯកសារ​ថ្មី​មួយ​ដែល​មាន​ឈ្មោះ​ '%1' មាន​រួច​ហើយ ។\n"

#: audio_plugin.cpp:77
msgid "Source File"
msgstr "ឯកសា​ប្រភព"

#: audio_plugin.cpp:78
msgid "Existing File"
msgstr "ឯកសារ​មាន​ហើយ"

#: audio_plugin.cpp:79
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "តើ​អ្នក​ចង់​ជំនួស​ឯកសារ​ដែល​មាន​ស្រាប់​ដោយ​ឯកសារ​មួយ​នៅ​ខាង​ស្ដាំ ?"

#: audiopreview.cpp:52
#, fuzzy
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"ឯកសារ​អូឌីយ៉ូ​នេះ​​មិន​​ត្រូវ​ទុក​\n"
"​​លើ​ម៉ាស៊ីន​មូលដ្ឋានទេ ។​\n"
"ចុចលើ​​ស្លាក​នេះ​ដើម្បី​ផ្ទុក​វា ។\n"

#: audiopreview.cpp:58
msgid "Unable to load audio file"
msgstr "មិន​អាច​ផ្ទុក​ឯកសារ​អូឌីយ៉ូ"

#: audiopreview.cpp:89
#, fuzzy, qt-format
msgid "Artist: %1"
msgstr "សិល្បករ ៖ %1\n"

#: audiopreview.cpp:92
#, fuzzy, qt-format
msgid "Title: %1"
msgstr "ចំណង​ជើង ៖ %1\n"

#: audiopreview.cpp:95
#, fuzzy, qt-format
msgid "Comment: %1"
msgstr "សេចក្តី​អធិប្បាយ ៖ %1\n"

#: audiopreview.cpp:97
#, fuzzy, qt-format
msgctxt "Bitrate: 160 kbits/s"
msgid "Bitrate: %1 %2\n"
msgstr "អត្រា​ប៊ីត ៖ %1 %2\n"

#: audiopreview.cpp:99
#, qt-format
msgid "Sample rate: %1 %2\n"
msgstr "អត្រា​ធម្មតា​ ៖ %1 %2\n"

#: audiopreview.cpp:100
msgid "Length: "
msgstr "ប្រវែង ៖ "
