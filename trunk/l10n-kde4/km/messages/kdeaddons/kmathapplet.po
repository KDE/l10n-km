#: mathapplet.cpp:70
msgid "Evaluate:"
msgstr "វាយ​តម្លៃ ៖"

#: mathapplet.cpp:118
msgid "Use &Degrees"
msgstr "ប្រើ​អង្សា"

#: mathapplet.cpp:119
msgid "Use &Radians"
msgstr "ប្រើ​រ៉ាដ្យង់"

#: mathapplet.cpp:209
msgid "< Eval"
msgstr "< វាយ​តម្លៃ"

#: mathapplet.cpp:216
msgid "Eval >"
msgstr "វាយតម្លៃ >"

#: mathapplet.cpp:261
msgid "You have to enter an expression to be evaluated first."
msgstr "ដំបូង អ្នក​ត្រូវ​តែ​បញ្ចូល​កន្សោម​ត្រូវ​វាយ​តម្លៃ​មួយ ។"

#: parser.cpp:659
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Syntax error"
msgstr ""
"កំហុស​កម្មវិធី​​​ញែក​នៅ​ទីតាំង %1 ៖\n"
"កំហុស​វាក្យ​សម្ពន្ធ"

#: parser.cpp:660 parser.cpp:664 parser.cpp:668 parser.cpp:672 parser.cpp:676
#: parser.cpp:680 parser.cpp:684 parser.cpp:688 parser.cpp:692 parser.cpp:695
#: parser.cpp:697
msgid "Math Expression Evaluator"
msgstr "កម្មវិធី​វាយ​តម្លៃ​កន្សោម​ពិជគណិត"

#: parser.cpp:663
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Missing parenthesis"
msgstr ""
"កំហុស​កម្មវិធី​​ញែក​នៅ​ទីតាំង %1 ៖\n"
"បាត​វង់​ក្រចក"

#: parser.cpp:667
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Function name unknown"
msgstr ""
"កំហុស​កម្មវិធី​ញែក​នៅ​ទីតាំង %1 ៖\n"
"មិន​ស្គាល់​ឈ្មោះ​អនុគមន៍"

#: parser.cpp:671
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Void function variable"
msgstr ""
"កំហុស​កម្មវិធី​​ញែក​នៅ​ទីតាំង %1 ៖\n"
"អថេរ​អនុគមន៍​​មិន​អាច​ប្រើ​បាន"

#: parser.cpp:675
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Too many functions"
msgstr ""
"កំហុស​កម្មវិធី​​ញែក​នៅ​ទីតាំង %1 ៖\n"
"​អនុគមន៍​ច្រើន​ពេក"

#: parser.cpp:679
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Token-memory overflow"
msgstr ""
"កំហុស​កម្មវិធី​​ញែក​នៅ​ទីតាំង %1 ៖\n"
"សតិ​ថូខឹន​លើស​ចំណុះ"

#: parser.cpp:683
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Stack overflow"
msgstr ""
"កំហុស​កម្មវិធី​​ញែក​នៅ​ទីតាំង %1 ៖\n"
"ជង់​លើស​ចំណុះ"

#: parser.cpp:687
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Name of function not free"
msgstr ""
"កំហុស​កម្មវិធី​ញែក​នៅ​ទីតាំង %1 ៖\n"
"ឈ្មោះ​អនុគមន៍​មិន​ទំនេរ"

#: parser.cpp:691
#, qt-format
msgid ""
"Parser error at position %1:\n"
"recursive function not allowed"
msgstr ""
"កំហុស​កម្មវិធី​ញែក​នៅ​ទីតាំង %1 ៖\n"
"មិន​​អនុញ្ញាត​អនុគមន៍​​ហៅ​ខ្លួន​ឯង​"

#: parser.cpp:694
#, qt-format
msgid "Could not find a defined constant at position %1"
msgstr "មិន​អាច​រក​ចំនួន​ថេរ​ដែល​បាន​កំណត់​នៅ​ទីតាំង %1"

#: parser.cpp:697
msgid "Empty function"
msgstr "អនុគមន៍​ទទេ"
