"There was an error loading file\n"
"%1"
msgstr ""
"​មាន​កំហុស​មួ​យ ក្នុង​ពេល​ផ្ទុក​ឯកសារ\n"
"%1"

#: phrasebook/phrasebookdialog.cpp:803
msgid "Export Phrase Book"
msgstr "នាំចេញ​សៀវភៅ​ឃ្លា"

#: phrasebook/phrasebookdialog.cpp:804 phraselist.cpp:457
#, qt-format
msgid ""
"There was an error saving file\n"
"%1"
msgstr ""
"មាន​កំហុស​មួយ​ពេល​រក្សាទុក​ឯកសារ\n"
"%1"

#: phrasebook/phrasebook.cpp:264
msgid ""
"*.txt|Plain Text Files (*.txt)\n"
"*.phrasebook|Phrase Books (*.phrasebook)\n"
"*|All Files"
