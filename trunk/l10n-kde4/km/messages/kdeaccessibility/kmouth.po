"%f -- the name of a file containing the text\n"
"%l -- the language code\n"
"%% -- a percent sign"
msgstr ""
"វាល​នេះ​បញ្ជាក់​ទាំង​ពាក្យ​បញ្ជា​ដែល​ប្រើ​សម្រាប់​និយាយ​អត្ថបទ និង ប៉ារ៉ាម៉ែត្រ​របស់​វា ។KMouth ដឹង​កន្លែង​"
"ដាក់​ខាងក្រោម ៖\n"
"%t -- អត្ថបទ​ដែល​គួរ​និយាយ\n"
"%f -- ឈ្មោះ​ឯកសារ​ដែល​មាន​អត្ថបទ\n"
"%l -- កូដ​ភាសា\n"
"%% -- សញ្ញា​ភាគរយ"

