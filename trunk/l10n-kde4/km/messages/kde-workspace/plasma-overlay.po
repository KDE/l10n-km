#. i18n: ectx: property (text), widget (QLabel, m_wallpaperLabel)
#: rc.cpp:14
msgid "Wallpaper"
msgstr "ផ្ទាំង​រូបភាព"

#. i18n: file: BackgroundDialog.ui:166
#. i18n: ectx: property (text), widget (QLabel, m_wallpaperTypeLabel)
#: rc.cpp:17
