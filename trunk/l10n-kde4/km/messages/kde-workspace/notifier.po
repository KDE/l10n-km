#: package/contents/ui/devicenotifier.qml:118
msgid "Available Devices"
msgstr "ឧបករណ៍​ដែល​អាច​ប្រើបាន"

#: package/contents/ui/devicenotifier.qml:118
msgid "No Devices Available"
msgstr "មិនមាន​ឧបករណ៍​ទេ"

#~ msgid "Click to eject this disc."
#~ msgstr "ចុច​ដើម្បី​ច្រាន​ថាស​នេះ​ចេញ ។"

#~ msgid "Click to safely remove this device."
#~ msgstr "ចុច​ដើម្បី​យក​ឧបករណ៍​នេះ​ចេញ​ដោយ​សុវត្ថិភាព ។"

#~ msgid "Click to unmount this device."
#~ msgstr "ចុច​ដើម្បីអាន់ម៉ោន​ឧបករណ៍​នេះ ។"

#~ msgid ""
#~ "It is currently <b>not safe</b> to remove this device: applications may "
#~ "be accessing it. Click the eject button to safely remove this device."
#~ msgstr ""
#~ "ឥឡូវ​នេះ <b>មិនមាន​សុវត្ថិភាព</b> ដើម្បី​យក​ឧបករណ៍​នេះ​ចេញ​ទេ ៖ កម្មវិធី​ប្រហែល​ជា​ចូល​ដំណើរការ​"
#~ "វា ។ ចុច​ប៊ូតុង​ច្រាន​ចេញ ដើម្បី​យក​ឧបករណ៍​នេះ​ចេញ​​ដោយ​សុវត្ថិភាព ។"

#~ msgid "This device is currently accessible."
#~ msgstr "ឧបករណ៍​នេះ​បច្ចុប្បន្ន​អាច​ប្រើ​បាន ។"

#~ msgid "Click to access this device from other applications."
#~ msgstr "ចុច​ដើម្បី​ចូលដំណើរការ​ឧបករណ៍​នេះ​ពី​កម្មវិធី​ផ្សេង ។"

#~ msgid "It is currently safe to remove this device."
#~ msgstr "ឥឡូវ​នេះ​មាន​សុវត្ថិភាព​ដើម្បី​យក​ឧបករណ៍​នេះ​ចេញ ។"

#~ msgid ""
#~ "It is currently <b>not safe</b> to remove this device: applications may "
#~ "be accessing other volumes on this device. Click the eject button on "
#~ "these other volumes to safely remove this device."
#~ msgstr ""
#~ "ឧបករណ៍​ត្រូវ​បាន​ដោ​តចូល ហើយ​កម្រិត​សំឡេង​មិន​ត្រូវបាន​ម៉ោន​សម្រាប់​ចូលដំណើរការ​នៅ​ឡើយ​ទេ ។ កម្រិត​សំឡេង​"
#~ "ផ្សេង​ទៀត​អាច​ចូល​ដំណើរការ​​​​​​បាននៅ​លើ​ឧបករណ៍​ដូច​គ្នា ដែល​មិនអាច​ត្រូវ​បាន​យកចេញ​ដោយ​សុវត្ថិភាព​នោះ​ទេ ។"

#~ msgid "This device is currently not accessible."
#~ msgstr "ឧបករណ៍​​នេះ​បច្ចុប្បន្ន​មិនអាច​​ប្រើ​បាន​ទេ ។"

#~ msgctxt "@info:status Free disk space"
#~ msgid "%1 free"
#~ msgstr "ទំនេរ %1"

#~ msgctxt ""
#~ "Accessing is a less technical word for Mounting; translation should be "
#~ "short and mean 'Currently mounting this device'"
#~ msgid "Accessing..."
#~ msgstr "កំពុង​ចូល​ដំណើរការ..."

#~ msgctxt ""
#~ "Removing is a less technical word for Unmounting; translation shoud be "
#~ "short and mean 'Currently unmounting this device'"
#~ msgid "Removing..."
#~ msgstr "កំពុង​យកចេញ..."

#~ msgid "1 action for this device"
#~ msgid_plural "%1 actions for this device"
#~ msgstr[0] "សកម្មភាព​ %1 សម្រាប់​ឧបករណ៍នេះ"

#~ msgid "No devices available."
#~ msgstr "មិនមាន​ឧបករណ៍​ទេ"

#~ msgid "Most recent device"
#~ msgstr "ឧបករណ៍​ថ្មីៗ​បំផុត"

#~ msgid "Display"
#~ msgstr "បង្ហាញ"

#~ msgid "Automounting"
#~ msgstr "ម៉ោន​ដោយ​ស្វ័យ​ប្រវត្តិ"

#~ msgid "Show hidden devices"
#~ msgstr "បង្ហាញ​ឧបករណ៍​ដែលបាន​លាក់"

#~ msgctxt "Hide a device"
#~ msgid "Hide %1"
#~ msgstr "លាក់ %1"

#~ msgid "Removable devices only"
#~ msgstr "មានតែ​ឧបករណ៍​ចល័ត"

#~ msgid "Non-removable devices only"
#~ msgstr "គ្មាន​ឧបករណ៍​ចល័ត"

#~ msgid "All devices"
#~ msgstr "ឧបករណ៍​ទាំងអស់"
