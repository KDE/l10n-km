#: kdecoration_plugins_p.cpp:109
msgid "Loading of window decoration plugin library disabled in configuration."
msgstr "ការ​បិទ​បណ្ណាល័យ​កម្មវិធី​ជំនួយ​តុបតែង​បង្អួច​បាន​បិទ​នៅ​ក្នុង​ការ​កំណត់​រចនាសម្ព័ន្ធ ។"

#: kdecoration_plugins_p.cpp:129
msgid "No window decoration plugin library was found."
msgstr "រក​មិន​ឃើញ​បណ្ណាល័យ​កម្មវិធី​ជំនួយនៃ​ការ​តុបតែង​បង្អួច ។"

#: kdecoration_plugins_p.cpp:154
msgid "The default decoration plugin is corrupt and could not be loaded."
msgstr "កម្មវិធី​ជំនួយ​នៃ​ការ​តុប​តែង​លំនាំ​ដើម​បាន​ខូច ហើយ​មិន​អាច​ផ្ទុក​បាន​ទៀត។"

#: kdecoration_plugins_p.cpp:166 kdecoration_plugins_p.cpp:171
#, kde-format
msgid "The library %1 is not a KWin plugin."
msgstr "បណ្ណាល័យ %1 មិន​មែនជាកម្មវិធី​ជំនួយ​របស់ KWin ។"

