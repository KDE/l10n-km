#: simplejavascriptapplet.cpp:514
msgid "i18n() takes at least one argument"
msgstr "i18n() ត្រូវការ​អាគុយម៉ង់យ៉ាង​ហោចណាស់​មួយ"

#: simplejavascriptapplet.cpp:530
msgid "i18nc() takes at least two arguments"
msgstr "i18nc() ត្រូវការ​អាគុយម៉ង់​យ៉ាង​ហោចណាស់​ពីរ"

#: simplejavascriptapplet.cpp:547
msgid "i18np() takes at least two arguments"
msgstr "i18np() ត្រូវការ​អាគុយម៉ង់​យ៉ាង​ហោចណាស់​ពីរ"

#: simplejavascriptapplet.cpp:564
msgid "i18ncp() takes at least three arguments"
msgstr "i18ncp() ត្រូវការ​អាគុយម៉ង់​យ៉ាង​ហោចណាស់​បី"

#: simplejavascriptapplet.cpp:582
msgid "dataEngine() takes one argument"
msgstr "dataEngine() ត្រូវកា​រអាគុយម៉ង់​មួយ"

#: simplejavascriptapplet.cpp:592 simplejavascriptapplet.cpp:617
#: simplejavascriptapplet.cpp:784
msgid "Could not extract the AppletObject"
msgstr "មិនអាច​​ស្រង់ AppletObject ចេញ​បានទេ"

#: simplejavascriptapplet.cpp:597 simplejavascriptapplet.cpp:622
#: simplejavascriptapplet.cpp:789
msgid "Could not extract the Applet"
msgstr "មិន​អាច​ស្រង់អាប់ភ្លេត​ចេញ​បានទេ"

#: simplejavascriptapplet.cpp:607
msgid "service() takes two arguments"
msgstr "service() ត្រូវការ​អាគុយម៉ង់​ពីរ"

#: simplejavascriptapplet.cpp:635
msgid "loadui() takes one argument"
msgstr "loadui() ត្រូវកា​រអាគុយម៉ង់​មួយ"

#: simplejavascriptapplet.cpp:641
#, kde-format
msgid "Unable to open '%1'"
msgstr "មិអាច​បើក '%1' បានទេ"

#: simplejavascriptapplet.cpp:681 simplejavascriptapplet.cpp:714
msgid "Constructor takes at least 1 argument"
msgstr "កម្មវិធី​ស្ថាបនា​ត្រូវកា​រអាគុយម៉ង់​យ៉ាង​ហោចណាស់​មួយ"

#: simplejavascriptapplet.cpp:766
msgid "CreateWidget takes one argument"
msgstr "CreateWidget ត្រូវការ​អាគុយម៉ង់​មួយ"

#: simplejavascriptapplet.cpp:774
msgid "The parent must be a QGraphicsWidget"
msgstr "មេ​ត្រូវតែ​ជា QGraphicsWidget"

#: simplejavascriptapplet.cpp:819
#, kde-format
msgid "This operation was not supported, %1"
msgstr "ប្រតិបត្តិការ​នេះ​មិន​ត្រូវ​បានគាំទ្រ​ %1 ទេ"

#: simplejavascriptapplet.cpp:826
msgid "print() takes one argument"
msgstr "print() ត្រូវការ​អាគុយម៉ង់​មួយ"

#: qtgui/linearlayout.cpp:72
msgid "LinearLayout requires a parent"
msgstr "LinearLayout ត្រូវការ​មេ"

#: qtgui/linearlayout.cpp:78
msgid "The parent must be a QGraphicsLayoutItem"
msgstr "មេ​ត្រូវ​តែ​ជា QGraphicsLayoutItem"

