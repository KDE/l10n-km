msgstr "ប្ដូរ​ទំហំ​បង្អួច​មេ​ស្វ័យ​ប្រវត្តិ"

#. i18n: file: kplayersettingsgeneral.ui:45
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_resize_automatically)
#: rc.cpp:2301
msgid "Resize main window automatically to make video area the correct size"
msgstr "ប្ដូរ​ទំហំ​បង្អួច​មេ​ស្វ័យ​ប្រវត្តិ​ដើម្បី​ធ្វើ​ឲ្យ​ផ្ទៃ​វីដេអូ​មាន​ទំហំ​ត្រឹមត្រូវ"

#. i18n: file: kplayersettingsgeneral.ui:48
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_resize_automatically)
#: rc.cpp:2304
msgid ""
"Option to choose whether to automatically resize main KPlayer window so that "
"the video area is of the desired size."
msgstr "ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ប្ដូរ​ទំហំ​បង្អួច KPlayer មេ ដើម្បី​ឲ្យ​ផ្ទៃ​វីដេអូ​ទៅ​ជា​ទំហំ​ដែល​ចង​បាន ។"

#. i18n: file: kplayersettingsgeneral.ui:65
#. i18n: ectx: property (text), widget (QLabel, l_playlist_menu_size)
#: rc.cpp:2307
msgid "Ma&ximum entries on playlist menus"
msgstr "ធាតុ​អតិបរមា​លើ​ម៉ឺនុយ​បញ្ជី​ចាក់"

#. i18n: file: kplayersettingsgeneral.ui:74
#. i18n: ectx: property (toolTip), widget (QLabel, l_playlist_menu_size)
#. i18n: file: kplayersettingsgeneral.ui:104
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_playlist_menu_size)
#: rc.cpp:2310 rc.cpp:2316
msgid "Maximum number of entries on Play List and Add To Playlist menus"
msgstr "ចំនួន​ធាតុ​អតិ​បរមា​លើ​ម៉ឺនុយ បញ្ជី​ចាក់ និង បន្ថែម​ទៅ​បញ្ជី​ចាក់"

#. i18n: file: kplayersettingsgeneral.ui:77
#. i18n: ectx: property (whatsThis), widget (QLabel, l_playlist_menu_size)
#. i18n: file: kplayersettingsgeneral.ui:107
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_playlist_menu_size)
#: rc.cpp:2313 rc.cpp:2319
msgid ""
"Option to specify the maximum number of entries on Play List and Add To "
"Playlist menus."
msgstr "ជម្រើស​ត្រូវ​បញ្ជាក់​ចំនួន​ធាតុ​អតិបរមា​លើ​ម៉ឺនុយ បញ្ជី​ចាក់ និង បន្ថែម​ទៅ​បញ្ជី​ចាក់ ។"

#. i18n: file: kplayersettingsgeneral.ui:122
#. i18n: ectx: property (text), widget (QLabel, l_recent_menu_size)
#: rc.cpp:2322
msgid "Maximum entries on &Play Recent menu"
msgstr "ធាតុ​អតិបរមា​សល​ម៉ឺនុយ ចាក់​ថ្មៗ"

#. i18n: file: kplayersettingsgeneral.ui:131
#. i18n: ectx: property (toolTip), widget (QLabel, l_recent_menu_size)
#. i18n: file: kplayersettingsgeneral.ui:161
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_recent_menu_size)
#: rc.cpp:2325 rc.cpp:2331
msgid "Maximum number of entries on the Play Recent menu"
msgstr "ចំនួន​ធាតុ​អតិបរមា​លើ​ម៉ឺនុយ ចាក់​ថ្មីៗ"

#. i18n: file: kplayersettingsgeneral.ui:134
#. i18n: ectx: property (whatsThis), widget (QLabel, l_recent_menu_size)
#. i18n: file: kplayersettingsgeneral.ui:164
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_recent_menu_size)
#: rc.cpp:2328 rc.cpp:2334
msgid ""
"Option to specify the maximum number of entries on the Play Recent menu. If "
"this number is exceeded, the oldest entries will be removed."
msgstr ""
"ជម្រើស​ត្រូវ​បញ្ជាក់​ចំនួន​ធាតុ​អតិបរមា​លើ​ម៉ឺនុយ ចាក់​ថ្មីៗ ។ បើ​ចំនួន​នេះ​លើស ធាតុ​ចាស់​បំផុត​នឹង​ត្រូវ​បាន​យក​ចេញ ។"

#. i18n: file: kplayersettingsgeneral.ui:179
#. i18n: ectx: property (text), widget (QLabel, l_recent_list_size)
#: rc.cpp:2337
msgid "Maximum &Recent entries in the library"
msgstr "ធាតុ​ថ្មីៗ​អតិបរមា​ក្នុង​បណ្ណាល័យ"

#. i18n: file: kplayersettingsgeneral.ui:188
#. i18n: ectx: property (toolTip), widget (QLabel, l_recent_list_size)
#. i18n: file: kplayersettingsgeneral.ui:218
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_recent_list_size)
#: rc.cpp:2340 rc.cpp:2346
msgid "Maximum number of entries on the Recent list in the multimedia library"
msgstr "ចំនួន​ធាតុ​អតិបរមា​លើ​បញ្ជី​ថ្មីៗ ក្នុង​បណ្ណាល័យ​ពហុ​មេឌៀ"

#. i18n: file: kplayersettingsgeneral.ui:191
#. i18n: ectx: property (whatsThis), widget (QLabel, l_recent_list_size)
#. i18n: file: kplayersettingsgeneral.ui:221
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_recent_list_size)
#: rc.cpp:2343 rc.cpp:2349
msgid ""
"Option to specify the maximum number of entries on the Recent list in the "
"multimedia library. If this number is exceeded, the oldest entries will be "
"removed."
msgstr ""
"ជម្រើស​ត្រូវ​បញ្ជាក់​ចំនួន​ធាតុ​អតិបរមា​លើ​បញ្ជី​ថ្មីៗ ក្នុង​បណ្ណាល័យ​ពហុ​មេឌៀ ។ បើ​ចំនួន​នេះ​លើស ធាតុ​ចាស់​បំផុត​នឹង​"
"ត្រូវ​បាន​យក​ចេញ ។"

#. i18n: file: kplayersettingsgeneral.ui:236
#. i18n: ectx: property (text), widget (QLabel, l_cache_size_limit)
#: rc.cpp:2352
msgid "Meta information cache size &limit"
msgstr "ដែន​កំណត់​ទំហំ​ឃ្លាំង​សម្ងាត់​ព័ត៌មាន​មេតា"

#. i18n: file: kplayersettingsgeneral.ui:245
#. i18n: ectx: property (toolTip), widget (QLabel, l_cache_size_limit)
#. i18n: file: kplayersettingsgeneral.ui:275
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_cache_size_limit)
#: rc.cpp:2355 rc.cpp:2361
msgid "Maximum number of entries for which KPlayer remembers properties"
msgstr "ចំនួន​ធាតុ​អតិបរមា​សម្រាប់ KPlayer មួយ​ណា​ចងចាំ​លក្ខណៈ​សម្បត្តិ"

#. i18n: file: kplayersettingsgeneral.ui:248
#. i18n: ectx: property (whatsThis), widget (QLabel, l_cache_size_limit)
#. i18n: file: kplayersettingsgeneral.ui:278
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_cache_size_limit)
#: rc.cpp:2358 rc.cpp:2364
msgid ""
"Option that shows and allows you to change the maximum number of entries for "
"which KPlayer remembers properties, even if they are no longer on playlist. "
"If the limit is exceeded, the oldest existing entries are removed from cache."
msgstr ""
"ជម្រើស​ដែល​បង្ហាញ និង​អនុញ្ញាត​ឲ្យ​អ្នក​ផ្លាស់ប្ដូរ​ចំនួន​ធាតុ​អតិបរមា សម្រាប់ KPlayer មួយ​ណា​ចងចាំ​លក្ខណៈ​"
"សម្បត្តិ សូម្បី​ពួក​វា​មិន​នៅ​លើ​បញ្ជី​ចាក់ ។ បើ​ដែន​កំណត់​លើស ធាតុ​ដែល​មាន​ចាស់​បំផុត​ត្រូវ​បាន​យក​ចេញ​ពី​ឃ្លាំង​សម្ងាត់ "
"។"

#. i18n: file: kplayersettingsgeneral.ui:287
#. i18n: ectx: property (text), widget (QCheckBox, c_allow_duplicate_entries)
#: rc.cpp:2367
msgid "Allo&w duplicate entries on playlists"
msgstr "អនុញ្ញាត​ធាតុ​ស្ទួន​លើ​បញ្ជី​ចាក់"

#. i18n: file: kplayersettingsgeneral.ui:290
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_allow_duplicate_entries)
#: rc.cpp:2370
msgid "Allow multiple entries with the same URL on playlists"
msgstr "អនុញ្ញាត​ធាតុ​ច្រើន​ដែល​មាន URL ដូច​គ្នា​លើ​បញ្ជី​ចាក់"

#. i18n: file: kplayersettingsgeneral.ui:293
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_allow_duplicate_entries)
#: rc.cpp:2373
msgid ""
"Option to choose whether to allow multiple entries having the exact same URL "
"on playlist. Duplicate entries will have the same set of file properties. If "
"this option is not selected, and you put a new entry with the same URL as an "
"existing one on a playlist, the old entry will be removed."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​អនុញ្ញាត​ធាតុ​ច្រើន​ដែល​មាន​ URL ដូច​គ្នា​ពិត​ប្រាកដ​លើ​បញ្ជី​ចាក់ ។ ធាតុ​ស្ទួន​នឹង​មាន​"
"សំណុំ​លក្ខណៈ​សម្បត្តិ​ឯកសារ​ដូច​គ្នា ។ បើ​ជម្រើស​នេះ​មិន​ត្រូវ​បាន​ជ្រើស ហើយ​អ្នក​ដាក់​ធាតុ​ថ្មី​ដែល​មាន URL ដូចមួយ​"
"ដែល​មាន​នៅ​លើ​បញ្ជី​ចាក់ ធាតុ​ចាស់​នឹង​ត្រូវ​បាន​យក​ចេញ ។"

#. i18n: file: kplayersettingsgeneral.ui:300
#. i18n: ectx: property (text), widget (QCheckBox, c_show_messages_on_error)
#: rc.cpp:2376
msgid "&Show messages if a file fails to play"
msgstr "បង្ហាញ​សារ បើ​ឯកសារ​បរាជ័យ​ក្នុង​ការ​ចាក់"

#. i18n: file: kplayersettingsgeneral.ui:303
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_show_messages_on_error)
#: rc.cpp:2379
msgid ""
"Show message log if KPlayer encounters an error when trying to play a file"
msgstr "បង្ហាញ​កំណត់​ហេតុ​សារ បើ KPlayer ជួប​ប្រទះ​កំហុស ពេល​ព្យាយាម​ចាក់​ឯកសារ"

#. i18n: file: kplayersettingsgeneral.ui:306
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_show_messages_on_error)
#: rc.cpp:2382
msgid ""
"Option to choose whether to show message log if KPlayer encounters an error "
"when trying to play a file, so you can look at the end of the log to see "
"what the error was."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​បង្ហាញ​កំណត់​ហេតុ​សា បើ KPlayer ជួប​ប្រទះ​កំហុស ពេល​ព្យាយាម​ចាក់​ឯកសារ ដូច្នេះ​"
"អ្នក​អាច​មើល​នៅ​ចុង​បញ្ចប់​នៃ​កំណត់​ហេតុ​ដើម្បី​មើល​កំហុស ។"

