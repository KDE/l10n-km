#. i18n: ectx: property (toolTip), widget (QLineEdit, c_hue_maximum)
#: rc.cpp:2403 rc.cpp:2409
msgid "Upper limit on the video hue"
msgstr "ដែន​កំណត់​លើ​ពណ៌​លាំៗ​វីដេអូ"

#. i18n: file: kplayersettingshue.ui:119
#. i18n: ectx: property (whatsThis), widget (QLabel, l_hue_maximum)
#. i18n: file: kplayersettingshue.ui:149
