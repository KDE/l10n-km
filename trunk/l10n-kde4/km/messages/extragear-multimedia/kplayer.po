msgstr "ដែន​កំណត់​ទាប​កម្រិត​ពណ៌​វីដេអូ"

#. i18n: file: kplayersettingscontrast.ui:62
#. i18n: ectx: property (whatsThis), widget (QLabel, l_contrast_minimum)
#. i18n: file: kplayersettingscontrast.ui:92
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_contrast_minimum)
#: rc.cpp:2070 rc.cpp:2076
msgid "Option to specify a lower limit on the video contrast setting."
msgstr "ជម្រើស​ត្រូវ​បញ្ជាក់​ដែន​កំណត់​ទាប លើ​ការ​កំណត់​កម្រិត​ពណ៌​វីដេអូ ។"

#. i18n: file: kplayersettingscontrast.ui:116
#. i18n: ectx: property (toolTip), widget (QLabel, l_contrast_maximum)
#. i18n: file: kplayersettingscontrast.ui:146
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_contrast_maximum)
#: rc.cpp:2082 rc.cpp:2088
msgid "Upper limit on the video contrast"
msgstr "ដែន​កំណត់​លើ​កម្រិត​ពណ៌​វីដេអូ"

#. i18n: file: kplayersettingscontrast.ui:119
#. i18n: ectx: property (whatsThis), widget (QLabel, l_contrast_maximum)
#. i18n: file: kplayersettingscontrast.ui:149
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_contrast_maximum)
#: rc.cpp:2085 rc.cpp:2091
msgid "Option to specify an upper limit on the video contrast setting."
msgstr "ជម្រើស​ត្រូវ​បញ្ជាក់​ដែន​កំណត់​លើ​ការ​កំណត់​កម្រិត​ពណ៌​វីដេអូ ។"

#. i18n: file: kplayersettingscontrast.ui:173
#. i18n: ectx: property (toolTip), widget (QLabel, l_contrast_step)
#. i18n: file: kplayersettingscontrast.ui:203
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_contrast_step)
#: rc.cpp:2097 rc.cpp:2103
msgid ""
"Amount of adjustment to video contrast when using Increase/Decrease commands"
msgstr "ចំនួន​លៃ​តម្រូវ​កម្រិត​ពណ៌​វីដេអូ ពេល​ប្រើ​ពាក្យ​បញ្ជា​បង្កើន/បន្ថយ"

#. i18n: file: kplayersettingscontrast.ui:176
#. i18n: ectx: property (whatsThis), widget (QLabel, l_contrast_step)
#. i18n: file: kplayersettingscontrast.ui:206
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_contrast_step)
#: rc.cpp:2100 rc.cpp:2106
msgid ""
"Option to specify the amount by which to change video contrast when using "
"Increase/Decrease Contrast commands on Player/Video menu or the "
"corresponding keyboard shortcuts."
msgstr ""
"ជម្រើស​ត្រូវ​បញ្ជាក់​ចំនួន ដែល​ត្រូវ​ផ្លាស់ប្ដូរ​កម្រិត​ពណ៌​វីដេអូ ពេល​ប្រើ​ពាក្យ​បញ្ជា​បង្កើន/បន្ថយ​កម្រិត​ពណ៌ លើ​"
"ម៉ឺនុយ កម្មវិធី​ចាក់/វីដេអូ ឬ​ផ្លូវកាត់​ក្ដារ​ចុច​ដែល​ដូច​គ្នា ។"

#. i18n: file: kplayersettingscontrast.ui:221
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_contrast_reset)
#. i18n: file: kplayersettingscontrast.ui:248
#. i18n: ectx: property (toolTip), widget (QLabel, l_contrast_to)
#. i18n: file: kplayersettingscontrast.ui:278
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_contrast_default)
#. i18n: file: kplayersettingscontrast.ui:305
#. i18n: ectx: property (toolTip), widget (QLabel, l_contrast_every)
#. i18n: file: kplayersettingscontrast.ui:318
#. i18n: ectx: property (toolTip), widget (QComboBox, c_contrast_every)
#: rc.cpp:2112 rc.cpp:2121 rc.cpp:2127 rc.cpp:2136 rc.cpp:2142
msgid ""
"Reset contrast to a specific setting for each new file or KPlayer session"
msgstr "កំណត់​កម្រិត​ពណ៌​ឡើង​វិញ​ទៅ​ការ​កំណត់​ជាក់លាក់ សម្រាប់​ឯកសារ​ថ្មី ឬ​សម័យ KPlayer នីមួយៗ"

#. i18n: file: kplayersettingscontrast.ui:224
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_contrast_reset)
#. i18n: file: kplayersettingscontrast.ui:251
#. i18n: ectx: property (whatsThis), widget (QLabel, l_contrast_to)
#. i18n: file: kplayersettingscontrast.ui:281
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_contrast_default)
#. i18n: file: kplayersettingscontrast.ui:308
#. i18n: ectx: property (whatsThis), widget (QLabel, l_contrast_every)
#. i18n: file: kplayersettingscontrast.ui:321
#. i18n: ectx: property (whatsThis), widget (QComboBox, c_contrast_every)
#: rc.cpp:2115 rc.cpp:2124 rc.cpp:2130 rc.cpp:2139 rc.cpp:2145
msgid ""
"Option to reset video contrast to a specific setting for each new file or "
"KPlayer session."
msgstr ""
"ជម្រើស​ត្រូវ​កំណត់​កម្រិត​ពណ៌​វីដេអូ​ឡើង​វិញ​ទៅ​ការ​កំណត់​ជាក់លាក់ សម្រាប់​ឯកសារ​ថ្មី ឬ​សម័យ KPlayer នីមួយៗ"

#. i18n: file: kplayersettingscontrols.ui:42
#. i18n: ectx: property (text), widget (QCheckBox, c_shift)
#: rc.cpp:2154
msgid "&Remember for current file any changes made with Shift"
msgstr "ចងចាំ​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន នូវ​ការ​ផ្លាស់ប្ដូរ​មួយ​ចំនួន​ដែល​បាន​ធ្វើ​ជាមួយ ប្ដូរ (Shift)"

#. i18n: file: kplayersettingscontrols.ui:45
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_shift)
#: rc.cpp:2157
msgid ""
"Remember changes made while holding the Shift key down in the file "
"properties for the current file"
msgstr ""
"ចងចាំ​ការ​ផ្លាស់ប្ដូរ​ដែល​បាន​ធ្វើ ខណៈ​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​"
"ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:48
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_shift)
#: rc.cpp:2160
msgid ""
"Option to choose whether to automatically remember any changes and "
"adjustments made while holding the Shift key down in the file properties for "
"the currently loaded file. This is particularly useful with volume, "
"contrast, brightness and aspect settings, but also works with other options "
"listed (but not checked) below."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ស្វ័យ​ប្រវត្តិ​ការ​ផ្លាស់ប្ដូរ និង​ការ​លៃ​តម្រូវ​មួយ​ចំនួន​ដែល​បាន​ធ្វើ ខណៈ​សង្កត់​"
"គ្រាប់​ចុច ប្ដូរ (Shift) ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​បច្ចុប្បន្ន ។ នេះ​មាន​ប្រយោជន៍​"
"ជា​ពិសេស​ជាមួយ​ការ​កំណត់​កម្រិត​សំឡេង កម្រិត​ពណ៌ ពន្លឺ និង​សមាមាត្រ ប៉ុន្តែ​ធ្វើ​ការ​ផង​ដែរ​ជាមួយ​ជម្រើស​ផ្សេង​ទៀត​"
"ដែល​រាយ​ខាង​ក្រោម (ប៉ុន្តែ​មិន​បាន​ធីក) ។"

#. i18n: file: kplayersettingscontrols.ui:75
#. i18n: ectx: property (text), widget (QLabel, l_remember)
#: rc.cpp:2163
msgid "Always remember the following settings for each file"
msgstr "ចងចាំ​ការ​កំណត់​ដូច​ខាង​ក្រោម​នេះ​ជានិច្ច​សម្រាប់​ឯកសារ​នីមួយៗ"

#. i18n: file: kplayersettingscontrols.ui:78
#. i18n: ectx: property (toolTip), widget (QLabel, l_remember)
#: rc.cpp:2166
msgid ""
"Always remember any changes made to the settings selected below in the file "
"properties for the current file"
msgstr ""
"ចងចាំ​ការ​ផ្លាស់ប្ដូរ​មួយ​ចំនួន​ដែល​បាន​ធ្វើ​តាម​ការ​កំណត់​ដែល​បាន​ជ្រើស​ខាងក្រោម ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​"
"សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:81
#. i18n: ectx: property (whatsThis), widget (QLabel, l_remember)
#: rc.cpp:2169
msgid ""
"Option to choose whether to automatically remember any changes and "
"adjustments made to the settings you select below in the file properties for "
"the currently loaded file. The selected settings will be stored even if you "
"do not hold Shift. This is most useful for settings that are almost always "
"file specific, like subtitle URL, subtitle delay, and audio delay."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ការ​ផ្លាស់ប្ដូរ​ការ​ផ្លាស់ប្ដូរ​មួយ​ចំនួន និង​ការ​លៃ​តម្រូវ​ដែល​បាន​ធ្វើ​ទៅ​ការ​"
"កំណត់ ដែល​អ្នក​បាន​ជ្រើស​ខាង​ក្រោម ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​បច្ចុប្បន្ន ។ ការ​កំណត់​"
"ដែល​បាន​ជ្រើស​នឹង​ត្រូវ​បាន​រក្សា​ទុក ទោះបី​អ្នក​មិន​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) ។ នេះ​មាន​ប្រយោជន៍​សម្រាប់​"
"ការ​កំណត់​ដែល​ជា​ឯកសារ​ជាក់លាក់ ដូច​ជា URL ចំណង​ជើង​រង ការ​ពន្យារ​ចំណង​ជើង​រង និង​ការ​អន្យារ​អូឌីយ៉ូ ។"

#. i18n: file: kplayersettingscontrols.ui:121
#. i18n: ectx: property (text), widget (QCheckBox, c_size)
#: rc.cpp:2172
msgid "Display si&ze"
msgstr "ទំហំ​​បង្ហាញ"

#. i18n: file: kplayersettingscontrols.ui:124
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_size)
#: rc.cpp:2175
msgid ""
"Remember the display size you choose by resizing KPlayer window in the file "
"properties for the current file"
msgstr ""
"ចងចាំ​ទំហំ​បង្ហាញ ដែល​អ្នក​ជ្រើស​ដោយ​ប្ដូរ​ទំហំ​បង្អួច KPlayer ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​"
"បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:127
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_size)
#: rc.cpp:2178
msgid ""
"Option to choose whether to automatically remember the video display size "
"you choose by resizing the KPlayer window in the file properties for the "
"currently loaded file. If this option is not selected, you can still make "
"KPlayer remember the display size by holding down Shift key before and while "
"you resize the window."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ទំហំ​បង្ហាញ​វីដេអូ​ស្វ័យ​ប្រវត្តិ ដែល​អ្នក​ជ្រើស​ដោយ​ប្ដូរ​ទំហំ​បង្អួច KPlayer ក្នុង​"
"លក្ខណៈ​សម្បត្តិ​ឯកសារ សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​បច្ចុប្បន្ន ។ បើ​ជម្រើស​នេះ​មិន​ត្រូវ​បាន​ជ្រើស អ្នក​អាច​នៅ​តែ​"
"ធ្វើ​ឲ្យ KPlayer ចងចាំ​ទំហំ​បង្ហាញ​ដោយ​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) មុន​ពេល និង​ខណៈ​អ្នក​ប្ដូរ​ទំហំ​បង្អួច ។"

#. i18n: file: kplayersettingscontrols.ui:134
#. i18n: ectx: property (text), widget (QCheckBox, c_aspect)
#: rc.cpp:2181
msgid "Displa&y aspect"
msgstr "សមាមាត្រ​បង្ហាញ"

#. i18n: file: kplayersettingscontrols.ui:137
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_aspect)
#: rc.cpp:2184
msgid ""
"Remember the chosen video aspect in the file properties for the current file"
msgstr "ចងចាំ​សមាមាត្រ​វីដេអូ​ដែល​ជ្រើស ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:140
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_aspect)
#: rc.cpp:2187
msgid ""
"Option to choose whether to automatically remember the video aspect you "
"choose by using commands on View menu in the file properties for the "
"currently loaded file. If this option is selected, KPlayer will remember the "
"video aspect in the current file's properties, then automatically reset it "
"to the previous setting when another file is loaded. If this option is not "
"selected, you can still make KPlayer remember the video aspect by holding "
"down the Shift key when choosing an aspect command."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​សមាមាត្រ​វីដេអូ ដែល​អ្នក​ជ្រើស​ដោយ​ប្រើ​ពាក្យ​បញ្ជា​លើ​ម៉ឺនុយ មើល ក្នុង​លក្ខណៈ​"
"សម្បត្តិ​ឯកសារ សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​ថ្មីៗ ។ បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស KPlayer នឹង​ចងចាំ​សមាមាត្រ​"
"វីដេអូ​ក្នុង​លក្ខណៈ​សម្បត្តិ​របស់​ឯកសារ​បច្ចុប្បន្ន បន្ទាប់​កំណត់​វា​ឡើង​វិញ​ទៅ​ការ​កំណត់​មុន ពេល​ឯកសារ​មួយ​ផ្សេង​ទៀត​"
"ត្រូវ​បាន​ផ្ទុក ។ បើ​ជម្រើស​នេះ​មិន​ត្រូវ​បាន​ជ្រើស អ្នក​នៅ​តែ​អាច​ធ្វើ​ឲ្យ KPlayer ចងចាំ​សមាមាត្រ​វីដេអូ "
"ដោយ​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) ពេល​ជ្រើស​ពាក្យ​បញ្ជា​សមាមាត្រ ។"

#. i18n: file: kplayersettingscontrols.ui:150
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_full_screen)
#: rc.cpp:2193
msgid ""
"Remember the full screen display option in the file properties for the "
"current file"
msgstr "ចងចាំ​ជម្រើស​បង្ហាញ​អេក្រង់​ពេញ ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:153
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_full_screen)
#: rc.cpp:2196
msgid ""
"Option to choose whether to automatically remember the setting for the full "
"screen option you choose on the View menu in the file properties for the "
"currently loaded file. If this option is selected, KPlayer will remember the "
"full screen option in the current file's properties, then automatically "
"reset it to the previous setting when another file is loaded. If this option "
"is not selected, you can still make KPlayer remember the full screen option "
"by holding down the Shift key when choosing it."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ការ​កំណត់​សម្រាប់​ជម្រើស​អេក្រង់​ពេញ ដែល​អ្នក​ជ្រើស​លើ​ម៉ឺនុយ មើល ក្នុង​លក្ខណៈ​"
"សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​បច្ចុប្បន្ន ។ បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស KPlayer នឹង​ចងចាំ​ជម្រើស​"
"អេក្រង់​ពេញ ក្នុង​លក្ខណៈ​សម្បត្តិ​របស់​ឯកសារ​បច្ចុប្បន្ន បន្ទាប់​កំណត់​វា​ឡើង​វិញ​ដោយ​ស្វ័យ​ប្រវត្តិ​ទៅ​ការ​កំណត់​មុន "
"ពេល​ឯកសារ​មួយ​ទៀត​ត្រូវ​បាន​ផ្ទុក ។ បើ​ជម្រើស​នេះ​មិន​ត្រូវ​បាន​ជ្រើស អ្នក​នៅ​តែ​អាច​ធ្វើ​ឲ្យ KPlayer ចងចាំ​"
"ជម្រើស​អេក្រង់​ពេញ ដោយ​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) ពេល​ជ្រើស​វា ។"

