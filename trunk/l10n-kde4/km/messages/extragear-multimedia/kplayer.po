#. i18n: ectx: property (toolTip), widget (QLabel, l_osd_level)
#. i18n: ectx: property (toolTip), widget (QComboBox, c_osd_level)
#: kplayersettingsadvanced.ui:430 kplayersettingsadvanced.ui:458
msgid "Choose what to display inside the video area"
msgstr "ជ្រើស​អ្វី​ដែល​ត្រូវ​បង្ហាញ​ខាង​ក្នុង​ផ្ទៃ​វីដេអូ"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_osd_level)
#. i18n: ectx: property (whatsThis), widget (QComboBox, c_osd_level)
#: kplayersettingsadvanced.ui:433 kplayersettingsadvanced.ui:461
msgid ""
"Option to choose what to include in On Screen Display inside the video area. "
"Since KPlayer can display almost everything outside the video area, the "
"recommended choice is Subtitles Only."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​អ្វី​ដែល​ត្រូវ​រួម​បញ្ចូល​ក្នុង​ ពេល​បង្ហាញ​អេក្រង់ ខាង​ក្នុង​ផ្ទៃ​វីដេអូ ។ ពី​ព្រោះ KPlayer អាច​"
"បង្ហាញ​ស្ទើរ​តែ​អ្វី​ទាំងអស់​នៅ​ខាង​ក្រៅ​ផ្ទៃ​វីដេអូ ជម្រើស​ដែល​ផ្ដល់​អនុសាសន៍​គឺ​តែ តែ​ចំណង​ជើង ។"

#. i18n: ectx: property (text), widget (QLabel, l_osd_level)
#: kplayersettingsadvanced.ui:436
msgid "OSD le&vel:"
msgstr "កម្រិត OSD ៖"

#. i18n: ectx: property (text), item, widget (QComboBox, c_osd_level)
#: kplayersettingsadvanced.ui:465
msgid "subtitles only"
msgstr "តែ​ចំណង​ជើង​រង"

#. i18n: ectx: property (text), item, widget (QComboBox, c_osd_level)
#: kplayersettingsadvanced.ui:470
msgid "subtitles, volume and seek"
msgstr "ចំណង​ជើង​រង កម្រិត​សំឡេង និង​ស្វែងរក"

#. i18n: ectx: property (text), item, widget (QComboBox, c_osd_level)
#: kplayersettingsadvanced.ui:475
msgid "subtitles, volume, seek, timer and percentage"
msgstr "ចំណង​ជើង​រង កម្រិត​សំឡេង ស្វែងរក ម៉ោង និង​ភាគរយ"

#. i18n: ectx: property (text), item, widget (QComboBox, c_osd_level)
#: kplayersettingsadvanced.ui:480
msgid "subtitles, volume, seek, timer, percentage and total time"
msgstr "ចំណង​ជើង​រង កម្រិត​សំឡេង ស្វែងរក ឧបករណ៍​កំណត់​ពេល​វេលា ភាគរយ និង​ពេល​វេលា​សរុប"

#. i18n: ectx: property (toolTip), widget (QLabel, l_driver)
#. i18n: ectx: property (toolTip), widget (QComboBox, c_driver)
#: kplayersettingsaudio.ui:40 kplayersettingsaudio.ui:68
msgid "Audio output to use for playing sound"
msgstr "លទ្ធផល​អូឌីយ៉ូ​ត្រូវ​ប្រើ​សម្រាប់​ចាក់​សំឡេង"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_driver)
#. i18n: ectx: property (whatsThis), widget (QComboBox, c_driver)
#: kplayersettingsaudio.ui:43 kplayersettingsaudio.ui:71
msgid ""
"Option that lists available audio outputs and lets you choose the one to use "
"for playing sound. Recommended choices are OSS (the default) and ALSA "
"(recommended when available). ARTS and SDL are not recommended. Auto will "
"let MPlayer choose an audio output according to its own configuration. If "
"you need to specify more than one output separated by comma, set this option "
"to Auto and put them in Additional Command Line Arguments on Advanced page."
msgstr ""
"ជម្រើស​ដែល​រាយ​បញ្ជី​លទ្ធផល​អូឌីយ៉ូ​ដែល​មាន និង​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​មួយ​ដើម្បី​ប្រើ​សម្រាប់​ចាក់​សំឡេង ។ ជម្រើស​"
"ដែល​ផ្ដល់​អនុសាសន៍​គឺ OSS (លំនាំ​ដើម) និង ALSA (ផ្ដល់​អនុសាសន៍ ពេល​មាន) ។ ARTS និង SDL មិន​ត្រូវ​បាន​"
"ផ្ដល់​អនុសាសន៍ ។ ស្វ័យ​ប្រវត្តិ នឹង​អនុញ្ញាត​ឲ្យ MPlayer ជ្រើស​លទ្ធផល​អូឌីយ៉ូ​ផ្អែក​លើ​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ផ្ទាល់​"
"របស់​វា ។ បើ​អ្នក​ត្រូវ​ការ​បញ្ជាក់​លទ្ធផល​ច្រើន​ជាង​មួយ​ដែល​បំបែក​ដោយ​សញ្ញា​ក្បៀស កំណត់​ជម្រើស​នេះ​ទៅ ស្វ័យ​"
"ប្រវត្តិ និង​ដាក់​វា​ក្នុង​អាគុយម៉ង់​បន្ទាត់​បន្ថែម​នៅ​លើ​ទំព័រ​កម្រិត​ខ្ពស់ ។"

#. i18n: ectx: property (text), widget (QLabel, l_driver)
#: kplayersettingsaudio.ui:46
msgid "Output d&river:"
msgstr "កម្មវិធី​បញ្ជា​ចេញ ៖"

#. i18n: ectx: property (toolTip), widget (QLabel, l_device)
#. i18n: ectx: property (toolTip), widget (QComboBox, c_device)
#: kplayersettingsaudio.ui:78 kplayersettingsaudio.ui:106
msgid "Audio device to use for the chosen output"
msgstr "ឧបករណ៍​អូឌីយ៉ូ​ត្រូវ​ប្រើ​សម្រាប់​លទ្ធផល​ដែល​ជ្រើស"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_device)
#. i18n: ectx: property (whatsThis), widget (QComboBox, c_device)
#: kplayersettingsaudio.ui:81 kplayersettingsaudio.ui:109
msgid ""
"Option to specify audio device to use for the chosen audio output. Leave "
"blank to use the default device."
msgstr ""
"ជម្រើស​ត្រូវ​ជម្រើស​ឧបករណ៍​អូឌីយ៉ូ ត្រូវ​ប្រើ​សម្រាប់​លទ្ធផល​អូឌីយ៉ូ​ដែល​ជ្រើស ។ ទុក​ទទេ​ដើម្បី​ប្រើ​ឧបករណ៍​លំនាំ​ដើម ។"

#. i18n: ectx: property (text), widget (QLabel, l_device)
#: kplayersettingsaudio.ui:84
msgid "Output dev&ice:"
msgstr "ឧបករណ៍​បញ្ចេញ ៖"

#. i18n: ectx: property (toolTip), widget (QCheckBox, c_softvol)
#: kplayersettingsaudio.ui:119
