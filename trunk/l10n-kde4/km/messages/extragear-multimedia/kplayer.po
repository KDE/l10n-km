#. i18n: file: kplayerpropertiesadvanced.ui:130
#. i18n: ectx: property (toolTip), widget (QLabel, l_demuxer)
#. i18n: file: kplayerpropertiesadvanced.ui:151
#. i18n: ectx: property (toolTip), widget (KComboBox, c_demuxer)
#: rc.cpp:161 rc.cpp:167
msgid "Demultiplexer used for the file or stream"
msgstr "Demultiplexer ដែល​ប្រើ​សម្រាប់​ឯកសារ ឬ​ស្ទ្រីម"

#. i18n: file: kplayerpropertiesadvanced.ui:133
#. i18n: ectx: property (whatsThis), widget (QLabel, l_demuxer)
#. i18n: file: kplayerpropertiesadvanced.ui:154
#. i18n: ectx: property (whatsThis), widget (KComboBox, c_demuxer)
#: rc.cpp:164 rc.cpp:170
msgid ""
"Property that shows and allows you to change the demultiplexer used for the "
"file or stream. If the chosen demuxer fails, another one may be used."
msgstr ""
"លក្ខណៈ​សម្បត្តិ​ដែល​បង្ហាញ និង​អនុញ្ញាត​ឲ្យ​អ្នក​ផ្លាស់ប្ដូរ demultiplexer ដែល​ប្រើ​សម្រាប់​ឯកសារ ឬ​"
"ស្ទ្រីប ។ បើ demuxer ដែល​ជ្រើស​បរាជ័យ មួយ​ទៀត​នឹង​ត្រូវ​បាន​ប្រើ ។"

#. i18n: file: kplayerpropertiesadvanced.ui:161
#. i18n: ectx: property (text), widget (QLabel, l_frame_drop)
#: rc.cpp:173
msgid "&Frame drop"
msgstr "ទម្លាក់​ស៊ុម"

#. i18n: file: kplayerpropertiesadvanced.ui:170
#. i18n: ectx: property (toolTip), widget (QLabel, l_frame_drop)
#. i18n: file: kplayerpropertiesadvanced.ui:183
#. i18n: ectx: property (toolTip), widget (KComboBox, c_frame_drop)
#. i18n: file: kplayersettingsadvanced.ui:166
#. i18n: ectx: property (toolTip), widget (QLabel, l_frame_drop)
#. i18n: file: kplayersettingsadvanced.ui:188
#. i18n: ectx: property (toolTip), widget (KComboBox, c_frame_drop)
#: rc.cpp:176 rc.cpp:182 rc.cpp:1796 rc.cpp:1805
msgid "Choose whether and how MPlayer should drop frames"
msgstr "ជ្រើស​របៀប​ដែល MPlayer គួរ​ទម្លាក់​ស៊ុម"

#. i18n: file: kplayerpropertiesadvanced.ui:173
#. i18n: ectx: property (whatsThis), widget (QLabel, l_frame_drop)
#. i18n: file: kplayerpropertiesadvanced.ui:186
#. i18n: ectx: property (whatsThis), widget (KComboBox, c_frame_drop)
#: rc.cpp:179 rc.cpp:185
msgid ""
"If your system is too slow to play this file, MPlayer can drop some frames "
"so playback does not slow down. Default uses the default from KPlayer "
"Settings, None disables dropping, Soft drops fewer frames, and Hard drops "
"more frames and may sometimes break decoding. If you select a frame dropping "
"option from Player menu while holding Shift key, KPlayer will remember that "
"choice in this property for the currently loaded file."
msgstr ""
"បើ​ប្រព័ន្ធ​របស់​អ្នក​យឺត​ពេក​ក្នុង​ការ​ចាក់​ឯកសារ​នេះ MPlayer អាច​ទម្លាក់​ស៊ុម​មួយ​ចំនួន ដូច្នេះ​ការ​ចាក់​សារ​ថ្មី​"
"នឹង​មិន​យឺត​ទេ ។ លំនាំ​ដើម ប្រើ​លំនាំ​ដើម​ពី​ការ​កំណត់ KPlayer គ្មាន បិទ​ការ​ទម្លាក់ ស្រាល ទម្លាក់​ស៊ុម​ខ្លះ "
"និង ពិបាក ទម្លាក់​ស៊ុម​ច្រើន ហើយ​ពេល​ខ្លះ​អាច​ធ្វើ​ឲ្យ​ឌីកូដ​ខូច ។ បើ​អ្នក​ជ្រើស​ការ​ទម្លាក់​ស៊ុម​ពី​ម៉ឺនុយ កម្មវិធី​"
"ចាក់ ខណៈ​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) KPlayer នឹង​ចងចាំ​ជម្រើស​នោះ​ក្នុង​លក្ខណៈ​សម្បត្តិ​នេះ សម្រាប់​"
"ឯកសារ​ដែល​ផ្ទុក​ថ្មីៗ ។"

