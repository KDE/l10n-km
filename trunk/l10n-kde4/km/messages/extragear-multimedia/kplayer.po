#: rc.cpp:2360
msgid ""
"Remember subtitles' vertical position in the file properties for the current "
"file"
msgstr "ចងចាំ​ទីតាំង​បញ្ឈរ​របស់​ចំណង​ជើង ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:241
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_subtitle_position)
#: rc.cpp:2363
msgid ""
"Option to choose whether to automatically remember the subtitles' vertical "
"position in the file properties for the currently loaded file. If this "
"option is selected, KPlayer will remember the subtitles' position in the "
"current file's properties, then automatically reset the subtitles' position "
"when another file is loaded. If this option is not selected, you can still "
"make KPlayer remember the subtitles' position by holding down the Shift key "
"when changing it."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ទីតាំង​បញ្ឈរ​របស់​ចំណង​ជើង​រង ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​"
"បច្ចុប្បន្ន ។ បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស KPlayer នឹង​ចងចាំ​ទីតាំង​ចំណង​ជើង​រង​របស់​ឯកសារ​បច្ចុប្បន្ន "
"បន្ទាប់​កំណត់​ទីតាំង​របស់​ចំណង​ជើង​រង​ឡើង​វិញ​ដោយ​ស្វ័យ​ប្រវត្តិ ពេល​ឯកសារ​មួយ​ផ្សេង​ទៀត​ត្រូវ​បាន​ផ្ទុក ។ បើ​ជម្រើស​"
"នេះ​មិន​ត្រូវ​បាន​ជ្រើស អ្នក​អាច​នៅ​តែ​ធ្វើ​ឲ្យ KPlayer ចងចាំ​ទីតាំង​របស់​ចំណង​ជើង​រង ដោយ​សង្កត់​គ្រាប់​ចុច​ប្ដូរ "
"ពេល​ផ្លាស់ប្ដូរ​វា ។"

#. i18n: file: kplayersettingscontrols.ui:244
#. i18n: ectx: property (text), widget (QCheckBox, c_subtitle_position)
#: rc.cpp:2366
msgid "Subtitle po&sition"
msgstr "ទីតាំង​ចំណង​ជើង​រង"

#. i18n: file: kplayersettingscontrols.ui:251
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_subtitle_delay)
#: rc.cpp:2369
msgid "Remember the subtitle delay in the file properties for the current file"
msgstr "ចងចាំ​ការ​ពន្យារ​ចំណង​ជើង​រង ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:254
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_subtitle_delay)
#: rc.cpp:2372
msgid ""
"Option to choose whether to automatically remember the subtitle delay in the "
"file properties for the currently loaded file. If this option is selected, "
"KPlayer will remember the subtitle delay in the current file's properties, "
"then automatically reset the subtitle delay when another file is loaded. If "
"this option is not selected, you can still make KPlayer remember the "
"subtitle delay by holding down the Shift key when changing it."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ការ​ពន្យារ​ចំណង​ជើង​រង ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​"
"ថ្មីៗ ។ បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស KPlayer នឹង​ចងចាំ​ការ​ពន្យារ​ចំណង​ជើង​រង ក្នុង​លក្ខណៈ​សម្បត្តិ​របស់​"
"ឯកសារ​បច្ចុប្បន្ន បន្ទាប់​ការ​កំណត់​ការ​ពន្យារ​ចំណង​ជើង​ឡើង​វិញ​ស្វ័យ​ប្រវត្តិ ពេល​ឯកសារ​មួយ​ផ្សេង​ទៀត​ត្រូវ​បាន​"
"ផ្ទុក ។ បើ​ជម្រើស​មិន​ត្រូវ​បាន​ជ្រើស អ្នក​នៅ​តែ​អាច​ធ្វើ​ឲ្យ KPlayer ចងចាំ​ការ​ពន្យារ​ចំណង​ជើង​រង ដោយ​"
"សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) ពេល​ផ្លាស់ប្ដូរ​វា ។"

#. i18n: file: kplayersettingscontrols.ui:257
#. i18n: ectx: property (text), widget (QCheckBox, c_subtitle_delay)
#: rc.cpp:2375
msgid "Subtitle de&lay"
msgstr "ការ​ពន្យារ​ចំណង​ជើង​រង"

#. i18n: file: kplayersettingscontrols.ui:264
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_frame_drop)
#: rc.cpp:2378
msgid ""
"Remember frame dropping option in the file properties for the current file"
msgstr "ចងចាំ​ជម្រើស​ទម្លាក់​ស៊ុម ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:267
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_frame_drop)
#: rc.cpp:2381
msgid ""
"Option to choose whether to automatically remember the frame dropping option "
"in the file properties for the currently loaded file. If this option is "
"selected, KPlayer will remember the frame dropping option in the current "
"file's properties, then automatically reset frame dropping to the previous "
"setting when another file is loaded. If this option is not selected, you can "
"still make KPlayer remember frame dropping option by holding down the Shift "
"key when choosing it from the Player menu."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ជម្រើស​ទម្លាក់​ស៊ុម​ស្វ័យ​ប្រវត្តិ ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​ដែល​"
"ផ្ទុក​ថ្មីៗ ។ បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស KPlayer នឹង​ចងចាំ​ជម្រើស​ទម្លាក់​ស៊ុម ក្នុង​លក្ខណៈ​សម្បត្តិ​របស់​"
"ឯកសារ​បច្ចុប្បន្ន បន្ទាប់​កំណត់​ការ​ទម្លាក់​ស៊ុម​ស្វ័យ​ប្រវត្តិ​ទៅ​ការ​កំណត់​មុន ពេល​ឯកសារ​មួយ​ផ្សេង​ទៀត​ត្រូវ​បាន​ផ្ទុក "
"។ បើ​ជម្រើស​នេះ​មិន​ត្រូវ​បាន​ជ្រើស អ្នក​នៅ​តែ​អាច​ធ្វើ​ឲ្យ KPlayer ចងចាំ​ជម្រើស​ទម្លាក់​ស៊ុម ដោយ​សង្កត់​គ្រាប់​"
"ចុច ប្ដូរ (Shift) ពេល​ជ្រើស​វា​ពី​ម៉ឺនុយ Player ។"

#. i18n: file: kplayersettingscontrols.ui:270
#. i18n: ectx: property (text), widget (QCheckBox, c_frame_drop)
#: rc.cpp:2384
msgid "Frame dro&p"
msgstr "ទម្លាក់​ស៊ុម"

#. i18n: file: kplayersettingscontrols.ui:277
#. i18n: ectx: property (toolTip), widget (QLabel, l_remember)
#: rc.cpp:2387
msgid ""
"Always remember any changes made to the settings selected below in the file "
"properties for the current file"
msgstr ""
"ចងចាំ​ការ​ផ្លាស់ប្ដូរ​មួយ​ចំនួន​ដែល​បាន​ធ្វើ​តាម​ការ​កំណត់​ដែល​បាន​ជ្រើស​ខាងក្រោម ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​"
"សម្រាប់​ឯកសារ​បច្ចុប្បន្ន"

#. i18n: file: kplayersettingscontrols.ui:280
#. i18n: ectx: property (whatsThis), widget (QLabel, l_remember)
#: rc.cpp:2390
msgid ""
"Option to choose whether to automatically remember any changes and "
"adjustments made to the settings you select below in the file properties for "
"the currently loaded file. The selected settings will be stored even if you "
"do not hold Shift. This is most useful for settings that are almost always "
"file specific, like subtitle URL, subtitle delay, and audio delay."
msgstr ""
"ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ចងចាំ​ការ​ផ្លាស់ប្ដូរ​ការ​ផ្លាស់ប្ដូរ​មួយ​ចំនួន និង​ការ​លៃ​តម្រូវ​ដែល​បាន​ធ្វើ​ទៅ​ការ​"
"កំណត់ ដែល​អ្នក​បាន​ជ្រើស​ខាង​ក្រោម ក្នុង​លក្ខណៈ​សម្បត្តិ​ឯកសារ​សម្រាប់​ឯកសារ​ដែល​ផ្ទុក​បច្ចុប្បន្ន ។ ការ​កំណត់​"
"ដែល​បាន​ជ្រើស​នឹង​ត្រូវ​បាន​រក្សា​ទុក ទោះបី​អ្នក​មិន​សង្កត់​គ្រាប់​ចុច ប្ដូរ (Shift) ។ នេះ​មាន​ប្រយោជន៍​សម្រាប់​"
"ការ​កំណត់​ដែល​ជា​ឯកសារ​ជាក់លាក់ ដូច​ជា URL ចំណង​ជើង​រង ការ​ពន្យារ​ចំណង​ជើង​រង និង​ការ​អន្យារ​អូឌីយ៉ូ ។"

#. i18n: file: kplayersettingscontrols.ui:283
#. i18n: ectx: property (text), widget (QLabel, l_remember)
#: rc.cpp:2393
msgid "Always remember the following settings for each file"
msgstr "ចងចាំ​ការ​កំណត់​ដូច​ខាង​ក្រោម​នេះ​ជានិច្ច​សម្រាប់​ឯកសារ​នីមួយៗ"

#. i18n: file: kplayersettingsgeneral.ui:38
#. i18n: ectx: property (toolTip), widget (QCheckBox, c_resize_automatically)
#: rc.cpp:2396
msgid "Resize main window automatically to make video area the correct size"
msgstr "ប្ដូរ​ទំហំ​បង្អួច​មេ​ស្វ័យ​ប្រវត្តិ​ដើម្បី​ធ្វើ​ឲ្យ​ផ្ទៃ​វីដេអូ​មាន​ទំហំ​ត្រឹមត្រូវ"

#. i18n: file: kplayersettingsgeneral.ui:41
#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_resize_automatically)
#: rc.cpp:2399
msgid ""
"Option to choose whether to automatically resize main KPlayer window so that "
"the video area is of the desired size."
msgstr "ជម្រើស​ត្រូវ​ជ្រើស​ថា​តើ​ត្រូវ​ប្ដូរ​ទំហំ​បង្អួច KPlayer មេ ដើម្បី​ឲ្យ​ផ្ទៃ​វីដេអូ​ទៅ​ជា​ទំហំ​ដែល​ចង​បាន ។"

#. i18n: file: kplayersettingsgeneral.ui:44
#. i18n: ectx: property (text), widget (QCheckBox, c_resize_automatically)
#: rc.cpp:2402
msgid "R&esize main window automatically"
msgstr "ប្ដូរ​ទំហំ​បង្អួច​មេ​ស្វ័យ​ប្រវត្តិ"

