msgstr "ជម្រើស​ត្រូវ​បញ្ជាក់​ដែន​កំណត់​លើ​ការ​កំណត់​ពណ៌​លាំៗ​វីដេអូ ។"

#. i18n: file: kplayersettingshue.ui:173
#. i18n: ectx: property (toolTip), widget (QLabel, l_hue_step)
#. i18n: file: kplayersettingshue.ui:203
#. i18n: ectx: property (toolTip), widget (QLineEdit, c_hue_step)
#: rc.cpp:2418 rc.cpp:2424
msgid "Amount of adjustment to video hue when using Increase/Decrease commands"
msgstr "ចំនួន​លៃ​តម្រូវ​ពណ៌​លាំ​វីដេអូ ពេល​ប្រើ​ពាក្យ​បញ្ជា បង្កើន/បន្ថយ"

#. i18n: file: kplayersettingshue.ui:176
#. i18n: ectx: property (whatsThis), widget (QLabel, l_hue_step)
#. i18n: file: kplayersettingshue.ui:206
#. i18n: ectx: property (whatsThis), widget (QLineEdit, c_hue_step)
#: rc.cpp:2421 rc.cpp:2427
msgid ""
"Option to specify the amount by which to change video hue when using "
"Increase/Decrease Hue commands on Player/Video menu or the corresponding "
"keyboard shortcuts."
msgstr ""
"ជម្រើស​ត្រូវ​បញ្ជាក់​ចំនួន ដែល​ត្រូវ​ផ្លាស់ប្ដូរ​ពណ៌​លាំៗ​វីដេអូ ពេល​ប្រើ​ពាក្យ​បញ្ជា​ពណ៌​លាំៗ​បង្កើន/បន្ថយ លើ​ម៉ឺនុយ​"
"កម្មវិធី​ចាក់/វីដេអូ ឬ​ផ្លូវកាត់​ក្ដារ​ចុច​ដែល​ដូច​គ្នា ។"

