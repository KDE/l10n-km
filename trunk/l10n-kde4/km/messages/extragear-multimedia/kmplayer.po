msgstr "FFmpeg deinterlacer"

#: pref.cpp:827
msgid "Enable mplayer's default postprocessing filters"
msgstr "បើក​តម្រង​ក្រោយ​ដំណើរការ​លំនាំដើម​​របស់ mplayer"

#: pref.cpp:828
msgid "Enable custom postprocessing filters (See: Custom preset -tab)"
msgstr "បើក​តម្រង​ក្រោយ​ដំណើរការ​ផ្ទាល់ខ្លួន​ (សូម​មើល ៖ ផ្ទាំង​កំណត់​ជា​មុន​ផ្ទាល់ខ្លួន)"

#: pref.cpp:829
msgid "Enable mplayer's fast postprocessing filters"
msgstr "បើក​តម្រង​ក្រោយ​ដំណើរការ​លឿន​របស់ mplayer"

#: pref.cpp:832 pref.cpp:833 pref.cpp:834
msgid "Filter is used if there is enough CPU"
msgstr "តម្រង​ត្រូវ​បាន​ប្រើ​ ប្រសិនបើ​មាន​ស៊ីភីយូ​គ្រប់គ្រាន់"

#: pref.cpp:836
msgid "Stretches luminance to full range (0..255)"
msgstr "ទាញ​ពន្លឺ​ទៅ​ជួរ​ពេញលេញ (0..255)"

#: pref.cpp:837
msgid "Custom Preset"
msgstr "កំណត់​ជា​មុន​ផ្ទាល់ខ្លួន"

#: pref.cpp:839
msgid "Deinterlacing"
msgstr "មិនត្របាញ់"

