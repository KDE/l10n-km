msgid "Example: mount %d"
msgstr "ឧទាហរណ៍ ៖ mount %d"

#: dialogs/deviceconfiguredialog.cpp:79
#, c-format
msgid ""
"Set a command to be run before connecting to your device (e.g. a mount "
"command) here.\n"
"%d is replaced by the device node, %m by the mount point.\n"
"Empty commands are not executed."
msgstr ""
"កំណត់​ពាក្យបញ្ជា​ដែលត្រូវ​រត់​មុន​ពេល​តភ្ជាប់​ទៅកាន់​ឧបករណ៍​របស់​អ្នក (ឧ. ពាក្យ​បញ្ជា mount) នៅ​ទីនេះ ។\n"
"%d ត្រូវ​បាន​ជំនួស​ដោយ​ថ្នាំង​ឧបករណ៍ ហើយ %m គឺ​ដោយ​ចំណុច​ម៉ោន ។\n"
"ពាក្យ​បញ្ជា​ទទេ​មិន​ត្រូវ​បាន​ប្រតិបត្តិ​ទេ ។"

#: dialogs/deviceconfiguredialog.cpp:82
msgid "Post-&disconnect command:"
msgstr "ពាក្យបញ្ជា​ក្រោយ​តភ្ជាប់ ៖"

#: dialogs/deviceconfiguredialog.cpp:85
#, c-format
msgid "Example: eject %d"
msgstr "ឧទាហរណ៍ ៖ eject %d"

#: dialogs/deviceconfiguredialog.cpp:86
#, c-format
msgid ""
"Set a command to be run after disconnecting from your device (e.g. an eject "
"command) here.\n"
"%d is replaced by the device node, %m by the mount point.\n"
"Empty commands are not executed."
msgstr ""
"កំណត់​ពាក្យ​បញ្ជា​ដែលត្រូវ​រត់​បន្ទាប់​ពី​ផ្ដាច់​​ចេញ​ពី​ឧបករណ៍​របស់​អ្នក (ឧ. ពាក្យ​បញ្ជា eject) នៅ​ទីនេះ ។\n"
"%d ត្រូវ​បាន​ជំនួស​ដោយ​ឧបករណ៍ និង %m គឺ​ដោយ​ចំណុច​ម៉ោន ។\n"
"ពាក្យ​បញ្ជា​ទទេ​មិន​ត្រូវ​បាន​ប្រតិបត្តិ​ឡើយ ។"

