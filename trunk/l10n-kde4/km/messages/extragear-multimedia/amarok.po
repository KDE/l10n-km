#: dialogs/EditFilterDialog.cpp:57
msgid ""
"<qt><p>By clicking here you can add the defined condition. The \"OK\" button "
"will close the dialog and apply the defined filter. With this button you can "
"add more than one condition to create a more complex filtering condition.</"
"p></qt>"
msgstr ""
"<qt><p>ដោយ​ចុច​នៅ​ទីនេះ អ្នក​អាច​បន្ថែម​លក្ខខណ្ឌ​ដែល​បាន​កំណត់​បាន ។ ប៊ូតុង \"យល់ព្រម\" នឹង​បិទ​ប្រអប់ ហើយ​​"
"អនុវត្ត​តម្រង​ដែល​បាន​កំណត់ ។ ជាមួយ​ប៊ូតុង​នេះ អ្នក​អាច​បន្ថែម​លក្ខខណ្ឌ​ច្រើន​ជាង​មួយ​ដើម្បី​បង្កើត​លក្ខខណ្ឌ​ត្រង​"
"ស្មុគស្មាញ ។</p></qt>"

#: dialogs/EditFilterDialog.cpp:60
msgid "Add this filter condition to the list"
msgstr "បន្ថែម​លក្ខខណ្ឌ​តម្រង​ទៅ​បញ្ជី"

#: dialogs/EditFilterDialog.cpp:64
msgid "&Clear"
msgstr "ជម្រះ"

#: dialogs/EditFilterDialog.cpp:65
msgid ""
"<p>By clicking here you will clear the filter. If you intend to undo the "
