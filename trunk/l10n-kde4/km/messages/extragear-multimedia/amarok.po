#: configdialog/dialogs/OsdConfig.cpp:64
#, kde-format
msgid ""
"<h3>Tags Displayed in OSD</h3>You can use the following tokens:<ul><li>Title "
"- %1<li>Album - %2<li>Artist - %3<li>Genre - %4<li>Bitrate - %5<li>Year - %"
"6<li>Track Length - %7<li>Track Number - %8<li>Filename - %9<li>Directory - %"
"10<li>Type - %11<li>Comment - %12<li>Score - %13<li>Playcount - %14<li>Disc "
"Number - %15<li>Rating - %16<li>Moodbar - %17<li>Elapsed Time - %18</ul>If "
"you surround sections of text that contain a token with curly-braces, that "
"section will be hidden if the token is empty, for example:<pre>%19</pre>Will "
"not show <b>Score: <i>%score</i></b> if the track has no score."
msgstr ""
"<h3>ស្លាក​ដែល​បាន​បង្ហាញ​ក្នុង OSD</h3>គឺ​អ្នក​អាច​ប្រើ​ថូខិន​ដូចខាងក្រោម ៖<ul><li>ចំណងជើង - %"
"1<li>អាល់ប៊ុម - %2<li>​សិល្បករ - %3<li>​ចង្វាក់ - %4<li>​អត្រាប៊ីត - %5<li>ឆ្នាំ - %"
"6<li>ប្រវែង​បទ - %7<li>លេខ​បទ - %8<li>​ឈ្មោះ​ឯកសារ - %9<li>ថត - %10<li>​ប្រភេទ - %"
"11<li>​សេចក្ដី​អធិប្បាយ - %12<li>​ពិន្ទុ - %13<li>​ចំនួន​ចាក់ - %14<li>​លេខ​ឌីស - %15<li>ការ​វាយ​"
"តម្លៃ - %16<li>​របារ​រុករក - %17<li>ពេល​​ដែល​កន្លង​ទៅ - %18</ul>ប្រសិន​បើ​អ្នក​នៅ​ជុំវិញ​ផ្នែក​"
"អត្ថបទ​ដែលមាន​ថូខិន​ដែលមាន​វង់ក្រចក​អង្កាញ់ៗ នោះ​ផ្នែក​នោះ​នឹង​ត្រូវបាន​លាក់​ប្រសិន​បើ​ថូខិន​ទទេ ឧទាហរណ៍ ៖"
"<pre>%19</pre>នឹង​មិនបង្ហាញ <b>ពិន្ទុ ៖ <i>%score</i></b> ទេ ប្រសិន​បើ​បទ​នោះ​មិនមាន​ពិន្ទុ​"
"នោះ ។"

