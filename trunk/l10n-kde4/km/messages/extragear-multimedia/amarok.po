#: browsers/filebrowser/FileBrowser.cpp:179
msgid ""
"<p>Here you can enter a path for a folder to display.</p><p>To go to a "
"folder previously entered, press the arrow on the right and choose one.</"
"p><p>The entry has folder completion. Right-click to choose how completion "
"should behave.</p>"
msgstr ""
"<p>នៅ​ទីនេះ អ្នក​អាច​បញ្ចូល​ផ្លូវ​សម្រាប់​ថត​ដែលត្រូវបង្ហាញ ។</p><p>ដើម្បី​ទៅកាន់​ថត​ដែលបាន​បញ្ចូល​ពី​"
"ពេលមុន សូម​សង្កត់​គ្រាប់ចុច​ព្រួញ​នៅ​ខាងស្ដាំ ហើយ​ជ្រើស​វា​មួយ ។</p><p>ធាតុ​មាន​ការ​បំពេញ​ថត ។ ចុច​កណ្ដុរ​"
"ខាងស្ដាំ ដើម្បី​ជ្រើស​របៀប​បំពេញ ។</p>"

#: browsers/filebrowser/FileBrowser.cpp:183
msgid ""
"<p>Here you can enter a name filter to limit which files are displayed.</"
"p><p>To clear the filter, toggle off the filter button to the left.</p><p>To "
"reapply the last filter used, toggle on the filter button.</p>"
msgstr ""
"<p>នៅទីនេះ អ្នក​អាច​បញ្ចូល​ឈ្មោះ​តម្រង​ ដើម្បី​កំណត់​ឯកសារ​ដែលត្រូវ​បង្ហាញ ។</p><p>ដើម្បី​ជម្រះ​តម្រង សូម​"
"បិទ​ប៊ូតុង​តម្រង​ទៅ​ខាងឆ្វេង ។</p><p>ដើម្បី​អនុវត្ត​​តម្រង​ដែល​បានប្រើ​ពីពេល​មុន​ឡើងវិញ សូម​បើក​ប៊ូតុង​តម្រង ។</"
"p>"

#: browsers/filebrowser/FileBrowser.cpp:186
msgid ""
"<p>This button clears the name filter when toggled off, or reapplies the "
"last filter used when toggled on.</p>"
msgstr ""
"<p>ប៊ូតុង​នេះ ជម្រះ​តម្រង​ឈ្មោះ​នៅពេល​ដែល​បិទ ឬ​អនុវត្ត​តម្រង​ដែលបាន​ប្រើ​ពីពេល​មុន​ឡើងវិញ នៅពេល​បើក ។</"
"p>"

