msgid "Kate Snippets"
msgstr "អត្ថបទ​ខ្លី​​របស់​ Kate "

#: jowennsnippets.cpp:247
msgid "Kate Snippets Settings"
msgstr "ការ​កំណត់​អត្ថបទ​ខ្លី​របស់​ Kate "

#: jowennsnippets.cpp:285
msgid "Create snippet"
msgstr "បង្កើត​អត្ថបទ​​ខ្លី​"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ម៉ន ម៉េត, សេង សុត្ថា"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,​​mornmet@khmeros.info,sutha@khmeros.info"

#. i18n: file: ui.rc:5
#. i18n: ectx: Menu (tools)
#: rc.cpp:5
msgid "&Tools"
msgstr "ឧបករណ៍​"

#: selector.cpp:43
msgid ""
"Add current text selection to a snippet file (click=add to on-the-go, "
"hold=menu=more options)"
msgstr ""
"បន្ថែម​ជម្រើស​អត្ថបទ​បច្ចុប្បន្ន​​​ទៅកាន់​​ឯកសារ​អត្ថបទ​​ខ្លី​​ៗ (ចុច​=​បន្ថែម​ ដើម្បី​បន្ត​ ប្រើ=ម៉ឺនុយ​=​ជម្រើស​បន្ថែម​"
")"

#: selector.cpp:45
msgid "Modify the current snippet"
msgstr "កែប្រែ​អត្ថបទ​ខ្លី​បច្ចុប្បន្ន​"

#: selector.cpp:47
msgid "Create a new repository file"
msgstr "បង្កើត​ឯកសារ​​របស់​ឃ្លាំង​ថ្មី​"

#: selector.cpp:49
msgid "Manage the snippet repository"
msgstr "គ្រប់គ្រង​ឃ្លាំង​របស់​​អត្ថបទ​ខ្លី​"

#: selector.cpp:240
msgid ""
"Developer's fault! Your editor component doesn't support the retrieval of "
"certain\n"
"information, please press this button longer to open the menu for manual\n"
"destination selection"
msgstr ""
"កំហុស​របស់​អ្នក​អភិវឌ្ឍន៍​! សមាសភាគ​របស់​កម្មវិធី​កែ​សម្រួល​របស់​អ្នក​​មិន​អាច​គាំទ្រ​ព័ត៌មាន​ដែល​បាន​មក​\n"
"សូម​ចុច​ប៊ូតុង​នេះ​ ដើម្បី​បើក​ម៉ឺនុយ​ សម្រាប់​​សៀវភៅ​ដៃ​​\n"
"ជម្រើស​ទិសដៅ​"

#: selector.cpp:250
msgid "Should not happen, cannot add snippet to a repository"
msgstr "មិនគួរ​កើត​ឡើង​ទេ មិនអាច​បន្ថែម snippet ទៅ​ឃ្លាំង​បាន​ទេ"

