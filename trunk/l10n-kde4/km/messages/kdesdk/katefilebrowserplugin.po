#~ msgid ""
#~ "<p>Here you can enter a name filter to limit which files are displayed.</"
#~ "p><p>To clear the filter, toggle off the filter button to the left.</"
#~ "p><p>To reapply the last filter used, toggle on the filter button.</p>"
#~ msgstr ""
#~ "<p>នៅ​ទីនេះ​អ្នក​អាច​បញ្ចូល​តម្រង​ឈ្មោះ​ដើម្បី​កំណត់​ថាតើ​ឯកសារ​មួយ​ណា​ត្រូវ​បង្ហាញ ។</p><p>ដើម្បី​ជម្រះ​"
#~ "តម្រង បិទ​ប៊ូតុង​តម្រង​ទៅ​ខាង​ឆ្វេង ។</p><p>ដើម្បី​អនុវត្ត​​តម្រង​ដែល​បាន​ប្រើ​ឡើងវិញ បើក​ប៊ូតុង​តម្រង ។</"
#~ "p>"

#~ msgid ""
#~ "<p>This button clears the name filter when toggled off, or reapplies the "
#~ "last filter used when toggled on.</p>"
#~ msgstr ""
#~ "<p>ប៊ូតុង​នេះ​ជម្រះ​តម្រង​ឈ្មោះ​នៅ​ពេល​បិទ ឬ​អនុវត្ត​តម្រង​ចុងក្រោយ​ឡើងវិញ​​ដែល​បាន​ប្រើ​នៅ​ពេល​បើក ។</p>"

#~ msgid "Apply last filter (\"%1\")"
#~ msgstr "អនុវត្ត​តម្រង​ចុងក្រោយ (\"%1\")"

