#: contactsresource.cpp:59
msgid "Personal Contacts"
msgstr "ទំនាក់ទំនង​ផ្ទាល់ខ្លួន"

#: contactsresource.cpp:139
#, kde-format
msgid "Directory '%1' does not exists"
msgstr "មិនទាន់មាន​ថត '%1' នៅ​ឡើយ​ទេ"

#: contactsresource.cpp:161 contactsresource.cpp:205
#, kde-format
msgid "Found file of unknown format: '%1'"
msgstr "រកឃើញ​ឯកសារ​ដែល​មិន​ស្គាល់ទ្រង់ទ្រាយ ៖ '%1'"

#: contactsresource.cpp:179
#, kde-format
msgid "Unable to open file '%1'"
msgstr "មិនអាច​បើក​ឯកសារ '%1' បាន​ទេ"

#: contactsresource.cpp:189
#, kde-format
msgid "Found invalid contact in file '%1'"
msgstr "រកឃើញ​ទំនាក់ទំនង​មិន​ត្រឹមត្រូវ​នៅ​ក្នុង​ឯកសារ '%1'"

#: contactsresource.cpp:199
#, kde-format
msgid "Found invalid contact group in file '%1': %2"
msgstr "រកឃើញ​ក្រុម​ទំនាក់ទំនង​មិន​ត្រឹមត្រូវ​នៅ​ក្នុង​ឯកសារ '%1': %2"

#: contactsresource.cpp:219 contactsresource.cpp:348 contactsresource.cpp:369
#: contactsresource.cpp:423
#, kde-format
msgid "Trying to write to a read-only directory: '%1'"
msgstr "ព្យាយាម​សរសេរ​ទៅ​ថតដែល​មាន​តែ​អាន ៖ '%1'"

#: contactsresource.cpp:237 contactsresource.cpp:253 contactsresource.cpp:289
#: contactsresource.cpp:302
#, kde-format
msgid "Unable to write to file '%1': %2"
msgstr "មិនអាច​សរសេរ​ទៅ​ឯកសារ '%1': %2 បាន​ទេ"

#: contactsresource.cpp:273 contactsresource.cpp:323
#, kde-format
msgid "Trying to write to a read-only file: '%1'"
msgstr "ព្យាយាម​សរសេរ​ទៅ​ឯកសារ​ដែលបាន​តែ​អាន ៖ '%1'"

#: contactsresource.cpp:313
#, kde-format
msgid "Received item with unknown payload %1"
msgstr "ធាតុដែល​បាន​ទទួល​ធាតុ​ដែល​មិន​ស្គាល់​តម្លៃ​ %1"

#: contactsresource.cpp:338
#, kde-format
msgid "Unable to remove file '%1'"
msgstr "មិនអាច​យក​ឯកសារ '%1' ចេញ​បាន​ទេ"

#: contactsresource.cpp:355
#, kde-format
msgid "Unable to create folder '%1'."
msgstr "មិនអាច​បង្កើត​ថត '%1' បាន​ទេ ។"

#: contactsresource.cpp:389
#, kde-format
msgid "Unable to rename folder '%1'."
msgstr "មិនអាច​ប្ដូរ​ឈ្មោះ​ថត '%1' បាន​ទេ ។"

#: contactsresource.cpp:428
#, kde-format
msgid "Unable to delete folder '%1'."
msgstr "មិនអាច​លុប​ថត '%1' បាន​ទេ ។"

#: contactsresource.cpp:444
#, kde-format
msgid "Unable to move file '%1' to '%2', '%2' already exists."
msgstr "មិនអាច​ផ្លាស់ទី​ឯកសារ '%1' ទៅ '%2' បាន​ទេ ដោយ​សារ​តែ​មាន '%2' រួច​ហើយ ។"

#: contactsresource.cpp:456
#, kde-format
msgid "Unable to move directory '%1' to '%2', '%2' already exists."
msgstr "មិនអាច​ផ្លាស់ទី​ថត '%1' ទៅ '%2' បានទេ ដោយ​សារ​តែ​មាន​ថត '%2' រួច​ហើយ ។"

#. i18n: file: settingsdialog.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:3
msgid "Directory Name"
msgstr "ឈ្មោះ​ថត"

#. i18n: file: settingsdialog.ui:25
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:6
msgid "&Directory:"
msgstr "ថត ៖"

#. i18n: file: settingsdialog.ui:40
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:9
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"ជ្រើស​ថត​ដែល​មាតិកា​របស់​វា​គួរ​ត្រូវ​បានបង្ហាញ​ដោយ​ធនធាន​នេះ ។ ប្រសិនបើ​មិន​ទាន់​មាន​ថត​ទេ វា​នឹង​ត្រូវ​"
"បានបង្កើត​ឡើង ។"

#. i18n: file: settingsdialog.ui:53
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:12
msgid "Access Rights"
msgstr "សិទ្ធិ​ចូលដំណើរការ"

#. i18n: file: settingsdialog.ui:59
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: rc.cpp:15
msgid "Read only"
msgstr "បានតែ​អាន"

#. i18n: file: settingsdialog.ui:66
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:18
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"ប្រសិនបើ​បើក​របៀប​បាន​តែ​អាន គ្មានការ​ផ្លាស់ប្ដូរ​នឹង​ត្រូវបាន​សរសេរ​ទៅ​ថត​ដែល​បាន​ជ្រើស​ខា​ងលើ​ទេ ។ របៀប​"
"បានតែ​អាន​នឹង​ត្រូវ​បានបើក​ដោយ​ស្វ័យ​ប្រវត្តិ ប្រសិនបើ​អ្នក​មិនមាន​សិទ្ធិ​សរសេរ​ទៅកាន់​ថត ។"

#. i18n: file: wizard/contactswizard.ui:19
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:21
msgid "Filename:"
msgstr "ឈ្មោះ​ឯកសារ ៖"

#. i18n: file: contactsresource.kcfg:10
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:24
msgid "Path to contacts directory"
msgstr "ផ្លូវ​​ទៅ​កាន់​ថត​ទំនាក់ទំនង"

#. i18n: file: contactsresource.kcfg:14
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:27
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ផ្នែកខាងក្រោយ​ពិតប្រាកដ ។"
