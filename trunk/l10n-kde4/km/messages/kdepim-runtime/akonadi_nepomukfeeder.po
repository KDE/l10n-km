#: feederqueue.cpp:136 nepomukfeederagent.cpp:327
#, kde-format
msgid "Indexing collection '%1'..."
msgstr "កំពុង​ធ្វើ​លិបិក្រម​ការ​សម្រាំង​ '%1'...​"

#: feederqueue.cpp:238
msgid "Indexing completed."
msgstr "ធ្វើ​លិបិក្រម​បាន​បញ្ចប់​ទាំងស្រុង​ ។"

#: feederqueue.cpp:265 nepomukfeederagent.cpp:278
msgid "Ready to index data."
msgstr "ទៅកាន់​ទិន្នន័យ​លិបិក្រម​រួចហើយ​"

#: nepomukfeederagent.cpp:231
msgid "Indexing has been disabled by you."
msgstr "អ្នក​បាន​បិទ​ការ​ធ្វើ​លិបិក្រម​ហើយ ។"

#: nepomukfeederagent.cpp:241
msgid "Unable to start the Nepomuk server."
msgstr "មិន​អាច​ចាប់ផ្ដើម​ម៉ាស៊ីន​បម្រើ​របស់​​ Nepomuk បាន​ឡើយ​ ។​"

#: nepomukfeederagent.cpp:247 nepomukfeederagent.cpp:256
msgid "Waiting for the Nepomuk server to start..."
msgstr "កំពុង​រង់ចាំ​ម៉ាស៊ីន​បម្រើ​របស់​​ Nepomuk ដើម្បី​ចាប់ផ្ដើម​​...​"

#: nepomukfeederagent.cpp:259
msgid "Nepomuk is not running."
msgstr "Nepomuk មិន​កំពុង​ដំណើរការ​ឡើយ​ ។​"

#: nepomukfeederagent.cpp:284
#, kde-format
msgid "Nepomuk is not operational: %1"
msgstr "Nepomuk គ្មាន​ប្រតិបត្តិការ​ឡើយ​​ ៖ %1"

#: nepomukfeederagent.cpp:329
msgid "Indexing recent changes..."
msgstr "កំណត់​ដាក់​លិបិក្រម​ការ​ផ្លាស់ប្ដូរ​ថ្មី..."

#: nepomukfeederagent.cpp:338
msgid "System idle, ready to index data."
msgstr "ប្រព័ន្ធ​ទំនេរ​​ អាច​ដាក់​លិបិក្រម​ទិន្នន័យ​បាន ។"

#: nepomukfeederagent.cpp:349
msgid "System busy, indexing suspended."
msgstr "ប្រព័ន្ធ​រវល់ កា​រដាក់​លិបិក្រម​បានផ្អាក ។"

#~ msgid "A blacklisted backend is used: '%1'."
#~ msgstr "កម្ម​វិធី​ខាងក្រោយ​ដែល​កត់​ចូល​ក្នុង​បញ្ជី​ខ្មៅ​ត្រូវ​បាន​ប្រើ​ ៖​​ '%1' ។"

#~ msgid "Calling the Nepomuk storage service failed: '%1'."
#~ msgstr "បាន​បរាជ័យ​ហៅ​សេវា​ផ្ទុក​របស់​​ Nepomuk ៖ '%1' ។"

#~ msgid "Nepomuk backend for Strigi is not available."
#~ msgstr "គ្មាន​កម្ម​វិធី​ខាងក្រោយ​របស់​ Nepomuk ​សម្រាប់ Strigi ឡើយ​"

#~ msgid ""
#~ "<b>Nepomuk Indexing Agents Have Been Disabled</b><br/>The Nepomuk service "
#~ "is not available or fully operational and attempts to rectify this have "
#~ "failed. Therefore indexing of all data stored in the Akonadi PIM service "
#~ "has been disabled, which will severely limit the capabilities of any "
#~ "application using this data.<br/><br/>The following problems were "
#~ "detected:<ul><li>%1</li></ul>Additional help can be found here: <a href="
#~ "\"http://userbase.kde.org/Akonadi\">userbase.kde.org/Akonadi</a>"
#~ msgstr ""
#~ "<b>បាន​បិទ​ភ្នាក់ងារ​ធ្វើ​លិបិក្រម​របស់​ Nepomuk ​</b><br/>គ្មាន​សេវា​របស់​​ Nepomuk ​ ឬ​ "
#~ "ប្រតិបត្តិការ​ពេញលេញ​​ ​ ហើយ​ការ​ព្យាយាម ដើម្បី​កែតម្រូវ​វា​ត្រូវ​បាន​បរាជ័យ​ ។​ ដូច្នេះ​​ ការ​ធ្វើ​លិបិក្រម​"
#~ "ទិន្នន័យ​ទាំងអស់​ដែល​បាន​ទុក​ក្នុង​សេវា​របស់​​​ Akonadi PIM ត្រូវ​បាន​បិទ​​ ដែល​នឹង​កំណត់​ឲ្យ​មាន​សមត្ថភាព​របស់​​​​"
#~ "កម្មវិធី​មួយ​ចំនួន​ដោយ​ប្រើ​ទិន្នន័យ​នេះ​ ។ ​<br/><br/> បញ្ហា​ខាងក្រោម​ត្រូវ​បាន​រក​ឃើញ​ ៖​<ul><li>%1</"
#~ "li></ul>ជំនួយ​បន្ថែម​អាច​រក​ឃើញ​នៅ​ទី​នេះ​ ៖​​ <a href=\"http://userbase.kde.org/Akonadi"
#~ "\">userbase.kde.org/Akonadi</a>"

#~ msgid "Nepomuk Indexing Disabled"
#~ msgstr "បាន​បិទ​ការ​ធ្វើ​លិបិក្រម​របស់​ Nepomuk ​"

#~ msgid "Strigi is not available for indexing."
#~ msgstr "គ្មាន​ Strigi សម្រាប់​ការ​ធ្វើ​លិបិក្រម​ឡើយ​ ។​"
