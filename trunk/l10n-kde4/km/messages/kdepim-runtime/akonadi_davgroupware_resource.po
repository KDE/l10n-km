#: setupwizard.cpp:133
msgid "DAV groupware configuration wizard"
msgstr "អ្នក​ជំនួយ​ការ​កំណត់​រនាសម្ព័ន្ធ​​របស់ DAV groupware"

#: setupwizard.cpp:198
msgid "Login Credentials"
msgstr "ចូលដោយ​សម្ងាត់"

#: setupwizard.cpp:199
msgid "Enter your credentials to login to the groupware server"
msgstr "បញ្ចូល​ភាព​សម្ងាត់​របស់​អ្នក ដើម្បី​ចូល​ក្នុង​ម៉ាស៊ីនបម្រើ groupware"

#: setupwizard.cpp:204
msgid "User"
msgstr "អ្នកប្រើ"

#: setupwizard.cpp:239
msgid "Predefined provider found"
msgstr "រក​ឃើញ​ក្រុមហ៊ុន​ផ្ដល់ដែលបាន​កំណត់​​ជា​មុន"

#: setupwizard.cpp:240
msgid "Select if you want to use the auto-detected provider"
msgstr "ជ្រើស​ប្រសិនបើ​អ្នក​ចង់​ប្រើក្រុមហ៊ុន​ផ្ដល់​ដែល​រកឃើញ​ដោយ​ស្វ័យ​ប្រវត្តិ"

#: setupwizard.cpp:255
msgid "No, choose another server"
msgstr "ទេ ជ្រើស​ម៉ាស៊ីន​បម្រើ​ផ្សេង"

#: setupwizard.cpp:262
#, kde-format
msgid ""
"Based on the email address you used as a login, this wizard\n"
"can configure automatically an account for %1 services.\n"
"Do you wish to do so?"
msgstr ""
"ដោយ​ផ្អែក​លើ​អាសយដ្ឋាន​អ៊ីមែល អ្នក​បាន​ប្រើនៅ​ពេល​ចូល អ្នក​ជំនួយ​ការ​នេះ​អាច​កំណត់​រចនាសម្ព័ន្ធ​គណនី​ដោយ​ស្វ័យ​"
"ប្រវត្តិ​ សម្រាប់​សេវា %1 ។\n"
"តើ​អ្នក​ចង់​ធ្វើ​ដូច្នេះ​ដែរឬទេ ?"

#: setupwizard.cpp:266
#, kde-format
msgid "Yes, use %1 as provider"
msgstr "បាទ/ចាស ប្រើ %1 ដូច​របស់​ក្រុមហ៊ុន​ផ្ដល់"

#: setupwizard.cpp:288
msgid "Groupware Server"
msgstr "ម៉ាស៊ីន​បម្រើ Groupware"

#: setupwizard.cpp:289
msgid "Select the groupware server the resource shall be configured for"
msgstr "ជ្រើស​ម៉ាស៊ីន​បម្រើ groupware ដែល​ធនធាន​នឹង​​ត្រូវ​បាន​កំណត់​រចនាសម្ព័ន្ធ"

#: setupwizard.cpp:308
msgid "Use one of those servers:"
msgstr "ប្រើ​មួយ​របស់​ម៉ាស៊ីនបម្រើ​ទាំងនោះ ៖"

#: setupwizard.cpp:318
msgid "Configure the resource manually"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​ធនធាន​ដោយ​ដៃ"

#: setupwizard.cpp:354
msgid "Connection"
msgstr "ការ​តភ្ជាប់"

#: setupwizard.cpp:355
msgid "Enter the connection information for the groupware server"
msgstr "បញ្ចូល​ព័ត៌មាន​តភ្ជាប់​សម្រាប់​ម៉ាស៊ីន​បម្រើ groupware"

#: setupwizard.cpp:363
msgid "Host"
msgstr "ម៉ាស៊ីន"

#: setupwizard.cpp:366
msgid "Installation path"
msgstr "ផ្លូវ​ដំឡើង"

#: setupwizard.cpp:369
msgid "Use secure connection"
msgstr "ប្រើ​ការ​តភ្ជាប់​សុវត្ថិភាព"

#: setupwizard.cpp:395
msgid "Final URL (CalDav)"
msgstr "URL ចុងក្រោយ (CalDav)"

#: setupwizard.cpp:400
msgid "Final URL (CardDav)"
msgstr "URL ចុងក្រោយ (CardDav)"

#: setupwizard.cpp:405
msgid "Final URL (GroupDav)"
msgstr "URL ចុងក្រោយ​ (GroupDav)"

#: setupwizard.cpp:463 setupwizard.cpp:469
msgid "Test Connection"
msgstr "សាកល្បង​ការ​តភ្ជាប់"

#: setupwizard.cpp:464
msgid ""
"You can test now whether the groupware server can be accessed with the "
"current configuration"
msgstr ""
"អ្នក​អាច​សាកល្បង​ឥឡូវ​ថាតើ​កម៉ាស៊ីនបម្រើ groupware អាច​ត្រូវ​បាន​ចូល​ដំណើរការ​ជា​មួយ​នឹង​ការ​កំណត់​"
"រចនាសម្ព័ន្ធ​បច្ចុប្បន្ន​ដែរ​ឬទេ"

#: setupwizard.cpp:510
msgid "An error occurred: "
msgstr "កំហុស​បានកើត​ឡើង ៖"

#: setupwizard.cpp:513
msgid "Connected successfully"
msgstr "បានតភ្ជាប់ដោយ​ជោគជ័យ"

