#: rc.cpp:9
msgid "Add Imap Resource"
msgstr "បន្ថែម​ធនធាន Imap"

#. i18n: file: kolabsettings.ui:58
#. i18n: ectx: property (text), widget (QPushButton, createKolabFolderButton)
#: rc.cpp:12
msgid "Create Kolab Folders"
msgstr "បង្កើត​ថត Kolab"

#. i18n: file: kolabsettings.ui:67
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:15
msgid "Create resource folders in account:"
msgstr "បង្កើត​ថត​ធនធាន​នៅ​ក្នុង​គណនី ៖"

#. i18n: file: kolabsettings.ui:79
#. i18n: ectx: property (text), widget (QLabel, label_4)
#: rc.cpp:18
msgid ""
"Note that the Kolab resource will use all IMAP accounts that contain the "
"special Kolab folders."
msgstr "ចំណាំ​ថា​ធនធាន Kolab នឹង​ត្រូវ​បាន​ប្រើ​គ្រប់​គណនី IMAP ទាំងអស់​ដែល​មាន​ថត Kolab ពិសេស ។"

#. i18n: file: kolabproxyresource.kcfg:10
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:21
msgid "Do not change the actual backend data."
msgstr "កុំផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាងក្រោយ​ពិត ។"

#: setupkolab.cpp:94
msgid "Could not start the account wizard. Please check your installation."
msgstr "មិន​អាច​ចាប់ផ្ដើម​អ្នក​ជំនួយ​ការ​គណនី​បាន​ទេ ។ សូម​ពិនិត្យ​មើ​ល​ការ​ដំឡើង​របស់​អ្នក ។"

#: setupkolab.cpp:96
msgid "Unable to start account wizard"
msgstr "មិន​អាច​ចាប់ផ្ដើម​អ្នក​ជំនួយ​ការ​គណនី​បាន​ទេ"
