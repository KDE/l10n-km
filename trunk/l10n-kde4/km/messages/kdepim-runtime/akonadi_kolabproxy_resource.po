#: kolabsettings.ui:43
msgid "The kolab resource needs an Imap resource."
msgstr "ត្រូវការ​ធនធាន kolab ត្រូវការ​ប្រភព Imap ។"

#. i18n: ectx: property (text), widget (QPushButton, launchWizard)
