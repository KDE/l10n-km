#. i18n: file: kolabsettings.ui:40
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:6
msgid "The kolab resource needs an Imap resource."
msgstr "ត្រូវការ​ធនធាន kolab ត្រូវការ​ប្រភព Imap ។"

#. i18n: file: kolabsettings.ui:47
