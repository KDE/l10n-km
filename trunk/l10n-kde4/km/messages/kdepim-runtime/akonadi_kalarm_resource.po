#, kde-format
msgctxt "@info"
msgid "Failed to save event file: %1"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​រក្សាទុក​ឯកសារ​ព្រឹត្តិការណ៍ ៖ %1"

#: kalarmdir/settingsdialog.cpp:44
msgctxt "@title"
msgid "Configure Calendar"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​ប្រតិទិន"

#: shared/kalarmresourcecommon.cpp:129
#, kde-format
msgctxt "@info"
msgid "Item ID %1 differs from payload ID %2."
msgstr "លេខ​សម្គាល់​ធាតុ​ %1 ខុស​ពី​លេខ​សម្គាល់​ payload %2​  ។"

#: shared/kalarmresourcecommon.cpp:175
#, kde-format
msgctxt "@info"
msgid "Event with uid '%1' not found."
msgstr "រក​មិន​ឃើញ​ព្រឹត្តិការណ៍​ដែល​មាន uid '%1' ។"

#: shared/kalarmresourcecommon.cpp:177
msgctxt "@info"
msgid "Calendar is not in current KAlarm format."
msgstr "ប្រតិទិន​មិន​ស្ថិត​នៅ​ក្នុង​ទ្រង់ទ្រាយ KAlarm បច្ចុប្បន្ន​ទេ ។"

#: shared/kalarmresourcecommon.cpp:179
#, kde-format
msgctxt "@info"
msgid "Event with uid '%1' is not in current KAlarm format."
msgstr "ព្រឹត្តិការណ៍​ដែល​មាន uid '%1' មិន​ស្ថិត​នៅ​ក្នុង​ទ្រង់ទ្រាយ KAlarm បច្ចុប្បន្ន​ទេ ។"

#: shared/kalarmresourcecommon.cpp:181
#, kde-format
msgctxt "@info"
msgid "Event with uid '%1' contains no usable alarms."
msgstr "ព្រឹត្តិការណ៍​ដែល​មាន uid '%1' មិន​មាន​​ការ​ជូន​ដំណឹង​ដែល​អាច​ប្រើប្រាស់​បាន​ទេ ។"

#: shared/kalarmresourcecommon.cpp:183
