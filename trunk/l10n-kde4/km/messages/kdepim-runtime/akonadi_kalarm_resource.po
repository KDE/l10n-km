#: kalarm/kalarmresource.cpp:90
msgctxt "@title:window"
msgid "Select Archived Alarm Calendar"
msgstr "ជ្រើស​​ប្រតិទិន​​ជួនដំណឹង​ដែល​ទុក​ក្នុង​ប័ណ្ណសារ​"

