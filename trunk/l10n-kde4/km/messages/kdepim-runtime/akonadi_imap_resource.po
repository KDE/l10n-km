msgstr "មិន​អា​កំណត់​ UID សម្រាប់​សារ​ដែលបាន​បង្កើត​ថ្មី​នៅ​លើ​ម៉ាស៊ីនបម្រើ​ទេ"

#: changecollectiontask.cpp:48
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr "មិន​អាច​កែប្រែ​ថត IMAP '%1' បាន​ទេ វា​មិនទាន់​មាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​​ឡើយ ។"

