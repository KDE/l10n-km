#: mixedmaildirresource.cpp:397
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "មិនអាច​លុប​ថត maildir កម្រិត​កំពូល​ '%1' បាន​ទេ ។"

