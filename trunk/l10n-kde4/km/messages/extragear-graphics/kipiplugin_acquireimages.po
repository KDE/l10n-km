#: twainiface/twaincontroller.cpp:233 scandialog.cpp:232
#, kde-format
msgid "The target image file format \"%1\" is unsupported."
msgstr "មិនគាំទ្រ​ទ្រង់ទ្រាយ​​ឯកសារ​រូបភាព​គោលដៅ \"%1\" ។"

#: twainiface/twaincontroller.cpp:241 scandialog.cpp:240
#, kde-format
msgid ""
"Failed to save file\n"
"\"%1\" to\n"
"\"%2\"."
msgstr ""
"បាន​បរាជ័យ​ក្នុង​កា​ររក្សា​ទុក​ឯកសារ\n"
"\"%1\" ទៅ\n"
"\"%2\" ។"

#: twainiface/twaincontroller.cpp:252 scandialog.cpp:251
#, kde-format
msgid ""
"A file named \"%1\" already exists. Are you sure you want to overwrite it?"
msgstr "មាន​ឯកសារ​ដែល​មាន​ឈ្មោះ \"%1\" រួច​ហើយ ។ តើ​អ្នក​ប្រកដ​ជា​ចង់​សរសេរ​ជាន់​លើ​វាឬ ?"

#: twainiface/twaincontroller.cpp:256 scandialog.cpp:255
msgid "Overwrite File?"
msgstr "សរសេរ​ជាន់​លើ​ឯកសារ ?"

