#: DB/ImageInfoList.cpp:82
msgid ""
"<p>You are about to sort a set of thumbnails with others in between.<br /"
">This might result in an unexpected sort order.<br /><p>Are you sure you "
"want to continue?</p>"
msgstr ""
"<p>អ្នក​រៀប​នឹង​តម្រៀប​រូបភាព​តូចៗ​ជា​មួយ​រូបភាព​ផ្សេង​នៅ​ក្នុង​ចន្លោះ ។<br />វា​មាន​​លទ្ធផល​នៅ​ក្នុង​លំដាប់​"
"តម្រៀប​ដែល​មិនបានរំពឹង​ទុក ។<br /><p>តើ​អ្នក​ប្រាកដ​ជា​ចង់​បន្ត ?</p>"

#: DB/ImageInfoList.cpp:84
msgid "Sort Thumbnails?"
msgstr "តម្រៀប​រូបភាព​តូចៗ?"

#: DB/NewImageFinder.cpp:169
msgid ""
"<p><b>Loading information from new files</b></p><p>Depending on the number "
"of images, this may take some time.<br/>However, there is only a delay when "
"new images are found.</p>"
msgstr ""
"<p><b>ផ្ទុក​ព័ត៌មាន​ពី​ឯកសារ​ថ្មី</b></p><p>អាស្រ័យ​លើ​ចំនួន​រូបភាព​ វា​អាច​ចំណាយ​ពេល​មួយ​រយៈ ។<br/>ទោះ​"
"ជា​យ៉ាង​ណា​ក៏​ដោយ មាន​តែ​ការ​ពន្យារ​នៅពេល​ដែល​រកឃើញ​រូបភាព​ថ្មី ។</p>"

#: DB/NewImageFinder.cpp:244
#, kde-format
msgid ""
"<p><b>Calculating checksum for %1 files<b></p><p>By storing a checksum for "
"each image KPhotoAlbum is capable of finding images even when you have moved "
"them on the disk.</p>"
msgstr ""
"<p><b>គណនា​ឆែកសាំ​សម្រាប់​ឯកសារ %1 <b></p><p>ដោយ​តម្រៀប​ឆែកសាំ​សម្រាប់​រូបភាព​នីមួយៗ "
"KPhotoAlbum អាច​រក​រូបភាព​សូម្បី​តែ​នៅ​ពេល​អ្នក​បានផ្លាស់ទី​ពួកវា​នៅ​លើថាស ។</p>"

