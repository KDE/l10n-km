#: XMLDB/FileReader.cpp:263
msgid ""
"<p>Your images/videos are not sorted, which means that navigating using the "
"date bar will only work suboptimally.</p><p>In the <b>Maintenance</b> menu, "
"you can find <b>Display Images with Incomplete Dates</b> which you can use "
"to find the images that are missing date information.</p>You can then select "
"the images that you have reason to believe have a correct date in either "
"their EXIF data or on the file, and execute <b>Maintenance->Read EXIF Info</"
"b> to reread the information.</p><p>Finally, once all images have their "
"dates set, you can execute <b>Images->Sort Selected by Date & Time</b> to "
"sort them in the database.</p>"
msgstr ""
"<p>រូបភាព​/វីដេអូ​របស់​អ្នក​មិន​​ត្រូវ​បាន​តម្រៀប​ទេ ដែល​មាន​ន័យ​ថា​ ការរុករក​ដោយ​ប្រើ​របារ​កាល​បរិច្ឆេទ​នឹង​"
"ដំណើរ​ការ​តាម​តែ​លក្ខណៈ​ធម្មតា​ប៉ុណ្ណោះ ។</p><p>នៅ​ក្នុង​ម៉ឺនុយ​ <b>តំហែ​ទាំ​</b> ​អ្នក​អាច​​ស្វែង​រក​ "
"<b>បង្ហាញ​រូប​ភាព​ជា​មួយ​កាល​បរិច្ឆេទ​មិន​ពេញ​លេញ​</b> ​ដែល​អ្នក​អាច​ប្រើ​ ដើម្បី​ស្វែង​រក​រូបភាព​ដែល​ជា​ព័ត៌មាន​"
"កាល​បរិច្ឆេទ​ដែល​បាត់​ ។</p>​បន្ទាប់​មក​ អ្នក​អាច​ជ្រើស​រូបភាព​ ដែល​អ្នក​មាន​ហេតុផល​ជឿ​ថា​មាន​កាល​បរិច្ឆេទ​"
"ត្រឹម​ត្រូវ​ទាំង​នៅ​ក្នុងទិន្នន័យ​​ EXIF ​និង​លើ​ឯកសារ រួច​ប្រតិបត្តិ​ <b>តំហែ​ទាំ​->​អាន​ព័ត៌មាន​ EXIF </b> ​ដើម្បី​"
"អាន​ព័ត៌មាន ។</p><p>​ជា​ចុង​ក្រោយ​ នៅ​ពេល​រូបភាព​ទាំង​អស់​មាន​សំណុំ​កាល​បរិច្ឆេទ​របស់​ពួក​វា​ អ្នក​អាច​ប្រតិបត្តិ​ "
"<b>រូបភាព​->តម្រៀប​ជម្រើស​តាម​កាល​បរិច្ឆេទ និង​ពេល​វេលា​</b> ​ដើម្បី​តម្រៀប​ពួក​វា​នៅ​ក្នុង​មូល​ដ្ឋាន​ទិន្នន័យ​ "
"។</p>"

#: XMLDB/FileReader.cpp:273
msgid ""
"<p>Your images/videos are not sorted, which means that navigating using the "
"date bar will only work suboptimally.</p><p>You also do not have EXIF "
"support available, which means that you cannot read image dates from JPEG "
"metadata. It is strongly recommended to recompile KPhotoAlbum with the "
"<code>exiv2</code> library. After you have done so, you will be asked what "
"to do to correct all the missing information.</p>"
msgstr ""
"<p>រូបភាព​/វីដេអូ​របស់​អ្នក​មិន​ត្រូវ​បាន​តម្រៀប ដែល​មាន​ន័យ​ថា​ការរុក​រក​ ដោយ​ប្រើ​របារ​កាល​បរិច្ឆេទ​នឹង​ដំណើរ​"
"តាម​លក្ខណៈ​ធម្មតា​ប៉ុណ្ណោះ ។</p><p>​អ្នក​​អាច​នឹង​មិន​មាន​ការគាំ​ទ្រ​ EXIF ​ដែល​ប្រើ​បាន​ផង​ដែរ ដែល​មាន​ន័យ​"
"ថា​ អ្នក​មិន​អាច​អាន​កាល​បរិច្ឆេទ​រូបភាព​ពី​ទិន្នន័យ​មេតា​ JPEG ​បាន​ទេ ។ អ្នក​ត្រូវ​បាន​ផ្តល់​អនុសាសន៍យ៉ាង​ម៉ឹង​"
"ម៉ាត់​ថា​ត្រូវ​តែ​ចង​ក្រង​ KPhotoAlbum ​ឡើង​វិញ​ជា​មួយ​នឹង​បណ្ណាល័យ​ <code>exiv2</code> ។ បន្ទាប់​ពី​អ្នក​"
"បាន​ធ្វើ​ដូច្នេះ​រួច​ហើយ​ អ្នក​នឹង​ត្រូវ​សួរ​នូវ​អ្វី​ដែល​នឹង​ត្រូវធ្វើ​ ដើម្បី​កែ​ព័ត៌មាន​ទាំង​អស់​ដែល​បាន​បាត់ ។​</p>"

#: XMLDB/FileReader.cpp:280
msgid "Images/Videos Are Not Sorted"
msgstr "រូបភាព/វីដេអូ​មិនត្រូវ​​​បាន​តម្រៀប"

#: XMLDB/FileReader.cpp:295
msgid ""
"<p>Not all the images in the database have information about image sizes; "
"this is needed to get the best result in the thumbnail view. To fix this, "
"simply go to the <b>Maintainance</b> menu, and first choose <b>Remove All "
"Thumbnails</b>, and after that choose <tt>Build Thumbnails</tt>.</p><p>Not "
"doing so will result in extra space around images in the thumbnail view - "
"that is all - so there is no urgency in doing it.</p>"
msgstr ""
"<p>គ្រប់​រូបភាព​ទាំង​អស់​នៅ​ក្នុង​មូលដ្ឋាន​ទិន្នន័យមិន​មែន​​សុទ្ធ​តែ​មាន​ព័ត៌មាន​អំពី​ទំហំ​រូបភាព​នោះ​ទេ ​វា​តម្រូវ​ឲ្យ​ទទួល​"
"យក​លទ្ធផល​ដែល​ល្អ​បំផុត​នៅ​ក្នុង​ទិដ្ឋភាព​រូបភាព​តូច​ៗ​ ។ ដើម្បី​ដោះ​ស្រាយ​បញ្ហា​នេះ ចូល​ទៅ​កាន់​ម៉ឺនុយ​ <b>តំហែ​ទាំ​</"
"b> ​តាម​ធម្មតា​ និង​មុន​ដំបូង​ជ្រើស​ <b>យក​រូបភាព​តូច​ៗ​ទាំង​អស់​ចេញ​</b> ហើយ​បន្ទាប់​មក​ជ្រើស​ <tt>បង្កើត​"
"រូបភាព​តូច​ៗ​</tt>។</p><p>បើ​មិន​ធ្វើ​ដូច្នេះ​ទេ នឹង​ធ្វើ​ឲ្យ​មាន​គម្លាត​បន្ថែម​ជុំ​វិញ​រូបភាព​នៅ​ក្នុង​ទិដ្ឋភាព​"
"រូបភាព​តូច​ៗ​ គ្រាន់​តែ​ប៉ុណ្ណឹង​ឯង ដូច្នេះ​មិន​ចាំបាច់​ប្រញាប់ប្រញាល់​ធ្វើ​វា​ក៏​បាន​ដែរ ។</p>"

#: XMLDB/FileReader.cpp:300
msgid "Not All Images Have Size Information"
msgstr "មិនមែន​រូបភាព​ទាំងអស់​មាន​ព័ត៌មាន​អំពី​ទំហំ​នោះ​ទេ"

#: XMLDB/FileReader.cpp:310
msgid ""
"<p>The index.xml file read was from an older version of KPhotoAlbum. "
"KPhotoAlbum read the old format without problems, but to be able to convert "
"back to KimDaBa 2.1 format, you need to run the current KPhotoAlbum using "
"the flag <b>export-in-2.1-format</b>, and then save.</p>"
msgstr ""
"<p>ឯកសារ​អាន​ index.xml ជា​កំណែ​ចាស់​របស់​ KPhotoAlbum ។ KPhotoAlbum អាន​ទ្រង់ទ្រាយ​ចាស់​ដោយ​"
"គ្មាន​បញ្ហា ប៉ុន្តែ​ដើម្បី​អាច​បំលែង​វា​ទៅ​ជា​ទ្រង់ទ្រាយ​ KimDaBa 2.1 វិញ អ្នក​ត្រូវ​តែ​រត់​ KPhotoAlbum "
"ថ្មីៗ​ដោយ​ប្រើ​ទង់<b>នាំចេញ​ក្នុង​ទ្រង់ទ្រាយ 2.1</b> ហើយ​បន្ទាប់​មក​រក្សា​វា​ទុក ។</p>"

#: XMLDB/FileReader.cpp:314
msgid "Old File Format read"
msgstr "បាន​អាន​ទ្រង់ទ្រាយ​ឯកសារ​ចាស់"

#: XMLDB/FileReader.cpp:335
msgid ""
"<p>KPhotoAlbum was unable to load a default setup, which indicates an "
"installation error</p><p>If you have installed KPhotoAlbum yourself, then "
"you must remember to set the environment variable <b>KDEDIRS</b>, to point "
"to the topmost installation directory.</p><p>If you for example ran "
"configure with <b>--prefix=/usr/local/kde</b>, then you must use the "
"following environment variable setup (this example is for Bash and "
"compatible shells):</p><p><b>export KDEDIRS=/usr/local/kde</b></p><p>In case "
"you already have KDEDIRS set, simply append the string as if you where "
"setting the <b>PATH</b> environment variable</p>"
msgstr ""
"<p>KPhotoAlbum មិន​អាច​ផ្ទុក​ការ​រៀប​ចំ​លំនាំ​ដើម​បាន​ទេ ដែល​បង្ហាញ​ថា​មាន​កំហុស​ក្នុង​ការ​ដំឡើង ។</"
"p><p>បើ​សិន​ជា​អ្នក​បាន​ដំឡើង​ KPhotoAlbum ដោយ​ខ្លួន​អ្នក​ផ្ទាល់ អ្នក​ត្រូវ​តែ​កុំ​ភ្លេច​កំណត់ <b>KDEDIRS</"
"b> អថេរ​បរិស្ថាន ដើម្បី​ចង្អុល​ទៅ​ថត​ដំឡើង​ដែល​នៅ​ខាង​លើ​បំផុត ។</p><p>​ឧទាហរណ៍ បើ​សិន​អ្នក​បាន​ដំណើរ​ការ​"
"កំណត់​រចនា​សម្ព័ន្ធ​ជា​មួយ​នឹង​ <b>--prefix=/usr/local/kde</b> រួច​ហើយ អញ្ចឹង​អ្នក​ត្រូវ​តែ​ប្រើ​ការរៀប​"
"ចំ​អថេរ​បរិស្ថាន​ដូច​ខាង​ក្រោម​ (ឧទាហរណ៍​នេះ​សម្រាប់​តែ​ Bash និង​ shells ដែល​ឆប​គ្នា​) ៖</p><p><b>នាំ​"
"ចេញ​ KDEDIRS=/usr/local/kde</b></p><p>​ក្នុង​ករណី​ដែល​អ្នក​មាន​សំណុំ​ KDEDIRS ​រួច​ហើយ អ្នក​អាច​"
"បន្ថែម​ខ្សែ​អក្សរ​ខាង​ចុង​តាម​ធម្មតា​ បើ​សិន​ជា​អ្នក​កំណត់​នូវ​អថេរ​បរិស្ថាន <b>ផ្លូវ</b> </p>"

