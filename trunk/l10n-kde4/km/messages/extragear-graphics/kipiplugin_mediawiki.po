#: plugin_wikimedia.cpp:79
msgid "Export to &WikiMedia Commons..."
msgstr "នាំចេញ​ទៅ​ WikiMedia Commons..."

#: wmwindow.cpp:80
msgid "Export to Wikimedia Commons"
msgstr "នាំចេញ​ទៅ Wikimedia Commons"

#: wmwindow.cpp:82
msgid "Start Upload"
msgstr "ចាប់ផ្ដើម​ផ្ទុក​ឡើង"

#: wmwindow.cpp:83
msgid "Start upload to Wikimedia Commons"
msgstr "ចាប់ផ្ដើម​ផ្ទុក​ឡើង​ទៅ Wikimedia Commons"

#: wmwindow.cpp:87
msgid "Wikimedia Commons Export"
msgstr "កា​រនាំចេញ​របស់ Wikimedia Commons"

#: wmwindow.cpp:89
#, kde-format
msgid ""
"A Kipi plugin to export image collection to Wikimedia Commons.\n"
"Using libmediawiki version %1"
msgstr ""
"កម្មវិធី​ជំនួយ Kipi ត្រូវ​នាំចេញ​​សម្រាំង​រូបភាព​ទៅ Wikimedia Commons ។\n"
"ប្រើកំណែ libmediawiki %1"

#: wmwindow.cpp:92
msgid "(c) 2011, Alexandre Mendes"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០១១ ដោយ Alexandre Mendes"

#: wmwindow.cpp:94
msgid "Alexandre Mendes"
msgstr "Alexandre Mendes"

#: wmwindow.cpp:94
msgid "Author"
msgstr "អ្នក​និពន្ធ"

#: wmwindow.cpp:97
msgid "Guillaume Hormiere"
msgstr "Guillaume Hormiere"

#: wmwindow.cpp:97 wmwindow.cpp:100
msgid "Developer"
msgstr "អ្នក​អភិវឌ្ឍន៍"

#: wmwindow.cpp:100
msgid "Gilles Caulier"
msgstr "Gilles Caulier"

#: wmwindow.cpp:225
msgid "Wiki Export"
msgstr "នាំចេញ Wiki"

#: wmwindow.cpp:260
msgid ""
"Login error\n"
"Please check your credentials and try again."
msgstr ""
"កំហុស​ក្នុងការ​ចូល\n"
"សូម​ពិនិត្យ​មើល​ព័ត៌មាន​​ពាក្យ​សម្ងាត់​របស់​អ្នក​ ហើយ​ព្យាយាម​ម្ដ​ងទៀត"

#: wmwindow.cpp:281
msgid "Upload finished with no errors."
msgstr "បានបញ្ចប់​ការ​ផ្ទុកឡើង​ដោយ​​គ្មាន​កំហុស ។"

#: wmwidget.cpp:86
msgid "This is the list of images to upload to your Wikimedia account."
msgstr "នេះជា​បញ្ជី​រូបភាព​ ត្រូវ​ផ្ទុក​ឡើង​ទៅ​គនណី Wikimedia របស់​អ្នក ។"

#: wmwidget.cpp:99
msgid ""
"This is a clickable link to open the Wikimedia home page in a web browser."
msgstr "នេះជា​តំណ​ដែល​អាច​ចុច​បាន ដើម្បី​បើក​គេហទំព័រ Wikimedia នៅ​ក្នុង​កម្មវិធីរុករក​បណ្ដាញ​របស់​អ្នក ។"

#: wmwidget.cpp:110 wmwidget.cpp:169
msgid "This is the login form to your Wikimedia account."
msgstr "នេះ​ជា​ទម្រង់​ចូល​គណនី Wikimedia របស់​អ្នក ។"

#: wmwidget.cpp:115
msgid ""
"Enter mediawiki server url where you want to be connected (as http://en."
"wikipedia.org/w/api.php for Wikipedia for example)."
msgstr ""
"បញ្ចូល url ម៉ាស៊ីន​បម្រើ mediawiki ដែល​អ្នក​ចង់​តភ្ជាប់ (ឧទាហរណ៍​ ដូច​ជា http://en.wikipedia."
"org/w/api.php សម្រាប់ Wikipedia​) ។"

#: wmwidget.cpp:121
msgid "Enter your mediawiki server login name where you want to be connected."
msgstr "បញ្ចូល​ឈ្មោះ​ចូល​ម៉ាស៊ីន​បម្រើ mediawiki ដែល​អ្នក​ចង់​ទភ្ជាប់ ។"

#: wmwidget.cpp:125
msgid "Enter your mediawiki server password where you want to be connected."
msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់​ម៉ាស៊ីន​បម្រើ mediawiki របស់​អ្នក​ ដែល​អ្នក​ចង់​តភ្ជាប់ ។"

#: wmwidget.cpp:128
msgid "Url:"
msgstr "Url ៖"

#: wmwidget.cpp:131
msgid "Login:"
msgstr "ចូល ៖"

#: wmwidget.cpp:134
msgid "Password:"
msgstr "ពាក្យសម្ងាត់ ៖"

#: wmwidget.cpp:139
msgid "&Log in"
msgstr "ចូល"

#: wmwidget.cpp:151
msgid "This is the Wikimedia account that is currently logged in."
msgstr "នេះជា​គណនី​ Wikimedia ដែល​បច្ចុប្បន្ន​បាន​ចូល ។"

#: wmwidget.cpp:154
msgctxt "Wikimedia account settings"
msgid "Logged as: "
msgstr "បាន​ចូល​ជា ៖"

#: wmwidget.cpp:157
msgid "Change Account"
msgstr "ផ្លាស់ប្ដូរ​គណនី"

#: wmwidget.cpp:158
msgid "Logout and change Wikimedia Account used for transfer"
msgstr "ចេញ ហើយ​ផ្លាស់ប្ដូរ​គណនី Wikimedia ដែល​បាន​ប្រើ​សម្រាប់​ផ្ទេរ"

#: wmwidget.cpp:163
msgid "Account"
msgstr "គណនី"

#: wmwidget.cpp:172
msgid "Author:"
msgstr "អ្នក​និពន្ធ ៖"

#: wmwidget.cpp:175
msgid "License:"
msgstr "អាជ្ញាប័ណ្ណ ៖"

#: wmwidget.cpp:178
msgid "Own work, multi-license with CC-BY-SA-3.0 and GFDL"
msgstr "ការងារ​​ផ្ទាល់​ខ្លួន អាជ្ញាប័ណ្ណ​ច្រើន​ជា​មួយ CC-BY-SA-3.0 និង GFDL"

#: wmwidget.cpp:180
msgid "Own work, multi-license with CC-BY-SA-3.0 and older"
msgstr "ការ​ផ្ទាល់ខ្លួន អាជ្ញាប័ណ្ណ​ច្រើន​ជា​មួយ CC-BY-SA-3.0 និង​កំណែ​ចាស់ៗ"

#: wmwidget.cpp:182
msgid "Creative Commons Attribution-Share Alike 3.0"
msgstr "Creative Commons Attribution-Share Alike 3.0"

#: wmwidget.cpp:184
msgid "Own work, Creative Commons Attribution 3.0"
msgstr "ការ​ផ្ទាល់​ខ្លួន Creative Commons Attribution 3.0"

#: wmwidget.cpp:186
msgid "Own work, release into public domain under the CC-Zero license"
msgstr "ការ​ងារ​ផ្ទាល់​ខ្លួន ចេញ​ផ្សារ​ក្នុង​ដែន​សាធារណៈ ក្រោម​អាជ្ញាប័ណ្ណ CC-Zero"

#: wmwidget.cpp:188
msgid "Author died more than 100 years ago"
msgstr "អ្នកនិពន្ធ​ដែល​បាន​ស្លាប់​ជាង ១០០ ឆ្នាំ​មក​ហើយ"

#: wmwidget.cpp:190
msgid ""
"Photo of a two-dimensional work whose author died more than 100 years ago"
msgstr "រូបថត​ការងារ​ពីរ​វិមាត្រ​ដែល​អ្នក​និពន្ធ​របស់​វា​បាន​ស្លាប់​ជាង ១០០ មក​ហើយ"

#: wmwidget.cpp:192
msgid "First published in the United States before 1923"
msgstr "បាន​បោះពុម្ពផ្សាយ​លើក​ដំបូង​ក្នុង​សហរដ្ឋអាមេរិក​មុន​ឆ្នាំ ១៩២៣"

#: wmwidget.cpp:194
msgid "Work of a U.S. government agency"
msgstr "ការងារ​របស់​ភ្នាក់ងារ​រដ្ឋាភិបាល​របស់​អាមេរិក"

#: wmwidget.cpp:196
msgid "Simple typefaces, individual words or geometric shapes"
msgstr "ផ្ទៃ​មុខ​ធម្មតា ពាក្យ​នីមួយៗ ឬ​រាង​ធរណីមាត្រ"

#: wmwidget.cpp:198
msgid "Logos with only simple typefaces, individual words or geometric shapes"
msgstr "រូបសញ្ញា​​មាន​តែ​ផ្ទៃមុខ​ធម្មតា ពាក្យ​នីមួយៗ​ ឬ​រាង​ធរណីមាត្រ"

#: wmwidget.cpp:207
msgid "Information"
msgstr "ព័ត៌មាន"

#: wmwidget.cpp:213
msgid "These are options that will be applied to photos before upload."
msgstr "មាន​​ជម្រើស​ដែល​នឹង​ត្រូវបាន​អនុវត្ត​ទៅ​រូបថត​មុន​នឹង​ផ្ទុក​ឡើង ​។"

#: wmwidget.cpp:217
msgid "Resize photos before uploading"
msgstr "ផ្លាស់ប្ដូរ​ទំហំ​រូបថត​មុន​នឹង​ផ្ទុក​ឡើង"

#: wmwidget.cpp:227
msgid "Maximum size:"
msgstr "ទំហំ​អតិបរមា ៖"

#: wmwidget.cpp:235
msgid "JPEG quality:"
msgstr "គុណភាព JPEG ៖"

#: wmwidget.cpp:246
msgid "Options"
msgstr "ជម្រើស"

#: wmwidget.cpp:340
msgid "Wikimedia commons"
msgstr "Wikimedia commons"

