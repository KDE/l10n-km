#: plugin_gpssync.cpp:139
#, kde-format
msgid ""
"<p>Unable to find the gpsbabel executable:<br/> This program is required by "
"this plugin to support GPS data file decoding. Please install gpsbabel as a "
"package from your distributor or <a href=\"%1\">download the source</a>.</"
"p><p>Note: at least, gpsbabel version %2 is required by this plugin.</p>"
msgstr ""
"<p>មិន​អាច​ស្វែងរក​ឯកសារ​ប្រតិបត្តិ gpsbabel បាន​ឡើយ​ ៖​<br/> កម្មវិធី​នេះ​​ត្រូវ​បាន​ទាមទារ​ដោយ​​កម្មវិធី​"
"ជំនួយ​នេះ​​ ដើម្បី​គាំទ្រ​ការ​ឌិកូដ​ឯកសារ​ទិន្នន័យ​​ GPS ។ ​សូម​ដំឡើង​​ gpsbabel ជា​កញ្ជាប់​​ ចេញ​ពី​កម្មវិធី​ចែកចាយ​"
"របស់​អ្នក​ឬ​ <a href=\"%1\">ប្រភព​ទាញ​យក​</a> ។</p><p>ចំណាំ​ ៖​ យ៉ាង​ហោច​ណាស់​ កំណែ​ gpsbabel  %"
"2 ត្រូវ​បាន​ទាមទារ​ដោយ​កម្មវិធី​ជំនួយ​នេះ​ ។</p>"

