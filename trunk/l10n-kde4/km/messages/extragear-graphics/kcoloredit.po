#: src/app/main.cpp:30
msgid "KColorEdit"
msgstr "KColorEdit"

#: src/app/main.cpp:31
msgid "KColorEdit, great tool for editing color palettes."
msgstr "KColorEdit ឧបករណ៍​ដ៏អស្ចារ្យ​សម្រាប់​កែសម្រួល​ក្ដារ​លាយ​ពណ៌ ។"

