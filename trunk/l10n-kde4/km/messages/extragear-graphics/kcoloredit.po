msgid "Overwrite"
msgstr "សរសេរ​ជាន់​លើ"

#: src/app/kcoloredit.cpp:166
msgid ""
"This action will delete all items (colors and comments) of the current "
"palette."
msgstr "សកម្មភាព​នេះ​នឹង​លុប​ធាតុ​ទាំងអស់ (ពណ៌ និង​មតិយោបល់) របស់​ក្ដារលាយ​បច្ចុប្បន្ន ។"

