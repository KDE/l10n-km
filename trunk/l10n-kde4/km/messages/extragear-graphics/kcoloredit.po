#: src/app/kcoloredit.cpp:112
#, kde-format
msgid ""
"The document \"%1\" has been modified.\n"
"Do you want to save your changes or discard them?"
msgstr ""
"ឯកសារ \"%1\" ត្រូវ​បានកែប្រែ ។\n"
"តើអ្នក​ចង់​រក្សាទុក​ការ​​ផ្លាស់ប្ដូរ​ ឬ​បោះបង់​ពួកគេ ?"

#: src/app/kcoloredit.cpp:114
msgid "Close Document"
msgstr "បិទ​ឯកសារ"

#: src/app/kcoloredit.cpp:150
#, kde-format
msgid "A file named \"%1\" already exists. Are you sure you want to overwrite it?"
msgstr "មាន​ឈ្មោះ​ឯកសារ \"%1\" រួច​ហើយ ។ តើ​អ្នក​ប្រាកដ​ជា​ចង់​សរសេរ​ជាន់​លើ​វា​ឬ ?"

