#: plugin_removeredeyes.cpp:63
msgid "&Red Eyes Removal..."
msgstr "ការ​យក​ភ្នែក​ក្រហម​ចេញ..."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម,​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,vannak@khmeros.info,piseth_dv@khmeros.info"

#: removeredeyeswindow.cpp:106
msgid "Automatic Red Eyes Removal"
msgstr "យក​ភ្នែក​ក្រហម​ចេញ​ដោយ​ស្វ័យ​ប្រវត្តិ"

#: removeredeyeswindow.cpp:133
msgid "Remove Red-Eyes"
msgstr "យក​ភ្នែក​ក្រហមចេញ"

#: removeredeyeswindow.cpp:136
msgid "A plugin to automatically detect and remove red-eyes"
msgstr "កម្មវិធី​ជំនួយ​ត្រូវរក​ឃើញ​ដោយ​ស្វ័យ​ប្រវត្តិ ហើយ​យក​ផ្នែក​ក្រហម​ចេញ"

#: removeredeyeswindow.cpp:138
#, fuzzy
#| msgid "(c) 2008, Andi Clemens"
msgid "(c) 2008-2009, Andi Clemens"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៨ ដោយ Andi Clemens"

#: removeredeyeswindow.cpp:140
msgid "Andi Clemens"
msgstr "Andi Clemens"

#: removeredeyeswindow.cpp:140
msgid "Author and Maintainer"
msgstr "អ្នក​និពន្ធ និង​អ្នក​ថែទាំ"

#: removeredeyeswindow.cpp:145
#, fuzzy
#| msgid "Plugin Handbook"
msgid "Handbook"
msgstr "សៀវភៅ​ដៃ​កម្មវិធី​ជំនួយ"

#: removeredeyeswindow.cpp:153
msgid "Correct &Photos"
msgstr "កែរូបថត"

#: removeredeyeswindow.cpp:154
msgid "Start correcting the listed images"
msgstr "ចាប់ផ្ដើមកែ​រូបភាព​ដែល​បាន​រាយ"

#: removeredeyeswindow.cpp:158
msgid "&Testrun"
msgstr "សាកល្បង​ការ​រត់"

#: removeredeyeswindow.cpp:159
msgid "Simulate the correction process, without saving the results."
msgstr "ក្លែង​ដំណើរការ​កែ ដោយ​មិនរក្សាទុក​លទ្ធផល ។"

#: removeredeyeswindow.cpp:185
msgid "Files List"
msgstr "បញ្ជី​ឯកសារ"

#: removeredeyeswindow.cpp:186
msgid "Settings"
msgstr "ការ​កំណត់"

#: removeredeyeswindow.cpp:303
msgid ""
"<p>You choose the <b>'overwrite' correction mode</b>!<br/>Are you sure you "
"want to loose your original image files?</p>"
msgstr ""
"<p>អ្នកជ្រើសរបៀប​កែ <b>'សរសេរជាន់លើ' </b>!<br/>តើ​អ្នក​ប្រាកដ​ជា​ចង់​បន្ធូរ​ឯកសារ​រូបភាព​ដើម​របស់​"
"អ្នក​ឬ ?</p>"

#: removeredeyeswindow.cpp:306
msgid "Overwrite mode"
msgstr "របៀប​សរសេរ​ជាន់លើ"

#: removeredeyeswindow.cpp:486
msgid ""
"<p>Some of the images could not be analyzed with the current settings or "
"they do not contain any red-eyes at all.</p><p><b>Would you like to remove "
"those images from the list?</b></p>"
msgstr ""
"<p>រូបភាព​មួយ​ចំនួន​មិនអាច​ត្រូវ​បាន​វិភាគ​ជា​មួយ​នឹង​ការ​កំណត់​បច្ចុប្បន្នបានទេ ឬ​ពួកវា​មិនមាន​ភ្នែក​ក្រហម​ទាន់តែ​"
"សោះ ។</p><p><b>តើ​អ្នកចង់​យក​រូបភាព​ទាំង​នោះ​ចេញ​ពី​បញ្ជី​ដែរឬទេ ?</b></p>"

#: removeredeyeswindow.cpp:492
msgid "Remove unprocessed images?"
msgstr "យក​រូបភាព​ដែល​មិន​ដំណើរការ​ចេញ ?"

#: removeredeyeswindow.cpp:524
msgid ""
"<p>You tried to add <b>RAW images</b> to the plugin,<br/>but those filetypes "
"are not supported.</p><p><b>They were automatically removed from the list.</"
"b></p>"
msgstr ""
"<p>អ្នកបាន​ព្យាយាម​បន្ថែម <b>រូប​ដើម</b> ទៅកម្មវិធី​ជំនួយ<br/>ប៉ុន្តែ​ប្រភេទ​ឯកសារ​ទាំង​នោះ​"
"មិនបានគាំទ្រទេ ។</p><p><b>ពួក​គេ​ត្រូវ​បាន​យក​ចេញ​ពី​បញ្ជី​ដោយ​ស្វ័យ​ប្រវត្តិ ។</b></p>"

#: removeredeyeswindow.cpp:528
msgid "RAW images found"
msgstr "រកឃើញ​រូបភាព​ដើម"

#: removeredeyeswindow.cpp:607
#, kde-format
msgid "<p>%1 image has been successfully processed.</p>"
msgid_plural "<p>%1 images have been successfully processed.</p>"
msgstr[0] "<p>រូបភាព %1 ត្រូវ​បាន​ដំណើរការ​ដោយ​ជោគជ័យ ។</p>"

#: removeredeyeswindow.cpp:610
msgid "<h2>Correction Complete!</h2>"
msgstr "<h2>ការ​កែ​បាន​បញ្ចប់ !</h2>"

#: removeredeyeswindow.cpp:612
msgid "Correction Complete"
msgstr "ការ​កែ​បានបញ្ចប់"
