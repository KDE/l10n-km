msgid "Misc"
msgstr "ផ្សេងៗ"

#: generalpage.cpp:156
msgid "Display Captions"
msgstr "បង្ហាញ​ចំណង​ជើង"

#: generalpage.cpp:158
msgid "If you enable this option, the images caption will be shown"
msgstr "ប្រសិនបើ​អ្នកបើ​ជម្រើស​នេះ ចំណង​ជើង​រូបភាព​នឹង​ត្រូវ​បានបង្ហាញ"

#: generalpage.cpp:161
msgid "Open Image with Right Click"
msgstr "បើក​រូបភាព​ដោយ​ចុច​កណ្ដុរ​ស្ដាំ"

#: generalpage.cpp:163
msgid ""
"If you enable this option, user will be able to open the target image in a "
"separate window using right mouse button"
msgstr ""
"ប្រសិនបើ​អ្នក​បើ​ជម្រើស​នេះ អ្នកបើរ​នឹង​អាច​បើក​រូបភាពគោលដៅ​នៅ​ក្នុង​បង្អួ​ចដោយឡែក ដោយ​ប្រើ​​ប៊ូតុង​កណ្ដុរ​ស្ដាំ"

#: generalpage.cpp:167
msgid "Open gallery in Konqueror"
msgstr "បើក​វិចិត្រសាល​នៅ​ក្នុង Konqueror"

#: generalpage.cpp:169
msgid ""
"If you enable this option, gallery will be open in Konqueror automatically"
msgstr "ប្រសិន​បើ​អ្នកបើក​ជម្រើស​នេះ វិចិត្រសាល​នឹង​ត្រូវ​បានបើកនៅ​ក្នុង Konqueror ដោយស្វ័យ​ប្រវត្តិ"

