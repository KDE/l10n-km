msgstr "ទំព័រ %1 ៖ ឯកសារ PDF <strong>%2</strong> មិនអាច​ត្រូវ​បាន​បម្លែង​ទៅ​ជា PostScript បានឡើយ ។<br>"

#: dviRenderer_prescan.cpp:104
#, qt-format
msgid "Page %1: The PostScript file <strong>%2</strong> could not be found.<br>"
msgstr "ទំព័រ %1 ៖ ឯកសារ PostScript <strong>%2</strong> រក​មិន​ឃើញ​ឡើយ ។<br>"

#: dviRenderer_prescan.cpp:253
#, qt-format
