#: dviexport.cpp:449
msgid "dvips progress dialog"
msgstr "ប្រអប់​វឌ្ឍនៈភាព dvips"

#: dviexport.cpp:451
#, qt-format
msgid "Export: %1 to PostScript"
msgstr "នាំចេញ ៖ %1 ទៅ​ជា PostScript"

#: dviexport.cpp:469
msgid ""
"<qt>The external program 'dvips', which was used to export the file, "
"reported an error. You might wish to look at the <strong>document info "
"dialog</strong> which you will find in the File-Menu for a precise error "
"report.</qt>"
msgstr "កម្មវិធី 'dvipdf' ខាង​ក្រៅ​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​នាំ​ឯកសារ​ចេញ បាន​រាយការណ៍​ពី​កំហុស ។ អ្នក​ប្រហែល​ជា​ចង់​រក​មើល <strong>ប្រអប់​ព័ត៌មាន​ឯកសារ</strong> ដែល​អ្នកនឹង​រក​​ក្នុង​ម៉ឺនុយ​ឯកសាចំពោះ​កំហុស​ដែល​ជាក់លាក់ ។</qt>"

