#: dviRenderer_prescan.cpp:440
#, qt-format
msgid ""
"<qt><strong>File conversion error</strong> KDVI was not able to convert the "
"external PDF file <strong>%1</strong> into PostScript. Expect missing "
"graphics or graphic errors.</qt>"
msgstr ""
"<qt><strong>កំហុស​ការ​បម្លែង​ឯកសារ​</strong> KDVI មិន​អាច​បម្លែង​ជា​ឯកសារ PDF ខាង​ក្រៅ "
"<strong>%1</strong> ទៅ​ជា PostScript បាន​ឡើយ ។ រំពឹ​ង​​ថា​បាត់​ក្រាហ្វិក ឬ​កំហុស​ក្រាហ្វិក ។</qt>"

#: dviRenderer_prescan.cpp:442
msgid "PDF/PS conversion error"
msgstr "កំហុស​ការ​បម្លែង PDF/PS"

#: dviWidget.cpp:111
#, qt-format
msgid "line %1 of %2"
msgstr "បន្ទាត់ %1 នៃ %2"

#: dviexport.cpp:75
msgid "Please be patient"
msgstr "សូម​រង់​ចាំ​ដោយ​ការ​អត់ធ្មត់​បន្តិច"

#: dviexport.cpp:259
msgid ""
"KDVI could not locate the program 'dvipdfm' on your computer. That program "
"is essential for the export function to work. You can, however, convert the "
"DVI-file to PDF using the print function of KDVI, but that will often "
"produce documents which print ok, but are of inferior quality if viewed in "
"the Acrobat Reader. It may be wise to upgrade to a more recent version of "
"your TeX distribution which includes the 'dvipdfm' program.\n"
"Hint to the perplexed system administrator: KDVI uses the PATH environment "
"variable when looking for programs."
msgstr ""
"KDVI មិន​អាច​រក​ទីតាំង​សម្រាប់​ទុក​កម្មវិធី 'dvipdfm' នៅ​លើ​កុំព្យូទ័រ​របស់​អ្នក​បាន​ឡើយ ។ កម្មវិធី​ទាំងនោះ គឺ​សំខាន់​ណាស់​សម្រាប់​នាំ​ចេញ​រូបមន្ដ​ការងារ ។  អ្នក​អាច​​បម្លែង​ឯកសារ​ DVI ទៅជា PDF ដោយ​ប្រើប្រាស់​"
"មុខងារ​បោះពុម្ព​របស់ KDVI ប៉ុន្តែ​ជាញឹកញាប់ផលិត​ឯកសារ​ដែល​បោះពុម្ព គ្មាន បញ្ហា​ទេ ប៉ុន្តែ​គុណភាព​អន់​បើ​បាន​មើល​ក្នុង កម្មវិធី​អាន Acrobat ។ វា​ប្រហែល​ជា​កំពុង​រៀប​ចំ​ធ្វើ​ឲ្យ​ប្រសើរ​​ឡើងចំពោះ​កំណែ​ថ្មីៗ​របស់ TeX ការបែងចែក​រួមមាន​កម្មវិធី 'dvipdfm' ។\n"
"Hint បាន​ធ្វើ​ឲ្យ​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ ៖  KDVI ប្រើ​អថេរ PATH របស់​សែល ពេល​កំពុង​រក​កម្មវិធី ។​"

#: dviexport.cpp:272
msgid "*.pdf|Portable Document Format (*.pdf)"
msgstr "*.pdf|Portable ទ្រង់ទ្រាយ​ឯកសារ (*.pdf)"

#: dviexport.cpp:272 dviexport.cpp:357
msgid "Export File As"
msgstr "នាំចេញ​ឯកសារ​ជា​"

#: dviexport.cpp:280 dviexport.cpp:365
#, qt-format
msgid ""
"The file %1\n"
"exists. Do you want to overwrite that file?"
msgstr ""
"ឯកសារ %1\n"
"មាន​រួច​ហើយ ។ តើ​អ្នក​ចង់​សរសេរ​ជាន់​ពី​លើ​ឯកសារ​នោះ​​ឬ?"

#: dviexport.cpp:281 dviexport.cpp:366
msgid "Overwrite File"
msgstr "សរសេរ​ជាន់​លើ​ឯកសារ"

#: dviexport.cpp:282 dviexport.cpp:367
msgid "Overwrite"
msgstr "សរសេរ​ជាន់​លើ"

#: dviexport.cpp:288
msgid "Using dvipdfm to export the file to PDF"
msgstr "ប្រើប្រាស់ dvipdfm ដើម្បី​នាំចេញ​ជា​ឯកសារ PDF"

#: dviexport.cpp:289
msgid ""
"KDVI is currently using the external program 'dvipdfm' to convert your DVI-"
"file to PDF. Sometimes that can take a while because dvipdfm needs to "
"generate its own bitmap fonts Please be patient."
msgstr ""
"KDVI បច្ចុប្បន្ន​ប្រើប្រាស់​កម្មវិធី 'dvipdfm' ខាង​ក្រៅ​ដើម្បី​បម្លែង​ទៅ​ជា​ឯកសារ DVI ទៅ PDF ។ "
"ពេល​ខ្លះ​អ្នកអាច​ប្រើ​វា​បាន​មួយ​រយៈ ព្រោះ dvipdfm ត្រូវ​ការ​បង្កើត​ពុម្ព​អក្សរ​រូបភាព​ផ្ទាល់​ខ្លួន​របស់​វា​"
"សូម​រង់ចាំ​ដោយ​ការ​អត់ធ្មត់​បន្តិច ។"

#: dviexport.cpp:293
msgid "Waiting for dvipdfm to finish..."
msgstr "កំពុង​រង់ចាំ dvipdfm ដើម្បី​បញ្ចប់​..."

#: dviexport.cpp:294
msgid "dvipdfm progress dialog"
msgstr "ប្រអប់​វឌ្ឍនៈភាព​របស់ dvipdfm "

#: dviexport.cpp:296
#, qt-format
msgid "Export: %1 to PDF"
msgstr "នាំចេញ ៖ %1 ជា PDF"

#: dviexport.cpp:304
msgid ""
"<qt>The external program 'dvipdfm', which was used to export the file, "
"reported an error. You might wish to look at the <strong>document info "
"dialog</strong> which you will find in the File-Menu for a precise error "
"report.</qt>"
msgstr ""
"<qt>កម្មវិធី 'dvipdf' ខាង​ក្រៅ​ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​នាំ​ឯកសារ​ចេញ រាយការណ៍​ពី​កំហុស ។ អ្នកប្រហែល​ជា​ចង់​រក​មើល <strong>ប្រអប់​ព័ត៌មាន​ឯកសារ</strong> ដែល​អ្នក​នឹង រក​​ក្នុង​ម៉ឺនុយ​ឯកសា​ចំពោះ​កំហុស​ដែល​មិន​បាន​"
"បញ្ចូល ។</qt>"

#: dviexport.cpp:332
msgid ""
"<qt><P>This DVI file refers to external graphic files which are not in "
"PostScript format, and cannot be handled by the <strong>dvips</strong> "
"program that KDVI uses interally to print or to export to PostScript. The "
"functionality that you require is therefore unavailable in this version of "
"KDVI.</p><p>As a workaround, you can use the <strong>File/Export As</strong>-"
"Menu to save this file in PDF format, and then use a PDF viewer.</p><p>The "
"author of KDVI apologizes for the inconvenience. If enough users complain, "
"the missing functionality might later be added.</p></qt>"
msgstr "<qt><P>ឯកសារ DVI នេះ​អាស្រ័យ​លើ​ឯកសារ​ក្រាហ្វិក​ខាង​ក្រៅ ដែល​គ្មាន​នៅ​ក្នុង​ទ្រង់ទ្រាយ​PostScript ហើយ​មិន​អាច​ដោះស្រាយ​ដោយ កម្មវិធី​<strong>dvips</strong> ប្រើ KDVI ដើម្បី​បោះពុម្ព ​ឬ​នាំចេញ​ទៅ​ជា PostScript ។ មុខងារ​ដែល​អ្នក​ត្រូវការ​នោះ​គឺ  KDVI មិន​អាច​ប្រើបាន​ក្នុង​កំណែ​នេះ​បាន​ឡើ​យ ។</p><p> ជុំវិញ​ការងារ អ្នក​អាច​ប្រើ <strong> ឯកសារ ឬ​នាំចេញ​ជា​</strong> ម៉ឺនុយ​ដើម្បី​រក្សា​ទុក​ឯកសារ​នេះ​ក្នុង​ទ្រង់ទ្រាយ PDF ហើយ​បន្ទាប់​មក​ប្រើ​កម្មវិធី​មើល PDF ។</p><p>អ្នក​និពន្ធ KDVI បាន​សុំទោស​ដោយសារតែ ហេតុ​ការណ៍​អាក្រក់​បាន​កើត​ឡើង ។ បើ​អ្នក ប្រើ​ប្រាស់​ជាច្រើន​ត្អូញត្អែរ​ពី​កំហុស មុខងារ​ដែល​បាត់​អាច​ត្រូវ​បាន​បន្ថែម​នៅ​ពេល​ក្រោយ ។</p></qt>"

#: dviexport.cpp:339
msgid "Functionality Unavailable"
msgstr "មុខងារ​ដែល​មិន​អាច​រក​បាន​"

#: dviexport.cpp:344
msgid ""
"KDVI could not locate the program 'dvips' on your computer. That program is "
"essential for the export function to work.\n"
"Hint to the perplexed system administrator: KDVI uses the PATH environment "
"variable when looking for programs."
msgstr ""
"KDVI មិន​អាច​រក​ឃើញ​កម្មវិធី 'dvips' នៅ​លើ​កុំព្យូទ័រ​របស់​អ្នក​ឡើយ ។ កម្មវិធី​នោះ​ជា​កម្មវិធី​សំខាន់​សម្រាប់​នាំ​រូបមន្ត​ចេញ​ដើម្បី​ប្រតិបត្តិ ។\n"
"ការ​ណែនាំ​ចំពោះ​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​ដែល​អល់អែក ៖ KDVI ប្រើ​អថេរ​បរិស្ថាន PATH ពេល​កំពុង​រក​មើល​កម្មវិធី ។"

#: dviexport.cpp:357
msgid "*.ps|PostScript (*.ps)"
msgstr "*.ps|PostScript (*.ps)"

#: dviexport.cpp:443
msgid "Using dvips to export the file to PostScript"
msgstr "ប្រើប្រាស់ dvips នាំចេញ​ឯកសារ​ទៅ​ជា​ឯកសារ PostScript"

#: dviexport.cpp:444
msgid ""
"KDVI is currently using the external program 'dvips' to convert your DVI-"
"file to PostScript. Sometimes that can take a while because dvips needs to "
"generate its own bitmap fonts Please be patient."
msgstr "KDVI បច្ចុប្បន្ន​កំពុង​ប្រើប្រាស់​កម្មវិធី 'dvipdfm' ខាង​ក្រៅ​ដើម្បី​បម្លែង​ទៅ​ជា​ឯកសារ DVI ទៅ​ជា PDF ។ ពេលខ្លះ​អ្នកអាច​ប្រើ​វា​បាន​មួយ​រយៈ ព្រោះ dvipdfm ត្រូវ​ការ​បង្កើត​ពុម្ព​អក្សរ​រូបភាព​ផ្ទាល់​ខ្លួន​របស់​វា​សូម​រង់ចាំ​ដោយ​ការ​អត់ធ្មត់​បន្តិច ។"

#: dviexport.cpp:448
msgid "Waiting for dvips to finish..."
