#: TeXFontDefinition.cpp:107
#, qt-format
msgid "Cannot find font %1, file %2."
msgstr "មិន​អាច​រក​ពុម្ព​អក្សរ %1 ឯកសារ %2 បាន​ទេ ។"

#: TeXFontDefinition.cpp:123
#, qt-format
msgid "Checksum mismatch for font file %1"
msgstr "ឆេកសាំ​មិនផ្គូផ្គង សម្រាប់​ឯកសារ​ពុម្ពអក្សរ %1"

#: TeXFontDefinition.cpp:132
msgid "TeX virtual"
msgstr "TeX និម្មិត​"

#: TeXFontDefinition.cpp:141
msgid "TeX Font Metric"
msgstr "រង្វាស់​ម៉ែត្រ​ពុម្ព​អក្សរ TeX"

#: TeXFontDefinition.cpp:166
msgid "FreeType"
msgstr "FreeType"

#: TeXFontDefinition.cpp:171
#, qt-format
msgid "Cannot recognize format for font file %1"
msgstr "មិន​អាច​ទទួល​ស្គាល់​ទ្រង់ទ្រាយ​សម្រាប់​ឯកសារ​ពុម្ព​អក្សរ %1 បាន​ទេ"

#: TeXFont_PFB.cpp:42
#, qt-format
msgid ""
"The font file %1 could be opened and read, but its font format is "
"unsupported."
msgstr "អាច​បើក និង អាន​ឯកសារ​ពុម្ព​អក្សរ %1 បាន ប៉ុន្តែ​ទ្រង់ទ្រាយ​ពុម្ព​អក្សរ​របស់​វា​គឺ​មិន​ត្រូវ​បាន​គាំទ្រ​ទេ ។"

#: TeXFont_PFB.cpp:48
#, qt-format
msgid "The font file %1 is broken, or it could not be opened or read."
msgstr "ឯកសារ​ពុម្ព​អក្សរ %1 ខូច ឬ​មិន​អាច​បើក ឬ​អាន​វា​បាន ។"

#: TeXFont_PFB.cpp:169
#, qt-format
msgid "FreeType reported an error when setting the character size for font file %1."
msgstr "ប្រភេទ​ឥត​គិត​ថ្លៃ​បាន​ធ្វើ​របាយការណ៍​កំហុស ពេល​កំពុង​កំណត់​ទំហំ​តួអក្សរ​របស់​ឯកសារ​ពុម្ព​អក្សរ %1 ។​"

#: TeXFont_PFB.cpp:185
#, qt-format
msgid "FreeType is unable to load glyph #%1 from font file %2."
msgstr "ប្រភេទ​ឥត​គិត​ថ្លៃ​មិន​អាច​ផ្ទុក glyph #%1ពី​ឯកសារ​ពុម្ព​អក្សរ %2 បានឡើយ ។​"

#: TeXFont_PFB.cpp:197
#, qt-format
msgid "FreeType is unable to render glyph #%1 from font file %2."
msgstr "ប្រភេទ​ឥតគិតថ្លៃ​មិន​អាច​បង្ហាញ glyph #%1ពី​ឯកសារ​ពុម្ពអក្សរ %2 បានឡើយ ។"

#: TeXFont_PFB.cpp:210
#, qt-format
msgid "Glyph #%1 is empty."
msgstr "Glyph #%1 គឺ​ទទេ ។​"

#: TeXFont_PFB.cpp:211
#, qt-format
msgid "Glyph #%1 from font file %2 is empty."
msgstr "Glyph #%1 ពី​ឯកសារ​ពុម្ព​អក្សរ %2 គឺ​ទទេ ។"

#: TeXFont_PFB.cpp:279
#, qt-format
msgid "FreeType is unable to load metric for glyph #%1 from font file %2."
msgstr "FreeType មិន​អាច​ផ្ទុក​រង្វាស់​ម៉ែត្រ​សម្រាប់ glyph #%1 ពី​ឯកសារ​ពុម្ព​អក្សរ %2 បាន​ទេ ។"

#: TeXFont_PK.cpp:89
#, qt-format
msgid "Cannot open font file %1."
msgstr "មិន​អាច​បើក​ឯកសារ​ពុម្ព​អក្សរ %1 បាន​ទេ ។"

#: TeXFont_PK.cpp:134
#, qt-format
msgid "TexFont_PK::operator[]: Character %1 not defined in font %2"
msgstr "TexFont_PK::operator[] ៖ តួ​អក្សរ %1 ពុំ​បាន​កំណត់​ក្នុង​ពុម្ព​អក្សរ %2 ឡើយ ។"

#: TeXFont_PK.cpp:450
#, qt-format
msgid "Unexpected %1 in PK file %2"
msgstr "%1 ដែល​មិន​បាន​រំពឹង​ក្នុង​ឯកសារ PK %2"

#: TeXFont_PK.cpp:517
#, qt-format
msgid "The character %1 is too large in file %2"
msgstr "តួ​អក្សរ %1 ធំពេក​នៅក្នុងឯកសារ %2"

#: TeXFont_PK.cpp:622 TeXFont_PK.cpp:708
#, qt-format
msgid "Wrong number of bits stored:  char. %1, font %2"
msgstr "ខុស​លេខ​​នៃ​ប៊ីត​ដែ​ល​បាន​ផ្ទុក ៖  តួ​អក្សរ %1 ពុម្ព​អក្សរ %2"

#: TeXFont_PK.cpp:624 TeXFont_PK.cpp:710
#, qt-format
msgid "Bad pk file (%1), too many bits"
msgstr "ឯកសារ pk មិន​ត្រឹមត្រូវ (%1) គឺ​ដោយ​មាន​ចំនួន​ប៊ីត​ច្រើន​ពេក"

#: TeXFont_PK.cpp:741
msgid "Font has non-square aspect ratio "
msgstr "ពុម្ព​អក្សរ​មាន​សមាមាត្រ​ដែល​មិន​មែន​ជា​ការេ​"

#: dviFile.cpp:111
msgid "The DVI file does not start with the preamble."
msgstr "ឯកសារ DVI មិន​ចាប់ផ្ដើម​ជាមួយ​នឹង​លំនាំ​ដើម​​ទេ ។"

#: dviFile.cpp:116
msgid ""
"The DVI file contains the wrong version of DVI output for this program. "
"Hint: If you use the typesetting system Omega, you have to use a special "
"program, such as oxdvi."
msgstr "ឯកសារ DVI មាន​កំណែ​ខុស​របស់ទិន្នផល DVI សម្រាប់​កម្មវិធី​នេះ ។  ការណែនាំ ៖ បើ​អ្នក​ប្រើ​ប្រព័ន្ធ​ការ​កំណត់​ប្រភេទ​អ៉ូម៉េហ្គា អ្នក​ត្រូវ​តែ​ប្រើ​កម្មវិធី​ពិសេស ដូចជា oxdvi ។​"

#: dviFile.cpp:154
msgid "The DVI file is badly corrupted. KDVI was not able to find the postamble."
msgstr "ឯកសារ DVI បាន​ខូច ។ KDVI មិន​អាច​រក​កម្មវិធី​ដែល​អាច​​រក​ឃើញ postamble បាន​ឡើយ ។"

#: dviFile.cpp:169
msgid "The postamble does not begin with the POST command."
msgstr "Postamble មិន​អាច​ចាប់​ផ្តើម​ជា​មួយ​បញ្ជា POST បាន​ឡើយ ។​"

#: dviFile.cpp:222
msgid "The postamble contained a command other than FNTDEF."
msgstr "Postamble មាន​ពាក្យ​បញ្ជា​ក្រៅ​ពី FNTDEF ។"

#: dviFile.cpp:255
#, qt-format
msgid "The page %1 does not start with the BOP command."
msgstr "ទំព័រ %1 មិន​ចាប់​ផ្ដើម​ជាមួយ​នឹង​ពាក្យ​បញ្ជា BOP ឡើយ ។"

#: dviFile.cpp:291
msgid "Not enough memory to load the DVI-file."
msgstr "គ្មាន​សតិ​គ្រប់គ្រាន់​ដើម្បី​ផ្ទុក​ឯកសារ DVI ឡើយ ។"

#: dviFile.cpp:297
msgid "Could not load the DVI-file."
msgstr "មិនអាច​ផ្ទុក​ឯកសារ DVI ឡើយ ។"

#: dviFile.cpp:386
#, qt-format
msgid ""
"<qt><p>The external program <strong>pdf2ps</strong> could not be started. As "
"a result, the PDF-file %1 could not be converted to PostScript. Some graphic "
"elements in your document will therefore not be displayed.</p><p><b>Possible "
"reason:</b> The program <strong>pdf2ps</strong> is perhaps not installed on "
"your system, or it cannot be found in the current search path.</p><p><b>What "
"you can do:</b> The program <strong>pdf2ps</strong> program is normally "
"contained in distributions of the ghostscript PostScript interpreter system. "
"If ghostscipt is not installed on your system, you could install it now. If "
"you are sure that ghostscript is installed, please try to use "
"<strong>pdf2ps</strong> from the command line to check if it really works.</"
"p><p><b>PATH:</b> %2</p></qt>"
msgstr ""
"<qt><p>កម្មវិធី​ខាង​ក្រៅ<strong>pdf2ps</strong> មិនអាច​ចាប់​ផ្តើម​បានទេ ។ ជាលទ្ធផល​ឯកសារ "
"PDF %1 ក៏​មិនអាច​បម្លែង​ទៅ​ជា PostScript ដែរ ។ ធាតុ​ក្រាហ្វិក​មួយ​ចំនួន​ក្នុង​ឯកសារ​របស់​អ្នកនឹង​មិន​ត្រូវ​បង្ហាញ​ឡើយ ។</p><p><b>ហេតុផល​ដែល​អាច​ធ្វើ​បាន ៖</b> កម្មវិធី <strong>pdf2ps</strong> "
"ប្រហែល​ជា​មិនទាន់​ដំឡើង​លើ​ប្រព័ន្ធ​របស់​អ្នកនូវ​ឡើយ​ទេ ឬ​វា​មិនអាច​រក​ឃើញ​នៅ​ក្នុង​ផ្លូវ​ស្វែងរក ។</"
"p><p><b>តើ​អ្នក​អាច​ធ្វើ​អ្វី​បាន ៖</b> កម្មវិធី <strong>pdf2ps</strong> ជាធម្មតាមាននៅ​ក្នុង​"
"ការចែកចាយ​នៃ​ប្រព័ន្ធ​បកប្រែ ghostscript PostScript ។ បើ ghostscipt ពុំ​ទាន់​បាន​ដំឡើង​លើ​"
"ប្រព័ន្ធ​របស់​អ្នកទេ អ្នកអាច​ដំឡើង​វា​ឥឡូវ​នេះ ។ បើ​អ្នក​ប្រាកដ​ថា ghostscript បាន​ដំឡើង​រួចហើយ "
"សូមព្យាយាម​ប្រើបន្ទាត់​ពាក្យ​បញ្ជា​<strong>pdf2ps</strong> ដើម្បី​ត្រួតពិនិត្យ បើ​វា​ពិត​ជា​ធ្វើការ​"
"មែន ។</p><p><b>PATH:</b> %2</p></qt>"

#: dviFile.cpp:410
msgid ""
"<qt><p>The PDF-file %1 could not be converted to PostScript. Some graphic "
"elements in your document will therefore not be displayed.</p><p><b>Possible "
"reason:</b> The file %1 might be broken, or might not be a PDF-file at all. "
"This is the output of the <strong>pdf2ps</strong> program that KDVI used:</"
"p><p><strong>%2</strong></p></qt>"
msgstr ""
"<qt><p>ឯកសារ PDF %1 មិនអាច​បម្លែង​ទៅ​ជា​ឯកសារ PostScript បាន​ឡើយ ។ ធាតុ​ក្រហ្វិក​មួយ​ចំនួន​នៅ​"
"ក្នុង​ឯកសារ​របស់អ្នកនឹង​មិនត្រូវ​បាន​បង្ហាញ​ឡើយ ។</p><p><b>មូលហេតុ​ដែលអាច​ធ្វើ​បាន ៖</b> ឯកសារ %1 ប្រហែលជា​ខូច ឬ​វា​អាច​មិន​មែន​ជា​ឯកសារ PDF ។ នេះ​ជា​លទ្ធផល​នៃ​កម្មវិធី <strong>pdf2ps</strong> "
"ដែល KDVI ត្រូវ​ប្រើ ៖ </p><p><strong>%2</strong></p></qt>"

#: dviRenderer.cpp:261
#, qt-format
msgid "Chapter %1"
msgstr "ជំពូក %1"

#: dviRenderer.cpp:265
#, qt-format
msgid "Section %1"
msgstr "ភាគ %1"

#: dviRenderer.cpp:269
#, qt-format
msgid "Subsection %1"
msgstr "ភាគ​រង %1"

#: dviRenderer.cpp:273
#, qt-format
msgid "Figure %1"
msgstr "រូបភាព​ពន្យល់ %1"

#: dviRenderer.cpp:277
#, qt-format
msgid "Theorem %1"
msgstr "ទ្រឹស្តីបទ %1"

#: dviRenderer.cpp:281
#, qt-format
msgid "Lemma %1"
msgstr "Lemma %1"

#: dviRenderer.cpp:285
#, qt-format
msgid "Remark %1"
msgstr "កំណត់​សម្គាល់ %1"

#: dviRenderer.cpp:289
#, qt-format
msgid "Example %1"
msgstr "ឧទាហរណ៍ %1"

#: dviRenderer.cpp:293
#, qt-format
msgid "Equation %1"
msgstr "សមីការ %1"

#: dviRenderer.cpp:297
#, qt-format
msgid "Item %1"
msgstr "ធាតុ %1"

#: dviRenderer.cpp:301
#, qt-format
msgid "Citation [%1]"
msgstr "សេចក្តី​ស្រង់ [%1]"

#: dviRenderer.cpp:308
msgid ""
"<qt><strong>File corruption</strong> KDVI could not interprete your DVI "
"file. This is most commonly caused by a corrupted file.</qt>"
msgstr "<qt><strong>ការ​ខូច​ឯកសារ​</strong> KDVI មិន​អាច​បកប្រែ​ឯកសារ DVI របស់​អ្នក​ឡើយ ។ បញ្ហា​នេះ​ទំនង​ជា​បង្ក​ឡើង​ដោយ​ឯកសារ​ដែល​បាន​ខូច ។</qt>"

#: dviRenderer.cpp:310 dviRenderer.cpp:587
msgid "DVI File Error"
msgstr "កំហុស​ឯកសារ DVI"

#: dviRenderer.cpp:364
msgid "KDVI: Information"
msgstr "KDVI ៖ ព័ត៌មាន​"

#: dviRenderer.cpp:379
msgid ""
"<qt>This DVI file contains source file information. You may click into the "
"text with the middle mouse button, and an editor will open the TeX-source "
"file immediately.</qt>"
msgstr "<qt>ឯកសារ DVI នេះ មាន​ព័ត៌មាន​ឯកសារ​ប្រភព ។ អ្នក​អាច​ចុច​លើ​អត្ថបទ ជា​មួយ​ប៊ូតុង​កណ្តុរ ​កណ្តាល ហើយ​កម្មវិធី​និពន្ធ​នឹង​បើក​ឯកសារ​ប្រភព TeX ភ្លាម​តែម្តង ។</qt>"

#: dviRenderer.cpp:386
msgid "Do not show this message again"
msgstr "កុំ​បង្ហាញ​សារ​នេះ​ម្តង​ទៀត"

#: dviRenderer.cpp:388
msgid "Explain in more detail..."
msgstr "ពន្យល់​លម្អិត​បន្ថែម..."

#: dviRenderer.cpp:416
msgid "Embedding PostScript Files"
msgstr "បង្កប់​ឯកសារ PostScript"

#: dviRenderer.cpp:448
msgid "Not all PostScript files could be embedded into your document."
msgstr "មិន​មែន​ឯកសារ PostScript ទាំងអស់​អាច​ត្រូវ​បាន​បង្កប់​ទៅ​ក្នុង​ឯកសារ​របស់​អ្នក ។"

#: dviRenderer.cpp:451
msgid ""
"All external PostScript files were embedded into your document. You will "
"probably want to save the DVI file now."
msgstr "​ឯកសារ PostScript ខាងក្រៅ​ទាំងអស់​ត្រូវ​បាន​បង្កប់​ទៅ​ក្នុង​ឯកសារ​របស់​អ្នក ។ អ្នក​ប្រហែល​ជា​ចង់​រក្សា​ឯកសារ​​ទុក DVI ឥឡូវ​នេះ?"

#: dviRenderer.cpp:543
#, qt-format
msgid ""
"<qt><strong>File error.</strong> The specified file '%1' does not exist. "
"KDVI already tried to add the ending '.dvi'.</qt>"
msgstr "<qt><strong>កំហុស​ឯកសារ ។</strong> ឯកសារ '%1' ដែល​បាន​បញ្ជាក់មិន​ទាន់​មាន​នូវ​ឡើយ​ទេ ។ KDVI បានព្យាយាម​បន្ថែម​ខាង​ចុ​ង​នៃ '.dvi' ។</qt>"

#: dviRenderer.cpp:545
msgid "File Error"
msgstr "កំហុស​ឯកសារ"

#: dviRenderer.cpp:556
#, qt-format
msgid ""
"<qt>Could not open file <nobr><strong>%1</strong></nobr> which has type "
"<strong>%2</strong>. KDVI can only load DVI (.dvi) files.</qt>"
msgstr "<qt>មិន​អាច​បើក​ឯកសារ<nobr><strong>%1</strong></nobr> ដែល​មាន​ប្រភេទ <strong>%2</strong> ។ KDVI អាច​ផ្ទុក​តែ​ឯកសារ DVI (.dvi) ។</qt>"

#: dviRenderer.cpp:567
#, qt-format
msgid ""
"<qt>File corruption! KDVI had trouble interpreting the file <nobr><strong>%"
"1</strong></nobr>. Most likely this means that the DVI file is broken.</qt>"
msgstr "<qt>ការ​ខូច​ឯកសារ! KDVI មាន​បញ្ហា​ក្នុង​ការ​បកប្រែ​ឯកសា <nobr><strong>%1</strong></nobr> ។ វា​ទំនង​ជា​មក​ពី​ឯកសារ DVI ខូច​ហើយ ។</qt>"

#: dviRenderer.cpp:585
msgid ""
"<qt>File corruption. KDVI could not interprete your DVI file. This is most "
"commonly caused by a corrupted file.</qt>"
msgstr ""
"<qt>ការ​ខូច​ឯកសារ ។ KDVI មិនអាច​បកប្រែ​ឯកសារ DVI របស់​អ្នក​បាន​ឡើយ ។ ការ​នេះ​វា​ទំនង​ជា​បង្កឡើង​ដោយ​"
"ឯកសារ​ដែលបាន​ខូច ។</qt>"

#: dviRenderer.cpp:742
#, qt-format
msgid ""
"<qt>You have asked KDVI to locate the place in the DVI file which "
"corresponds to line %1 in the TeX-file <strong>%2</strong>. It seems, "
"however, that the DVI file does not contain the necessary source file "
"information. We refer to the manual of KDVI for a detailed explanation on "
"how to include this information. Press the F1 key to open the manual.</qt>"
msgstr ""
"<qt>អ្នក​បាន​ស្នើ KDVI ទៅ​ទីតាំង​ក្នុង​ឯកសារ DVI ដែល​ឆ្លើយ​តប​នឹង​បន្ទាត់ %1 ក្នុង​ឯកសារ TeX "
"<strong>%2</strong> ។ ឯកសារ DVI មិន​ទាន់​មាន​ព័ត៌មាន​ឯកសារ​ប្រភព​ចាំបាច់​នូវ​ឡើយ​ទេ ។ យើង​យោង​ទៅ​សៀវភៅ​ដៃ​របស់ KDVI ដែលមានការពន្យល់លម្អិត​ថា​តើ​ត្រូវ​រួម​បញ្ចូល​ព័ត៌មាន​តាម​របៀប​ណា ។ សូម​ចុច​គ្រាប់​ចុច F1ដើម្បី​បើក​សៀវភៅ​ដៃ ។</qt>"

#: dviRenderer.cpp:747 dviRenderer.cpp:785
msgid "Could Not Find Reference"
msgstr "មិន​អាច​រក​សេចក្តី​យោង​បាន​ឡើយ​"

#: dviRenderer.cpp:783
#, qt-format
msgid ""
"<qt>KDVI was not able to locate the place in the DVI file which corresponds "
"to line %1 in the TeX-file <strong>%2</strong>.</qt>"
msgstr "<qt>KDVI មិន​អាច​កំណត់​ទីតាំង​ក្នុង​ឯកសារ DVI ដែល​ឆ្លើយ​តប​ទៅ​នឹង​បន្ទាត់ %1 ក្នុង​ឯកសារ TeX <strong>%2</strong>ឡើយ ។</qt>"

#: dviRenderer_draw.cpp:262
msgid "The DVI code set a character of an unknown font."
msgstr "កូដ DVI កំណត់​តួ​អក្សរ​ដែល​មិន​ស្គាល់​ពុម្ព​អក្សរ ។"

#: dviRenderer_draw.cpp:287 dviRenderer_prescan.cpp:646
#, qt-format
msgid "The DVI code referred to font #%1, which was not previously defined."
msgstr "កូដ DVI បាន​អាស្រ័យ​លើ​ពុម្ព​អក្សរ #%1 តើ​កូដ​មួយ​ណា​ដែល​មិន​ទាន់​បាន​កំណត់​ពី​មុន ។"

#: dviRenderer_draw.cpp:372
msgid "The stack was not empty when the EOP command was encountered."
msgstr "ជង់​មិន​អាច​ទទេ​បាន​ទេ ពេល​​បាន​ជួប​ពាក្យ​បញ្ជា EOP ។"

#: dviRenderer_draw.cpp:384
msgid "The stack was empty when a POP command was encountered."
msgstr "ជង់​ទទេ​បាន​ទេ ពេល​ជួប​ប្រទះ​ពាក្យ​បញ្ជា POP ។"

#: dviRenderer_draw.cpp:508 dviRenderer_draw.cpp:517
msgid "The DVI code referred to a font which was not previously defined."
msgstr "កូដ DVI យោង​ទៅ​ពុម្ព​អក្សរ ដែល​មិន​បាន​កំណត់​ពី​​មុន ។​"

#: dviRenderer_draw.cpp:557
msgid "An illegal command was encountered."
msgstr "បាន​ជួប​ប្រទះ​ពាក្យ​បញ្ជា​ដែល​មិន​ត្រឹមត្រូវ ។​​"

#: dviRenderer_draw.cpp:562
#, qt-format
msgid "The unknown op-code %1 was encountered."
msgstr "បាន​ជួប​ប្រទះ​កូដ op %1 ដែល​មិន​ស្គាល់ ។"

#: dviRenderer_prescan.cpp:87
#, qt-format
