#: fontpool.cpp:277
msgid ""
"<qt><p>KDVI was not able to locate all the font files which are necessary to "
"display the current DVI file. Your document might be unreadable.</p></qt>"
msgstr "<qt><p>KDVI មិន​អាច​រក​ទីតាំង​សម្រាប់​ឯកសារ​ពុម្ព​អក្សរ​ទាំងអស់ ដែល​ចាំបាច់​ក្នុង​ការ​បង្ហាញ​ឯកសារ DVI បច្ចុប្បន្ន ។ ឯកសារ​របស់​អ្នក​ប្រហែល​ជា​មិន​អាច​អាន​បាន​ឡើយ ។​</p></qt>"

#: fontpool.cpp:281
