#: libs/dimg/filters/bw/bwsepiasettings.cpp:247
#, fuzzy
msgid ""
"<b>Black & White with Green Filter</b>:<p>Simulate black and white film "
"exposure using a green filter. This is useful for all scenic shoots, "
"especially portraits photographed against the sky.</p>"
msgstr ""
"<b>ពណ៌​ខ្មៅ និង​ស​ជា​មួយ​តម្រង​ពណ៌​​បៃតង</b> ៖<p>ធ្វើ​ត្រាប់​តាមការ​បង្ហាញ​ហ្វីល​​ស និង​ខ្មៅ ដោយ​ប្រើ​តម្រង​ពណ៌​"
"បៃតង​ ។ វាមាន​ប្រយោជន៍​បំផុត​សម្រាប់​ការ​ថត​បែប​ទស្សនីយភាព​ទាំង​ឡាយ ជា​ពិសេស​សម្រាប់​ការ​បញ្ឈរ​ដែល​ថត​​​ទល់​"
"មេឃ  ។</p>"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:253
#, fuzzy
msgid "Orange Filter"
msgstr "តម្រង​ពណ៌​ទឹកក្រូច"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:254
#, fuzzy
msgid ""
"<b>Black & White with Orange Filter</b>:<p>Simulate black and white film "
"exposure using an orange filter. This will enhance landscapes, marine scenes "
"and aerial photography.</p>"
msgstr ""
"<b>ស​ និង​ខ្មៅ​ជា​មួយ​តម្រង់​ពណ៌​ទឹក​ក្រូច​ </b> ៖<p> ធ្វើ​ត្រាប់​តាម​ការ​បង្ហាញ​ហ្វីល​ស និង​ខ្មៅ ដោយ​ប្រើ​តម្រង​ពណ៌​"
"ទឹក​ក្រូច ។ វា​នឹង​ប្រសើរ​នូវ​ការ​ថត​បែប​អាកាស និង​ទស្សនីយ​ភាព​ផ្តេក​បែប​​​សមុទ្រ ។</p>"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:260
#, fuzzy
msgid "Red Filter"
msgstr "តម្រង​ពណ៌​ក្រហម"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:261
#, fuzzy
msgid ""
"<b>Black & White with Red Filter</b>:<p>Simulate black and white film "
"exposure using a red filter. This creates dramatic sky effects, and "
"simulates moonlight scenes in the daytime.</p>"
msgstr ""
"<b>ស និង​ខ្មៅ​ជា​មួយ​តម្រង​ពណ៌​ក្រហម​</b>​៖<p>​ធ្វើ​ត្រាប់​តាម​ការ​បង្ហាញ​ហ្វីល​ស និង​ខ្មៅ ដោយ​ប្រើ​តម្រង​ពណ៌​"
"ក្រហម​ ។ វា​នឹង​បង្កើត​នូវ​បែប​ផែន​ផ្ទៃ​មេឃ​ដែល​គួរ​ឲ្យ​រំភើប និង​ធ្វើ​ត្រាប់​តាម​ទស្សនីយភាព​ពន្លឺ​ព្រះចន្ទ​នៅ​ពេល​"
"ថ្ងៃ ។</p>"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:267
#, fuzzy
msgid "Yellow Filter"
msgstr "តម្រង​ពណ៌​លឿង"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:268
#, fuzzy
msgid ""
"<b>Black & White with Yellow Filter</b>:<p>Simulate black and white film "
"exposure using a yellow filter. This has the most natural tonal correction, "
"and improves contrast. Ideal for landscapes.</p>"
msgstr ""
"<b>ស និង​ខ្មៅ​ជា​មួយ​តម្រង​ពណ៌​លឿង​</b> ៖<p>​ធ្វើ​ត្រាប់​តាម​ការ​បង្ហាញ​ហ្វីល​ពណ៌​ស និង​ខ្មៅ ដោយ​ប្រើ​តម្រង​ពណ៌​"
"លឿង ។ វា​មាន​ការកែខៃ​ទឹក​ពណ៌​បែប​ធម្មជាតិ​បំផុត និង​បង្កើន​នូវ​កម្រិត​ពណ៌​ទៀត​ផង ។ ប្រសើរ​បំផុត​សម្រាប់​​​ផ្តេក​ ។"
"</p>"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:274
#, fuzzy
msgid "Yellow-Green Filter"
msgstr "តម្រង​ពណ៌​លឿង និង​បៃតង"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:275
#, fuzzy
msgid ""
"<b>Black & White with Yellow-Green Filter</b>:<p>Simulate black and white "
"film exposure using a yellow-green filter. A yellow-green filter is highly "
"effective for outdoor portraits because red is rendered dark while green "
"appears lighter. Great for correcting skin tones, bringing out facial "
"expressions in close-ups and emphasizing the feeling of liveliness. This "
"filter is highly effective for indoor portraits under tungsten lighting.</p>"
msgstr ""
"<b>ស​ និង​ខ្មៅ​ជា​មួយ​តម្រង​ពណ៌​លឿង​ និង​បៃ​តង </b> ៖<p>​ធ្វើ​ត្រាប់​តាម​ការ​បង្ហាញ​ហ្វីល​ពណ៌​ស និង​ខ្មៅ​ ដោយ​ប្រើ​"
"តម្រង​ពណ៌​លឿង និង​បៃ​តង​ ។  តម្រង​ពណ៌​លឿង និង​បៃ​តង​មាន​ប្រសិទ្ធិភាព​ខ្ពស់​សម្រាប់​បញ្ឈរ​ខាង​ក្រៅ​ ពី​ព្រោះ​ពណ៌​ក្រហម​"
"ត្រូវ​បង្ហាញ​ងងឹត​ ខណៈ​ពេល​ពណ៌​បៃតង​បង្ហាញ​ភ្លឺ​ជាង​នេះ ។ អស្ចារ្យ​សម្រាប់​ការ​កែ​ខៃ​ទឹក​ពណ៌​របស់​ស្បែក ដោយ​"
"បង្ហាញ​ជា​លក្ខណៈ​ទឹក​មុខជិត​បំផុត​ និង​សង្កត់​ធ្ងន់​ទៅ​លើ​អារម្មណ៍​រស់​រវើក ។ តម្រង​នេះ​មាន​ប្រសិទ្ធិភាព​ខ្ពស់​"
"សម្រាប់បញ្ឈរ​ខាង​ក្រៅ​ ក្រោម​ពន្លឺតង់ស្តែន​ ។</p>"

#: libs/dimg/filters/bw/bwsepiasettings.cpp:283
