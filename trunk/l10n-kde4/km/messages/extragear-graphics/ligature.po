"qt>"
msgstr "<qt>កំពុង​ពន្លា​ឯកសារ​ <nobr><strong>%1</strong></nobr> ។ សូម​រង់ចាំ ។</qt>"

#: ligaturepart.cpp:853
#, qt-format
msgid ""
"<qt><strong>File Error</strong> Could not uncompress the file <nobr><strong>%"
"1</strong></nobr>. The file will not be loaded.</qt>"
msgstr ""
"<qt><strong>កំហុស​ឯកសារ</strong> មិន​អាច​ពន្លា​ឯកសារ​<nobr><strong>%1</strong></"
"nobr>បានទេ ។ ​ឯកសារ​នឹង​មិន​ត្រូវ​បានផ្ទុក​ឡើយ ។​</qt>"

#: ligaturepart.cpp:855
msgid ""
"<qt>This error typically occurs if the file is corrupt. If you want to be "
"sure, try to decompress the file manually using command-line tools.</qt>"
msgstr ""
"<qt>កំហុស​នេះ​កើតឡើង​ជា​ធម្មតា បើ​ឯកសា​ខូច ។ បើ​អ្នក​ចង់​ប្រាកដ ព្យាយាម​ពន្លា​ឯកសារ​ដោយ​ដៃ​ដោយ​ប្រើ​"
"ឧបករណ៍​បន្ទាត់​ពាក្យ​បញ្ជា ។</qt>"

#: ligaturepart.cpp:912
#, qt-format
msgid ""
"<qt>The document <b>%1</b> cannot be shown because its file type is not "
"supported.</qt>"
msgstr "<qt>មិន​អាច​បង្ហាញ​ឯកសារ <b>%1</b> បាន​ទេ ពីព្រោះមិន​គាំទ្រ​ប្រភេទ​ឯកសារ​របស់​វា ។</qt>"

#: ligaturepart.cpp:914
#, qt-format
msgid ""
"<qt>The file has mime type <b>%1</b> which is not supported by any of the "
"installed Ligature plugins.</qt>"
msgstr ""
"<qt>ឯកសារ​មាន​ប្រភេទ mime  <b>%1</b> ដែល​មិនបានគាំទ្រ​ដោយ​កម្មវិធី​ជំនួយរបស់ Ligature ដែល​បាន​"
"ដំឡើង​រួច ។</qt>"

#: ligaturepart.cpp:943
msgid ""
"<qt>No service implementing the given mimetype and fullfilling the given "
"constraint expression can be found.</qt>"
msgstr ""
"<qt>រក​មិន​ឃើញ​សេវា​ដែល​ប្រតិបត្តិ​ប្រភេទ mime ដែល​ផ្ដល់​ឲ្យ និង​បំពេញ​កន្សោម​កម្រិត​ដែល​ផ្ដល់​ឲ្យ ។</qt>"

#: ligaturepart.cpp:946
msgid "<qt>The specified service provides no shared library.</qt>"
msgstr "<qt>សេវា​ដែល​បាន​បញ្ជាក់​មិន​ផ្ដល់​បណ្ណាល័យ​ចែក​រំលែក​ទេ ។</qt>"

#: ligaturepart.cpp:949
#, qt-format
msgid ""
"<qt><p>The specified library <b>%1</b> could not be loaded. The error "
"message returned was:</p> <p><b>%2</b></p></qt>"
msgstr ""
"<qt><p>មិន​អាច​ផ្ទុក​បណ្ណាល័យ​ដែល​បាន​បញ្ជាក់ <b>%1</b> ទេ ។ សារ​កំហុស​ដែល​បាន​ត្រឡប់​គឺ ៖</p> "
"<p><b>%2</b></p></qt>"

#: ligaturepart.cpp:952
msgid "<qt>The library does not export a factory for creating components.</qt>"
msgstr "<qt>បណ្ណាល័យ​មិន​នាំ​ចេញ​រោងចក្រ​សម្រាប់​បង្កើត​សមាសភាគ​ទេ ។</qt>"

#: ligaturepart.cpp:955
msgid ""
"<qt>The factory does not support creating components of the specified type.</"
"qt>"
msgstr "<qt>រោងចក្រ​មិន​គាំទ្រ​ការ​បង្កើត​សមាសភាគ​នៃ​ប្រភេទ​ដែល​បាន​បញ្ជាក់​ឡើយ ។</qt>"

#: ligaturepart.cpp:959
#, qt-format
msgid ""
"<qt><p><b>Problem:</b> The document <b>%1</b> cannot be shown.</"
"p><p><b>Reason:</b> The software component <b>%2</b> which is required to "
"display files of type <b>%3</b> could not be initialized. This could point "
"to serious misconfiguration of your KDE system, or to damaged program files."
"</p><p><b>What you can do:</b> You could try to re-install the software "
"packages in question. If that does not help, you could file an error report, "
"either to the provider of your software (e.g. the vendor of your Linux "
"distribution), or directly to the authors of the software. The entry "
"<b>Report Bug...</b> in the <b>Help</b> menu helps you to contact the KDE "
"programmers.</p></qt>"
msgstr ""
"<qt><p><b>បញ្ហា ៖</b> មិន​អាច​បង្ហាញ​ឯកសារ <b>%1</b> បាន​ទេ ។</p><p><b>ហេតុផល ៖</b> "
"សមាសភាគ​កម្មវិធី <b>%2</b> ដែល​ត្រូវ​បាន​ទាមទារ​ដើម្បី​បង្ហាញ​ប្រភេទ​ឯកសារ <b>%3</b> មិន​អាច​ត្រូវ​"
"បាន​ចាប់ផ្ដើម​ទេ ។ វា​នេះ​អា​ចង្អុល​ទៅ​ការ​កំណត់​រចនា​សម្ព័ន្ធ​ខុស​ធ្ងន់ធ្ងរ​នៃ​ប្រព័ន្ធ KDE របស់​អ្នក ឬ ទៅ​"
"ឯកសារ​កម្មវិធី​ដែល​ខូច ។</p><p><b>អ្វី​ដែល​អ្នក​អាច​ធ្វើ ៖</b> អ្នក​អាច​ព្យាយាម​ដើម្បីដំឡើង​ឡើង​វិញ​កញ្ចប់​"
"កម្មវិធី​ក្នុង​សំណួរ ។ បើ​វា​នោះ​មិន​ជួយ​អ្នក​អាច​បង្កើត​ឯកសារ​របាយការណ៍​កំហុស ទៅ​អ្នក​ផ្ដល់​នៃ​កម្មវិធី​របស់​អ្នក "
"(ឧ. អ្នក​លក់​នៃ​ការ​ចែកចាយ លីនុច​របស់​អ្នក) ឬ ដោយ​ផ្ទាល់​ទៅ​អ្នក​និពន្ធ​នៃ​កម្មវិធី ។ ធាតុ <b>រាយការណ៍​"
