msgstr ""
"<qt><strong>កំហុស​ឯកសារ!</strong> មិន​អាច​បើក​ឯកសារ<nobr><strong>%1</strong></nobr> "
"សម្រាប់​ការ​ពន្លា​បាន​ទេ ។ ឯកសារ​នឹង​មិន​ត្រូវ​បាន​ផ្ទុក​ទេ ។</qt>"

#: ligaturepart.cpp:812
msgid ""
"<qt>This error typically occurs if you do not have enough permissions to "
"read the file. You can check ownership and permissions if you right-click on "
"the file in the Konqueror file manager and then choose the 'Properties' menu."
"</qt>"
msgstr ""
"<qt>កំហុស​នេះ​កើតឡើង​ជា​ធម្មតា បើ​អ្នក​មិន​មាន​សិទ្ធិ​គ្រប់គ្រាន់​ដើម្បី​អាន​ឯកសារ ។ អ្នក​អាច​ពិនិត្យ​មើល​ភាព​ជា​"
"កម្មសិទ្ធិ និង​សិទ្ធិ បើ​អ្នក​ចុច​កណ្ដុរ​ខាងស្ដាំ​លើ​ឯកសារ​ក្នុង​កម្មវិធី​គ្រប់គ្រង​ឯកសារ Konqueror ហើយ​ពេល​នោះ "
"ជ្រើស​ម៉ឺនុយ 'លក្ខណៈ​សម្បត្តិ'  ។</qt>"

#: ligaturepart.cpp:822
