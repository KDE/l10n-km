#: kiconedit.cpp:177 kiconeditslots.cpp:89 kiconeditslots.cpp:144
#: kiconeditslots.cpp:288
#, kde-format
msgid ""
"The current file has been modified.\n"
"Do you want to save it?"
msgstr ""
"ឯកសារ​បច្ចុប្បន្ន​ត្រូវ​​បាន​​កែប្រែ ។\n"
"តើ​អ្នក​ចង់​រក្សា​ទុក​វា​ឬទេ?"

#: kiconedit.cpp:253
#, kde-format
msgid "New &Window"
msgstr "បង្អួច​ថ្មី"

#: kiconedit.cpp:256
#, kde-format
msgid ""
"New window\n"
"\n"
"Opens a new icon editor window."
msgstr ""
"បង្អួច​ថ្មី\n"
"\n"
"បើក​បង្អួច​កម្មវិធី​និពន្ធ​​រូប​តំណាង​ថ្មី ។"

#: kiconedit.cpp:259
#, kde-format
msgid ""
"New\n"
"\n"
"Create a new icon, either from a template or by specifying the size"
msgstr ""
"ថ្មី\n"
"\n"
"បង្កើត​រូប​តំណាង​ថ្មី​មួយ​ពី​ពុម្ព​មួយ ឬ​ដោយ​បញ្ជាក់​ទំហំ"

#: kiconedit.cpp:263
#, kde-format
msgid ""
"Open\n"
"\n"
"Open an existing icon"
msgstr ""
"បើក\n"
"\n"
"បើក​រូប​តំណាង​ដែល​មាន​ស្រាប់"

#: kiconedit.cpp:271
#, kde-format
msgid ""
"Save\n"
"\n"
"Save the current icon"
msgstr ""
"រក្សា​ទុក\n"
"\n"
"រក្សា​ទុក​រូប​តំណាង​បច្ចុប្បន្ន"

#: kiconedit.cpp:276
#, kde-format
msgid ""
"Print\n"
"\n"
"Opens a print dialog to let you print the current icon."
msgstr ""
"បោះពុម្ព\n"
"\n"
"បើក​ប្រអប់​បោះពុម្ព ដើម្បី​អនុញ្ញាតិ​ឲ្យ​អ្នក​បោះពុម្ព​រូប​តំណាង​បច្ចុប្បន្ន ។"

#: kiconedit.cpp:284
#, kde-format
msgid ""
"Cut\n"
"\n"
"Cut the current selection out of the icon.\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"កាត់\n"
"\n"
"កាត់​ការ​ជ្រើសរើស​បច្ចុប្បន្ន​ចេញ​ពី​រូប​តំណាង ។\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ អ្នក​អាច​ធ្វើ​ការ​ជ្រើសរើស​ជា​រង្វង់ ឬ​ត្រីកោណ)"

#: kiconedit.cpp:288
#, kde-format
msgid ""
"Copy\n"
"\n"
"Copy the current selection out of the icon.\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"ចម្លង\n"
"\n"
"ចម្លង​ការ​ជ្រើសរើស​បច្ចុប្បន្ន​ចេញ​ពី​រូប​តំណាង ។\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ អ្នក​អាច​ធ្វើការ​ជ្រើស​ជា​រង្វង់ ឬ ត្រីកោណ)"

#: kiconedit.cpp:292
#, kde-format
msgid ""
"Paste\n"
"\n"
"Paste the contents of the clipboard into the current icon.\n"
"\n"
"If the contents are larger than the current icon you can paste them in a new "
"window.\n"
"\n"
"(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you "
"also want to paste transparency.)"
msgstr ""
"បិទភ្ជាប់\n"
"\n"
"បិទភ្ជាប់​មាតិកា​នៃ​ក្ដារ​តម្បៀត​ខ្ទាស់​ទៅ​ក្នុងរូប​តំណាង​បច្ចុប្បន្ន .\n"
"\n"
"ប្រសិន​បើ​មាតិកា​ធំ​ជាងរូប​តំណាង​បច្ចុប្បន្ន អ្នក​អាច​បិទ​ភ្ជាប់ពួក​វា​នៅ​ក្នុង​បង្អួច​ថ្មី​បាន ។\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ ជ្រើស \"បិទ​ភ្ជាប់ភីកសែល​ថ្លា\" នៅ​ក្នុង​ប្រអប់កំណត់រចនា​​សម្ព័ន្ធ ​ប្រសិនបើ​អ្នកចង់​បិទ​ភ្ជាប់​"
"ភាពថ្លា ។)"

#: kiconedit.cpp:300
#, kde-format
msgid "Paste as &New"
msgstr "បិទ​ភ្ជាប់​ជា​ថ្មី"

#: kiconedit.cpp:309
#, kde-format
msgid "Resi&ze..."
msgstr "ប្ដូរ​ទំហំ..."

#: kiconedit.cpp:312
#, kde-format
msgid ""
"Resize\n"
"\n"
"Smoothly resizes the icon while trying to preserve the contents"
msgstr ""
"ប្ដូរ​ទំហំ\n"
"\n"
"ប្ដូរ​ទំហំ​រូប​តំណាង​យ៉ាង​រលូន ខណៈ​ព្យាយាម​ការពារ​មាតិកា"

#: kiconedit.cpp:317
#, kde-format
msgid "&GrayScale"
msgstr "មាត្រដ្ឋាន​ប្រផេះ"

#: kiconedit.cpp:320
#, kde-format
msgid ""
"Gray scale\n"
"\n"
"Gray scale the current icon.\n"
"(Warning: The result is likely to contain colors not in the icon palette"
msgstr ""
"មាត្រដ្ឋាន​ប្រផេះ\n"
"\n"
"ធ្វើ​​រូប​តំណាង​បច្ចុប្បន្ន​ជា​មាត្រដ្ឋាន​ប្រផេះ ។\n"
"(ការ​ព្រមាន ៖ លទ្ធផល​ហាក់​ដូច​ជា​មាន​ពណ៌​ដែល​មិន​នៅ​ក្នុង​ក្ដារ​លាយ​រូប​តំណាង"

#: kiconedit.cpp:327
#, kde-format
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one."
msgstr ""
"ពង្រីក\n"
"\n"
"ពង្រីក​ម្តង​មួយ ។"

#: kiconedit.cpp:331
#, kde-format
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one."
msgstr ""
"បង្រួម\n"
"\n"
"បង្រួម​ម្ដង​មួយ ។"

#: kiconedit.cpp:335
#, kde-format
msgid "&Zoom"
msgstr "ពង្រីក​"

#: kiconedit.cpp:339
#, kde-format
msgid "100%"
msgstr "១០០%"

#: kiconedit.cpp:345
#, kde-format
msgid "200%"
msgstr "២០០%"

#: kiconedit.cpp:351
#, kde-format
msgid "500%"
msgstr "៥០០%"

#: kiconedit.cpp:357
