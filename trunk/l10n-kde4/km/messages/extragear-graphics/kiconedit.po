#: kiconedit.cpp:377
#, kde-format
msgid "Show &Grid"
msgstr "បង្ហាញ​ក្រឡា​ចត្រង្គ"

#: kiconedit.cpp:380
#, kde-format
msgid "Hide &Grid"
msgstr "លាក់​ក្រឡា​ចត្រង្គ"

#: kiconedit.cpp:381
#, kde-format
msgid ""
"Show grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"បង្ហាញ​ក្រឡា​ចត្រង្គ\n"
"\n"
"បិទ/បើក​ក្រឡា​ចត្រង្គ​ក្នុង​រូប​តំណាង​កែ​សម្រួល​ក្រឡា​ចត្រង្គ"

#: kiconedit.cpp:388
#, kde-format
msgid "Color Picker"
msgstr "ឧបករណ៍​រើស​ពណ៌"

#: kiconedit.cpp:392
#, kde-format
msgid ""
"Color Picker\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"ឧបករណ៍​រើស​​ពណ៌\n"
"\n"
"ពណ៌​នៃ​ភីក​សែល​ដែល​បាន​ចុចលើ​នឹង​ជា​ពណ៌​គូរ​បច្ចុប្បន្ន"

#: kiconedit.cpp:397
#, kde-format
msgid "Freehand"
msgstr "ធ្វើ​តាម​ចិត្ត"

#: kiconedit.cpp:401
#, kde-format
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"ធ្វើ​តាម​ចិត្ត\n"
"\n"
"គូរ​បន្ទាត់​ដែល​មិន​មែន​ជា​លីនេអ៊ែរ"

#: kiconedit.cpp:408
#, kde-format
msgid "Rectangle"
msgstr "ចតុកោណ​កែង"

#: kiconedit.cpp:412
#, kde-format
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"ចតុកោណ\n"
"\n"
"គូរ​ចតុកោណ"

#: kiconedit.cpp:416
#, kde-format
msgid "Filled Rectangle"
msgstr "ចតុកោណ​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:420
#, kde-format
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"ចតុកោណ​ដែល​បាន​បំពេញ\n"
"\n"
"គូរ​ចតុកោណ​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:424
#, kde-format
msgid "Circle"
msgstr "រង្វង់"

#: kiconedit.cpp:428
#, kde-format
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"រង្វង់\n"
"\n"
"គូរ​រង្វង់"

#: kiconedit.cpp:432
#, kde-format
msgid "Filled Circle"
msgstr "រង្វល់​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:436
#, kde-format
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"រង្វង់​មូល​ដែល​បាន​បំពេញ\n"
"\n"
"គូរ​រង្វង់​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:440
#, kde-format
msgid "Ellipse"
msgstr "រាង​ពង​ក្រពើ"

#: kiconedit.cpp:444
#, kde-format
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"ពង​ក្រពើ\n"
"\n"
"គូរ​រាង​ពង​ក្រពើ"

#: kiconedit.cpp:448
#, kde-format
msgid "Filled Ellipse"
msgstr "រាង​ពង​ក្រពដែល​បាន​បំពេញ"

#: kiconedit.cpp:452
#, kde-format
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"​រាង​ពង​ក្រពដែល​បាន​បំពេញ\n"
"\n"
"គូរ​រាង​ពង​ក្រពើ​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:456
#, kde-format
msgid "Spray"
msgstr "ការ​បាញ់ថ្នាំ"

#: kiconedit.cpp:460
#, kde-format
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"ការបាញ់​ថ្នាំ\n"
"\n"
"គូរ​ភីកសែល​ពង្រាយក្នុង​​ពណ៌​បច្ចុប្បន្ន"

#: kiconedit.cpp:465
#, kde-format
msgid "Flood Fill"
msgstr "បំពេញ​ទាំងមូល"

#: kiconedit.cpp:469
#, kde-format
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"បង្ហូរ​បំពេញ\n"
"\n"
"បំពេញ​ភីកសែល​ដែល​នៅ​ជិត​គ្នា​ជា​មួយ​ពណ៌​បច្ចុប្បន្ន"

#: kiconedit.cpp:474
#, kde-format
msgid "Line"
msgstr "បន្ទាត់"

#: kiconedit.cpp:478
#, kde-format
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"បន្ទាត់\n"
"\n"
"គូរ​បន្ទាត់​ត្រង់​ដោយ​បញ្ឈរ ដោយ​ផ្ដេក ឬ​មុំ ៤៥ ដឺក្រេ ។"

#: kiconedit.cpp:483
#, kde-format
msgid "Eraser (Transparent)"
