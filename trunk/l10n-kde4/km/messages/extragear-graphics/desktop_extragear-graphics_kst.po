msgctxt "Comment"
msgid "Phases a given data set to the specified period and zero phase."
msgstr "ដាក់​ដំណាក់​កាល​សំណុំ​ទិន្នន័យ​ដែល​ផ្ដល់​ទៅ​កំឡុង​ពេល​ជាក់លាក់ និង​ដំណាក់​កាល​សូន្យ ។"

#: src/plugins/shift/kstobject_shift.desktop:8
msgctxt "Name"
msgid "Shift"
msgstr "អង្កិល"

#: src/plugins/shift/kstobject_shift.desktop:23
msgctxt "Comment"
msgid "Shifts (and truncates) a vector."
msgstr "អង្កិល (និង​កាត់​ឲ្យ​ខ្លី) វ៉ិចទ័រ ។"

#: src/plugins/statistics/kstobject_statistics.desktop:8
msgctxt "Name"
msgid "Statistics"
msgstr "ស្ថិតិ"

#: src/plugins/statistics/kstobject_statistics.desktop:26
msgctxt "Comment"
msgid "Determines statistics for a given data set."
msgstr "កំណត់​ស្ថិតិ​សម្រាប់​សំណុំ​ទិន្នន័យ​ដែល​ផ្ដល់​ឲ្យ ។"

#: src/plugins/syncbin/kstobject_syncbin.desktop:8
msgctxt "Name"
msgid "Syncbin"
msgstr "Syncbin"

#: src/plugins/syncbin/kstobject_syncbin.desktop:19
msgctxt "Comment"
msgid ""
"Synchronously coadd vector Y into bins defined by vector X.  Like a 1D map."
msgstr ""
"បន្ថែម​វ៉ិចទ័រ Y រួមគ្នា​អសមកាល​ទៅ​ក្នុង bins បាន​កំណត់​ដោយ​វ៉ិចទ័រ X ។  ដូច​ជា​ផែនទី​ ១ ត្រីមាត្រ ។"

#: src/plugins/testplugin/kstobject_testplugin.desktop:8
msgctxt "Name"
msgid "Test Plugin"
msgstr "កម្មវិធី​ជំនួយ​សាកល្បង"

#: src/plugins/testplugin/kstobject_testplugin.desktop:25
msgctxt "Comment"
msgid "A test of new data object plugin system."
msgstr "ការ​សាកល្បង​នៃ​ប្រព័ន្ធ​កម្មវិធី​ជំនួយ​វត្ថុ​ទិន្នន័យ​ថ្មី ។"
