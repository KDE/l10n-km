msgstr "បង្វិល​រូបភាព %1"

#: plugin_jpeglossless.cpp:283
msgid ""
"<p>Are you sure you wish to convert the selected image(s) to black and "
"white? This operation <b>cannot</b> be undone.</p>"
msgstr ""
"<p>តើ​អ្នក​ប្រាកដ​ជា​ចង់​បម្លែង​រូបភាព​ដែល​បាន​ជ្រើស​ទៅ​ពណ៌​ស និង​ខ្មៅ​ឬ ? ប្រតិបត្តិការ​នេះ​ <b>មិន​អាច</"
"b> ត្រូវ​បាន​ធ្វើ​វិញ​ទេ ។</p>"

#: plugin_jpeglossless.cpp:300
msgid "Convert images to black & white"
