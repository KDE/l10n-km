"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"
msgstr ""
"<p>\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"10\" align=\"center\">\n"
"<tr>\n"
"<td>\n"
"<img src=\"hicolor/32x32/apps/kipi.png\">\n"
"</td>\n"
"<td>\n"
"តើ​អ្នក​ដឹង​ទេ​ថា​ប្រតិបត្តិការ​រូបភាព​ទាំងអស់​នៅ​ក្នុង​កម្មវិធីជំនួយ​​ដំណើរការ​រូបភាព​រត់​ដោយ​គ្មាន​បាត់បង់​ព័ត៌មាន "
"<b>Exif</b> នៅ​ក្នុង​ឯកសារ <b>JPEG</b>?\n"
"</td>\n"
"</tr>\n"
"</table>\n"
"</p>\n"

#: tips.cpp:99
