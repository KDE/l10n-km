#: timeadjustdialog.cpp:189
#| msgid "Plugin Handbook"
msgid "Handbook"
msgstr "សៀវភៅ​ដៃ"

#: timeadjustdialog.cpp:197
msgid "Adjustment Type"
msgstr "ប្រភេទ​លៃតម្រូវ"

#: timeadjustdialog.cpp:202
msgid "Add"
msgstr "បន្ថែម"

#: timeadjustdialog.cpp:203
msgid "Subtract"
msgstr "ដក"

#: timeadjustdialog.cpp:204
msgid "Set file date to EXIF/IPTC/XMP creation date"
msgstr "កំណត់​កាលបរិច្ឆេទ​ឯកសារ​ទៅ​កាលបរិច្ឆេទ​បង្កើត EXIF/IPTC/XMP"

#: timeadjustdialog.cpp:205
msgid "Custom date"
msgstr "កាលបរិច្ឆេទ​ផ្ទាល់ខ្លួន"

#: timeadjustdialog.cpp:220
msgid "Reset to current date"
msgstr "កំណត់​​ទៅ​កាលបរិច្ឆេទ​បច្ចុប្បន្ន​ឡើង​វិញ"

#: timeadjustdialog.cpp:223
msgid "Update EXIF creation date"
msgstr "ធ្វើ​ឲ្យ​កាលបរិច្ឆេទ​បង្កើត EXIF ទាន់សម័យ"

#: timeadjustdialog.cpp:224
msgid "Update IPTC creation date"
msgstr "ធ្វើ​ឲ្យ​កាលបរិច្ឆេទ​បង្កើត​ IPTC ទាន់សម័យ"

#: timeadjustdialog.cpp:225
msgid "Update XMP creation date"
msgstr "ធ្វើ​កាលបរិច្ឆេទ​បង្កើត​ XMP ទាន់​សម័យ"

#: timeadjustdialog.cpp:243
msgid "Adjustments"
msgstr "ការ​លៃតម្រូវ"

#: timeadjustdialog.cpp:246
msgid "Hours:"
msgstr "ម៉ោង ៖"

#: timeadjustdialog.cpp:251
msgid "Minutes:"
msgstr "នាទី ៖"

#: timeadjustdialog.cpp:256
msgid "Seconds:"
msgstr "វិនាទី ៖"

#: timeadjustdialog.cpp:261
msgid "Days:"
msgstr "ថ្ងៃ ៖"

#: timeadjustdialog.cpp:266
msgid "Months:"
msgstr "ខែ ៖"

#: timeadjustdialog.cpp:271
msgid "Years:"
msgstr "ឆ្នាំ ៖"

#: timeadjustdialog.cpp:295
msgid "Example"
msgstr "ឧទាហរណ៍"

#: timeadjustdialog.cpp:447
#, kde-format
msgid "1 image will be changed; "
msgid_plural "%1 images will be changed; "
msgstr[0] "រូបភាព %1 នឹង​ត្រូ​វបាន​ផ្លាស់ប្ដូរ"

#: timeadjustdialog.cpp:450
#, kde-format
msgid "1 image will be skipped due to an inexact date."
msgid_plural "%1 images will be skipped due to inexact dates."
msgstr[0] "រូបភាព %1 នឹង​ត្រូវ​បាន​រំលង​ដោយ​សារ​តែ​កាលបរិច្ឆេទ​មិន​ច្បាស់លាស់ ។"

#: timeadjustdialog.cpp:458
#, kde-format
msgid "1 image will be changed"
msgid_plural "%1 images will be changed"
msgstr[0] "រូបភាព %1 នឹង​ត្រូវ​បាន​ផ្លាស់ប្ដូរ"

#: timeadjustdialog.cpp:472
#, kde-format
msgid "<b>%1</b><br/>would, for example, change into<br/><b>%2</b>"
msgstr "<b>%1</b><br/>ឧទាហរណ៍ នឹង​​ផ្លាស់ប្ដូរ​ទៅ​ជា<br/><b>%2</b>"

#: timeadjustdialog.cpp:593
msgid "Unable to set date and time like picture metadata from:"
msgstr "មិនអាច​កំណត់​កាលបរិច្ឆេទ និង​ពេលវេលា​ដូច​ជា​ទិន្នន័យ​មេតា​រូបភាព ៖"

