#: models/kptcommonstrings.cpp:131
#, fuzzy
msgctxt "@info:whatsthis"
msgid ""
"<para>Controls resource overbooking when scheduling.</para><para>If "
"overbooking is allowed, a resource may be booked (on working days) to work "
"more than it is available. This can happen if the resource is allocated to "
"multiple tasks or are booked on other projects.</para><para>If overbooking "
"is to be avoided, resources will not be booked more than they are available. "
"On resource conflict, tasks will be delayed until the resource is available."
"</para>"
msgstr ""
"<para>ត្រួត​ពិនិត្យ​ធន​ធាន​ដែល​បាន​ប្រើ​លើស​ នៅ​ពេល​កំណត់​ពេល​ ។</para><para>​បើ​សិន​ការប្រើ​​លើស​ត្រូវ​បាន​"
"អនុញ្ញាត ​ធន​ធាន​អាច​ត្រូវ​បាន​ប្រើ​ (នៅ​ថ្ងៃ​ធ្វើ​ការ​) ដើម្បី​ដំណើរ​ការ​ឲ្យ​បាន​ច្រើន​ជាង​ធម្មតា ។ រឿង​នេះ​"
"អាចកើត​ឡើង​បាន បើ​សិន​ធន​ធាន​ត្រូវ​បាន​បម្រុង​ទុក​សម្រាប់​ភារកិច្ច​ជា​ច្រើន ឬ​ត្រូវ​បាន​ប្រើ​នៅ​លើ​គម្រោង​ផ្សេង​"
"ទៀត ។</para><para>បើ​សិន​ការប្រើ​ត្រូវ​បាន​ជៀស​វាង ធន​ធាន​នឹង​មិន​ត្រូវ​បាន​ប្រើ​ច្រើន​ជាង​តាម​ដែល​អាច​"
"ប្រើ​បាន​ទេ ។ នៅ​លើ​ធន​ធាន​ដែល​មាន​ភាព​ប៉ះ​ទង្គិច​ ភារកិច្ច​នឹង​ត្រូវ​ពន្យា​ពេល​ រហូត​ដល់​ធន​ធាន​អាច​ប្រើ​បាន ។"
"</para>"

#: models/kptcommonstrings.cpp:137
#, fuzzy
msgctxt "@info:tooltip"
msgid "The distribution to be used during scheduling"
msgstr "ការ​ចែក​ចាយ​ត្រូវ​បាន​ប្រើ​​អំឡុង​ពេល​​កំណត់ពេល​"

#: models/kptcommonstrings.cpp:139
#, fuzzy
msgctxt "@info:whatsthis"
msgid ""
"<para>The distribution to be used during scheduling</para><para>If "
"distribution is 'None', the tasks estimate is used as is during scheduling.</"
"para><para>If distribution is 'PERT', the estimate used is calculated based "
"on the entered optimistic- (O), pessimistic-(P) and most likely (M) "
"estimate. The formula used for this is (O + 4 * M + P) / 6.<para>"
msgstr ""
"<para>ការ​ចែក​ចាយ​នឹង​ត្រូវ​ប្រើ​ក្នុង​អំឡុង​កំណត់​ពេល​</para><para>​បើ​សិន​ការ​ចែក​ចាយ​ជា​ 'គ្មាន​'  ការ​"
"ប៉ាន់​ស្មាន​ភារកិច្ចនឹង​ត្រូវ​ប្រើ​ក្នុង​អំឡុង​កំណត់​ពេល​ ។</para><para>បើ​សិន​ការចែក​ចាយ​ជា​ 'PERT' ការ​ប៉ាន់​"
"ស្មាន​នឹង​ត្រូវ​ប្រើ​នៅ​ពេល​ធ្វើ​ការ​គណនា​ ដោយ​ផ្អែក​លើ​សុទិដ្ឋិនិយម​ (O) ទុទិដ្ឋិនិយម​ (P) និង​ការ​ប៉ាន់​ស្មាន​ "
"(M) ​ដែល​ទំនង​បំផុត​ដែល​ត្រូវ​បាន​បញ្ចូល ។ រូបមន្ត​ដែល​ត្រូវ​​ប្រើ​សម្រាប់​ការចែក​ចាយ​នេះ​គឺ (O + 4 * M + "
"P) / 6 ។<para>"

