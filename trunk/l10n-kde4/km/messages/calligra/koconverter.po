#: koconverter.cpp:50
msgid "KOConverter"
msgstr "KOConverter"

#: koconverter.cpp:51
msgid "Calligra Document Converter"
msgstr "កម្មវិធី​បម្លែង​ឯកសារ​របស់​ Calligra "

#: koconverter.cpp:53
msgid "(c) 2001-2011 Calligra developers"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០១-២០11 អ្នក​អភិវឌ្ឍន៍ Calligra"

#: koconverter.cpp:54
msgid "David Faure"
msgstr "David Faure"

#: koconverter.cpp:55
msgid "Nicolas Goutte"
msgstr "Nicolas Goutte"

#: koconverter.cpp:59
msgid "Input file"
msgstr "ឯកសារ​បញ្ចូល"

#: koconverter.cpp:60
msgid "Output file"
msgstr "ឯកសារ​លទ្ធផល"

#: koconverter.cpp:61
msgid "Make a backup of the destination file"
msgstr "ធ្វើ​ការ​បម្រុង​ទុកឯកសារ​ទិសដៅ"

#: koconverter.cpp:62
msgid "Batch mode: do not show dialogs"
msgstr "របៀបបាច់ ៖ កុំបង្ហាញ​ប្រអប់​"

#: koconverter.cpp:63
msgid "Interactive mode: show dialogs (default)"
msgstr "របៀប​អន្តរកម្ម ៖ បង្ហាញ​ប្រអប់​ (លំនាំដើម)"

#: koconverter.cpp:64
msgid "Mimetype of the output file"
msgstr "ប្រភេទ Mime របស់ឯកសារ​លទ្ធផល"

#: koconverter.cpp:102
#, kde-format
msgid "Mimetype for input file %1 not found!"
msgstr "រក​មិន​ឃើញ​ប្រភេទ Mime សម្រាប់​ឯកសារ %1 !"

#: koconverter.cpp:112
#, kde-format
msgid "Mimetype not found %1"
msgstr "រក​មិន​ឃើញ​ប្រភេទ Mime %1"

#: koconverter.cpp:121
msgid "Mimetype not found, try using the -mimetype option"
msgstr "រក​មិនឃើញ​ប្រភេទ Mime ព្យាយាម​ប្រើ -ជម្រើស​ប្រភេទ mime"

#: koconverter.cpp:135
msgid "*** The conversion failed! ***"
msgstr "*** ការ​បម្លែង​បាន​បរាជ័យ ! ***"

#: koconverter.cpp:140
msgid "Two arguments required"
msgstr "ត្រូវ​ការ​អាគុយម៉ង់ពីរ"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ម៉ន ម៉េត, សេង សុត្ថា, អេង វណ្ណៈ, អោក ពិសិដ្ឋ"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ""
