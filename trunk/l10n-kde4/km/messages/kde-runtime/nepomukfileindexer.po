#: indexer/main.cpp:44
msgid "NepomukIndexer"
msgstr "NepomukIndexer"

#: indexer/main.cpp:46
msgid ""
"NepomukIndexer indexes the contents of a file and saves the results in "
"Nepomuk"
msgstr "NepomukIndexer ដាក់​លិបិក្រម​មាតិកា​ឯកសារ និង​រក្សាទុក​លទ្ធផល​នៅ​ក្នុង Nepomuk"

#: indexer/main.cpp:48
msgid "(C) 2011, Vishesh Handa"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០១១ ដោយ Vishesh Handa"

#: indexer/main.cpp:49
msgid "Vishesh Handa"
msgstr "Vishesh Handa"

#: indexer/main.cpp:49
msgid "Current maintainer"
msgstr "អ្នក​ថែទាំ​បច្ចុប្បន្ន"

#: indexer/main.cpp:50
msgid "Sebastian Trüg"
msgstr ""

#: indexer/main.cpp:50
