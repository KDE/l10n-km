msgstr ""

#: indexer/main.cpp:55
msgid "The URI provided will be forced on the resource"
msgstr "URI ដែល​បាន​ផ្ដល់​នឹង​ត្រូវ​បាន​បង្ខំ​នៅ​លើ​ធនធាន"

#: indexer/main.cpp:56
msgid "The modification time of the resource in time_t format"
msgstr "ពេលវេលា​កែប្រែ​ធនធានស្ថិត​ក្នុងទ្រង់ទ្រាយ time_t"

#: indexer/main.cpp:57
msgid "The URL of the file to be indexed"
msgstr "URL របស់​ឯកសារ​ត្រូវ​បា​ន​ដាក់​លិបិក្រម"

#: indexer/main.cpp:58
msgid "Remove all indexed data of the URL provided"
msgstr "យក​ទិន្នន័យ​ដែល​បាន​ដាក់​លិបិក្រម​ទាំងអស់​របស់ URL ដែល​បាន​ផ្ដល់​ចេញ"

