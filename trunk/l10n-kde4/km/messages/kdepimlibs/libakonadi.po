#: selftestdialog.cpp:385
#, kde-format
msgid ""
"The program '%1' to control the Akonadi server was found but could not be "
"executed successfully.\n"
"Result:\n"
"%2\n"
"Make sure the Akonadi server is installed correctly."
msgstr ""
"កម្មវិធី '%1' ត្រូវ​ត្រួតពិនិត្យ​ម៉ាស៊ីនបម្រើ Akonadi ដែល​បានរក​ឃើញ ប៉ុន្តែ​មិនអាច​ត្រូវ​បាន​ប្រតិបត្តិ​ដោយ​"
"ជោគជ័យ​ទេ ។\n"
"លទ្ធផល ៖\n"
"%2\n"
"សូម​ប្រាកដ​ថា​ម៉ាស៊ីន Akonadi ត្រូវ​បាន​ដំឡើង​យ៉ាង​ត្រឹមត្រូវ ។"

