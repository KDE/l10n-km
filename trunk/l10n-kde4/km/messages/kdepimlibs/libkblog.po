#: blogger1.cpp:243
msgid ""
"Could not fetch user's info out of the result from the server, not a map."
msgstr "មិន​អាច​​ទៅ​យក​ព័ត៌មាន​របស់​​អ្នក​ប្រើ​នៃ​លទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ មិនមែន​ជា​ផែនទី ។"

#: blogger1.cpp:270
msgid "Could not fetch blogs out of the result from the server, not a list."
msgstr "មិន​អាច​ទៅ​យក​ប្លុក​​របស់​លទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ មិនមែន​ជា​បញ្ជី ។"

#: blogger1.cpp:305
msgid ""
"Could not fetch list of posts out of the result from the server, not a list."
msgstr "មិន​អាច​ទៅ​យក​បញ្ជី​ប្រកាស​របស់​លទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ​ មិន​មែនជា​បញ្ជី ។"

#: blogger1.cpp:324
msgid "Could not read post."
msgstr "មិន​អាច​អាន​ប្រកាស ។"

#: blogger1.cpp:351 blogger1.cpp:354
msgid "Could not fetch post out of the result from the server."
msgstr "មិន​អាច​ទៅ​យក​ប្រកាស​របស់លទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ ។"

#: blogger1.cpp:372
msgid "Could not read the postId, not a string or an integer."
msgstr "មិន​អាច​អាន​ postId មិន​មែន​ជា​​ខ្សែអក្សរ ឬ​ចំនួន​គត់ ។"

#: blogger1.cpp:405 blogger1.cpp:429
msgid "Could not read the result, not a boolean."
msgstr "មិន​អាច​អាន​លទ្ធផល មិន​មែន​ជា​ប៊ូលីន ។"

#: gdata.cpp:216 gdata.cpp:278 gdata.cpp:340 gdata.cpp:386 gdata.cpp:443
msgid "Authentication failed."
msgstr "បាន​បរាជ័យ​ក្នុង​កា​រផ្ទៀងផ្ទាត់ ។"

#: gdata.cpp:543
msgid "Could not regexp the Profile ID."
msgstr "មិន​អាច​ regexp លេខ​សម្គាល់​ទម្រង់ ។"

#: gdata.cpp:548
msgid "Could not fetch the homepage data."
msgstr "មិន​អាច​ទៅ​យក​ទិន្នន័យ​គេហទំព័រ ។"

#: gdata.cpp:565
msgid "Could not get blogs."
msgstr "មិន​អាច​ទទួល​ប្លុក ។"

#: gdata.cpp:586 gdata.cpp:802
msgid "Could not regexp the blog id path."
msgstr "មិនអាច​ regexp ប្លុក​ផ្លូខ​លេខ​សម្គាល់ ។"

#: gdata.cpp:607 gdata.cpp:653
msgid "Could not get comments."
msgstr "មិន​អាច​ទទួល​សេចក្ដី​អធិប្បាយ ។"

#: gdata.cpp:621 gdata.cpp:667
msgid "Could not regexp the comment id path."
msgstr "មិន​អាច regexp ផ្លូវ​លេខ​សម្គាល់​របស់​សេច​ក្ដីអធិប្បាយ ។"

#: gdata.cpp:699 gdata.cpp:772
msgid "Could not get posts."
msgstr "មិនអាច​ទទួល​ប្រកាស ។"

#: gdata.cpp:719
msgid "Could not regexp the post id path."
msgstr "មិន​អាច regexp ផ្លូវ​​​លេខសម្គាល់​របស់​ប្រកាស ។"

#: gdata.cpp:845 gdata.cpp:912 gdata.cpp:1019 wordpressbuggy.cpp:309
#: wordpressbuggy.cpp:359
msgid "Could not regexp the id out of the result."
msgstr "មិន​អាច​ regexp លេខ​សម្គាល់​របស់​លទ្ធផល ។"

#: gdata.cpp:854 gdata.cpp:921 gdata.cpp:1028
msgid "Could not regexp the published time out of the result."
msgstr "មិន​អាច regexp ពេលវេលា​ដែល​បាន​បោះពុម្ព​របស់​លទ្ធផល ។"

#: gdata.cpp:863 gdata.cpp:930 gdata.cpp:1037
msgid "Could not regexp the update time out of the result."
msgstr "មិន​អាច​ regexp ពេលវេលា​ទាន់សម័យ​របស់​លទ្ធផល ។"

#: livejournal.cpp:344 livejournal.cpp:453 livejournal.cpp:478
msgid "Could not read the post ID, result not a map."
msgstr "មិន​អាច​អាច​លេខសម្គាល់​ប្រកាស លទ្ធផល​មិន​មែន​ជា​ផែនទី ។"

#: livejournal.cpp:491
msgid "The returned post ID did not match the sent one: "
msgstr "លេខ​សម្គាល់​កា​រប្រកាស​ដែល​បាន​ត្រឡប់​មិន​ផ្គូផ្គង​​ការ​ប្រកាស​ដែល​បាន​ផ្ញើ​ចេញ ៖"

#: metaweblog.cpp:74
msgid "Media is a null pointer."
msgstr "មេឌៀ​គឺ​ជា​ចំណុច​​ទទេ"

#: metaweblog.cpp:133
msgid "Could not list categories out of the result from the server."
msgstr "មិន​អាច​រាយ​ប្រភេទ​របស់​លទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ ។"

#: metaweblog.cpp:194
msgid "Could not read the result, not a map."
msgstr "មិនអាច​អាន​លទ្ធផល មិនមែន​ជា​ផែនទី ។"

#: movabletype.cpp:170
msgid ""
"Could not fetch list of trackback pings out of the result from the server."
msgstr "មិន​អាច​ទៅ​យក​បញ្ជី​ដាន​របស់លទ្ធផល​ពី​ម៉ាស៊ីន​បម្រើ ។"

#: wordpressbuggy.cpp:62 wordpressbuggy.cpp:152
msgid "Post is a null pointer."
msgstr "ប្រកាស​គឺ​ជា​ចំណុច​ទទេ ។"
