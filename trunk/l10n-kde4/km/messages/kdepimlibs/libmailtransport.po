#. i18n: file: mailtransport.kcfg:54
#. i18n: ectx: whatsthis, entry (precommand), group (Transport $(transportId))
#: rc.cpp:63
#, fuzzy
msgid ""
"\n"
"        A command to run locally, prior to sending email.\n"
"        This can be used to set up SSH tunnels, for example.\n"
"        Leave it empty if no command should be run.\n"
"      "
msgstr ""
"\n"
"        ពាក្យ​បញ្ជា​ត្រូវ​រត់​មូលដ្ឋាន មុន​នឹង​ផ្ញើ​អ៊ីមែល ។\n"
"        ឧទាហរណ៍ នេះ​អាច​ត្រូវ​បាន​​ប្រើ​ដើម្បី​រៀបចំធ្យូនែល SSH ។\n"
"        ទុក​ឲ្យ​វា​ទទេ ប្រសិន​បើ​គ្មាន​ពាក្យ​បញ្ជា​គួរ​រត់ ។\n"
"      "

#. i18n: file: mailtransport.kcfg:57
#. i18n: ectx: label, entry (requiresAuthentication), group (Transport $(transportId))
#: rc.cpp:70
msgid "Server requires authentication"
msgstr "ម៉ាស៊ីន​បម្រើ​ទាមទារ​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#. i18n: file: mailtransport.kcfg:61
#. i18n: ectx: whatsthis, entry (requiresAuthentication), group (Transport $(transportId))
#: rc.cpp:73
msgid ""
"\n"
"        Check this option if your SMTP server requires authentication before "
"accepting mail.\n"
"        This is known as 'Authenticated SMTP' or simply ASMTP.\n"
"      "
msgstr ""
"\n"
"        គូស​ធីក​ជម្រើស​នេះ ប្រសិន​បើ​ម៉ាស៊ីន​ SMTP រប​ស់​អ្នក​ទាមទារ​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​មុន​នឹង​ទទួល​"
"សំបុត្រ ។\n"
"        វា​ត្រូវ​បាន​ស្គាល់​ជា 'SMTP ដែល​បាន​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ' ឬ​តាមធម្មតាជា ASMTP ។\n"
"      "

#. i18n: file: mailtransport.kcfg:65
#. i18n: ectx: label, entry (storePassword), group (Transport $(transportId))
#: rc.cpp:79
msgid "Store password"
msgstr "ទុក​ពាក្យ​សម្ងាត់"

#. i18n: file: mailtransport.kcfg:71
#. i18n: ectx: whatsthis, entry (storePassword), group (Transport $(transportId))
#: rc.cpp:82
#, fuzzy
msgid ""
"\n"
"        Check this option to have your password stored.\n"
"        If KWallet is available the password will be stored there which is "
"considered safe.\n"
"        However, if KWallet is not available, the password will be stored in "
"the configuration file.\n"
"        The password is stored in an obfuscated format, but should not be "
"considered secure from decryption efforts if access to the configuration "
"file is obtained.\n"
"      "
msgstr ""
" គូស​ធីក​ជម្រើស​នេះ​ដើម្បី​ទុក​ពាក្យ​សម្ងាត់​របស់​អ្នក​ ។\n"
"       បើ​មាន​ KWallet  ពាក្យ​សម្ងាត់​នឹង​ត្រូវ​បាន​ទុក​នៅ​ទីនោះ​ដែល​ត្រូវ​បាន​ចាត់​ទុក​ថា​មាន​សុវត្ថិភាព​ ។\n"
"       ទោះ​បី​យ៉ាងណា​ បើ​មិន​មាន​ KWallet  ទេ ពាក្យ​សម្ងាត់​នឹង​ត្រូវ​ទុក​នៅ​ក្នុង​ឯកសារ​កំណត់​រចនាសម្ព័ន្ធ "
"។\n"
"        ពាក្យសម្ងាត់​ត្រូវ​បាន​ទុក​នៅ​ក្នុងទ្រង់​ទ្រាយ obfuscated  ប៉ុន្តែ​មិន​គួរ​ត្រូវ​បាន​ចាត់​ទុក​ថា​មាន​"
"សុវត្ថិភាព​ពីកិច្ចប្រឹង​ប្រែង​អ៊ិនគ្រីបទេ បើសិន​ការចូល​ដំណើរការ​ទៅឯកសារ​កំណត់​រចនាសម្ព័ន្ធត្រូវ​បាន​ទទួល​យក ។\n"
"     "

