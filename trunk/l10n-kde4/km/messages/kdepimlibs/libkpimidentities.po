#: identitymanager.cpp:108
#, kde-format
msgctxt ""
"%1: name; %2: number appended to it to make it unique among a list of names"
msgid "%1 #%2"
msgstr "%1 #%2"

#: identitymanager.cpp:362
msgid "Unnamed"
msgstr "គ្មាន​ឈ្មោះ"

#: identitymanager.cpp:470
msgctxt "use default address from control center"
msgid "Default"
msgstr "លំនាំដើម"

#: identitymanager.cpp:495
msgctxt "Default name for new email accounts/identities."
msgid "Unnamed"
msgstr "គ្មាន​ឈ្មោះ"

#: signatureconfigurator.cpp:83
msgid "&Enable signature"
msgstr "អនុញ្ញាត​ហត្ថលេខា"

#: signatureconfigurator.cpp:85
msgid ""
"Check this box if you want KMail to append a signature to mails written with "
"this identity."
msgstr ""
"ធីក​ប្រអប់​នេះ នៅពេល​ដែល​អ្នក​ចង់​ឲ្យ KMail បន្ថែម​ហត្ថលេខា​ទៅ​សំបុត្រ​ដែល​បាន​បង្កើត​ដោយ​អត្តសញ្ញាណ​នេះ ។"

#: signatureconfigurator.cpp:95
msgid "Click on the widgets below to obtain help on the input methods."
msgstr "ចុច​លើ​ធាតុក្រាហ្វិក​ខាងក្រោម ដើម្បី​បង្ហាញ​ជំនួយ​នៅលើ​វិធីសាស្ដ្រ​បញ្ចូល ។"

#: signatureconfigurator.cpp:99
msgctxt "continuation of \"obtain signature text from\""
msgid "Input Field Below"
msgstr "វាល​បញ្ចូល​ខាងក្រោម"

#: signatureconfigurator.cpp:101
msgctxt "continuation of \"obtain signature text from\""
msgid "File"
msgstr "ឯកសារ"

#: signatureconfigurator.cpp:103
msgctxt "continuation of \"obtain signature text from\""
msgid "Output of Command"
msgstr "លទ្ធផល​របស់​ពាក្យបញ្ជា"

#: signatureconfigurator.cpp:105
msgid "Obtain signature &text from:"
msgstr "បាន​អត្ថបទ​ហត្ថលេខា​ពី ៖"

#: signatureconfigurator.cpp:147
msgid "Use this field to enter an arbitrary static signature."
msgstr "ប្រើ​វាលនេះ​ដើម្បី​បញ្ចូល​ហត្ថលេខា​ស្ថិតិ"

#: signatureconfigurator.cpp:186 signatureconfigurator.cpp:400
msgid "&Use HTML"
msgstr "ប្រើ HTML"

#: signatureconfigurator.cpp:205
msgid ""
"Use this requester to specify a text file that contains your signature. It "
"will be read every time you create a new mail or append a new signature."
msgstr ""
"ប្រើ​អ្នក​ស្នើ​នេះ ដើម្បី​បញ្ជាក់​ឯកសារ​អត្ថបទ​ដែល​មាន​ហត្ថលេខា​របស់​អ្នក ។ វា​នឹង​ត្រូវបាន​អាន​នៅ​រាល់ពេល​"
"ដែល​អ្នក​បង្កើត​សំបុត្រ​ថ្មី ឬ​បន្ថែម​ហត្ថលេខា​ថ្មី ។"

#: signatureconfigurator.cpp:208
msgid "S&pecify file:"
msgstr "ឯកសារ​ជាក់លាក់ ៖"

#: signatureconfigurator.cpp:215
msgid "Edit &File"
msgstr "កែសម្រួល​ឯកសារ"

#: signatureconfigurator.cpp:216
msgid "Opens the specified file in a text editor."
msgstr "បើក​ឯកសារ​ដែលបាន​បញ្ជាក់​នៅ​ក្នុង​កម្មវិធីនិពន្ធ​អត្ថបទ ។"

#: signatureconfigurator.cpp:236
msgid ""
"You can add an arbitrary command here, either with or without path depending "
"on whether or not the command is in your Path. For every new mail, KMail "
"will execute the command and use what it outputs (to standard output) as a "
"signature. Usual commands for use with this mechanism are \"fortune\" or "
"\"ksig -random\"."
msgstr ""
"អ្នក​អាច​បន្ថែម​ពាក្យបញ្ជា arbitrary នៅទីនេះ ដោយ​មានផ្លូវ ឬ​គ្មាន​ក៏ដោយ ដោយ​សំខាន់​ត្រង់ថាតើ​"
"ពាក្យបញ្ជា​នៅ​ក្នុង​ផ្លូវ​របស់​អ្នក​ឬ​អត់ ។ ចំពោះ​សំបុត្រ​ថ្មី​ទាំងអស់ KMail នឹង​ប្រតិបត្តិ​ពាក្យបញ្ជា ហើយ​ប្រើ​នូវ​អ្វី​"
"ដែល​វា​បង្ហាញ (ជា​លទ្ធផល​ស្តង់ដារ) ជា​ហត្ថលេខា ។ ពាក្យបញ្ជា​ទូទៅ​សម្រាប់​ការ​ប្រើប្រាស់​ជាមួយ​យន្តការ​"
"នេះ​គឺ \"fortune\" ឬ \"ksig -random\" ។"

#: signatureconfigurator.cpp:241
msgid "S&pecify command:"
msgstr "ពាក្យបញ្ជា​ជាក់លាក់ ៖"

#: signatureconfigurator.cpp:409
msgid "&Use HTML (disabling removes formatting)"
msgstr "ប្រើ HTML (បិទ​ការ​យក​ទ្រង់ទ្រាយ​ចេញ)"

#: signature.cpp:99
#, kde-format
msgid "<qt>Failed to execute signature script<p><b>%1</b>:</p><p>%2</p></qt>"
msgstr "<qt>បាន​បរាជ័យ​ក្នុង​ការ​ប្រតិបត្តិ​ស្គ្រីប​ហត្ថលេខា<p><b>%1</b>៖</p><p>%2</p></qt>"

