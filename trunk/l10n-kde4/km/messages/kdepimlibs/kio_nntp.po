#: nntp.cpp:125 nntp.cpp:494
#, kde-format
msgid "Selecting group %1..."
msgstr "កំពុង​ជ្រើស​ក្រុម %1..."

#: nntp.cpp:140
msgid "Downloading article..."
msgstr "កំពុង​ទាញ​យក​អត្ថបទ..."

#: nntp.cpp:199
#, kde-format
msgid "Invalid special command %1"
msgstr "ពាក្យ​បញ្ជា​ពិសេស​មិន​ត្រឹម​ត្រូវ %1"

#: nntp.cpp:207
msgid "Sending article..."
msgstr "កំពុង​ផ្ញើ​អត្ថបទ..."

#: nntp.cpp:357
msgid "Downloading group list..."
msgstr "កំពុង​ទាញ​យក​បញ្ជី​ក្រុម​..."

#: nntp.cpp:362
msgid "Looking for new groups..."
msgstr "កំពុង​រក​មើល​ក្រុម​ថ្មី..."

#: nntp.cpp:429
msgid "Downloading group descriptions..."
msgstr "កំពុង​ទាញយក​សេចក្ដី​ពិពណ៌នា​ក្រុម..."

#: nntp.cpp:516
#, kde-format
msgid ""
"Could not extract message serial numbers from server response:\n"
"%1"
msgstr ""
"មិន​អាច​ស្រង់​លេខ​សៀរៀល​សារ​ចេញពី​ការ​ឆ្លើយ​តប​របស់​ម៉ាស៊ីន​បម្រើ​​ទេ ៖\n"
"%1"

#: nntp.cpp:531
msgid "Downloading new headers..."
msgstr "កំពុង​ទា​ញ​យក​បឋម​កថា​ថ្មី..."

#: nntp.cpp:562
#, kde-format
msgid ""
"Could not extract first message id from server response:\n"
"%1"
msgstr ""
"មិនអាចស្រង់​លេខ​សម្គាល់​សារ​ដំបូង​ចេញ​ពី​ការ​ឆ្លើយតប​របស់​ម៉ាស៊ីន​បម្រើ​ទេ ៖\n"
"%1"

#: nntp.cpp:588
#, kde-format
msgid ""
"Could not extract message id from server response:\n"
"%1"
msgstr ""
"មិនអាច​ស្រង់​លេខ​សម្គាល់​សារ​ចេញ​ពី​ការ​ឆ្លើយតប​របស់​ម៉ាស៊ីន​បម្រើ​ទេ ៖\n"
"%1"

#: nntp.cpp:739
msgid "Connecting to server..."
msgstr "កំពុង​តភ្ជាប់​ទៅ​ម៉ាស៊ីន​បម្រើ..."

#: nntp.cpp:773
msgid "This server does not support TLS"
msgstr "ម៉ាស៊ីន​បម្រើ​នេះ​មិន​គាំទ្រ TLS ទេ"

#: nntp.cpp:777
msgid "TLS negotiation failed"
msgstr "ការ​ចចារ TLS បាន​បរាជ័យ"

#: nntp.cpp:892
#, kde-format
msgid ""
"Unexpected server response to %1 command:\n"
"%2"
msgstr ""
"ការ​ឆ្លើយតប​របស់​ម៉ាស៊ីន​បម្រើ​ទៅ​ពាក្យ​បញ្ជា %1 មិនបាន​រំពឹងទុក ៖\n"
"%2"
