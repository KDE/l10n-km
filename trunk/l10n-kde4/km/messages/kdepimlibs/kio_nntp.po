#: nntp.cpp:126 nntp.cpp:492
#, qt-format
msgid "Selecting group %1..."
msgstr "កំពុង​ជ្រើស​ក្រុម %1..."

#: nntp.cpp:141
msgid "Downloading article..."
msgstr "កំពុង​ទាញ​យក​អត្ថបទ..."

#: nntp.cpp:199
#, qt-format
msgid "Invalid special command %1"
msgstr "ពាក្យ​បញ្ជា​ពិសេសមិន​ត្រឹម​ត្រូវ %1"

#: nntp.cpp:207
msgid "Sending article..."
msgstr "កំពុង​ផ្ញើ​អត្ថបទ..."

#: nntp.cpp:357
msgid "Downloading group list..."
msgstr "កំពុង​ទាញ​យក​បញ្ជី​ក្រុម​..."

#: nntp.cpp:362
msgid "Looking for new groups..."
msgstr "កំពុង​រក​មើល​ក្រុម​ថ្មី..."

#: nntp.cpp:428
msgid "Downloading group descriptions..."
msgstr "កំពុង​ទាញ​យកក្រុម​ការ​ពិពណ៌នា​..."

#: nntp.cpp:514
#, qt-format
msgid ""
"Could not extract message serial numbers from server response:\n"
"%1"
msgstr ""
"មិន​អាច​ស្រង់​ចេញ​លេខ​សារ​ដំបូង ពី​ការ​ឆ្លើយ​តប​របស់​ម៉ាស៊ីន​បម្រើ​ ៖\n"
"%1"

#: nntp.cpp:529
msgid "Downloading new headers..."
msgstr "កំពុង​ទា​ញ​យក​បឋម​កថា​ថ្មី..."

#: nntp.cpp:560
#, qt-format
msgid ""
"Could not extract first message id from server response:\n"
"%1"
msgstr ""
"មិន​អាច​ស្រង់​ចេញ​លេខ​សម្គាល់​សារ​ដំបូង ពី​ការ​ឆ្លើយ​តប​របស់​ម៉ាស៊ីន​បម្រើ ៖\n"
"%1"

#: nntp.cpp:586
#, qt-format
msgid ""
"Could not extract message id from server response:\n"
"%1"
msgstr ""
"មិន​អាច​ស្រង់​ចេញ​លេខ​សម្គាល់សារ ពី​ការ​ឆ្លើយ​តប​របស់​ម៉ាស៊ីន​បម្រើ ​៖\n"
"%1"

#: nntp.cpp:735
msgid "Connecting to server..."
msgstr "កំពុង​តភ្ជាប់​ទៅ​ម៉ាស៊ីន​បម្រើ..."

#: nntp.cpp:771
msgid "This server does not support TLS"
msgstr "ម៉ាស៊ីន​បម្រើ​នេះ​មិន​គាំទ្រ TLS បាន​ឡើយ​"

#: nntp.cpp:776
msgid "TLS negotiation failed"
msgstr "ការ​ចចារ​របស់ TLS បាន​បរាជ័យ"

#: nntp.cpp:863
#, qt-format
msgid ""
"Unexpected server response to %1 command:\n"
"%2"
msgstr ""
"ការ​ឆ្លើយ​តប​របស់​ម៉ាស៊ីន​បម្រើដែល​មិន​រំពឹង​ទៅ​ពាក្យ​បញ្ជា %1 ៖\n"
"%2"
