#: scheduler.cpp:394
#, kde-format
msgctxt "@info"
msgid "%1 wants to attend %2 but was not invited."
msgstr "%1 ចង់​ចូលរួម %2 ប៉ុន្តែ​គេ​មិនបាន​អញ្ជើញ ។"

