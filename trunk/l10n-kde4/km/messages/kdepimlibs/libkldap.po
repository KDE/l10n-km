#: ldapconnection.cpp:327
msgid "Cannot set time limit."
msgstr "មិន​អាច​កំណត់​​​ពេលវេលា ។"

#: ldapconnection.cpp:337
msgid "Cannot initialize the SASL client."
msgstr "មិន​អាច​ចាប់ផ្ដើម​​ម៉ាស៊ីន​ភ្ញៀវ SASL ។"

#: ldapconnection.cpp:416
msgid ""
"LDAP support not compiled in. Please recompile libkldap with the OpenLDAP "
"(or compatible) client libraries, or complain to your distribution packagers."
msgstr ""
"ការ​គាំទ្រ LDAP មិន​បាន​ចងក្រង​នៅ ។ សូម​ចងក្រង​ libkldap ដោយ​បណ្ណាល័យ​ម៉ាស៊ីន​ភ្ញៀវ OpenLDAP (ឬ​"
"ឆបគ្នា) ឬ​តវ៉ា​ទៅ​កម្មវិធី​គ្រប់គ្រង​កញ្ចប់​ចែកចាយ​របស់​អ្នក ។"

