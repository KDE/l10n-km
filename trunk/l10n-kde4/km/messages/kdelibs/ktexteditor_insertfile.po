#: insertfileplugin.cpp:87
msgid "Insert File..."
msgstr "បញ្ចូល​ឯកសារ..."

#: insertfileplugin.cpp:99
msgid "Choose File to Insert"
msgstr "ជ្រើស​ឯកសារ​ដែល​ត្រូវ​បញ្ចូល"

#: insertfileplugin.cpp:100
msgid "&Insert"
msgstr ""

#: insertfileplugin.cpp:129
msgid ""
"Failed to load file:\n"
"\n"
msgstr ""
"បរាជ័យ​ក្នុង​ការ​ផ្ទុក​ឯកសារ ៖\n"
"\n"

#: insertfileplugin.cpp:129 insertfileplugin.cpp:150 insertfileplugin.cpp:172
msgid "Insert File Error"
msgstr "កំហុស​ក្នុង​ការ​បញ្ចូល​ឯកសារ"

#: insertfileplugin.cpp:143
#, qt-format
msgid ""
"<p>The file <strong>%1</strong> does not exist or is not readable, aborting."
msgstr "<p>ឯកសារ <strong>%1</strong> មិន​មាន ឬ មិន​អាច​អាន - កំពុង​បោះបង់ ។"

#: insertfileplugin.cpp:147
#, qt-format
msgid "<p>Unable to open file <strong>%1</strong>, aborting."
msgstr "<p>មិន​អាច​បើក​ឯកសារ <strong>%1</strong> - កំពុង​បោះបង់ ។"

#: insertfileplugin.cpp:170
#, qt-format
msgid "<p>File <strong>%1</strong> had no contents."
msgstr "<p>ឯកសារ <strong>%1</strong> មិន​មាន​មាតិកា​ឡើយ ។"

