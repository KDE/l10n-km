#: server/nepomukserver.desktop:8
msgctxt "Name"
msgid "Nepomuk Server"
msgstr "ម៉ាស៊ីន​បម្រើ​របស់​ Nepomuk"

#: server/nepomukserver.desktop:31
msgctxt "Comment"
msgid "The Nepomuk Server providing Storage services and strigi controlling"
msgstr ""
"ម៉ាស៊ីន​បម្រើ​របស់ Nepomuk ដែល​ផ្ទុក​សេវា​ផ្ទុក​ និង​ការ​ត្រួតពិនិត្យ​របស់ "
"strigi"

#: server/nepomukservice.desktop:4
msgctxt "Comment"
msgid "Nepomuk Service"
msgstr "សេវា​របស់ Nepomuk"

#: services/backupsync/gui/nepomukbackup.desktop:2
msgctxt "Name"
msgid "Nepomuk Backup"
msgstr "បម្រុងទុក Nepomuk"

#: services/backupsync/service/nepomukbackupsync.desktop:8
msgctxt "Name"
msgid "Nepomuk Backup and Sync"
msgstr "ធ្វើ​សមកាលកម្ម និង​បម្រុង​ទុក Nepomuk"

#: services/backupsync/service/nepomukbackupsync.desktop:31
msgctxt "Comment"
msgid "Nepomuk Service which handles backup and sync."
msgstr "សេវា​របស់ Nepomuk ដែល​​ដោះស្រាយ​ព័ត៌មាន​បម្រុង និង​សមកាលកម្ម ។"

#: services/fileindexer/nepomukfileindexer.desktop:7
msgctxt "Name"
msgid "File Indexer Service"
msgstr "សេវា​កម្មវិធី​កំណត់​លិបិក្រម​ឯកសារ"

#: services/fileindexer/nepomukfileindexer.desktop:30
msgctxt "Comment"
msgid "Nepomuk Service which indexes files on the desktop"
msgstr "សេវា Nepomuk ដែល​ឯកសារ​លិបិក្រម​នៅ​លើ​ផ្ទៃតុ"

#: services/fileindexer/nepomukfileindexer.notifyrc:3
msgctxt "Comment"
msgid "Desktop Search"
msgstr "ស្វែងរក​ផ្ទៃតុ"

#: services/fileindexer/nepomukfileindexer.notifyrc:28
msgctxt "Name"
msgid "Initial Indexing started"
msgstr "បាន​ចាប់ផ្ដើម​ការ​កំណត់​លិបិក្រម​ដំបូង"

#: services/fileindexer/nepomukfileindexer.notifyrc:51
msgctxt "Comment"
msgid "Indexing of local files for fast searches has started."
msgstr "កំណត់​លិបិក្រម​នៃ​ឯកសារ​មូលដ្ឋាន​សម្រាប់​​ចាប់ផ្ដើម​ស្វែងរក​រហ័ស ។"

#: services/fileindexer/nepomukfileindexer.notifyrc:77
msgctxt "Name"
msgid "Initial Indexing finished"
msgstr "បាន​បញ្ចប់​ការ​កំណត់​លិបិក្រម​ដំបូង"

#: services/fileindexer/nepomukfileindexer.notifyrc:100
msgctxt "Comment"
msgid "The initial indexing of local files for fast desktop searches has completed."
msgstr ""
"ការ​កំណត់​​លិបិក្រម​នៃ​ឯកសារ​មូលដ្ឋាន​ដំបូង​សម្រាប់​បញ្ចប់​ការ​ស្វែងរក​ផ្ទៃត"
"ុ​រហ័ស ។"

#: services/fileindexer/nepomukfileindexer.notifyrc:126
msgctxt "Name"
msgid "Indexing suspended"
msgstr "បាន​ផ្អាក​ការ​កំណត់​លិបិក្រម"

#: services/fileindexer/nepomukfileindexer.notifyrc:149
msgctxt "Comment"
msgid "File indexing has been suspended by the search service."
msgstr "ផ្អាក​ការ​កំណត់​លិបិក្រម​ឯកសារ​ដោយ​សេវា​ស្វែងរក ។"

#: services/fileindexer/nepomukfileindexer.notifyrc:175
msgctxt "Name"
msgid "Indexing resumed"
msgstr "បាន​ធ្វើ​បន្ត​ការ​កំណត់លិបិក្រម"

#: services/fileindexer/nepomukfileindexer.notifyrc:198
msgctxt "Comment"
msgid "File indexing has been resumed by the search service."
msgstr "ធ្វើ​បន្ត​ការ​កំណត់​លិបិក្រម​ឯកសារ​ដោយ​សេវា​ស្វែងរក ។"

#: services/filewatch/nepomukfilewatch.desktop:7
msgctxt "Name"
msgid "NepomukFileWatch"
msgstr "NepomukFileWatch"

#: services/filewatch/nepomukfilewatch.desktop:30
msgctxt "Comment"
msgid "The Nepomuk file watch service for monitoring file changes"
msgstr "សេវា​ឃ្លាំមើល​ឯកសារ Nepomuk សម្រាប់​ត្រួតពិនិត្យ​ការ​ផ្លាស់ប្ដូរ​ឯកសារ"

#: services/filewatch/nepomukfilewatch.notifyrc:3
msgctxt "Comment"
msgid "Nepomuk file watch service"
msgstr "សេវា​ឃ្លាំមើល​ឯកសារ Nepomuk"

#: services/filewatch/nepomukfilewatch.notifyrc:28
msgctxt "Name"
msgid "New Removable Device"
msgstr "ឧបករណ៍​ចល័ត​ថ្មី"

#: services/filewatch/nepomukfilewatch.notifyrc:51
msgctxt "Comment"
msgid "A new unknown removable device has been mounted"
msgstr "ម៉ោង​ឧបករណ៍​ចល័ត​ដែល​មិន​ស្គាល់​ថ្មី"

#: services/queryservice/nepomukqueryservice.desktop:7
msgctxt "Name"
msgid "NepomukQueryService"
msgstr "NepomukQueryService"

#: services/queryservice/nepomukqueryservice.desktop:30
msgctxt "Comment"
msgid "The Nepomuk Query Service provides an interface for persistent query folders"
msgstr ""
"សេវា​សំណួរ Nepomuk ផ្ដល់​ចំណុច​ប្រទាក់​​សម្រាប់​ថត​សំណួរ​ដែល​​មាន​ជា​បន្ត"

#: services/storage/nepomukstorage.desktop:7
msgctxt "Name"
msgid "Nepomuk Data Storage"
msgstr "ផ្ទុក​ទិន្នន័យ​ Nepomuk"

#: services/storage/nepomukstorage.desktop:30
msgctxt "Comment"
msgid "The Core Nepomuk data storage service"
msgstr "សេវា​ផ្ទុក​ទិន្នន័យ Nepomuk សំខាន់"

#: services/storage/nepomukstorage.notifyrc:3
msgctxt "Name"
msgid "Semantic Data Storage"
msgstr "ផ្ទុក​ទិន្នន័យ​ផ្ទៃតុ Semantic"

#: services/storage/nepomukstorage.notifyrc:26
msgctxt "Comment"
msgid "Semantic Desktop"
msgstr "ផ្ទៃតុ Semantic"

#: services/storage/nepomukstorage.notifyrc:51
msgctxt "Name"
msgid "Failed to start Nepomuk"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ចាប់ផ្ដើម Nepomuk"

#: services/storage/nepomukstorage.notifyrc:74
msgctxt "Comment"
msgid "The Nepomuk Semantic Desktop system could not be started"
msgstr "មិន​អាច​ចាប់ផ្ដើម​ប្រព័ន្ធ​ផ្ទៃតុ​ Nepomuk Semantic បាន​ទេ"

#: services/storage/nepomukstorage.notifyrc:100
msgctxt "Name"
msgid "Converting Nepomuk data"
msgstr "បម្លែង​ទិន្នន័យ​របស់ Nepomuk"

#: services/storage/nepomukstorage.notifyrc:123
msgctxt "Comment"
msgid "All Nepomuk data is converted to a new storage backend"
msgstr ""
"បម្លែង​ទិន្នន័យ​របស់ Nepomuk ទាំងអស់​ ដើម្បី​ផ្ទុក​កម្មវិធី​ខាងក្រោយ​ថ្មី"

#: services/storage/nepomukstorage.notifyrc:149
msgctxt "Name"
msgid "Converting Nepomuk data failed"
msgstr "បាន​បរាជ័យ​​ការ​បម្លែង​ទិន្នន័យ​របស់ Nepomuk"

#: services/storage/nepomukstorage.notifyrc:172
msgctxt "Comment"
msgid "Converting Nepomuk data to a new backend failed"
msgstr ""
"បាន​បរាជ័យ​ការ​បម្លែង​ទិន្នន័យ​របស់ Nepomuk ទៅកាន់​កម្មវិធី​ខាងក្រោយ​ថ្មី"

#: services/storage/nepomukstorage.notifyrc:198
msgctxt "Name"
msgid "Converting Nepomuk data done"
msgstr "បម្លែង​ទិន្នន័យ​របស់ Nepomuk រួចហើយ"

#: services/storage/nepomukstorage.notifyrc:221
msgctxt "Comment"
msgid "Successfully converted Nepomuk data to new backend"
msgstr ""
"បាន​បម្លែង​ទិន្នន័យ​របស់ Nepomuk ដោយ​ជោគជ័យ​ទៅកាន់​កម្មវិធី​ខាងក្រោយ​ថ្មី"
