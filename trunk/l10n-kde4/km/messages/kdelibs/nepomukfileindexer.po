#: indexer/main.cpp:46
msgid "NepomukIndexer"
msgstr "NepomukIndexer"

#: indexer/main.cpp:48
msgid ""
"NepomukIndexer indexes the contents of a file and saves the results in "
"Nepomuk"
msgstr "លិបិក្រម NepomukIndexer  មាន​មាតិកា​ឯកសារ និង​​រក្សាទុក​លទ្ធផល​ក្នុង Nepomuk"

#: indexer/main.cpp:50
#, fuzzy
#| msgid "(C) 2011, Vishesh Handa"
msgid "(C) 2011, Vishesh Handa, Sebastian Trueg"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០១១ ដោយ Vishesh Handa"

#: indexer/main.cpp:51
msgid "Vishesh Handa"
msgstr "Vishesh Handa"

#: indexer/main.cpp:51
msgid "Current maintainer"
msgstr "អ្នក​ថែទាំ​បច្ចុប្បន្ន"

#: indexer/main.cpp:52
msgid "Sebastian Trüg"
msgstr "Sebastian Trüg"

#: indexer/main.cpp:52
msgid "Developer"
msgstr "អ្នក​អភិវឌ្ឍន៍"

#: indexer/main.cpp:57
msgid "The URI provided will be forced on the resource"
msgstr "URI ដែល​បាន​ផ្ដល់​នឹង​ត្រូវ​បាន​បង្ខំ​​នៅ​លើ​ធនធាន"

#: indexer/main.cpp:58
msgid "The modification time of the resource in time_t format"
msgstr "ពេលវេលា​កំណែប្រែ​របស់​ធនធាន​​ក្នុង​​ទ្រង់ទ្រាយ time_t"

#: indexer/main.cpp:59
msgid "The URL of the file to be indexed"
msgstr "URL របស់​ឯកសារ​ត្រូវ​បាន​កំណត់​លិបិក្រម"

#: indexer/main.cpp:60
msgid "Remove all indexed data of the URL provided"
msgstr "យក​​ទិន្នន័យ​ដែល​បាន​កំណត់​លិបិក្រម​ទាំងអស់​ចេញ​ពី​ URL ដែល​បាន​ផ្ដល់"

#: eventmonitor.cpp:69
msgid "Indexing files for fast searching. This process may take a while."
msgstr "កំណត់​លិបិក្រម​ឯកសារ​សម្រាប់​ការ​ស្វែងរករហ័ស ។ ដំណើរការ​នេះ​អាច​ចំណាយ​ពេល​មួយ​ស្របក់ ។"

#: eventmonitor.cpp:98 eventmonitor.cpp:128
msgid "Resuming indexing of files for fast searching."
msgstr "បន្ត​ការ​កំណត់​លិបិក្រម​ឯកសារ​សម្រាប់​ការ​ស្វែងរក​រហ័ស ។"

#: eventmonitor.cpp:106
msgid "Suspending the indexing of files to preserve resources."
msgstr "ផ្អាក​ការ​កំណត់​លិបិក្រម ដើម្បី​រក្សាទុក​ធនធាន ។"

#: eventmonitor.cpp:120
#, kde-format
msgid "Disk space is running low (%1 left). Suspending indexing of files."
msgstr "ទំហំ​ថាស​ជិត​អស់​ហើយ (ទុក %1 ) ។ ផ្អាក​ការ​កំណត់​លិបិក្រម​ឯកសារ ។"

#: eventmonitor.cpp:148
#, kde-format
msgctxt "@info %1 is a duration formatted using KLocale::prettyFormatDuration"
msgid "Initial indexing of files for fast searching finished in %1"
msgstr "កំណត់​លិបិក្រម​​ឯកសារ​ដំបូង​សម្រាប់​ការ​ស្វែងរក​រហ័ស​ដែល​បាន​បញ្ចប់​នៅ​ក្នុង %1"

#: fileindexer.cpp:176
msgctxt "@info:status"
msgid "File indexer is suspended."
msgstr "ផ្អាក​កម្មវិធី​កំណត់​លិបិក្រម​ឯកសារ ។"

#: fileindexer.cpp:184
msgctxt "@info:status"
msgid "Scanning for recent changes in files for desktop search"
msgstr "វិភាគ​រក​អំពី​ការផ្លាស់ប្ដូរ​បច្ចុប្បន្ន​នៅ​ក្នុង​ឯកសារ​សម្រាប់​ការ​ស្វែងរក​ផ្ទៃតុ"

#: fileindexer.cpp:187
msgctxt "@info:status"
msgid "Indexing files for desktop search."
msgstr "កំណត់​លិបិក្រម​ឯកសារ​សម្រាប់​ការ​ស្វែងរក​ផ្ទៃតុ ។"

#: fileindexer.cpp:194
#, kde-format
msgctxt "@info:status"
msgid "Scanning for recent changes in %1"
msgstr "វិភាគ​រក​អំពី​ការ​ផ្លាស់ប្ដូរ​បច្ចុប្បន្ន​នៅ​ក្នុង %1"

#: fileindexer.cpp:198
#, kde-format
msgctxt "@info:status"
msgid "Indexing files in %1"
msgstr "កំណត់​លិបិក្រម​ឯកសារ​នៅ​ក្នុង %1"

#: fileindexer.cpp:200
#, kde-format
msgctxt "@info:status"
msgid "Indexing %1"
msgstr "កំណត់​លិបិក្រម %1"

#: fileindexer.cpp:205
msgctxt "@info:status"
msgid "File indexer is idle."
msgstr "កម្មវិធី​កំណត់​លិបិក្រម​ឯកសារ​គឺ​ទទេ ។"

