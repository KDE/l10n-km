#: tests/test_regression.cpp:372
msgid "Save failures of this testrun as failure snapshot <snapshot>"
msgstr "រក្សាទុក​ការ​បរាជ័យ​នៃ​ការ​រត់​សាកល្បង​នេះ​ជា​រូបថត​បរាជ័យ <snapshot>"

#: tests/test_regression.cpp:374
