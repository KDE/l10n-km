msgid ""
"<p>For help on individual commands, do <code>'help &lt;command&gt;'</code></"
"p>"
msgstr "<p>សម្រាប់​ជំនួយ​អំពីពាក្យ​បញ្ជា​នីមួយៗ ធ្វើ <code>'help &lt;command&gt;'</code></p>"

#: view/kateviewhelpers.cpp:331
#, qt-format
msgid "No help for '%1'"
