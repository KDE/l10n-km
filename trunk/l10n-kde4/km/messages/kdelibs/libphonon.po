#: volumeslider.cpp:36 volumeslider.cpp:50 volumeslider.cpp:169
#: volumeslider.cpp:180
#, kde-format
msgid "Volume: %1%"
msgstr "កម្រិត​សំឡេង ៖ %1%"

#: volumeslider.cpp:37 volumeslider.cpp:51 volumeslider.cpp:103
#, kde-format
msgid ""
"Use this slider to adjust the volume. The leftmost position is 0%, the "
"rightmost is %1%"
msgstr "ប្រើ​គ្រាប់​រំកិល​នេះ​ដើម្បី​លៃតម្រូវ​កម្រិត​សំឡេង ។ ទីតាំង​ខាង​ឆ្វេង​បំផុត​គឺ 0% ខាង​ស្ដាំ​បំផុត​គឺ %1%"

#: volumeslider.cpp:166
msgid "Muted"
msgstr "ស្ងាត់"

#: audiooutput.cpp:304
#, kde-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>ឧបករណ៍​ចាក់​អូឌីយ៉ូ​ម្ដង​ទៀត <b>%1</b> មិន​ដំណើរការ ។ <br/>ត្រឡប់ទៅ "
"<b>%2</b>។</html>"

#: audiooutput.cpp:309
#, kde-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr "<html>ប្ដូរ​ទៅ​ឧបករណ៍​ចាក់​អូឌីយ៉ូ​ម្ដង​ទៀត <b>%1</b><br/>ដែល​ទើបតែ​អាច​ប្រើ​បាន និង​មាន​ការ​អនុវត្ត​ខ្ពស់ ។</html>"

#: audiooutput.cpp:312
#, kde-format
msgid "Revert back to device '%1'"
msgstr "ត្រឡប់​ទៅ​ឧបករណ៍ '%1' វិញ"

