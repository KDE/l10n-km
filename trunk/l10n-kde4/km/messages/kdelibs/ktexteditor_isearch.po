#: ISearchPlugin.cpp:65 ISearchPlugin.cpp:351
msgid "Search Incrementally"
msgstr "ស្វែងរកបន្ថែម"

#: ISearchPlugin.cpp:70 ISearchPlugin.cpp:352
msgid "Search Incrementally Backwards"
msgstr "ស្វែងរក​បន្ថែម ថយក្រោយ"

#: ISearchPlugin.cpp:85
msgid "Search"
msgstr "ស្វែងរក ៖ "

#: ISearchPlugin.cpp:90
msgid "I-Search:"
msgstr "ស្វែងរក-បន្ថែម ៖"

#: ISearchPlugin.cpp:94
msgid "Search Options"
msgstr "ជម្រើស​ស្វែងរក"

#: ISearchPlugin.cpp:98 ISearchPlugin.cpp:397
msgid "Case Sensitive"
msgstr "ប្រកាន់​តួ​អក្សរ​តូច​ធំ "

#: ISearchPlugin.cpp:106 ISearchPlugin.cpp:399
msgid "From Beginning"
msgstr "ពី​ដំបូង"

#: ISearchPlugin.cpp:113 ISearchPlugin.cpp:401
msgid "Regular Expression"
msgstr "កន្សោម​ធម្មតា"

#: ISearchPlugin.cpp:228
msgctxt "Incremental Search"
msgid "I-Search:"
msgstr "ស្វែងរក-បន្ថែម ៖"

#: ISearchPlugin.cpp:231
msgctxt "Incremental Search found no match"
msgid "Failing I-Search:"
msgstr "ស្វែងរក-បន្ថែម បរាជ័យ ៖"

#: ISearchPlugin.cpp:234
msgctxt "Incremental Search in the reverse direction"
msgid "I-Search Backward:"
msgstr "ស្វែងរក-បន្ថែម ថយក្រោយ ៖"

#: ISearchPlugin.cpp:237
msgid "Failing I-Search Backward:"
msgstr "ស្វែងរក-បន្ថែម ថយក្រោយ បរាជ័យ ៖"

#: ISearchPlugin.cpp:240
msgctxt "Incremental Search has passed the end of the document"
msgid "Wrapped I-Search:"
msgstr "ស្វែងរក-បន្ថែម បន្ត​ជុំវិញ ៖"

#: ISearchPlugin.cpp:243
msgid "Failing Wrapped I-Search:"
msgstr "ស្វែងរក-បន្ថែម បាន​បន្ត​ជុំវិញ បរាជ័យ ៖"

#: ISearchPlugin.cpp:246
msgid "Wrapped I-Search Backward:"
msgstr "ស្វែងរក-បន្ថែម ថយក្រោយ បាន​បន្ត​ជុំវិញ ៖"

#: ISearchPlugin.cpp:249
msgid "Failing Wrapped I-Search Backward:"
msgstr "ស្វែងរក-បន្ថែម ថយក្រោយ បាន​បន្ត​ជុំវិញ បរាជ័យ ៖"

#: ISearchPlugin.cpp:253
msgctxt ""
"Incremental Search has passed both the end of the document and the original "
"starting position"
msgid "Overwrapped I-Search:"
msgstr "ស្វែងរក-បន្ថែម បាន​បន្ត​ជុំវិញ​ហើយ ៖"

#: ISearchPlugin.cpp:256
msgid "Failing Overwrapped I-Search:"
msgstr "ស្វែងរក-បន្ថែម ដែល​បាន​បន្ត​ជុំវិញ បានបរាជ័យ ៖"

#: ISearchPlugin.cpp:259
msgid "Overwrapped I-Search Backwards:"
msgstr "ស្វែងរក-បន្ថែម ថយក្រោយ ដែល​បាន​បន្ត​ជុំវិញ ៖"

#: ISearchPlugin.cpp:262
msgid "Failing Overwrapped I-Search Backward:"
msgstr "ស្វែងរក-បន្ថែម ថយក្រោយ ដែល​បាន​បន្ត​ជុំវិញ បាន​បរាជ័យ ៖"

#: ISearchPlugin.cpp:264
#, fuzzy
msgid "Error: unknown i-search state."
msgstr "កំហុស ៖ ស្ថានភាព ស្វែងរក​-បន្ថែម ដែល​មិន​ស្គាល់ !"

#: ISearchPlugin.cpp:322
msgid "Next Incremental Search Match"
msgstr "ការ​ផ្គូផ្គង​ស្វែងរក​បន្ថែម​បន្ទាប់"

#: ISearchPlugin.cpp:323
msgid "Previous Incremental Search Match"
msgstr "ការ​ផ្គូផ្គង​ស្វែងរក​បន្ថែម​មុន"

