#: rc.cpp:115 rc.cpp:775
msgid ""
"<qt>\n"
"<p>Here you can see a text excerpt showing the unknown word in its context. "
"If this information is not sufficient to choose the best replacement for the "
"unknown word, you can click on the document you are proofing, read a larger "
"part of the text and then return here to continue proofing.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>នៅ​ទីនេះ អ្នក​អាច​មើលឃើញ​ការ​ដកស្រង់​អត្ថបទ​ដែល​មានពាក្យ​មិន​ស្គាល់​នៅក្នុង​បរិបទ​របស់​វា ។ ប្រសិនបើ​"
"ព័ត៌មាន​នេះ​មិន​គ្រប់គ្រាន់​ដើម្បី​ជ្រើស​ពាក្យ​ជំនួស​ដែល​ល្អ​បំផុត​សម្រាប់​ពាក្យដែល​​មិន​ស្គាល់​នោះ អ្នក​អាច​ចុច​លើ​ឯកសារ​"
"ដែល​អ្នក​កំពុងកែ រួច​អាន​ផ្នែក​ធំ​របស់​អត្ថបទ បន្ទាប់​មក​ត្រឡប់​មក​ទីនេះ​វិញ ដើម្បី​បន្ដកែ ។</p>\n"
"</qt>"

