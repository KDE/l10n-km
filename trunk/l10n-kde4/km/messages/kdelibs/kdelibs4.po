#: kdeui/dialogs/kaboutkdedialog_p.cpp:49
#, kde-format
msgid ""
"<html><font size=\"5\">K Desktop Environment</font><br /><b>Version %1</b></"
"html>"
msgstr "<html><font size=\"5\">បរិស្ថាន​ផ្ទៃតុ K</font><br /><b>កំណែ %1</b></html>"

#: kdeui/dialogs/kaboutkdedialog_p.cpp:59
msgid ""
"<html>The <b>K Desktop Environment</b> is written and maintained by the KDE "
"Team, a world-wide network of software engineers committed to <a href="
"\"http://www.gnu.org/philosophy/free-sw.html\">Free Software</a> development."
"<br /><br />No single group, company or organization controls the KDE source "
"code. Everyone is welcome to contribute to KDE.<br /><br />Visit <a href="
"\"http://www.kde.org/\">http://www.kde.org</a> for more information on the "
"KDE project.</html>"
msgstr ""
"<html><b>បរិស្ថាន​ផ្ទៃតុ K</b> ត្រូវបាន​បង្កើតឡើង និង​ថែទាំ​ដោយ​ក្រុម KDE ដែលជា​បណ្ដាញ​វិស្វករ​"
"កម្មវិធី​ទូទាំងពិភពលោក ដែលបាន​ដាក់ស្នើ​ទៅកាន់​ការ​អភិវឌ្ឍ <a href=\"http://www.gnu.org/"
"philosophy/free-sw.html\">កម្មវិធី​ឥតគិតថ្លៃ</a> ។<br /><br />គឺ​មិនមែន​តែ​មួយ​ក្រុម ឬ​ក្រុមហ៊ុន "
"ឬ​អង្គការតែ​មួយ​ទេ ដែល​គ្រប់គ្រង​កូដ​ប្រភព KDE នោះ ។ អ្នក​រាល់គ្នា​គឺ​ត្រូវបាន​ស្វាគមន៍​ក្នុងការ​ចូលរួម​ក្នុង "
"KDE ។<br /><br />ចំពោះ​ព័ត៌មាន​អំពី​គម្រោង KDE សូម​ចូល​ទស្សនា <a href=\"http://www.kde.org/"
"\">http://www.kde.org</a></html>"

#: kdeui/dialogs/kaboutkdedialog_p.cpp:74
msgid ""
"<html>Software can always be improved, and the KDE Team is ready to do so. "
"However, you - the user - must tell us when something does not work as "
"expected or could be done better.<br /><br />The K Desktop Environment has a "
"bug tracking system. Visit <a href=\"http://bugs.kde.org/\">http://bugs.kde."
"org</a> or use the \"Report Bug...\" dialog from the \"Help\" menu to report "
"bugs.<br /><br />If you have a suggestion for improvement then you are "
"welcome to use the bug tracking system to register your wish. Make sure you "
"use the severity called \"Wishlist\".</html>"
msgstr ""
"<html>កម្មវិធី​អាច​ត្រូវបាន​ធ្វើ​ឲ្យ​ប្រសើរ​ជានិច្ច ហើយ​ក្រុម KDE គឺ​ត្រៀម​ខ្លួន​រួចស្រេច​ក្នុង​ការ​ធ្វើ​"
"ដូចនោះ ។ ទោះជា​យ៉ាងណា​ក៏ដោយ អ្នក​ត្រូវតែ​ជូនដំណឹងដល់​ពួកយើង នៅពេល​ដែល​អ្វីមួយ​មិន​ដំណើរការ​ដូចដែលបាន​"
"រំពឹងទុក ឬ​ធ្វើបាន​ល្អ​ជាង ។<br /><br />បរិស្ថាន​ផ្ទៃតុ K មាន​ប្រព័ន្ធ​តាមដាន​កំហុស ។ សូម​ទស្សនា <a "
"href=\"http://bugs.kde.org/\">http://bugs.kde.org</a> ឬ​ប្រើ​ប្រអប់ \"រាយការណ៍​"
"កំហុស...\" ពី​ម៉ឺនុយ \"ជំនួយ\" ដើម្បី​រាយការណ៍​កំហុស ។<br /><br />​ប្រសិន​បើ​អ្នក​មាន​ការផ្ដល់​យោបល់​សម្រាប់​"
"ការ​ធ្វើ​ឲ្យ​ប្រសើរ នៅពេល​នោះ​អ្នក​នឹង​ត្រូវ​ស្វាគមន៍​ចំពោះ​ការ​ប្រើ​ប្រព័ន្ធ​តាមដាន​កំហុស​ដើម្បី​ចុះឈ្មោះ ។ "
"ត្រូវប្រាកដ​ថា​អ្នកប្រើ \"បញ្ជី​ប្រាថ្នា\" ។</html>"

#: kdeui/dialogs/kaboutkdedialog_p.cpp:91
msgid ""
"<html>You do not have to be a software developer to be a member of the KDE "
"team. You can join the national teams that translate program interfaces. You "
"can provide graphics, themes, sounds, and improved documentation. You decide!"
"<br /><br />Visit <a href=\"http://www.kde.org/jobs/\">http://www.kde.org/"
"jobs/</a> for information on some projects in which you can participate.<br /"
"><br />If you need more information or documentation, then a visit to <a "
"href=\"http://techbase.kde.org/\">http://techbase.kde.org</a> will provide "
"you with what you need.</html>"
msgstr ""
"<html>អ្នក​មិនចាំបាច់​ជា​អ្នក​អភិវឌ្ឍន៍​កម្មវិធី​ដើម្បី​ជា​សមាជិក​ក្រុម KDE ឡើយ ។ អ្នក​អាច​ចូលរួម​ក្រុម​ជា​លក្ខណៈ​"
"ជាតិបាន ដែល​បកប្រែ​ចំណុច​ប្រទាក់​កម្មវិធី ។ អ្នក​អាច​ផ្ដល់​បាន​នូវ​ក្រាហ្វិក ស្បែក សំឡេង និង​ឯកសារ​ដែលបាន​"
"ធ្វើ​ឲ្យ​ប្រសើរ ។ អ្នក​ជា​អ្នក​សម្រេចចិត្ត !<br /><br />ចំពោះ​ព័ត៌មាន​​អំពី​គម្រោង​ដែលអ្នក​អាច​ចូលរួម​បាន "
"សូម​ទស្សនា <a href=\"http://www.kde.org/jobs/\">http://www.kde.org/jobs/</a> ។"
"<br /><br />ប្រសិន​បើ​អ្នក​ត្រូវការ​ព័ត៌មាន ឬ​ឯកសារ​បន្ថែម សូម​ចូល​ទស្សនា <a href=\"http://"
"techbase.kde.org/\">http://techbase.kde.org</a> ដែល​នឹង​ផ្ដល់​ឲ្យ​អ្នក​នូវ​អ្វី​ដែល​អ្នក​"
"ត្រូវការ ។</html>"

#: kdeui/dialogs/kaboutkdedialog_p.cpp:111
msgid ""
"<html>KDE is available free of charge, but making it is not free.<br /><br /"
">Thus, the KDE team formed the KDE e.V., a non-profit organization legally "
"founded in Tuebingen, Germany. The KDE e.V. represents the KDE project in "
"legal and financial matters. See <a href=\"http://www.kde-ev.org/\">http://"
"www.kde-ev.org</a> for information on the KDE e.V.<br /><br />The KDE team "
"does need financial support. Most of the money is used to reimburse members "
"and others on expenses they experienced when contributing to KDE. You are "
"encouraged to support KDE through a financial donation, using one of the "
"ways described at <a href=\"http://www.kde.org/support/\">http://www.kde.org/"
"support/</a>.<br /><br />Thank you very much in advance for your support.</"
"html>"
msgstr ""
"<html>KDE គឺ​មិនគិត​ថ្លៃទេ ប៉ុន្តែ​ការ​បង្កើត​វា​គឺ​មិនមែន​មិនគិត​ថ្លៃ​នោះ​ទេ ។<br /><br />ដូច្នេះ ក្រុម "
"KDE បាន​បង្កើត KDE e.V. ដែល​ជា​អង្គការ​មិន​រក​ប្រាក់​ចំណេញ​ស្របច្បាប់​មួយ នៅ​ក្នុង​ទីក្រុង Tuebingen "
"ប្រទេស​អាឡឺម៉ង់ ។ The KDE e.V. តំណាង​ឲ្យ​គម្រោង KDE ក្នុង​​លក្ខខណ្ឌ​ស្របច្បាប់ និង​ហិរញ្ញវត្ថុ ។ សូមមើល "
"<a href=\"http://www.kde-ev.org/\">http://www.kde-ev.org</a> សម្រាប់​ព័ត៌មាន​បន្ថែម​"
"អំពី KDE e.V.<br /><br />ក្រុម KDE គឺ​ត្រូវ​ការ​ការ​គាំទ្រ​ផ្នែក​ហិរញ្ញវត្ថុ ។ ថវិកា​ភាគច្រើន​គឺ​ត្រូវ​បាន​"
"ប្រើ​សម្រាប់​សង​ដល់​សមាជិក ហើយ​ថវិកា​ផ្សេងទៀត​គឺ​សម្រាប់​ការ​ចំណាយ​ផ្សេងៗ​នៅពេល​ចូលរួម​ជាមួយ KDE ។ អ្នក​"
"ត្រូវបាន​លើកទឹកចិត្ត​ឲ្យ​គាំទ្រ KDE តាមរយៈ​ការ​ជួយ​ឧបត្ថម្ភ​ខាងផ្នែក​ហិរញ្ញវត្ថុ ដោយប្រើ​វិធី​ណាមួយ​ដែលបាន​"
"រៀបរាប់​នៅ <a href=\"http://www.kde.org/support/\">http://www.kde.org/support/"
"</a> ។<br /><br />សូម​អរគុណ​យ៉ាង​ជ្រាលជ្រៅ​ចំពោះ​ការ​គាំទ្រ​របស់​អស់​លោកអ្នក ។</html>"

