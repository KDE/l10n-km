#: kfile/kfilewidget.cpp:349
msgid ""
"<qt>This is the preferences menu for the file dialog. Various options can be "
"accessed from this menu including: <ul><li>how files are sorted in the list</"
"li><li>types of view, including icon and list</li><li>showing of hidden "
"files</li><li>the Places navigation panel</li><li>file previews</"
"li><li>separating folders from files</li></ul></qt>"
msgstr ""
"<qt>នេះ​ជា​ម៉ឺនុយ​ចំណង់ចំណូលចិត្ត​សម្រាប់​ប្រងប់​ឯកសារ ។ ជម្រើស​ផ្សេងទៀត​អាច​ត្រូវបាន​ចូល​ដំណើរការ​ពី​ម៉ឺនុយ​នេះ "
"ដោយ​រួមមាន ៖ <ul><li>របៀប​តម្រៀប​ឯកសារ​នៅ​ក្នុង​បញ្ជី</li><li>ប្រភេទ​ទិដ្ឋភាព ដែលរួមមាន​រូបតំណាង "
"និង​បញ្ជី</li><li>ការ​បង្ហាញ​ឯកសារ​ដេលលាក់</li><li>បន្ទះ​រុករក​ទីតាំង</li><li>ការ​មើល​ឯកសារ​"
"ជាមុន</li><li>ការ​បំបែកថត​ចេញ​ពី​ឯកសារ</li></ul></qt>"

