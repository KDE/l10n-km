#: mediacontrols_p.h:50
msgid "start playback"
msgstr "ចាប់ផ្ដើម​ចាក់ឡើង​វិញ"

#: mediacontrols_p.h:55
msgid "pause playback"
msgstr "ផ្អាក​ការ​ចាក់​ឡើង​វិញ"

#: mediacontrols_p.h:61
msgid "stop playback"
msgstr "បញ្ឈប់​កា​រចាក់ឡើង​វិញ"

#: mediacontrols_p.h:66
msgid "loop: restarts playback at end"
msgstr "រង្វិលជុំ ៖ ចាប់ផ្ដើម​ការ​ចាក់ឡើង​វិញ​នៅពេល​ចប់"

#: kfileaudiopreview.cpp:75
msgid "Media Player"
msgstr "កម្មវិធី​ចាក់​មេឌៀ"

#: kfileaudiopreview.cpp:90
msgid "Play &automatically"
msgstr "ចាក់​ដោយ​ស្វ័យប្រវត្តិ"

