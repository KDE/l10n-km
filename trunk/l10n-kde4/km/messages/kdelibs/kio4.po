msgid_plural "These files use advanced permissions."
msgstr[0] "ឯកសារ​ទាំងនេះ​ប្រើ​សិទ្ធិ​កម្រិត​ខ្ពស់ ។."

#: kfile/kpropertiesdialog.cpp:2361
msgid "This folder uses advanced permissions."
