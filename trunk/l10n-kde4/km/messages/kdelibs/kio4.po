msgstr "ឧបករណ៍ (/dev/fd0) ៖"

#: kfile/kpropertiesdialog.cpp:2917
msgid "Device:"
msgstr "ឧបករណ៍ ៖"

#: kfile/kpropertiesdialog.cpp:2930
msgid "Read only"
msgstr "បាន​តែ​អាន"

#: kfile/kpropertiesdialog.cpp:2934
msgid "File system:"
msgstr "ប្រព័ន្ធ​ឯកសារ ៖"

#: kfile/kpropertiesdialog.cpp:2942
msgid "Mount point (/mnt/floppy):"
msgstr "ចំណុច​ម៉ោន (/mnt/floppy) ៖"

#: kfile/kpropertiesdialog.cpp:2943
msgid "Mount point:"
msgstr "ចំណុច​ម៉ោន ៖"

#: kfile/kpropertiesdialog.cpp:2976
msgid "Unmounted Icon"
msgstr "រូប​តំណាង​ដែល​មិន​បាន​ម៉ោន"

#: kfile/kpropertiesdialog.cpp:3178
msgid "&Application"
msgstr "កម្មវិធី"

#: kfile/kpropertiesdialog.cpp:3297
#, kde-format
msgid "Add File Type for %1"
msgstr "បន្ថែម​ប្រភេទ​ឯកសារ​ទៅ​ឲ្យ %1"

#: kfile/kpropertiesdialog.cpp:3298
msgid "Select one or more file types to add:"
msgstr "ជ្រើស​ប្រភេទ​ឯកសារ​មួយ ឬ ច្រើន ដើម្បី​បន្ថែម ៖"

#: kfile/kpropertiesdialog.cpp:3432
msgid "Only executables on local file systems are supported."
msgstr "គាំទ្រ​តែ​ឯកសារ​ប្រតិបត្តិ​នៅ​លើ​ប្រព័ន្ធ​ឯកសារ​មូលដ្ឋាន​ប៉ុណ្ណោះ"

#: kfile/kpropertiesdialog.cpp:3446
#, kde-format
msgid "Advanced Options for %1"
msgstr "ជម្រើស​កម្រិត​ខ្ពស់សម្រាប់ %1"

#: kfile/kfilesharedialog.cpp:59
msgid "&Share"
msgstr "ចែករំលែក"

#: kfile/kfilesharedialog.cpp:133
msgid "Only folders in your home folder can be shared."
msgstr "មាន​តែ​ថត​ក្នុង​ថត​ផ្ទះ​របស់​អ្នក​ប៉ុណ្ណោះ​អាច​នឹង​ចែក​រំលែក​បាន ។"

#: kfile/kfilesharedialog.cpp:143
msgid "Not shared"
msgstr "មិន​បាន​ចែក​រំលែក"

#: kfile/kfilesharedialog.cpp:148
msgid "Shared"
msgstr "បាន​ចែករំលែក"

#: kfile/kfilesharedialog.cpp:160
msgid ""
"Sharing this folder makes it available under Linux/UNIX (NFS) and Windows "
"(Samba)."
msgstr "ចែក​រំលែក​ថត​នេះ ធ្វើ​ឲ្យ​វា​អាច​ប្រើ​បាន​ក្រោម Linux/UNIX (NFS) និង Windows (Samba)."

#: kfile/kfilesharedialog.cpp:167
msgid "You can also reconfigure file sharing authorization."
msgstr "អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​ការ​អនុញ្ញាត​ចែក​រំលែក​ឯកសារ​ឡើង​វិញ ។"

#: kfile/kfilesharedialog.cpp:171 kfile/kfilesharedialog.cpp:195
msgid "Configure File Sharing..."
msgstr "កំណត់​រចនា​សម្ព័ន្ធ​ការ​ចែក​រំលែក​ឯកសារ​..."

#: kfile/kfilesharedialog.cpp:180
msgid ""
"Error running 'filesharelist'. Check if installed and in $PATH or /usr/sbin."
msgstr ""
"មាន​កំហុស ក្នុង​ការ​រត់ 'បញ្ជី​ចែក​រំលែក​ឯកសារ' ។ ពិនិត្យ​ថា​តើ​វា​បាន​ដំឡើង និង មាន​នៅ​ក្នុង $PATH ឬ /"
"usr/sbin ។"

#: kfile/kfilesharedialog.cpp:187
msgid "You need to be authorized to share folders."
msgstr "អ្នក​ចាំបាច់​ត្រូវ​មាន​ការ​អនុញ្ញាត ដើម្បី​ចែក​រំលែក​ឯកសារ ។"

#: kfile/kfilesharedialog.cpp:190
msgid "File sharing is disabled."
msgstr "ការ​ចែក​រំលែក​ឯកសារ មិន​បាន​អនុញ្ញាត​ឡើយ ។"

#: kfile/kfilesharedialog.cpp:257
#, kde-format
msgid "Sharing folder '%1' failed."
msgstr "បរាជ័យ​ក្នុង​ការ​ចែក​រំលែកថត '%1' ។"

#: kfile/kfilesharedialog.cpp:258
#, kde-format
msgid ""
"An error occurred while trying to share folder '%1'. Make sure that the Perl "
