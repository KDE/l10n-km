msgctxt "Comment"
msgid "Adds global keyboard shortcuts to KActivityManager Daemon"
msgstr "បន្ថែម​ផ្លូវកាត់​ក្ដារចុច​សកល​ទៅ​ដេមិន KActivityManager"

#: service/plugins/nepomuk/activitymanager-plugin-nepomuk.desktop:2
msgctxt "Name"
msgid "Nepomuk Feeder Plugin"
msgstr "កម្មវិធី​ជំនួយ​របស់​​កម្មវិធី​មតិ​ព័ត៌មាន Nepomuk"

#: service/plugins/nepomuk/activitymanager-plugin-nepomuk.desktop:38
msgctxt "Comment"
