msgid "Share-Like-Connect Plugin"
msgstr "កម្មវិធី​ជំនួយ​តភ្ជាប់​ដូច​ជា​ការ​ចែករំលែក"

#: service/plugins/slc/activitymanager-plugin-slc.desktop:40
msgctxt "Comment"
msgid "Plugin to provide data to the SLC system"
msgstr "កម្មវិធី​ជំនួយ​ត្រូវ​ផ្ដល់​ទិន្នន័យ​ទៅកាន់​ប្រព័ន្ធ SLC"

#: service/plugins/sqlite/activitymanager-plugin-sqlite.desktop:2
msgctxt "Name"
msgid "Sqlite Feeder Plugin"
msgstr "កម្មវិធី​ជំនួយ​មតិព័ត៌មាន​របស់ Sqlite"

#: service/plugins/sqlite/activitymanager-plugin-sqlite.desktop:32
msgctxt "Comment"
msgid "Plugin to store and score events in Sqlite"
msgstr "កម្មវិធី​ជំនួយ​ដើម្បី​រក្សាទុក​ និងដាក់​ពិន្ទុ​ព្រឹត្តិការណ៍​នៅ​ក្នុង Sqlite"

#: service/ui/plugins/declarativeui/package/metadata.desktop:2
msgctxt "Name"
msgid "Activity manager UI handler"
msgstr "កម្មវិធី​គ្រប់គ្រង​សកម្មភាព​នៃ​កម្មវិធី​គ្រប់គ្រង​ចំណុច​ប្រទាក់​អ្នកប្រើ"

#: workspace/fileitemplugin/kactivitymanagerd_fileitem_linking_plugin.desktop:4
