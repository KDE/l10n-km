#: service/plugins/dummy/activitymanager-plugin-dummy.desktop:43
msgctxt "Comment"
msgid "Just testing"
msgstr "គ្រាន់តែ​ធ្វើ​ការសាកល្បង"

#: service/plugins/globalshortcuts/activitymanager-plugin-globalshortcuts.desktop:2
msgctxt "Name"
msgid "Global Shortcuts plugin"
msgstr "កម្មវិធី​ជំនួយ​ផ្លូវកាត់​សកល"

