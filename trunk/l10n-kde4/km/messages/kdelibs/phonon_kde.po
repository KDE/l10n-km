#: kdepluginfactory.cpp:131
#, kde-format
msgid "Unable to use the <b>%1</b> Multimedia Backend:"
msgstr "មិន​អាច​ប្រើ​ផ្នែកខា​ងក្រោយ​ពហុព័ត៌មាន​របស់ <b>%1</b> ៖"

#: kdepluginfactory.cpp:139
msgid "create method returned 0"
msgstr "វិធីសាស្ត្រ​បង្កើត​បាន​ត្រឡប់ 0"

#: kdepluginfactory.cpp:164
#, kde-format
msgid "<qt>Unable to use the <b>%1</b> Multimedia Backend:<br/>%2</qt>"
msgstr "<qt>មិនអាច​ប្រើ <b>%1</b> ផ្នែក​ខាង​ក្រោយ​ពហុព័ត៌មាន ៖<br/>%2</qt>"

#: kdepluginfactory.cpp:184
msgid "Unable to find a Multimedia Backend"
msgstr "មិន​អាច​រក​ផ្នែក​ខាង​ក្រោយ​ពហុព័ត៌មាន"

#: kdepluginfactory.cpp:219
msgid "Unable to find the requested Multimedia Backend"
msgstr "មិន​អាច​រក​ផ្នែក​ខាង​ក្រោយ​ពហុព័ត៌មាន​ដែល​បាន​ស្នើ"

