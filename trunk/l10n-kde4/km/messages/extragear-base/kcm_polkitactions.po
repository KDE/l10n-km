msgid "Global system policy settings"
msgstr "ការ​កំណត់​គោលនយោបាយ​ប្រព័ន្ធ​សកល"

#: PolkitActionsKCM.cpp:39
msgid ""
"A configuration for polkit-1 system administrators and policy priorities"
msgstr "ការ​កំណត់​រចនាសម្ព័ន្ធ​សម្រាប់ polkit-1 អាទិភាព​សម្រាប់​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ និង​គោលនយោបាយ"

