#: plugin_validators.cpp:44
msgid "Validate Web Page"
msgstr "​ធ្វើ​ឲ្យ​ទំព័រ​បណ្តាញ​មាន​សុពលភាព"

#: plugin_validators.cpp:54
msgid "&Validate Web Page"
msgstr "​ធ្វើ​ឲ្យ​ទំព័រ​បណ្តាញ​មាន​សុពលភាព"

#: plugin_validators.cpp:59
msgid "Validate &HTML"
msgstr "ធ្វើ​ឲ្យ​ HTML ​មាន​សុពលភាព"

#: plugin_validators.cpp:62
msgid "Validate &CSS"
msgstr "ធ្វើ​ឲ្យ CSS ​មាន​សុពលភាព"

#: plugin_validators.cpp:65
msgid "Validate &Links"
msgstr "ធ្វើ​ឲ្យ​តំណ​មាន​សុពលភាព"

#: plugin_validators.cpp:71
msgid "C&onfigure Validator..."
msgstr "​កំណត់​រចនាសម្ព័ន្ធ​កម្មវិធី​ធ្វើ​​ឲ្យ​មាន​សុពលភាព..."

#: plugin_validators.cpp:139
msgid "Cannot Validate Source"
msgstr "មិន​អាច​ធ្វើ​ឲ្យ​​ប្រភព​​មាន​សុពលភាព​​"

#: plugin_validators.cpp:140
msgid "You cannot validate anything except web pages with this plugin."
msgstr "អ្នក​មិន​អាច​ធ្វើ​ឲ្យ​អ្វីៗ​​មាន​សុពលភាព​បានទេ ​លើកលែង​តែ​​ទំព័រ​បណ្តាញ​​ដែល​មាន​កម្មវិធី​ជំនួយ​នេះ ។"

#: plugin_validators.cpp:153
msgid "Malformed URL"
msgstr "URL មិន​ត្រឹមត្រូវ"

#: plugin_validators.cpp:154
msgid "The URL you entered is not valid, please correct it and try again."
msgstr "URL ដែល​អ្នក​បាន​​បញ្ចូល​​​មិន​ត្រឹមត្រូវ​ទេ សូម​​កែ​វា​​ហើយ​​សាកល្បង​ម្តង​ទៀត ។"

#: plugin_validators.cpp:163
msgid "Upload Not Possible"
msgstr "មិន​អាច​ផ្ទុក​ឡើង​បាន​ទេ"

#: plugin_validators.cpp:164
msgid "Validating links is not possible for local files."
msgstr "មិន​អាច​ធ្វើ​ឲ្យ​តំណ​មាន​សុពលភាព​​សម្រាប់​ឯកសារ​មូលដ្ឋាន​បានទេ ។"

#: plugin_validators.cpp:177
#, kde-format
msgid ""
"<qt>The selected URL cannot be verified because it contains a password. "
"Sending this URL to <b>%1</b> would put the security of <b>%2</b> at risk.</"
"qt>"
msgstr ""
"<qt>URL​ ដែល​បាន​ជ្រើស​​មិន​អាច​ត្រូវ​បាន​ផ្ទៀងផ្ទាត់​ទេ ពី​​ព្រោះ​វា​មាន​​ពាក្យ​សម្ងាត់​ ។ ការ​បញ្ជូន​ URL ​នេះ​​"
"ទៅ <b>%1</b> នឹង​ធ្វើ​ឲ្យ​សុវត្ថិភាព​របស់​ <b>%2</b>​ មាន​​គ្រោះថ្នាក់ ។</qt>"

