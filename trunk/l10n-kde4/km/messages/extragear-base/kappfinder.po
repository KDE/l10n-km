#: main.cpp:27
msgid "KDE's application finder"
msgstr "ឧបករណ៍​រក​កម្មវិធី​របស់ KDE"

#: main.cpp:31 toplevel.cpp:50
msgid "KAppfinder"
msgstr "KAppfinder"

#: main.cpp:33
msgid "(c) 1998-2000, Matthias Hoelzer-Kluepfel"
msgstr "រក្សា​សិទ្ធ​ឆ្នាំ ១៩៩៨-២០០០ ដោយ Matthias Hoelzer-Kluepfel"

#: main.cpp:34
msgid "Matthias Hoelzer-Kluepfel"
msgstr "Matthias Hoelzer-Kluepfel"

#: main.cpp:35
msgid "Tobias Koenig"
msgstr "Tobias Koenig"

#: main.cpp:40
msgid "Install .desktop files into directory <dir>"
msgstr "ដំឡើង​ឯកសារ .desktop ទៅ​ក្នុង​ថត <dir>"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, អេង វណ្ណៈ, អោក ពិសិដ្ឋ​​"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,​​evannak@khmeros.info,piseth_dv@khmeros.info"

#: toplevel.cpp:58
msgid ""
"The application finder looks for non-KDE applications on your system and "
"adds them to the KDE menu system. Click 'Scan' to begin, select the desired "
"applications and then click 'Apply'."
msgstr ""
"ឧបករណ៍​រក​កម្មវិធី រក​មើល​កម្មវិធី​ដែល​មិន​មែន​ជា​របស់ KDE នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក ហើយ​បន្ថែម​\n"
"ពួក​វា​ទៅក្នុង​​ប្រព័ន្ធ​ម៉ឺនុយ KDE ។ ចុច 'ស្កេន' ដើម្បី​ចាប់ផ្ដើម ជ្រើស​កម្មវិធី​ដែល​ចង់​ស្កេន​ ហើយ​​បន្ទាប់​មក​"
"ចុច 'អនុវត្ត' ។"

#: toplevel.cpp:67
msgid "Application"
msgstr "កម្មវិធី"

#: toplevel.cpp:67
msgid "Description"
msgstr "សេចក្ដី​ពិពណ៌នា"

#: toplevel.cpp:67
msgid "Command"
msgstr "ពាក្យ​បញ្ជា"

#: toplevel.cpp:77
msgid "Summary:"
msgstr "សង្ខេប ៖"

#: toplevel.cpp:79
msgid "Scan"
msgstr "ស្កេន​"

#: toplevel.cpp:80
msgid "Select All"
msgstr "ជ្រើស​ទាំងអស់​"

#: toplevel.cpp:81
msgid "Unselect All"
msgstr "ដោះ​ជម្រើស​ទាំងអស់"

#: toplevel.cpp:238
#, kde-format
msgid "Summary: %1 application found"
msgid_plural "Summary: %1 applications found"
msgstr[0] "សង្ខេប ៖ បាន​រកឃើញ​កម្មវិធី %1"

#: toplevel.cpp:281
#, kde-format
msgid "%1 application was added to the KDE menu system."
msgid_plural "%1 applications were added to the KDE menu system."
msgstr[0] "កម្មវិធី %1 ត្រូវ​បាន​បន្ថែម​ទៅ​កាន់​ប្រព័ន្ធ​ម៉ឺនុយ KDE ។"
