#: kcmodules/helper/polkitkde1.actions:2
msgctxt "Name"
msgid "System policy settings"
msgstr "ការ​កំណត់​គោលនយោបាយ​ប្រព័ន្ធ"

#: kcmodules/helper/polkitkde1.actions:35
msgctxt "Name"
msgid "Read system authorizations"
msgstr "អាន​ការ​អនុញ្ញាត​របស់ប្រព័ន្ធ"

#: kcmodules/helper/polkitkde1.actions:65
msgctxt "Description"
msgid "Authorization is required to read system authorizations"
msgstr "ការ​អនុញ្ញាត​ត្រូវ​បានទាមទារ​ ដើម្បីអាន​ការ​អនុញ្ញាត​របស់​ប្រព័ន្ធ"

#: kcmodules/helper/polkitkde1.actions:99
msgctxt "Name"
msgid "Change implicit authorizations for an action"
msgstr "ផ្លាស់ប្ដូរ​ការអនុញ្ញាតមិន​​ជាក់លាក់​សម្រាប់​សកម្មភាព"

#: kcmodules/helper/polkitkde1.actions:129
msgctxt "Description"
msgid "Authorization is required to change implicit authorizations"
msgstr "កា​រអនុញ្ញាត​ត្រូវ​បាន​ទាមទារ​ ដើម្បី​ផ្លាស់ប្ដូរ​ការ​អនុញ្ញាត​មិន​​ជាក់លាក់"

#: kcmodules/helper/polkitkde1.actions:162
msgctxt "Name"
msgid "Change explicit authorizations for an action"
msgstr "ផ្លាស់ប្ដូរ​ការ​អនុញ្ញាតជាក់លាក់​សម្រាប់​សកម្មភាព"

#: kcmodules/helper/polkitkde1.actions:192
msgctxt "Description"
msgid "Authorization is required to change explicit authorizations"
msgstr "ការ​អនុញ្ញាត​ត្រូវ​បានទាមទារ​ ដើម្បី​ផ្លាស់ប្ដូរ​ការ​អនុញ្ញាត​ជាក់លាក់"

#: kcmodules/helper/polkitkde1.actions:226
msgctxt "Name"
msgid "Change global configuration for system policies"
msgstr "ផ្លាស់ប្ដូរ​ការ​កំណត់​រចនាសម្ព័ន្ធ​សកល​សម្រាប់​គោលនយោបាយ​ប្រព័ន្ធ"

#: kcmodules/helper/polkitkde1.actions:256
msgctxt "Description"
msgid ""
"Authorization is required to change global configuration for system policies"
msgstr "ការ​អនុញ្ញាត​ត្រូវ​បាន​ទាមទារ​ ដើម្បី​ផ្លាស់ប្ដូរ​ការ​កំណត់​រចនាសម្ព័ន្ធសកល​សម្រាប់គោលនយោបាយ​ប្រព័ន្ធ"

#: kcmodules/polkitactions/kcm_polkitactions.desktop:13
msgctxt "Name"
msgid "Actions policy"
msgstr "គោលនយោបាយ​សកម្មភាព"

#: kcmodules/polkitactions/kcm_polkitactions.desktop:44
msgctxt "Comment"
msgid "Configure policies for trusted actions in the system"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​គោលនយោបាយ​ សម្រាប់​សកម្មភាព​ដែល​ទុកចិត្ត​នៅ​ក្នុង​ប្រព័ន្ធ"

#: kcmodules/polkitconfig/kcm_polkitconfig.desktop:13
msgctxt "Name"
msgid "Global policy configuration"
msgstr "ការ​កំណត់​គោលនយោបាយ​សកល"

#: kcmodules/polkitconfig/kcm_polkitconfig.desktop:44
msgctxt "Comment"
msgid "Configure global settings for system policies"
msgstr "កំណត់​រចនាសម្ព័ន្ធនៃ​ការ​កំណត់​សកល​សម្រាប់​គោលនយោបាយ​ប្រព័ន្ធ"

#: kcmodules/settings-system-policies.desktop:8
