#: helper/polkitkde1.actions:2
msgctxt "Name"
msgid "System policy settings"
msgstr "ការ​កំណត់​គោល​នយោបាយ​ប្រព័ន្ធ​​ "

#: helper/polkitkde1.actions:54
msgctxt "Name"
msgid "Read system authorizations"
msgstr "អាន​សេចក្ដី​អនុញ្ញាត​ប្រព័ន្ធ​"

#: helper/polkitkde1.actions:100
msgctxt "Description"
msgid "Authorization is required to read system authorizations"
msgstr "សេចក្ដី​អនុញ្ញាត​ត្រូវ​បាន​ទាមទារ​ ដើម្បី​អាន​សេចក្ដីអនុញ្ញាត​ប្រព័ន្ធ​"

#: helper/polkitkde1.actions:150
msgctxt "Name"
msgid "Change implicit authorizations for an action"
msgstr "ប្ដូរ​សេចក្ដី​អនុញ្ញាត​ទាំង​ស្រុង​ សម្រាប់​សកម្មភាព​"

#: helper/polkitkde1.actions:195
msgctxt "Description"
msgid "Authorization is required to change implicit authorizations"
msgstr "សេចក្ដី​អនុញ្ញាត​ត្រូវ​បាន​ទាមទារ​ ដើម្បី​ប្ដូរ​សេចក្ដីអនុញ្ញាត​​ទាំងស្រុង​"

#: helper/polkitkde1.actions:243
msgctxt "Name"
msgid "Change explicit authorizations for an action"
msgstr "ប្ដូរ​សេចក្ដី​អនុញ្ញាត​មិន​មិន​ទាំង​ស្រុង​​​ សម្រាប់​សកម្មភាព​"

#: helper/polkitkde1.actions:288
msgctxt "Description"
msgid "Authorization is required to change explicit authorizations"
msgstr "សេចក្ដី​អនុញ្ញាត​ត្រូវ​បាន​ទាមទារ​ ដើម្បី​ប្ដូរ​សេចក្ដី​អនុញ្ញាត​មិន​ទាំងស្រុង​"

#: helper/polkitkde1.actions:337
msgctxt "Name"
msgid "Change global configuration for system policies"
msgstr "ប្ដូរ​ការកំណត់​រចនាសម្ព័ន្ធ​សកល​​​ សម្រាប់​គោល​​នយោបាយ​ប្រព័ន្ធ​"

#: helper/polkitkde1.actions:383
msgctxt "Description"
msgid ""
"Authorization is required to change global configuration for system policies"
msgstr "សេចក្ដី​អនុញ្ញាត​ត្រូវ​បាន​ទាមទារ​ ​ដើម្បី​កំណត់​រចនាសម្ព័ន្ធ​សកល​ សម្រាប់​​គោល​នយោបាយ​ប្រព័ន្ធ​"

