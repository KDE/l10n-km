#: kviewconfmodules.cpp:43
msgid "Resizing"
msgstr "កំពុង​ប្តូរ​ទំហំ"

#: kviewconfmodules.cpp:48
msgid "Only resize window"
msgstr "ប្តូរ​តែ​ទំហំ​បង្អួច"

#: kviewconfmodules.cpp:49
msgid "Resize image to fit window"
msgstr "ប្តូរ​ទំហំ​រូបភាព​ឲ្យ​សម​នឹង​បង្អួច"

#: kviewconfmodules.cpp:50
msgid "Don't resize anything"
msgstr "កុំ​ប្តូរ​ទំហំ​អ្វីមួយ"

#: kviewconfmodules.cpp:51
msgid "Best fit"
msgstr "សម​បំផុត"

#: kviewconfmodules.cpp:52
msgid ""
"<p>KView will resize the window to fit the image. The image will never be "
"scaled up but if it is too large for the screen the image will be scaled "
"down.</p>"
msgstr ""
"<p>KView នឹង​ប្តូរ​ទំហំ​បង្អួច​ឲ្យ​សម​នឹង​រូបភាព ។ រូបភាព​នឹង​បង្កើន​មាត្រដ្ឋាន ប៉ុន្តែ​ប្រសិនបើ​វា​ធំពេក​ចំពោះ​"
"អេក្រង់ រូបភាព​នឹង​បន្ថយមាត្រដ្ឋាន ។</p>"
