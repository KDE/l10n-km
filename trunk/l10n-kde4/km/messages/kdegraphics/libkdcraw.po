#: libkdcraw/dcrawsettingswidget.cpp:182
msgid "16 bits color depth"
msgstr "ជម្រៅ​ពណ៌ ១៦​ ប៊ីត"

#: libkdcraw/dcrawsettingswidget.cpp:183
msgid ""
"<p>If enabled, all RAW files will be decoded in 16-bit color depth using a "
"linear gamma curve. To prevent dark picture rendering in the editor, it is "
"recommended to use Color Management in this mode.<p>If disabled, all RAW "
"files will be decoded in 8-bit color depth with a BT.709 gamma curve and a "
"99th-percentile white point. This mode is faster than 16-bit decoding."
msgstr ""
"<p>ប្រសិន​បើ​បាន​បើក ឯកសារ RAW ទាំងអស់​នឹង​ត្រូវបាន​ឌិកូដ​ទៅ​ជា​ជម្រៅ​ពណ៌ ១៦ ប៊ីត ដោយប្រើ​ខ្សែកោង​ហ្កាម៉ា​"
"លីនេអ៊ែរ ។ ដើម្បី​ការ​ពារ​ពី​ការ​បង្ហាញ​រូបភាព​ងងិត​ក្នុង​កម្មវិធី​និពន្ធ វា​គឺ​ត្រូវបាន​ផ្ដល់​អានុសាសន៍​ឲ្យ​ប្រើ​ការ​"
"គ្រប់គ្រង​ពណ៌​នៅ​ក្នុង​របៀប​នេះ ។<p>ប្រសិន​បើ​បិទ ឯកសារ RAW ទាំងអស់​នឹង​ត្រូវបាន​អ៊ិនកូដ​ទៅ​ជា​ជម្រៅ​ពណ៌ ៨ "
"ប៊ីតដោយ​ខ្សែកោង​ហ្កាម៉ា BT.709 និង​ចំណុច​ស 99th-percentile ។ របៀប​នេះ គឺ​លឿន​ជាង​ការ​ឌិកូដ ១៦ "
"ប៊ីត ។"

#: libkdcraw/dcrawsettingswidget.cpp:202
msgid "Interpolate RGB as four colors"
msgstr "ដាក់​ចន្លោះ RGB ជា​ ៤ ពណ៌"

#: libkdcraw/dcrawsettingswidget.cpp:203
msgid ""
"<p><b>Interpolate RGB as four colors</b><p>The default is to assume that all "
"green pixels are the same. If even-row green pixels are more sensitive to "
"ultraviolet light than odd-row this difference causes a mesh pattern in the "
"output; using this option solves this problem with minimal loss of detail."
"<p>To resume, this option blurs the image a little, but it eliminates false "
"2x2 mesh patterns with VNG quality method or mazes with AHD quality method."
msgstr ""
"<p><b>កែខៃ RGB ជា​បួន​ពណ៌​</b><p>លំនាំដើម​គឺ​ត្រូវ​សន្មត់​ថា​ភីកសែល​ពណ៌​បៃតង​ទាំងអស់​គឺ​ដូចគ្នា ។ ប្រសិន​បើ​"
"ភីកសែល​​ពណ៌​បៃតងគូរ​គឺស្គាល់​​ពណ៌​ស្វាយ​ខ្ចី​ជាង​ជួរ​​សេស ភាព​ខុស​គ្នា​នេះ​បណ្ដាល​ឲ្យលំនាំដើម​ប្រទាក់គ្នា​នៅ​ក្នុង​"
"លទ្ធផល ដោយ​ប្រើ​ជម្រើស​នេះ​ដោះស្រាយ​បញ្ហា​នេះ​ដោយ​បាត់បង់​សេចក្ដី​លម្អិត​អប្បបរមា ។<p>ដើម្បី​បន្ត ជម្រើស​"
"នេះ​ធ្វើ​ឲ្យ​រូបភាព​ព្រិលៗ​បន្តិច ប៉ុន្តែ​វា​លុប​ភាព​មិន​ត្រឹមត្រូវ ២x២ លំនាំ​ប្រទាក់គ្នា​ជា​មួយ​វិធីសាស្ត្រ​គុណភាព "
"VNG ឬ​ខ្វាត់ខ្វែង​ជា​មួយ​វិធីសាស្ត្រ​គុណភាព AHD ។"

#: libkdcraw/dcrawsettingswidget.cpp:219
msgid "Visit LibRaw project website"
msgstr "ទស្សនា​តំបន់​បណ្ដាញ​គម្រោង​របស់ LibRaw"

#: libkdcraw/dcrawsettingswidget.cpp:222
msgid "Do not stretch or rotate pixels"
msgstr "កុំ​ទាញ ឬ​បង្វិល​ភីកសែល"

#: libkdcraw/dcrawsettingswidget.cpp:223
msgid ""
"<p><b>Do not stretch or rotate pixels</b><p>For Fuji Super CCD cameras, show "
"the image tilted 45 degrees. For cameras with non-square pixels, do not "
"stretch the image to its correct aspect ratio. In any case, this option "
"guarantees that each output pixel corresponds to one RAW pixel.<p>"
msgstr ""
"<p><b>កុំ​ទាញ ឬ​បង្វិល​ភីកសែល</b><p>សម្រាប់​ម៉ាស៊ីន​ថត Fuji Super CCD បង្ហាញ​រូបភាព​ដែល​ផ្អៀង ៤៥ "
"ដឺក្រេ ។ សម្រាប់​ម៉ាស៊ីន​ថត​ដែល​គមាន​ភីកសែល​ការ៉េ សូម​កុំ​ទាញ​រូបភាព​ឲ្យ​វែង​ទៅ​តាម​សមាមាត្រ​ត្រឹមត្រូវ​របស់​វា ។ "
"ក្នុង​ករណី​ណា​មួយ ជម្រើស​នេះ​ធានា​ថា ភីកសែល​ទិន្នផល​នីមួយៗ​ដូច​ទៅ​និង​ភីកសែល RAW មួយ ។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:232
msgid "Quality:"
msgstr "គុណភាព ៖"

#: libkdcraw/dcrawsettingswidget.cpp:234
msgid "Bilinear"
msgstr "ប៊ីលីនេអ៊ែរ"

#: libkdcraw/dcrawsettingswidget.cpp:235
msgid "VNG"
msgstr "VNG"

#: libkdcraw/dcrawsettingswidget.cpp:236
msgid "PPG"
msgstr "PPG"

#: libkdcraw/dcrawsettingswidget.cpp:237
msgid "AHD"
msgstr "AHD"

#: libkdcraw/dcrawsettingswidget.cpp:239
msgid ""
"<p><b>Quality (interpolation)</b><p>Select here the demosaicing RAW images "
"decoding interpolation method. A demosaicing algorithm is a digital image "
"process used to interpolate a complete image from the partial raw data "
"received from the color-filtered image sensor internal to many digital "
"cameras in form of a matrix of colored pixels. Also known as CFA "
"interpolation or color reconstruction, another common spelling is "
"demosaicing. There are 4 methods to demosaicing RAW images:<p><b>Bilinear</"
"b>: use high-speed but low-quality bilinear interpolation (default - for "
"slow computer). In this method, the red value of a non-red pixel is computed "
"as the average of the adjacent red pixels, and similar for blue and green."
"<p><b>VNG</b>: use Variable Number of Gradients interpolation. This method "
"computes gradients near the pixel of interest and uses the lower gradients "
"(representing smoother and more similar parts of the image) to make an "
"estimate.<p><b>PPG</b>: use Patterned Pixel Grouping interpolation. Pixel "
"Grouping uses assumptions about natural scenery in making estimates. It has "
"fewer color artifacts on natural images than the Variable Number of "
"Gradients method.<p><b>AHD</b>: use Adaptive Homogeneity-Directed "
"interpolation. This method selects the direction of interpolation so as to "
"maximize a homogeneity metric, thus typically minimizing color artifacts.<p>"
msgstr ""

#: libkdcraw/dcrawsettingswidget.cpp:269
msgid "Median:"
msgstr "សមឌ្ឍរេខា"

#: libkdcraw/dcrawsettingswidget.cpp:270
msgid ""
"<p><b>Median Filter</b><p>Set here the passes used by median filter applied "
"after interpolation to Red-Green and Blue-Green channels."
msgstr ""
"<p><b>តម្រង​មេដ្យាន</b><p>កំណត់​ការ​ហុច​​ដែល​បាន​ប្រើ​ដោយ​តម្រង​មេដ្យាន​ដែល​បាន​​អនុវត្ត​បន្ទាប់​ពី​ចន្លោះ​"
"ភាគ ទៅ​ឆានែល​ក្រហម-បៃតង និង​ខៀវ-​បៃតង ។"

#: libkdcraw/dcrawsettingswidget.cpp:276
msgid "Demosaicing"
msgstr ""

#: libkdcraw/dcrawsettingswidget.cpp:284
msgid "Method"
msgstr "វិធីសាស្ត្រ​"

#: libkdcraw/dcrawsettingswidget.cpp:286
msgid "Default D65"
msgstr "D65 លំនាំ​ដើម"

#: libkdcraw/dcrawsettingswidget.cpp:287
msgid "Camera"
msgstr "ម៉ាស៊ីន​ថត"

#: libkdcraw/dcrawsettingswidget.cpp:288
msgid "Automatic"
msgstr "ស្វ័យ​ប្រវត្តិ"

#: libkdcraw/dcrawsettingswidget.cpp:289
msgid "Manual"
msgstr "ដោយ​ដៃ"

#: libkdcraw/dcrawsettingswidget.cpp:291
msgid ""
"<p><b>White Balance</b><p>Configure the raw white balance :<p><b>Default "
"D65</b>: Use a standard daylight D65 white balance (dcraw defaults)"
"<p><b>Camera</b>: Use the white balance specified by the camera. If not "
"available, reverts to default neutral white balance<p><b>Automatic</b>: "
"Calculates an automatic white balance averaging the entire "
"image<p><b>Manual</b>: Set a custom temperature and green level values"
msgstr ""

#: libkdcraw/dcrawsettingswidget.cpp:304
msgid "T(K):"
msgstr "T(K) ៖"

#: libkdcraw/dcrawsettingswidget.cpp:305
msgid "<p><b>Temperature</b><p>Set here the color temperature in Kelvin."
msgstr "<p><b>សីតុណ្ហភាព</b><p>កំណត់​សីតុណ្ហភាព​ពណ៌​គិត​ជា កែវិន នៅ​ទីនេះ ។"

#: libkdcraw/dcrawsettingswidget.cpp:312
msgid "Green:"
msgstr "បៃតង ៖"

#: libkdcraw/dcrawsettingswidget.cpp:313
msgid ""
"<p>Set here the green component to set magenta color cast removal level."
msgstr ""

#: libkdcraw/dcrawsettingswidget.cpp:316
msgid "Highlights:"
msgstr "បន្លិច ៖"

#: libkdcraw/dcrawsettingswidget.cpp:318
msgid "Solid white"
msgstr "ពណ៌ស​តាន់"

#: libkdcraw/dcrawsettingswidget.cpp:319
msgid "Unclip"
msgstr "មិន​ច្រឹប"

#: libkdcraw/dcrawsettingswidget.cpp:320
msgid "Blend"
msgstr "លាយ"

#: libkdcraw/dcrawsettingswidget.cpp:321
msgid "Rebuild"
msgstr "ស្ថាបនា​​​ឡើងវិញ"

#: libkdcraw/dcrawsettingswidget.cpp:323
msgid ""
"<p><b>Highlights</b><p>Select here the highlight clipping method:<p><b>Solid "
"white</b>: clip all highlights to solid white<p><b>Unclip</b>: leave "
"highlights unclipped in various shades of pink<p><b>Blend</b>:Blend clipped "
"and unclipped values together for a gradual fade to white<p><b>Rebuild</b>: "
"reconstruct highlights using a level value"
msgstr ""
"<p><b>បន្លិច</b><p>ជ្រើស​វិធីសាស្ត្រ​កាត់​បន្លិច​ឲ្យ​ខ្លី ៖<p><b>ស​តាន់</b> ៖ កាត់​បន្លិច​ទាំងអស់​ទៅ​ជា​ពណ៌​ស​"
"តាន់<p><b>មិន​កាត់</b> ៖ ធ្វើ​ឲ្យ​បន្លិច​ដែល​មិន​បាន​កាត់​ទាំងអស់​មាន​ស្រមោល​ពណ៌​ផ្កា​ឈូក<p><b>ល្បាយ</b> "
"៖ លាយ​តម្លៃ​ដែល​កាត់ មិន​មិន​កាត់​ចូល​គ្នា​ដើម្បី​ឲ្យ​ប្ដូរ​ទៅ​ជា​ពណ៌​ស​បន្តិច​ម្ដងៗ<p><b>សង់​ឡើង​វិញ</b> ៖ សង់​"
"បន្លិច​ឡើង​វិញ​ដោយ​ប្រើ​តម្លៃ​កម្រិត"

#: libkdcraw/dcrawsettingswidget.cpp:333
msgid "Level:"
msgstr "កម្រិត ៖"

#: libkdcraw/dcrawsettingswidget.cpp:338
msgid ""
"<p><b>Level</b><p>Specify the reconstruct highlight level. Low values favor "
"whites and high values favor colors."
msgstr ""
"<p><b>កម្រិត</b><p>បញ្ជាក់​កម្រិត​បន្លិច​ការ​សង់​ឡើង​វិញ ។ តម្លៃ​ទាបខិត​ទៅ​រក​ពណ៌​ស និង​តម្លៃ​ខ្ពស់​ខិត​ទៅ​រក​ពណ៌​"
"ចម្រុះ ។"

#: libkdcraw/dcrawsettingswidget.cpp:342
msgid "Brightness:"
msgstr "ពន្លឺ ៖"

#: libkdcraw/dcrawsettingswidget.cpp:347
msgid ""
"<p><b>Brighness</b><p>Specify the brightness level of output image.The "
"default value is 1.0 (works in 8-bit mode only).<p>"
msgstr ""
"<p><b>ពន្លឺ</b><p>បញ្ជាក់​កម្រិត​ពន្លឺ​របស់​រូបភាព​ទិន្នផល ។ តម្លៃ​លំនាំ​ដើម​គឺ 1.0 (ធ្វើការ​តែ​ក្នុង​របៀប "
"៨ ប៊ីត ប៉ុណ្ណោះ) ។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:357
msgid "Black:"
msgstr "ខ្មៅ ៖"

#: libkdcraw/dcrawsettingswidget.cpp:358
msgid ""
"<p><b>Black point</b><p>Use a specific black point value to decode RAW "
"pictures. If you set this option to off, the Black Point value will be "
"automatically computed.<p>"
msgstr ""
"<p><b>ចំណុច​ខ្មៅ</b><p>ប្រើ​ចំណុច​ខ្មៅ​ជាក់លាក់​ដើម្បីឌិកូដ​រូបភាព​ដើម ។ ប្រសិន​បើ​កំណត់​ជម្រើស​ទៅ​ជា​បិទ តម្លៃ​"
"ចំណុច​ខ្មៅ​នឹង​ត្រូវ​បាន​គណនា​ដោយ​ស្វ័យ​ប្រវត្តិ ។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:366
msgid ""
"<p><b>Black point value</b><p>Specify specific black point value of the "
"output image.<p>"
msgstr "<p><b>តម្លៃ​ចំណុច​ខ្មៅ​</b><p>បញ្ជាក់​តម្លៃ​ចំណុច​ខ្មៅ​ជាក់លាក់​របស់​រូបភាព​លទ្ធផល ​​។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:369
msgid "White:"
msgstr "ស ៖"

#: libkdcraw/dcrawsettingswidget.cpp:370
msgid ""
"<p><b>White point</b><p>Use a specific white point value to decode RAW "
"pictures. If you set this option to off, the White Point value will be "
"automatically computed.<p>"
msgstr ""
"<p><b>ចំណុច​ស</b><p>ប្រើ​ចំណុច​ស​ជាក់លាក់​ដើម្បីឌិកូដ​រូបភាព​ដើម RAW ។ ប្រសិន​បើ​កំណត់​ជម្រើស​ទៅ​ជា​បិទ តម្លៃ​"
"ចំណុច​ស​នឹង​ត្រូវ​បាន​គណនា​ដោយ​ស្វ័យ​ប្រវត្តិ ។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:378
msgid ""
"<p><b>White point value</b><p>Specify specific white point value of the "
"output image.<p>"
msgstr "<p><b>តម្លៃ​ចំណុច​ស</b><p>បញ្ជាក់​តម្លៃ​ចំណុច​ស​ជាក់លាក់​របស់​រូបភាព​លទ្ធផល ​​។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:408
msgid "White Balance"
msgstr "​តុល្យភាព​ពណ៌ស"

#: libkdcraw/dcrawsettingswidget.cpp:416
msgid "Enable noise reduction"
msgstr "បើក​ការ​កាត់​បន្ថយ​ការ​រំខាន"

#: libkdcraw/dcrawsettingswidget.cpp:417
msgid ""
"<p><b>Enable Noise Reduction</b><p>Use wavelets to erase noise while "
"preserving real detail.<p>"
msgstr ""
"<p><b>អនុញ្ញាត​ការ​កាត់​បន្ថែម​ភាព​មិន​ច្បាស់</b><p>ប្រើ​រលក​ដើម្បី​លុប​ភាព​មិន​ច្បាស់ ខណៈ​រក្សា​ទុក​លម្អិត​ពិត "
"។<p>"

#: libkdcraw/dcrawsettingswidget.cpp:424
msgid "Threshold:"
msgstr "កម្រិត​ពន្លឺ​ ៖"

#: libkdcraw/dcrawsettingswidget.cpp:425
msgid ""
"<p><b>Threshold</b><p>Set here the noise reduction threshold value to use."
