#: libkdcraw/dcrawsettingswidget.cpp:396
msgid ""
"<p><b>Highlights</b><p>Select here the highlight clipping method:<p><b>Solid "
"white</b>: clip all highlights to solid white<p><b>Unclip</b>: leave "
"highlights unclipped in various shades of pink<p><b>Blend</b>:Blend clipped "
"and unclipped values together for a gradual fade to white<p><b>Rebuild</b>: "
"reconstruct highlights using a level value"
msgstr ""
"<p><b>បន្លិច</b><p>ជ្រើស​វិធីសាស្ត្រ​កាត់​បន្លិច​ឲ្យ​ខ្លី ៖<p><b>ស​តាន់</b> ៖ កាត់​បន្លិច​ទាំងអស់​ទៅ​ជា​ពណ៌​ស​"
"តាន់<p><b>មិន​កាត់</b> ៖ ធ្វើ​ឲ្យ​បន្លិច​ដែល​មិន​បាន​កាត់​ទាំងអស់​មាន​ស្រមោល​ពណ៌​ផ្កា​ឈូក<p><b>ល្បាយ</b> "
"៖ លាយ​តម្លៃ​ដែល​កាត់ មិន​មិន​កាត់​ចូល​គ្នា​ដើម្បី​ឲ្យ​ប្ដូរ​ទៅ​ជា​ពណ៌​ស​បន្តិច​ម្ដងៗ<p><b>សង់​ឡើង​វិញ</b> ៖ សង់​"
"បន្លិច​ឡើង​វិញ​ដោយ​ប្រើ​តម្លៃ​កម្រិត"

