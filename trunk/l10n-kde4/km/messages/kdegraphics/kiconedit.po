#: kiconeditslots.cpp:285
msgid ""
"The current file has been modified.\n"
"Do you want to save it?"
msgstr ""
"ឯកសារ​បច្ចុប្បន្នត្រូវ​​បាន​​កែប្រែ ។\n"
" តើ​អ្នក​ចង់​រក្សា​វា​ទុក​ឬទេ ?"

#: kiconedit.cpp:251
msgid "New &Window"
msgstr "បង្អួច​ថ្មី"

#: kiconedit.cpp:254
msgid ""
"New window\n"
"\n"
"Opens a new icon editor window."
msgstr ""
"បង្អួច​ថ្មី\n"
"\n"
"បើក​បង្អួច​កម្មវិធីនិពន្ធ​​រូបតំណាង​ថ្មី ។"

#: kiconedit.cpp:257
msgid ""
"New\n"
"\n"
"Create a new icon, either from a template or by specifying the size"
msgstr ""
"ថ្មី\n"
"\n"
"បង្កើត​រូបតំណាង​ថ្មី​មួយ ពី​ពុម្ព​មួយ ឬ ដោយ​បញ្ជាក់​ទំហំ"

#: kiconedit.cpp:261
msgid ""
"Open\n"
"\n"
"Open an existing icon"
msgstr ""
"បើក\n"
"\n"
"បើក​រូប​តំណាង​ដែល​មាន​ស្រាប់"

#: kiconedit.cpp:269
msgid ""
"Save\n"
"\n"
"Save the current icon"
msgstr ""
"រក្សា​ទុក\n"
"\n"
"រក្សាទុក​រូបតំណាង​បច្ចុប្បន្ន"

#: kiconedit.cpp:274
msgid ""
"Print\n"
"\n"
"Opens a print dialog to let you print the current icon."
msgstr ""
"បោះពុម្ព\n"
"\n"
"បើក​ប្រអប់​បោះពុម្ព ដើម្បី​អនុញ្ញាតិ​ឲ្យ​អ្នក​បោះពុម្ព​រូប​តំណាង​បច្ចុប្បន្ន ។"

#: kiconedit.cpp:282
msgid ""
"Cut\n"
"\n"
"Cut the current selection out of the icon.\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"កាត់\n"
"\n"
"កាត់​ការ​ជ្រើសរើស​បច្ចុប្បន្ន​ចេញ​ពី​រូប​តំណាង ។\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ អ្នក​អាច​ធ្វើ​ការ​ជ្រើសរើស​ជា​រង្វង់ ឬ ត្រីកោណ)"

#: kiconedit.cpp:286
msgid ""
"Copy\n"
"\n"
"Copy the current selection out of the icon.\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"ចម្លង\n"
"\n"
"ចម្លង​ការ​ជ្រើសរើស​បច្ចុប្បន្ន​ចេញ​ពី​រូប​តំណាង ។\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ អ្នក​អាច​ធ្វើការ​ជ្រើស​ជា​រង្វង់ ឬ ត្រីកោណ)"

#: kiconedit.cpp:290
msgid ""
"Paste\n"
"\n"
"Paste the contents of the clipboard into the current icon.\n"
"\n"
"If the contents are larger than the current icon you can paste them in a new "
"window.\n"
"\n"
"(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you "
"also want to paste transparency.)"
msgstr ""
"បិទភ្ជាប់\n"
"\n"
"បិទភ្ជាប់​មាតិកា​នៃ​ក្ដារ​តម្បៀត​ខ្ទាស់​ទៅ​ក្នុងរូប​តំណាង​បច្ចុប្បន្ន .\n"
"\n"
"ប្រសិន​បើ​មាតិកា​ធំ​ជាងរូប​តំណាង​បច្ចុប្បន្ន អ្នក​អាច​បិទ​ភ្ជាប់ពួក​វា​នៅ​ក្នុង​បង្អួច​ថ្មី​បាន ។\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ ជ្រើស \"បិទ​ភ្ជាប់ភីកសែល​ថ្លា\" នៅ​ក្នុង​ប្រអប់កំណត់រចនា​​សម្ព័ន្ធ ​ប្រសិនបើ​អ្នកចង់​បិទ​ភ្ជាប់​"
"ភាពថ្លា ។)"

#: kiconedit.cpp:298
msgid "Paste as &New"
msgstr "បិទ​ភ្ជាប់​ជា​ថ្មី"

#: kiconedit.cpp:307
msgid "Resi&ze..."
msgstr "ប្ដូរ​ទំហំ..."

#: kiconedit.cpp:310
msgid ""
"Resize\n"
"\n"
"Smoothly resizes the icon while trying to preserve the contents"
msgstr ""
"ប្ដូរ​ទំហំ\n"
"\n"
"ប្ដូរ​ទំហំ​រូប​តំណាង​យ៉ាង​រលូន ្នុង​ពេល​ព្យាយាម​រក្សាមាតិកា"

#: kiconedit.cpp:315
msgid "&GrayScale"
msgstr "មាត្រដ្ឋាន​ប្រផេះ"

#: kiconedit.cpp:318
msgid ""
"Gray scale\n"
"\n"
"Gray scale the current icon.\n"
"(Warning: The result is likely to contain colors not in the icon palette"
msgstr ""
"មាត្រដ្ឋាន​ប្រផេះ \n"
"\n"
"ធ្វើ​​រូប​តំណាង​បច្ចុប្បន្ន​ជា​មាត្រដ្ឋាន​ប្រផេះ ។\n"
"(ការព្រមាន ៖ លទ្ធផល​ហាក់​ដូច​ជា​មាន​ពណ៌​ដែល​មិន​នៅ​ក្នុង​ក្ដារ​លាយ​រូប​តំណាង"

#: kiconedit.cpp:325
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one."
msgstr ""
"ពង្រីក \n"
"\n"
"ពង្រីក​ម្តងមួយ ។"

#: kiconedit.cpp:329
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one."
msgstr ""
"បង្រួម\n"
"\n"
"បង្រួម​ម្ដង​មួយ ។"

#: kiconedit.cpp:333
msgid "&Zoom"
msgstr ""

#: kiconedit.cpp:337
msgid "100%"
msgstr "១០០%"

#: kiconedit.cpp:343
msgid "200%"
msgstr "២០០%"

#: kiconedit.cpp:349
msgid "500%"
msgstr "៥០០%"

#: kiconedit.cpp:355
msgid "1000%"
msgstr "១០០០%"

#: kiconedit.cpp:375
msgid "Show &Grid"
msgstr "បង្ហាញ​ក្រឡាចត្រង្គ"

#: kiconedit.cpp:378
msgid "Hide &Grid"
msgstr "លាក់​ក្រឡាចត្រង្គ"

#: kiconedit.cpp:379
msgid ""
"Show grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"បង្ហាញ​ក្រឡា​ចត្រង្គ\n"
"\n"
"បិទ​បើក​ក្រឡាចត្រង្គ​ក្នុង​ ក្រឡាចត្រង្គ បិទ/បើក នៃ​ការកែសម្រួល​រូបតំណាង"

#: kiconedit.cpp:386
msgid "Color Picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌"

#: kiconedit.cpp:390
msgid ""
"Color Picker\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"ឧបករណ៍​ជ្រើស​​ពណ៌\n"
"\n"
"ពណ៌​នៃ​ភីកសែលដែល​បាន​ចុចលើ នឹង​ជា​ពណ៌​គូរ​បច្ចុប្បន្ន"

#: kiconedit.cpp:395
msgid "Freehand"
msgstr "ធ្វើ​តាម​ចិត្ត"

#: kiconedit.cpp:399
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"ធ្វើ​តាម​ចិត្ត\n"
"\n"
"គូរ​បន្ទាប់​តាមចិត្ត"

#: kiconedit.cpp:406
msgid "Rectangle"
msgstr "ចតុកោណកែង"

#: kiconedit.cpp:410
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"ចតុកោណ\n"
"\n"
"គូរ​ចតុកោណ"

#: kiconedit.cpp:414
msgid "Filled Rectangle"
msgstr "ចតុកោណ​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:418
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"ចតុកោណ​ដែល​បាន​បំពេញ\n"
"\n"
"គូរ​ចតុកោណ​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:422
msgid "Circle"
msgstr "រង្វង់"

#: kiconedit.cpp:426
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"រង្វង់\n"
"\n"
"គូរ​រង្វង់"

#: kiconedit.cpp:430
msgid "Filled Circle"
msgstr "រង្វល់មូល​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:434
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"រង្វង់មូល​ដែល​បានបំពេញ\n"
"\n"
"គូរ​រង្វង់​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:438
msgid "Ellipse"
msgstr "ពង​ក្រពើ"

#: kiconedit.cpp:442
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"ពងក្រពើ\n"
"\n"
"គូរ​រាង​ពង​ក្រពើ"

#: kiconedit.cpp:446
msgid "Filled Ellipse"
msgstr "រាង​ពង​ក្រពដែល​បាន​បំពេញ"

#: kiconedit.cpp:450
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"​រាង​ពង​ក្រពដែល​បាន​បំពេញ\n"
"\n"
"គូរ​រាង​ពង​ក្រពើ​ដែល​បាន​បំពេញ"

#: kiconedit.cpp:454
msgid "Spray"
msgstr "ការ​បាញ់ថ្នាំ"

#: kiconedit.cpp:458
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"ការបាញ់​ថ្នាំ\n"
"\n"
"គូរ​ភីកសែល​ពង្រាយក្នុង​​ពណ៌​បច្ចុប្បន្ន"

#: kiconedit.cpp:463
msgid "Flood Fill"
msgstr "បំពេញ​ទាំងមូល"

#: kiconedit.cpp:467
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"បង្ហូរ​បំពេញ\n"
"\n"
"បំពេញ​ភីកសែល​ដែល​នៅ​ជិត​គ្នា​ជា​មួយ​ពណ៌​បច្ចុប្បន្ន"

#: kiconedit.cpp:472
msgid "Line"
msgstr "បន្ទាត់"

#: kiconedit.cpp:476
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"បន្ទាត់\n"
"\n"
"គូរ​បន្ទាត់​ត្រង់​ដោយ​បញ្ឈរ, ដោយ​ផ្ដេក ឬ មុំ ៤៥ ដឺក្រេ ។"

#: kiconedit.cpp:481
msgid "Eraser (Transparent)"
msgstr "ឧបករណ៍​លុប (ថ្លា)"

#: kiconedit.cpp:485
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"លុប\n"
"\n"
"លុប​ភីកសែល ៖ កំណត់​ភីកសែល​ទៅ​ជា​ថ្លា\n"
"\n"
"(ព័ត៌មាន​ជំនួយ ៖ ប្រសិន​បើ​អ្នក​ចង់​គូរ​ភាព​ថ្លា​ជា​មួយ​ឧបករណ៍​ផ្សេង​គ្នា , ដំបូង​ចុច​លើ \"លុប\" បន្ទាប់មក​នៅ​លើ​"
"ឧបករណ៍​ដែល​អ្នក​ចង់​ប្រើ)"

#: kiconedit.cpp:492
msgid "Rectangular Selection"
msgstr "ការ​ជ្រើស​ជា​ចតុកោណ"

#: kiconedit.cpp:496
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"ជ្រើស\n"
"\n"
"ជ្រើស​ផ្នែក​ចតុកោណ​នៃ​រូប​តំណាង​ដោយ​ប្រើ​កណ្ដុរ ។."

#: kiconedit.cpp:501
msgid "Circular Selection"
msgstr "ការ​ជ្រើស​ជា​រង្វង់"

#: kiconedit.cpp:505
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"ជ្រើស\n"
"\n"
