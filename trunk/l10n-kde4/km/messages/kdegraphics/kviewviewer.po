msgid "Zoom In"
msgstr "ពង្រីក"

#: kviewviewer.cpp:480
msgid "Zoom Out"
msgstr "បង្រួម"

#: kviewviewer.cpp:490
msgid "&Flip"
msgstr "ត្រឡប់"

#: kviewviewer.cpp:491
msgid "&Vertical"
msgstr "បញ្ឈរ"

#: kviewviewer.cpp:492
msgid "&Horizontal"
msgstr "ផ្ដេក"

#: kviewviewer.cpp:496
msgid "Ro&tate Counter-Clockwise"
msgstr "បង្វិល​បញ្ច្រាស​ទ្រនិច​នាឡិកា"

#: kviewviewer.cpp:498
msgid "Rotate Clockwise"
msgstr "បង្វិល​ស្រប​ទ្រិចនាឡិកា​"

#: kviewviewer.cpp:504
msgid "Fit Image to Window"
msgstr "ធ្វើ​ឲ្យ​រូបភាព​សម​ទៅ​និង​បង្អួច"

#: kviewviewer.cpp:527
msgid "Show Scrollbars"
msgstr "បង្ហាញ​របារមូរ​"

#: kviewviewer.cpp:529
msgid "Hide Scrollbars"
msgstr "លាក់​របារមូរ"

#: kviewviewer.cpp:767
msgid "Save Image As..."
msgstr "រក្សាទុក​រូបភាព​ជា​​..."

#: kviewviewer.cpp:816
#, qt-format
msgid "Load changed image? - %1"
msgstr "ផ្ទុក​រូបភាព​ដែល​បានផ្លាស់ប្តូរ​ឬ ? - %1"

#: kviewviewer.cpp:818
#, qt-format
msgid ""
"The image %1 which you have modified has changed on disk.\n"
"Do you want to reload the file and lose your changes?\n"
"If you don't and subsequently save the image, you will lose the\n"
"changes that have already been saved."
msgstr ""
"រូបភាព​ %1 ដែល​អ្នកបាន​កែប្រែ​បាន​ផ្លាស់ប្តូរ​លើ​ថាស​ ។ \n"
"តើ​អ្នក​ចង់​ផ្ទុក​ឯកសារ​ឡើង​វិញ ហើយ​បាត់បង់​ការផ្លាស់ប្តូរ​របស់អ្នក​ឬ ?\n"
"បើ​អ្នក​មិន​ចង់​ទេ ត្រូវ​រក្សារូបភាព​ទុក​ជាបន្តបន្ទាប់​ អ្នក​នឹង បាត់បង់​\n"
"ការផ្លាស់ប្តូដែល​បាន​រក្សាទុក​រួចហើយ​ ។​"

#: kviewviewer.cpp:828
msgid "Do Not Reload"
msgstr "កុំ​ផ្ទុក​ឡើង​វិញ"

#: kviewviewer.cpp:885
