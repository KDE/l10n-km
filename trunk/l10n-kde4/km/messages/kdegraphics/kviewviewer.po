msgstr "(រក្សាសិទ្ធ​) ១៩៩៧-២០០២ អ្នក​អភិវឌ្ឍ​ន៍ KView"

#: kviewviewer.cpp:186
msgid "Maintainer"
msgstr "អ្នក​ថែទាំ"

#: kviewviewer.cpp:187
