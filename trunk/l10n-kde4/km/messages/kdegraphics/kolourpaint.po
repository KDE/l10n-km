msgstr "មិន​អាច​រក្សាទុក​រូបភាព​បាន​ឡើយ - ព័ត៌មាន​មិន​គ្រប់គ្រាន់​ឡើយ ។"

#: document/kpDocument_Save.cpp:92
msgid "<empty>"
msgstr "<ទទេ>"

#: document/kpDocument_Save.cpp:88
#, qt-format
msgid ""
"URL: %1\n"
"Mimetype: %2"
msgstr ""
"URL ៖ %1\n"
"Mimetype ៖ %2"

#: document/kpDocument_Save.cpp:94
msgid "Internal Error"
msgstr "កំហុស​ខាងក្នុង"

#: document/kpDocument_Save.cpp:127
#, qt-format
msgid ""
"<qt><p>The <b>%1</b> format may not be able to preserve all of the image's "
"color information.</p><p>Are you sure you want to save in this format?</p></"
"qt>"
msgstr ""
"<qt><p>ទ្រង់ទ្រាយ <b>%1</b> ប្រហែល​ជា​មិន​អាចរក្សា​ព័ត៌មាន​អំពី​ពណ៌​ទាំងអស់​របស់​រូបភាព​បាន​ឡើយ ។</"
"p><p>តើ​អ្នក​ពិត​ជា​ចង់​រក្សាទុក​ក្នុង​ទ្រង់ទ្រាយ​នេះ​ឬ ?</p></qt>"

#: document/kpDocument_Save.cpp:134
msgid "Lossy File Format"
msgstr "ទ្រង់ទ្រាយ​ឯកសារ​ដែល​បាត់បង់"

#: document/kpDocument_Save.cpp:142
#, qt-format
msgid ""
"<qt><p>Saving the image at the low color depth of %1-bit may result in the "
"loss of color information. Any transparency will also be removed.</p><p>Are "
"you sure you want to save at this color depth?</p></qt>"
msgstr ""
"<qt><p>ការ​រក្សាទុក​រូបភាព​ត្រឹម​ជម្រៅ​ពណ៌ %1-ប៊ីត អាច​នឹង​បណ្ដាល​ឲ្យ​បាត់បង់​ព័ត៌មាន​អំពី​ពណ៌ ។ ភាព​ថ្លា​នានា​ក៏​"
"នឹង​ត្រូវ​បាន​យកចេញ​ផង​ដែរ ។</p><p>តើ​អ្នក​ពិត​ជា​ចង់​រក្សាទុក​ត្រឹម​ជម្រៅ​ពណ៌​នេះ​ឬ ?</p></qt>"

#: document/kpDocument_Save.cpp:149
msgid "Low Color Depth"
msgstr "ជម្រៅ​ពណ៌​ទាប"

#: document/kpDocument_Save.cpp:281
#, qt-format
msgid ""
"A document called \"%1\" already exists.\n"
"Do you want to overwrite it?"
msgstr ""
"មាន​ឯកសារ​ដែល​មាន​ឈ្មោះ \"%1\" រួច​ហើយ ។\n"
"តើ​អ្នក​ចង់​សរសេរ​ជាន់​លើ​វា​ឬ​ទេ ?"

#: document/kpDocument_Save.cpp:285
msgid "Overwrite"
msgstr "សរសេរ​ជាន់​លើ"

#: document/kpDocument_Save.cpp:317
msgid "Could not save image - unable to create temporary file."
msgstr "មិន​អាច​រក្សាទុក​រូបភាព​បាន​ឡើយ - មិន​អាច​បង្កើត​ឯកសារ​បណ្ដោះអាសន្ន ។"

#: document/kpDocument_Save.cpp:352
#, qt-format
msgid "Could not save as \"%1\"."
msgstr "មិន​អាច​រក្សាទុក​ជា \"%1\" បាន​ឡើយ ។"

#: document/kpDocument_Save.cpp:367
msgid "Could not save image - failed to upload."
msgstr "មិន​អាច​រក្សាទុក​រូបភាព​បាន​ឡើយ - មិន​អាច​ផ្ទុក​ឡើង ។"

#: document/kpDocument_Open.cpp:95
#, qt-format
msgid "Could not open \"%1\"."
msgstr "មិន​អាច​បើក \"%1\" បាន​ឡើយ ។"

#: document/kpDocument_Open.cpp:127
#, qt-format
msgid "Could not open \"%1\" - unknown mimetype."
msgstr "មិន​អាច​បើក \"%1\" បាន​ឡើយ - មិន​ស្គាល់ mimetype ។"

#: document/kpDocument_Open.cpp:138
#, qt-format
msgid ""
"Could not open \"%1\" - unsupported image format.\n"
"The file may be corrupt."
msgstr ""
"មិន​អាច​បើក \"%1\" បាន​ឡើយ - មិន​គាំទ្រ​ទ្រង់ទ្រាយ​រូបភាព​ប្រភេទ​នោះ​ឡើយ ។\n"
"ឯកសារ​អាច​នឹង​ខូច ។"

#: document/kpDocument_Open.cpp:199
#, qt-format
msgid ""
"The image \"%1\" may have more colors than the current screen mode. In order "
"to display it, some colors may be changed. Try increasing your screen depth "
"to at least %2bpp.\n"
"It also contains translucency which is not fully supported. The translucency "
"data will be approximated with a 1-bit transparency mask."
msgstr ""
"រូបភាព \"%1\" អាច​នឹង​មាន​ចំនួន​ពណ៌​ច្រើន​ជាង​របៀប​អេក្រង់​បច្ចុប្បន្ន ។ ដើម្បី​អាច​បង្ហាញ​វា ពណ៌​មួយ​ចំនួន​អាច​"
"នឹង​ត្រូវ​បាន​ផ្លាស់ប្ដូរ ។ សូម​ព្យាយាម​បង្កើន​ជម្រៅ​អេក្រង់​របស់​អ្នក យ៉ាង​ហោច​ណាស់​ត្រឹម %2bpp ។\n"
"រូបភាព​នេះ​ក៏​មាន​ភាព​ថ្លា​ផង​ដែរ ដែល​មិន​ត្រូវ​បាន​គាំទ្រ​បាន​ពេញលេញ​ឡើយ ។ ទិន្នន័យ​អំពី​ភាព​ថ្លា នឹង​ត្រូវ​បាន​"
"ប៉ាន់ប្រមាណ​ជាមួយ​នឹង​របាំង​ថ្លា ១ប៊ីត ។"

#: document/kpDocument_Open.cpp:210
#, qt-format
msgid ""
"The image \"%1\" may have more colors than the current screen mode. In order "
"to display it, some colors may be changed. Try increasing your screen depth "
"to at least %2bpp."
msgstr ""
"រូបភាព \"%1\" អាច​នឹង​មាន​ចំនួន​ពណ៌​ច្រើន​ជាង​របៀប​អេក្រង់​បច្ចុប្បន្ន ។ ដើម្បី​អាច​បង្ហាញ​វា ពណ៌​មួយ​ចំនួន​អាច​"
"នឹង​ត្រូវ​បាន​ផ្លាស់ប្ដូរ ។ សូម​ព្យាយាម​បង្កើន​ជម្រៅ​អេក្រង់​របស់​អ្នក យ៉ាង​ហោច​ណាស់​ត្រឹម %2bpp ។"

#: document/kpDocument_Open.cpp:215
#, qt-format
msgid ""
"The image \"%1\" contains translucency which is not fully supported. The "
"translucency data will be approximated with a 1-bit transparency mask."
msgstr ""
"រូបភាព \"%1\" ក៏​មាន​ភាព​ថ្លា​ផង​ដែរ ដែល​មិន​ត្រូវ​បាន​គាំទ្រ​បាន​ពេញលេញ​ឡើយ ។ ទិន្នន័យ​អំពី​ភាព​ថ្លា នឹង​"
"ត្រូវ​បាន​ប៉ាន់ប្រមាណ​ជាមួយ​នឹង​របាំង​ថ្លា ១ប៊ីត ។"

#: document/kpDocument_Open.cpp:261
#, qt-format
msgid "Could not open \"%1\" - out of graphics memory."
msgstr "មិន​អាច​បើក \"%1\" បាន​ឡើយ - អស់​សតិ​ក្រាហ្វិក​ហើយ ។"

#: kpviewscrollablecontainer.cpp:156 kpviewscrollablecontainer.cpp:920
#: kpviewscrollablecontainer.cpp:926 kpviewscrollablecontainer.cpp:932
msgid "Left drag the handle to resize the image."
msgstr "អូស​កណ្ដុរ​ឆ្វេង​លើ​ចំណុច​ទាញ ដើម្បី​ប្ដូរ​ទំហំ​រូបភាព ។"

#: kpviewscrollablecontainer.cpp:219
msgid "Resize Image: Let go of all the mouse buttons."
msgstr "ប្ដូរ​ទំហំ​រូបភាព ៖ ប្រើ​ប៊ូតុង​កណ្ដុរ​ទាំងអស់ ។"

#: kpviewscrollablecontainer.cpp:249
msgid "Resize Image: Right click to cancel."
msgstr "ប្ដូរ​ទំហំ​រូបភាព ៖ ចុច​កណ្ដុរ​ស្ដាំ ដើម្បី​បោះបង់ ។"

