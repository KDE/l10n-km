#: ksane_viewer.cpp:90 ksane_widget.cpp:177
msgid "Zoom In"
msgstr "ពង្រីក"

#: ksane_viewer.cpp:93 ksane_widget.cpp:180
msgid "Zoom Out"
msgstr "បង្រួម"

#: ksane_viewer.cpp:96 ksane_widget.cpp:183
msgid "Zoom to Selection"
msgstr "ពង្រីក​តាម​ការ​ជ្រើស"

#: ksane_viewer.cpp:99 ksane_widget.cpp:186
msgid "Zoom to Fit"
msgstr "ពង្រីក​ឲ្យ​សម"

#: ksane_widget.cpp:100
#, kde-format
msgid "Authentication required for: %1"
msgstr ""

#: ksane_widget.cpp:189
msgid "The lamp is warming up!"
msgstr "អំពូល​កំពុង​កំដៅ !"

#: ksane_widget.cpp:202
msgid "Cancel current scan operation"
msgstr "បោះបង់​ប្រតិបត្តិ​ស្កេន​បច្ចុប្បន្ន"

#: ksane_widget.cpp:207
msgid "Scan Preview Image"
msgstr "ស្កេន​រូបភាព​មើលជា​មុន"

#: ksane_widget.cpp:208
msgctxt "Preview button text"
msgid "Preview"
msgstr "មើល​ជាមុន"

#: ksane_widget.cpp:211
msgid "Scan Final Image"
msgstr "ស្កេន​រូបភាព​ចុងក្រោយ"

#: ksane_widget.cpp:212
msgctxt "Final scan button text"
msgid "Scan"
msgstr "ស្កេន"

#: ksane_widget.cpp:250
msgid "Basic Options"
msgstr "ជម្រើស​មូលដ្ឋាន"

#: ksane_widget.cpp:256
msgid "Other Options"
msgstr "ជ្រើស​ផ្សេងៗ"

#: ksane_widget.cpp:294
msgid "No scanner device has been found."
msgstr "រក​មិន​ឃើញ​ឧបករណ៍​ម៉ាស៊ីន​ស្កេន ។"

#: ksane_widget.cpp:305
msgid "Select Scanner"
msgstr "ជ្រើស​ម៉ាស៊ីន​ស្កេន"

#: ksane_widget.cpp:472 ksane_widget.cpp:512
msgid ""
"The image data contained 16 bits per color, but the color depth has been "
"truncated to 8 bits per color."
msgstr "ទិន្នន័យ​រូបភាព​មាន​ ១៦ ប៊ីត​/ពណ៌ ប៉ុន្តែ​ជម្រៅ​ពណ៌​ត្រូវ​បានកាត់​ឲ្យ​ខ្លី​ទៅ ៨ ប៊ីត/ពណ៌ ។"

#: ksane_widget_private.cpp:314
msgid "Separate color intensity tables"
msgstr "តារាង​អាំងតង់ស៊ីតេ​ពណ៌​ដោយ​ឡែក"

#: ksane_widget_private.cpp:1211 ksane_widget_private.cpp:1299
msgid "The image format is not (yet?) supported by libksane!"
msgstr "ទ្រង់ទ្រាយ​រូបផាព​មិន​ត្រូវបាន​គាំទ្រ​ដោយ libksane នៅ​ឡើយ​ទេ !"

