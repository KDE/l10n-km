#: solid-action-edit.cpp:76
msgid ""
"It appears that the device conditions for this action are not valid. \n"
"If you previously used this utility to make changes, please revert them and "
"file a bug"
msgstr ""
"វា​បង្ហាញ​ថា លក្ខខណ្ឌ​ឧបករណ៍​​សម្រាប់​សកម្មភា​ព​នេះ​មិន​ត្រឹមត្រូវ​ទេ ។ \n"
"ប្រសិនបើ​អ្នក​បាន​ប្រើ​ឧបករណ៍​នេះ​ពីមុន​ដើម្បីផ្លាស់ប្ដូរ សូម​បញ្ច្រាស​ពួកវា ហើយ​រៀបចំ​កំហុស"

#: solid-action-edit.cpp:76
msgid "Error parsing device conditions"
msgstr "កំហុស​ក្នុងការ​ញែក​លក្ខខណ្ឌ​ឧបករណ៍"

#: solid-action-edit.cpp:210
msgid "Any of the contained conditions must match"
msgstr "លក្ខខណ្ឌ​ណាមួយ​ខាងក្រោម​ត្រូវ​តែ​ផ្គូផ្គង"

#: solid-action-edit.cpp:212
msgid "All of the contained conditions must match"
msgstr "លក្ខខណ្ឌ​ទាំង​អស់​ខាង​ក្រោម​ត្រូវ​តែ​ផ្គូផ្គង"

#: solid-action-edit.cpp:216
#, kde-format
msgid "The device must be of the type %1"
msgstr "ឧបករណ៍​ត្រូវ​តែ​ជា​ប្រភេទ​ %1"

#: solid-action-edit.cpp:218
#, kde-format
msgid "The devices property %1 must equal %2"
msgstr "លក្ខណៈ​សម្បត្តិ​ឧបករណ៍​ %1 ត្រូវ​តែ​ស្មើ %2"

#: solid-action-edit.cpp:220
#, kde-format
msgid "The devices property %1 must not equal %2"
msgstr "លក្ខណៈ​សម្បត្តិ​ឧបករណ៍​ %1 ត្រូវ​តែ​មិនស្មើ​គ្នា %2"

