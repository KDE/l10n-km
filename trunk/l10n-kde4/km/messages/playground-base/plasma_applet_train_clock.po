#. i18n: file: clockConfig.ui:46
#. i18n: ectx: attribute (title), widget (QWidget, AppearanceTab)
#: clock.cpp:203 rc.cpp:3
msgid "Appearance"
msgstr "រូបរាង"

#: clock.cpp:772
msgid "The train-clock SVG file was not found"
msgstr "រក​មិន​ឃើញ​ឯកសារ SVG"

#: clock.cpp:791
msgid "The train-clock SVG file has no element e0-p1"
msgstr "ឯកសារ​ SVG គ្មាន​ធាតុ e0-p1"

#. i18n: file: clockConfig.ui:52
#. i18n: ectx: property (text), widget (QCheckBox, showDate)
#: rc.cpp:6
msgid "Show &date"
msgstr "បង្ហាញ​កាលបរិច្ឆេទ"

#. i18n: file: clockConfig.ui:75
#. i18n: ectx: property (text), widget (QCheckBox, showDay)
#: rc.cpp:9
msgid "Show day of the &week"
msgstr "បង្ហាញ​ថ្ងៃ​នៃ​សប្ដាហ៍"

#. i18n: file: clockConfig.ui:85
#. i18n: ectx: property (text), widget (QCheckBox, showYear)
#: rc.cpp:12
msgid "Show &year"
msgstr "បង្ហាញ​ឆ្នាំ"

#. i18n: file: clockConfig.ui:92
#. i18n: ectx: property (text), widget (QCheckBox, showTimezone)
#: rc.cpp:15
msgid "Show &timezone"
msgstr "បង្ហាញ​តំបន់​ពេលវេលា"

#. i18n: file: clockConfig.ui:99
#. i18n: ectx: property (text), widget (QCheckBox, twentyFour)
#: rc.cpp:18
msgid "24-hour format"
msgstr "ទ្រង់ទ្រាយ ២៤ ម៉ោង"

#. i18n: file: clockConfig.ui:128
#. i18n: ectx: attribute (title), widget (QWidget, TimezonesTab)
#: rc.cpp:21
msgid "Timezones"
msgstr "តំបន់​ពេលវេលា"

#. i18n: file: clockConfig.ui:134
#. i18n: ectx: property (text), widget (QCheckBox, localTimeZone)
#: rc.cpp:24
msgid "Use &local timezone"
msgstr "ប្រើ​តំបន់​ពេលវេលា​មូលដ្ឋាន"

