#. i18n: file: uiMain.ui:377
#. i18n: ectx: property (text), widget (QLabel, TlPasswordReq)
#: rc.cpp:66
msgid ""
"This quiz has been protected by a password.\n"
"In order to continue, please enter the password below."
msgstr ""
"​សំណួរ​នេះ​ត្រូវ​​បានការពារ​ដោយ​ពាក្យ​សម្ងាត់ ។\n"
"ដើម្បី​បន្ត សូម​បញ្ចូល​ពាក្យ​សម្ងាត់​ខាងក្រោម ។"

