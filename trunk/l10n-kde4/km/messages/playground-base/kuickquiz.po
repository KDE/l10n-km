#. i18n: file: uiMain.ui:93
#. i18n: ectx: property (text), widget (QTableWidget, TwQuestionList)
#: kuickquiz.cpp:69 rc.cpp:21
msgid "Question"
msgstr "សំណួរ"

#: kuickquiz.cpp:161 kuickquiz.cpp:319
msgid "Incorrect password"
msgstr "ពាក្យសម្ងាត់​មិនត្រឹមត្រូវ"

#: kuickquiz.cpp:161
msgid "The password you have supplied was incorrect. Please try again."
msgstr "ពាក្យ​សម្ងាត់​ដែល​អ្នក​បានផ្ដល់​មិនត្រឹមត្រូវ​ទេ ។ សូមព្យាយាម​ម្ដង​ទៀត ។"

#: kuickquiz.cpp:319
msgid "A supplied password did not match."
msgstr "ពាក្យ​សម្ងាត់​ដែល​បានផ្ដល់​មិនផ្គូផ្គង​ទេ ។"

#: kuickquiz.cpp:319
msgid ""
"Either the new passwords do not match, or the old password was incorrect."
msgstr "​ពាក្យ​សម្ងាត់​ថ្មី​មិន​ផ្គូផ្គង ឬ​ពាក្យ​សម្ងាត់​ចាស់​មិនត្រឹមត្រូវ ។"

#: kuickquiz.cpp:340
#, kde-format
msgid "Quiz for %1"
msgstr "សំណួរ​សម្រាប់ %1"

#: kuickquiz.cpp:342
msgid "No quiz name has been specified"
msgstr "គ្មានឈ្មោះសំណួរ​ត្រូវ​បាន​បញ្ជាក់​ទេ"

#: kuickquiz.cpp:346
msgid "The quiz cannot be done because no questions exist."
msgstr "សំណួរ​មិនអាច​ត្រូវ​បានធ្វើ​​ដោយ​សារ​តែ​គ្មាន​សំណួរ"

#: kuickquiz.cpp:349
msgid "Do this quiz"
msgstr "ធ្វើ​សំណួរ​នេះ"

#: kuickquiz.cpp:355
msgid ""
"No scores have been entered yet.\n"
"Do the quiz to receive some results."
msgstr ""
"គ្មាន​ពិន្ទុ​ត្រូវ​បានបញ្ចូល​នៅ​ឡើយ​ទេ ។\n"
"ធ្វើ​សំណួរ​ដើម្បីទទួល​បានលទ្ធផល ។"

#: kuickquiz.cpp:366
#, kde-format
msgid "Position %2 : 1 point scored by %3 \n"
msgid_plural "Position %2 : %1 points scored by %3 \n"
msgstr[0] "ទីតាំង %2 ៖ បានដាក់ពិន្ទុ  %1 ដោយ %3 \n"

#: kuickquiz.cpp:388
#, kde-format
msgid "You scored 1 point from a total of %2"
msgid_plural "You scored %1 points from a total of %2"
msgstr[0] "អ្នក​បាន​ដាក់​ពិន្ទុ %1 ពី​ពិន្ទុ​សរុប %2"

#: kuickquiz.cpp:389
msgid "Your name here"
msgstr "ឈ្មោះ​របស់​អ្នក​នៅ​ទីនេះ"

#: quizfinish.cpp:36
msgid "Submit result"
msgstr "ដាក់ស្នើ​លទ្ធផល"

#: quizfinish.cpp:37
msgid "Skip submitting"
msgstr "រំលង​ការ​ដាក់ស្នើ"

#: quizfinish.cpp:38
msgid "Congratulations on completing the quiz!"
msgstr "សូមអបអរសាទរចំពោះ​ការ​បញ្ចប់​សំណួរ !"

#: quizquestion.cpp:27
msgid "Next Question"
msgstr "សំណួរ​បន្ទាប់"

#: quizquestion.cpp:28
msgid "Abort Quiz"
msgstr "បោះបង់​សំណួរ"

#: quizsplash.cpp:39
msgid "Top 5 scores"
msgstr "ពិន្ទុ ៥ ខ្ពស់"

