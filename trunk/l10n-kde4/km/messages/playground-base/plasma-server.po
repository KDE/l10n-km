#: main.cpp:49
#, kde-format
msgid "Run Plasma widgets in their own window"
msgstr "ដំណើរការ​ធាតុក្រាហ្វិក​ប្លាស្មា​នៅ​ក្នុង​បង្អួច​ផ្ទាល់​របស់​ពួកវា"

#: main.cpp:100
#, kde-format
msgid "No description available"
msgstr "មិនមាន​សេចក្ដី​ពណ៌នា​ទេ"

#: main.cpp:117
#, kde-format
msgid "Plasma Widget Viewer"
msgstr "កម្មវិធី​មើល​ធាតុក្រាហ្វិក​ប្លាស្មា"

#: main.cpp:119
#, kde-format
msgid "2007-2008, Frerich Raabe"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៧-២០០៨ ដោយ Frerich Raabe"

#: main.cpp:121
#, kde-format
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:122
#, kde-format
msgid "Original author"
msgstr "អ្នក​និពន្ធ​ដើម"

#: main.cpp:128
#, kde-format
msgid "Displays a list of known applets"
msgstr "បង្ហាញ​បញ្ជី​អាប់ភ្លេត​ដែល​ស្គាល់"

#: main.cpp:129
#, kde-format
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"ឈ្មោះ​អាប់ភ្លេត​ត្រូវ​មើល អាច​យោង​តាម​ឈ្មោះកម្មវិធី​ជំនួយ ឬ​ផ្លូវ (ផ្លូវ​ពេញលេញ ឬ​ទាក់ទង) ទៅ​កញ្ចប់ ។ "
"ប្រសិនបើ​មិន​បានផ្ដល់​ទេ នោះ​ការ​ប៉ុនប៉ង​ត្រូវ​ផ្ទុក​កញ្ចប់​ពី​ថត​បច្ចុប្បន្ន ។"

#: main.cpp:132
#, kde-format
msgid "Optional arguments of the applet to share"
msgstr "អាគុម៉ង់​ជម្រើស​របស់​អាប់​ភ្លេត​ត្រូវ​ចែករំលែក"

#: main.cpp:133
#, kde-format
msgid "List zeroconf announced remote widgets"
msgstr "រាយ zeroconf ដែលបាន​ប្រកាស​ធាតុក្រាហ្វិក​ពី​ចម្ងាយ"
