#: lock/autologout.cc:44
msgid "<qt><nobr><b>Automatic Log Out</b></nobr></qt>"
msgstr "<qt><nobr><b>ចេញ​ដោយ​ស្វ័យប្រវត្តិ</b></nobr></qt>"

#: lock/autologout.cc:45
msgid ""
"<qt>To prevent being logged out, resume using this session by moving the "
"mouse or pressing a key.</qt>"
msgstr "<qt>ដើម្បី​ទប់ស្កាត់​ការ​ចេញ បន្ដ​ប្រើ​សម័យ​ដោយ​ផ្លាស់​ទី​កណ្ដុរ ឬ ចុច​គ្រាប់​ចុច​មួយ ។</qt>"

#: lock/autologout.cc:50
msgid "Time Remaining:"
msgstr "ពេលវេលា​នៅ​សល់ ៖"

#: lock/autologout.cc:86
#, kde-format
msgid "<qt><nobr>You will be automatically logged out in 1 second</nobr></qt>"
msgid_plural "<qt><nobr>You will be automatically logged out in %1 seconds</nobr></qt>"
msgstr[0] "<qt><nobr>អ្នក​នឹង​ត្រូវ​បាន​ចេញ​ដោយ​ស្វ័យប្រវត្តិ​ក្នុង​រយៈ​ពេល %1 វិនាទី</nobr></qt>"

#: lock/main.cc:60
msgid "KRunner Locker"
msgstr "កម្មវិធី​ចាក់សោ KRunner"

#: lock/main.cc:60
msgid "Session Locker for KRunner"
msgstr "កម្មវិធី​ចាក់សោ​សម័យ​សម្រាប់ KRunner"

#: lock/main.cc:63
msgid "Force session locking"
msgstr "បង្ខំ​សម័យ​ឲ្យ​ចាក់​សោ"

#: lock/main.cc:64
msgid "Only start screensaver"
msgstr "ចាប់​ផ្ដើម​តែធាតុ​រក្សា​អេក្រង់​"

#: lock/main.cc:65
msgid "Only use the blank screensaver"
msgstr "ប្រើ​តែ​ធាតុ​រក្សា​អេក្រង់​ទទេប៉ុណ្ណោះ"

#: lock/lockprocess.cc:741
msgid "Will not lock the session, as unlocking would be impossible:\n"
msgstr "នឹង​មិន​ចាក់​សោ​សម័យ ព្រោះថា​ការ​ដោះសោ​នឹង​មិន​អាច​ធ្វើ​ទៅបាន ៖\n"

#: lock/lockprocess.cc:745
msgid "Cannot start <i>kcheckpass</i>."
msgstr "មិន​អាច​ចាប់​ផ្ដើម <i>kcheckpass</i> ។"

#: lock/lockprocess.cc:746
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not setuid root."
msgstr "<i>kcheckpass</i> មិន​អាច​ប្រតិបត្តិ​បាន​ទេ ។ ប្រហែល​ជា​វា​មិនមែន​ជា setuid root ។"

#: lock/lockprocess.cc:789
msgid "No appropriate greeter plugin configured."
msgstr "គ្មាន​កម្មវិធី​ជំនួយ​វន្ទនាការ​សមរម្យ ត្រូវបាន​កំណត់​រចនាសម្ព័ន្ធ ។"

#: lock/lockdlg.cc:98
msgid "<nobr><b>The session is locked</b></nobr><br />"
msgstr "<nobr><b>សម័យ​ត្រូវ​បាន​ចាក់សោ</b></nobr><br />"

#: lock/lockdlg.cc:99
#, kde-format
msgid "<nobr><b>The session was locked by %1</b></nobr><br />"
msgstr "សម័យ​ត្រូវ​បាន​ចាក់សោ​ដោយ​ %1"

#: lock/lockdlg.cc:110
msgid "Unl&ock"
msgstr "ដោះសោ"

#: lock/lockdlg.cc:112
msgid "Sw&itch User..."
msgstr "ប្ដូរ​អ្នក​ប្រើ..."

#: lock/lockdlg.cc:183
msgid "<b>Unlocking failed</b>"
msgstr "<b>ការ​ដោះ​សោ​បាន​បរាជ័យ</b>"

#: lock/lockdlg.cc:189
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>ព្រមាន ៖ ប្តូរ​ជាប់​បាន​បើក​ហើយ</b>"

#: lock/lockdlg.cc:421
#, kde-format
msgid ""
"Cannot unlock the session because the authentication system failed to work;\n"
"you must kill krunner_lock (pid %1) manually."
msgstr ""
"មិនអាច​ដោះសោ​សម័យ​ពីព្រោះ​ប្រព័ន្ធ​ផ្ទៀងផ្ទាត់​បរាជ័យ​នឹង​ដំណើរការ ។\n"
"អ្នក​ត្រូវ​សម្លាប់​ krunner_lock (pid %1) ដោយ​ដៃ ។"

#: lock/lockdlg.cc:535
#, kde-format
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one.<br />The current session will be hidden and a new login screen "
"will be displayed.<br />An F-key is assigned to each session; F%1 is usually "
"assigned to the first session, F%2 to the second session and so on. You can "
"switch between sessions by pressing Ctrl, Alt and the appropriate F-key at "
"the same time. Additionally, the KDE Panel and Desktop menus have actions "
"for switching between sessions."
msgstr ""
"អ្នក​បាន​ជ្រើសរើស​យក​បើកសម័យ​ផ្ទៃតុ​ជំនួស​ឲ្យ​ការបន្តផ្ទៃតុ​បច្ចុប្បន្ន ។ <br/>សម័យ​បច្ចុប្បន្ន​នឹង​លាក់ ហើយ​"
"អេក្រង់​ចូល​ថ្មី​នឹង​បង្ហាញ​ឡើង ។<br/>គ្រាប់ចុច F ត្រូវ​បាន​ផ្ទេរ​ទៅ​ឲ្យ​សម័យ​និមួយៗ F%1 ជា​ធម្មតា​ត្រូវ​បាន​"
"ផ្ទេរ​ទៅ​ឲ្យ​សម័យ​ដំបូង F%2 ត្រូវ​ផ្ទេរទៅ​ឲ្យ​សម័យ​"

