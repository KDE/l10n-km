#: main.cpp:28
#, kde-format
msgid "Shell used to load Plasma widgets as stand-alone applications."
msgstr "សែល​បាន​ប្រើ​ ដើម្បី​ផ្ទុក​ធាតុក្រាហ្វិក​ប្លាស្មា​ជា​កម្មវិធី​ឈរ​តែ​​មួយ ។"

#: main.cpp:34
#, kde-format
msgid "Plasma Widgets shell"
msgstr "សែល​ធាតុក្រាហ្វិក​ប្លាស្មា"

#: main.cpp:36
#, kde-format
msgid "Copyright 2006-2009, The KDE Team"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ​២០០៦-២០០៩ ដោយ​ក្រុម KDE"

#: main.cpp:37
#, kde-format
msgid "Marco Martin"
msgstr "Marco Martin"

#: main.cpp:38
#, kde-format
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង​អ្នក​ថែទាំ"

#: main.cpp:44
#, kde-format
msgid "Show window decorations around the widget"
msgstr "បង្ហាញ​ការ​តុបតែង​បង្អួច​ជុំវិញ​ធាតុក្រាហ្វិក"

#: main.cpp:45
#, kde-format
msgid "Do not show window decorations around the widget"
msgstr "កុំ​បង្ហាញ​ការ​តុបតែង​បង្អួច​ជុំវិញ​ធាតុ​ក្រាហ្វិក"

#: main.cpp:47
#, kde-format
msgid "Display the widget fullscreen"
msgstr "បង្ហាញ​ធាតុក្រាហ្វិក​ពេញ​អេក្រង់"

#: main.cpp:48
#, kde-format
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"ឈ្មោះ​អាប់ភ្លេត​ត្រូ​វមើល អាច​យោង​លើ​ឈ្មោះ​កម្មវិធី​ជំនួយ ឬ​ផ្លូវ (ផ្លូវ​ពេញលេញ ឬ​ទាក់ទង) ទៅ​កញ្ចប់ ។ ប្រសិន​"
"បើ​មិន​បាន​ផ្ដល់​ទេ នោះ​ការ​ប៉ុនប៉ង​ត្រូវ​ផ្ទុក​កញ្ចប់​ពី​ថត​បច្ចុប្បន្ន ។"

#: main.cpp:51
#, kde-format
msgid "Optional arguments for the applet to add"
msgstr "អាគុយម៉ង​អុបទិក​សម្រាប់​អាប់ភ្លេត​ត្រូវ​បន្ថែម"
