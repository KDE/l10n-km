#: emailmessage/emailwidget.cpp:401
msgid "Unknown Sender"
msgstr "មិន​ស្គាល់​អ្នក​ផ្ញើ"

#: emailmessage/emailwidget.cpp:539 emailnotifier/emailwidget.cpp:530
msgctxt "flag new"
msgid "Message is marked as New, click to mark as Read"
msgstr "សារ​ត្រូវ​បាន​សម្គាល់​ថា​ថ្មី ចុច​ដើម្បី​សម្គាល់​ថា​អាន​រួច"

#: emailmessage/emailwidget.cpp:542 emailnotifier/emailwidget.cpp:533
msgctxt "flag new"
msgid "Message is marked as Read, click to mark as New"
msgstr "សារ​ត្រូវ​បាន​សម្គាល់​ថា​អានរួច ចុច​ដើម្បី​សម្គាល់​ថា​ថ្មី"

#: emailmessage/emailwidget.cpp:552 emailnotifier/emailwidget.cpp:538
msgctxt "flag important"
msgid "Message is marked as Important, click to remove this flag"
msgstr "សារ​ត្រូវ​បាន​សម្គាល់​ថា​សំខាន់ ចុច​ដើម្បី​យក​ទង់​នេះ​ចេញ"

#: emailmessage/emailwidget.cpp:554 emailnotifier/emailwidget.cpp:540
msgctxt "flag important"
msgid "Click to mark message as Important"
msgstr "ចុច​ដើម្បី​សម្គាល់​សារ​ថា​សំខាន់"

#: emailmessage/emailwidget.cpp:564
msgctxt "flag Task"
msgid "Message is marked as Action Item, click to remove this flag"
msgstr "សារ​ត្រូវ​បាន​សម្គាល់​ថា​ធាតុ​សកម្មភាព ចុច​ដើម្បី​យក​ទង់​នេះ​ចេញ"

#: emailmessage/emailwidget.cpp:566
msgctxt "flag Task"
msgid "Click to mark message as Action Item"
msgstr "ចុច​ដើម្បី​សម្គាល់​សារ​ថា​ជា​ធាតុ​សកម្ម"

#: emailmessage/emailwidget.cpp:706
msgid "Date:"
msgstr "កាលបរិច្ឆេទ ៖"

#: emailmessage/emailwidget.cpp:712
msgid "To:"
msgstr "ជូន​ចំពោះ ៖"

#: emailmessage/emailwidget.cpp:718
msgid "CC:"
msgstr "ចម្លង​ជូន ៖"

#: emailmessage/emailwidget.cpp:724
msgid "BCC:"
msgstr "ចម្លង​ជា​សម្ងាត់​ជូន ៖"

