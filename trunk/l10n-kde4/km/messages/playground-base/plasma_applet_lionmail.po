msgid "<h3>Fetching email body %1 failed: <p /></h3><pre>%2</pre>"
msgstr "<h3>បានបរាជ័យ​ក្នុងកា​រទៅយក​តួ​អ៊ីមែល %1 ៖ <p /></h3><pre>%2</pre>"

