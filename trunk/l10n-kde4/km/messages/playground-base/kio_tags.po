#: kio_tags.cpp:53
#, kde-format
msgid "Things tagged with '%1'"
msgstr "វត្ថុ​បាន​ដាក់ស្លាក​​ដោយ '%1'"

#: kio_tags.cpp:132
#, kde-format
msgid "Cannot put URL '%1' into a tag without a source URL"
msgstr "មិនអាច​ដាក់ URL '%1' នៅ​ក្នុង​ស្លាក​ដោយគ្មាន​ប្រភព URL បានទេ"

#: kio_tags.cpp:178
#, kde-format
msgid "No new tag name specified in URL %1."
msgstr "គ្មានឈ្មោះស្លាក​ថ្មី​បានបញ្ជាក់នៅ​ក្នុង URL %1 ។"

#: kio_tags.cpp:333
#, kde-format
msgid "Unable to handle URL %1"
msgstr "មិនអាច​គ្រប់គ្រង URL %1"

