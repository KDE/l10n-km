#: converterdialog.cpp:57
#, kde-format
msgid "No Virtuoso Nepomuk database found. Nothing to convert."
msgstr "រក​មិន​ឃើញ​មូលដ្ឋាន​ទិន្នន័យ​របស់​ Virtuoso Nepomuk  ។​ គ្មាន​អ្វី​ត្រូវ​បម្លែង​ទេ ។"

#: converterdialog.cpp:68
#, kde-format
msgid "Installed Virtuoso version is 5. No need to convert."
msgstr "កំណែ​ Virtuoso ​ដែល​បាន​ដំឡើង​គឺ​កំណែ​ ៥ ។ មិន​ចាំ​បាច់​បម្លែង​ទេ ។"

#: converterdialog.cpp:72
#, kde-format
msgid "Ready to convert Nepomuk database to Virtuoso 6 format."
msgstr "ត្រៀម​នឹង​បម្លែង​មូលដ្ឋាន​ទិន្នន័យ​ Nepomuk ​ទៅ​ជា​ទ្រង់​ទ្រាយ Virtuoso កំណែ ៦។"

#: converterdialog.cpp:77
#, kde-format
msgid "Could not find a valid Virtuoso installation."
msgstr "មិន​អាច​រក​ឃើញ​ការដំឡើង​ Virtuoso ​ដែល​ត្រឹម​ត្រូវ​ទេ ។"

#: converterdialog.cpp:84
#, kde-format
msgid "Nepomuk Database already converted to version 6."
msgstr "មូលដ្ឋាន​ទិន្នន័យ​របស់​ Nepomuk ​ត្រូវ​បាន​បម្លែង​ទៅ​ជាកំណែ​ ៦ រួច​ហើយ ។"

#: converterdialog.cpp:89
#, kde-format
msgid ""
"Failed to determine the correct Virtuoso version number. Cannot convert."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​កំណត់​លេខ​កំណែ​ Virtuoso ​ត្រឹម​ត្រូវ ។ មិន​អាច​បម្លែង​បាន​ទេ ។"

#: converterdialog.cpp:99
#, kde-format
msgid "Start Conversion"
msgstr "ចាប់​ផ្តើម​ការបម្លែង"

#: converterdialog.cpp:119
#, kde-format
msgid "Converting Virtuoso database to version 6..."
msgstr "កំពុង​តែ​បម្លែង​មូលដ្ឋាន​ទិន្នន័យ​ Virtuoso ​ទៅ​ជា​កំណែ ៦..."

#: converterdialog.cpp:152
#, kde-format
msgid "Nepomuk Virtuoso database conversion failed: %1"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​បម្លែង​មូលដ្ឋាន​ទិន្នន័យ​របស់​ Nepomuk Virtuoso ៖ %1"

#: converterdialog.cpp:155
#, kde-format
msgid "Nepomuk Virtuoso database successfully converted to version 6."
msgstr "មូលដ្ឋាន​ទិន្នន័យ​របស់ Nepomuk Virtuoso ​ត្រូវ​បាន​បម្លែង​ដោយ​ជោគ​ជ័យ​ទៅ​ជា​កំណែ​ ៦​ ។"

#: converterjob.cpp:83
#, kde-format
msgid "Please disable Nepomuk before starting the converter."
msgstr "សូម​បិទ​ Nepomuk សិន​ មុន​នឹង​ចាប់​ផ្តើម​កម្មវិធី​បម្លែង ។"

#: converterjob.cpp:93
#, kde-format
msgid "Creating backup in <filename>%1</filename>..."
msgstr "កំពុង​បង្កើត​ការបម្រុង​ទុក​នៅ​ក្នុង​ <filename>%1</filename>..."

#: converterjob.cpp:97
#, kde-format
msgid "Failed to create backup (%1)."
msgstr "បាន​បរាជ័យ​ក្នុង​ការបម្រុង​ទុក​ (%1) ។"

#: converterjob.cpp:103
#, kde-format
msgid "Starting Virtuoso version 5..."
msgstr "កំពុង​ចាប់​ផ្តើម​កំណែ​​ ៥..."

#: converterjob.cpp:120 converterjob.cpp:182
#, kde-format
msgid "Failed to create stored procedure (%1)"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​បង្កើត​បែប​បទ​ដែល​បាន​រក្សា​ទុក​ (%1)"

#: converterjob.cpp:126
#, kde-format
msgid "Dumping V5 database to %1..."
msgstr "កំពុង​បោះ​បង់​មូលដ្ឋាន​ទិន្នន័យ​ V5 ​ទៅ​ %1..."

#: converterjob.cpp:139
#, kde-format
msgid "Shutting down Virtuoso version 5..."
msgstr "កំពុងបិទ​ Virtuoso កំណែ ៥..."

#: converterjob.cpp:144
#, kde-format
msgid "Failed to dump all graphs in the database to %1"
msgstr "បាន​បរាជ័យ​ក្នុង​ការបោះ​បង់​ក្រាហ្វ​ទាំង​អស់​នៅ​ក្នុង​មូលដ្ឋាន​ទិន្នន័យ​ទៅ​ %1"

#: converterjob.cpp:150
#, kde-format
msgid "Deleting Virtuoso V5 database files..."
msgstr "កំពុង​លុប​ឯកសារ​មូលដ្ឋាន​ទិន្នន័យ Virtuoso​ V5 ..."

#: converterjob.cpp:154
#, kde-format
msgid "Starting Virtuoso version 6..."
msgstr "កំពុង​ចាប់​ផ្តើម​ Virtuoso កំណែ​ ៦..."

#: converterjob.cpp:188
#, kde-format
msgid "Importing dump from %1 into V6 database."
msgstr "កំពុង​នាំ​ចូល​គំនរ​​សំរាម​ពី​ %1 ​ទៅ​ក្នុង​មូលដ្ឋាន​ទិន្នន័យ​ V6 ។"

#: converterjob.cpp:201
#, kde-format
msgid "Failed to import database dump."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​នាំចូល​គំន​រ​សំរាមមូលដ្ឋាន​ទិន្នន័យ ។"

#: converterjob.cpp:218
#, kde-format
msgid "Removing backup data."
msgstr "យក​ទិន្នន័យ​បម្រុង​ទុក​ចេញ ។"

#: converterjob.cpp:239
#, kde-format
msgid "Keeping V5 dump in <filename>%1</filename>"
msgstr "រក្សា​ទុក​គំនរ​សំរាម​ V5 ​នៅ​ក្នុង​ <filename>%1</filename>"

#: converterjob.cpp:242
#, kde-format
msgid "Removing temp data."
msgstr "កំពុង​យក​ទិន្នន័យ​បណ្តោះ​អាសន្ន​ចេញ ។"

#: converterjob.cpp:253
#, kde-format
msgid "Conversion failed. Restoring backup..."
msgstr "ការបម្លែង​បាន​បរាជ័យ ។ កំពុង​ស្តារ​ព័ត៌មាន​បម្រុង​ទុក..."

#: converterjob.cpp:257
#, kde-format
msgid "Failed to restore backup (%1)."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ស្តារ​ព័ត៌មាន​បម្រុង​ទុក​ (%1) ។"

#: main.cpp:33
#, kde-format
msgid "Virtuoso Converter"
msgstr "កម្មវិធី​បម្លែង​ Virtuoso"

#: main.cpp:35
#, kde-format
msgid "Virtuoso V5 to V6 converter"
msgstr "កម្មវិធី​បម្លែង​ Virtuoso V5 ទៅ​ជា​ V6 "

#: main.cpp:37
#, kde-format
msgid "(c) 2010, Sebastian Trüg"
msgstr "រក្សា​សិទ្ធិ​ឆ្នាំ ២០១០ ដោយ​ Sebastian Trüg"

#: main.cpp:40
#, kde-format
msgid "Sebastian Trüg"
msgstr "Sebastian Trüg"

#: main.cpp:40
#, kde-format
msgid "Maintainer"
msgstr "អ្នក​ថែទាំ"

#: main.cpp:46
#, kde-format
msgid "Automatic mode without user interaction"
msgstr "របៀប​ស្វ័យ​ប្រវត្តិ ដោយ​គ្មាន​អន្តររបស់​អ្នក​ប្រើ"

#: main.cpp:47
#, kde-format
msgid "Do not create a backup of the data before converting."
msgstr "កុំ​បង្កើត​ការបម្រុង​ទុក​ទិន្នន័យ​ មុន​ពេល​បម្លែង ។"

#: main.cpp:48
#, kde-format
msgid "Keep the dump of the old database."
msgstr "រក្សា​ទុក​សំរាម​របស់​មូលដ្ឋាន​ទិន្នន័យ​ចាស់​ៗ ។"
