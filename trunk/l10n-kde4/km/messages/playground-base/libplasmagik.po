#, kde-format
msgid "The file %1 already exists. Do you want to overwrite it?"
msgstr "ឯកសារ %1 មួយ​មាន​រួចហើយ ។ តើ​អ្នក​ចង់​សរសេរ​ជាន់​លើ​វា​ឬទេ ?"

#: uploader.cpp:260
msgid "Overwrite"
msgstr "សរសេរ​ជាន់​លើ"

#: uploader.cpp:326
msgid "Some problem occoured during the packaging operation."
msgstr "បញ្ហា​មួយ​ចំនួន​បានកើតឡើង​ កំឡុង​ពេល​ប្រតិបត្តិ​កញ្ចប់ ។"

#: uploader.cpp:332
#, kde-format
msgctxt "The argument is a filename"
msgid ""
"Your creation has been successfully packaged!<br>You can find it at: <b>%1</"
"b>"
msgstr "ការ​បង្កើត​របស់​អ្នក​នឹង​ត្រូវ​បានខ្ចប់​ដោយជោគជ័យ !<br>អ្នក​អាច​រក​វា​នៅ ៖ <b>%1</b>"

#: uploader.cpp:335
msgid "Plasmoid Packaged!"
msgstr "បាន​ខ្ចប់ Plasmoid !"

#: uploader.cpp:345
msgid ""
"Sorry, you must fill in all the fields before we can package your creation. "
"Please fill in all the fields completely."
msgstr "សូម​អភ័យទោស អ្នក​ត្រូវ​តែ​បំពេញ​នៅ​ក្នុង​វាល​ទាំងអស់ មុន​នឹង​យើង​អាច​ខ្ចប់​ការ​បង្កើត​របស់​អ្នក ។ សូម​បំពេញ​នៅ​ក្នុង​វាល​ទាំងអស់​ ។"

#: uploader.cpp:347
msgid "Have you filled in all the fields?"
msgstr "អ្នក​បាន​បំពេញ​នៅ​ក្នុង​វាល​ទាំងអស់ ?"

#: uploader.cpp:352
msgid "The folder that contains the content you want to package does not exist"
msgstr "ថត​ដែល​មាន​មាតិកា​ដែល​អ្នក​ចង់​ខ្ចប់​ដែល​មិន​ទាន់​មាន"

#: uploader.cpp:358
#, kde-format
msgid "You are going to package the %1 folder <br>Are you sure you want to continue?"
msgstr "អ្នក​នឹង​ខ្ចប់ថត %1 <br>តើ​អ្នក​ប្រាកដ​ជា​ចង់​បន្ត​ឬ ?"

#: uploader.cpp:372
msgctxt "Do _NOT_ translate 'COPYING'"
msgid ""
"Sorry, we cannot create the package of your creation because we cannot find "
"any acceptable license.\n"
" Have you specified a valid license? If you wish to use a custom license, "
"you must make sure to include it in a file called<b>COPYING</b>."
msgstr ""
"សូម​អភ័យទោស អ្នក​មិន​អាច​បង្កើត​កញ្ចប់​ការ​បង្កើត​របស់​អ្នក​បាន​ទេ ពីព្រោះ​យើង​មិន​អាច​រក​អាជ្ញាប័ណ្ណ​ដែលអាច​ទទួលបាន​ទេ ។\n"
" តើ​អ្នក​បាន​បញ្ជាក់​អាជ្ញាបណ្ណ​ត្រឹមត្រូវ​ឬនៅ ? ប្រសិន​បើអ្នក​ចង់​ប្រើ​អាជ្ញាបណ្ណ​ផ្ទាល់ខ្លួន អ្នក​ត្រូវ​តែ​ប្រាកដថា​ត្រូវ​រួម​បញ្ចូល​វា​នៅ​ក្នុង​ឯកសារ​មួយ​ដែល​ហៅ​ថា<b>ការ​ចម្លង</b> ។"

#: uploader.cpp:376
msgid "Could not find any acceptable license"
msgstr "មិន​អាច​រក​អាជ្ញាប័ណ្ណ​ដែល​អាច​ទទួល​យក​បាន"

#: uploader.cpp:380
msgid ""
"The file you have specified does not exists. Please make sure that you've "
"chosen the right file."
msgstr "ឯកសារ​ដែល​អ្នក​បាន​បញ្ជាក់​មិន​ទាន់​មាន​ទេ ។ សូម​ប្រាកដថា អ្នក​បាន​ជ្រើស​ឯកសារ​ត្រឹមត្រូវ ។"

#: uploader.cpp:388
#, no-c-format
msgid ""
"<qt><b style=\"color: red\">***WARNING, WARNING, WARNING!!!***</b><br>It "
"seems that you are going to package your ENTIRE home directory. This is not "
"what you want in the 99.999% of the cases, and in any case it will take a "
"lot of space on the disk and a lot of time to complete.<br>Are you sure you "
"want to continue?</qt>"
msgstr "<qt><b style=\"color: red\">***ការ​ព្រមាន ការ​ព្រមាន ការ​ព្រមាន!!!***</b><br>វា​ហាក់បី​ដូច​ជា​អ្នក​នឹង​ខ្ចប់​ថត​ផ្ទះ ENTIRE របស់​អ្នក ។ នេះ​មិនមែន​ជា​អ្វី​ដែល​អ្នក​ចង់​បាន​នៅ​ក្នុង 99.999% នៃ​ករណី​នេះ​នោះទេ និង​នៅ​ក្នុង​ករណី​មួយ​ចំនួន​វា​នឹង​ចំណាយទំហំ​ជា​ច្រើន​នៅ​លើ​ថាស និង​ពេលវេលា​ច្រើន​ដើម្បី​បញ្ចប់​វា ។<br>អ្នក​ប្រាកដ​ជា​ចង់​បន្ត​ឬ ?</qt>"

