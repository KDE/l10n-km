#: uploader.cpp:412
#| msgctxt "Do _NOT_ translate 'COPYING'"
#| msgid ""
#| "Sorry, we cannot create the package of your creation because we cannot "
#| "find any acceptable license.\n"
#| " Have you specified a valid license? If you wish to use a custom license, "
#| "you must make sure to include it in a file called<b>COPYING</b>."
msgctxt "Do _NOT_ translate 'COPYING'"
msgid ""
"The package of your creation cannot be created because no acceptable license "
"can be found.\n"
"Have you specified a valid license? If you wish to use a custom license, you "
"must make sure to include it in a file called<b>COPYING</b>."
msgstr ""
"មិនអាច​បង្កើត​កញ្ចប់បានទេ ពីព្រោះ​គ្មានអាជ្ញាប័ណ្ណ​ដែលអាច​ទទួល​យក​បាន ។\n"
"តើអ្នក​បាន​បញ្ជាក់​អាជ្ញាប័ណ្ណ​ត្រឹមត្រូវ​ដែរឬទេ ? ប្រសិនបើ​អ្នក​ចង់​ប្រើ​អាជ្ញាប័ណ្ណ​ផ្ទាល់ខ្លួន អ្នក​ត្រូវ​តែ​ប្រាកដ​ថា​រួម​បញ្ចូល​វា​ក្នុង​ឯកសារ​ដែលមាន​ឈ្មោះថា<b>COPYING</b> ។"

#: uploader.cpp:416
msgid "Could not find any acceptable license"
msgstr "មិនអាច​រក​អាជ្ញាប័ណ្ណ​ដែល​អាច​ទទួល​យក​បាន​ណាមួយ​ទេ"

