#: toggle_compositing.cpp:89
#, kde-format
msgid "&Configure Desktop Effects..."
msgstr "កំណត់​​រចនាសម្ព័ន្ធ​បែបផែន​ផ្ទៃតុ..."

#: toggle_compositing.cpp:92
#, kde-format
msgid "&Update Compositing State"
msgstr "ធ្វើ​បច្ចុប្បន្នភាព​ស្ថានភាព​តែង"

#: toggle_compositing.cpp:152
#, kde-format
msgid "Compositing state"
msgstr "ស្ថានភាព​តែង"

#: toggle_compositing.cpp:156
#, kde-format
msgid "Compositing is disabled in settings"
msgstr "កា​រតែង​ត្រូវ​បានបិទ​នៅ​ក្នុង​ការ​កំណត់"

#: toggle_compositing.cpp:163
#, kde-format
msgid "Compositing is active"
msgstr "ការ​តែង​សកម្ម"

#: toggle_compositing.cpp:168
#, kde-format
msgid "Compositing is temporarily suspended"
msgstr "កា​រតែង​បច្ចុប្បន្ន​ត្រូវ​បាន​ផ្អាក"
