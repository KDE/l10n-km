#: confirmation_dialog.cpp:41
msgid "Confirm Desktop Effects Change"
msgstr "អះអាង​កា​រផ្លាស់ប្ដូរ​បែបផែន​ផ្ទៃតុ"

#: confirmation_dialog.cpp:46
msgid "&Accept Configuration"
msgstr "ទទួល​យក​ការ​ផ្លាស់ប្ដូរ"

#: confirmation_dialog.cpp:48
msgid "&Return to Previous Configuration"
msgstr "ត្រឡប់​ទៅការ​កំណត់​រចនាសម្ព័ន្ធ​មុន​វិញ"

#: confirmation_dialog.cpp:51
msgid ""
"Desktop effects settings have changed.\n"
"Do you want to keep the new settings?\n"
"They will be automatically reverted in 10 seconds."
msgstr ""
"ការ​កំណត់​បែបផែន​ផ្ទៃតុ​បាន​ផ្លាស់ប្ដូរ\n"
"តើអ្នក​ចង់​រក្សាទុក​ការ​កំណត់​ថ្មី​នេះ​ដែរឬទេ ?\n"
"ពួកវា​នឹង​ត្រឡប់ទៅ​ដើម​វិញ​ក្នុង​រយៈពេល ១០ វិនាទី ។"

#: ktimerdialog.cpp:168
#, kde-format
msgid "1 second remaining:"
msgid_plural "%1 seconds remaining:"
msgstr[0] "នៅ​សល់ %1 វិនាទី ៖"
