#: cups/kptextpage.cpp:40
#, kde-format
msgid ""
" <qt> <p><b>Characters Per Inch</b></p> <p>This setting controls the "
"horizontal size of characters when printing a text file. </p> <p>The default "
"value is 10, meaning that the font is scaled in a way that 10 characters per "
"inch will be printed. </p> <hr />  <p><em><b>Additional hint for power users:"
"</b> This KDEPrint GUI element corresponds to the CUPS command line job "
"option parameter:</em> <pre>    -o cpi=...          # example: \"8\" or "
"\"12\"  </pre> </p> </qt>"
msgstr ""
" <qt>  <p><b>តួអក្សរ​ក្នុង​មួយ​អ៊ិន្ឈ៍</b></p>  <p>ការ​កំណត់​នេះ​គ្រប់គ្រង​ទំហំ​ផ្ដេក​របស់​តួអក្សរ​នៅពេល​"
"បោះពុម្ព​ឯកសារ​អត្ថបទ ។ </p> <p>តម្លៃ​លំនាំដើម​គឺ ១០ មាន​ន័យ​ថា​​ពុម្ពអក្សរ​ត្រូវ​បាន​ធ្វើ​មាត្រដ្ឋាន​​តាម​"
"វិធី​ដែល​​តួអក្សរ​​ ១០ ក្នុង​មួយ​អ៊ិន្ឈ៍​នឹង​ត្រូវ​បាន​បោះពុម្ព ។ </p>  <hr />  <p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​"
"អ្នក​ប្រើ​ជាន់​ខ្ពស់ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ក្រាហ្វិក​របស់ KDEPrint នេះ​ត្រូវ​​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​"
"ការងារ​បន្ទាត់​ពាក្យ​បញ្ជា​បោះពុម្ព​របស់ CUPS ៖</em>  <pre>    -o cpi=...          # "
"example: \"8\" or \"12\"  </pre> </p>  </qt>"

#: cups/kptextpage.cpp:54
#, kde-format
msgid ""
" <qt> <p><b>Lines Per Inch</b></p>  <p>This setting controls the vertical "
"size of characters when printing a text file. </p> <p>The default value is "
"6, meaning that the font is scaled in a way that 6 lines per inch will be "
"printed. </p>  <hr />  <p><em><b>Additional hint for power users:</b> This "
"KDEPrint GUI element corresponds to the CUPS command line job option "
"parameter:</em> <pre>    -o lpi=...         # example \"5\" or \"7\"  </pre> "
"</p> </qt>"
msgstr ""
" <qt>  <p><b>បន្ទាត់​ក្នុង​មួយ​អ៊ិន្ឈ៍​</b></p>  <p>ការ​កំណត់​នេះ​គ្រប់គ្រង​ទំហំ​បញ្ឈរ​របស់​តួអក្សរ​នៅ​ពេល​"
"បោះពុម្ព​ឯកសារ​អត្ថបទ ។ </p> <p>តម្លៃ​លំនាំដើម​គឺ ៦ មាន​ន័យ​ថា ពុម្ពអក្សរ​ត្រូវ​បាន​ធ្វើមាត្រដ្ឋាន​តាម​"
"វិធី ៦ បន្ទាត់​ក្នុង​មួយ​អ៊ិន្ឈ៍ នឹង​ត្រូវ​បាន​បោះពុម្ព ​​​។ </p>  <hr />  <p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​អ្នក​"
"ប្រើ​ជាន់ខ្ពស់ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ក្រាហ្វិក​របស់ KDEPrint នេះ​ត្រូវ​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​"
"ការងារ​បន្ទាត់​ពាក្យ​បញ្ជា​រប​ស់ CUPS ៖</em>  <pre>    -o lpi=...         # example "
"\"5\" or \"7\"  </pre> </p>  </qt>"

#: cups/kptextpage.cpp:68
#, kde-format
msgid ""
" <qt> <p><b>Columns</b></p> <p>This setting controls how many columns of "
"text will be printed on each page when printing text files. </p> <p>The "
"default value is 1, meaning that only one column of text per page will be "
"printed. </p> <hr />  <p><em><b>Additional hint for power users:</b> This "
"KDEPrint GUI element corresponds to the CUPS command line job option "
"parameter:</em> <pre>    -o columns=...     # example: \"2\" or \"4\"  </"
"pre> </p> </qt>"
msgstr ""
" <qt>  <p><b>ជួរឈរ</b></p>  <p>ការ​កំណត់​នេះ​គ្រប់គ្រង​ចំនួន​​ជួរឈររបស់​អត្ថបទ​ដែល​នឹង​​ត្រូវ​បាន​បោះពុម្ព​"
"នៅ​លើទំព័រ​នីមួយៗ​នៅពេល​បោះពុម្ព​ឯកសារ​អត្ថបទ ។ </p>  <p>តម្លៃ​លំនាំដើម​គឺ ១ មាន​ន័យ​ថា​មានតែ​ជួរឈរ​"
"អត្ថបទ​មួយ​ប៉ុណ្ណោះ​ក្នុង​មួយ​ទំព័រ​ដែល​នឹង​ត្រូវ​​បោះពុម្ព ។ </p>  <hr />  <p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​អ្នក​"
"ប្រើជាន់ខ្ពស់ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​អ្នកប្រើ​ក្រាហ្វិក​របស់ KDEPrint នេះ​ត្រូវ​​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​"
"ការងារ​បន្ទាត់​ពាក្យ​បញ្ជា​របស់ CUPS ៖</em>  <pre>    -o columns=...     # example: "
"\"2\" or \"4\"  </pre> </p>  </qt>"

#: cups/kptextpage.cpp:83
#, kde-format
msgid " <qt>  Preview icon changes when you turn on or off prettyprint.  </qt>"
msgstr " <qt>  រូបតំណាង​មើល​ជាមុន នឹង​ផ្លាស់​ប្ដូរ នៅពេល​អ្នក​បិទ ឬ បើក prettyprint ។  </qt>"

#: cups/kptextpage.cpp:86
#, kde-format
msgid ""
" <qt> <p><b>Text Formats</b></p> <p>These settings control the appearance of "
"text on printouts. They are only valid for printing text files or input "
"directly through kprinter. </p> <p><b>Note:</b> These settings have no "
"effect whatsoever for input formats other than text, or for printing from "
"applications such as the KDE Advanced Text Editor. (Applications in general "
"send PostScript to the print system, and 'kate' in particular has its own "
"knobs to control the print output.)</p>. <hr /> <p><em><b>Additional hint "
"for power users:</b> This KDEPrint GUI element corresponds to the CUPS "
"command line job option parameter:</em> <pre>     -o cpi=...         # "
"example: \"8\" or \"12\"  <br />     -o lpi=...         # example: \"5\" or "
"\"7\"  <br />     -o columns=...     # example: \"2\" or \"4\"  </pre> </p> "
"</qt>"
msgstr ""
" <qt> <p><b>ទ្រង់​ទ្រាយ​អត្ថបទ​</b></p> <p>ការកំណត់​ទាំង​នេះ​គ្រប់​គ្រង​រូបរាង​របស់​អត្ថបទ​នៅ​ពេល​បោះ​"
"ពុម្ព​ ។ ពួក​វា​​​ត្រឹម​ត្រូវ​សម្រាប់​តែ​ការ​បោះ​ពុម្ព​ឯកសារ​អត្ថបទ ឬ​ការបញ្ចូល​ដោយ​ផ្ទាល់​តាម​រយៈ​ kprinter "
"ប៉ុណ្ណោះ ។ </p> <p><b>ចំណាំ​ ៖</b> ការ​កំណត់​ទាំង​នេះ​គ្មានឥទ្ធិពល​​អ្វី​ទាំង​អស់​ចំពោះ​ទ្រង់​ទ្រាយ​បញ្ចូល​ក្រៅ​ពី​"
"អត្ថបទ​ឬ​ក៏​គ្មាន​ឥទ្ធិពល​អ្វី​ទាំង​អស់​ចំពោះ​ការ​បោះ​ពុម្ព​ពី​កម្មវិធី​ដូច​ជា​កម្មវិធី​កែ​សម្រួល​អត្ថបទ​កម្រិត​ខ្ពស់​របស់​ KDE "
"។ (ជា​ទូទៅ​កម្មវិធី​នឹង​​ផ្ញើ PostScript ​ទៅ​កាន់​ប្រព័ន្ធ​បោះ​ពុម្ព​ និង​ជា​ពិសេស​ 'kate' ​មាន​ knobs ​"
"របស់វា​ផ្ទាល់​ដើម្បី​គ្រប់​គ្រង​ទិន្នន័យ​បោះ​ពុម្ព​ ។)</p>។ <hr /> <p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​អ្នក​ប្រើ​"
"ជាន់​ខ្ពស់​ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ក្រាហ្វិក​របស់ KDEPrint នេះ​ត្រូវ​​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​ការងារ​"
"របស់​បន្ទាត់​ពាក្យ​បញ្ជា​របស់​ CUPS  ៖</em> <pre>     -o cpi=...         # example: "
"\"8\" or \"12\"  <br />     -o lpi=...         # example: \"5\" or \"7\"  "
"<br />     -o columns=...     # example: \"2\" or \"4\"  </pre> </p> </qt>"

#: cups/kptextpage.cpp:107
#, kde-format
msgid ""
" <qt> <p><b>Margins</b></p> <p>These settings control the margins of "
"printouts on the paper. They are not valid for jobs originating from "
"applications that define their own page layout internally and send "
"PostScript to KDEPrint (such as KOffice or OpenOffice.org). </p> <p>When "
"printing from KDE applications, such as KMail and Konqueror, or printing an "
"ASCII text file through kprinter, you can choose your preferred margin "
"settings here. </p> <p>Margins may be set individually for each edge of the "
"paper. The combo box at the bottom lets you change the units of measurement "
"between Pixels, Millimeters, Centimeters, and Inches. </p> <p>You can even "
"use the mouse to grab one margin and drag it to the intended position (see "
"the preview picture on the right side).</p> <hr /> <p><em><b>Additional hint "
"for power users:</b> This KDEPrint GUI element corresponds to the CUPS "
"command line job option parameter:</em> <pre>     -o page-top=...      # "
"example: \"72\"  <br />     -o page-bottom=...   # example: \"24\"  <br /"
">     -o page-left=...     # example: \"36\"  <br />     -o page-"
"right=...    # example: \"12\"  </pre> </p> </qt>"
msgstr ""
" <qt> <p><b>រឹម​</b></p> <p>ការ​កំណត់​ទាំង​នេះ​គ្រប់​គ្រង​រឹម​បោះ​ពុម្ព​នៅ​លើ​ក្រដាស ។ ពួក​វា​​​មិន​ត្រឹមត្រូវ​"
"សម្រាប់​ការងារ​ដែល​កើត​ចេញ​មក​ពី​កម្មវិធី​ដែល​កំណត់​ប្លង់​ទំព័រ​ផ្ទាល់​ខ្លួន​របស់​ពួក​វា​នៅ​ខាង​ក្នុង​ ហើយ​នឹង​ផ្ញើ​ "
"PostScript ទៅ​កាន់​ KDEPrint (ដូច​ជា​ KOffice ឬ​ OpenOffice.org) ទេ ។ </p> <p>នៅ​"
"ពេលដែល​​បោះ​ពុម្ព​ចេញ​ពី​កម្មវិធី​ KDE  ដូច​ជា​ KMail និង​ Konqueror ឬ​នៅ​ពេល​បោះ​ពុម្ព​ឯកសារ​អត្ថបទ​ "
"ASCII ​តាម​រយៈ kprinter អ្នក​អាច​ជ្រើស​ការកំណត់​រឹម​សំណព្វ​របស់​អ្នក​នៅ​ទីនេះ​បាន​ ។ </p> <p>រឹម​អាច​នឹង​"
"ត្រូវ​កំណត់​ដោយ​ឡែក​ពី​គ្នា​សម្រាប់​គែម​ក្រដាស​នីមួយ​ៗ​ ។ ប្រអប់​បន្សំ​ស្ថិត​នៅ​ខាង​ក្រោម​អនុញ្ញាត​ឲ្យ​អ្នក​ផ្លាស់​ប្តូរ​ឯកតា​"
"រង្វាស់​រវាង​ភីកសែល មីល្លីម៉ែត្រ សង់​ទីម៉ែត្រ​ និង​អ៊ិន្ឈ៍ ។ </p> <p>អ្នក​ថែម​ទាំង​អាច​ប្រើ​កណ្តុរ​ដើម្បីចាប់​រឹម​"
"ម្ខាង​ និង​អូស​វា​ទៅ​កាន់​ទីតាំង​ដែល​ត្រូវ​ការ​បាន​ទៀត​ផង​ (សូម​មើល មើល​រូបភាព​ជា​មុន​នៅ​ចំហៀង​ខាង​ស្តាំ) ។</p> "
"<hr /> <p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​អ្នកប្រើ​ជាន់​ខ្ពស់​ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​ក្រាហ្វិក​របស់​ "
"KDEPrint នេះ​ត្រូវ​​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​ការងារ​បន្ទាត់​ពាក្យ​បញ្ជា​របស់​ CUPS ​៖</em> <pre>     -"
"o page-top=...      # example: \"72\"  <br />     -o page-bottom=...   # "
"example: \"24\"  <br />     -o page-left=...     # example: \"36\"  <br /"
">     -o page-right=...    # example: \"12\"  </pre> </p> </qt>"

#: cups/kptextpage.cpp:133
#, kde-format
msgid ""
" <qt> <p><b>Turn Text Printing with Syntax Highlighting (Prettyprint) On.</"
"b></p> <p>ASCII text file printouts can be 'prettyfied' by enabling this "
"option. If you do so, a header is printed at the top of each page. The "
"header contains the page number, job title (usually the filename), and the "
"date. In addition, C and C++ keywords are highlighted, and comment lines are "
"italicized.</p> <p>This prettyprint option is handled by CUPS.</p> <p>If you "
"prefer another 'plaintext-to-prettyprint' converter, look for the "
"<em>enscript</em> pre-filter on the <em>Filters</em> tab. </p> <br /> <hr /> "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"corresponds to the CUPS command line job option parameter:</em> <pre>     -o "
"prettyprint=true.  </pre> </p> </qt>"
msgstr ""
" <qt> <p><b>បើក​ការ​បោះ​ពុម្ព​អត្ថបទ​ដោយ​បន្លិចវាក្យសម្ព័ន្ធ​ (Prettyprint) ។</b></p> <p>​"
"ការបោះ​ពុម្ព​ឯកសារ​អត្ថបទ​ ASCII ​អាច​ជា​ 'prettyfied' ដោយ​ការ​បើក​ជម្រើស​នេះ​ ។ បើ​អ្នក​ធ្វើ​"
"ដូច្នេះ ក្បាល​ទំព័រ​​នឹង​ត្រូវបោះ​ពុម្ព​នៅ​ខាង​លើ​ទំព័រ​នីមួយ​ៗ​ ។ ក្បាល​ទំព័រ​នេះ​មាន​លេខ​ទំព័រ ចំណង​ជើង​ការងារ​ (ជា​"
"ទូ​ទៅ​ជា ឈ្មោះ​ឯកសារ) និង​កាល​បរិច្ឆេទ​ ។ លើស​នេះ​ទៀត ពាក្យគន្លឹះ​ C និង​ C++ ​នឹង​ត្រូវ​បាន​បន្លិច​ ហើយ​"
"បន្ទាត់​មតិយោបល់​នឹង​ត្រូវ​បាន​ធ្វើ​ឲ្យ​ទៅ​ជា​ទ្រេត ។</p> <p>ជម្រើស​ prettyprint នេះ​អាច​នឹង​ត្រូវគ្រប់​គ្រង​​"
"ដោយ​ CUPS ។</p> <p>បើ​អ្នក​ត្រូវ​ការ​កម្មវិធី​បម្លែង​ 'plaintext-to-prettyprint' ផ្សេង​ទៀត សូម​"
"រក​មើល​ត្រង់ជា​មុន​នូវ​ <em>enscript</em> ​នៅ​លើផ្ទាំង​ <em>តម្រង​</em> ។ </p> <br /> <hr /> "
"<p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​អ្នក​ប្រើ​ជាន់​ខ្ពស់ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​អ្នកប្រើ​ក្រាហ្វិក​របស់​ "
"KDEPrint នេះ​ត្រូវ​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​ការងារ​បន្ទាត់​ពាក្យ​បញ្ជា​របស់​ CUPS ៖</em> <pre>     -"
"o prettyprint=true.  </pre> </p> </qt>"

#: cups/kptextpage.cpp:152
#, kde-format
msgid ""
" <qt> <p><b>Turn Text Printing with Syntax Highlighting (Prettyprint) Off.</"
"b></p> <p>ASCII text file printed with this option turned off appear without "
"a page header and without syntax highlighting. (You can still set the page "
"margins, though.)</p> <br /> <hr /> <p><em><b>Additional hint for power "
"users:</b> This KDEPrint GUI element corresponds to the CUPS command line "
"job option parameter:</em> <pre>    -o prettyprint=false  </pre> </p> </qt>"
msgstr ""
" <qt> <p><b>បិទ​ការ​បោះ​ពុម្ព​អត្ថបទ​ដោយ​បន្លិច​វាក្យសម្ព័ន្ធ​ (Prettyprint) ។</b></p> <p>ឯកសារ​"
"អត្ថបទ​ ASCII ដែល​បាន​បោះ​ពុម្ព​ជាមួយ​ជម្រើស​នេះត្រូវ​បាន​បិទ​ និង​បង្ហាញ​ដោយ​គ្មាន​ក្បាល​ទំព័រ​ និង​ដោយ​គ្មាន​"
"ការ​បន្លិច​វាក្យសម្ព័ន្ធ​ ។ (ទោះ​បី​យ៉ាង​ណា អ្នក​នៅ​តែ​អាច​កំណត់​រឹម​ទំព័រ​បានដដែល​។)</p> <br /> <hr /> "
"<p><em><b>ជំនួយ​បន្ថែម​សម្រាប់​អ្នក​ប្រើ​ជាន់​ខ្ពស់​ ៖</b> ធាតុ​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ក្រាហ្វិក​របស់​ "
"KDEPrint នេះ​ត្រូវ​នឹង​ប៉ារ៉ាម៉ែត្រ​ជម្រើស​ការងារ​បន្ទាត់ពាក្យ​​បញ្ជា​របស់​ CUPS ៖</em> <pre>    -o "
"prettyprint=false  </pre> </p> </qt>"

#: cups/kptextpage.cpp:166
#, kde-format
msgid ""
" <qt> <p><b>Print Text with Syntax Highlighting (Prettyprint)</b></p>  "
"<p>ASCII file printouts can be 'prettyfied' by enabling this option. If you "
"do so, a header is printed at the top of each page. The header contains the "
"page number, job title (usually the filename), and the date. In addition, C "
"and C++ keywords are highlighted, and comment lines are italicized.</p> "
"<p>This prettyprint option is handled by CUPS.</p> <p>If you prefer another "
"'plaintext-to-prettyprint' converter, look for the <em>enscript</em> pre-"
"filter on the <em>Filters</em> tab. </p> <br /> <hr /> <p><em><b>Additional "
"hint for power users:</b> This KDEPrint GUI element corresponds to the CUPS "
"command line job option parameter:</em> <pre>     -o prettyprint=true.  <br /"
">     -o prettyprint=false  </pre> </p> </qt>"
msgstr ""
" <qt> <p><b>បោះ​ពុម្ព​អត្ថបទ​ដោយ​បន្លិច​វាក្យសម្ព័ន្ធ​ (Prettyprint)</b></p>  <p>ការបោះ​ពុម្ព​"
"ឯកសារ ASCII ​អាច​នឹង​ជា​ 'prettyfied' ដោយ​ការបើក​ជម្រើស​នេះ​ ។ បើ​អ្នក​ធ្វើ​ដូច្នេះ ក្បាល​ទំព័រ​នឹង​"
"ត្រូវ​បាន​បោះ​ពុម្ព​នៅ​ខាង​លើ​ទំព័រ​នីមួយ​ៗ ។ ក្បាល​ទំព័រ​មាន​លេខ​ទំព័រ ចំណង​ជើង​ការងារ (ជា​ទូទៅ​ជា​ឈ្មោះ​ឯកសារ​"
") និងកាល​បរិច្ឆេទ ។ លើស​នេះ​ទៀត​ ពាក្យ​គន្លឹះ C និង​ C++ ​នឹង​ត្រូវ​បាន​បន្លិច ហើយ​បន្ទាត់​មតិយោបល់​នឹង​ត្រូវ​"
"បាន​ធ្វើ​ឲ្យ​ទៅ​ជា​ទ្រេត ។</p> <p>ជម្រើស​ prettyprint នេះ​ត្រូវ​បាន​គ្រប់​គ្រង​ដោយ​ CUPS ។</p> "
"<p>បើ​អ្នក​ត្រូវ​ការ​កម្មវិធី​បម្លែង​ 'plaintext-to-prettyprint' ​ផ្សេង​ទៀត សូម​មើល​តម្រង​ដើម​របស់​​ "
"<em>enscript</em> ​លើ​បន្ទះ​ <em>តម្រង​</em> ។ </p> <br /> <hr /> <p><em><b>ជំនួយ​"
"បន្ថែម​សម្រាប់​អ្នកប្រើ​ជាន់​ខ្ពស់​ ៖</b> ធាតុ​ចំណុចប្រទាក់​អ្នកប្រើ​ក្រាហ្វិក​របស់​ KDEPrint នេះ​ត្រូវ​​នឹង​"
"ប៉ារ៉ាម៉ែត្រ​ជម្រើស​ការងារ​បន្ទាត់​ពាក្យ​បញ្ជា​របស់​ CUPS ៖</em> <pre>     -o "
"prettyprint=true.  <br />     -o prettyprint=false  </pre> </p> </qt>"

