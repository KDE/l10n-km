#. i18n: file: publicTransportFilterConfig.ui:102
#. i18n: ectx: property (text), widget (QLabel, label_12)
#: rc.cpp:45
msgid "Max. line:"
msgstr "បន្ទាត់​អតិបរមា ៖"

#. i18n: file: publicTransportFilterConfig.ui:144
#. i18n: ectx: property (text), item, widget (KComboBox, filterTypeTarget)
#: rc.cpp:48
msgid "Show all targets"
msgstr "បង្ហាញ​គោលដៅ​ទាំងអស់"

#. i18n: file: publicTransportFilterConfig.ui:149
#. i18n: ectx: property (text), item, widget (KComboBox, filterTypeTarget)
#: rc.cpp:51
msgid "Show matching targets"
