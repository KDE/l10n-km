#: settings.cpp:133
msgid ""
"<b>This shows the filters of the selected filter configuration.</b><br>Each "
"filter configuration consists of a filter action and a list of filters. Each "
"filter contains a list of constraints.<br>A filter matches, if all it's "
"constraints match while a filter configuration matches, if one of it's "
"filters match.<br>To use a filter configuration select it in the 'Filter "
"Uses' tab. Each stop settings can use another filter configuration."
"<br><br><b>Filter Types</b><br>- <b>Vehicle:</b> Filters by vehicle types."
"<br>- <b>Line String:</b> Filters by transport line strings.<br>- <b>Line "
"number:</b> Filters by transport line numbers.<br>- <b>Target:</b> Filters "
"by target/origin.<br>- <b>Via:</b> Filters by intermediate stops.<br>- "
"<b>Delay:</b> Filters by delay."
msgstr ""

