#. i18n: file: publicTransportFilterConfig.ui:154
#. i18n: ectx: property (text), item, widget (KComboBox, filterTypeTarget)
#: rc.cpp:54
msgid "Hide matching targets"
msgstr "លាក់​គោលដៅ​ដែល​ផ្គូផ្គង"

#. i18n: file: publicTransportFilterConfig.ui:168
#. i18n: ectx: property (text), widget (QLabel, label_16)
#: rc.cpp:57
