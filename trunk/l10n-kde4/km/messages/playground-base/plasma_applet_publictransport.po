msgstr "ប្រភព​ទិន្នន័យ"

#. i18n: file: publicTransportConfig.ui:31
#. i18n: ectx: property (text), widget (QLabel, label_8)
#: rc.cpp:6
msgid "Service provider:"
msgstr "ក្រុមហ៊ុន​ផ្ដល់​សេវា ៖"

#. i18n: file: publicTransportConfig.ui:63
#. i18n: ectx: property (text), widget (QLabel, label_6)
#: rc.cpp:9
msgid "Appearance"
msgstr "រូបរាង"

#. i18n: file: publicTransportConfig.ui:76
#. i18n: ectx: property (text), widget (QLabel, lblCity)
#: rc.cpp:12
msgid "City:"
msgstr "ទីក្រុង ៖"

#. i18n: file: publicTransportConfig.ui:99
#. i18n: ectx: property (text), widget (QLabel, label_16)
#: rc.cpp:15
msgid "Update automatically:"
msgstr "ធ្វើ​ឲ្យ​ទាន់សម័យ​ដោយ​ស្វ័យ​ប្រវត្តិ​ ៖"

#. i18n: file: publicTransportConfig.ui:134
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:18
msgid "seconds"
msgstr "វិនាទី"

#. i18n: file: publicTransportConfig.ui:143
#. i18n: ectx: property (text), widget (QLabel, label_17)
#: rc.cpp:21
msgid "Update every:"
msgstr "ធ្វើ​ឲ្យ​ទាន់សម័យ​រៀងរាល់ ៖"

#. i18n: file: publicTransportConfig.ui:173
#. i18n: ectx: property (text), widget (QLabel, label_18)
#: rc.cpp:24
msgid "Show remaining minutes:"
msgstr "បង្ហាញ​នាទី​នៅ​ដល់ ៖"

#. i18n: file: publicTransportConfig.ui:183
#. i18n: ectx: property (text), widget (QLabel, label_19)
#: rc.cpp:27
msgid "Show departure time:"
msgstr "បង្ហាញ​ពេលវេលា​ចេញ​ដំណើរ ៖"

#. i18n: file: publicTransportConfig.ui:196
#. i18n: ectx: property (text), widget (QLabel, label_9)
#: rc.cpp:30
