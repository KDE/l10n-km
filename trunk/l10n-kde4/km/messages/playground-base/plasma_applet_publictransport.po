#: publictransport.cpp:95
msgid "&Update timetable"
msgstr "ភាព​ទាន់សម័យ​ដែល​អាច​កំណត់​ពេល​បាន"

#: publictransport.cpp:117
msgid "depart is in the past"
msgstr "ការ​ចេញ​ស្ថិត​ក្នុង​អតីតកាល"

#: publictransport.cpp:126
#, kde-format
msgid "in %1 hours and %2 minutes"
msgstr "ក្នុងរយៈពេល %1 ម៉ោង និង %2 នាទី"

#: publictransport.cpp:129
#, kde-format
msgid "in %1 hour"
msgid_plural "in %1 hours"
msgstr[0] "ក្នុងរយៈពេល %1 ម៉ោង"

#: publictransport.cpp:133
#, kde-format
msgid "in %1 minute"
msgid_plural "in %1 minutes"
msgstr[0] "ក្នុង​រយៈពេល %1 នាទី"

#: publictransport.cpp:136
msgid "now"
msgstr "ឥឡូវ"

#: publictransport.cpp:171 publictransport.cpp:188
msgid "The stop name is ambigous."
msgstr "ឈ្មោះ​បញ្ឈប់គឺ ambigous ។"

#: publictransport.cpp:195
msgid "The stop name is valid."
msgstr "ឈ្មោះ​បញ្ឈប់​​​ត្រឹមត្រូវ​ទេ ។"

#: publictransport.cpp:221
msgid "The stop name is invalid."
msgstr "ឈ្មោះ​បញ្ឈប់​មិន​ត្រឹមត្រូវ​ទេ ។"

#: publictransport.cpp:227
msgid "Error parsing departure information"
msgstr "កំហុស​ក្នុងការ​ញែកព័ត៌មាន​ចេញ​ដំណើរ"

#: publictransport.cpp:250
msgid "Public transport"
msgstr "កា​រដឹក​ជញ្ជូន​សាធារណៈ"

#: publictransport.cpp:252
msgid "View departure times for public transport"
msgstr "មើល​ពេល​វេលា​ចេញ​ដំណើរ​សម្រាប់​ការ​ដឹក​ជញ្ជូន​សាធារណៈ"

#: publictransport.cpp:256
#, kde-format
msgctxt "%4 is the translated duration text, e.g. in 3 minutes"
msgid "Next departure from '%1': line %2 (%3) %4"
msgstr "ចេញ​ដំណើរ​បន្ទាប់ពី '%1' ៖ បន្ទាត់ %2 (%3) %4"

#: publictransport.cpp:289
msgid "Please set a city and a stop."
msgstr "សូម​កំណត់​ទីក្រុង និង​កា​របញ្ឈប់ ។"

#: publictransport.cpp:291
msgid "Please set a stop."
msgstr "សូម​កំណត់​ការ​បញ្ឈប់ ។"

#: publictransport.cpp:293
msgid "Please select a service provider."
msgstr "សូម​ជ្រើស​ក្រុមហ៊ុន​ផ្ដល់​សេវា ។"

#: publictransport.cpp:295
msgid "The minimal shown line can't be bigger than the maximal shown line."
msgstr "កា​របង្រួម​អប្បបរមា​បង្ហាញ​បន្ទាត់ ដែល​មិន​ធំជាង​បន្ទាត់​ដែលបង្ហាញ​អតិបរមា ។"

#: publictransport.cpp:350
msgctxt "A tramline or busline"
msgid "Line"
msgstr "បន្ទាត់"

#: publictransport.cpp:351
msgctxt "Direction of a tramline or busline"
msgid "Direction"
msgstr "ទិសដៅ"

#: publictransport.cpp:352
msgctxt "Time of departure of a tram or bus"
msgid "Departure"
msgstr "ចេញ​ដំណើរ"

#: publictransport.cpp:430
msgid "General"
msgstr "ទូទៅ"

#: publictransport.cpp:431
msgid "Filter"
msgstr "តម្រង"

#: publictransport.cpp:495
msgid "Checking validity of the stop name."
msgstr "ពិនិត្យ​សុពលភាព​របស់​ឈ្មោះបញ្ឈប់ ។"

#. i18n: file: publicTransportConfig.ui:24
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:3
