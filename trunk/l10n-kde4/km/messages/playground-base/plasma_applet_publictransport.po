#. i18n: file: publicTransportFilterConfig.ui:57
#. i18n: ectx: property (text), widget (QLabel, label_15)
#: rc.cpp:39
msgid "Show night lines:"
msgstr "បង្ហាញ​បន្ទាត់​ពេល​យប់ ៖"

#. i18n: file: publicTransportFilterConfig.ui:77
#. i18n: ectx: property (text), widget (QLabel, label_11)
#: rc.cpp:42
msgid "Min. line:"
