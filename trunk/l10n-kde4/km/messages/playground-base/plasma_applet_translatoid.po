#. i18n: ectx: property (text), widget (QLabel, label)
#: form/languageform.ui:17
msgid "Automatically paste the selection:"
msgstr "បិទ​ភ្ជាប់​ជម្រើស​ដោយ​ស្វ័យ​ប្រវត្តិ ៖"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: form/languageform.ui:37
msgid "Automatically translate the source:"
msgstr "បកប្រែ​ប្រភព​ដោយ​ស្វ័យ​ប្រវត្តិ ៖"

#. i18n: ectx: property (text), widget (QLabel, label)
#: form/reminderform.ui:19
msgid "Show duration (seconds)"
msgstr "បង្ហាញថិរវេលា (វិនាទី)"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: form/reminderform.ui:39
msgid "Show frequency (seconds)"
msgstr "បង្ហាញ​ប្រេកង់​ (វិនាទី)"

#. i18n: ectx: property (text), widget (QCheckBox, checkBox)
#: form/reminderform.ui:59
#, fuzzy
#| msgid "Reminder"
msgid "Enable reminder"
msgstr "អ្នក​រំលឹក"

#. i18n: ectx: property (text), widget (QPushButton, deleteButton)
#: form/reminderform.ui:99
msgid "delete"
msgstr "លុប"

#: ktranslatoid.cpp:131
msgid "Translatoid"
msgstr "Translatoid"

#: ktranslatoid.cpp:132
msgid "Use the mouse wheel on icon to swap languages"
msgstr "ប្រើ​កង់​កណ្តុរ​នៅ​លើ​រូប​តំណាង​ដូរ​ភាសា"

#: ktranslatoid.cpp:139
msgid "Invert the translation"
msgstr "ដាក់​បញ្ច្រាសការ​​ប្រែភាសា"

#: ktranslatoid.cpp:142
msgid "Translate"
msgstr "បកប្រែ"

#: ktranslatoid.cpp:143
msgid "Click here to translate"
msgstr "ចុច​ទីនេះ ដើម្បី​ប្រែភាសា"

#: ktranslatoid.cpp:162
msgid "Paste a selection to translate it"
msgstr "បិទ​ភ្ជាប់​ជម្រើស​ដើម្បី​បកប្រែ​វា"

#: ktranslatoid.cpp:163
msgid "Copy the result"
msgstr "ចម្លង​លទ្ធផល"

#: ktranslatoid.cpp:164
msgid "Clear the source text"
msgstr "ជម្រះ​អត្ថបទ​ប្រភព"

#: ktranslatoid.cpp:165
msgid "Click here to remember the translation"
msgstr "ចុច​ទីនេះ ដើម្បីចង់ចាំ​ការ​ប្រែភាសា"

#: ktranslatoid.cpp:167
msgid "Change source language"
msgstr "ផ្លាស់ប្ដូរ​ភាសា​ប្រភព"

#: ktranslatoid.cpp:168
msgid "Change destination language"
msgstr "ផ្លាស់ប្ដូរ​ភាសា​ទិសដៅ"

#: ktranslatoid.cpp:216
msgid "Networking is disabled. Cannot connect to Google."
msgstr "ការតភ្ជាប់​បណ្តាញ​ត្រូវ​បាន​បិទ ។ មិន​អាច​តភ្ជាប់​ទៅ​ Google បាន​ទេ ។"

#: ktranslatoid.cpp:238
msgid "Do you remember?"
msgstr "តើអ្នក​ចង់​ចាំ ?"

