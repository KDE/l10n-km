#: nepomukcontextchooser.cpp:101
#, kde-format
#, fuzzy
msgctxt "@info:tooltip"
msgid "Current work context: <emphasis>%1</emphasis>"
msgstr "បរិបទ​ការងារ​បច្ចុប្បន្ន ៖ <emphasis>%1</emphasis>"

#: nepomukcontextchooser.cpp:103
#, kde-format
#, fuzzy
msgctxt "@info:tooltip"
msgid ""
"You are working in the context of <emphasis>%1</emphasis>. This means that "
"files, emails, and other resources can easily be related to it."
msgstr ""
"អ្នក​កំពុង​តែ​ធ្វើ​ការងារ​នៅ​ក្នុង​បរិបទ​នៃ​ <emphasis>%1</emphasis> ។ "
"នេះ​មាន​ន័យ​ថា​ឯកសារ អ៊ីមែល​ "
"និង​ធន​ធាន​ផ្សេង​ទៀត​អាច​ធ្វើ​ឲ្យ​មាន​ទំនាក់​ទំនង​បាន​យ៉ាង​ងាយ​ជា​មួយ​នឹង​វា "
"។"

#: nepomukcontextchooser.cpp:110
#, fuzzy
