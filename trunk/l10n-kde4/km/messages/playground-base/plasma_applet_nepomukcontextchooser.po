#: nepomukcontextchooser.cpp:101
#, kde-format
msgctxt "@info:tooltip"
msgid "Current work context: <emphasis>%1</emphasis>"
msgstr "បរិបទ​ការងារ​បច្ចុប្បន្ន ៖ <emphasis>%1</emphasis>"

#: nepomukcontextchooser.cpp:103
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"You are working in the context of <emphasis>%1</emphasis>. This means that "
"files, emails, and other resources can easily be related to it."
msgstr ""
"អ្នក​កំពុង​តែ​ធ្វើ​ការងារ​នៅ​ក្នុង​បរិបទ​នៃ​ <emphasis>%1</emphasis> ។ នេះ​មាន​ន័យ​ថា​ឯកសារ អ៊ីមែល​ "
"និង​ធន​ធាន​ផ្សេង​ទៀត​អាច​ធ្វើ​ឲ្យ​មាន​ទំនាក់​ទំនង​បាន​យ៉ាង​ងាយ​ជា​មួយ​នឹង​វា ។"

#: nepomukcontextchooser.cpp:110
#, kde-format
msgctxt "@action:button"
msgid "No work context selected"
msgstr "គ្មាន​បរិបទ​ការងារ​ត្រូវ​បាន​ជ្រើស​ទេ"

#: nepomukcontextchooser.cpp:113
#, kde-format
msgctxt "@info:tooltip"
msgid "No work context selected"
msgstr "គ្មាន​បរិបទ​ការងារ​ត្រូវ​បាន​ជ្រើស​ទេ"

#: nepomukcontextchooser.cpp:115
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Choose the current work context to be able to easily relate files, emails, "
"and other resources to it."
msgstr ""
"ជ្រើស​បរិបទ​ការងារ​បច្ចុប្បន្ន​ដែល​អាច​ធ្វើ​ឲ្យ​ឯកសារ អ៊ីមែល និង​ធន​ធាន​ផ្សេង​ទៀត​មាន​ទំនាក់​ទំនង​យ៉ាង​ងាយ​ជា​មួយ​"
"វា ។"

#: nepomukcontextchooser.cpp:134
#, kde-format
msgid "Start Ginkgo"
msgstr "ចាប់​ផ្តើម​ Ginkgo"

#: nepomukcontextchooser.cpp:153
#, kde-format
msgid "Context Types"
msgstr "ប្រភេទ​បរិបទ"

#: nepomukcontextchooser.cpp:155
#, kde-format
msgid "Select the types that should be selectable as work context"
msgstr "ជ្រើស​ប្រភេទ​ដែល​នឹង​គួរ​អាច​ជ្រើស​ជា​បរិបទ​ការងារ​បាន"
