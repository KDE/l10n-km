#: ../configshell/main.cpp:49
msgid "Connection ID to edit"
msgstr "លេខ​សម្គាល់​ការ​តភ្ជាប់​ត្រូវ​កែសម្រួល"

#: ../configshell/main.cpp:50
msgid ""
"Connection type to create, must be one of '802-3-ethernet', '802-11-"
"wireless', 'pppoe', 'vpn', 'cellular'"
msgstr ""
"ប្រភេទ​តភ្ជាប់​ត្រូវ​បង្កើត ត្រូវតែ​ជា '802-3-ethernet', '802-11-wireless', 'pppoe', "
"'vpn', 'cellular'"

#: ../configshell/main.cpp:51
msgid ""
"Space-separated connection type-specific arguments, may be either 'gsm' or "
"'cdma' for cellular, or 'openvpn' or 'vpnc' for vpn connections, and "
"interface and AP identifiers for wireless connections"
msgstr ""
"ប្រភេទ​ការ​តភ្ជាប់​ដែល​បំបែក​ដោយ​ចន្លោះ​ដែល​មាន​អាគុយម៉ង់​ជាក់លាក់ អាច​ជា 'gsm' ឬ 'cdma' សម្រាប់​"
"ទូរស័ព្ទ​ចល័ត ឬ 'openvpn' ឬ 'vpnc' សម្រាប់​ការ​តភ្ជាប់ vpn និង​ចំណុច​ប្រទាក់​ឧបករណ៍​កំណត់​អត្តសញ្ញាណ "
"AP សម្រាប់​ការ​តភ្ជាប់​ឥត​ខ្សែរ"

#: ../configshell/main.cpp:52
msgid "Operation mode, may be either 'create' or 'edit'"
msgstr "របៀប​ប្រតិបត្តិការ អាច​ជា 'បង្កើត' ឬ​'កែសម្រួល'"

