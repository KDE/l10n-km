#: main.cpp:32
msgid "The KDE desktop, panels and widgets workspace application."
msgstr "ផ្ទៃ​តុ ផ្ទាំង និង​កម្មវិធី​តំបន់​ធ្វើការ​នៃ​ធាតុ​ក្រាហ្វិក​របស់​ KDE ។"

#: main.cpp:38
msgid "Plasma Workspace"
msgstr "តំបន់​ធ្វើការ​ប្លាស្មា​"

#: main.cpp:40
msgid "Copyright 2006-2009, The KDE Team"
msgstr "រក្សា​សិទ្ធិ​ឆ្នាំ​ ២០០៦-២០០៩ ដោយ​ក្រុម​ KDE"

#: main.cpp:41
msgid "Alexis Menard"
msgstr "Alexis Menard"

#: main.cpp:42 main.cpp:45
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង​អ្នក​ថែ​ទាំ"

#: main.cpp:44
msgid "Marco Martin"
msgstr "Marco Martin"

#: main.cpp:52
msgid "Starts as a normal application instead of as the primary user interface"
msgstr "ចាប់​ផ្តើម​ដូច​កម្មវិធី​ធម្មតា​​ជួសវិញដូច​ចំណុច​ប្រទាក់​អ្នក​ប្រើ​ចម្បង"

#: main.cpp:53
msgid "The geometry of the screen"
msgstr "ធរណីមាត្រ​របស់​អេក្រង់"

#: main.cpp:55
msgid "use a QGLWidget for the viewport"
msgstr "ប្រើ​ QGLWidget ​សម្រាប់​ viewport"

#: main.cpp:57
msgid "Starts the application in fullscreen"
msgstr "ចាប់​ផ្តើម​កម្មវិធី​ក្នុង​របៀប​ពេញ​អេក្រង់"

#: plasmaapp.cpp:160
msgid "Lock Plasma Mobile screen"
msgstr "ចាក់​សោ​អេក្រង់​ចល័ត​ប្លាស្មា"

