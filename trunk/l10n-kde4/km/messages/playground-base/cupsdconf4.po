#: cupsd.conf.template.cpp:1
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server name (ServerName)</b>\n"
"<p>\n"
"The hostname of your server, as advertised to the world.\n"
"By default CUPS will use the hostname of the system.</p>\n"
"<p>\n"
"To set the default server used by clients, see the client.conf file.</p>\n"
"<p>\n"
"<i>ex</i>: myhost.domain.com</p>\n"
msgstr ""
"<b>ឈ្មោះ​ម៉ាស៊ីន​បម្រើ (ServerName)</b>\n"
"<p>\n"
"ឈ្មោះ​​ម៉ាស៊ីន​បម្រើ​របស់​អ្នក ដូចដែល​​បាន​ផ្សព្វផ្សាយ​​ទៅ​ពិភព​លោក ។\n"
"តាម​លំនាំដើម CUPS នឹង​ប្រើ​​ឈ្មោះ​ម៉ាស៊ីន​របស់​ប្រព័ន្ធ ។</p>\n"
"<p>\n"
"ដើម្បី​កំណត់​ម៉ាស៊ីន​បម្រើ​លំនាំ​ដើម​ដែល​​បាន​ប្រើ​ដោយ​ម៉ាស៊ីនភ្ញៀវ សូម​មើល​ឯកសារ client.conf ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ myhost.domain.com</p>\n"

#: cupsd.conf.template.cpp:11
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server administrator (ServerAdmin)</b>\n"
"<p>\n"
"The email address to send all complaints or problems to.\n"
"By default CUPS will use \"root@hostname\".</p>\n"
"<p>\n"
"<i>ex</i>: root@myhost.com</p>\n"
msgstr ""
"<b>អ្នក​គ្រប់​គ្រង​ប្រព័ន្ធ (ServerAdmin)</b>\n"
"<p>\n"
"អាសយដ្ឋាន​អ៊ីមែលដែល​ត្រូវ​ផ្ញើ​​បញ្ហា​ទាំងអស់ ។\n"
"តាម​លំនាំ​ដើម CUPS នឹង​ប្រើ \"root@hostname\" ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ root@myhost.com</p>\n"

#: cupsd.conf.template.cpp:19
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Access log (AccessLog)</b>\n"
"<p>\n"
"The access log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/access_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/access_log</p>\n"
msgstr ""
"<b>កំណត់ហេតុ​​ចូល​ដំណើរការ (AccessLog)</b>\n"
"<p>\n"
"ឯកសារ​កំណត់ហេតុ​​ចូល​ដំណើរការ ។ ប្រសិន​បើ​វា​មិន​ចាប់​ផ្ដើម​ដោយ​សញ្ញា / ទេ នោះ​វា​នឹង​​ត្រូវបាន​សម្មត់​ថា​ទាក់ទង​"
"នឹង ServerRoot ។ តាម​លំនាំ​ដើម​គឺ​កំណត់​ទៅ\n"
"\"/var/log/cups/access_log\" ។</p>\n"
"<p>\n"
"អ្នក​​ក៏​អាច​ប្រើ​ឈ្មោះ​ពិសេស <b>syslog</b> ផង​ដែរ ដើម្បី​ផ្ញើលទ្ធផល​​ទៅ\n"
"ឯកសារ syslog ឬ daemon ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /var/log/cups/access_log</p>\n"

#: cupsd.conf.template.cpp:31
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Data directory (DataDir)</b>\n"
"<p>\n"
"The root directory for the CUPS data files.\n"
"By default /usr/share/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups</p>\n"
msgstr ""
"<b>ថត​ទិន្នន័យ (DataDir)</b>\n"
"<p>\n"
"ថត root សម្រាប់​ឯកសារ​ទិន្នន័យ CUPS ។\n"
"តាម​លំនាំ​ដើម​គឺ /usr/share/cups ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /usr/share/cups</p>\n"

#: cupsd.conf.template.cpp:39
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Default character set (DefaultCharset)</b>\n"
"<p>\n"
"The default character set to use. If not specified,\n"
"defaults to utf-8.  Note that this can also be overridden in\n"
"HTML documents...</p>\n"
"<p>\n"
"<i>ex</i>: utf-8</p>\n"
msgstr ""
"<b>សំណុំ​តួអក្សរ​លំនាំ​ដើម (DefaultCharset)</b>\n"
"<p>\n"
"កំណត់​សំណុំ​តួអក្សរ​លំនាំដើម​ដើម្បី​ប្រើ ។ ប្រសិនបើ​មិន​បាន​បញ្ជាក់\n"
"នោះ​កំណត់​លំនាំដើម​ទៅ utf-8 ។ ចំណាំថា វា​ក៏​អាច​ត្រូវបាន​បដិសេធ​នៅ​ក្នុង​\n"
"ឯកសារ HTML ផងដែរ...</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ utf-8</p>\n"

#: cupsd.conf.template.cpp:48
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Default language (DefaultLanguage)</b>\n"
"<p>\n"
"The default language if not specified by the browser.\n"
"If not specified, the current locale is used.</p>\n"
"<p>\n"
"<i>ex</i>: en</p>\n"
msgstr ""
"<b>ភាសា​លំនាំ​ដើម (DefaultLanguage)</b>\n"
"<p>\n"
"ភាសា​លំនាំ​ដើម នៅពេល​ដែល​មិន​បាន​បញ្ជាក់​​ដោយ​កម្មវិធី​រុករក ។\n"
"ប្រសិន​បើ​មិន​បាន​បញ្ជាក់ នោះ​វា​នឹង​ប្រើ​មូលដ្ឋាន​បច្ចុប្បន្ន ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ en</p>\n"

#: cupsd.conf.template.cpp:56
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Document directory (DocumentRoot)</b>\n"
"<p>\n"
"The root directory for HTTP documents that are served.\n"
"By default the compiled-in directory.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/doc</p>\n"
msgstr ""
"<b>ថត​ឯកសារ (DocumentRoot)</b>\n"
"<p>\n"
"ថត root សម្រាប់​ឯកសារ HTTP ដែល​ត្រូវបាន​​បម្រើ ។\n"
"តាមលំនាំដើម គឺ​ថត​ដែលបាន​ចងក្រង​ខាងក្នុង ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /usr/share/cups/doc</p>\n"

#: cupsd.conf.template.cpp:64
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Error log (ErrorLog)</b>\n"
"<p>\n"
"The error log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/error_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/error_log</p>\n"
msgstr ""
"<b>កំណត់ហេតុ​កំហុស (ErrorLog)</b>\n"
"<p>\n"
"ឯកសារ​កំណត់ហេតុ​កំហុស ។ ប្រសិនបើ​វា​មិន​ចាប់ផ្ដើម​ដោយ​សញ្ញា /\n"
"នោះ​វា​ត្រូវ​បាន​សន្មត់​ថា​ទាក់អត​នឹង ServerRoot ។ តាម​លំនាំដើម ត្រូវ​បាន​កំណត់​ទៅ \n"
"\"/var/log/cups/error_log\" ។</p>\n"
"<p>\n"
"អ្នក​ក៏​អាច​ប្រើ​ឈ្មោះ​ពិសេស <b>syslog</b> ផង​ដែរ​ដើម្បី​ផ្ញើ​លទ្ធផល​​ទៅ​\n"
"ឯកសារ syslog ឬ daemon ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /var/log/cups/error_log</p>\n"

#: cupsd.conf.template.cpp:76
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Font path (FontPath)</b>\n"
"<p>\n"
"The path to locate all font files (currently only for pstoraster).\n"
"By default /usr/share/cups/fonts.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/fonts</p>\n"
msgstr ""
"<b>ផ្លូវ​ពុម្ព​អក្សរ (FontPath)</b>\n"
"<p>\n"
"ផ្លូវ​ដែល​ត្រូវ​ដាក់​​ឯកសារ​ពុម្ព​អក្សរ​ទាំងអស់ (បច្ចុប្បន្ន គឺ​សម្រាប់​តែ pstoraster ប៉ុណ្ណោះ)។\n"
"តាម​លំនាំ​ដើម​គឺ /usr/share/cups/fonts ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /usr/share/cups/fonts</p>\n"

#: cupsd.conf.template.cpp:84
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Log level (LogLevel)</b>\n"
"<p>\n"
"Controls the number of messages logged to the ErrorLog\n"
"file and can be one of the following:</p>\n"
"<ul type=circle>\n"
"<li><i>debug2</i>:     Log everything.</li>\n"
"<li><i>debug</i>:     Log almost everything.</li>\n"
"<li><i>info</i>:      Log all requests and state changes.</li>\n"
"<li><i>warn</i>:      Log errors and warnings.</li>\n"
"<li><i>error</i>:     Log only errors.</li>\n"
"<li><i>none</i>:      Log nothing.</li>\n"
"</ul><p>\n"
"<i>ex</i>: info</p>\n"
msgstr ""
"<b>កម្រិត​កំណត់ហេតុ (LogLevel)</b>\n"
"<p>\n"
"ត្រួតពិនិត្យ​ចំនួន​សារ​ដែល​បាន​ចុះកំណត់ហេតុ​ទៅ​ឯកសារ ErrorLog\n"
"និង​អាច​ដូចជា​​ខាងក្រោម ៖</p>\n"
"<ul type=circle>\n"
"<li><i>បំបាត់​កំហុស ២</i> ៖     ចុះកំណត់ហេតុ​អ្វីៗ​ទាំង​អស់ ។</li>\n"
"<li><i>បំបាត់​កំហុស</i> ៖     ចុះកំណត់ហេតុ​ស្ទើរ​តែ​ទាំងអស់ ។</li>\n"
"<li><i>ព័ត៌មាន</i> ៖      ចុះកំណត់ហេតុ​នូវ​សំណើ និង​ការ​ផ្លាស់ប្ដូរ​សភាព​ទាំងអស់ ។</li>\n"
"<li><i>ព្រមាន</i> ៖      ចុះ​កំណត់ហេតុ​កំហុស និង​ការ​ព្រមាន ។</li>\n"
"<li><i>កំហុស</i> ៖     ចុះកំណត់ហេតុ​តែ​កំហុស​ប៉ុណ្ណោះ ។</li>\n"
"<li><i>គ្មាន</i> ៖      មិន​ចុះ​កំណត់ហេតុ​អ្វី​ទាំងអស់ ។</li>\n"
"</ul><p>\n"
"<i>ឧ.</i> ៖ info</p>\n"

#: cupsd.conf.template.cpp:99
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max log size (MaxLogSize)</b>\n"
"<p>\n"
"Controls the maximum size of each log file before they are\n"
"rotated.  Defaults to 1048576 (1MB).  Set to 0 to disable log rotating.</p>\n"
"<p>\n"
"<i>ex</i>: 1048576</p>\n"
msgstr ""
"<b>ទំហំ​កំណត់​ហេតុ​អតិបរមា (MaxLogSize)</b>\n"
"<p>\n"
"ត្រួត​ពិនិត្យ​ទំហំ​អតិបរមា​នៃ​ឯកសារ​កំណត់​ហេតុ​នីមួយៗ មុន​ពេល​បង្វិល​ពួកវា ។\n"
"កំណត់​លំនាំ​ដើម​ទៅ ១០៤៨៥៧៦ (១ ម.ប.) ។ កំណត់​ទៅ ០ ដើម្បី​បិទ​ការ​បង្វិល​កំណត់​ហេតុ ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ១០៤៨៥៧៦</p>\n"

#: cupsd.conf.template.cpp:107
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Page log (PageLog)</b>\n"
"<p>\n"
"The page log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/page_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/page_log</p>\n"
msgstr ""
"<b>កំណត់​ហេតុ​​ទំព័រ (PageLog)</b>\n"
"<p>\n"
"ឯកសារ​កំណត់ហេតុ​​ទំព័រ ។ បើ​វា​មិន​ចាប់ផ្ដើម​ដោយ​សញ្ញា /\n"
"នោះ​វា​នឹង​ត្រូវបាន​សន្មត់​​ថា​ទាក់ទង​នឹង ServerRoot ។ តាមលំនាំ​ដើម​ កំណត់​ទៅ\n"
"\"/var/log/cups/page_log\" ។</p>\n"
"<p>\n"
"អ្នក​ក៏​អាច​ប្រើ​ឈ្មោះ​ពិសេស <b>syslog</b> ផងដែរ​ដើម្បី​ផ្ញើលទ្ធផល​​ទៅ\n"
"ឯកសារ syslog ឬ daemon ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /var/log/cups/page_log</p>\n"

#: cupsd.conf.template.cpp:119
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Preserve job history (PreserveJobHistory)</b>\n"
"<p>\n"
"Whether or not to preserve the job history after a\n"
"job is completed, canceled, or stopped.  Default is Yes.</p>\n"
"<p>\n"
"<i>ex</i>: Yes</p>\n"
msgstr ""
"<b>រក្សាទុក​​​​ប្រវត្តិ​ការងារ (PreserveJobHistory)</b>\n"
"<p>\n"
"ថាតើត្រូវរក្សាទុក​​ប្រវត្តិ​ការងារ​បន្ទាប់​ពី​បាន​បញ្ចប់​ការ​ងារ​មួយ\n"
" ឬ​បោះ​បង់ ឬ​បញ្ឈប់ ។ លំនាំ​ដើម​ គឺ​បាទ/ចាស ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ បាទ/ចាស</p>\n"

#: cupsd.conf.template.cpp:127
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Preserve job files (PreserveJobFiles)</b>\n"
"<p>\n"
"Whether or not to preserve the job files after a\n"
"job is completed, canceled, or stopped.  Default is No.</p>\n"
"<p>\n"
"<i>ex</i>: No</p>\n"
msgstr ""
"<b>រក្សាទុក​​ឯកសារ​ការងារ (PreserveJobFiles)</b>\n"
"<p>\n"
"ថា​តើត្រូវ​រក្សាទុក​​ឯកសារ​ការ​ងារ​បន្ទាប់​ពី​បាន​បញ្ចប់ការងារ\n"
"ឬ​បោះបង់ ឬ​បញ្ឈប់ ។ លំនាំ​ដើមគឺ ទេ ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ទេ</p>\n"

#: cupsd.conf.template.cpp:135
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Printcap file (Printcap)</b>\n"
"<p>\n"
"The name of the printcap file.  Default is no filename.\n"
"Leave blank to disable printcap file generation.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/printcap</p>\n"
msgstr ""
"<b>ឯកសារ Printcap (Printcap)</b>\n"
"<p>\n"
"ឈ្មោះ​របស់​ឯកសារ Printcap ។ លំនាំ​ដើម ​គឺ​គ្មាន​​ឈ្មោះ​ឯកសារ ។\n"
"ទុក​វា​ឲ្យ​នៅ​ទទេ ដើម្បី​បិទ​ការ​បង្កើត​ឯកសារ printcap ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖/etc/printcap</p>\n"

#: cupsd.conf.template.cpp:143
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Request directory (RequestRoot)</b>\n"
"<p>\n"
"The directory where request files are stored.\n"
"By default /var/spool/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups</p>\n"
msgstr ""
"<b>ថត​សំណើ (RequestRoot)</b>\n"
"<p>\n"
"ថត​ដែល​ទុក​​ឯកសារស្នើ ។\n"
"តាម​លំនាំ​ដើម​គឺ /var/spool/cups ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /var/spool/cups</p>\n"

#: cupsd.conf.template.cpp:151
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Remote root user (RemoteRoot)</b>\n"
"<p>\n"
"The name of the user assigned to unauthenticated accesses\n"
"from remote systems.  By default \"remroot\".</p>\n"
"<p>\n"
"<i>ex</i>: remroot</p>\n"
msgstr ""
"<b>អ្នក​ប្រើ root ពី​ចម្ងាយ (RemoteRoot)</b>\n"
"<p>\n"
"ឈ្មោះ​អ្នក​ប្រើ​ត្រូវ​បាន​ផ្ដល់​ទៅ​ឲ្យ​ដំណើរការ​​ដែល​​​មិន​បាន​ផ្ទៀង​ផ្ទាត់​ភាព​ត្រឹមត្រូវ\n"
"ពី​ប្រព័ន្ធ​ពី​ចម្ងាយ ។ តាម​លំនាំ​ដើម​គឺ \"remroot\"។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ remroot</p>\n"

#: cupsd.conf.template.cpp:159
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server binaries (ServerBin)</b>\n"
"<p>\n"
"The root directory for the scheduler executables.\n"
"By default /usr/lib/cups or /usr/lib32/cups (IRIX 6.5).</p>\n"
"<p>\n"
"<i>ex</i>: /usr/lib/cups</p>\n"
msgstr ""
"<b>ប្រព័ន្ធ​គោល​ពីរ​ម៉ាស៊ីន​បម្រើ (ServerBin)</b>\n"
"<p>\n"
"ថត root សម្រាប់​ឯកសារ​ដែល​អាច​​ប្រតិបត្តិកម្មវិធី​កំណត់ពេល​បាន ។\n"
"តាម​លំនាំ​ដើម​គឺ /usr/lib/cups ឬ /usr/lib32/cups (IRIX 6.5)។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /usr/lib/cups</p>\n"

#: cupsd.conf.template.cpp:167
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server files (ServerRoot)</b>\n"
"<p>\n"
"The root directory for the scheduler.\n"
"By default /etc/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups</p>\n"
msgstr ""
"<b>ឯកសារ​ម៉ាស៊ីន​បម្រើ (ServerRoot)</b>\n"
"<p>\n"
"ថត root សម្រាប់​កម្មវិធី​កំណត់ពេល ។\n"
"តាម​លំនាំ​ដើម​គឺ /etc/cups ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /etc/cups</p>\n"

#: cupsd.conf.template.cpp:175
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>User (User)</b>\n"
"<p>\n"
"The user the server runs under.  Normally this\n"
"must be <b>lp</b>, however you can configure things for another user\n"
"as needed.</p>\n"
"<p>\n"
"Note: the server must be run initially as root to support the\n"
"default IPP port of 631.  It changes users whenever an external\n"
"program is run...</p>\n"
"<p>\n"
"<i>ex</i>: lp</p>\n"
msgstr ""
"<b>អ្នក​ប្រើ (User)</b>\n"
"<p>\n"
"អ្នក​ប្រើ​ដែល​គ្រប់គ្រង​ម៉ាស៊ីន​បម្រើ ។ ជា​ធម្មតាវា​ត្រូវ​តែ​ជា\n"
"<b>lp</b> ទោះជា​យ៉ាង​ណាក៏ដោយ អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​នូវ​អ្វី​មួយ​ចំនួន​​\n"
"សម្រាប់​អ្នក​ប្រើ​ផ្សេង​ទៀត​តាម​តម្រូវការ ។</p>\n"
"<p>\n"
"ចំណាំ ៖ ម៉ាស៊ីន​បម្រើ​ត្រូវ​រត់ជា root នៅពេល​ចាប់​ផ្តើម​ដំបូង ដើម្បី​គាំទ្រ\n"
"ច្រក IPP លំនាំដើម​នៃ 631 ។ វា​ផ្លាស់​ប្តូរ​អ្នក​ប្រើ រាល់​ពេល​ដែល​កម្មវិធីខាង​ក្រៅ\n"
"រត់...</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ lp</p>\n"

#: cupsd.conf.template.cpp:188
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Group (Group)</b>\n"
"<p>\n"
"The group the server runs under.  Normally this\n"
"must be <b>sys</b>, however you can configure things for another\n"
"group as needed.</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"
msgstr ""
"<b>ក្រុម (Group)</b>\n"
"<p>\n"
"ក្រុម​ដែល​គ្រប់គ្រង​​ម៉ាស៊ីន​បម្រើ ។ ជា​ធម្មតាវា​\n"
"ត្រូវ​តែ​ជា <b>sys</b> ទោះបី​ជាយ៉ាង​ណាក៏ដោយ អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​នូវ​អ្វី​​\n"
"មួយ​ចំនួន​សម្រាប់​ក្រុម​ផ្សេងទៀត​តាម​តម្រូវការ ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ sys</p>\n"

#: cupsd.conf.template.cpp:197
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>RIP cache (RIPCache)</b>\n"
"<p>\n"
"The amount of memory that each RIP should use to cache\n"
"bitmaps.  The value can be any real number followed by \"k\" for\n"
"kilobytes, \"m\" for megabytes, \"g\" for gigabytes, or \"t\" for tiles\n"
"(1 tile = 256x256 pixels).  Defaults to \"8m\" (8 megabytes).</p>\n"
"<p>\n"
"<i>ex</i>: 8m</p>\n"
msgstr ""
"<b>ឃ្លាំង​សម្ងាត់ RIP (RIPCache)</b>\n"
"<p>\n"
"ចំនួន​​​សតិ​សរុប​ដែល RIP នីមួយៗ​ប្រើ​ដើម្បី​ទុករូបភាព​ក្នុង​​ឃ្លាំង​សម្ងាត់ ។\n"
"តំលៃ​អាច​ជា​​ចំនួន​ពិត​ដែល​ដាក់​ពី​ក្រោយ​ដោយ \"k\" សម្រាប់\n"
"គីឡូបៃ \"m\" សម្រាប់​មេកាបៃ \"g\" សម្រាប់​ជីកាបៃ ឬ \"t\" សម្រាប់​ក្រឡា\n"
"(១ ក្រឡា = ២៥៦x២៥៦ ភីកសែល) ។ លំនាំ​ដើម​គឺ \"8m\" (៨ មេកាបៃ)។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ 8m</p>\n"

#: cupsd.conf.template.cpp:207
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Temporary files (TempDir)</b>\n"
"<p>\n"
"The directory to put temporary files in. This directory must be\n"
"writable by the user defined above!  Defaults to \"/var/spool/cups/tmp\" or\n"
"the value of the TMPDIR environment variable.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups/tmp</p>\n"
msgstr ""
"<b>ឯកសារ​បណ្តោះ​អាសន្ន (TempDir)</b>\n"
"<p>\n"
"ថតដែល​ត្រូវទុក​​ឯកសារ​បណ្តោះ​អាសន្ន​ ។ ថតនេះ​ត្រូវ​តែ​អាច​សរសេរ​បាន​\n"
"​ដោយ​អ្នក​ប្រើដែល​បាន​កំណត់​​ខាង​លើ ! កំណត់​លំនាំដើម​ទៅ \"/var/spool/cups/tmp\" ឬ \n"
"តម្លៃ​​របស់​អថេរបរិស្ថាន TMPDIR ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ /var/spool/cups/tmp</p>\n"

#: cupsd.conf.template.cpp:216
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Filter limit (FilterLimit)</b>\n"
"<p>\n"
"Sets the maximum cost of all job filters that can be run\n"
"at the same time.  A limit of 0 means no limit.  A typical job may need\n"
"a filter limit of at least 200; limits less than the minimum required\n"
"by a job force a single job to be printed at any time.</p>\n"
"<p>\n"
"The default limit is 0 (unlimited).</p>\n"
"<p>\n"
"<i>ex</i>: 200</p>\n"
msgstr ""
"<b>ព្រំដែន​តម្រង (FilterLimit)</b>\n"
"<p>\n"
"កំណត់​តម្លៃ​​អតិបរមា​នៃ​តម្រង​ការ​ងារ​ទាំង​អស់​ដែល​អាច​រត់​នៅ\n"
"ពេលដំណាល​គ្នា ។ ព្រំដែន ០ មាន​ន័យ​ថា​គ្មាន​ព្រំដែន ។ ការ​ងារ​ធម្មតា​អាច​ត្រូវ​ការ\n"
"​ព្រំដែន​​តម្រង​យ៉ាង​ហោច​ណាស់ ២០០ ។ ព្រំដែន​ដែល​​​តិច​ជាង​កម្រិត​អប្បបរមា​ត្រូវ​ការ\n"
"ដោយការងារ​មួយ ដែល​តម្រូវ​​ឲ្យ​បោះពុម្ព​ការងារ​តែ​មួយ​នៅ​ពេល​​ណា​មួយ ។</p>\n"
"<p>\n"
"ព្រំដែន​​​លំនាំ​ដើម​គឺ ០ (មិន​កំណត់) ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ ២០០</p>\n"

#: cupsd.conf.template.cpp:228
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Listen to (Port/Listen)</b>\n"
"<p>\n"
"Ports/addresses that are listened to.  The default port 631 is reserved\n"
"for the Internet Printing Protocol (IPP) and is what is used here.</p>\n"
"<p>\n"
"You can have multiple Port/Listen lines to listen to more than one\n"
"port or address, or to restrict access.</p>\n"
"<p>\n"
"Note: Unfortunately, most web browsers don't support TLS or HTTP Upgrades\n"
"for encryption.  If you want to support web-based encryption you will\n"
"probably need to listen on port 443 (the \"HTTPS\" port...).</p>\n"
"<p>\n"
"<i>ex</i>: 631, myhost:80, 1.2.3.4:631</p>\n"
msgstr ""
"<b>ស្តាប់ (Port/Listen)</b>\n"
"<p>\n"
"ច្រក/អាសយដ្ឋាន​ដែល​ត្រូវ​ស្ដាប់ ។ តាមលំនាំ​ដើម​ច្រក ៦៣១ គឺ​ត្រូវបាន​បម្រុង​ទុក​\n"
"សម្រាប់ Internet Printing Protocol  (IPP) និង​ជា​អ្វី​ដែល​ត្រូវ​ប្រើ​នៅ​ទី​នេះ ។</p>\n"
"<p>\n"
"\n"
"អ្នក​អាច​មាន​ច្រក/​អាសយដ្ឋាន​ច្រើន​ដែលត្រូវ​ស្ដាប់​ច្រើន​ជាង​ច្រក ឬ​អាសយដ្ឋាន​មួយ ឬ​ត្រូវ​ដាក់​កម្រិត​ការ​ចូល​"
"ដំណើរការ ។</p>\n"
"<p>\n"
"ចំណាំ ៖ ជាអកុសល កម្មវិធី​​រុក​រក​បណ្តាញ​ភាគ​ច្រើន​​មិន​​គាំ​ទ្រ​ការ​ធ្វើ​ឲ្យ TLS ឬ HTTP ប្រសើរ​​សម្រាប់\n"
"ការ​បម្លែង​ជា​​កូដ​ឡើយ ។ ប្រសិន​បើ​អ្នកចង់​​គាំ​ទ្រ​ការ​បម្លែង​​ជា​កូដ​ដោយ​ផ្អែក​លើ​បណ្តាញ​\n"
"អ្នក​ត្រូវ​ស្ដាប់​ច្រក ៤៤៣ ( ច្រក \"HTTPS\" ...) ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ៦៣១,myhost:80, 1.2.3.4:631១</p>\n"

#: cupsd.conf.template.cpp:243
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Hostname lookups (HostNameLookups)</b>\n"
"<p>\n"
"Whether or not to do lookups on IP addresses to get a\n"
"fully-qualified hostname.  This defaults to Off for performance reasons...</"
"p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>ការ​រកមើល​ឈ្មោះ​ម៉ាស៊ីន (HostNameLookups)</b>\n"
"<p>\n"
"ថា​តើ​ត្រូវ​​រក​មើល​លើ​អាសយដ្ឋាន IP ដើម្បី​ទទួលបាន\n"
"ឈ្មោះ​ម៉ាស៊ីន​ពេញលេញ​ឬអត់ ។ វា​កំណត់​លំនាំ​ដើមទៅ បិទ សម្រាប់ហេតុផល​ដំណើរការ​...</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ បើក</p>\n"

#: cupsd.conf.template.cpp:251
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Keep alive (KeepAlive)</b>\n"
"<p>\n"
"Whether or not to support the Keep-Alive connection\n"
"option.  Default is on.</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>ទុក​ឲ្យ​សកម្ម (KeepAlive)</b>\n"
"<p>\n"
"ថា​តើ​ត្រូវ​គាំទ្រ​ជម្រើស​ការ​​ត​ភ្ជាប់​ទុក​ឲ្យ​​សកម្ម​ឬ​អត់ ។\n"
"លំនាំ​ដើម​ គឺ បើក ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ បើក</p>\n"

#: cupsd.conf.template.cpp:259
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Keep-alive timeout (KeepAliveTimeout)</b>\n"
"<p>\n"
"The timeout (in seconds) before Keep-Alive connections are\n"
"automatically closed.  Default is 60 seconds.</p>\n"
"<p>\n"
"<i>ex</i>: 60</p>\n"
msgstr ""
"<b>អស់​​ពេល​ទុក​ឲ្យ​សកម្ម (KeepAliveTimeout)</b>\n"
"<p>\n"
"ពេលវេលា​អស់ (គិតជា​វិនាទី) មុន​ពេល​ការតភ្ជាប់​ទុក​ឲ្យ​សកម្ម​ត្រូវ​បាន\n"
"​បិទ​ដោយ​ស្វ័យ​ប្រវត្តិ ។ តាម​លំនាំ​ដើម​គឺ ៦០ វិនាទី ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ ៦០</p>\n"

#: cupsd.conf.template.cpp:267
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max clients (MaxClients)</b>\n"
"<p>\n"
"Controls the maximum number of simultaneous clients that\n"
"will be handled.  Defaults to 100.</p>\n"
"<p>\n"
"<i>ex</i>: 100</p>\n"
msgstr ""
"<b>ម៉ាស៊ីន​ភ្ញៀវ​អតិបរមា (MaxClients)</b>\n"
"<p>\n"
"ត្រួតពិនិត្យ​ចំនួន​ម៉ាស៊ីនភ្ញៀវ​កើត​ឡើង​ដំណាល​គ្នា​អតិបរមា\n"
"​ដែល​នឹង​​ត្រូវ​ដោះ​ស្រាយ ។ កំណត់​លំនាំដើម​ទៅ ១០០ ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ១០០</p>\n"

#: cupsd.conf.template.cpp:275
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max request size (MaxRequestSize)</b>\n"
"<p>\n"
"Controls the maximum size of HTTP requests and print files.\n"
"Set to 0 to disable this feature (defaults to 0).</p>\n"
"<p>\n"
"<i>ex</i>: 0</p>\n"
msgstr ""
"<b>ទំហំ​សំណើ​អតិបរមា (MaxRequestSize)</b>\n"
"<p>\n"
"ត្រួត​ពិនិត្យ​ទំហំអតិបរមា​នៃ​សំណើ HTTP និង​ឯកសារ​​បោះពុម្ព ។\n"
"កំណត់​ទៅ ០ ដើម្បី​បិទ​លក្ខណៈ​ពិសេស​នេះ (កំណត់​លំនាំដើម​ទៅ ០)។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ០</p>\n"

#: cupsd.conf.template.cpp:283
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Client timeout (Timeout)</b>\n"
"<p>\n"
"The timeout (in seconds) before requests time out.  Default is 300 seconds.</"
"p>\n"
"<p>\n"
"<i>ex</i>: 300</p>\n"
msgstr ""
"<b>អស់ពេល​ម៉ាស៊ីន​ភ្ញៀវ (Timeout)</b>\n"
"<p>\n"
"ពេលវេលា​អស់ (គិត​ជា​វិនាទី) មុន​ពេល​សំណើ​អស់ពេល ។ លំនាំ​ដើម​គឺ ៣០០ វិនាទី ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ៣០០</p>\n"

#: cupsd.conf.template.cpp:290
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Use browsing (Browsing)</b>\n"
"<p>\n"
"Whether or not to <b>listen</b> to printer \n"
"information from other CUPS servers.  \n"
"</p>\n"
"<p>\n"
"Enabled by default.\n"
"</p>\n"
"<p>\n"
"Note: to enable the <b>sending</b> of browsing\n"
"information from this CUPS server to the LAN,\n"
"specify a valid <i>BrowseAddress</i>.\n"
"</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>ប្រើ​ការ​រុក​រក (Browsing)</b>\n"
"<p>\n"
"ថា​តើត្រូវ​<b>ស្ដាប់</b>​ព័ត៌មានម៉ាស៊ីន​បោះពុម្ព\n"
"​ពី​ម៉ាស៊ីន​បម្រើ CUPS ផ្សេងៗឬ​អត់ ។  \n"
"</p>\n"
"<p>\n"
"​តាម​លំនាំ​ដើម​គឺ​​ត្រូវបានបើក ។\n"
"</p>\n"
"<p>\n"
"ចំណាំ ៖ ដើម្បី​បើក​<b>ការ​ផ្ញើ</b>​នៃព័ត៌មាន​​រុក​រក\n"
"​ពី​ម៉ាស៊ីន​បម្រើ CUPS នេះ​ទៅ​កាន់ LAN\n"
"គឺ​ត្រូវ​​បញ្ជាក់ <i>អាសយដ្ឋាន​រុក​រក</i>ឲ្យបាន​ត្រឹមត្រូវ ។\n"
"</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ បើក</p>\n"

#: cupsd.conf.template.cpp:307
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Use short names (BrowseShortNames)</b>\n"
"<p>\n"
"Whether or not to use \"short\" names for remote printers\n"
"when possible (e.g. \"printer\" instead of \"printer@host\").  Enabled by\n"
"default.</p>\n"
"<p>\n"
"<i>ex</i>: Yes</p>\n"
msgstr ""
"<b>ប្រើ​ឈ្មោះ​ខ្លី (BrowseShortNames)</b>\n"
"<p>\n"
"ថា​តើត្រូវ​ប្រើ​ឈ្មោះ​\"ខ្លី\"​សម្រាប់​​ម៉ាស៊ីន​បោះពុម្ព​ពី​ចម្ងាយ\n"
"នៅ​ពេល​ដែល​អាចធ្វើ​បាន​ឬអត់ (ឧ. \"printer\" ជំនួសឲ្យ \"printer@host\") ។\n"
"តាម​លំនាំដើម​គឺ​ត្រូវ​បាន​បើក ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ បាទ/ចាស</p>\n"

#: cupsd.conf.template.cpp:316
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse addresses (BrowseAddress)</b>\n"
"<p>\n"
"Specifies a broadcast address to be used.  By\n"
"default browsing information is broadcast to all active interfaces.</p>\n"
"<p>\n"
"Note: HP-UX 10.20 and earlier do not properly handle broadcast unless\n"
"you have a Class A, B, C, or D netmask (i.e. no CIDR support).</p>\n"
"<p>\n"
"<i>ex</i>: x.y.z.255, x.y.255.255</p>\n"
msgstr ""
"<b>រកមើល​អាសយដ្ឋាន (BrowseAddress)</b>\n"
"<p>\n"
"បញ្ជាក់​អាសយដ្ឋាន​ផ្សាយ​​ដែល​ត្រូវ​ប្រើ ។ តាម​លំនាំដើម\n"
"ព័ត៌មាន​​រុក​រកត្រូវ​បាន​ផ្សាយ​ទៅ​កាន់​គ្រប់ចំណុច​ប្រទាក់​ដែល​សកម្ម​ទាំងអស់ ។</p>\n"
"<p>\n"
"ចំណាំ ៖ HP-UX 10.20 និង​ស៊េរីមុនៗ មិន​អាច​ដោះស្រាយ​​ការ​ផ្សាយ​បាន​ត្រឹមត្រូវ​ទេ​\n"
"លុះ​ត្រាតែ​អ្នក​មាន​ថ្នាក់​របាំង​បណ្ដាញ A, B, C, ឬ D (មាន​ន័យ​ថា គ្មាន​ការ​គាំទ្រ CIDR)។</p>\n"
"<p>\n"
"<i>ឧ˙.</i> ៖ x.y.z.255, x.y.255.255</p>\n"

#: cupsd.conf.template.cpp:327
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse allow/deny (BrowseAllow/BrowseDeny)</b>\n"
"<p>\n"
"<u>BrowseAllow</u>: specifies an address mask to allow for incoming browser\n"
"packets. The default is to allow packets from all addresses.</p>\n"
"<p>\n"
"<u>BrowseDeny</u>: specifies an address mask to deny for incoming browser\n"
"packets. The default is to deny packets from no addresses.</p>\n"
"<p>\n"
"Both \"BrowseAllow\" and \"BrowseDeny\" accept the following notations for\n"
"addresses:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"The hostname/domainname restrictions only work if you have turned hostname\n"
"lookups on!</p>\n"
msgstr ""
"<b>អនុញ្ញាត/បដិសេធ​ការ​​រុក​រក (BrowseAllow/BrowseDeny)</b>\n"
"<p>\n"
"<u>អនុញ្ញាត​​​ការ​រុករក</u> ៖ បញ្ជាក់​​របាំង​អាសយដ្ឋាន​មួយ ​ដើម្បី​អនុញ្ញាត​ដល់​​កញ្ចប់​កម្មវិធីរុករក  ។\n"
"ដែល​នឹង​មក​ដល់ ។ លំនាំ​ដើម​គឺ​អនុញ្ញាត​កញ្ចប់​​ពី​អាសយដ្ឋាន​ទាំងអស់ ។</p>\n"
"<p>\n"
"<u>បដិសេធ​ការ​​រុករក</u>៖ បញ្ជាក់​របាំង​អាសយដ្ឋាន ដើម្បី​បដិសេធ​​កញ្ចប់​កម្មវិធី​រុករក​ដែល​នឹង\n"
"មក​ដល់ ។ លំនាំដើម​គឺ​បដិសេធ​កញ្ចប់​ដែល​គ្មាន​អាសយដ្ឋាន ។</p>\n"
"<p>\n"
"ទាំង \"អនុញ្ញាត​ការ​​រុករក\" និង​\"បដិសេធ​ការ​រុករក\" គឺ​ព្រម​ទទួល​យក​ការ​ជូន​ដំណឹង​ដូច​ខាង​ក្រោម​សម្រាប់\n"
"អាសយដ្ឋាន ៖</p>\n"
"<pre>\n"
"ទាំង​អស់\n"
"គ្មាន\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"ការ​ដាក់​កម្រិត​ឈ្មោះ​ម៉ាស៊ីន/ឈ្មោះ​ដែន គឺ​នឹង​​ដំណើរការ​បាន​តែ​នៅពេលដែល​អ្នក​បានបើក​ការ​ស្វែង​រក\n"
"​ឈ្មោះ​ម៉ាស៊ីន​តែ​ប៉ុណ្ណោះ !\n"
"</p>\n"

#: cupsd.conf.template.cpp:354
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse interval (BrowseInterval)</b>\n"
"<p>\n"
"The time between browsing updates in seconds.  Default\n"
"is 30 seconds.</p>\n"
"<p>\n"
"Note that browsing information is sent whenever a printer's state changes\n"
"as well, so this represents the maximum time between updates.</p>\n"
"<p>\n"
"Set this to 0 to disable outgoing broadcasts so your local printers are\n"
"not advertised but you can still see printers on other hosts.</p>\n"
"<p>\n"
"<i>ex</i>: 30</p>\n"
msgstr ""
"<b>ចន្លោះ​ពេល​​រុក​រក (BrowseInterval)</b>\n"
"<p>\n"
"ពេល​វេលា​រវាង​ការ​​ធ្វើ​​បច្ចុប្បន្នភាព​ការ​រុក​រក​គិត​ជា​វិនាទី ។ តាម​លំនាំ​ដើម\n"
"គឺ ៣០ វិនាទី ។</p>\n"
"<p>\n"
"ចំណាំ​ថា ព័ត៌មាន​រុករក​ត្រូវ​បាន​ផ្ញើ​នៅ​រាល់​ពេល​ដែល​ស្ថានភាព​របស់​ម៉ាស៊ីន​បោះពុម្ព​​ផ្លាស់ប្ដូរដែរ\n"
"ដូច្នេះ ​វា​តំណាង​ឲ្យ​ពេលវេលា​រវាង​​បច្ចុប្បន្នភាព​អតិបរមា ។​</p>\n"
"<p>\n"
"កំណត់​វា​ទៅ 0 ដើម្បី​បិទ​ការ​ផ្សាយ​ចេញ ដូច​នេះ​ម៉ាស៊ីន​បោះពុម្ព​មូលដ្ឋាន​របស់​អ្នក​\n"
"មិន​ផ្សាយចេញទេ ប៉ុន្តែ​អ្នក​នៅ​តែ​អាច​មើល​ឃើញ​ម៉ាស៊ីន​បោះពុម្ព​នៅ​លើ​ម៉ាស៊ីន​ផ្សេង​ទៀត​បាន ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ៣០</p>\n"

#: cupsd.conf.template.cpp:368
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse order (BrowseOrder)</b>\n"
"<p>\n"
"Specifies the order of BrowseAllow/BrowseDeny comparisons.</p>\n"
"<p>\n"
"<i>ex</i>: allow,deny</p>\n"
msgstr ""
"<b>លំដាប់​រុក​រក (BrowseOrder)</b>\n"
"<p>\n"
"បញ្ជាក់​លំដាប់​នៃ​ការ​ប្រៀបធៀប ​អនុញ្ញាតការ​​រុក​រក​/​​បដិសេធការ​​រុក​រក ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ អនុញ្ញាត បដិសេធ</p>\n"

#: cupsd.conf.template.cpp:375
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse poll (BrowsePoll)</b>\n"
"<p>\n"
"Poll the named server(s) for printers.</p>\n"
"<p>\n"
"<i>ex</i>: myhost:631</p>\n"
msgstr ""
"<b>ផូល​រុក​រក (BrowsePoll)</b>\n"
"<p>\n"
"ផូល​​ម៉ាស៊ីន​បម្រើ​​ដែលមាន​ឈ្មោះ​សម្រាប់​​ម៉ាស៊ីន​​បោះ​ពុម្ព ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ myhost:631</p>\n"

#: cupsd.conf.template.cpp:382
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse port (BrowsePort)</b>\n"
"<p>\n"
"The port used for UDP broadcasts.  By default this is\n"
"the IPP port; if you change this you need to do it on all servers.\n"
"Only one BrowsePort is recognized.</p>\n"
"<p>\n"
"<i>ex</i>: 631</p>\n"
msgstr ""
"<b>ច្រក​រុក​រក (BrowsePort)</b>\n"
"<p>\n"
"ច្រក​ដែល​ប្រើ​សម្រាប់​ផ្សាយ UDP ។ តាម​លំនាំ​ដើម​នេះ​ វាគឺ\n"
"ច្រក IPP ។ ប្រសិន​បើ​អ្នក​ផ្លាស់​ប្តូរវា អ្នក​​ត្រូវ​ធ្វើ​វា​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទាំង​អស់ ។\n"
"មាន​តែ​ច្រក​​រុក​រក​មួយ​​ប៉ុណ្ណោះ​​ត្រូវ​បាន​ទទួល​ស្គាល់ ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ ៦៣១</p>\n"

#: cupsd.conf.template.cpp:391
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse relay (BrowseRelay)</b>\n"
"<p>\n"
"Relay browser packets from one address/network to another.</p>\n"
"<p>\n"
"<i>ex</i>: src-address dest-address</p>\n"
msgstr ""
"<b>បញ្ជូន​បន្ត​ការ​រុករក (BrowseRelay)</b>\n"
"<p>\n"
"កញ្ចប់​កម្មវិធី​រុករក​​បញ្ជូន​បន្ត​ពី​អាសយ​ដ្ឋាន/បណ្ដាញ​មួយ​ទៅ​​អាសយដ្ឋាន ឬ​បណ្ដាញ​មួយ​​​ផ្សេង​ទៀត ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ អាសយដ្ឋាន​ប្រភព អាសយដ្ឋាន​ទិស​ដៅ</p>\n"

#: cupsd.conf.template.cpp:398
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse timeout (BrowseTimeout)</b>\n"
"<p>\n"
"The timeout (in seconds) for network printers - if we don't\n"
"get an update within this time the printer will be removed\n"
"from the printer list.  This number definitely should not be\n"
"less the BrowseInterval value for obvious reasons.  Defaults\n"
"to 300 seconds.</p>\n"
"<p>\n"
"<i>ex</i>: 300</p>\n"
msgstr ""
"<b>​​អស់​ពេល​រុករក​ (BrowseTimeout)</b>\n"
"<p>\n"
"ពេលវេលា​អស់ (គិតជា​​វិនាទី) សម្រាប់​ម៉ាស៊ីន​បោះ​ពុម្ព​បណ្តាញ - ប្រសិន​បើ​យើង​មិន\n"
"​ធ្វើ​បច្ចុប្បន្នភាព​ក្នុង​ពេល​​នេះទេ នោះ​ម៉ាស៊ីន​បោះពុម្ព​នឹង​ត្រូវ​បាន​យក​ចេញ\n"
"ពី​បញ្ជី​ម៉ាស៊ីន​បោះ​ពុម្ព ។ ចំនួន​នេះ​គឺ​ដាច់ខាត​​មិនអាច​តិច\n"
"ជាង​តំលៃ​ចន្លោះ​ពេល​​រុក​រក​ទេ ។ លំនាំ​ដើម\n"
"គឺ ៣០០ វិនាទី ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ ៣០០</p>\n"

#: cupsd.conf.template.cpp:409
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Implicit classes (ImplicitClasses)</b>\n"
"<p>\n"
"Whether or not to use implicit classes.</p>\n"
"<p>\n"
"Printer classes can be specified explicitly in the classes.conf\n"
"file, implicitly based upon the printers available on the LAN, or\n"
"both.</p>\n"
"<p>\n"
"When ImplicitClasses is On, printers on the LAN with the same name\n"
"(e.g. Acme-LaserPrint-1000) will be put into a class with the same\n"
"name. This allows you to setup multiple redundant queues on a LAN\n"
"without a lot of administrative difficulties.  If a user sends a\n"
"job to Acme-LaserPrint-1000, the job will go to the first available\n"
"queue.</p>\n"
"<p>\n"
"Enabled by default.</p>\n"
msgstr ""
"<b>ថ្នាក់​ខាងក្នុង (ImplicitClasses)</b>\n"
"<p>\n"
"ថាតើ​ត្រូវ​ប្រើ​ថ្នាក់​ខាង​ក្នុង ឬ​អត់ ។</p>\n"
"<p>\n"
"ថ្នាក់​​ម៉ាស៊ីន​បោះពុម្ព​អាច​ត្រូវ​បាន​បញ្ជាក់​នៅ​ខាងក្នុង​ឯកសារ classes.conf\n"
"ថ្នាក់​ខាងក្នុង​​​ផ្អែក​លើ​ម៉ាស៊ីន​បោះពុម្ព​ដែល​មាន​នៅ​លើ LAN ឬ\n"
"ទាំង​ពីរ ។</p>\n"
"<p>\n"
"ពេល ImplicitClasses ​​បើក ម៉ាស៊ីន​បោះពុម្ព​នៅ​លើ LAN ដែល​មាន​ឈ្មោះ​ដូច​គ្នា\n"
"(ឧទា. Acme-LaserPrint-1000) នឹង​ត្រូវ​បាន​ដាក់​ក្នុង​ថ្នាក់​មួយ​ដែល​មាន​ឈ្មោះ​ដូច​គ្នា ។\n"
"វា​អនុញ្ញាត​ឲ្យ​អ្នក​រៀបចំ​ជួរស្ទួន​គ្នា​ជា​ច្រើន​នៅ​លើ LAN\n"
"ដោយ​មិន​ពិបាក​ក្នុង​ការ​គ្រប់​គ្រង​ឡើយ ។ ​ប្រសិនបើ​អ្នក​ប្រើ​ម្នាក់​ផ្ញើ\n"
"ការ​ងារមួយ​ទៅ Acme-LaserPrint-1000 នោះ​ការ​ងារ​នឹង​ទៅ​កាន់​ជួរ​ដែល​មាន​ដំបូង ។\n"
"</p>\n"
"<p>\n"
"តាម​លំនាំដើម គឺ​ត្រូវ​បាន​បើក ។</p>\n"

#: cupsd.conf.template.cpp:427
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>System group (SystemGroup)</b>\n"
"<p>\n"
"The group name for \"System\" (printer administration)\n"
"access.  The default varies depending on the operating system, but\n"
"will be <b>sys</b>, <b>system</b>, or <b>root</b> (checked for in that "
"order).</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"
msgstr ""
"<b>ក្រុម​ប្រព័ន្ធ (SystemGroup)</b>\n"
"<p>\n"
"ឈ្មោះ​ក្រុម​សម្រាប់ចូល​ដំណើរការ \"ប្រព័ន្ធ\" (ការ​គ្រប់គ្រង​ម៉ាស៊ីន​បោះពុម្ព) ។\n"
"លំនាំ​ដើម​ផ្លាស់ប្ដូរ​ដោយ​អាស្រ័យ​តាម​​ប្រព័ន្ធ​ប្រតិបត្តិការ ប៉ុន្តែ\n"
"នឹងជា <b>sys</b>, <b>system</b>, ឬ <b>root</b> (ពិនិត្យ​រក​មើល​នៅ​ក្នុង​លំដាប់​នោះ) ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ sys</p>\n"

#: cupsd.conf.template.cpp:436
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Encryption certificate (ServerCertificate)</b>\n"
"<p>\n"
"The file to read containing the server's certificate.\n"
"Defaults to \"/etc/cups/ssl/server.crt\".</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.crt</p>\n"
msgstr ""
"<b>វិញ្ញាបនបត្រ​បម្លែង​ជា​កូដ (ServerCertificate)</b>\n"
"<p>\n"
"ឯកសារ​ដែល​​ត្រូវ​អាន​មាន​វិញ្ញាបនបត្រ​របស់​ម៉ាស៊ីន​បម្រើ ។\n"
"តាម​លំនាំ​ដើមគឺ \"/etc/cups/ssl/server.crt\" ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ /etc/cups/ssl/server.crt</p>\n"

#: cupsd.conf.template.cpp:444
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Encryption key (ServerKey)</b>\n"
"<p>\n"
"The file to read containing the server's key.\n"
"Defaults to \"/etc/cups/ssl/server.key\".</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.key</p>\n"
msgstr ""
"<b>កូនសោ​បម្លែង​ជា​កូដ (ServerKey)</b>\n"
"<p>\n"
"ឯកសារ​ដែល​​ត្រូវ​អាន​មាន​កូនសោ​​របស់​ម៉ាស៊ីន​បម្រើ ។\n"
"កំណត់​លំនាំដើម​ទៅ \"/etc/cups/ssl/server.key\" ។</p>\n"
"<p>\n"
"<i>ឧ.</i>៖ /etc/cups/ssl/server.key</p>\n"

#: cupsd.conf.template.cpp:452
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"Access permissions\n"
"# Access permissions for each directory served by the scheduler.\n"
"Locations are relative to DocumentRoot...\n"
"# AuthType: the authorization to use:\n"
"#    None   - Perform no authentication\n"
"Basic  - Perform authentication using the HTTP Basic method.\n"
"Digest - Perform authentication using the HTTP Digest method.\n"
"#    (Note: local certificate authentication can be substituted by\n"
"the client for Basic or Digest when connecting to the\n"
"localhost interface)\n"
"# AuthClass: the authorization class; currently only Anonymous, User,\n"
"System (valid user belonging to group SystemGroup), and Group\n"
"(valid user belonging to the specified group) are supported.\n"
"# AuthGroupName: the group name for \"Group\" authorization.\n"
"# Order: the order of Allow/Deny processing.\n"
"# Allow: allows access from the specified hostname, domain, IP address, or\n"
"network.\n"
"# Deny: denies access from the specified hostname, domain, IP address, or\n"
"network.\n"
"# Both \"Allow\" and \"Deny\" accept the following notations for addresses:\n"
"#     All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"# The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.\n"
"# Encryption: whether or not to use encryption; this depends on having\n"
"the OpenSSL library linked into the CUPS library and scheduler.\n"
"# Possible values:\n"
"#     Always       - Always use encryption (SSL)\n"
"Never        - Never use encryption\n"
"Required     - Use TLS encryption upgrade\n"
"IfRequested  - Use encryption if the server requests it\n"
"# The default value is \"IfRequested\".\n"
msgstr ""
"សិទ្ធិ​ចូល​​ដំណើរការ\n"
"# សិទ្ធិ​ចូល​ដំណើរការ​​សម្រាប់​ថត​នីមួយៗ​ដែល​បានបម្រើ​​ដោយ​កម្មវិធី​កំណត់​ពេល ។\n"
"ទីតាំង​គឺ​​ទាក់ទង​នឹង DocumentRoot...\n"
"# AuthType ៖ សេចក្តី​អនុញ្ញាត​ដែល​ត្រូវ​ប្រើ ៖\n"
"#    គ្មាន   - ប្រតិបត្តិ​ដោយ​គ្មានការ​​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ\n"
"មូល​ដ្ឋាន  - ប្រតិបត្តិ​​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវដោយប្រើ​វិធី​សាស្ត្រ​​មូល​ដ្ឋាន HTTP ។\n"
"Digest - ប្រតិបត្តិ​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដោយ​ប្រើ​វិធី​សាស្ដ្រ Digest HTTP ។\n"
"#    (ចំណាំ ៖ ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​នៃវិញ្ញាបនបត្រមូលដ្ឋាន​អាច​ត្រូវ​បាន​ជំនួស​ដោយ​\n"
"ម៉ាស៊ីន​ភ្ញៀវ​សម្រាប់​មូលដ្ឋាន ឬ Digest នៅពេល​ត​ភ្ជាប់​ទៅ\n"
"ចំណុច​ប្រទាក់​ម៉ាស៊ីន​មូលដ្ឋាន(localhost))\n"
"#  AuthClass ៖ ថ្នាក់​សេចក្តី​អនុញ្ញាត ។ បច្ចុប្បន្ន​មាន​តែជនអនាមិក អ្នក​ប្រើ​\n"
"ប្រព័ន្ធ (អ្នក​ប្រើ​ត្រឹមត្រូវ​របស់ក្រុម SystemGroup) និង​ក្រុម\n"
"(អ្នក​ប្រើ​ត្រឹមត្រូវ​របស់​ក្រុម​ដែល​បាន​បញ្ជាក់) ប៉ុណ្ណោះ​ដែល​ត្រូវ​បាន​គាំទ្រ ។\n"
"# AuthGroupName ៖ ឈ្មោះ​ក្រុម​សម្រាប់សេចក្ដី​អនុញ្ញាតជា \"ក្រុម\" ។\n"
"# លំដាប់ ៖ លំដាប់​នៃ​ដំណើរការ​អនុញ្ញាត/បដិសេធ ។\n"
"# អនុញ្ញាត ៖ អនុញ្ញាត​ឲ្យ​ដំណើរការ​ពី​ឈ្មោះ​ម៉ាស៊ីន ដែន អាសយដ្ឋាន IP ឬ\n"
"បណ្ដាញ​ដែល​បាន​បញ្ជាក់ ។\n"
"# បដិសេធ ៖ បដិសេធ​ការ​ចូល​ដំណើរការ​ពី​ឈ្មោះ​ម៉ាស៊ីន ដែន អាសយដ្ឋាន IP ឬ\n"
"បណ្ដាញ​ដែល​បាន​បញ្ជាក់ ។\n"
"# ទាំង \"អនុញ្ញាត\" និង​\"បដិសេធ\" ព្រម​ទទួល​ការ​កំណត់​​សម្រាប់​អាសយដ្ឋាន​ដូច​ខាង​ក្រោម ៖​\n"
"#     ទាំងអស់\n"
"គ្មាន\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"# ម៉ាស៊ីន និង អាសយដ្ឋាន​ដែន ​ទាមទារ​ឲ្យ​អ្នក​បើក​ការ​ស្វែងរក​ឈ្មោះ​ម៉ាស៊ីន​\n"
"ដោយប្រើ \"HostNameLookups On\" ខាង​លើ ។\n"
"# ការ​បម្លែងជា​កូដ ៖ ថាតើ​ត្រូវ​ប្រើ​ការ​បម្លែងជា​កូដ​ឬអត់ ។ វា​អាស្រ័យទៅ​លើ​​​ការ​ដែល\n"
"បាន​ត​បណ្ណាល័យ OpenSSL ទៅ​បណ្ណាល័យ CUPS និង កម្មវិធី​កំណត់​ពេល ។\n"
"# តម្លៃដែល​អាច ៖\n"
"#     ជានិច្ច       - ប្រើ​ការ​បម្លែង​ជាកូដ (SSL) ជានិច្ច\n"
"កុំ        - កុំ​ប្រើ​ការ​បម្លែង​ជាកូដ\n"
"ត្រូវការ     - ប្រើ​​ការ​ធ្វើ​ឲ្យ​ប្រសើរ​នៃ​ការ​បម្លែង​ជា​កូដ TLS \n"
"បើ​បាន​ស្នើ - ប្រើ​ការ​បម្លែងជា​​កូដ ប្រសិនបើ​ម៉ាស៊ីន​បម្រើ​ស្នើសុំវា\n"
"# តម្លៃ​លំនាំដើម​គឹ \"បើ​បាន​ស្នើ\" ។\n"

#: cupsd.conf.template.cpp:495
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Authentication (AuthType)</b>\n"
"<p>\n"
"The authorization to use:<p>\n"
"<ul type=circle>\n"
"<li><i>None</i>   - Perform no authentication.</li>\n"
"<li><i>Basic</i>  - Perform authentication using the HTTP Basic method.</"
"li>\n"
"<li><i>Digest</i> - Perform authentication using the HTTP Digest method.</"
"li>\n"
"</ul><p>\n"
"Note: local certificate authentication can be substituted by\n"
"the client for <i>Basic</i> or <i>Digest</i> when connecting to the\n"
"localhost interface.</p>\n"
msgstr ""
"<b>ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ (AuthType)</b>\n"
"<p>\n"
"សេចក្តី​អនុញ្ញាត​ដែល​ត្រូវ​ប្រើ ៖<p>\n"
"<ul type=circle>\n"
"<li><i>គ្មាន</i>   - ប្រតិបត្តិ​ដោយគ្មាន​​ការ​ផ្ទៀង​ផ្ទាត់​ភាព​ត្រឹម​ត្រូវ ។</li>\n"
"<li><i>មូល​ដ្ឋាន</i>  - ប្រតិបត្តិ​ការ​ផ្ទៀង​ផ្ទាត់​ភាព​ត្រឹម​ត្រូវ​ដោយ​ប្រើ​វិធី​សាស្ត្រ​មូល​ដ្ឋាន HTTP ។</"
"li>\n"
"<li><i>Digest</i> - ប្រតិបត្តិការ​​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដោយ​ប្រើ​វិធី​សាស្ត្រ Digest HTTP ។</"
"li>\n"
"</ul><p>\n"
"ចំណាំ ៖ ​ការ​ផ្ទៀង​ផ្ទាត់ភាព​ត្រឹមត្រូវ​នៃ​វិញ្ញាបនបត្រ​មូលដ្ឋាន​អាចត្រូវ​បាន​ជំនួស​ដោយ\n"
"ម៉ាស៊ីនភ្ញៀវសម្រាប់​<i>មូល​ដ្ឋាន</i> ឬ <i>Digest</i> នៅពេល​តភ្ជាប់​ទៅ\n"
"ចំណុច​ប្រទាក់​ម៉ាស៊ីនមូលដ្ឋាន (localhost) ។</p>\n"

#: cupsd.conf.template.cpp:508
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Class (AuthClass)</b>\n"
"<p>\n"
"The authorization class; currently only <i>Anonymous</i>, <i>User</i>,\n"
"<i>System</i> (valid user belonging to group SystemGroup), and <i>Group</i>\n"
"(valid user belonging to the specified group) are supported.</p>\n"
msgstr ""
"<b>ថ្នាក់ (AuthClass)</b>\n"
"<p>\n"
"ថ្នាក់​សេចក្តី​អនុញ្ញាត ។ បច្ចុប្បន្ន​គឺ​​មាន​តែ<i>ជនអនាមិក</i> <i>អ្នក​ប្រើ</i>,\n"
"<i>ប្រព័ន្ធ</i> (​អ្នក​ប្រើ​ត្រឹម​ត្រូវរបស់​ក្រុម SystemGroup) និង <i>ក្រុម</i>\n"
"(​អ្នក​ប្រើ​​ត្រឹម​ត្រូវរបស់​​ក្រុម​ដែល​បញ្ជាក់) ប៉ុណ្ណោះ​ដែល​ត្រូវ​បាន​គាំ​ទ្រ ។</p>\n"

#: cupsd.conf.template.cpp:515
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<p>The user/group names allowed to access the resource. The format is a\n"
"comma separated list.</p>\n"
msgstr ""
"<p>ឈ្មោះ​អ្នក​ប្រើ/​ក្រុម​ដែលត្រូវ​បាន​​អនុញ្ញាត​ឲ្យ​ចូលដំណើរ​ការធនធាន ។ ទ្រង់​ទ្រាយ​គឺ​ជា\n"
"បញ្ជី​ដែលបំបែក​​ដោយ​សញ្ញា​ក្បៀស ។</p>\n"

#: cupsd.conf.template.cpp:519
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Satisfy (Satisfy)</b>\n"
"<p>\n"
"This directive controls whether all specified conditions must\n"
"be satisfied to allow access to the resource. If set to \"all\",\n"
"then all authentication and access control conditions must be\n"
"satisfied to allow access.\n"
"</p>\n"
"<p>\n"
"Setting Satisfy to \"any\" allows a user to gain access if the\n"
"authentication <i>or</i> access control requirements are satisfied.\n"
"For example, you might require authentication for remote access,\n"
"but allow local access without authentication.\n"
"</p>\n"
"<p>\n"
"The default is \"all\".\n"
"</p> \n"
msgstr ""
"<b>តម្រូវចិត្ត (Satisfy)</b>\n"
"<p>\n"
"សេចក្ដី​បង្គាប់​នេះ​ត្រួត​ពិនិត្យ​ថាតើ​លក្ខខណ្ឌ​ដែល​បាន​បញ្ជាក់​ទាំង​អស់​​ត្រូវ​\n"
"តម្រូវចិត្ត ដើម្បី​អនុញ្ញាត​​ឲ្យ​ចូលដំណើរ​ការ​​ធនធានឬអត់ ។ ប្រសិន​បើ​បានកំណត់​ទៅ \"ទាំង​អស់\"\n"
"នោះ​​លក្ខខណ្ឌ​ត្រួត​ពិនិត្យ​ការ​ចូល​​​ដំណើរការ និង​ការ​ផ្ទៀតផ្ទាត់​ភាព​ត្រឹមត្រូវ​ទាំង​អស់​ត្រូវ​តម្រូវចិត្ត\n"
"​ដើម្បី​អនុញ្ញាតឲ្យ​​ដំណើរ​ការ ។\n"
"</p>\n"
"<p>\n"
"ការ​កំណត់​តម្រូវចិត្តទៅ  \"ណា​មួយ\" នឹងអនុញ្ញាត​ឲ្យ​អ្នក​ប្រើបង្កើន​ការ​ចូល​​ដំណើរ​ការ ប្រសិន​បើ\n"
"ការ​ផ្ទៀតផ្ទាត់​ភាព​ត្រឹមត្រូវ <i>ឬ</i>​តម្រូវការ​​ត្រួត​ពិនិត្យ​ការ​ចូល​ដំណើរ​ត្រូវ​បាន​តម្រូវចិត្ត ។\n"
"ឧទាហរណ៍ អ្នក​អាច​ទាមទារ​​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ​សម្រាប់​​ចូល​ដំណើរ​ការ​ពី​ចម្ងាយ\n"
"ប៉ុន្តែ​​អនុញ្ញាត​ឲ្យ​ចូល​ដំណើរ​ការ​មូលដ្ឋាន​ដោយ​គ្មាន​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ។\n"
"</p>\n"
"<p>\n"
"លំនាំដើម​គឺ \"ទាំង​អស់\" ។\n"
"</p> \n"

#: cupsd.conf.template.cpp:537
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Authentication group name (AuthGroupName)</b>\n"
"<p>\n"
"The group name for <i>Group</i> authorization.</p>\n"
msgstr ""
"<b>ឈ្មោះ​​ក្រុម​ផ្ទៀង​ផ្ទាត់​ភាព​ត្រឹម​ត្រូវ (AuthGroupName)</b>\n"
"<p>\n"
"ឈ្មោះ​ក្រុម​សម្រាប់សេចក្តី​អនុញ្ញាត​<i>ក្រុម</i> ។</p>\n"

#: cupsd.conf.template.cpp:542
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>ACL order (Order)</b>\n"
"<p>\n"
"The order of Allow/Deny processing.</p>\n"
msgstr ""
"<b>លំដាប់ ACL (Order)</b>\n"
"<p>\n"
"លំដាប់​​នៃដំណើរការ​អនុញ្ញាត/បដិសេធ ។</p>\n"

#: cupsd.conf.template.cpp:547
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Allow</b>\n"
"<p>\n"
"Allows access from the specified hostname, domain, IP address, or\n"
"network. Possible values are:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.</p>\n"
msgstr ""
"<b>អនុញ្ញាត</b>\n"
"<p>\n"
"អនុញ្ញាត​ការចូល​ដំណើរ​ការ​​​ពី​ឈ្មោះ​ម៉ាស៊ីន ដែន អាសយដ្ឋាន IP ឬ\n"
"បណ្តាញ​ដែល​បញ្ជាក់ ។ តម្លៃ​អាច​ប្រើ​បាន​​គឺ ៖</p>\n"
"<pre>\n"
"ទាំង​អស់\n"
"គ្មាន\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"ម៉ាស៊ីន និង​អាសយដ្ឋាន​ដែន​​ទាម​ទារ​​ឲ្យ​អ្នក​បើកការ​ស្វែងរក​​ឈ្មោះ​ម៉ាស៊ីន\n"
"ដោយប្រើ \"HostNameLookups On\" ខាង​លើ ។</p>\n"

#: cupsd.conf.template.cpp:568
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>ACL addresses (Allow/Deny)</b>\n"
"<p>\n"
"Allows/Denies access from the specified hostname, domain, IP address, or\n"
"network. Possible values are:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.</p>\n"
msgstr ""
"<b>អាសយដ្ឋាន ACL (Allow/Deny)</b>\n"
"<p>\n"
"អនុញ្ញាត/បដិសេធ​ការ​ចូល​ដំណើរ​ការ​ពី​ឈ្មោះ​ម៉ាស៊ីន ដែន អាសយដ្ឋាន IP ឬ\n"
"បណ្តាញ​ដែលបាន​​បញ្ជាក់​ ។ តម្លៃ​ដែល​អាច​​គឺ ៖</p>\n"
"<pre>\n"
"ទាំង​អស់\n"
"គ្មាន\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"អាសយដ្ឋានម៉ាស៊ីន និងដែន​ទាម​ទារ​ឲ្យ​អ្នកបើក​ការ​ស្វែងរក​​ឈ្មោះ​ម៉ាស៊ីន\n"
"ដោយប្រើ \"HostNameLookups On\" ខាង​លើ ។</p>\n"

#: cupsd.conf.template.cpp:589
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Encryption (Encryption)</b>\n"
"<p>\n"
"Whether or not to use encryption; this depends on having\n"
"the OpenSSL library linked into the CUPS library and scheduler.</p>\n"
"<p>\n"
"Possible values:</p>\n"
"<ul type=circle>\n"
"<li><i>Always</i>       - Always use encryption (SSL)</li>\n"
"<li><i>Never</i>        - Never use encryption</li>\n"
"<li><i>Required</i>     - Use TLS encryption upgrade</li>\n"
"<li><i>IfRequested</i>  - Use encryption if the server requests it</li>\n"
"</ul><p>\n"
"The default value is \"IfRequested\".</p>\n"
msgstr ""
"<b>ការ​បម្លែង​ជា​​​កូដ (Encryption)</b>\n"
"<p>\n"
"ថាតើ​ត្រូវ​​ប្រើ​ការ​បម្លែងជា​​​កូដ​ឬ​អត់ ។ វានេះ​ផ្អែក​លើ​ការ​ដែល\n"
"បាន​តភ្ជាប់​បណ្ណាល័យ OpenSSL ទៅ​បណ្ណាល័យ CUPS និង​កម្មវិធី​​កំណត់​ពេល ។</p>\n"
"<p>\n"
"តម្លៃ​ដែល​អាច ៖</p>\n"
"<ul type=circle>\n"
"<li><i>ជានិច្ច</i>       - ប្រើ​ការ​បម្លែង​ជា​កូដ (SSL) ជានិច្ច</li>\n"
"<li><i>កុំ</i>        - កុំ​​ប្រើ​ការ​បម្លែងជា​​​កូដ</li>\n"
"<li><i>ទាម​ទារ</i>     - ប្រើ​ការ​ធ្វើ​ឲ្យ​ប្រសើរ​នៃ​ការ​បម្លែងជា​​​កូដ TLS </li>\n"
"<li><i>​បើ​ស្នើសុំ</i>  - ប្រើ​ការ​បម្លែងជា​​​កូដ ប្រសិនបើ​ម៉ាស៊ីន​បម្រើ​ស្នើ​វា</li>\n"
"</ul><p>\n"
"តម្លៃ​​លំនាំ​ដើម​គឺ \"IfRequested\" ។</p>\n"

#: cupsd.conf.template.cpp:604
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Access permissions</b>\n"
"<p>\n"
"Access permissions for each directory served by the scheduler.\n"
"Locations are relative to DocumentRoot...</p>\n"
msgstr ""
"<b>សិទ្ធិ​ចូលដំណើរការ</b>\n"
"<p>\n"
"សិទ្ធិ​ចូល​ដំណើរការសម្រាប់​ថតនីមួយៗ​ត្រូវបាន​បម្រើ​​ដោយ​កម្មវិធី​កំណត់​ពេល ។\n"
"ទីតាំង​គឺ​ទាក់ទង​ទៅនឹង DocumentRoot...</p>\n"

#: cupsd.conf.template.cpp:610
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Auto purge jobs (AutoPurgeJobs)</b>\n"
"<p>\n"
"Automatically purge jobs when not needed for quotas.\n"
"Default is No.</p>\n"
msgstr ""
"<b>លុប​​ចោល​ការងារ​ដោយ​ស្វ័យ​ប្រវត្តិ (AutoPurgeJobs)</b>\n"
"<p>\n"
"លុប​ចោល​ការងារ​ដោយ​​ស្វ័យ​ប្រវត្តិ នៅ​ពេល​ដែល​មិន​ត្រូវ​ការ​វាសម្រាប់​កូតា ។\n"
"លំនាំ​ដើម​គឺ ទេ ។</p>\n"

#: cupsd.conf.template.cpp:616
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse protocols (BrowseProtocols)</b>\n"
"<p>\n"
"Which protocols to use for browsing.  Can be\n"
"any of the following separated by whitespace and/or commas:</p>\n"
"<ul type=circle>\n"
"<li><i>all</i>  - Use all supported protocols.</li>\n"
"<li><i>cups</i> - Use the CUPS browse protocol.</li>\n"
"<li><i>slp</i>  - Use the SLPv2 protocol.</li>\n"
"</ul><p>\n"
"The default is <b>cups</b>.</p>\n"
"<p>\n"
"Note: If you choose to use SLPv2, it is <b>strongly</b> recommended that\n"
"you have at least one SLP Directory Agent (DA) on your\n"
"network.  Otherwise, browse updates can take several seconds,\n"
"during which the scheduler will not response to client\n"
"requests.</p>\n"
msgstr ""
"<b>​ពិធីការ​រុករក (BrowseProtocols)</b>\n"
"<p>\n"
"ពិធីការដែល​ត្រូវ​​ប្រើ​សម្រាប់​ការរុក​រក ។ អាច\n"
"ជាពិធីការ​​ណា​មួយ​ក្នុង​ចំណោម​ពិធីការ​​ខាង​ក្រោម​ដែល​បំបែក​ដោយ​ចន្លោះ​ និង/ឬ​ក្បៀស ៖</p>\n"
"<ul type=circle>\n"
"<li><i>ទាំង​អស់l</i>  - ប្រើ​ពិធីការ​ដែល​បាន​គាំ​ទ្រ​ទាំង​អស់ ។</li>\n"
"<li><i>cups</i> - ប្រើ​ពិធីការ​រុក​រក CUPS ។</li>\n"
"<li><i>slp</i>  - ប្រើ​ពិធីការ SLPv2 ។</li>\n"
"</ul><p>\n"
"លំនាំ​ដើម​គឺ <b>cups</b>។</p>\n"
"<p>\n"
"ចំណាំ ៖ ប្រសិនបើ​អ្នក​ជ្រើស​ប្រើ SLPv2 នោះ​យើង​សូម​ផ្ដល់​<b>អនុសាសន៍</b>​ដល់​អ្នក​ថា​\n"
"អ្នក​មាន​​យ៉ាង​ហោច​ណាស់ភ្នាក់ងារ​​ថត SLP (DA) មួយ​នៅ​លើ​បណ្ដាញ\n"
"របស់​អ្នក ។ ប្រសិនបើមិន​ដូច្នោះ​ទេ ការ​រុករក​អាច​​ចំណាយ​ពេល​ច្រើន\n"
"នៅពេល​ដែល​កម្មវិធី​កំណត់​ពេល​មិន​​ឆ្លើយ​តប​ទៅតាម​សំណើ​របស់​​ម៉ាស៊ីន​ភ្ញៀវ ។</p>\n"

#: cupsd.conf.template.cpp:634
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Classification (Classification)</b>\n"
"<p>\n"
"The classification level of the server.  If set, this\n"
"classification is displayed on all pages, and raw printing is disabled.\n"
"The default is the empty string.</p>\n"
"<p>\n"
"<i>ex</i>: confidential\n"
msgstr ""
"<b>ការ​បែងចែក​ប្រភេទ (Classification)</b>\n"
"<p>\n"
"កម្រិត​ការ​បែងចែក​ជា​ក្រុម​របស់​ម៉ាស៊ីន​បម្រើ ។ ប្រសិនបើ​បាន​កំណត់ នោះ​ការ\n"
"បែងចែក​ប្រភេទ​នេះ ​នឹង​ត្រូវ​​បង្ហាញ​លើ​ទំព័រ​ទាំង​អស់ ហើយ​ការ​បោះពុម្ព​ឆៅនឹង​ត្រូវ​បាន​បិទ ។\n"
"លំនាំដើម​គឺ​ខ្សែអក្សរ​ទទេ ។</p>\n"
"<p>\n"
"<i>ឧ.</i> ៖ សម្ងាត់\n"

#: cupsd.conf.template.cpp:643
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Allow overrides (ClassifyOverride)</b>\n"
"<p>\n"
"Whether to allow users to override the classification\n"
"on printouts. If enabled, users can limit banner pages to before or\n"
"after the job, and can change the classification of a job, but cannot\n"
"completely eliminate the classification or banners.</p>\n"
"<p>\n"
"The default is off.</p>\n"
msgstr ""
"<b>​អនុញ្ញាត​ឲ្យ​បដិសេធ (ClassifyOverride)</b>\n"
"<p>\n"
"ថា​តើ​​ត្រូវ​អនុញ្ញាត​ឲ្យ​អ្នក​ប្រើ​បដិសេធការ​បែងចែក​ប្រភេទ\n"
"លើសន្លឹក​បោះពុម្ព​ឬ​អត់ ។ ប្រសិនបើ​បាន​បើក អ្នក​ប្រើ​អាច​កំណត់​ទំព័រ​​បដា​ទៅ​មុន ឬ​​ក្រោយ​ការងារ\n"
"ហើយ​​អាច​ផ្លាស់ប្ដូរការ​បែងចែក​ប្រភេទ​​ការងារ​មួយ ប៉ុន្តែ​មិន​អាច\n"
"លុប​​បដា ឬ​ការបែងចែក​ប្រភេទ​​ទាំងស្រុង​​បាន​ទេ ។</p>\n"
"<p>\n"
"លំនាំដើម​គឺ បិទ ។</p>\n"

#: cupsd.conf.template.cpp:653
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Hide implicit members (HideImplicitMembers)</b>\n"
"<p>\n"
"Whether or not to show the members of an\n"
"implicit class.</p>\n"
"<p>\n"
"When HideImplicitMembers is On, any remote printers that are\n"
"part of an implicit class are hidden from the user, who will\n"
"then only see a single queue even though many queues will be\n"
"supporting the implicit class.</p>\n"
"<p>\n"
"Enabled by default.</p>\n"
msgstr ""
"<b>លាក់​សមាជិក​ខាងក្នុង (HideImplicitMembers)</b>\n"
"<p>\n"
"ថា​តើ​ត្រូ​វ​បង្ហាញ​សមាជិក​របស់​ថ្នាក់ខាងក្នុង​ឬ​អត់ ។\n"
"</p>\n"
"<p>\n"
"ពេល HideImplicitMembers បើក នោះ​ម៉ាស៊ីន​បោះពុម្ព​ពី​ចម្ងាយ​ដែល​ជា​\n"
"ផ្នែក​របស់​ថ្នាក់​ខាងក្នុង នឹង​​ត្រូវ​បាន​លាក់​ពី​អ្នក​ប្រើ បន្ទាប់​មកអ្នក​ប្រើ​នោះ​​​នឹង\n"
"ឃើញ​តែ​ជួរ​មួយ​ប៉ុណ្ណោះ ទោះ​បី​ជា​មាន​ជួរ​ជា​ច្រើន​​​​\n"
"​គាំទ្រ​ថ្នាក់ខាងក្នុង​​ក៏​ដោយ ។</p>\n"
"<p>\n"
"លំនាំ​ដើម​គឺ​បាន​បើក ។</p>\n"

#: cupsd.conf.template.cpp:666
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Use &quot;any&quot; classes (ImplicitAnyClasses)</b>\n"
"<p>\n"
"Whether or not to create <b>AnyPrinter</b> implicit\n"
"classes.</p>\n"
"<p>\n"
"When ImplicitAnyClasses is On and a local queue of the same name\n"
"exists, e.g. \"printer\", \"printer@server1\", \"printer@server1\", then\n"
"an implicit class called \"Anyprinter\" is created instead.</p>\n"
"<p>\n"
"When ImplicitAnyClasses is Off, implicit classes are not created\n"
"when there is a local queue of the same name.</p>\n"
"<p>\n"
"Disabled by default.</p>\n"
msgstr ""
"<b>ប្រើថ្នាក់​&quot;មួយ​ចំនួន&quot; (ImplicitAnyClasses)</b>\n"
"<p>\n"
"ថាតើ​ត្រូវ​បង្កើត​ថ្នាក់​ខាងក្នុង​​របស់ ​<b>AnyPrinter</b> ឬ​អត់ ។\n"
"</p>\n"
"<p>\n"
"​ពេល ImplicitAnyClasses បើក ហើយ​មាន​ជួរ​មូលដ្ឋាន​មាន​ឈ្មោះ​ដូច​គ្នា\n"
"ឧ. \"printer\", \"printer@server1\", \"printer@server1\" នោះ\n"
"​ថ្នាក់ខាងក្នុង​​មួយ​ដែល​ហៅ​ថា \"Anyprinter\" នឹង​ត្រូវ​បាន​បង្កើត​ជំនួស​វិញ ។</p>\n"
"<p>\n"
"នៅពេល ImplicitAnyClasses បិទ នោះ​ថ្នាក់​ខាងក្នុង​នឹង​មិន​​​ត្រូវ​បាន​បង្កើត​ទេ\n"
"នៅ​ពេល​ដែល​មាន​ជួរ​មូលដ្ឋាន​មួយ​ដែល​មាន​ឈ្មោះ​ដូច​គ្នា ។</p>\n"
"<p>\n"
"លំនាំ​ដើម​គឺ​បាន​បិទ ។</p>\n"

#: cupsd.conf.template.cpp:681
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max jobs (MaxJobs)</b>\n"
"<p>\n"
"Maximum number of jobs to keep in memory (active and completed).\n"
"Default is 0 (no limit).</p>\n"
msgstr ""
"<b>ចំនួន​ការងារ​អតិបរមា (MaxJobs)</b>\n"
"<p>\n"
"ចំនួន​ការងារ​អតិបរមា​​ត្រូវ​រក្សា​ទុក​ក្នុង​សតិ (សកម្ម និង​បាន​បញ្ចប់​) ។\n"
"លំនាំដើម​០ គឺ (គ្មាន) ។</p>\n"

#: cupsd.conf.template.cpp:687
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max jobs per user (MaxJobsPerUser)</b>\n"
"<p>\n"
"The MaxJobsPerUser directive controls the maximum number of <i>active</i>\n"
"jobs that are allowed for each user. Once a user reaches the limit, new\n"
"jobs will be rejected until one of the active jobs is completed, stopped,\n"
"aborted, or canceled.</p>\n"
"<p>\n"
"Setting the maximum to 0 disables this functionality.\n"
"Default is 0 (no limit).\n"
"</p>\n"
msgstr ""
"<b>ចំនួន​ការងារ​អតិបរមា​សម្រាប់​​អ្នក​ប្រើ​ម្នាក់ (MaxJobsPerUser)</b>\n"
"<p>\n"
"សេចក្តី​​បង្គាប់​​របស់ MaxJobsPerUser ត្រួតពិនិត្យ​ចំនួន​​ការងារ​<i>សកម្ម</i>​អតិបរមា\n"
"ដែល​ត្រូវ​បាន​អនុញ្ញាត​សម្រាប់​អ្នក​ប្រើ​ម្នាក់ៗ ។ នៅពេល​ដែលអ្នក​ប្រើ​ម្នាក់​ឈាន​ដល់​ចំនួន​កំណត់ នោះការងារ​ថ្មី\n"
"នឹង​ត្រូវ​បាន​ច្រាន​ចោល​រហូត​ដល់​ការងារ​សកម្ម​មួយ​​ត្រូវ​បាន​​បញ្ចប់ ឬ​បញ្ឈប់\n"
"ឬ បោះបង់ ។</p>\n"
"<p>\n"
"ការ​កំណត់​ចំនួន​អតិបរមា​ទៅ ០ នឹង​បិទ​មុខ​ងារ​នេះ ។\n"
"លំនាំដើម​គឺ ០ (គ្មាន​កំណត់) ។\n"
"</p>\n"

#: cupsd.conf.template.cpp:699
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max jobs per printer (MaxJobsPerPrinter)</b>\n"
"<p>\n"
"The MaxJobsPerPrinter directive controls the maximum number of <i>active</"
"i>\n"
"jobs that are allowed for each printer or class. Once a printer or class\n"
"reaches the limit, new jobs will be rejected until one of the active jobs\n"
"is completed, stopped, aborted, or canceled.</p>\n"
"<p>\n"
"Setting the maximum to 0 disables this functionality.\n"
"Default is 0 (no limit).\n"
"</p>\n"
msgstr ""
"<b>ការងារ​អតិបរមា​ក្នុង​ម៉ាស៊ីន​បោះពុម្ព​មួយ (MaxJobsPerPrinter)</b>\n"
"<p>\n"
"សេចក្តី​​បង្គាប់​របស់ MaxJobsPerPrinter ត្រួតពិនិត្យ​ចំនួន​ការងារ​<i>សកម្ម</i>​អតិបរមា\n"
"ដែល​បាន​អនុញ្ញាត​សម្រាប់​ម៉ាស៊ីន​បោះពុម្ព ឬ​ថ្នាក់​នីមួយៗ ។ ពេល​ដែល​ម៉ាស៊ីន​បោះពុម្ព ឬ​ថ្នាក់\n"
"ឈាន​ដល់​ចំនួន​កំណត់ នោះ​ការងារ​ថ្មី​ៗ​នឹង​ត្រូវ​បាន​ច្រាន​ចោល រហូត​ដល់​ការងារ​សកម្ម​មួយ​ចំនួន\n"
"ត្រូវ​បាន​បញ្ចប់ ឬ​បញ្ឈប់ ឬ​បោះបង់ ។</p>\n"
"<p>\n"
"ការកំណត់​​ចំនួន​អតិបរមា​ទៅ ០ នឹង​បិទ​មុខងារ​នេះ ។\n"
"លំនាំដើម​គឺ ០ (មិន​កំណត់) ។\n"
"</p>\n"

#: cupsd.conf.template.cpp:711
#, kde-format
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Port</b>\n"
"<p>\n"
"The port value that the CUPS daemon is listening to. Default is 631.</p>\n"
msgstr ""
