msgid "Platform specific configuration module"
msgstr "ម៉ូឌុល​កំណត់​រចនាសម្ព័ន្ធ​ជាក់លាក់​របស់​វេទិកា"

#. i18n: file: platform.ui:21
#. i18n: ectx: property (text), widget (QRadioButton, optNative)
#: rc.cpp:6
msgid "Native desktop shell"
msgstr "សែល​ផ្ទៃតុ​ដើម"

#. i18n: file: platform.ui:28
#. i18n: ectx: property (text), widget (QLabel, descrNative)
#: rc.cpp:9
msgid "System's default desktop shell"
msgstr "សែល​ផ្ទៃតុ​លំនាំដើម​របស់​ប្រព័ន្ធ"

#. i18n: file: platform.ui:52
#. i18n: ectx: property (text), widget (QRadioButton, optPlasma)
#: rc.cpp:12
msgid "Plasma desktop shell"
msgstr "សែល​ផ្ទៃតុ​ប្លាស្មា"

#. i18n: file: platform.ui:59
#. i18n: ectx: property (text), widget (QLabel, descrPlasma)
#: rc.cpp:15
msgid "KDE4 Plasma desktop shell"
msgstr "សែល​ផ្ទៃតុ​ប្លាស្មា​របស់ KDE4"

#. i18n: file: platform.ui:85
#. i18n: ectx: property (text), widget (QRadioButton, optCustom)
#: rc.cpp:18
msgid "User custom shell"
msgstr "សែល​​ផ្ទាល់ខ្លួន​របស់​អ្នក​ប្រើ"

#. i18n: file: platform.ui:111
#. i18n: ectx: property (text), widget (QPushButton, btnShellSetup)
#: rc.cpp:21
msgid "Setup"
msgstr "រៀបចំ"

#. i18n: file: platform.ui:120
#. i18n: ectx: property (text), widget (QLabel, dexcrCustom)
#: rc.cpp:24
msgid ""
"This shell is reserved for user's custom shell. Press \"Setup\" button to "
"setup your favourite shell."
msgstr ""
"សែល​នេះ​ត្រូ​វបាន​បម្រុង​ទុក​សម្រាប់​សែល​ផ្ទាល់ខ្លួន​របស់​អ្នក ។ ចុចប៊ូតុង \"រៀបចំ\" ដើម្បី​រៀបចំ​សែល​ដែលជា​ទី​"
"ពេញចិត្ត​របស់​អ្នក ។"

#. i18n: file: platform.ui:142
#. i18n: ectx: property (text), widget (QCheckBox, chkInstallCPl)
#: rc.cpp:27
msgid "Install as Control Panel element"
msgstr "ដំឡើង​ជា​ធាតុ​បន្ទះ​វត្ថុ​បញ្ជា"

#. i18n: file: platform.ui:152
#. i18n: ectx: property (text), widget (QCheckBox, chkDisableMenuGen)
#: rc.cpp:30
msgid "Enable automatic regeneration of Start menu entries"
msgstr "បើក​ការ​បង្កើត​ដោយ​ស្វ័យ​ប្រវត្តិ​របស់​ធាតុ​ម៉ឺនុយ​ចាប់ផ្ដើម"

