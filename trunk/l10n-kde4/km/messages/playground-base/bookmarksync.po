#. i18n: file: settings.ui:13
#. i18n: ectx: property (windowTitle), widget (QWidget, Settings)
#: plugin_bookmarksync.cpp:50 rc.cpp:9
msgid "Settings"
msgstr "ការ​កំណត់"

#: plugin_bookmarksync.cpp:73
msgid "Sync Bookmarks"
msgstr "ធ្វើ​សមកាលកម្ម​ចំណាំ"

#: plugin_bookmarksync.cpp:78
msgid "Configure..."
msgstr "កំណត់​រចនាសម្ព័ន្ធ..."

#: plugin_bookmarksync.cpp:83
msgid "Fetch bookmarks"
msgstr "ទៅ​យក​ចំណាំ"

#: plugin_bookmarksync.cpp:90
msgid "Save bookmarks"
msgstr "រក្សាទុក​ចំណាំ"

#: plugin_bookmarksync.cpp:192
msgid "Please indicate (remote) location"
msgstr "សូម​បង្ហាញ​ទីតាំង (ពី​ចម្ងាយ)"

#: plugin_bookmarksync.cpp:207
msgid "No bookmarks file found"
msgstr "រក​មិនឃើញ​ឯកសារ​ចំណាំ"

#: plugin_bookmarksync.cpp:230
#, kde-format
msgid "Sync failed: %1"
msgstr "បានបរាជ័យ​ក្នុងការ​ធ្វើ​សមកាលកម្ម ៖ %1"

#. i18n: file: plugin_bookmarksync.rc:4
#. i18n: ectx: Menu (tools)
#: rc.cpp:3
msgid "&Tools"
msgstr "ឧបករណ៍"

#. i18n: file: plugin_bookmarksync.rc:8
#. i18n: ectx: ToolBar (extraToolBar)
#: rc.cpp:6
msgid "Extra Toolbar"
msgstr "របារ​ឧបករណ៍​បន្ថែម"

#. i18n: file: settings.ui:21
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:12
msgid ""
"Bookmarksync can sync your bookmark file to another location. For now it can "
"only save and fetch, but maybe in the future it can actually merge."
msgstr ""
"Bookmarksync អាច​​ធ្វើ​សមកាលកម្ម​ឯកសារ​ចំណាំ​របស់​អ្នក​ទៅ​ទីតាំង​ផ្សេង ។ ចាប់ពី​ឥឡូវ​នេះ វា​អាច​រក្សាទុក "
"និង​ទៅ​យក ប៉ុន្តែ​អាច​នៅ​ពេល​អនាគត វា​អាច​បញ្ចូល​គ្នា​យ៉ាង​ពិតប្រាកដ ។"

#. i18n: file: settings.ui:33
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:15
msgid ""
"Select the location where to store or fetch the bookmarks file to. Like "
"sftp://some.server"
msgstr "ជ្រើស​ទីតាង​ដែល​ត្រូវ​ទុក ឬ​ទៅ​យក​ឯកសារ​ចំណាំ ។ ដូចជា sftp://some.server"

#. i18n: file: settings.ui:43
#. i18n: ectx: property (text), widget (KPushButton, kpushbutton)
#: rc.cpp:18
msgid "Select location"
msgstr "ជ្រើស​ទីតាំង"

#. i18n: file: settings.ui:52
#. i18n: ectx: property (text), widget (QCheckBox, AutoSave)
#: rc.cpp:21
msgid "Save bookmark file automatically on change"
msgstr "រក្សាទុក​ឯកសារ​ចំណាំ​ដោយ​ស្វ័យ​ប្រវត្តិ​នៅពេល​ផ្លាស់ប្ដូរ"

#. i18n: file: settings.ui:59
#. i18n: ectx: property (text), widget (QCheckBox, AutoFetch)
#: rc.cpp:24
msgid "Fetch bookmark file automatically on startup when that file is newer"
msgstr "ទៅ​យក​ឯកសារ​ចំណាំ​ដោយ​ស្វ័យ​ប្រវត្តិ​នៅពេល​ចាប់ផ្ដើម នៅពេល​ឯកសារ​មាន​កំណែ​ថ្មី"
