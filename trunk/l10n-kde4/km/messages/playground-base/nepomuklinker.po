#: main.cpp:40
msgid "Tasklinker"
msgstr "Tasklinker"

#: main.cpp:42
msgid "A tool for associating resources to tasks"
msgstr "ឧបករណ៍​សម្រាប់​ភ្ជាប់​ធនធាន​ទៅកាន់​ភារកិច្ច"

#: main.cpp:44
msgid "(c) 2009, Mathieu Dupuy"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៩ ដោយ Mathieu Dupuy"

#: main.cpp:47
msgid "Mathieu Dupuy"
msgstr "Mathieu Dupuy"

#: main.cpp:47
msgid "Author"
msgstr "អ្នក​និពន្ធ"

#: main.cpp:53
msgid "The URI of the resource to associate"
msgstr "URI របស់​​ធនធានត្រូវ​ភ្ជាប់"

#: main.cpp:65
msgid "Tasks cannot be associated to each other."
msgstr "ភារកិច្ច​មិនអាច​ត្រូវ​បាន​ភ្ជាប់​គ្នា​បាន​ទេ ។"

#: main.cpp:82
#, fuzzy, kde-format
#| msgid "'%1' has been associated to '%2'"
msgid "'%1' have been associated to '%2'"
msgstr "'%1' ត្រូវ​បាន​ភ្ជាប់​ទៅកាន់ '%2'"

#: main.cpp:85
msgid "Association created successfully."
msgstr "បាន​បង្កើត​ការ​ភ្ជាប់​ដោយ​ជោគជ័យ ។"

