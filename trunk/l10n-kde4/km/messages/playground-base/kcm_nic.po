#: arrowwidget.cpp:34
msgctxt "Displayed when arrow widget does not know connection state"
msgid "UNKNOWN"
msgstr " មិន​ស្គាល់"

#: arrowwidget.cpp:36
msgid ""
"Shows if the network interface is connected; red for disconnected and green "
"for connected"
msgstr ""
"បង្ហាញ​ប្រសិនបើ​ចំណុច​ប្រទាក់​បណ្ដាញ​បាន​ភ្ជាប់ ពណ៌ក្រហម​មាន​ន័យ​ថា​មិន​បាន​ភ្ជាប់ និង​ពណ៌បៃតង​មានន័យ​ថា​បាន​ភ្ជាប់"

#: kcm_nic.cpp:84
msgid "This tab shows all network interfaces"
msgstr "ផ្ទាំង​នេះ​បង្ហាញ​ចំណុចប្រទាក់​បណ្ដាញ​ទាំងអស់"

#: kcm_nic.cpp:85
