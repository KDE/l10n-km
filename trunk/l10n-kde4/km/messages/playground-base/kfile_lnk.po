#: kfile_lnk.cpp:45
#, kde-format
msgid "Windows Link File Information"
msgstr "ព័ត៌មាន​ឯកសារ​តំណ​​វីនដូ"

#: kfile_lnk.cpp:50
#, kde-format
msgid "Size of Target"
msgstr "ទំហំ​​​គោលដៅ"

#: kfile_lnk.cpp:53
#, kde-format
msgid "Location"
msgstr "ទីតាំង"

#: kfile_lnk.cpp:54
#, kde-format
msgid "Points To"
msgstr "ចង្អុល​ទៅ"

#: kfile_lnk.cpp:55
#, kde-format
msgid "Description"
msgstr "សេចក្ដី​ពិពណ៌នា"

#: kfile_lnk.cpp:77
#, kde-format
msgid "on Windows disk: %1"
msgstr "នៅ​លើ​ថាស​របស់​វីនដូ៖ %1"

#: kfile_lnk.cpp:82
#, kde-format
msgid "on network share"
msgstr "នៅ​លើ​ការ​ចែក​រំលែក​បណ្ដាញ"

#: lnkforward.cpp:37
#, kde-format
msgid "lnkforward"
msgstr "lnkforward"

#: lnkforward.cpp:39
#, kde-format
msgid "KDE tool for opening URLs given in a Windows .lnk file"
msgstr "ឧបករណ៍ KDE សម្រាប់​​​បើក URLs ​​ដែល​​បាន​ផ្ដល់​​​ក្នុង​ឯកសារ Windows .lnk"

#: lnkforward.cpp:52
#, kde-format
msgid ""
"Map a Windows drive to a local mountpoint, e.g. \"C=/mnt/windows\".\n"
"This option can be given multiple times."
msgstr ""
"ផ្គូផ្គង​​ដ្រាយ​វីនដូ​​​ទៅ​ចំណុច​ម៉ោន​មូលដ្ឋាន​មួយ ឧ. \"C=/mnt/windows\" ។\n"
"ជម្រើស​នេះ​អាច​ត្រូវ​បាន​ផ្ដល់​​​ច្រើន​ដង ។"

#: lnkforward.cpp:55
#, kde-format
msgid "Windows .lnk file to open."
msgstr "ឯកសារ Windows .lnk ត្រូវ​បើក"
