#: crystal.cpp:166
msgctxt "Tooltip main title text"
msgid "Crystal Desktop Search"
msgstr "ការ​ស្វែងរក​ផ្ទៃតុ​គ្រីស្ទាល់"

#: crystal.cpp:167
#, kde-format
msgctxt "Tooltip sub text"
msgid "Last search: %2 (%1 match)"
msgid_plural "Last search: %2 (%1 matches)"
msgstr[0] "កា​រស្វែងរក​ចុងក្រោយ ៖ %2 (ការ​ផ្គូផ្គង %1)"

#: crystal.cpp:171
msgctxt "No search has been done yet"
msgid "Crystal Desktop Search"
msgstr "ការ​ស្វែងរក​ផ្ទៃតុ​គ្រីស្តាល់"

#: crystal.cpp:172
msgctxt "Tooltip sub text"
msgid "Click on the icon to start searching"
msgstr "ចុច​លើ​រូបតំណាង​ដើម្បី​ចាប់ផ្ដើម​ស្វែងរក"

#: crystal.cpp:184
msgid "Search Options"
msgstr "ជម្រើស​ស្វែងរក"

#: crystaldialog.cpp:179
msgctxt "no active search, no results shown"
msgid "Idle."
msgstr "ទំនេរ ។"

#: crystaldialog.cpp:209
#, kde-format
msgctxt "status in the plasmoid's popup"
msgid "Searching for <b>\"%1\"</b>..."
msgstr "កំពុង​ស្វែងរក <b>\"%1\"</b>..."

#: crystaldialog.cpp:288
#, kde-format
msgid "Searching for <b>\"%2\"</b>. %1 file found so far..."
msgid_plural "Searching for <b>\"%2\"</b>. %1 files found so far..."
msgstr[0] "ស្វែងរក <b>\"%2\"</b> ។ រហូត​មក​ដល់​ពេល​នេះរកឃើញ​ឯកសារ %1..."

#: crystaldialog.cpp:351
#, kde-format
msgid "Search for <b>\"%2\"</b> finished. %1 matching file found."
msgid_plural "Search for <b>\"%2\"</b> finished. %1 matching files found."
msgstr[0] "ស្វែងរក <b>\"%2\"</b> បាន​បញ្ចប់ ។ បាន​រកឃើញ​ឯកសារផ្គូផ្គង %1 ។"

