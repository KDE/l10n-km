#: dashboard.cpp:103
msgctxt "dashboard title"
msgid "Crystal Desktop Search"
msgstr "ការ​ស្វែងរក​ផ្ទៃតុ​គ្រីស្ទាល់"

#: dashboard.cpp:104
msgctxt "dashboard introduction"
msgid ""
"Type in a word to search for it in your files. For more complex queries, you "
"can prefix your query with \"<strong>?</strong>\" to use the more powerful "
"<a href=\"http://techbase.kde.org/Development/Tutorials/Metadata/Nepomuk/"
"QueryService#Simple_Search_Syntax\" target=\"_new\">Nepomuk search syntax</"
"a>."
msgstr ""
"វាយ​ពាក្យ​ដើម្បី​ស្វែងរក​វា​នៅ​ក្នុង​ឯកសារ​របស់​អ្នក ។ ចំពោះ​សំណួរ​ស្មុគស្មាញ អ្នក​អាច​ដាក់​បុព្វ​សំណួរ​របស់​អ្នក​ដោយ​"
"ប្រើ \"<strong>?</strong>\" ដើម្បីប្រើ​វាក្យសម្ព័ន្ធ​ស្វែងរក Nepomuk មាន​អនុភាព​បន្ថែម​ទៀត​"
"សូមមើល​<a href=\"http://techbase.kde.org/Development/Tutorials/Metadata/"
"Nepomuk/QueryService#Simple_Search_Syntax\" target=\"_new\"></a> ។"

#: dashboard.cpp:105
msgctxt "dashboard header tags"
msgid "My Tags"
msgstr "ស្លាក​របស់​ខ្ញុំ"

#: dashboard.cpp:106
msgctxt "dashboard header recent"
msgid "Recent Searches"
msgstr "ស្វែងរក​ថ្មីៗ"

#: dashboard.cpp:124
msgid "Desktop search is not activated. Please enable it in System Settings"
msgstr "ការ​ស្វែងរក​ផ្ទៃតុ​មិន​ត្រូវ​បានធ្វើ​ឲ្យ​សកម្ម​ទេ ។ សូម​បើក​វា​នៅ​ក្នុង​ការ​កំណត់​ប្រព័ន្ធ"

#: dashboard.cpp:135
msgid "No tags found."
msgstr "រក​មិន​ឃើញ​ស្លាក​ទេ"

#: dialog.cpp:130
msgid "Dashboard"
msgstr "ផ្ទាំង​គ្រប់គ្រង"

#: dialog.cpp:135
msgid "Results"
msgstr "លទ្ធផល"

#: dialog.cpp:154
msgctxt "no active search, no results shown"
msgid "Idle."
msgstr "ទំនេរ ។"

#: dialog.cpp:219
#, kde-format
msgctxt "status in the plasmoid's popup"
msgid "Searching for <i>\"%1\"</i>..."
msgstr "ស្វែងរក <i>\"%1\"</i>..."

#: dialog.cpp:237
#, kde-format
msgid "Searching for <i>\"%2\"</i>. %1 file found so far..."
msgid_plural "Searching for <i>\"%2\"</i>. %1 files found so far..."
msgstr[0] "ស្វែងរក <i>\"%2\"</i> ។ រហូត​មក​ដល់ពេល​នេះ​រកឃើញ​ឯកសារ %1..."

#: dialog.cpp:254
#, kde-format
msgid "Found %2 result in %1."
msgid_plural "Found %2 results in %1."
msgstr[0] "រកឃើញ​លទ្ធផ %2 នៅ​ក្នុង %1 ។"

