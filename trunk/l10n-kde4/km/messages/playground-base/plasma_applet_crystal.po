#: dashboard.cpp:103
#, kde-format
msgctxt "dashboard title"
msgid "Crystal Desktop Search"
msgstr "ការ​ស្វែងរក​ផ្ទៃតុ​គ្រីស្ទាល់"

#: dashboard.cpp:104
#, kde-format
msgctxt "dashboard introduction"
msgid ""
"Enter your query into the search field above and press the search button. "
"You can refine your search using the buttons above."
msgstr ""
"បញ្ចូល​សំណួរ​របស់​អ្នក​ទៅ​ក្នុង​វាល​ស្វែងរក​ខាង​លើ ហើយ​ចុច​ប៊ូតុង​ស្វែងរក​ ។ អ្នក​អាច​​សំអាត​ការ​ស្វែងរក​របស់​អ្នក​"
"ដោយ​ប្រើ​ប៊ូតុង​ខាងលើ ។"

#: dashboard.cpp:106
#, kde-format
msgctxt "dashboard header tags"
msgid "My Tags"
msgstr "ស្លាក​របស់​ខ្ញុំ"

#: dashboard.cpp:107
#, kde-format
msgctxt "dashboard header recent"
msgid "Recent Searches"
msgstr "ស្វែងរក​ថ្មីៗ"

#: dashboard.cpp:125
#, kde-format
msgid ""
"Desktop search is not activated. <a href=\"crystal:/opensettings\">Click "
"here</a> to enable it in System Settings."
msgstr ""
"ការ​ស្វែងរក​ផ្ទៃតុ​មិន​ត្រូវ​បានធ្វើ​ឲ្យ​សកម្ម​ទេ ។ <a href=\"crystal:/opensettings\">ចុច​ទីនេះ</"
"a> ដើម្បីបើក​វា​នៅ​ក្នុងការ​កំណត់​ប្រព័ន្ធ ។"

#: dashboard.cpp:136
#, kde-format
msgid "No tags found."
msgstr "រក​មិន​ឃើញ​ស្លាក​"

#: dialog.cpp:151
#, kde-format
msgid "Dashboard"
msgstr "ផ្ទាំង​គ្រប់គ្រង"

#: dialog.cpp:156
#, kde-format
msgid "Results"
msgstr "លទ្ធផល"

#: dialog.cpp:216
#, kde-format
msgctxt "no active search, no results shown"
msgid "Idle."
msgstr "ទំនេរ ។"

#: dialog.cpp:421
#, kde-format
msgid "Found %1 result for \"<i>%2</i>\" in %3."
msgid_plural "Found %1 results for \"<i>%2</i>\" in %3."
msgstr[0] "រក​ឃើញ​ %1 លទ្ធផល​សម្រាប់​ \"%2\" នៅ​ក្នុង​ %3 ។"

#: dialog.cpp:440
#, kde-format
msgid "Found %2 result in %1."
msgid_plural "Found %2 results in %1."
msgstr[0] "រកឃើញ​លទ្ធផល​ %2 នៅ​ក្នុង %1 ។"

#: dialog.cpp:452
#, kde-format
msgctxt "tooltip on result/dashboard button"
msgid "Show Results"
msgstr "បង្ហាញ​លទ្ធផល"

#: dialog.cpp:456
#, kde-format
msgctxt "tooltip on result/dashboard button"
msgid "Show Dashboard"
msgstr "បង្ហាញ​ផ្ទាំង​គ្រប់គ្រង"

#: resourcewidget.cpp:106
#, kde-format
msgctxt "default label for result, will usually be overwritten"
msgid "Generic Resource"
msgstr "ធនធាន​ទូទៅ"

#: resourcewidget.cpp:341
#, kde-format
msgid "Generic Result"
msgstr "លទ្ធផល​ទូទៅ"

