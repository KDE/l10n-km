#: kjobviewer.cpp:141
#, kde-format
msgid "There is no default printer. Start with --all to see all printers."
msgstr ""
"គ្មាន​ម៉ាស៊ីន​បោះពុម្ព​លំនាំ​ដើម ។ រើស​យក​ --ទាំង​អស់ ដើម្បី​មើល​ម៉ាស៊ីន​បោះពុម្ព​\n"
"ទាំង​អស់ ។"

#: kjobviewer.cpp:141
#, kde-format
msgid "Print Error"
msgstr "កំហុស​បោះពុម្ព"

