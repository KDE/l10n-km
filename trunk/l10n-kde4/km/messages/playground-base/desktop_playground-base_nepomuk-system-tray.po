#: plugins/backup/nepomuksystray_nepomukbackupsync.desktop:6
msgctxt "Name"
msgid "Backup and Sync system tray plugin"
msgstr "កម្មវិធី​ជំនួយ​​បម្រុងទុក និង​ធ្វើ​សមកាលកម្ម​ថាស​ប្រព័ន្ធ"

#: plugins/nepomuksystray_plugin.desktop:4
msgctxt "Name"
msgid "Nepomuk System Tray Plugin"
msgstr "កម្មវិធី​ជំនួយ​ថាស​ប្រព័ន្ធ​របស់ Nepomuk"

#: plugins/strigi/nepomuksystray_strigi.desktop:6
msgctxt "Name"
msgid "Strigi system tray plugin"
msgstr "កម្មវិធី​ជំនួយ​ថាស​ប្រព័ន្ធ​របស់ Strigi"

#: plugins/strigi/nepomuksystray_strigi.desktop:33
msgctxt "Comment"
msgid "Plugin for the Nepomuk system tray that controls the Strigi service"
msgstr "កម្មវិធី​ជំនួយ​សម្រាប់​ថាស​ប្រព័ន្ធ​របស់ Nepomuk ដែល​ត្រួតពិនិត្យ​សេវា​កម្ម Strigi"

#: runtime/plasma/dataengine/plasma-engine-nepomuk.desktop:2
msgctxt "Name"
msgid "Nepomuk Services Engine"
msgstr "ម៉ាស៊ីន​សេវាកម្ម Nepomuk"

#: runtime/plasma/dataengine/plasma-engine-nepomuk.desktop:26
msgctxt "Comment"
msgid "Engine that feeds statuses of all Nepomuk services"
msgstr "ម៉ាស៊ីនដែល​ស្ថានភាព​មតិព័ត៌មាន​​របស់​សេវាកម្ម Nepomuk ទាំង​អស់"

#: runtime/systemtray/nepomuksystray_qt.desktop:2
msgctxt "Name"
msgid "Nepomuk Services Controller"
msgstr "កម្មវិធី​ត្រួតពិនិត្យ​សេវា​កម្ម Nepomuk"

#: runtime/systemtray/nepomuksystray_qt.desktop:28
msgctxt "Comment"
msgid "System tray icon to control the behavior of the Nepomuk services"
msgstr "រូបតំណាង​ថាស​ប្រព័ន្ធ​ ដើម្បី​ត្រួតពិនិត្យ​ឥរិយាបថ​របស់​សេវា​កម្ម Nepomuk"
