#: contacts.cpp:169
#, kde-format
msgid "Contact Selection"
msgstr "ការ​ជ្រើស​ទំនាក់ទំនង"

#: contacts.cpp:170
#, kde-format
msgid "Display Properties"
msgstr "បង្ហាញលក្ខណៈសម្បត្តិ"

#: contacts.cpp:280
#, kde-format
msgid "You can add contacts in the settings dialog."
msgstr "អ្នក​អាច​បន្ថែម​ទំនាក់ទំនង​នៅក្នុង​ប្រអប់​កំណត់"

#. i18n: ectx: property (availableLabel), widget (KActionSelector, contacts)
#: contactsConfig.ui:16
#, kde-format
msgid "&Available contacts:"
msgstr "ទំនាក់ទំនង​ដែលមាន ៖"

#. i18n: ectx: property (selectedLabel), widget (KActionSelector, contacts)
#: contactsConfig.ui:19
#, kde-format
msgid "&Plasmoid contacts:"
msgstr "ទំនាក់ទំនង​ប្លាស្មយ ៖"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: displayConfig.ui:16
#, kde-format
msgid "Contacts"
msgstr "ទំនាក់ទំនង"

#. i18n: ectx: property (toolTip), widget (QCheckBox, contactsShowWidget)
#: displayConfig.ui:22
#, kde-format
msgid ""
"Enable this to show contact properties like their name, email address or "
"instant messaging status."
msgstr ""
"បើក​វា ដើម្បីបង្ហាញ​លក្ខណៈសម្បត្តិ​ទំនាក់ទំនង​ដូចជា​ឈ្មោះ​ អាសយដ្ឋាន​អ៊ីមែល ឬ​ស្ថានភាព​ផ្ញើសារ​បន្ទាន់​របស់​"
"ពួកវា ។"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, contactsShowWidget)
#: displayConfig.ui:25
#, kde-format
msgid ""
"Enable this to show contact properties like their name, email address or "
"instant messaging status. Which properties are shown in which order can be "
"configured in the \"Contact Properties\" tab."
msgstr ""
"បើកវា ដើម្បីបង្ហាញ​លក្ខណៈសម្បត្តិ​ទំនាក់ទំនង​ដូច​ជា​ឈ្មោះ​ អាសយដ្ឋាន​អ៊ីមែល ឬ​ស្ថានភាព​ផ្ញើសារ​បន្ទាន់​របស់​"
"ពួកវា ។ ដែល​លក្ខណៈសម្បត្តិ​ត្រូវ​បាន​បង្ហាញ​​ជា​លំដាប់ ដែលអាច​ត្រូវ​បានកំណត់​រចនាសម្ព័ន្ធ​នៅ​ក្នុង​ផ្ទាំង "
"\"លក្ខណៈសម្បត្តិទំនាក់ទំនង\" ។"

#. i18n: ectx: property (text), widget (QCheckBox, contactsShowWidget)
#: displayConfig.ui:28
#, kde-format
msgid "Show contact properties"
msgstr "បង្ហាញ​លក្ខណៈសម្បត្តិ​ទំនាក់ទំនង"

#. i18n: ectx: property (availableLabel), widget (KActionSelector, contactsSelection)
#: displayConfig.ui:38
#, kde-format
msgid "&Available properties:"
msgstr "លក្ខណៈសម្បត្តិ​ដែល​មាន ៖"

#. i18n: ectx: property (selectedLabel), widget (KActionSelector, contactsSelection)
#: displayConfig.ui:41
#, kde-format
msgid "&Shown properties:"
msgstr "បង្ហាញលក្ខណៈសម្បត្តិ ៖"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: displayConfig.ui:51
#, kde-format
msgid "Marble Map"
msgstr "ផែនទី​ម៉ាប"

#. i18n: ectx: property (toolTip), widget (QCheckBox, marbleShowWidget)
#. i18n: ectx: property (whatsThis), widget (QCheckBox, marbleShowWidget)
#: displayConfig.ui:57 displayConfig.ui:60
#, kde-format
msgid ""
"Enable this and a map will be shown that displays the location of contacts "
"(if known)."
msgstr "បើក​វា ហើយ​ផែនទី​នឹង​ត្រូវ​បានបង្ហាញ​ ដែល​កា​របង្ហាញ​ទីតាំង​របស់​ទំនាក់ទំនង (ប្រសិនបើ​ដឹង) ។"

#. i18n: ectx: property (text), widget (QCheckBox, marbleShowWidget)
#: displayConfig.ui:63
#, kde-format
msgid "Show a map of contacts"
msgstr "បង្ហាញ​ផែនទី​របស់​ទំនាក់ទំនង"

#. i18n: ectx: property (toolTip), widget (QListView, marbleTheme)
#. i18n: ectx: property (whatsThis), widget (QListView, marbleTheme)
#. i18n: ectx: property (toolTip), widget (QLabel, label)
#. i18n: ectx: property (whatsThis), widget (QLabel, label)
#: displayConfig.ui:91 displayConfig.ui:94 displayConfig.ui:104
#: displayConfig.ui:107
#, kde-format
msgid "Marble can display different maps (themes). Select one here."
msgstr "ម៉ាប​អាច​បង្ហាញ​ផែនទីខុសៗគ្នា (ស្បែក) ។ ជ្រើស​មួយ​នៅ​ទីនេះ ។"

#. i18n: ectx: property (text), widget (QLabel, label)
#: displayConfig.ui:110
#, kde-format
msgid "Marble Theme:"
msgstr "ស្បែក​ម៉ាប ៖"

#. i18n: ectx: property (toolTip), widget (QCheckBox, marbleRecenterOnLocationChange)
#: displayConfig.ui:120
#, kde-format
msgid ""
"The map center will be moved to contacts who change their location when this "
"setting is enabled."
msgstr ""
"មជ្ឈមណ្ឌល​ផែនទី​នឹង​ត្រូវ​បានផ្លាស់ទី​ទៅ​កាន់​ទំនាក់ទំនង​ ដែល​បានផ្លាស់ប្ដូរ​ទីតាំង​របស់វា នៅពេល​ការ​កំណត់​នេះ​ត្រូវ​"
"បាន​បើក ។"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, marbleRecenterOnLocationChange)
#: displayConfig.ui:123
#, kde-format
msgid ""
"The map center will be moved to contacts who change their location when this "
"setting is enabled. If, for example, you are adding a new contact to be "
"displayed, and the location of that contact is known, the map will show that "
"new contact with this setting enabled. When disabled, the map will not move "
"on its own, but stay at the point you moved it to last."
msgstr ""
"មជ្ឈមណ្ឌល​នេះ​នឹង​ត្រូ​វបានផ្លាស់ទីទៅកាន់​ទំនាក់ទំនង​ដែល​បានផ្លាស់ប្ដូរ​ទីតាំង​របស់​វា​នៅពេល​ការ​កំណត់​នេះ​ត្រូវ​"
"បានបើក ។ ឧទាហរណ៍ ប្រសិនបើ​ អ្នកកំពុង​បន្ថែម​ទំនាក់ទំនង​ថ្មី​ឲ្យ​បង្ហាញ ហើយទីតាំង​ដែល​ទំនាក់ទំនង​ត្រូវ​"
"បានស្គាល់ ផែនទី​នឹង​បង្ហាញ​ទំនាក់ទំនង​ថ្មី​ជា​មួយ​នឹង​ការ​កំណត់​ដែល​បានបើក ។ នៅ​ពេល​បាន​បិទ ផែនទី​​មិន​ផ្លាស់ទី​នៅ​"
"លើ​វា​ផ្ទាល់​ទេ ប៉ុន្តែ​នៅ​ចំណុច​ដែល​អ្នក​បាន​ផ្លាស់ទី​វា​ចុងក្រោយ ។"

#. i18n: ectx: property (text), widget (QCheckBox, marbleRecenterOnLocationChange)
#: displayConfig.ui:126
#, kde-format
msgid "Focus on contacts who change location"
msgstr "ផ្ដោត​លើ​ទំនាក់ទំនង​ដែល​ផ្លាស់ប្ដូរទីតាំង"

#: eventcell.cpp:66
#, kde-format
msgid "<b>One unread message:</b><br />"
msgid_plural "<b>%1 unread messages:</b><br />"
msgstr[0] "<b>សារ​មិនទាន់​ចំនួន %1 ៖</b><br />"

#: eventcell.cpp:89
#, kde-format
msgid "Today is %1 birthday"
msgstr "ថ្ងៃ​នេះ​ជា​ថ្ងៃ​ខួប​កំណើត %1"

#: eventcell.cpp:95
#, kde-format
msgid "Only one day left to %2 birthday"
msgid_plural "Only %1 days left to %2 birthday"
msgstr[0] "នៅ​សល់​តែ​ %1 ថ្ងៃ​ដល់​ថ្ងៃ​ខួប​កំណត់ %2"

#: lineeditcell.cpp:61
#, kde-format
msgid "Type a message and press return to send it"
msgstr "វាយ​សារ និង​ចុច return ដើម្បី​ផ្ញើវា"

#: lineeditcell.cpp:62
#, kde-format
msgid "This contact cannot be reached at the moment."
msgstr "មិនអាច​ទាក់ទង​ទំនាក់ទំនង​នេះ​បានទេ​នៅពេល​នេះ ។"

#: statuscell.cpp:95
#, kde-format
msgid "<b>Status Message:</b><br />%1"
msgstr "<b>សារ​ស្ថានភាព ៖</b><br />%1"
