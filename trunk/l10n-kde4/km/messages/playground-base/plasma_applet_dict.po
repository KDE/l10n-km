#: package/contents/ui/main.qml:104
#, kde-format
msgid "Type a word..."
msgstr "វាយ​ពាក្យ..."

#: package/contents/ui/main.qml:121
#, kde-format
msgid "Arbitrary String Which Says The Dictionary Type"
msgstr "ឃ្លា​ដែល​មិន​ត្រឹមត្រូវ ដែល​ជា​ការ​និយាយ​ប្រភេទ​វចនានុក្រម"

#: package/contents/ui/main.qml:237
#, kde-format
msgid "Loading..."
msgstr "កំពុង​ផ្ទុក..."

#: package/contents/ui/main.qml:248
#, kde-format
msgid ""
"This is the dictionary widget. Type a word in the search field above to get "
"a definition."
msgstr "វា​ជា​ធាតុ​ក្រាហ្វិក​វចនានុក្រម ។ វាយ​ពាក្យ​នៅ​ក្នុង​វាល​ស្វែងរក​ខាងលើ​ដើម្បី​ទទួល​បាន​និយមន័យ ។"
