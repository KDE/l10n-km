#: publisher/publisher.cpp:36
msgid "Export project"
msgstr "នាំចេញ​គម្រោង"

#: publisher/publisher.cpp:37
msgid ""
"Choose a target file to export the current project to an installable package "
"file on your system."
msgstr ""
"ជ្រើស​ឯកសារ​គោលដៅ​ដើម្បី​នាំ​ចេញ​គម្រោង​បច្ចុប្បន្ន​ទៅ​កាន់​ឯកសារ​កញ្ចប់​ដែល​អាច​ដំឡើង​បាន​នៅ​លើ​ប្រព័ន្ធ​របស់​"
"អ្នក​ ។"

