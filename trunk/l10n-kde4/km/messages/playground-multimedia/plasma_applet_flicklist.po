#: flicklist.cpp:49
msgid "Scrolling speed:"
msgstr "ល្បឿន​រមូរ ៖"

#: flicklist.cpp:52
msgid "Set Speed"
msgstr "កំណត់​ល្បឿន"

#: flicklist.cpp:63
msgid "Flicking velocity:"
msgstr "ភាពរហ័ស​នៃ​ការ​ផ្ទាត់ ៖"

#: flicklist.cpp:66
msgid "Set Velocity"
msgstr "កំណត់​ភាព​រហ័ស"

#: flicklist.cpp:78
msgid "<b>Wiimote Flicklist Demo</b>"
msgstr "<b>បង្ហាញ​បញ្ជី​ផ្ទាត់​​សាកល្បង Wiimote​</b>"

#: flicklist.cpp:82
msgid ""
"Point the wiimote at the ledbar, hold <b>B</b> pressed and move up and down "
"to scroll."
msgstr "ចង្អុល​ wiimote នៅ​លើ​របារ​ ចុច <b>B</b> ហើយ​ផ្លាស់ទី​ឡើង​លើ និង​ចុះក្រោម​ដើម្បី​រមូរ ។"

#: flicklist.cpp:117
msgid "No world to say hello"
msgstr "គ្មាន​ពាក្យ​ត្រូវ​និយាយ​សួរស្ដី​ទេ"
