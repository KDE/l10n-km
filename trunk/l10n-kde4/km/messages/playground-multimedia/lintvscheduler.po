#: src/ui/lintvprogrameditor.cpp:202
#, kde-format
msgid ""
"&nbsp; - You set the start time to <b>%1</b>, but the current time is <b>%2</"
"b>.<br>"
msgstr ""
"&nbsp; - អ្នក​បាន​កំណត់​ពេល​វេលា​ចាប់​ផ្ដើម​ជា​ <b>%1</b> ប៉ុន្តែ​ ពេល​វេលា​បច្ចុប្បន្ន​គឺ​ <b>%2</b> ។"
"<br>"

#: src/ui/lintvprogrameditor.cpp:210
#, kde-format
msgid "&nbsp; - Cannot record for <b>%1</b>.<br>"
msgstr "&nbsp; - មិន​អាច​ថត​សម្រាប់​ <b>%1</b> ។<br>"

#: src/ui/lintvprogrameditor.cpp:216
#, kde-format
msgid ""
"&nbsp; - Today is <b>%1</b>, but you set the date to start recording to <b>"
"%2</b>.<br>"
msgstr ""
"&nbsp; - ថ្ងៃ​នេះ​ជា​ <b>%1</b> ប៉ុន្តែ អ្នក​បាន​កំណត់​កាល​បរិច្ឆេទ​ ដើម្បី​ចាប់​ផ្ដើម​ថត​ជា​ <b>%2</"
"b> ។<br>"

#: src/ui/lintvprogrameditor.cpp:224
#, kde-format
msgid ""
"&nbsp; - You set the end time (<b>%1</b>) before the start time (<b>%2</b>)."
"<br>"
msgstr ""
"&nbsp; - អ្នក​បាន​កំណត់​ពេល​វេលា​បញ្ចប់​ (<b>%1</b>) មុន​ពេលវេលា​ចាប់​ផ្ដើម​ (<b>%2</b>) ។<br>"

#: src/ui/lintvprogrameditor.cpp:230
msgid "Errors saving program:<br>"
msgstr "កំហុស​ក្នុង​ការ​រក្សា​ទុក​កម្មវិធី ៖<br>"

