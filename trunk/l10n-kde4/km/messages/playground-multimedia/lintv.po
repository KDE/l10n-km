msgstr "បាន​ចាប់​ផ្ដើម​ថត​ \"%1\" នៅត្រង់​ %2"

#: src/lintv.cpp:263
msgid ""
"Mplayer or mencoder executable could not be found.\n"
"You must install Mplayer and mencoder in order to use LinTV."
msgstr ""
"រក​មិន​ឃើញ Mplayer ឬ​ mencoder ដែល​អាច​ប្រតិបត្តិ​បាន​ ។\n"
"អ្នក​ត្រូវ​តែ​ដំឡើង​ Mplayer និង​ mencoder ដើម្បី​ប្រើ​ LinTV ។"

#: src/lintv.cpp:266
msgid "Missing Dependencies"
msgstr "បាត់​ភាព​អាស្រ័យ"

#: src/lintv.cpp:640
#, kde-format
msgid "Are you sure you want to cancel the current recording (\"%1\")?\n"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​បោះ​បង់​ការ​ថត​បច្ចុប្បន្ន​ឬ  (\"%1\") ?\n"

#: src/lintv.cpp:643
msgid "Are you sure?"
msgstr "តើ​អ្នក​ប្រាកដ​ហើយ​ឬ ?"

#: src/lintv.cpp:711
msgid "Hide LinTV"
msgstr "លាក់​ LinTV"

#: src/lintv.cpp:765
#, kde-format
msgid "User canceled \"%1\""
msgstr "បាន​បោះ​បង់​ដោយ​អ្នក​ប្រើ​ \"%1\""

#: src/lintv.cpp:768
#, kde-format
msgid "Finished Recording \"%1\" at %2"
msgstr "បាន​បញ្ចប់​ការ​ថត​ \"%1\" នៅ​ត្រង់​ %2"

#: src/lintv.cpp:833
msgid ""
"LinTV is currently recording: all recordings must be stopped before exiting "
"LinTV."
msgstr "LinTV កំពុង​តែ​ថត ៖ ត្រូវ​តែ​បញ្ឈប់​ការ​ថត​ទាំង​អស់​ជា​មុន​សិន មុន​នឹង​បិទ​ LinTV ។"

#: src/lintv.cpp:835
msgid "Stop recording before exiting"
msgstr "បញ្ឈប់​ការ​ថត មុន​នឹង​បិទ"

