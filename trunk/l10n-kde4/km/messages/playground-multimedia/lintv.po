#, kde-format
msgid "LinTV is currently recording \"%1\" to file: \"%2\""
msgstr "បច្ចុប្បន្ន​ LinTV កំពុងតែ​ថត​ \"%1\" ទៅ​កាន់​ឯកសារ​ ៖ \"%2\""

