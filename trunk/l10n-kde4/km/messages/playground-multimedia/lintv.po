#: src/lintv.cpp:112 src/lintv.cpp:706
msgid "Show LinTV"
msgstr "បង្ហាញ LinTV"

#: src/lintv.cpp:118
msgid "Open LinTV Scheduler"
msgstr "បើក​កម្មវិធី​កំណត់​​កាល​វិភាគ​របស់ LinTV"

