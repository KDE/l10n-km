#. i18n: file: eventappletformatconfig.ui:30
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:92
#, no-c-format
msgid ""
"The format for the displayed text for events.\n"
"Substitutions (mostly self-explanatory) are:\n"
"%{startDate}, %{endDate} - start and end date, %{startTime}, %{endTime} - "
"start and end time,\n"
"%{summary} - summary, %{description} - description, %{location} - location, "
"%{duration} - duration,\n"
"%{yearsSince} - years since the first time (useful for birthdays),\n"
"%{resourceName} - the i18n name of the Akonadi resource,\n"
"%{mainCategory}, %{categories} - the first or all categories,\n"
"%{tab} - a tabulator"
msgstr ""
"The format for the displayed text for events.\n"
"Substitutions (mostly self-explanatory) are:\n"
"%{startDate}, %{endDate} - start and end date, %{startTime}, %{endTime} - "
"start and end time,\n"
"%{summary} - summary, %{description} - description, %{location} - location, "
"%{duration} - duration,\n"
"%{yearsSince} - years since the first time (useful for birthdays),\n"
"%{resourceName} - the i18n name of the Akonadi resource,\n"
"%{mainCategory}, %{categories} - the first or all categories,\n"
"%{tab} - a tabulator"

