#: facebookresource_friends.cpp:146
#, kde-format
msgid "Unable to retrieve friends' information from server: %1"
msgstr "មិនអាច​ទៅយក​ព័ត៌មាន​របស់​មិត្តភក្ដិ​ពី​ម៉ាស៊ីនបម្រើ ៖%1"

