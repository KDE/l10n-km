#: facebookresource.cpp:103
msgid "Unable to login to Facebook, authentication failure."
msgstr "មិន​អាច​ចូឡ Facebook បាន​ទេ ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​បាន​បរាជ័យ ។"

#: facebookresource.cpp:148
msgid "Preparing sync of friends list."
msgstr "រៀបចំ​ធ្វើ​សមកាលកម្ម​បញ្ជី​មិត្តភក្ដិ ។"

#: facebookresource.cpp:157
msgid "Preparing sync of events list."
msgstr "រៀបចំ​ធ្វើ​សមកាលកម្ម​បញ្ជី​ព្រឹត្តិការណ៍ ។"

#: facebookresource.cpp:166
msgid "Preparing sync of notes list."
msgstr "រៀបចំ​ធ្វើ​សមកាលកម្ម​បញ្ជី​ចំណាំ ។"

#: facebookresource.cpp:175
msgid "Preparing sync of posts."
msgstr "រៀបចំ​ធ្វើ​សមកាលកម្ម​​ប្រកាស ។"

#: facebookresource.cpp:184
msgid "Preparing sync of notifications."
msgstr "រៀបចំ​ធ្វើ​សមកាលកម្ម​ការ​ជូន​ដំណឹង ។"

