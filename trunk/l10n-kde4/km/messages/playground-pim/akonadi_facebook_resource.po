#: facebookresource_friends.cpp:176
#, kde-format
msgid "Updated one friend from the server."
msgid_plural "Updated %1 friends from the server."
msgstr[0] "បាន​ធ្វើ​បច្ចុប្បន្ន​ភាព​មិត្តភក្ដិ %1 ពី​ម៉ាស៊ីន​បម្រើ ។"

#: facebookresource_friends.cpp:179
msgid "Finished, no friends needed to be updated."
