#: facebookresource.cpp:311
#, kde-format
msgid "Unable to delete note from server: %1"
msgstr "មិនអាច​លុប​ចំណាំ​ពី​ម៉ាស៊ីន​បម្រើ​បាន​ទេ ៖ %1"

