#: emailcollectionconfig.cpp:96
#| msgctxt "@title:window"
#| msgid "Select Addressbook Folder"
msgctxt "@title:window"
msgid "Select Address Book Folder"
msgstr "​ជ្រើស​ថត​សៀវភៅ​អាសយដ្ឋាន"

#: emailcollectionconfig.cpp:175
msgctxt "@title:window"
msgid "Manage Email Sources"
msgstr "គ្រប់គ្រង​ធនធាន​អ៊ីមែល"

#: emailcollectionconfig.cpp:184
#, kde-format
msgctxt "@info"
msgid ""
"<title>Please select the folder for storing newly created emails.</"
"title><note>If the folder list below is empty, you might have to add an "
"email source through <interface>%1</interface> <br>or change which folders "
"you are subscribed to through <interface>%2</interface></note>"
msgstr ""
"<title>សូម​ជ្រើស​ថត​សម្រាប់​ទុក​អ៊ីមែល​ដែល​បានបង្កើត​ថ្មី ។</title><note>ប្រសិន​បើ​បញ្ជី​ថត​ខាង​ក្រោម​ទទេ "
"អ្នកអាច​បន្ថែម​ប្រភព​អ៊ីមែល​តាមរយៈ <interface>%1</interface> <br>ឬ​ផ្លាស់ប្ដូរ​ថត​ណាមួយ​ដែល​អ្នក​​"
"បាន​​ជាវ​តាមរយៈ <interface>%2</interface></note>"

#: kremail.cpp:78
msgid "New"
msgstr "ថ្មី"

#: kremail.cpp:85
msgid "Save"
msgstr "រក្សាទុក"

#: kremail.cpp:134 kremail.cpp:154
msgid "No scanner found."
msgstr "រក​មិនឃើញ​ម៉ាស៊ីន​ស្កេន ។"

#: kremail.cpp:150
#, kde-format
#| msgid "Opening the selected scanner (%1) failed! Retrying..."
msgid "Opening the selected scanner (%1) failed. Retrying...."
msgstr "បាន​បរាជ័យ​ក្នុងការ​បើក​ម៉ាស៊ីន​ស្កេន​ដែល​បាន​ជ្រើស (%1) ! កំពុង​ព្យាយាម​ម្ដង​ទៀត..."

#: kremail.cpp:164
#, kde-format
msgid "Opening the selected scanner (%1) failed again. Scanning failed."
msgstr "បាន​បរាជ័យ​ក្នុងកា​របើក​ម៉ាស៊ីន​ស្កេន​ដែលបាន​ជ្រើស (%1) ម្ដង​ទៀត ។ បាន​បរាជ័យ​យក្នុងការ​ស្កេន ។"

#: kremail.cpp:313
msgid "Email item created successfully"
msgstr "បានបង្កើត​ធាតុ​អ៊ីមែល​ដោយ​​ជោគជ័យ"

#: kremail.cpp:317
msgid "Error occurred"
msgstr "កំហុស​បានកើត​ឡើង"

#: main.cpp:11
msgid "kReMail"
msgstr "kReMail"

#: main.cpp:13
msgid "A program to convert traditional mail to an electronic format."
msgstr "កម្មវិធី​ត្រូវ​បម្លែង​សំបុត្រ​ចាស់​ទៅ​ជា​ទ្រង់ទ្រាយ​អេឡិចត្រូនិក ។"

