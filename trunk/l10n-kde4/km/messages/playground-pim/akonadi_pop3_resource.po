#: pop3resource.cpp:107
msgid "Starting mail check..."
msgstr "ចាប់ផ្ដើម​ពិនិត្យ​មើល​សំបុត្រ..."

#: pop3resource.cpp:113
msgid "No target folder set, aborting mail check."
msgstr "មិន​មាន​ថត​គោលដៅ​បាន​កំណត់​ទេ បោះបង់​ការ​ពិនិត្យ​សំបុត្រ ។"

#: pop3resource.cpp:125
msgid "You need to supply a username and a password to access this mailbox."
msgstr "អ្នក​ត្រូវ​តែ​ផ្ដល់​ឈ្មោះ​អ្នក​ប្រើ និង​ពាក្យ​សម្ងាត់​ដើម្បី​ចូលដំណើរការ​ប្រអប់​សំបុត្រ​នេះ ។"

#: pop3resource.cpp:127
msgid "Account:"
msgstr "គណនី ៖"

#: pop3resource.cpp:130
msgid "No username and password supplied."
msgstr "គ្មាន​អ្នក​ប្រើ និង​ពាក្យ​សម្ងាត់​បាន​ផ្ដល់ទេ ។"

#: pop3resource.cpp:175
msgid "Mail check already in progress, unable to start a second check."
msgstr "ការ​ពិនិត្យ​សំបុត្រ​កំពុង​ដំណើរការ មិនអាច​ចាប់ផ្ដើម​ពិនិត្យ​លើក​ទីពីរ​បានទេ ។"

#: pop3resource.cpp:193
msgid "Source URL is malformed"
msgstr "URL មិន​ត្រឹមត្រូវ"

#: pop3resource.cpp:194
msgid "Kioslave Error Message"
msgstr "សារ​កំហុស​របស់ Kioslave"

#. i18n("Preparing transmission from \"%1\"...", mName),
#. true, // can be canceled
#. useSSL() || useTLS() );
#. connect( mMailCheckProgressItem, SIGNAL( progressItemCanceled( KPIM::ProgressItem* ) ),
#. this, SLOT( slotAbortRequested() ) );
#. FIXME
#: pop3resource.cpp:223
#, kde-format
msgid "Preparing transmission from \"%1\"..."
msgstr "កំពុង​រៀបចំ​បញ្ជូន​ពី \"%1\"..."

#: pop3resource.cpp:377
#, kde-format
msgid ""
"Fetching message %1 of %2 (%3 of %4 KB) for %5@%6 (%7 KB remain on the "
"server)."
msgstr "ទៅ​យក​សារ %1 នៃ %2 (%3 នៃ %4 គីឡូបៃ) សម្រាប់ %5@%6 (%7 គីឡូបៃ នៅ​សល់​លើ​ម៉ាស៊ីន​បម្រើ) ។"

#: pop3resource.cpp:386
#, kde-format
msgid "Fetching message %1 of %2 (%3 of %4 KB) for %5@%6."
msgstr "ទៅ​យក​សារ %1 នៃ %2 (%3 នៃ %4 គីឡូបៃ) សម្រាប់ %5@%6 ។"

#: pop3resource.cpp:737
msgid "Adding remaining messages to the target folder."
msgstr "បន្ថែម​សារ​ដែល​នៅ​សល់​ទៅ​ថត​គោលដៅ ។"

#: pop3resource.cpp:845
#, kde-format
msgid "Fetched 1 message from %2. Deleting messages from server..."
msgid_plural "Fetched %1 messages from %2. Deleting messages from server..."
msgstr[0] "បាន​ទៅ​យក​សារ %1 ពី %2 ។ លុប​សារ​ពីម៉ាស៊ីនបម្រើ..."

#: pop3resource.cpp:860 pop3resource.cpp:876
#, kde-format
msgid "Fetched 1 message from %2. Terminating transmission..."
msgid_plural "Fetched %1 messages from %2. Terminating transmission..."
msgstr[0] "បាន​ទៅ​យកសារ %1 ពី %2 ។ កំពុង​បញ្ចប់​ការ​បញ្ជូន..."

#: pop3resource.cpp:986
#, kde-format
msgid ""
"The message could not be added to the target folder.\n"
"%1"
msgstr ""
"សារ​មិនអាច​ត្រូវ​បាន​បន្ថែម​ទៅ​ថត​គោលដៅ​បានទេ ។\n"
"%1"

