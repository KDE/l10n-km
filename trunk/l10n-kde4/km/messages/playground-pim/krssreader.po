#: migratefeedscommand.cpp:70 migratefeedscommand.cpp:211
#, kde-format
msgid "Akonadi Data Migration"
msgstr "កា​រផ្លាស់ប្ដូរ​ទិន្នន័យ Akonadi"

#: migratefeedscommand.cpp:72
#, kde-format
msgid ""
"Since version 1.4, Akregator uses the Akonadi framework to store feeds and "
"articles. Your feeds and articles from older Akregator versions will now be "
"migrated."
msgstr ""
"តាំង​ពី​កំណែ ១.៤ Akregator ប្រើ​គ្រោងការណ៍ Akonadi ដើម្បី​ទុក​មតិព័ត៌មាន និង​អត្ថបទ ។ មតិព័ត៌មាន "
"និងអត្ថបទ​របស់​អ្នក​ពី​កំណែ Akregator ចាស់​នឹង​ត្រូវ​បានផ្លាស់ប្ដូរ ។"

#: migratefeedscommand.cpp:76
#, kde-format
msgid "Please choose the resource to use for importing feeds and articles."
msgstr "សូមជ្រើស​ធនធាន​ដើម្បីប្រើ​សម្រាប់នាំចូល​មតិព័ត៌មាន និងអត្ថបទ ។"

#: migratefeedscommand.cpp:84
#, kde-format
msgid "Resource:"
msgstr "ធនធាន ៖"

#: migratefeedscommand.cpp:135
#, kde-format
msgid "Failed: %1 (%2)"
msgstr "បានបរាជ័យ ៖ %1 (%2)"

#: migratefeedscommand.cpp:139
#, kde-format
msgid "Imported: %1"
msgstr "បាននាំចូល ៖ %1"

#: migratefeedscommand.cpp:310
#, kde-format
msgid ""
"<p>The import of the existing feed list failed:</p><p>%1</p><p>Could not "
"import your feeds and archived articles.</p>"
msgstr ""
"<p>បានបរាជ័យ​ក្នុងកា​រនាំចូល​បញ្ជី​មតិព័ត៌មាន​ដែលមាន​ស្រាប់ ៖</p><p>%1</p><p>មិនអាច​នាំចូល​មតិព័ត៌មាន​"
"របស់​អ្នក និង​អត្ថបទ​ដែលបានទុកជា​ប័ណ្ណសារ​ទេ ។</p>"

#: migratefeedscommand.cpp:326
#, kde-format
msgid ""
"<p>The existing feed list was successfully imported. In the next step, the "
"archived articles from these feeds will be imported.</p>"
msgstr ""
"<p>បញ្ជី​មតិព័ត៌មាន​ដែល​មាន​ស្រាប់​ត្រូ​វបាន​នាំចូលដោយ​ជោគជ័យ ។ ក្នុង​ជំហាន​បន្ទាប់ អត្ថបទ​ដែលបានទុកជា​"
"ប័ណ្ណសារ​ពី​មតិព័ត៌មាន​ទាំង​នេះ​នឹង​ត្រូ​វបាននាំចូល​ ។</p>"

#: migratefeedscommand.cpp:336
#, kde-format
msgid "Importing feed list..."
msgstr "កំពុង​នាំចូល​បញ្ជី​មតិព័ត៌មាន..."

#: migratefeedscommand.cpp:341
#, kde-format
msgid "Import of archived articles finished."
msgstr "បាន​បញ្ចប់ការ​នាំចូល​អត្ថបទ​ដែលបាន​ទុកជា​ប័ណ្ណសារ ។"

#: migratefeedscommand.cpp:357
#, kde-format
msgctxt "current position, total number, feed title"
msgid "Importing items for feed %1 of %2: \"%3\"..."
msgstr "កំពុង​នាំចូល​ធាតុ​សម្រាប់មតិព័ត៌មាន %1 នៃ %2 ៖ \"%3\"..."
