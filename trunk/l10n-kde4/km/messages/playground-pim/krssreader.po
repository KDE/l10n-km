#: importitemsjob.cpp:123
#, kde-format
msgid "Could not generate a temporary file for export."
msgstr "មិនអាច​បង្កើត​ឯកសារ​បណ្ដោះអាសន្ន​ដើម្បីនាំចេញ​បានទេ ។"

#: importitemsjob.cpp:137
#, kde-format
msgid ""
"Could not start storage exporter %1. Make sure it is properly installed."
msgstr ""
"មិនអាច​ចាប់ផ្ដើម​កម្មវិធី​នាំចេញ​កា​រផ្ទុក​ %1 បានទេ ។ សូម​ប្រាកដ​ថា វា​ត្រូវ​បានដំឡើង​យ៉ាង​ត្រឹមត្រូវ ។"

#: importitemsjob.cpp:147
#, kde-format
msgid "Storage exporter failed to start."
msgstr "បានបរាជ័យ​ក្នុងកា​រចាប់ផ្ដើម​កម្មវិធីនាំចេញ​ការផ្ទុក ។"

#: importitemsjob.cpp:150
#, kde-format
msgid "Storage exporter crashed."
msgstr "បានគាំង​កម្មវិធីនាំចេញ​ការ​ផ្ទុក ។"

#: importitemsjob.cpp:153
#, kde-format
msgid "Storage exporter communication timed out."
msgstr "អស់ពេល​ទំនាក់ទំនង​កម្មវិធីនាំចេញ​ការ​ផ្ទុក ។"

#: importitemsjob.cpp:156
#, kde-format
msgid "Storage exporter write error."
msgstr "កំហុស​សរសេរ​កម្មវិធី​នាំចេញ​ការ​ផ្ទុក​ ។"

#: importitemsjob.cpp:159
#, kde-format
msgid "Storage exporter read error."
msgstr "កំហុស​អាន​កម្មវិធីនាំចេញ​ការ​ផ្ទុក ។"

#: importitemsjob.cpp:162
#, kde-format
msgid "Storage exporter: unknown error"
msgstr "កម្មវិធី​នាំចេញ​ការ​ផ្ទុក ៖ មិន​ស្គាល់​កំហុស"

#: importitemsjob.cpp:171
#, kde-format
msgid "Item export failed. Storage exporter %1 crashed."
msgstr "បានបរាជ័យ​ក្នុងការ​នាំធាតុ​ចេញ ។ កម្មវិធីនាំចេញ​ការ​ផ្ទុក %1 បានគាំង ។"

#: importitemsjob.cpp:178
#, kde-format
msgid "Item export failed. Storage exporter %1 returned exit code %2."
msgstr "បានបរាជ័យ​ក្នុង​ការ​នាំធាតុ​ចេញ ។ កម្មវិធី​នាំចេញ​ការ​ផ្ទុក %1 បាន​ត្រឡប់កូដ​ចេញ %2 ។"

#: importitemsjob.cpp:185
#, kde-format
msgid "Item import failed, target resource was already deleted."
msgstr "បានបរាជ័យ​ក្នុងកា​រនាំចូល​ធាតុ បាន​លុប​ធនធាន​គោលដៅ​រួ​ចរាល់​ហើយ ។"

