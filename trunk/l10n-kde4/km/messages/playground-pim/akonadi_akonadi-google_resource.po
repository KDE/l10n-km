#. i18n: file: calendar/settingsdialog.ui:59
#. i18n: ectx: property (text), widget (QLabel, authenticateLabel)
#: rc.cpp:12
msgid ""
"<html><body><p>In order to access Google services you need to authenticate. "
"Click the <i>Authenticate</i> button and follow instructions in the dialog.</"
"p></body></html>"
msgstr ""
"<html><body><p>ដើម្បី​ចូល​ដំណើរការ​សេវា​កម្ម​ហ្គូហ្គល អ្នក​ត្រូវ​តែ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ។ ចុច​ប៊ូតុង "
"<i>ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ</i> ហើយ​អនុវត្ត​តាម​សេចក្ដីណែនាំ​នៅ​ក្នុង​ប្រអប់ ។</p></body></html>"

