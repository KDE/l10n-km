#: error.cpp:47
msgid "The XML response from the server could not be parsed"
msgstr "មិន​អាច​ញែក​ការ​ឆ្លើយតប XML ពី​ម៉ាស៊ីន​បម្រើ"

#: error.cpp:50
msgid "No error.  You can test for this using Error::isValid()"
msgstr "គ្មាន ។  អ្នក​អាច​សាកល្បង​សម្រាប់​ការ​ប្រើ​កំហុស​នេះ::isValid()"

#: error.cpp:53
msgid "An unknown error occurred. Please resubmit the request."
msgstr "កំហុស​មិន​ស្គាល់​បាន​កើត​ឡើង ។ សូម​ដាក់​ស្នើ​សំណើ​ឡើង​វិញ ។"

#: error.cpp:56
msgid "The service is not available at this time."
msgstr "សេវា​មិន​មាន​នៅ​ពេល​នេះ ។"

#: error.cpp:59
msgid ""
"The application has reached the maximum number of requests allowed. More "
"requests are allowed once the time window has completed."
msgstr ""
"កម្មវិធី​បាន​ដល់​ចំនួន​អតិបរមា​នៃ​សំណើ​ដែល​បាន​ស្នើ ។ សំណើ​បន្ថែម​ត្រូវ​បាន​អនុញ្ញាត​តែ​ម្ដង ពេល​បង្អួច​បញ្ចប់ ។"

#: error.cpp:62
msgid "The request came from a remote address not allowed by this application."
msgstr "សំណើ​មក​ពី​អាសយដ្ឋាន​ពី​ចម្ងាយ​មិន​ត្រូវ​បាន​អនុញ្ញាត​ដោយ​កម្មវិធី​នេះ​ទេ ។"

#: error.cpp:65
msgid "One of the parameters specified was missing or invalid."
msgstr "ប៉ារ៉ាម៉ែត្រ​ដែល​បាន​បញ្ជាក់​មួយ​បាត់ ឬ​មិន​ត្រឹមត្រូវ ។"

#: error.cpp:68
msgid "The api key submitted is not associated with any known application."
msgstr "កូន​សោ api ដែល​បាន​ដាក់​ស្នើ​មិន​ទាក់ទង​ជាមួយ​កម្មវិធី​ដែល​ស្គាល់​ណាមួយ​ទេ ។"

#: error.cpp:71
msgid ""
"The session key was improperly submitted or has reached its timeout. Direct "
"the user to log in again to obtain another key."
msgstr ""
"កូន​សោ​សម័យ​ត្រូវ​បាន​ដាក់ស្នើ​ដោយ​មិន​ត្រឹមត្រូវ ឬ​បាន​អស់​ពេល ។ ប្រាប់​អ្នក​ប្រើ​ឲ្យ​ចូល​ម្ដង​ទៀត​ដើម្បី​យក​កូន​សោ​មួយ​"
"ផ្សេង​ទៀត ។"

#: error.cpp:74
msgid ""
"The submitted call_id was not greater than the previous call_id for this "
"session."
msgstr "call_id ដែល​បាន​ដាក់​ស្នើ​មិន​ធំ​ជាង call_id មុន​សម្រាប់​សម័យ​នេះ ។"

#: error.cpp:77
msgid "Incorrect signature."
msgstr "ហត្ថលេខា​មិន​ត្រឹមត្រូវ ។"

#: error.cpp:80
msgid "Invalid user id."
msgstr "លេខ​សម្គាល់​អ្នក​ប្រើ​មិន​ត្រឹមត្រូវ ។"

#: error.cpp:83
msgid "Invalid photo id."
msgstr "លេខ​សម្គាល់​រូបថត​មិន​ត្រឹមត្រូវ ។"

#: error.cpp:86
msgid "The uid cannot be specified from a desktop application."
msgstr "uid មិន​អាច​ត្រូវ​បាន​បញ្ជាក់​ពី​កម្មវិធី​ផ្ទៃតុ ។"

#: error.cpp:89
msgid "Invalid photo tag subject."
msgstr "ប្រធាន​បទ​ស្លាក​រូបថត​មិន​ត្រឹមត្រូវ ។"

#: error.cpp:92
msgid "Cannot tag photo already visible on Facebook."
msgstr "មិន​អាច​ដាក់​ស្លាក​រូបថត​ដែល​អាច​មើល​ឃើញ​លើ Facebook ។"

#: error.cpp:95
msgid "Too many photo tags pending."
msgstr "មាន​ស្លាក​រូបថត​មិន​ទាន់​សម្រេច ។"

#: error.cpp:98
msgid "The markup was invalid"
msgstr "ការ​សម្គាល់​មិន​ត្រឹមត្រូវ"

#: error.cpp:101
msgid "Error while parsing FQL statement."
msgstr "កំហុស​ខណៈ​ពេល​ញែក​សេចក្ដី​ថ្លែងការណ៍ FQL ។"

#: error.cpp:104
msgid "The field you requested does not exist."
msgstr "វាល​ដែល​អ្នក​ស្នើ​មិន​មាន​ទេ ។"

#: error.cpp:107
msgid "The table you requested does not exist."
msgstr "តារាង​ដែល​អ្នក​ស្នើ​មិន​មាន​ទេ ។"

#: error.cpp:110
msgid "Your statement is not indexable."
msgstr "សេចក្ដី​ថ្លែងការណ៍​មិន​អាច​ធ្វើ​លិបិក្រម ។"

#: error.cpp:113
msgid "The function you called down not exist."
msgstr "អនុគមន៍​ដែល​អ្នក​ហៅ​ចុះ​មិន​មាន​ទេ ។"

#: error.cpp:116
msgid "Wrong number of arguments passed into the function."
msgstr "ចំនួន​អាគុយម៉ង់​ខុស​បញ្ជូន​ទៅ​ក្នុង​អនុគមន៍ ។"

#: error.cpp:119
msgid "ERROR Error: an unrecognized error was received from Facebook."
msgstr "កំហុស ERROR ៖ កំហុស​មិន​ស្គាល់​ត្រូវ​បាន​ទទួល​ពី Facebook ។"

