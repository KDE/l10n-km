msgid "Provides the metadata for all rekollect notes"
msgstr "ផ្ដល់​នូវ​ទិន្នន័យ​មេតា​សម្រាប់​ចំណាំ rekollect​ ទាំងអស់"

#: src/rekollect.desktop:2
msgctxt "Name"
msgid "Rekollect"
msgstr "Rekollect"

#: src/rekollect.desktop:28
msgctxt "Comment"
msgid "Create and manage notes and lists"
msgstr "បង្កើត និង​គ្រប់គ្រង​ចំណាំ និង​បញ្ជី"

#: src/rekollect.desktop:53
msgctxt "GenericName"
