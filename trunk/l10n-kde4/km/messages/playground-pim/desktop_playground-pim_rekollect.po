#: src/applet/metadata.desktop:2
msgctxt "Name"
msgid "Rekollect Notes"
msgstr "ចំណាំ Rekollect"

#: src/applet/metadata.desktop:24
msgctxt "Comment"
msgid "Displays a list of notes available in Rekollect"
msgstr "បង្ហាញ​បញ្ជី​ចំណាំ​ដែល​មាន​នៅ​ក្នុង Rekollect"

#: src/dataengine/plasma-engine-rekollectnotes.desktop:2
