#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,​​evannak@khmeros.info,piseth_dv@khmeros.info"

#: main.cpp:30
#, kde-format
msgid "Recipients Picker Demo"
msgstr "អ្នក​ទទួល​កា​របង្ហាញ​សាកល្បង​របស់​ឧបកណ៍​ជ្រើស"

#: main.cpp:31
#, kde-format
msgid "(c) 2007"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៧"

#: mainwindow.cpp:74
#, kde-format
msgid "Select recipient"
msgstr "ជ្រើស​អ្នក​ទទួល"

#: mainwindow.cpp:79 mainwindow.cpp:221
#, kde-format
msgid "Advanced Interface"
msgstr "ចំណុច​ប្រទាក់​កម្រិត​ខ្ពស់"

#: mainwindow.cpp:80
#, kde-format
msgid ""
"Toggles between a simple interface to add one or more persons as recipient "
"or an advanced interface with more possibilities which are not required so "
"often."
msgstr ""
"បិទ/បើក​រវាង​ចំណុច​ប្រទាក់​ធម្មតា ដើម្បី​បន្ថែម​មនុស្ស​ម្នាក់ ឬ​ច្រើន​ជា​អ្នក​ទទួល ឬ​ចំណុច​ប្រទាក់​កម្រិត​ខ្ពស់​ដែល​"
"មាន​លទ្ធភាប​ច្រើន​ដែល​មិន​ត្រូវ​បាន​ទាមទារ​ជា​រឿយៗ ។"

#: mainwindow.cpp:93
#, kde-format
msgid "This list displays persons who are filtered with the settings above."
msgstr "បញ្ជី​នេះ​បង្ហាញ​មនុស្ស​ដែល​ត្រូវ​បាន​ត្រង​ជា​មួយ​នឹង​ខាង​ការ​កំណត់​ខាងលើ ។"

#: mainwindow.cpp:106
#, kde-format
msgid "Marked persons only "
msgstr "បាន​សម្គាល់​តែ​មនុស្ស "

#: mainwindow.cpp:107
#, kde-format
msgid "Show only persons who are marked with a status"
msgstr "បង្ហាញ​តែ​មនុស្ស​ដែល​ត្រូវ​បានសម្គាល់​ជា​មួយ​ស្ថានភាព​នេះ"

#: mainwindow.cpp:113
#, kde-format
msgid "Search"
msgstr "ស្វែងរក"

#: mainwindow.cpp:114
#, kde-format
msgid ""
"Enter some text to filter the list of persons. You can also enter "
"information that is not visible in the list, such as addresses or phone "
"numbers."
msgstr ""
"បញ្ចូល​អត្ថបទ​ត្រូវ​ត្រង​​​​បញ្ជី​​មនុស្ស ។ អ្នក​ក៏​អាច​បញ្ចូល​ព័ត៌មាន​ដែល​មិន​អាច​មើលឃើញ​នៅ​ក្នុង​បញ្ជី ដូច​ជា​អាសយដ្ឋាន "
"ឬ​លេខ​ទូរស័ព្ទ ។"

#: mainwindow.cpp:119
#, kde-format
msgid " Address book:"
msgstr " សៀវភៅ​អាសយដ្ឋាន ៖"

#: mainwindow.cpp:124 mainwindow.cpp:245
#, kde-format
msgid "All"
msgstr "ទាំងអស់"

#: mainwindow.cpp:125 mainwindow.cpp:246
#, kde-format
msgid "Distribution Lists"
msgstr "បញ្ជី​ចែកចាយ"

#: mainwindow.cpp:126
#, kde-format
msgid "Select a address book or a category to display those persons only."
msgstr "ជ្រើស​សៀវភៅ​អាសយដ្ឋាន ឬ​ប្រភេទ​ដើម្បី​បង្ហាញ​តែ​មនុស្ស​ទាំងនោះ ។"

#: mainwindow.cpp:163
#, kde-format
msgid "Do not show recipients' names to each other."
msgstr "កុំបង្ហាញ​ឈ្មោះ​​​អ្នក​ទទួល​​​​ដល់​អ្នក​ផ្សេង"

#: mainwindow.cpp:164
#, kde-format
msgid "Display all recipients' names to each other."
msgstr "បង្ហាញ​ឈ្មោះ​​​អ្នក​ទទួល​ទាំងអស់​​ដល់អ្នក​ទាំងអស់​​គ្នា"

#: mainwindow.cpp:223
#, kde-format
msgid "Basic Interface"
msgstr "ចំណុច​ប្រទាក់​មូលដ្ឋាន"

#: mainwindow.cpp:247
#, kde-format
msgid "Category"
msgstr "ប្រភេទ"

#: persontreeview.cpp:198
#, kde-format
msgid ""
"You do not have any persons in your address book. You can insert persons "
"with the program kaddressbook, which is also part of the kdepim package."
msgstr ""
"អ្នក​មិនមាន​មនុស្ស​នៅ​ក្នុង​សៀវភៅ​អាសយដ្ឋាន ។ អ្នក​អាច​បញ្ចូល​មនុស្ស​ជាមួយ​កម្មវិធី kadressbook ដែល​ជា​"
"ផ្នែក​របស់​កញ្ចប់ kdepim ។"
