#: agent.cpp:49
msgid "No error"
msgstr "គ្មាន​កំហុស"

#: agent.cpp:52
msgid "One of the specified parameters was invalid"
msgstr "ប៉ារ៉ាម៉ែត្រ​ដែលបានបញ្ជាក់​មិន​ត្រឹមត្រូវ"

#: agent.cpp:55
msgid "The specified filter already exists"
msgstr "មាន​តម្រង​ដែល​បាន​បញ្ជាក់រួច​ហើយ"

#: agent.cpp:58
msgid "Filtering of the specified mimetype is not supported"
msgstr "ត្រង​ប្រភេទ mime ដែល​បាន​បញ្ជាក់​មិន​ត្រូវ​បាន​គាំទ្រ​ទេ"

#: agent.cpp:61
msgid "Syntax error in filter"
msgstr "កំហុស​វាក្យសម្ព័ន្ធ​ក្នុង​តម្រង"

#: agent.cpp:64
msgid "The specified filter doesn't exist"
msgstr "មិនទាន់មាន​តម្រង​ដែល​បាន​បញ្ជាក់​ទេ"

#: agent.cpp:67
msgid "Not all the specified collections could be attached or detached"
msgstr "មិន​បាន​បញ្ជាក់​សម្រាំង​ទាំងអស់​ដែល​គួរ​ត្រូវ​បាន​ភ្ជាប់ ឬ​ផ្ដាច់"

#: agent.cpp:73
msgid "Unknown status code"
msgstr "មិនស្គាល់​កូដ​ស្ថានភាព"

