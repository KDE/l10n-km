#: kvaio.cpp:155
msgid "Memory Stick inserted"
msgstr "បាន​បញ្ចូល Memory Stick"

#: kvaio.cpp:158
msgid "Memory Stick ejected"
msgstr "បាន​យក Memory Stick ចេញ"

#: kvaio.cpp:167
msgid "Unhandled event: "
msgstr "ព្រឹត្តិការណ៍​ដែល​មិន​បាន​ដោះស្រាយ ៖"

#: kvaio.cpp:416
msgid "AC Connected"
msgstr "ចរន្ត​ឆ្លាស់​បានភ្ជាប់"

#: kvaio.cpp:416
msgid "AC Disconnected"
msgstr "ចរន្ត​ឆ្លាស់​បាន​ផ្ដាច់"

#: kvaio.cpp:422
msgid "Battery is Fully Charged. "
msgstr "ថ្ម​បាន​សាក​ពេញ ។ "

#: kvaio.cpp:429
#, qt-format
msgid "Caution: Battery is Almost Empty (%1% remaining)."
msgstr "ប្រយ័ត្ន ៖ ថ្ម​ជិត​អស់ហើយ (នៅសល់ %1%) ។"

#: kvaio.cpp:432
#, fuzzy
msgid "Alert: Battery is Empty"
msgstr "ការព្រមាន ៖ ថ្ម​អស់​ហើយ !"

#: kvaio.cpp:435
msgid "No Battery Inserted."
msgstr "មិន​បាន​បញ្ចូល​ថ្ម ។"

#: kvaio.cpp:438
#, qt-format
msgid "Remaining Battery Capacity: %1%"
msgstr "សមត្ថភាព​ថ្ម​ដែល​នៅ​សល់ ៖ %1%"

#: kvaio.cpp:463 kvaio.cpp:476
msgid "Brightness"
msgstr "ពន្លឺ"

#: kvaio.cpp:484
msgid "Volume"
msgstr "កម្រិត​សម្លេង"

#: kvaio.cpp:521 kvaio.cpp:586
msgid "It seems that KMix is not running."
msgstr "KMix ហាក់បី​ដូចជា​មិន​កំពុង​រត់​ឡើយ ។"

#: kvaio.cpp:564
msgid "Starting KMix..."
msgstr "កំពុង​ចាប់ផ្ដើម KMix..."

#: kvaio.cpp:607
msgid "Mute on"
msgstr "ស្ងាត់"

#: kvaio.cpp:610
msgid "Mute off"
msgstr "មិន​ស្ងាត់"

