#: floppy.cpp:113
msgid "<qt>This allows you to select the floppy disk's size and density.</qt>"
msgstr "<qt>វា​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​ទំហំ​របស់​ថាស​ទន់ និង​ដង់​ស៊ីតេ ។</qt>"

#: floppy.cpp:121
msgid "F&ile system:"
msgstr "ប្រព័ន្ធ​ឯកសារ ៖"

#: floppy.cpp:129 floppy.cpp:141
msgctxt "Linux"
msgid ""
"KFloppy supports three file formats under Linux: MS-DOS, Ext2, and Minix"
msgstr "KFloppy គាំទ្រ​ទ្រង់ទ្រាយ​ឯកសារ​បីក្រោម​លីនុច ៖ MS-DOS Ext2 និង Minix"

#: floppy.cpp:132
msgctxt "BSD"
msgid "KFloppy supports three file formats under BSD: MS-DOS, UFS, and Ext2"
msgstr "KFloppy គាំទ្រ​ទ្រង់ទ្រាយ​ឯកសារ​បី​ក្រោម BSD ៖ MS-DOS UFS និង Ext2"

#: floppy.cpp:143 floppy.cpp:172 floppy.cpp:603 floppy.cpp:730
msgid "DOS"
msgstr "DOS"

#: floppy.cpp:145
msgctxt "Linux"
msgid "Program mkdosfs found."
msgstr "រក​ឃើញ​កម្មវិធី mkdosfs ។"

#: floppy.cpp:148
msgctxt "Linux"
msgid ""
"Program mkdosfs <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr "<b>រក​មិន​ឃើញ</b>កម្មវិធី mkdosfs ។ ការ​ធ្វើ​ទ្រង់ទ្រាយ MSDOS <b>មិន​អាច​ប្រើ​បាន</b> ។"

#: floppy.cpp:152 floppy.cpp:190 floppy.cpp:620
msgid "ext2"
msgstr "ext2"

#: floppy.cpp:154 floppy.cpp:192
msgid "Program mke2fs found."
msgstr "រកឃើញ​កម្មវិធី mke2fs ។"

#: floppy.cpp:157 floppy.cpp:195
msgid "Program mke2fs <b>not found</b>. Ext2 formatting <b>not available</b>"
msgstr "<b>រក​មិន​ឃើញ</b>កម្មវិធី mke2fs ។ ការ​ធ្វើ​ទ្រង់ទ្រាយ Ext2<b>មិន​អាច​ប្រើ​បាន</b>"

#: floppy.cpp:161 floppy.cpp:647
msgid "Minix"
msgstr "Minix"

#: floppy.cpp:163
msgctxt "Linux"
msgid "Program mkfs.minix found."
msgstr "រក​ឃើញ​កម្មវិធី mkfs.minix​ ។"

#: floppy.cpp:166
msgctxt "Linux"
msgid ""
"Program mkfs.minix <b>not found</b>. Minix formatting <b>not available</b>"
msgstr ""
"<b>រក​មិន​ឃើញ​</b>កម្មវិធី mkfs.minix ។ ការ​ធ្វើ​ទ្រង់ទ្រាយ Minix <b>មិន​អាច​ប្រើ​បាន</b>"

#: floppy.cpp:170
msgctxt "BSD"
msgid "KFloppy supports two file formats under BSD: MS-DOS and UFS"
msgstr "KFloppy គាំទ្រ​ទ្រង់ទ្រាយ​ឯកសារ​ពីរ​ក្រោម BSD ៖ MS-DOS និង UFS"

#: floppy.cpp:174
msgctxt "BSD"
msgid "Program newfs_msdos found."
msgstr "រក​ឃើញ​កម្មវិធី newfs_msdos ។"

#: floppy.cpp:177
msgctxt "BSD"
msgid ""
"Program newfs_msdos <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr ""
"<b>រក​មិន​ឃើញ​</b>កម្មវិធី ewfs_msdos ។ ការ​ធ្វើ​ទ្រង់ទ្រាយ MSDOS <b>មិន​អាច​ប្រើ​បាន</b> ។"

#: floppy.cpp:181 floppy.cpp:513 floppy.cpp:638
msgid "UFS"
msgstr "UFS"

#: floppy.cpp:183
msgctxt "BSD"
msgid "Program newfs found."
msgstr "រក​ឃើញ​កម្មវិធី newfs ។"

#: floppy.cpp:186
msgctxt "BSD"
msgid "Program newfs <b>not found</b>. UFS formatting <b>not available</b>."
msgstr "<b>រក​មិន​ឃើញ</b>​កម្មវិធី newfs ។ ការ​ធ្វើ​ទ្រង់ទ្រាយ UFS <b>មិន​អាច​ប្រើ​បាន</b> ។"

#: floppy.cpp:201
msgid "&Formatting"
msgstr "ការ​ធ្វើ​ទ្រង់ទ្រាយ"

#: floppy.cpp:204
msgid "Q&uick format"
msgstr "ការ​ធ្វើ​ទ្រង់ទ្រាយ​រហ័ស"

#: floppy.cpp:208
msgid ""
"<qt>Quick format is only a high-level format: it creates only a file system."
"</qt>"
msgstr ""
"<qt>ការ​ធ្វើ​ទ្រង់ទ្រាយ​រហ័ស គឺ​ជា​ការ​ធ្វើ​ទ្រង់ទ្រាយ​កម្រិត​ខ្ពស់ ៖ វា​បង្កើត​តែ​ប្រព័ន្ធ​ឯកសារ​មួយ ។</qt>"

#: floppy.cpp:211
msgid "&Zero out and quick format"
msgstr "លុប និង​ធ្វើ​ទ្រង់ទ្រាយ​រហ័ស"

#: floppy.cpp:215
msgid ""
"<qt>This first erases the floppy by writing zeros and then it creates the "
"file system.</qt>"
msgstr "<qt>ដំបូង​លុប​ថាស​ទន់​ដោយ​សរសេរ​សូន្យ ហើយ​បន្ទាប់​មក​វា​បង្កើត​ប្រព័ន្ធ​ឯកសារ​ ។</qt>"

#: floppy.cpp:217
msgid "Fu&ll format"
msgstr "ការធ្វើ​ទ្រង់ទ្រាយ​ពេញ​លេញ"

#: floppy.cpp:221
msgid ""
"Full format is a low-level and high-level format. It erases everything on "
"the disk."
msgstr ""
"ការ​ធ្វើ​ទ្រង់ទ្រាយ​ពេញលេញ​គឺ​ជា​ការ​ធ្វើ​ទ្រង់ទ្រាយ​កម្រិត​ទាប និង​កម្រិត​ខ្ពស់ ។ វា​លុប​អ្វី​ទាំង​អស់នៅ​លើ​ថាស ។​"

#: floppy.cpp:230
msgid "Program fdformat found."
msgstr "រក​ឃើញ​កម្មវិធី fdformat ។"

#: floppy.cpp:235
msgid "Program fdformat <b>not found</b>. Full formatting <b>disabled</b>."
msgstr "<b>រក​មិន​ឃើញ</b>​កម្មវិធី fdformat ។ ការ​ធ្វើ​ទ្រង់ទ្រាយ​ពេញ​លេញ<b>បានបិទ</b> ។"

#: floppy.cpp:242
msgid "Program dd found."
msgstr "រក​ឃើញ​កម្មវិធី dd ។"

#: floppy.cpp:246
msgid "Program dd <b>not found</b>. Zeroing-out <b>disabled</b>."
msgstr "<b>រក​មិន​ឃើញ</b>កម្មវិធី dd ។ ការ​លុប <b>បាន​បិទ</b> ។"

#: floppy.cpp:251
msgid "&Verify integrity"
msgstr "ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#: floppy.cpp:255
msgid ""
"<qt>Check this if you want the floppy disk to be checked after formatting. "
"Please note that the floppy will be checked twice if you have selected full "
"formatting.</qt>"
msgstr ""
"<qt>ពិនិត្យ​វា ប្រសិន​បើ​អ្នក​ចង់​ឲ្យ​ថាស​ទន់​ត្រូវ​បាន​ពិនិត្យ​បន្ទាប់​ពី​ធ្វើ​ទ្រង់ទ្រាយ ។ សូម​ចំណាំ​ថា ថាស​ទន់​នឹង​ត្រូវ​"
"បាន​ពិនិត្យ​ពី​រដង ប្រសិន​បើ​អ្នក​បាន​ជ្រើស​ការ​ធ្វើ​ទ្រង់ទ្រាយ​ពេញ​លេញ ។</qt>"

#: floppy.cpp:260
msgid "Volume la&bel:"
msgstr "ស្លាក​កម្រិត​សំឡេង ៖"

#: floppy.cpp:264
msgid ""
"<qt>Check this if you want a volume label for your floppy. Please note that "
"Minix does not support labels at all.</qt>"
msgstr ""
"<qt>ពិនិត្យ​វា ប្រសិន​បើ​អ្នក​ចង់​បាន​ស្លាក​សម្លេង​សម្រាប់​ថាស​ទន់​របស់​អ្នក ។ សូម​ចំណាំ​ថា Minix មិន​គាំទ្រ​ស្លាក​"
"ទាល់​តែ​សោះ ។</qt>"

#: floppy.cpp:273 floppy.cpp:722
msgctxt "Volume label, maximal 11 characters"
msgid "KDE Floppy"
msgstr "ថាស​ទន់​របស់ KDE"

#: floppy.cpp:277
msgid ""
"<qt>This is for the volume label. Due to a limitation of MS-DOS the label "
"can only be 11 characters long. Please note that Minix does not support "
"labels, whatever you enter here.</qt>"
msgstr ""
"<qt>វា​សម្រាប់​ស្លាក​កម្រិត​សម្លេង ។ ដោយ​សារ​តែ​ការ​កម្រិត​របស់ MS-DOS ស្លាក​អាច​មាន​ប្រវែង​តែ ១១ តួ​"
"អក្សរ​ប៉ុណ្ណោះ ។ សូម​ចំណាំ​ថា Minix មិន​គាំទ្រ​ស្លាក អ្វី​ក៏​ដោយ​អ្នក​បញ្ចូល​នៅ​ទីនេះ ។</qt>"

#: floppy.cpp:287 floppy.cpp:495
msgid "&Format"
msgstr "ធ្វើ​ទ្រង់ទ្រាយ"

#: floppy.cpp:294
msgid "<qt>Click here to start formatting.</qt>"
msgstr "<qt>ចុច​ទីនេះ ដើម្បី​ចាប់ផ្ដើម​ធ្វើ​ទ្រង់ទ្រាយ ។</qt>"

#: floppy.cpp:318
msgid "<qt>This is the status window, where error messages are displayed.</qt>"
msgstr "<qt>នេះ​គឺ​ជា​បង្អួច​ស្ថានភាព ដែល​សារ​កំហុស​ត្រូវ​បាន​បង្ហាញ ។</qt>"

#: floppy.cpp:332
msgid "<qt>Shows progress of the format.</qt>"
msgstr "<qt>បង្ហាញ​វឌ្ឍនភាព​នៃ​ការ​ធ្វើ​ទ្រង់ទ្រាយ ។</qt>"

#: floppy.cpp:340
msgid ""
"KFloppy cannot find any of the needed programs for creating file systems; "
"please check your installation.<br /><br />Log:"
msgstr ""
"KFloppy មិន​អាច​រក​កម្មវិធី​ដែល​ត្រូវការ​ណា​មួយ សម្រាប់​បង្កើត​ប្រព័ន្ធ​ឯកសារ សូម​ពិនិត្យ​មើល​ការ​ដំឡើង​របស់​"
"អ្នក ។<br><br>កំណត់​ហេតុ ៖"

#: floppy.cpp:372
msgid "KDE Floppy Formatter"
msgstr "ឧបករណ៍​ធ្វើ​ទ្រង់ទ្រាយ​ថាស​ទន់​របស់ KDE"

#: floppy.cpp:515
msgctxt "BSD"
msgid "Formatting with BSD on a user-given device is only possible with UFS"
msgstr "ការ​ធ្វើ​ទ្រង់ទ្រាយ​ជាមួយ BSD នៅ​លើ​ឧបករណ៍​ដែល​ផ្ដល់​ឲ្យ​ដោយ​អ្នក​ប្រើ អាច​ធ្វើ​បាន​តែ​ជាមួយ UFS"

#: floppy.cpp:523
#, kde-format
msgid ""
"<qt>Formatting will erase all data on the device:<br/><b>%1</b><br/>(Please "
"check the correctness of the device name.)<br/>Are you sure you wish to "
"proceed?</qt>"
msgstr ""
"<qt>ការ​ធ្វើ​ទ្រង់ទ្រាយ​នឹង​លុប​ទិន្នន័យ​ទាំងអស់​នៅ​លើ​ឧបករណ៍ ៖<br/><b>%1</b><br/>(សូម​ពិនិត្យ​ភាព​ត្រឹមត្រូវ​"
"នៃ​ឈ្មោះ​របស់​ឧបករណ៍ ។)<br/>តើ​អ្នក​ប្រាកដ​ជា​ចង់​ធ្វើ​បន្ត​ឬ?</qt>"

#: floppy.cpp:526 floppy.cpp:541
msgid "Proceed?"
msgstr "ធ្វើ​បន្ត?"

#: floppy.cpp:540
msgid ""
"Formatting will erase all data on the disk.\n"
"Are you sure you wish to proceed?"
msgstr ""
"ការ​ធ្វើ​ទ្រង់ទ្រាយ​នឹង​លុប​ទិន្នន័យ​ទាំងអស់​នៅ​ក្នុង​ថាស ។\n"
"តើ​អ្នក​ប្រាកដ​ជា​ចង់​ដំណើរ​ការ​ឬ?"

#: format.cpp:266
#, kde-format
msgid "Unexpected drive number %1."
msgstr "លេខ​ដ្រាយ %1ដែល​មិន​បាន​រំពឹង​ទុក ។"

#: format.cpp:278
#, kde-format
msgid "Unexpected density number %1."
msgstr "លេខ​ដង់ស៊ីតេ %1 ដែល​មិន​បាន​រំពឹង​ទុក ។"

#: format.cpp:293
#, kde-format
msgid "Cannot find a device for drive %1 and density %2."
msgstr "មិន​អាច​រកឃើញ​ឧបករណ៍​សម្រាប់​ដ្រាយ %1 និង​ដង់ស៊ីតេ %2 ។"

#: format.cpp:312
#, kde-format
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"មិន​អាច​ចូល​ដំណើរ​ការ %1\n"
"សូម​ប្រាកដ​ថា​មាន​ឧបករណ៍ ហើយ​អ្នក​មាន​សិទ្ធិ​សរសេរ​ទៅ​កាន់​វា ។"

#: format.cpp:343
#, kde-format
msgid "The program %1 terminated with an error."
msgstr "កម្មវិធី %1 បាន​បញ្ចប់​ដោយ​មាន​កំហុស ។"

#: format.cpp:349
#, kde-format
msgid "The program %1 terminated abnormally."
msgstr "កម្មវិធី %1 បាន​បញ្ចប់​ដោយ​មិន​ធម្មតា ។"

#: format.cpp:412 format.cpp:573 format.cpp:670 format.cpp:769 format.cpp:847
#: format.cpp:941
msgid "Internal error: device not correctly defined."
msgstr "កំហុស​ខាង​ក្នុង ៖ ឧបករណ៍​ដែល​បាន​កំណត់​មិន​ត្រឹមត្រូវ ។"

#: format.cpp:419
msgid "Cannot find fdformat."
msgstr "មិន​អាច​រកឃើញ fdformat ។"

#: format.cpp:451
msgid "Could not start fdformat."
msgstr "មិន​អាច​ចាប់ផ្ដើម fdformat ។"

#: format.cpp:478
#, kde-format
msgid "Error formatting track %1."
msgstr "កំហុស​ក្នុង​ការ​ធ្វើ​ទ្រង់ទ្រាយ​ត្រាក %1 ។"

#: format.cpp:486 format.cpp:519
msgid ""
