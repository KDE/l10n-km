msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៣ ដោយ George Staikos"

#: konfigurator.cpp:52
msgid "George Staikos"
msgstr "George Staikos"

#: konfigurator.cpp:118
msgid "New Wallet"
msgstr "កាបូប​ថ្មី"

#: konfigurator.cpp:119
msgid "Please choose a name for the new wallet:"
msgstr "សូម​ជ្រើស​ឈ្មោះ​មួយ សម្រាប់​កាបូប​ថ្មី ៖"

#: konfigurator.cpp:223 konfigurator.cpp:274
msgid "Always Allow"
msgstr "អនុញ្ញាត​ជានិច្ច"

#: konfigurator.cpp:226 konfigurator.cpp:233 konfigurator.cpp:287
msgid "Always Deny"
msgstr "បដិសេធ​ជានិច្ច"

#: konfigurator.cpp:323
msgid ""
"This configuration module allows you to configure the KDE wallet system."
msgstr "ម៉ូឌុល​កំណត់​រចនា​សម្ព័ន្ធ​នេះអនុញ្ញាត​ឲ្យ​អ្នក​កំណត់​រចនា​សម្ព័ន្ធ​ប្រព័ន្ធ​កាបូប​របស់ KDE ។"

#: konfigurator.cpp:332
msgid "&Delete"
msgstr "លុប"

#~ msgid "Wallet Preferences"
#~ msgstr "ចំណូល​ចិត្ត​កាបូប"

#~ msgid ""
#~ "<p>The wallet subsystem provides a convenient and secure way to manage "
#~ "all your passwords.  This option specifies whether or not you want to use "
#~ "it.</p>"
#~ msgstr ""
#~ "<p>ប្រព័ន្ធ​រង​កាបូប​ផ្ដល់​នូវ​វិធី​ងាយស្រួល និង​សុវត្ថិភាព​ដើម្បី​គ្រប់គ្រង​ពាក្យ​សម្ងាត់​របស់​អ្នក​ទាំង​អស់ ។ ​ "
#~ "ជម្រើស​នេះ​បញ្ជាក់​ថាតើ​អ្នក​ចង់​ប្រើ​វា ឬ​ក៏អត់ ។</p>"

#~ msgid "&Enable the KDE wallet subsystem"
#~ msgstr "បើក​ប្រព័ន្ធរង​របស់​កាបូប KDE"

#~ msgid ""
#~ "It is best to close your wallets when you are not using them to prevent "
#~ "others from viewing or using them."
#~ msgstr ""
#~ "ជា​ការ​ល្អបំផុត អ្នក​គួរ​តែ​បិទ​កាបូប​របស់​អ្នក ពេល​អ្នក​មិន​ប្រើ​ពួកវា ។ ធ្វើ​ដូច្នេះ ដើម្បី​មិន​ឲ្យ​អ្នក​ដទៃ​"
#~ "មើល ឬ​ប្រើ​ពួកវា ។"

#~ msgid "Close Wallet"
#~ msgstr "បិទ​កាបូប"

#~ msgid ""
#~ "<p><b>Close wallet after a period of inactivity.</b><br>When a wallet is "
#~ "closed the password is needed to access it again.</p>"
#~ msgstr ""
#~ "<p><b>បិទ​កាបូប បន្ទាប់ពី​អសកម្ម​មួយ​រយៈពេល </b><br> ពេល​កាបូប​មួយ​បិទ ពាក្យ​សម្ងាត់​នឹង​ត្រូវការ​"
#~ "ម្តងទៀត​ដើម្បី​ប្រើប្រាស់​វា ។</p>"

#~ msgid "Close when unused for:"
#~ msgstr "បិទ​នៅ​ពេល​មិន​ប្រើ​រយៈពេល ៖"

#~ msgid " min"
#~ msgstr " នាទី"

#~ msgid ""
#~ "<p><b>Close wallet as soon as the screensaver starts.</b><br>When a "
#~ "wallet is closed the password is needed to access it again.</p>"
#~ msgstr ""
#~ "<p><b>បិទ​កាបូប​ភ្លាមៗ ពេល​ធាតុ​រក្សាអេក្រង់​ចាប់ផ្តើម ។</b><br>ពេល​កាបូប​មួយ​បិទ នោះ​វា​ត្រូវការ​"
#~ "ពាក្យ​សម្ងាត់ ដើម្បី​អាច​ប្រើ​ប្រាស់​វា​ម្តងទៀត ។</p>"

#~ msgid "Close when screensaver starts"
#~ msgstr "បិទ​នៅ​ពេល​ធាតុ​រក្សា​អេក្រង់​ចាប់ផ្ដើម"

#~ msgid ""
#~ "<p><b>Close wallet as soon as applications that use it have stopped.</"
#~ "b><br>Note that your wallet will only be closed when all applications "
#~ "that use it have stopped.<br>When a wallet is closed the password is "
#~ "needed to access it again.</p>"
#~ msgstr ""
#~ "<p><b>បិទ​កាបូប​ភ្លាមៗ ពេល​ដែល​កម្មវិធី​ប្រើវា​បាន​ឈប់ ។</b><br>សូម​ចំណាំថា កាបូប​របស់អ្នកនឹង​បិទ​តែ​"
#~ "ពេលកម្មវិធី​ទាំងអស់ដែល​ប្រើ​វា​បាន​ឈប់​ប៉ុណ្ណោះ ។<br>ពេល​កាបូប​មួយ​បិទ នោះ​វា​ត្រូវការ​ពាក្យ​សម្ងាត់​"
#~ "ម្តងទៀត​ដើម្បី​ប្រើ​ប្រាស់​វា ។</p>"

#~ msgid "Close when last application stops using it"
#~ msgstr "បិទ ពេល​កម្មវិធី​ចុងក្រោយ​ឈប់​ប្រើ​វា"

#~ msgid "Automatic Wallet Selection"
#~ msgstr "ការ​ជ្រើស​កាបូប​ស្វ័យប្រវត្តិ"

#~ msgid "Select wallet to use as default:"
#~ msgstr "ជ្រើស​កាបូប​ដែល​ត្រូវ​ប្រើ​ជា​លំនាំដើម ៖"

#~ msgid "New..."
#~ msgstr "ថ្មី..."

#~ msgid "Different wallet for local passwords:"
#~ msgstr "កាបូប​ផ្សេងៗ​គ្នា សម្រាប់​ពាក្យ​សម្ងាត់​មូលដ្ឋាន ៖"

#~ msgid "Wallet Manager"
#~ msgstr "កម្មវិធី​គ្រប់គ្រង​កាបូប"

#~ msgid "Show manager in system tray"
#~ msgstr "បង្ហាញ​កម្មវិធី​គ្រប់គ្រង ក្នុង​ថាស​ប្រព័ន្ធ"

#~ msgid "Hide system tray icon when last wallet closes"
#~ msgstr "លាក់​រូបតំណាង​ថាស​ប្រព័ន្ធ ពេល​កាបូប​ចុងក្រោយ​បិទ"

#~ msgid "Access Control"
#~ msgstr "ត្រួតពិនិត្យ​ការ​ដំណើរការ"

#~ msgid "&Prompt when an application accesses an open wallet"
#~ msgstr "ជូន​ដំណឹង ពេល​កម្មវិធី​មួយ​ប្រើ​ប្រាស់​កាបូប​ដែល​បើក"

#~ msgid "Wallet"
#~ msgstr "កាបូប"

#~ msgid "Application"
#~ msgstr "កម្មវិធី"

#~ msgid "Policy"
#~ msgstr "គោលការណ៍"

#~ msgid "&Launch Wallet Manager"
#~ msgstr "បើក​ដំណើរការ​កម្មវិធី​គ្រប់គ្រង​កាបូប"
