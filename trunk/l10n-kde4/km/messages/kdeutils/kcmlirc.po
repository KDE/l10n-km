#: addaction.cpp:101
#, kde-format
msgid ""
"You did not select a mode of that remote control. Please use %1, or revert "
"back to select a different mode."
msgstr ""
"អ្នក​មិន​បាន​ជ្រើស​របៀប​នៃ​ការ​បញ្ជា​ពី​ចម្ងាយ​នោះ​ទេ ។ សូមប្រើ​ %1 ឬ​ត្រឡប់​ទៅ​ដើម​វិញ ដើម្បី​ជ្រើស​របៀប​"
"ផ្សេង ។"

#: addaction.cpp:103
msgid "Incorrect Remote Control Detected"
msgstr "​ការ​បញ្ជា​ពី​ចម្ងាយ​មិន​ត្រឹមត្រូវ ដែល​បាន​រក​ឃើញ"

