#: kdessh.cpp:58
msgid "KDE ssh"
msgstr "KDE ssh"

#: kdessh.cpp:59
msgid "Runs a program on a remote host"
msgstr "រត់​កម្មវិធី​មួយ​នៅ​លើ​ម៉ាស៊ីន​ពី​ចម្ងាយ"

#: kdessh.cpp:61
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០០ ដោយ Geert Jansen"

#: kdessh.cpp:63
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdessh.cpp:63
msgid "Maintainer"
msgstr "អ្នក​ថែទាំ"

#: kdessh.cpp:69
msgid "Specifies the remote host"
msgstr "បញ្ជាក់​ម៉ាស៊ីន​ពី​ចម្ងាយ"

#: kdessh.cpp:70
msgid "The command to run"
msgstr "ពាក្យ​បញ្ជា​​ត្រូវ​រត់"

#: kdessh.cpp:71
msgid "Specifies the target uid"
msgstr "បញ្ជាក់ uid គោល​ដៅ"

#: kdessh.cpp:72
msgid "Specify remote stub location"
msgstr "បញ្ជាក់​ទីតាំង stub ​ពី​ចម្ងាយ"

#: kdessh.cpp:73
msgid "Do not keep password"
msgstr "កុំ​រក្សាទុក​ពាក្យ​សម្ងាត់"

#: kdessh.cpp:74
msgid "Stop the daemon (forgets all passwords)"
msgstr "បញ្ឈប់ daemon (ភ្លេច​ពាក្យ​សម្ងាត់​ទាំង​អស់)"

#: kdessh.cpp:75
msgid "Enable terminal output (no password keeping)"
msgstr "អាច​មាន​លទ្ធផល​របស់​ស្ថានីយ (គ្មាន​ការ​រក្សាទុក​ពាក្យ​សម្ងាត់)"

#: kdessh.cpp:107
msgid "No command or host specified."
msgstr "គ្មាន​ពាក្យ​បញ្ជា ឬ​ម៉ាស៊ីន​ដែល​បាន​បញ្ជាក់"

#: kdessh.cpp:178
msgid ""
"Ssh returned with an error.\n"
"The error message is:\n"
"\n"
msgstr ""
"Ssh បាន​ត្រឡប់​ដោយ​មាន​កំហុស ។\n"
"សារ​កំហុស​គឺ ៖\n"
"\n"

#: kdessh.cpp:189
msgid "Command"
msgstr "ពាក្យបញ្ជា"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,​​evannak@khmeros.info,piseth_dv@khmeros.info"

#: sshdlg.cpp:56
msgid "The action you requested needs authentication. Please enter "
msgstr "សកម្មភាព​ដែល​អ្នក​បាន​ស្នើ ត្រូវការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ។ សូម​បញ្ចូល"

#: sshdlg.cpp:76
msgid "Conversation with ssh failed.\n"
msgstr "ការ​សន្ទនា​ជាមួយ ssh បាន​បរាជ័យ ។ \n"

#: sshdlg.cpp:85
msgid ""
"The programs 'ssh' or 'kdesu_stub' cannot be found.\n"
"Make sure your PATH is set correctly."
msgstr ""
"កម្មវិធី 'ssh' ឬ 'kdesu_stub' មិន​អាច​រក​ឃើញ ។\n"
"សូម​ប្រាកដ​ថា​ PATH របស់​អ្នក​ត្រូវ​បាន​កំណត់​យ៉ាង​ត្រឹមត្រូវ ។"

#: sshdlg.cpp:91
msgid "Incorrect password. Please try again."
msgstr "ពាក្យ​សម្ងាត់​​មិនត្រឹមត្រូវ ។ សូម​ព្យាយាម​ម្ដង​ទៀត ។"

#: sshdlg.cpp:95
msgid "Internal error: Illegal return from SshProcess::checkInstall()"
msgstr "កំហុស​ខាង​ក្នុង ៖​ ត្រឡប់​មិន​ត្រឹមត្រូវ​ពី SshProcess::checkInstall()"
