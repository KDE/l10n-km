#: gcalresource.cpp:109
msgctxt "@info: status"
msgid "Not yet authenticated for use of Google Calendar."
msgstr "មិន​បានផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដើម្បី​ប្រើ​ប្រតិទិន​របស់ Google នៅ​ឡើយ​ទេ ។"

#: gcalresource.cpp:155
msgid "Failed to retrieve events."
msgstr "បានបរាជ័យ​ក្នុងការ​ទៅ​យក​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:165 gcalresource.cpp:421
msgctxt "@info:status"
msgid "Failed getting last updated event."
msgstr "បានបរាជ័យ​ក្នុង​ការ​យក​ព្រឹត្តិការណ៍​ដែល​បានធ្វើ​​បច្ចុប្បន្នភាព​​ចុងក្រោយ ។"

#: gcalresource.cpp:267
msgctxt "@info:status"
msgid "Invalid password or network proxy."
msgstr "ពាក្យ​សម្ងាត់ ឬ​ប្រូកស៊ី​បណ្ដាញ​មិន​ត្រឹមត្រូវ ។"

#: gcalresource.cpp:449
msgctxt "@info:status"
msgid "Invalid password."
msgstr "ពាក្យសម្ងាត់​មិន​ត្រឹមត្រូវ ។"

#: gcalresource.cpp:482 gcalresource.cpp:585 gcalresource.cpp:697
msgctxt "@info:status"
msgid "Not yet authenticated for use of Google calendar."
msgstr "មិនបានផ្ទៀងផ្ទាត់​ភាពត្រឹមត្រូវ​ ដើម្បី​ប្រើ​ប្រតិទិន​របស់ Google នៅឡើយ​ទេ ។"

#: gcalresource.cpp:486 gcalresource.cpp:558
msgid "Failed to add event."
msgstr "បាន​បរាជ័យ​ក្នុងការ​បន្ថែម​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:501 gcalresource.cpp:606
msgctxt "@info:status"
msgid "No payload to add event."
msgstr "គ្មាន​​ការ​ចំណាយ​ក្នុងកា​របន្ថែម​ព្រឹត្តិការណ៍​ ។"

#: gcalresource.cpp:510 gcalresource.cpp:615 gcalresource.cpp:708
msgctxt "@info:status"
msgid "Failed to create gcal_event."
msgstr "បានបរាជ័យ​ក្នុងកា​របង្កើត gcal_event ។"

#: gcalresource.cpp:555 gcalresource.cpp:666
msgctxt "@info:status"
msgid "Failed adding new calendar."
msgstr "បានបរាជ័យ​ក្នុងកា​របន្ថែម​ប្រតិទិន​ថ្មី ។"

#: gcalresource.cpp:589 gcalresource.cpp:669
msgid "Failed to edit event."
msgstr "បាន​បរាជ័យ​ក្នុងកា​រកែសម្រួល​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:701
msgid "Failed to delete event."
msgstr "បាន​បរាជ័យ​ក្នុងការ​លុប​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:722
msgctxt "@info:status"
msgid "Failed deleting new calendar."
msgstr "បានបរាជ័យ​ក្នុងការ​លុប​ប្រតិទិន​ថ្មី ។"

#. i18n: file: GoogleData.ui:14
#. i18n: ectx: property (windowTitle), widget (QDialog, dlgGoogleDataConf)
#: rc.cpp:3
msgid "Dialog"
msgstr "ប្រអប់"

#. i18n: file: GoogleData.ui:22
#. i18n: ectx: property (text), widget (QLabel, lbAccount)
#: rc.cpp:6
msgid "Your Google mail username (or user@whatever.domain.com)"
msgstr "ឈ្មោះអ្នកប្រើ​សំបុត្រ​ហ្គូហ្គល​របស់​អ្នក (ឬ user@whatever.domain.com)"

#. i18n: file: GoogleData.ui:39
#. i18n: ectx: property (text), widget (QLabel, lbPass)
#: rc.cpp:9
msgid "Your password"
msgstr "ពាក្យ​សម្ងាត់​របស់​អ្នក"

#. i18n: file: gcalresource.kcfg:9
#. i18n: ectx: label, entry (timestamp), group (General)
#: rc.cpp:12
msgid "A timestamp in RFC 3339 format (e.g. 2008-09-10T21:00:00Z.)"
msgstr "ត្រាពេលវេលា​គិត​ជា​ទ្រង់ទ្រាយ RFC 3339 (ឧ. 2008-09-10T21:00:00Z.)"

#. i18n: file: gcalresource.kcfg:13
#. i18n: ectx: label, entry (username), group (General)
#: rc.cpp:15
msgid "The username login (e.g. john.doe@gmail.com)"
msgstr "ឈ្មោះ​អ្នក​ប្រើ​ចូល (ឧ. john.doe@gmail.com)"

#. i18n: file: gcalresource.kcfg:17
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:18
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាងក្រោយ​ពិតប្រាកដ ។"
