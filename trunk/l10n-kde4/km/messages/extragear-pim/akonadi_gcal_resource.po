#: gcalresource.cpp:108
msgctxt "@info: status"
msgid "Not yet authenticated for use of Google Calendar."
msgstr "មិន​បានផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដើម្បី​ប្រើ​ប្រតិទិន​របស់ Google នៅ​ឡើយ​ទេ ។"

#: gcalresource.cpp:154
msgid "Failed to retrieve events."
msgstr "បានបរាជ័យ​ក្នុងការ​ទៅ​យក​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:164 gcalresource.cpp:409
msgctxt "@info:status"
msgid "Failed getting last updated event."
msgstr "បានបរាជ័យ​ក្នុង​ការ​យក​ព្រឹត្តិការណ៍​ដែល​បានធ្វើ​​បច្ចុប្បន្នភាព​​ចុងក្រោយ ។"

#: gcalresource.cpp:262
msgctxt "@info:status"
msgid "Invalid password or network proxy."
msgstr "ពាក្យ​សម្ងាត់ ឬ​ប្រូកស៊ី​បណ្ដាញ​មិន​ត្រឹមត្រូវ ។"

#: gcalresource.cpp:437
msgctxt "@info:status"
msgid "Invalid password."
msgstr "ពាក្យសម្ងាត់​មិន​ត្រឹមត្រូវ ។"

#: gcalresource.cpp:470 gcalresource.cpp:567 gcalresource.cpp:673
msgctxt "@info:status"
msgid "Not yet authenticated for use of Google calendar."
msgstr "មិនបានផ្ទៀងផ្ទាត់​ភាពត្រឹមត្រូវ​ ដើម្បី​ប្រើ​ប្រតិទិន​របស់ Google នៅឡើយ​ទេ ។"

#: gcalresource.cpp:474 gcalresource.cpp:540
msgid "Failed to add event."
msgstr "បាន​បរាជ័យ​ក្នុងការ​បន្ថែម​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:489 gcalresource.cpp:588
msgctxt "@info:status"
msgid "No payload to add event."
msgstr "គ្មាន​​ការ​ចំណាយ​ក្នុងកា​របន្ថែម​ព្រឹត្តិការណ៍​ ។"

#: gcalresource.cpp:498 gcalresource.cpp:597 gcalresource.cpp:684
msgctxt "@info:status"
msgid "Failed to create gcal_event."
msgstr "បានបរាជ័យ​ក្នុងកា​របង្កើត gcal_event ។"

#: gcalresource.cpp:537 gcalresource.cpp:642
msgctxt "@info:status"
msgid "Failed adding new calendar."
msgstr "បានបរាជ័យ​ក្នុងកា​របន្ថែម​ប្រតិទិន​ថ្មី ។"

#: gcalresource.cpp:571 gcalresource.cpp:645
msgid "Failed to edit event."
msgstr "បាន​បរាជ័យ​ក្នុងកា​រកែសម្រួល​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:677
msgid "Failed to delete event."
msgstr "បាន​បរាជ័យ​ក្នុងការ​លុប​ព្រឹត្តិការណ៍ ។"

#: gcalresource.cpp:698
msgctxt "@info:status"
msgid "Failed deleting new calendar."
msgstr "បានបរាជ័យ​ក្នុងការ​លុប​ប្រតិទិន​ថ្មី ។"

