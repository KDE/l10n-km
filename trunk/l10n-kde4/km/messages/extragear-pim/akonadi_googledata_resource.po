#: googledataresource.cpp:173
msgid "Failed retrieving contacts!"
msgstr "បានបរាជ័យ​ក្នុងការ​ទៅ​យក​​ទំនាក់ទំនង !"

#: googledataresource.cpp:191
msgid "Failed contacts retrieving!"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ទៅយក​ទំនាក់ទំនង !"

#: googledataresource.cpp:201 googledataresource.cpp:452
msgctxt "@info:status"
msgid "Failed getting last updated contact."
msgstr "បានបរាជ័យ​ក្នុងការ​យក​ទំនាក់ទំនង​ដែល​បានធ្វើ​បច្ចុប្បន្នភាព​​ចុងក្រោយ ។"

#: googledataresource.cpp:321
msgctxt "@info:status"
msgid "Invalid password or network proxy."
msgstr "ពាក្យ​សម្ងាត់​ ឬ​ប្រូកស៊ីន​មិនត្រឹមត្រូវ ។"

#: googledataresource.cpp:479
msgctxt "@info:status"
msgid "Invalid password."
msgstr "ពាក្យ​សម្ងាត់​មិន​ត្រឹមត្រូវ ។"

#: googledataresource.cpp:658
msgctxt "@info:status"
msgid "Failed adding new contact."
msgstr "បានបរាជ័យ​ក្នុងកា​របន្ថែម​ទំនាក់ទំនង​ថ្មី ។"

#: googledataresource.cpp:661
msgid "Failed adding contact!"
msgstr "បានបរាជ័យ​ក្នុងការ​បន្ថែម​ទំនាក់ទំនង !"

#: googledataresource.cpp:719 googledataresource.cpp:864
msgctxt "@info:status"
msgid "Failed to create gcal_contact."
msgstr "បានបរាជ័យ​ក្នុងការ​បង្កើត gcal_contact ។"

#: googledataresource.cpp:823
msgctxt "@info:status"
msgid "Failed editing new contact."
msgstr "បានបរាជ័យ​ក្នុងការ​កែសម្រួល​ទំនាក់ទំនង​ថ្មី ។"

#: googledataresource.cpp:880
msgctxt "@info:status"
msgid "Failed deleting new contact."
msgstr "បាន​បរាជ័យ​ក្នុងកា​រលុប​ទំនាក់ទំនង​ថ្មី ។"

