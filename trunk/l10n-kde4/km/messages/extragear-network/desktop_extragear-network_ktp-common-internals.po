#: data/ktelepathy.notifyrc:3
msgctxt "Name"
msgid "Instant messaging"
msgstr "ការ​ផ្ញើ​សារ​បន្ទាន់"

#: data/ktelepathy.notifyrc:31
msgctxt "Comment"
msgid "Instant messaging"
msgstr "ការ​ផ្ញើ​សារ​បន្ទាន់"

#: data/ktelepathy.notifyrc:61
msgctxt "Name"
msgid "Group"
msgstr "ក្រុម"

#: data/ktelepathy.notifyrc:90
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "ក្រុម​ដែល​ទំនាក់ទំនង​នៅ"

#: data/ktelepathy.notifyrc:120
msgctxt "Name"
msgid "Contact"
msgstr "ទំនាក់ទំនង"

#: data/ktelepathy.notifyrc:148
msgctxt "Comment"
msgid "The specified contact"
msgstr "ទំនាក់ទំនង​ដែល​បាន​បញ្ជាក់"

#: data/ktelepathy.notifyrc:177
msgctxt "Name"
msgid "Class"
msgstr "ថ្នាក់"

#: data/ktelepathy.notifyrc:205
msgctxt "Comment"
msgid "The message class"
msgstr "ថ្នាក់​សារ"

#: data/ktelepathy.notifyrc:237
msgctxt "Name"
msgid "Instant messaging error"
msgstr "កំហុស​ក្នុង​ការ​ផ្ញើ​សារ​បន្ទាន់"

#: data/ktelepathy.notifyrc:265
msgctxt "Comment"
msgid "An error occurred within instant messaging"
msgstr "មាន​កំហុស​បាន​កើតឡើង​នៅ​ពេល​ផ្ញើ​សារ​បន្ទាន់"

#: data/ktelepathy.notifyrc:296
msgctxt "Name"
msgid "Instant messaging info message"
msgstr "សារ​ព័ត៌មាន​ការ​ផ្ញើ​សារ​បន្ទាន់"

#: data/ktelepathy.notifyrc:323
msgctxt "Comment"
msgid "A general info message from instant messaging"
msgstr "សារ​ព័ត៌មាន​ទូទៅ​ពី​ការ​ផ្ញើ​សារ​បន្ទាន់"

#: data/ktelepathy.notifyrc:356
msgctxt "Name"
msgid "Incoming Message"
msgstr "សារ​ចូល"

#: data/ktelepathy.notifyrc:385
msgctxt "Comment"
msgid "An incoming message has been received"
msgstr "បាន​ទទួល​សារ​ចូល"

#: data/ktelepathy.notifyrc:419
msgctxt "Name"
msgid "Incoming Message in Active Chat"
msgstr "សារ​ចូល​នៅ​ក្នុង​ជជែក​សកម្ម"

#: data/ktelepathy.notifyrc:447
msgctxt "Comment"
msgid "An incoming message in the active chat window has been received"
msgstr "បាន​ទទួល​សារ​ចូល​នៅ​ក្នុង​បង្អួច​ជជែក​សកម្ម"

#: data/ktelepathy.notifyrc:480
msgctxt "Name"
msgid "Outgoing Message"
msgstr "សារ​ចេញ"

#: data/ktelepathy.notifyrc:509
msgctxt "Comment"
msgid "An outgoing message has been sent"
msgstr "បាន​ផ្ញើ​សារ​ចេញ"

#: data/ktelepathy.notifyrc:543
msgctxt "Name"
msgid "Highlight"
msgstr "រំលេច"

#: data/ktelepathy.notifyrc:572
msgctxt "Comment"
msgid "A highlighted message has been received"
msgstr "បាន​ទទួល​សារ​រំលេច"

#: data/ktelepathy.notifyrc:604
msgctxt "Name"
msgid "Buzz/Nudge"
msgstr "ជូន​ដំណឹង/កេះកៀវ"

#: data/ktelepathy.notifyrc:632
msgctxt "Comment"
msgid "A contact has sent you a buzz/nudge"
msgstr "ទំនាក់ទំនង​បាន​ផ្ញើ​ការ​ជូនដំណឹង/ការ​កេះកៀវ​ឲ្យ​អ្នក"

#: data/ktelepathy.notifyrc:663
msgctxt "Name"
msgid "Message Dropped"
msgstr "បាន​បោះបង់​សារ"

#: data/ktelepathy.notifyrc:692
msgctxt "Comment"
msgid "A message was filtered by the Privacy Plugin"
msgstr "សារ​ត្រូវ​បាន​ត្រង​ដោយ​កម្មវិធី​ជំនួយ​ភាព​ឯកជន"

#: data/ktelepathy.notifyrc:723
msgctxt "Name"
msgid "Service Message"
msgstr "សេវាកម្ម​សារ"

#: data/ktelepathy.notifyrc:752
msgctxt "Comment"
msgid "A service message has been received (e.g. authorization request)"
msgstr "បាន​ទទួល​សេវាកម្ម​សារ (ឧ.ការ​ស្នើ​សេចក្ដី​អនុញ្ញាត)"

#: data/ktelepathy.notifyrc:786
msgctxt "Name"
msgid "New incoming chat"
msgstr "ការ​ជជែក​ចូល​ថ្មី"

#: data/ktelepathy.notifyrc:814
msgctxt "Comment"
msgid "A new instant message has been received"
msgstr "បាន​ទទួល​សារ​បន្ទាន់​ថ្មី"

#: data/ktelepathy.notifyrc:846
msgctxt "Name"
msgid "Incoming file transfer"
msgstr "ការ​ផ្ទេរ​សារ​ចូល"

#: data/ktelepathy.notifyrc:874
msgctxt "Comment"
msgid "An incoming file transfer request has been received"
msgstr "បាន​ទទួល​សំណើ​ការ​ផ្ទេរ​ឯកសារ​ចូល"

#: data/ktelepathy.notifyrc:906
msgctxt "Name"
msgid "Incoming call"
msgstr "មាន​ការ​ហៅ​ចូល"

#: data/ktelepathy.notifyrc:933
msgctxt "Comment"
msgid "An incoming audio/video call request has been received"
msgstr "បាន​ទទួល​សំណើ​ការ​ហៅ​ចូល​ជា​វីដេអូ/អូឌីយ៉ូ"

#: data/ktelepathy.notifyrc:968
msgctxt "Name"
msgid "Chatstyle Install Request"
msgstr "ការ​ស្នើ​ដំឡើង​រចនាប័ទ្ម​ជជែក"

#: data/ktelepathy.notifyrc:1000
msgctxt "Name"
msgid "Chatstyle Installed Successfully"
msgstr "បាន​ដំឡើង​រចនាប័ទ្ម​ជជែក​ដោយ​ជោគជ័យ"

#: data/ktelepathy.notifyrc:1032
msgctxt "Name"
msgid "Chatstyle Installation Failed"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ដំឡើង​រចនាប័ទ្ម​ជជែក"

#: data/ktelepathy.notifyrc:1064
msgctxt "Name"
msgid "Emoticonset Install Request"
msgstr "ការ​ស្នើ​ដំឡើង Emoticonset"

#: data/ktelepathy.notifyrc:1096
msgctxt "Name"
msgid "Emoticonset Installed Successfully"
msgstr "បាន​ដំឡើង Emoticonset ដោយ​ជោគជ័យ"

#: data/ktelepathy.notifyrc:1129
msgctxt "Name"
msgid "Emoticonset Installation failed"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ដំឡើង Emoticonset"
