#: cryptographyguiclient.cpp:108
msgid ""
"You have not selected a private key for yourself, so signing is not "
"possible. Please select a private key in the Cryptography preferences dialog"
msgstr ""
"អ្នក​មិន​បាន​ជ្រើស​សោ​ឯកជន​សម្រាប់​អ្នក​ទេ សូច្នេះ​ការ​ចុះហត្ថលេខា​មិន​អាច​ធ្វើ​បាន​ទេ ។ សូម​ជ្រើស​សោ​ឯកជន​នៅ​"
"ក្នុង​ប្រអប់​ចំណូលចិត្ត​ការ​គ្រីប"

#: cryptographyguiclient.cpp:109
msgid "No Private Key"
msgstr "គ្មាន​សោ​ឯកជនទេ"

#: cryptographyguiclient.cpp:171
#, kde-format
msgid "You need to select a public key for %2 to send encrypted messages to them."
msgstr "អ្នក​ត្រូវ​តែ​ជ្រើស​សោ​សាធារណៈសម្រាប់ %2 ដើម្បី​ផ្ញើ​​សារ​ដែល​​អ៊ីនគ្រិប​ទៅ​ពួកវា ។"

#: cryptographyguiclient.cpp:173
