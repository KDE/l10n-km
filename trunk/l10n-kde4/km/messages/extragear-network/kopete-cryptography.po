#: cryptographyselectuserkey.cpp:41
msgid "Select Contact's Public Key"
msgstr "ជ្រើស​កូនសោ​សាធារណៈ​របស់​ទំនាក់ទំនង​​"

#: cryptographyselectuserkey.cpp:50 cryptographyselectuserkey.cpp:51
msgid "Select the key you want to use encrypt messages to the recipient"
msgstr "ជ្រើស​សោ​ដែល​អ្នក​ចង់​ប្រើ​​​ការ​អ៊ីនគ្រិប​សារ​ទៅ​អ្នក​ទទួល"

#: cryptographyselectuserkey.cpp:54
#, kde-format
msgid "Select public key for %1"
msgstr "ជ្រើស​កូនសោ​សាធារណៈ​សម្រាប់ %1"

#: cryptographypreferences.cpp:46
msgid "Private Key: "
msgstr "សោ​ឯកជន ៖ "

#: cryptographypreferences.cpp:49 cryptographypreferences.cpp:50
msgid "Select the key you want to use to sign and encrypt messages"
msgstr "ជ្រើសសោ​ដែល​អ្នក​ចង់​ប្រើ ដើម្បី​ចុះហត្ថលេខា និង​អ៊ីនគ្រិប​សារ"

#: cryptographypreferences.cpp:51
msgid "The private key used for decryption and signing"
msgstr "សោ​ឯកជន​បាន​ប្រើ​សម្រាប់​ការ​ឌិគ្រិប និង​ចុះហត្ថលេខា"

#: cryptographypreferences.cpp:52
msgid ""
"View and change the private key used for signing and encrypting messages "
"using the Cryptography plugin"
msgstr "មើល និង​ផ្លាស់ប្ដូរ​សោ​ឯកជន​ដែល​បាន​ប្រើ​សម្រាប់​ចុះហត្ថលេខា និង​អ៊ីនគ្រិប​សារ​ ដោយ​ប្រើ​កម្មវិធី​ជំនួយ​ការ​គ្រីប"

#: cryptographypreferences.cpp:54
msgid ""
"Before you can sign messages or receive encrypted ones, you must select a "
"private key for yourself.\n"
"\n"
"Before you can send encrypted messages to someone, you must select their "
"public key by right-clicking on their name in your contact list and choosing "
"\"Select Public Key\"."
msgstr ""
"មុន​ពេល​អ្នក​អាច​ចុះហត្ថលេខា​សារ ឬ​ទទួល​សារ​ដែល​បាន​អ៊ីនគ្រិប អ្នក​ត្រូវ​តែ​ជ្រើស​សោ​សាធារណៈ​សម្រាប់​អ្នក​"
"ផ្ទាល់ ។\n"
"\n"
"មុន​ពេល​អ្នកអាច​​ផ្ញើសារ​ដែល​បាន​អ៊ីនគ្រិប​ទៅ​អ្នកណា​ម្នាក់ អ្នក​ត្រូវ​តែ​ជ្រើស​សោ​សាធារណៈ​ដោយ​ចុច​កណ្ដុរ​ស្ដាំ​លើ​"
"ឈ្មោះ​របស់​ពួកវានៅ​ក្នុង​បញ្ជីទំនាក់ទំនង និង​ជ្រើស\"ជ្រើស​សោ​សាធារណៈ\" ។"

#: exportkeys.cpp:40
msgid "Export Public Keys"
msgstr "នាំចេញ​សោ​សាធារណៈ"

#: exportkeys.cpp:42
msgid "Export"
msgstr "នាំចេញ"

#: exportkeys.cpp:42
msgid "Export checked keys to address book"
msgstr "នាំចេញ​សោ​ដែល​បាន​ត្រួតពិនិត្យ​ទៅ​សៀវភៅ​អាសយដ្ឋាន"

#: exportkeys.cpp:75
msgid "<No meta-contacts with keys to export>"
msgstr "<គ្មាន​ទំនាក់ទំនង​មេតា​ដែល​មាន​សោ​ត្រូវ​នាំចេញ>"

#: cryptographyplugin.cpp:92
msgid "&Select Public Key..."
msgstr "ជ្រើស​សោ​សាធារណៈ..."

#: cryptographyplugin.cpp:98
msgid "&Export Public Keys To Address Book..."
msgstr "នាំចេញ​សោ​សាធារណៈ​ទៅ​សៀវភៅ​អាសយដ្ឋាន..."

#: cryptographyplugin.cpp:368 cryptographyguiclient.cpp:163
msgid ""
"This protocol may not work with messages that are encrypted. This is because "
"encrypted messages are very long, and the server or peer may reject them due "
"to their length. To avoid being signed off or your account being warned or "
"temporarily suspended, turn off encryption."
msgstr ""
"ពិធីការ​នេះ​មិនអាច​ដំណើរការ​ជាមួយ​សារ​ដែល​ត្រូវ​បាន​អ៊ីនគ្រិប​បាន​ទេ ។ នេះពីព្រោះ​តែ​សារ​ដែល​បាន​អ៊ីនគ្រិប​វែង​"
"ពេក និង​ម៉ាស៊ីន​បម្រើ ឬ​ម៉ាស៊ីន​ដូចគ្នា​អាច​ច្រាន​ពួកគេ​ចោល ដោយ​សារ​ប្រវែង​របស់​ពួកវា ។ ដើម្បី​ចៀសវាង​ត្រូវ​បាន​"
"ឲ្យ​ចេញ ឬ​គណនី​របស់​អ្នក​កំពុង​ត្រូវ​បាន​ព្រមាន ឬផ្អាក​ជា​បណ្ដោះ​អាសន្ន បិទ​ការ​អ៊ីនគ្រិប ។"

#: cryptographyplugin.cpp:369 cryptographyguiclient.cpp:164
msgid "Cryptography Unsupported Protocol"
msgstr "កា​រគ្រីប​ពិធីការ​ដែល​មិន​បាន​គាំទ្រ"

#: cryptographyplugin.cpp:405
#, kde-format
msgid ""
"Cryptography plugin has found an encryption key for %1 (%2) in your KDE "
"address book. Do you want to use key %3 as this contact's public key? "
msgstr ""
"កម្មវិធី​ជំនួយ​ការ​គ្រីប​បាន​រកឃើញ​សោ​អ៊ីនគ្រិប​សម្រាប់ %1 (%2) នៅ​ក្នុង​សៀវភៅ​អាសយដ្ឋាន​របស់ KDE ។ តើ​​អ្នក​​"
"ចង់​ប្រើ​សោ %3 ជា​សោ​សាធារណៈ​របស់​ទំនាក់ទំនង​ឬទេ ?"

#: cryptographyplugin.cpp:406
msgid "Public Key Found"
msgstr "រកឃើញ​សោ​សាធារណៈ"

#: cryptographyplugin.cpp:417
msgid "Public Keys Found"
msgstr "រកឃើញ​សោ​សាធារណៈ"

#: cryptographyplugin.cpp:420
#, kde-format
msgid ""
"Cryptography plugin has found multiple encryption keys for %1 (%2) in your "
"KDE address book. To use one of these keys, select it and choose OK."
msgstr ""
"កម្មវិធី​ការ​អ៊ីនគ្រិប​បាន​រកឃើញ​សោ​អ៊ីនគ្រប​ជា​ច្រើន​សម្រាប់ %1 (%2) នៅ​ក្នុង​សៀវភៅ​អាសយដ្ឋាន​របស់ KDE ។ "
"ដើម្បី​ប្រើសោ​មួយ​ក្នុង​ចំណោម​សោ​ទាំង​នេះ ជ្រើស​វា និង​ចុច​ យល់ព្រម ។"

