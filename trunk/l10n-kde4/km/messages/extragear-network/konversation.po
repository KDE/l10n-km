#: src/viewer/channeloptionsdialog.cpp:566
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>The <b>T</b>opic mode means that only the channel "
"operator can change the topic for the channel.</p></qt>"
msgstr ""
"<qt><p>​ទាំង​នេះ​ត្រួត​ពិនិត្យ <em>របៀប</em> ឆានែល ។  "
"មាន​តែ​ការី​ប៉ុណ្ណោះ​អាច​ផ្លាស់ប្ដូរ​ ។</p><p> <b>ប្រធាន​បទ</b>មាន​ន័យ​ថា "
"​មានតែ​ការី​ឆានែល​ប៉ុណ្ណោះ​​អាច​ផ្លាស់ប្ដូរ​ប្រធាន​បទ​សម្រាប់​ឆានែលបាន​ "
"។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:568
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p><b>N</b>o messages from outside means users who are not "
"in the channel cannot send messages for everybody in the channel to see.  "
"Almost all channels have this set to prevent nuisance messages.</p></qt>"
msgstr ""
"<qt><p>ទាំង​នេះ​ត្រួត​ពិនិត្យ​ <em>របៀប​</em> របស់​ឆានែល​ ។  "
"ការី​តែមួយ​ប៉ុណ្ណោះ​អាច​ប្ដូរ​ទាំងនេះ​បាន​ ។​ "
"</p><p><b>គ្មាន​</b>សារ​ពី​ខាង​ក្រៅ​ មាន​ន័យ​ថា​អ្នក​ប្រើ​ដែល​មិន​នៅ​ក្នុង​ឆ"
"ានែល​មិន​អាច​ផ្ញើ​សារ​សម្រាប់​អ្នក​រាល់​គ្នា​​ក្នុង​ឆានែល​ដើម្បី​មើល​បាន​ឡើយ"
"​​ ។  "
"គ្រប់​ឆានែល​ភាគ​ច្រើន​មាន​ការ​កំណត់​នេះ​ដើម្បី​ការ​ការ​ពារ​សារ​ដែល​រំខាន​ "
"។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:570
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>A <b>S</b>ecret channel will not show up in the channel "
"list, nor will any user be able to see that you are in the channel with the "
"<em>WHOIS</em> command or anything similar.  Only the people that are in the "
"same channel will know that you are in this channel, if this mode is set.</"
"p></qt>"
msgstr ""
"<qt><p>ទាំង​នេះ​ត្រួតពិនិត្យ​ <em>របៀប​</em> នៃ​ឆានែល​ ។  "
"ការី​តែ​មួយ​ប៉ុណ្ណោះ​អាច​ប្ដូរ​ទាំង​នេះ​បាន​ ។ </p><p>ឆានែល​ <b>សម្ងាត់​</b> "
"នឹង​មិន​បង្ហាញ​ក្នុង​​បញ្ជី​ឆានែល​ នឹង​គ្មាន​អ្នក​ប្រើ​អាច​ដឹង​ថា "
"​អ្នក​នៅ​ក្នុង​ឆានែល​ជាមួយ​ ​<em>ជា​អ្នក​​ណា​​</em>ពាក្យ​បញ្ជា "
"ឬ​ប្រហាក់​ប្រហែល​វត្ថុ​អ្វី​មួយ​ ។  "
"មាន​មនុស្ស​តែម្នាក់​ប៉ុណ្ណោះ​ដែល​មាន​ក្នុង​ឆានែល​ដូច​គ្នា​ "
"នឹង​ដឹង​ថា​អ្នក​នៅ​ក្នុង​ឆានែល​នេះ​ ប្រ​សិន​បើ​ របៀប​នេះ​ត្រូវ​បាន​កំណត់​ "
"។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:572
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>An <b>I</b>nvite only channel means that people can only "
"join the channel if they are invited.  To invite someone, a channel operator "
"needs to issue the command <em>/invite nick</em> from within the channel.</"
"p></qt>"
msgstr ""
"<qt><p>ទាំង​នេះ​ត្រួតពិនិត្យ​ <em>របៀប​</em> នៃ​ឆានែល​ ។  "
"ការី​តែមួយ​ប៉ុណ្ណោះ​អាច​ប្ដូរ​ទាំង​នេះ​បាន​ ។ </p><p>អញ្ជើញ​ "
"<b>ឆានែល</b>តែមួយ​ប៉ុណ្ណោះ​ មាន​ន័យ​ថា​អ្នក​អាច​ភ្ជាប់​​បានតែ​ឆានែល​ "
"ប្រ​សិន​បើ​ ពួកវា​ត្រូវ​បាន​អញ្ជើញ ។  ដើម្បី​អញ្ជើញ​អ្នក​ណា​ម្នាក់​ "
"ត្រូវ​ការ​ការី​ឆានែល​ដើម្បី​ ចេញ​ពាក្យ​បញ្ជា​ <em>/អញ្ជើញ​សម្មតិនាម​</em> "
"ពី​ខាងក្រៅ​ឆានែល​ ។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:574
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>A <b>P</b>rivate channel is shown in a listing of all "
"channels, but the topic is not shown.  A user's <em>WHOIS</em> may or may "
"not show them as being in a private channel depending on the IRC server.</"
"p></qt>"
msgstr ""
"<qt><p>ទាំងនេះ​ត្រួត​ពិនិត្យ​ <em>របៀប​</em> នៃ​ឆានែល ។  "
"ការី​តែមួយ​ប៉ុណ្ណោះ​អាច​ប្តូរ​ទាំង​នេះ​ ។ </p><p>ឆានែល​ <b>ឯកជន​</b> "
"ត្រូវ​​បាន​​ង្ហាញ​ក្នុង​បញ្ជី​របស់​ឆានែល​ទាំង​អស់​ "
"ប៉ុន្តែ​ប្រធាន​បទ​មិន​ត្រូវ​បាន​ង្ហាញ​ឡើយ​ ។  អ្នក​ប្រើ​ "
"<em>ជា​អ្នក​ណា​</em> អាច​ ឬ​មិន​អាច​ "
"បង្ហាញ​វា​ក្នុង​ឆានែល​ឯកជន​ផ្អែក​ទៅ​លើ​ម៉ាស៊ីន​បម្រើ​ជជែក​​តាម​​អ៊ីនធឺណិត​ "
"។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:576
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>A <b>M</b>oderated channel is one where only operators, "
"half-operators and those with voice can talk.</p></qt>"
msgstr ""
"<qt><p>ទាំង​នេះ​​ត្រួត​ពិនិត្យ​​ <em>របៀប​</em> នៃ​ឆានែល​ ។  "
"ការី​តែមួយ​ប៉ុណ្ណោះ​អាច​ប្ដូរ​ទាំងនេះ​ ។ </p><p>បន្ថយ​ <b>ឆានែល​</b> "
"មួយ​ដែល​ការី​តែមួយ​ប៉ុណ្ណោះ​ ពាក្យ​កណ្ដាល​ការី​ "
"និង​ជាមួយ​សំឡេង​អាច​និយាយ​បាន​ទាំង​នោះ​​ ។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:578
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>A protected channel requires users to enter a password "
"in order to join.</p></qt>"
msgstr ""
"<qt><p>ទាំង​នេះ​ត្រួត​ពិនិត្យ​​<em>របៀប​​</em> នៃ​ឆានែល​ ។  "
"ការី​តែមួយ​ប៉ុណ្ណោះ​អាច​ប្ដូរ​ទាំង​នេះ​ ។​ </p><p>អ្នក​ប្រើ​ទាមទារ​ឆានែល​ដែល"
"​បាន​ការ​ពារ​​ដើម្បី​បញ្ចូល​ពាក្យ​សម្ងាត់​​នៅ​ក្នុង​លំដាប់​ភ្ជាប់​ "
"។</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:580
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can "
"change these.</p><p>A channel that has a user <b>L</b>imit means that only "
"that many users can be in the channel at any one time.  Some channels have a "
"bot that sits in the channel and changes this automatically depending on how "
"busy the channel is.</p></qt>"
msgstr ""
"<qt><p>ទាំងនេះ​ត្រួតពិនិត្យ​ <em>របៀប</em> នៃ​ឆានែល​ ។  "
"ការី​តែមួយ​ប៉ុណ្ណោះ​អា​ច​ប្ដូរ​ទាំងនេះ​ ។ </p><p>ឆានែល​ដែល​អ្នក​ប្រើ​ "
"<b>កំណត់​</b> ដែល​មាន​ន័យ​ថា​ "
"អ្នក​ប្រើ​ជាច្រើន​អាច​នៅ​ក្នុង​ឆានែល​ពេល​តែមួយ​ ។  "
"ឆានែល​មួយ​ចំនួន​មាន​អ្នក​លេង​លើ​បណ្ដាញ​ដែល​ចូល​ក្នុង​ឆានែល​ "
"និង​ប្ដូរ​វា​ដោយ​ស្វ័យ​ប្រវត្តិ​អាស្រ័យ​ទៅលើ​ ភាព​​រវល់​ឆានែលរបៀបណា​​ "
"។</p></qt>"

