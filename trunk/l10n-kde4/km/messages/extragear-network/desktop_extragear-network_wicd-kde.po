#: wicdclient.scripts.actions:66
msgctxt "Description"
msgid "Requesting root privileges to save scripts"
msgstr "ស្នើ​សុំ​សិទ្ធិ​ជា​ root ដើម្បី​រក្សា​ទុក​ស្គ្រីប"

