msgstr ""
"<qt>កន្សោម​តម្រង (ឧ. <tt>http://www.example.com/ad/*</tt>, <a href=\"filterhelp"
"\">សម្រាប់​ព័ត៌មាន​បន្ថែម</a>) ៖"

#: adblock/adblocksettingwidget.cpp:68
msgid " day"
msgid_plural " days"
msgstr[0] "ថ្ងៃ"

#: adblock/adblocksettingwidget.cpp:85
msgid ""
"<qt><p>Enter an expression to filter. Filters can be defined as either:"
"<ul><li>a shell-style wildcard, e.g. <tt>http://www.example.com/ads*</tt>, "
"the wildcards <tt>*?[]</tt> may be used</li><li>a full regular expression by "
"surrounding the string with '<tt>/</tt>', e.g. <tt>/\\/(ad|banner)\\./</tt></"
"li></ul><p>Any filter string can be preceded by '<tt>@@</tt>' to whitelist "
"(allow) any matching URL, which takes priority over any blacklist (blocking) "
"filter."
msgstr ""
"<qt><p>បញ្ចូល​កន្សោម​ដើម្បី​ត្រង ។ តម្រង​អាច​ត្រូវ​បាន​កំណត់​ជា ៖<ul><li>តួអក្សរ​ជំនួស shell-style "
"ឧ. <tt>http://www.example.com/ads*</tt> តួអក្សរ​ជំនួស <tt>*?[]</tt> ត្រូវ​បាន​ប្រើ</"
"li><li>កន្សោម​ធម្មតា​ពេញលេញ​ដែល​អម​ឃ្លា​ដោយ​សញ្ញា '<tt>/</tt>' ឧ. <tt>/\\/(ad|"
"banner)\\./</tt></li></ul><p>ឃ្លា​តម្រង​ទាំងអស់​អាច​ត្រូវ​បា​ន​នាំមុខ​ដោយ '<tt>@@</tt>' ទៅកាន់​"
"បញ្ជី​ស (អនុញ្ញាត) URL ផ្គូផ្គង​ណាមួយ ដើម្បី​មាន​អាទិភាព​លើ​តម្រង​បញ្ជី​ខ្មៅ (ទប់ស្កាត់) ។"

