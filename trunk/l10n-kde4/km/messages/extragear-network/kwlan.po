#: kwlansuprocess.cpp:79
#, kde-format
msgid ""
"<qt>Kwlan was unable to<p align=\"center\"><b>%1</b></p>This may be caused "
"by temporary malfunction or system misconfiguration (e.g. absence of the "
"utility called). You may want to run this task again and see if this helps. "
"Do you want to restart the task?</qt>"
msgstr ""
"<qt>Kwlan មិន​អាច​​ទៅកាន់​<p align=\"center\"><b>%1</b></p>​វា​អាច​បណ្ដាល​មក​ពី​ការ​​​ធ្វើ​ការ​ខុស​"
"ប្រក្រតី​បណ្ដោះ​អាសន្ន​ ឬ​​បាត់​ការ​កំណត់​រចនាសម្ព័ន្ធ​ប្រព័ន្ធ​​ (ឧ. អវត្តមាន​នៃ​ឧបករណ៍​ដែល​បាន​ហៅ​​) ។​ អ្នក​អាច​"
"ដំណើរការ​កិច្ចការ​នេះ​ម្ដងទៀត ហើយ​មើល​ថា​តើ​វា​អាច​ជួយ​បាន​ដែរ​ឬទេ ។​ ​តើ​អ្នក​ចង់​ចាប់ផ្ដើម​កិច្ចការ​​​ឡើង​វិញ​"
"ដែរ​ឬទេ ?​</qt>"

#: kwlansuprocess.cpp:86 kwlansuprocess.cpp:110
#, kde-format
msgid "Error has occurred"
msgstr "កំហុស​បាន​កើត​ឡើង​"

#: kwlansuprocess.cpp:103
#, kde-format
msgid ""
"<qt>Kwlan was unable to<p align=\"center\"><b>%1</b></p>This may be caused "
"by system misconfiguration e.g. absence of the utility called or incorrect "
"parameters passed. Please check this and try again."
msgstr ""
"<qt>Kwlan មិន​អាច​ទៅកាន់​​<p align=\"center\"><b>%1</b></p>វា​អាច​បង្ក​ដោយ​កំហុស​ការ​កំណត់​"
"រចនាសម្ព័ន្ធ​ប្រព័ន្ធ​​ ឧ.ទា​. អវត្តមាន​នៃ​ឧបករណ៍​ដែល​បាន​ហៅ​​ ឬ​បាន​បិទ​ភ្ជាប់​ប៉ារ៉ាម៉ែត្រ​មិន​ត្រឹមត្រូវ​ ។ សូម​"
"ពិនិត្យ​មើល​វា​ ហើយ​ព្យាយាម​ម្ដងទៀត​ ។"

