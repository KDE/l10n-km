#: dbushandler.cpp:96
msgid ""
"The Web share for magnet-links is disabled. You can set it up at settings:/"
"network-and-connectivity/sharing"
msgstr ""
"ការ​ចែករំលែក​បណ្ដាញ​សម្រាប់​តំណ​ម៉ាញេទិច​ត្រូវ​បាន​បិទ ។ អ្នក​អាច​រៀបចំ​វា​បាន​នៅ settings:/network-"
"and-connectivity/sharing"

#: dbushandler.cpp:120
msgid ""
"Cannot start process for KTorrent.                           This should not "
"happen, even if KTorrent is not installed.                           Check "
"your machines resources and limits."
msgstr ""
"មិន​អាច​ចាប់ផ្ដើម​ដំណើរការ​សម្រាប់ KTorrent បាន​ទេ ។                           វា​មិន​គួរ​"
"កើតមាន​ទេ ទោះបីជា​មិន​បាន​ដំឡើង KTorrent ក៏ដោយ ។ ពិនិត្យមើល​ធនធាន និង​ដែន​កំនត់​ម៉ាស៊ីន​របស់​អ្នក ។"

#: dbushandler.cpp:158
#, kde-format
msgid ""
"Could not connect to KTorrent via DBus                                     "
"after %1 seconds. Is it broken?"
msgstr ""
"មិន​អាច​តភ្ជាប់​ទៅកាន់ KTorrent តាម DBus បាន​ទេ                                     "
"បន្ទាប់ពី %1 វិនាទី ។ តើ​វា​ខូច​ឬ ?"

#: dbushandler.cpp:180
msgid ""
"Could not get the group list, do you have a compatible KTorrent version "
"running?"
msgstr "មិន​អាច​យក​បញ្ជី​ក្រុម​បាន​ទេ តើ​អ្នក​កំពុង​ដំណើរការ KTorrent កំណែ​ឆប​គ្នា​មែន​ទេ ?"

#: dbushandler.cpp:333
#, kde-format
msgid "The link for %1 does not contain the required btih hash-parameter."
msgstr "តំណ​ភ្ជាប់​សម្រាប់ %1 មិន​មាន btih hash-parameter ដែល​បាន​ទាមទារ​ទេ ។"

#: dbushandler.cpp:345
#, kde-format
msgid "The found value (%1) for the hash is neither 32 nor 40 chars long."
msgstr "តម្លៃ (%1) ដែល​បាន​រក​ឃើញ​សម្រាប់​សញ្ញា​គឺ​មិនមែន​ជា​ប្រវែង​តួអក្សរ ៣២ ហើយ​ក៏​មិនមែន ៤០ ដែរ ។"

#: dbushandler.cpp:624
msgid "Torrent has been removed from KTorrent."
msgstr "បាន​យក Torrent ចេញពី KTorrent ។"

#: kio_magnet.cpp:294 kio_magnet.cpp:395
#, kde-format
msgid ""
"File exists in KTorrent, but cannot open it on disk at path\"%1\". Have you "
"removed the file manually?"
msgstr ""
"ឯកសារ​មាន​នៅ​ក្នុង KTorrent ប៉ុន្តែ​មិន​អាច​បើក​វា​នៅ​លើ​ថាស​នៅ​ផ្លូវ\"%1\" បាន​ទេ ។ តើ​អ្នក​មាន​បាន​យក​"
"ឯកសារ​ចេញ​ដោយ​ដៃ​ដែរ​ឬទេ ?"

#: kio_magnet.cpp:375
msgid "You cannot write to magnet resources."
msgstr "អ្នក​មិន​អាច​សរសេរ​ទៅកាន់​ធនធាន​ម៉ាញេទិច​បាន​ទេ ។"

#: kio_magnet.cpp:403
#, kde-format
msgid "File \"%1\" is a directory. This should not happen. Please file a bug."
msgstr "ឯកសារ \"%1\" គឺជា​ថត ។ វា​មិន​គួរ​កើតមាន​ទេ សូម​រៀបចំ​ឯកសារ​កំហុស ។"

#: kio_magnet.cpp:429
#, kde-format
msgid ""
"File exists in KTorrent, but cannot open it on disk at path \"%1\". Have you "
"removed the file manually?"
msgstr ""
"ឯកសារ​មាន​នៅ​ក្នុង KTorrent ប៉ុន្តែ​មិន​អាច​បើក​វា​នៅ​លើ​ថាស​នៅ​ផ្លូវ \"%1\" បាន​ទេ ។ តើ​អ្នក​មាន​បាន​"
"យក​ឯកសារ​ចេញ​ដោយ​ដៃ​ដែរ​ឬទេ ?"

#. i18n: file: magnetsettings.kcfg:10
#. i18n: ectx: label, entry (Enabled), group (Magnet)
#: rc.cpp:3
msgid "Enable the global magnet-link support."
msgstr " បើក​ការ​គាំទ្រ​តំណ​ម៉ាញេទិច​សាកល ។"

#. i18n: file: magnetsettings.kcfg:14
#. i18n: ectx: label, entry (ShareSize), group (Magnet)
#: rc.cpp:6
msgid "Total maximum size used by the share in MiB."
msgstr "ទំហំ​អតិបរមា​សរុប​ដែល​បាន​ប្រើ​ដោយ​ការ​ចែករំលែក​នៅ​ក្នុង MiB ។"

#. i18n: file: magnetsettings.kcfg:18
#. i18n: ectx: label, entry (TrustedHosts), group (Magnet)
#: rc.cpp:9
msgid "List of hosts which are directly accepted on loading"
msgstr "បញ្ជី​ម៉ាស៊ីន​ដែល​បាន​ព្រម​ទទួល​ដោយ​ផ្ទាល់​នៅ​ពេល​ផ្ទុក"

#. i18n: file: magnetsettings.kcfg:21
#. i18n: ectx: label, entry (ManagedTorrents), group (Magnet)
#: rc.cpp:12
msgid "Torrents inside KTorrent which are managed by these modules."
msgstr "Torrents នៅ​ក្នុង KTorrent ដែល​ត្រូវ​បាន​គ្រប់គ្រង​ដោយ​ម៉ូឌុល​នេះ ។"

#. i18n: file: magnetsettings.kcfg:24
#. i18n: ectx: label, entry (RunningTorrents), group (Magnet)
#: rc.cpp:15
msgid "Torrents currently used by the I/O-Slaves."
msgstr "Torrents បច្ចុប្បន្ន​ដែល​បាន​ប្រើ​ដោយ I/O-Slaves ។"

#. i18n: file: magnetsettings.kcfg:27
#. i18n: ectx: label, entry (MaxShareRatio), group (Magnet)
#: rc.cpp:18
msgid "The maximum share ratio which should be targeted for each torrent."
msgstr "សមាមាត្រ​ចែករំលែក​អតិបរមា​ដែល​គួរ​ត្រូវ​បាន​ជា​គោលដៅ​សម្រាប់ torrent នីមួយៗ ។"
