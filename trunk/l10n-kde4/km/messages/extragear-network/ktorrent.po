#. i18n: file: ktorrent/advancedpref.ui:157
#. i18n: ectx: property (toolTip), widget (QSpinBox, kcfg_guiUpdateInterval)
#: rc.cpp:1106
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
