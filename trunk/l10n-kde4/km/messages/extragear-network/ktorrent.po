msgid "Additional Peer Sources"
msgstr "ប្រភព​ម៉ាស៊ីន​ដូចគ្នា​បន្ថែម"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 22
#: rc.cpp:295
msgid ""
"DHT is a trackerless protocol to find peers sharing the same torrents as you "
"do."
msgstr ""
"DHT គឺ​ជា​ពិធីការ​ដែល​គ្មាន​កម្មវិធី​តាមដាន ដើម្បី​ស្វែងរក​ម៉ាស៊ីន​ដូចគ្នា​ដែល​ចែករំលែក torrent ដូចគ្នា​នឹង​"
"អ្នក ។"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 25
#: rc.cpp:298
msgid "Use DHT to get additional peers"
msgstr "ប្រើ DHT ដើម្បី​យក​ម៉ាស៊ីន​ដូចគ្នា​បន្ថែម"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 34
#: rc.cpp:301
msgid "UDP port for DHT communications:"
msgstr "ច្រក UDP សម្រាប់​ទំនាក់ទំនង DHT ៖"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 46
#: rc.cpp:304
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">UDP port to use for the "
"DHT protocol.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Attention:</span> If you are behind a router, this port needs "
"to be forwarded to accept incoming DHT requests. The UPnP plugin can do this "
"for you.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ច្រក UDP ដែលត្រូវ​ប្រើ​សម្រាប់​"
"ពិធីការ DHT ។</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; "
"margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">សូម​ជំរាប​ថា ៖</span> ប្រសិន​បើ​អ្នក​នៅ​ពីក្រោយ​​រ៉ោតទ័រ ច្រកនេះ​តម្រូវ​ឲ្យ​បញ្ជូន​បន្ត "
"ដើម្បី​ទទួល​យក​សំណើរ DHT ចូល ។ កម្មវិធី​ជំនួយ UPnP គឺ​អាច​ធ្វើ​ដូចនេះ​បាន ។</p></body></html>"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 64
#: rc.cpp:312
msgid "Wether or not to use µTorrent compatible peer exchange."
msgstr "ថាតើ​ត្រូវ​ប្រើ​ការ​ផ្លាស់ប្ដូរ​ម៉ាស៊ីន​ដូច​គ្នា​ដែល​ឆបគ្នា​របស់ µTorrent ឬ​ក៏​អត់ ។"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 67
#: rc.cpp:315
msgid "Use peer exchange"
msgstr "ប្រើ​ការ​ផ្លាស់ប្ដូរ​​ម៉ាស៊ីន​ដូចគ្នា"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 77
#: rc.cpp:318
msgid "Encryption"
msgstr "​ការ​អ៊ីនគ្រីប"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 87
#: rc.cpp:321
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Protocol encryption is "
"useful when your ISP is slowing down bittorrent connections. </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">The encryption will "
"prevent your bittorrent traffic to be flagged as bittorrent traffic, and so "
"the ISP will not slow it down.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ការ​អ៊ិនគ្រីប​ពិធីការ​គឺ​មាន​ប្រយោជន៍ "
"នៅពេល​ដែល ISP អ្នក​អ្នក​បន្ថយ​ការ​តភ្ជាប់ bittorrent ។ </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">ការ​អ៊ិនគ្រីប​នឹង​ការពារ​ចរាចរ "
"bittorrent របស់​អ្នក​ដើម្បី​កំណត់​ជា​ចរាចរ bittorrent ហើយ​ដូច្នេះ ISP នឹង​មិន​បន្ថយ​ការ​តភ្ជាប់ទេ ។"
"</p></body></html>"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 90
#: rc.cpp:328
msgid "Use protocol encryption"
msgstr "ប្រើ​ការ​អ៊ិនគ្រីប​ពិធី​ការ​"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 97
#: rc.cpp:331
msgid ""
"Not all clients support encryption, and some people have encryption "
"disabled. If you want to connect to those peers, you need to have this "
"option enabled."
msgstr ""
"ម៉ាស៊ីន​ភ្ញៀវ​មួយ​ចំនួន​មិន​គាំទ្រ​ការ​អ៊ិនគ្រីប​ទេ ហើយ​បុគ្គល​មួយ​ចំនួន​បាន​បិទ​ការ​អ៊ិនគ្រីប ។ ប្រសិន​បើ​អ្នក​ចង់​តភ្ជាប់​"
"ម៉ាស៊ីន​ដូចគ្នា​ទាំងនោះ អ្នក​ត្រូវបិទ​ជម្រើស​នេះ ។"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 100
#: rc.cpp:334
msgid "Allow unencrypted connections"
msgstr "អនុញ្ញាត​ការ​តភ្ជាប់​ដែល​មិន​បាន​អ៊ីនគ្រីប"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 110
#: rc.cpp:337
msgid "Tracker"
msgstr "កម្មវិធី​តាម​ដាន​"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 116
#: rc.cpp:340
msgid ""
"Instead of allowing the tracker to determine your IP address, tell the "
"tracker which IP address to use. Use this when you are behind a proxy."
msgstr ""
"ជំនួស​ឲ្យ​កម្មវិធី​តាមដាន​ដូច​ខាង​ក្រោម ដើម្បី​កំណត់​អាសយដ្ឋាន IP របស់​អ្នក​ ប្រាប់​កម្មវិធី​តាមដាន​ថា​"
"អាសយដ្ឋាន IP ត្រូវ​ប្រើ ។ ប្រើ​វា​នៅពេល​អ្នក​នៅ​ខាង​ក្រោយ​ប្រូកស៊ី ។"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 119
#: rc.cpp:343
msgid "Send the tracker a custom IP address or hostname"
msgstr "ផ្ញើ​ឈ្មោះ​ម៉ាស៊ីន ឬ​អាសយដ្ឋាន​ IP ផ្ទាល់​ខ្លួន​របស់​កម្មវិធី​តាមដាន"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 128
#: rc.cpp:346
msgid "Custom IP address or hostname:"
msgstr "ឈ្មោះ​ម៉ាស៊ីន ឬ​អាសយដ្ឋាន IP ៖"

#. i18n: tag string
#. i18n: file ./ktorrent/btpref.ui line 135
#: rc.cpp:349
msgid ""
"Custom IP address or hostname to send to the tracker. Hostnames will be "
"resolved at runtime and the resolved IP address will be sent to the tracker."
msgstr ""
"ឈ្មោះ​ម៉ាស៊ីន ឬ​អាសយដ្ឋាន IP ផ្ទាល់ខ្លួន​ដើម្បី​ផ្ញើ​​ទៅ​កម្មវិធី​តាមដាន ។ ឈ្មោះ​ម៉ាស៊ីន​នឹង​ត្រូវ​បាន​ដោះស្រាយ​នៅ​"
"ពេល​រត់ និង​អាសយដ្ឋាន​ IP ដែល​បាន​ដោះស្រាយ​នឹង​ត្រូវ​បាន​ផ្ញើ​ទៅ​កម្មវិធី​តាមដាន ។"

