#: engine/ftpsocket.cpp:1491 engine/ftpsocket.cpp:1835
#: engine/ftpsocket.cpp:2659 engine/sftpsocket.cpp:537
#: engine/sftpsocket.cpp:733 engine/sftpsocket.cpp:803
#: engine/sftpsocket.cpp:1007
#, kde-format
msgid "Transferring..."
