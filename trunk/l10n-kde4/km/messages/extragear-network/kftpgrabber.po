#: engine/sftpsocket.cpp:214
#, kde-format
msgid "Public key authentication succeeded."
msgstr "បាន​ជោគជ័យ​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​សោ​សាធារណៈ ។​"

#: engine/sftpsocket.cpp:226
#, kde-format
msgid "Authentication has failed."
