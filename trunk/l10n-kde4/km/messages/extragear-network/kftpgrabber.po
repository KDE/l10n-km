#: engine/ftpsocket.cpp:468 engine/sftpsocket.cpp:318
#, kde-format
msgid "Failed to connect (%1.)"
msgstr "បាន​បរាជ័យ​ទៅ​តភ្ជាប់​ (%1 ។)"

#: engine/ftpsocket.cpp:478
#, kde-format
msgid ""
"SSL negotiation successful. Connection is secured with %1 bit cipher %2."
msgstr "ការ​​ចរចា​អំពី​​ SSL ដោយ​ជោគជ័យ ។ ការ​តភ្ជាប់​មាន​សុវត្ថិភាព​ជាមួយ​ប៊ីត %1 សរសេរ​សម្ងាត់ %2 ។"

#: engine/ftpsocket.cpp:505
#, kde-format
msgid "SSL negotiation failed. Connection aborted."
msgstr "បាន​បរាជ័យ​​ការចរចា​អំពី​ SSL ។ បាន​បោះបង់​ការ​តភ្ជាប់​ ។ "

#: engine/ftpsocket.cpp:538 engine/sftpsocket.cpp:360
#, kde-format
msgid "Aborted."
msgstr "បាន​បោះបង់​ ។"

#: engine/ftpsocket.cpp:838
#, kde-format
msgid "Incompatible address family for PORT, but EPRT not supported, aborting."
msgstr "ក្រុម​អាសយដ្ឋាន​ដែល​មិន​ឆប​គ្នា សម្រាប់ PORT ប៉ុន្តែ EPRT មិន​បាន​គាំទ្រ​ កំពុង​បោះបង់ ។"

#: engine/ftpsocket.cpp:880
#, kde-format
msgid "Establishing data connection with %1:%2..."
msgstr "កំពុង​បង្កើត​ការ​តភ្ជាប់​ទិន្នន័យ​ជាមួយ​ %1 ៖ %2..."

#: engine/ftpsocket.cpp:914 engine/ftpsocket.cpp:920
#, kde-format
msgid "Unable to establish a listening socket."
msgstr "មិន​អាច​បង្កើត​រន្ធ​ស្ដាប់​បាន​ឡើយ ។"

#: engine/ftpsocket.cpp:953
#, kde-format
msgid "Waiting for data connection on port %1..."
msgstr "កំពុង​រង់ចាំ​ការ​តភ្ជាប់​ទិន្នន័យ​​លើ​ច្រក​ %1..."

#: engine/ftpsocket.cpp:967 engine/ftpsocket.cpp:1042
#, kde-format
msgid "Data connection established."
msgstr "បាន​បង្កើត​ការ​តភ្ជាប់​ទិន្នន័យ ។"

#: engine/ftpsocket.cpp:1017
#, kde-format
msgid "Data channel secured with %1 bit SSL."
msgstr "ឆានែល​ទិន្នន័យ​ដែល​មាន​សុវត្ថិភាព​ជាមួយ %1 ប៊ីត SSL ។"

#: engine/ftpsocket.cpp:1028
#, kde-format
msgid "Failed to establish a data connection (%1.)"
msgstr "បាន​បរាជ័យ​ទៅ​បង្កើត​ការ​តភ្ជាប់​ទិន្នន័យ (%1 ។)"

#: engine/ftpsocket.cpp:1035 engine/ftpsocket.cpp:2471
#: engine/ftpsocket.cpp:2481 engine/ftpsocket.cpp:2638
#: engine/ftpsocket.cpp:2648
#, kde-format
msgid "Transfer completed."
msgstr "បាន​បញ្ចប់​ទាំងស្រុង​ការ​ផ្ទេរ​ ។​"

#: engine/ftpsocket.cpp:1050
#, kde-format
msgid "Data connection closed."
msgstr "បាន​បិទ​ការ​តភ្ជាប់​ទិន្នន័យ​ ។"

#: engine/ftpsocket.cpp:1218 engine/sftpsocket.cpp:386
#, kde-format
