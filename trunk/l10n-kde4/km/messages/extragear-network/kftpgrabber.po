#: engine/sftpsocket.cpp:234
#, kde-format
msgid "Authentication succeeded."
msgstr "បាន​ជោគជ័យ​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ ។"

#: engine/sftpsocket.cpp:236 engine/sftpsocket.cpp:237
#, kde-format
msgid "No authentication methods available."
msgstr "គ្មាន​វិធីសាស្ត្រ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដែល​អាច​រក​បាន​ឡើយ ។"

#: engine/sftpsocket.cpp:252
#, kde-format
msgid "Unable to initialize SFTP channel."
msgstr "មិន​អាច​​​ចាប់ផ្ដើម​ឆានែល​របស់​ SFTP បាន​ឡើយ​ ។"

#: engine/sftpsocket.cpp:253
#, kde-format
msgid "SFTP initialization has failed."
msgstr "បាន​បរាជ័យ​ការ​ចាប់ផ្ដើម SFTP ។"

#: engine/sftpsocket.cpp:312
#, kde-format
msgid "Connected with server, stand by for authentication..."
msgstr "បាន​តភ្ជាប់​ជាមួយ​ម៉ាស៊ីន​បម្រើ​ ទ្រទ្រង់​ ​សម្រាប់​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ..."

#: engine/sftpsocket.cpp:717 engine/sftpsocket.cpp:985
#, kde-format
msgid "Transfer has failed."
msgstr "ការ​ផ្ទេរ​បាន​បរាជ័យ​ ។"

#: engine/socket.cpp:133
#, kde-format
msgid "Disconnected."
msgstr "បាន​ផ្ដាច់ ។"

#: engine/socket.cpp:173
#, kde-format
msgid "Connection timed out."
msgstr "អស់​ពេល​ការ​តភ្ជាប់ ។"

#: engine/socket.cpp:502 engine/socket.cpp:538
#, kde-format
msgid "Scan complete."
msgstr "បញ្ចប់​ការ​វិភាគ​រក ។"

#: engine/socket.cpp:552
#, kde-format
msgid "Starting recursive directory scan..."
msgstr "កំពុង​ចាប់ផ្ដើម​​​វិភាគ​រក​​ថត​ដែល​សរសេរ​ជាន់​គ្នា​ឡើងវិញ​..."

