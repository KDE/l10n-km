#: src/presenceapplet.cpp:119
msgid "More"
msgstr "ច្រើន​ទៀត"

#: src/presenceapplet.cpp:121
msgid "Online"
msgstr "លើបណ្ដាញ"

#: src/presenceapplet.cpp:122
msgid "Busy"
msgstr "រវល់"

#: src/presenceapplet.cpp:123
msgid "Away"
msgstr "ចាកឆ្ងាយ"

#: src/presenceapplet.cpp:124
msgid "Not Available"
msgstr "មិន​ទំនេរ"

#: src/presenceapplet.cpp:125
msgid "Invisible"
msgstr "មើល​មិនឃើញ"

#: src/presenceapplet.cpp:126
msgid "Offline"
msgstr "ក្រៅ​បណ្ដាញ"

#: src/presenceapplet.cpp:136
msgid "Account Manager"
msgstr "កម្មវិធី​គ្រប់គ្រង​គណនី"

#: src/presenceapplet.cpp:137
msgid "Contact List"
msgstr "បញ្ជី​ទំនាក់ទំនង"

#: src/presenceapplet.cpp:138
msgid "Add New Contacts"
msgstr "បន្ថែម​ទំនាក់ទំនង​ថ្មី"

#: src/presenceapplet.cpp:201
msgid ""
"Seems like you forgot to select an account. Also do not forget to connect it "
"first."
msgstr "ហាក់​បី​ដូច​ជា​អ្នក​ភ្លេច​ជ្រើស​គណនី ។ ហើយ​កុំ​ភ្លេច​តភ្ជាប់​វា​សិន ។"

#: src/presenceapplet.cpp:202
msgid "No Account Selected"
msgstr "គ្មាន​គណនី​បាន​ជ្រើស​ទេ"

#: src/presenceapplet.cpp:205
msgid ""
"An error we did not anticipate just happened and so the contact could not be "
"added. Sorry."
msgstr "កំហុស​មួយ​ដែល​យើង​មិន​រំពឹង​ទុក​បានកើតឡើង ហើយ​ដូច្នេះ​មិន​អាច​បន្ថែម​កា​រតភ្ជាប់បាន​ទេ សូម​ទោស ។"

#: src/presenceapplet.cpp:206
msgid "Account Error"
msgstr "កំហុស​គណនី"

#: src/presenceapplet.cpp:256
msgid "Connecting..."
msgstr "កំពុង​តភ្ជាប់..."
