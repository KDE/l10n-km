#: twitter.cpp:234
msgid "Failed to access kwallet. Store password in config file instead?"
msgstr ""
"បានបរាជ័យ​ក្នុង​ការ​ចូល​ដំណើរការ kwallet ។ ទុក​ពាក្យ​សម្ងាត់​របស់​នៅ​ក្នុង​ឯកសារ config ជំនួស​វិញ​ឬ ?"

#: twitter.cpp:254 twitter.cpp:599
msgid "Refreshing timeline..."
msgstr "កំពុង​ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់..."

#: twitter.cpp:273
#, kde-format
msgid "%1 new tweets"
msgstr "tweets ថ្មី %1"

#: twitter.cpp:385
#, kde-format
msgid " from %1"
msgstr " ពី %1"

#: twitter.cpp:388
#, kde-format
msgid ""
"<tr><td align='left' width='1%'><font color='%2'>%1</font></td><td "
"align='right' width='auto'><p align='right'><font color='%2'>%3%4</font></"
"p></td></tr>"
msgstr ""
"<tr><td align='left' width='1%'><font color='%2'>%1</font></td><td "
"align='right' width='auto'><p align='right'><font color='%2'>%3%4</font></"
"p></td></tr>"

#: twitter.cpp:426
msgid " tweets"
msgstr " tweets"

#: twitter.cpp:428
msgid " minutes"
msgstr " នាទី"

#: twitter.cpp:431
msgid "User name:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: twitter.cpp:432
msgid "Password:"
msgstr "ពាក្យ​សម្ងាត់ ៖"

#: twitter.cpp:433
msgid "Timeline size:"
msgstr "ទំហំ​បន្ទាត់​ពេលវេលា ៖"

#: twitter.cpp:434
msgid "Timeline refresh:"
msgstr "ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់ ៖"

#: twitter.cpp:435
msgid "Show messages of friends:"
msgstr "បង្ហាញ​សារ​របស់​មិត្តភ័ក្រ ៖"

#: twitter.cpp:636
msgid "1 minute ago"
msgstr "១ នាទី​កន្លង​ទៅ"

#: twitter.cpp:638
#, kde-format
msgid "%1 minutes ago"
msgstr "%1 កន្លង​ទៅ"

#: twitter.cpp:640
msgid "1 hour ago"
msgstr "១ ម៉ោង​កន្លង​ទៅ"

#: twitter.cpp:642
#, kde-format
msgid "%1 hours ago"
msgstr "%1 កន្លង​ទៅ"
