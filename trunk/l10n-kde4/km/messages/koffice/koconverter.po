#: koconverter.cpp:63
msgid "KOConverter"
msgstr "KOConverter"

#: koconverter.cpp:64
msgid "KOffice Document Converter"
msgstr "កម្មវិធី​បម្លែង​ឯកសារ​របស់​ KOffice"

#: koconverter.cpp:66
msgid "(c) 2001-2004 KOffice developers"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០១-២០០៤ អ្នក​អភិវឌ្ឍន៍ KOffice"

#: koconverter.cpp:67
msgid "David Faure"
msgstr "David Faure"

#: koconverter.cpp:68
msgid "Nicolas Goutte"
msgstr "Nicolas Goutte"

#: koconverter.cpp:72
msgid "Input file"
msgstr "ឯកសារ​បញ្ចូល"

#: koconverter.cpp:73
msgid "Output file"
msgstr "ឯកសារ​លទ្ធផល"

#: koconverter.cpp:74
msgid "Make a backup of the destination file"
msgstr "ធ្វើ​ការ​បម្រុង​ទុកឯកសារ​ទិសដៅ"

#: koconverter.cpp:75
msgid "Batch mode: do not show dialogs"
msgstr "របៀបបាច់ ៖ កុំបង្ហាញ​ប្រអប់​"

#: koconverter.cpp:76
msgid "Interactive mode: show dialogs (default)"
msgstr "របៀប​អន្តរកម្ម ៖ បង្ហាញ​ប្រអប់​ (លំនាំដើម)"

#: koconverter.cpp:77
msgid "Mimetype of the output file"
msgstr "ប្រភេទ Mime របស់ឯកសារ​លទ្ធផល"

#: koconverter.cpp:117
#, kde-format
msgid "Mimetype for input file %1 not found!"
msgstr "រក​មិន​ឃើញ​ប្រភេទ Mime សម្រាប់​ឯកសារ %1 !"

#: koconverter.cpp:127
#, kde-format
msgid "Mimetype not found %1"
msgstr "រក​មិន​ឃើញ​ប្រភេទ Mime %1"

#: koconverter.cpp:136
msgid "Mimetype not found, try using the -mimetype option"
msgstr "រក​មិនឃើញ​ប្រភេទ Mime ព្យាយាម​ប្រើ -ជម្រើស​ប្រភេទ mime"

#: koconverter.cpp:150
msgid "*** The conversion failed! ***"
msgstr "*** ការ​បម្លែង​បាន​បរាជ័យ ! ***"

#: koconverter.cpp:155
msgid "Two arguments required"
msgstr "ត្រូវ​ការ​អាគុយម៉ង់ពីរ"
