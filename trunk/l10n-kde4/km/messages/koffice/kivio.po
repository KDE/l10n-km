#: plugins/kiviozoomtool/tool_zoom.cpp:44
msgid "By pressing this button you can zoom in on a specific area."
msgstr "ដោយ​ចុច​ប៊ូតុង​នេះ អ្នក​អាច​បង្រួម​តំបន់​ជាក់លាក់​ណា​មួយ ។"

