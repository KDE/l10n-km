#: plugins/kiviozoomtool/tool_zoom.cpp:74
msgid "The Zoom Page button shows the entire page."
msgstr "ប៊ូតុង​ពង្រីកទំព័រ នឹង​បង្ហាញ​ទំព័រ​ទាំងមូល ។"

#: plugins/kiviozoomtool/tool_zoom.cpp:77
msgid "Zoom Selected"
