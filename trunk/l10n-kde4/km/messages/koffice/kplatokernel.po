msgid "Calculated expected estimate"
msgstr "ការ​វាយតម្លៃ​ដែលគិតទុក​ដែល​បានគណនា"

#: kptglobal.cpp:79
msgid "Calculated estimate variance"
msgstr "វ៉ារ្យង់​វាយតម្លៃ​ដែល​បានគណនា"

#: kptglobal.cpp:80 kptglobal.cpp:85
msgid "Optimistic estimate"
msgstr "ការ​វាយតម្លៃ​សុទិដ្ឋិនិយម"

#: kptglobal.cpp:81 kptglobal.cpp:86
msgid "Pessimistic estimate"
msgstr "ការ​វាយតម្លៃ​ទុទិដ្ឋិនិយម"

#: kptglobal.cpp:82
msgid "Type of estimate"
msgstr "ប្រភេទ​វាយតម្លៃ"

#: kptglobal.cpp:83
msgid "The calendar used when estimate type is Length"
msgstr "ប្រតិទិន​បានប្រើនៅពេល​ប្រភេទ​វាយតម្លៃ​គឺ​ជា​ប្រវែង"

#: kptglobal.cpp:84
msgid "The most likely estimate"
msgstr "ការ​វាយតម្លៃ​​ស្រដៀង​បំផុត"

#: kptglobal.cpp:87
msgid "Type of risk"
msgstr "ប្រភេទ​គ្រោះថ្នាក់"

