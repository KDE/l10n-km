#: kptglobal.cpp:70
msgid "Planned cost"
msgstr "តម្លៃ​ដែល​បាន​គ្រោង​ទុក"

#: kptglobal.cpp:71
msgid "Actual cost"
msgstr "តម្លៃ​ជាក់លាក់"

#: kptglobal.cpp:72
msgid "Time when task was actually started"
msgstr "ពេលវេលា​នៅ​ពេល​ភារកិច្ច​ត្រូវ​បាន​ចាប់ផ្ដើម​​យ៉ាង​ជាក់លាក់"

#: kptglobal.cpp:73
msgid "Shows if the task is started"
msgstr "បង្ហាញ​បើ​ភារកិច្ច​ចាប់ផ្ដើម"

#: kptglobal.cpp:74
msgid "Time when task was actually finished"
msgstr "ពេលវេលា​នៅពេល​ភារកិច្ច​ត្រូវ​បានបញ្ចប់​យ៉ាង​ជាក់លាក់"

#: kptglobal.cpp:75
msgid "Shows if the task is finished"
msgstr "បង្ហាញ​បើ​ភារកិច្ច​បញ្ចប់"

#: kptglobal.cpp:76
msgid "Status Note"
msgstr "ចំណាំ​ស្ថានភាព"

