msgid "The node has not been scheduled"
msgstr "ថ្នាំង​មិន​ត្រូវ​បានកំណត់​កាលវិភាគ"

#: kptglobal.cpp:90
msgid "An effort has been estimated, but no resource has been assigned"
msgstr "កិច្ចប្រឹងប្រែង​ត្រូវ​បានវាយតម្លៃ ប៉ុន្តែ​គ្មាន​ធនធាន​ត្រូវ​បានផ្ដល់"

#: kptglobal.cpp:91
msgid "A resource assigned to this task is overbooked"
msgstr "ធនធាន​បានផ្ដល់​ទៅ​ភារកិច្ច​នេះ​លើស​កម្រិត"

#: kptglobal.cpp:92
msgid "A resource assigned to this task is not available"
msgstr "ធនធាន​បាន​ផ្ដល់​ទៅ​ភារកិច្ច​នេះ​មិន​ត្រឹមត្រូវ​ទេ"

#: kptglobal.cpp:93
msgid "A timing constraint could not be met"
msgstr "ការបង្គាប់​ពេលវេលា​មិន​អាច​ត្រូវ​បាន​បំពេញ"

#: kptglobal.cpp:94
msgid "The assigned resource could not meet the estimated effort"
msgstr "ធនធាន​ដែល​បានផ្ដល់​មិន​​បំពេញ​​កិច្ចប្រឹងប្រែង​ដែល​បាន​វាយ​តម្លៃ"

#: kptglobal.cpp:96
msgid "Budgeted Cost of Work Scheduled"
msgstr "តម្លៃ​គ្រោងទុក​នៃ​ការងារ​ដែល​បានកំណត់​ពេល"

#: kptglobal.cpp:97
msgid "Budgeted Cost of Work Performed"
msgstr "តម្លៃ​ដែល​បានគ្រោងទុក​នៃ​ការងារ​ដែល​បាន​អនុវត្ត"

#: kptglobal.cpp:98
msgid "Actual Cost of Work Performed"
msgstr "តម្លៃ​ពិតប្រាក​នៃ​ការ​ងារ​ដែល​បាន​អនុវត្ត"

#: kptglobal.cpp:99
msgid "Schedule performance index (BCWP/BCWS)"
msgstr "លេបិក្រម​អនុវត្ត​កាលវិភាព (BCWP/BCWS)"

#: kptglobal.cpp:101
msgid "The name of the resource or resource group"
msgstr "ឈ្មោះ​របស់​ធនធាន ឬ​ក្រុម​ធនធាន"

#: kptglobal.cpp:102
msgid "The type of the resource or resource group"
msgstr "ប្រភេទ​របស់​ធនធាន ឬ​ក្រុម​ធនធាន"

#: kptglobal.cpp:103
msgid "The initials of the resource"
msgstr "អាទិសង្កេត​របស់​ធនធាន"

#: kptglobal.cpp:104
msgid "The e-mail address of the resource"
msgstr "អាសយដ្ឋាន​អ៊ីមែល​របស់​ធនធាន"

#: kptglobal.cpp:105
msgid "The calendar defines when the resource is working"
msgstr "ប្រតិទិន​កំណត់​នៅពេល​ធនធាន​កំពុងធ្វើការ"

#: kptglobal.cpp:106
msgid "The maximum load that can be assigned"
msgstr "កា​រផ្ទុក​អតិបរមា ដែល​អាច​ត្រូវ​បានផ្ដល់"

#: kptglobal.cpp:107 kptglobal.cpp:108
msgid "Defines when the resource is available to the project"
msgstr "កំណត់​នៅពេល​​គ្រោង​អាច​ប្រើ​ធនធាន​បាន"

#: kptglobal.cpp:109
msgid "The cost pr hour, normal hours"
msgstr "តម្លៃ​ក្នុង​ម៉ោង ម៉ោង​ធម្មតា"

#: kptglobal.cpp:110
msgid "The cost pr hour, overtime hours"
msgstr "តម្លៃ​ក្នុង​ម៉ោង​ លើស​ម៉ោង"

#: kptglobal.cpp:111
msgid "The fixed cost"
msgstr "តម្លៃ​ថេរ"

#: kptglobal.cpp:113
msgid "The name of the account"
msgstr "ឈ្មោះ​របស់​គណនី"

#: kptglobal.cpp:114
msgid "The description of the account"
msgstr "សេចក្ដី​ពិពណ៌នា​របស់​គណនី"

#: kptglobal.cpp:116
msgid "The name of the schedule"
msgstr "ឈ្មោះ​របស់​កាលវិភាគ"

#: kptglobal.cpp:117
msgid "The schedules state"
msgstr "ស្ថានភាព​កាលវិភាគ"

#: kptglobal.cpp:118
msgid "Controles resource overbooking when scheduling"
msgstr "ត្រួតពិនិត្យ​ធនធាន​លើស​នៅ​ពេល​គ្រោង​"

