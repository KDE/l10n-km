#: imapaccount.cpp:192
#, kde-format
msgid ""
"You requested TLS/SSL to connect to %1, but your system does not seem to be "
"set up for that."
msgstr ""
"អ្នក​បាន​ស្នើ​ឲ្យ TLS/SSL តភ្ជាប់​ទៅកាន់ %1 ប៉ុន្តែ​ប្រព័ន្ធ​របស់​អ្នក​មិន​ត្រូវបាន​ដំឡើង​សម្រាប់​ធ្វើ​ដូចនោះ​"
"ទេ ។"

#: imapaccount.cpp:237
#, kde-format
msgid ""
"Could not connect to the IMAP-server %1.\n"
"%2"
msgstr ""
"មិនអាច​តភ្ជាប់​ទៅ​កាន់​ម៉ាស៊ីនបម្រើ IMAP %1.\n"
"%2 បាន​ទេ"

#: imapaccount.cpp:263
#, kde-format
msgid "Could not test the capabilities supported by the IMAP server %1."
msgstr "មិនអាច​សាកល្បង​ភាព​ឆប​គ្នា​ដែល​បាន​គាំទ្រ​ដោយ​ម៉ាស៊ីន​បម្រើ IMAP %1 ។"

#: imapaccount.cpp:290
#, kde-format
msgid ""
"Cannot use the IMAP server %1, some mandatory capabilities are missing: %2. "
"Please ask your sysadmin to upgrade the server."
msgstr ""
"មិនអាច​ប្រើ​ម៉ាស៊ីន​បម្រើ IMAP %1 ទេ ភាព​ឆប​ដែល​ចាំបាច់​មួយ​ចំនួន គឺ​បាត់ ៖ %2 ។ សូម​សួរ​​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​"
"របស់​អ្នក ដើម្បី​ធ្វើ​ឲ្យ​ម៉ាស៊ីន​បម្រើ​របស់​អ្នក​ប្រសើរ​ឡើង ។"

#: imapresource.cpp:166 imapresource.cpp:606 imapresource.cpp:805
msgid "There is currently no connection to the IMAP server."
msgstr "បច្ចុប្បន្ន​មិនមាន​ការ​តភ្ជាប់​ទៅកាន់​ម៉ាស៊ីនបម្រើ IMAP នោះ​ទេ ។"

#: imapresource.cpp:229
msgid "No message retrieved, server reply was empty."
msgstr "មិន​ទទួល​បាន​សារ​ទេ ចម្លើយ​ម៉ាស៊ីន​បម្រើ​គឺ​ទទេ ។"

#: imapresource.cpp:257
msgid "No server configured yet."
msgstr "គ្មាន​ម៉ាស៊ីន​បម្រើ​ត្រូវបានកំណត់​រចនាសម្ព័ន្ធ​នៅ​ឡើយ​ទេ ។"

#: imapresource.cpp:276
msgid "Could not read the password: user rejected wallet access."
msgstr "មិនអាច​អាន​ពាក្យ​សម្ងាត់​បាន​ទេ ៖ អ្នកប្រើបាន​ច្រាន​ការ​ចូល​ដំណើរការ​កាបូប​ចោល ។"

#: imapresource.cpp:279
msgid "Authentication failed."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ។"

#: imapresource.cpp:486
msgid "Cannot move message, it does not exist on the server."
msgstr "មិនអាច​ផ្លាស់ទី​សារ​បានទេ វា​មិនមាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទេ ។"

#: imapresource.cpp:492
#, kde-format
msgid "Cannot move message out of '%1', '%1' does not exist on the server."
msgstr "មិនអាច​ផ្លាស់ទី​សារ​ចេញ​ពី '%1' បាន​ទេ '%1' មិន​ទាន់មាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទេ ។"

#: imapresource.cpp:499
#, kde-format
msgid "Cannot move message to '%1', '%1' does not exist on the server."
msgstr "មិនអាច​ផ្លាស់ទី​សារ​ទៅ '%1' ដោយ​សារ​តែ '%1' មិន​ទាន់មាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​នៅ​ឡើយ​ទេ ។"

#: imapresource.cpp:543
#, kde-format
msgid ""
"Failed to move message out of '%1' on the IMAP server. Could not select '%1'."
msgstr ""
"បាន​បរាជ័យ​ក្នុងកា​រផ្លាស់ទី​សារ​ចេញ​ពី '%1' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។ មិន​អាច​ជ្រើស '%1' បាន​ទេ ។"

#: imapresource.cpp:578
#, kde-format
msgid ""
"Failed to move message to '%1' on the IMAP server. Could not copy into '%1'."
msgstr ""
"បាន​បរាជ័យ​ក្នុងការ​ផ្លាស់ទី​សារ​ទៅ​កាន់ '%1' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។ មិនអាច​ចម្លង​ទៅ​ក្នុង '%1' បាន​"
"ទេ ។"

#: imapresource.cpp:591
#, kde-format
msgid ""
"Failed to mark the message from '%1' for deletion on the IMAP server. It "
"will reappear on next sync."
msgstr ""
"បាន​បរាជ័យ​ក្នុងការ​សម្គាល់​សារ​ពី '%1' សម្រាប់​លុប​នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។ វា​នឹង​បង្ហាញ​ឡើង​វិញ​នៅ​​ពេល​"
"ធ្វើសមកាលកម្ម​បន្ទាប់ ។"

#: imapresource.cpp:701
msgid "Inbox"
msgstr "ប្រអប់​ទទួល"

#: imapresource.cpp:718
msgid "Shared Folders"
msgstr "ថត​រួម"

#: imapresource.cpp:943
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr "មិនអាច​បន្ថែម​ថត IMAP '%1' សម្រាប់​ថត​មេ​ដែល​មិនទាន់​មាន​បាន​ទេ '%2' ។"

#: imapresource.cpp:978
#, kde-format
msgid "Failed to create folder '%1' on the IMAP server."
msgstr "បាន​បរាជ័យ​ក្នុងការ​បង្កើត​ថត '%1' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។"

#: imapresource.cpp:989
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr "មិន​អាច​កែប្រែ​ថត IMAP '%1' បាន​ទេ វា​មិនទាន់មាន​នៅ​លើម៉ាស៊ីនបម្រើ​ទេ ។"

#: imapresource.cpp:1040
#, kde-format
msgid ""
"ACLs for '%1' need to be retrieved from the IMAP server first. Skipping ACL "
"change"
msgstr "ACLs សម្រាប់ '%1' តម្រូវ​ឲ្យ​ទៅ​យក​ពី​ម៉ាស៊ីន​បម្រើ IMAP សិន ។ រំលង​ការ​ផ្លាស់ប្ដូរ ACL"

#: imapresource.cpp:1202
msgid "Failed to rename the folder, restoring folder list."
msgstr "បរាជ័យ​ក្នុង​ការ​ប្ដូរ​ឈ្មោះ​ថត ដោយ​ស្ដារ​បញ្ជី​ថត​ឡើងវិញ ។"

#: imapresource.cpp:1213
#, kde-format
msgid "Failed to write the new ACLs for '%1' on the IMAP server. %2"
msgstr "បានបរាជ័យ​ក្នុងការ​សរសេរ​ ACLs ថ្មី​សម្រាប់ '%1' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។ %2"

#: imapresource.cpp:1228
#, kde-format
msgid "Failed to write the new annotations for '%1' on the IMAP server. %2"
msgstr "បាន​បរាជ័យ​ក្នុងការ​សរសេរ​ចំណារ​ថ្មី​សម្រាប់ '%1' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។ %2"

#: imapresource.cpp:1256
msgid "Failed to delete the folder, restoring folder list."
msgstr "បរាជ័យ​ក្នុង​ការ​លុប​ថត ស្ដារ​បញ្ជី​ថត​ឡើងវិញ ។"

#: imapresource.cpp:1269
#, kde-format
msgid "Cannot move IMAP folder '%1', it does not exist on the server."
msgstr "មិនអាច​ផ្លាស់ទី​ថត IMAP '%1' បាន​ទេ វា​មិនមាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទេ ។"

#: imapresource.cpp:1276
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' out of '%2', '%2' does not exist on the server."
msgstr ""
"មិនអាច​ផ្លាស់ទី​ថត IMAP '%1' ចេញ​ពី '%2' បាន​ទេ ដោយសារតែ '%2' មិន​ទាន់​មាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទេ ។"

#: imapresource.cpp:1284
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' to '%2', '%2' does not exist on the server."
msgstr ""
"មិនអាច​ផ្លាស់ទី​ថត IMAP '%1' ទៅ '%2' បានទេ ដោយ​សារ​តែ '%2' មិន​ទាន់មាន​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ទេ ។"

#: imapresource.cpp:1321
#, kde-format
msgid "Failed to move folder '%1' out of '%2' on the IMAP server."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ផ្លាស់ទី​ថត '%1' ចេញ​ពី '%2' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។"

#: imapresource.cpp:1331
#, kde-format
msgid "Failed to subscribe to the newly moved folder '%1' on the IMAP server."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ជាវ​ទៅកាន់​ថត​ដែល​បាន​ផ្លាស់ទី​ថ្មីៗ '%1' នៅ​លើ​ម៉ាស៊ីន​បម្រើ IMAP ។"

#: imapresource.cpp:1349
#, kde-format
msgid ""
"The server refused the supplied username and password. Do you want to go to "
"the settings, have another attempt at logging in, or do nothing?\n"
"\n"
"%1"
msgstr ""
"ម៉ាស៊ីន​បម្រើ​បាន​បដិសេធ​ឈ្មោះ​អ្នកប្រើ និង​ពាក្យ​សម្ងាត់​ដែល​បានផ្ដល់ ។ តើ​អ្នក​ចង់​ចូល​ទៅ​កាន់​ការ​កំណត់ ដែល​មាន​"
"ការ​ប៉ុនប៉ង​ផ្សេង​ទៀត​នៅពេល​ចូល ឬ​មិនធ្វើ​អ្វី​ទាំង​អស់ ?\n"
"\n"
"%1"

#: imapresource.cpp:1353
msgid "Could Not Authenticate"
msgstr "មិនអាច​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​បានទេ"

#: imapresource.cpp:1354
msgid "Settings"
msgstr "ការ​កំណត់"

#: imapresource.cpp:1355
msgctxt "Input username/password manually and not store them"
msgid "Single Input"
msgstr "ព័ត៌មាន​បញ្ចូល​ទោល"

#: imapresource.cpp:1365
#, kde-format
msgid "Could not connect to the IMAP-server %1."
msgstr "មិនអាច​តភ្ជាប់​ទៅកាន់​ម៉ាស៊ីន​បម្រើ IMAP %1 ទេ ។"

#: imapresource.cpp:1379
msgid "Connection established."
msgstr "បាន​បង្កើត​ការ​តភ្ជាប់ ។"

#. i18n: file: imapresource.kcfg:10
#. i18n: ectx: label, entry (ImapServer), group (network)
#: rc.cpp:3
msgid "IMAP server"
msgstr "ម៉ាស៊ីន​បម្រើ IMAP"

#. i18n: file: imapresource.kcfg:13
#. i18n: ectx: label, entry (ImapPort), group (network)
#: rc.cpp:6
msgid "Defines the port the IMAP service is running on"
msgstr "កំណត់​ច្រក​សេវា IMAP ដែលកំពុង​តែ​រត់"

#. i18n: file: imapresource.kcfg:17
#. i18n: ectx: label, entry (UserName), group (network)
#: rc.cpp:9
msgid "Username"
msgstr "ឈ្មោះ​អ្នកប្រើ"

#. i18n: file: imapresource.kcfg:20
#. i18n: ectx: label, entry (Safety), group (network)
#: rc.cpp:12
msgid "Defines the encryption type to use"
msgstr "កំណត់​ប្រភេទ​ការ​អ៊ិនគ្រីប​ដើម្បី​ប្រើ"

#. i18n: file: imapresource.kcfg:24
#. i18n: ectx: label, entry (Authentication), group (network)
#: rc.cpp:15
msgid "Defines the authentication type to use"
msgstr "កំណត់​ប្រភេទ​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដែល​ត្រូវ​ប្រើ"

#. i18n: file: imapresource.kcfg:28
#. i18n: ectx: label, entry (SubscriptionEnabled), group (network)
#: rc.cpp:18
msgid "Defines if the server side subscription is enabled"
msgstr "កំណត់ ប្រសិន​បើ​បាន​អនុញ្ញាត​ការ​ជាវ​ជា​ប្រចាំ​នៅ​ផ្នែក​ម៉ាស៊ីន​បម្រើ"

#. i18n: file: imapresource.kcfg:34
#. i18n: ectx: label, entry (DisconnectedModeEnabled), group (cache)
#: rc.cpp:21
msgid "Defines if all the IMAP data should be cached locally all the time"
msgstr "កំណត់ ប្រសិនបើ​ទិន្នន័យ IMAP ទាំង​អស់​គួរ​ត្រូវ​បាន​ដាក់ជា​ឃ្លាំង​សម្ងាត់​ក្នុង​មូលដ្ឋាន​គ្រប់ពេល"

#. i18n: file: imapresource.kcfg:38
#. i18n: ectx: label, entry (IntervalCheckEnabled), group (cache)
#: rc.cpp:24
msgid "Defines if interval checking is enabled."
msgstr "កំណត់​ ប្រសិនបើ​ចន្លោះ​ពេល​ត្រួតពិនិត្យ​ត្រូវ​បានបើក ។"

#. i18n: file: imapresource.kcfg:42
#. i18n: ectx: label, entry (IntervalCheckTime), group (cache)
#: rc.cpp:27
msgid "Check interval in minutes"
msgstr "ពិនិត្យ​មើល​ចន្លោះ​ពេល​គិត​ជា​នាទី"

#. i18n: file: imapresource.kcfg:46
#. i18n: ectx: label, entry (IncludeInManualCheck), group (cache)
#: rc.cpp:30
msgid "Whether to include the account in the manual mail check operation."
msgstr "ថាតើ​ត្រូវ​រួម​បញ្ចូល​គណនី​នៅ​ក្នុង​ប្រតិបត្តិការ​ពិនិត្យ​មើល​សំបុត្រ​ដោយ​ដៃដែរឬទេ ។"

#. i18n: file: imapresource.kcfg:51
#. i18n: ectx: label, entry (RetrieveMetadataOnFolderListing), group (cache)
#: rc.cpp:33
msgid ""
"Defines if the annotations, ACLs and quota information of mailboxes should\n"
"             also be retrieved when the mailboxes get listed."
msgstr ""
"កំណត់ ប្រសិនបើ​ចំណា ACLs និង​ព័ត៌មានកូតា​របស់​ប្រអប់​សំបុត្រគួរ​ត្រូ​វបាន​\n"
"​ទៅ​យក​នៅពេល​ប្រអប់​សំបុត្រ​ត្រូ​វបាន​រាយ ។"

#. i18n: file: imapresource.kcfg:56
#. i18n: ectx: label, entry (AutomaticExpungeEnabled), group (cache)
#: rc.cpp:37
msgid ""
"Defines if the expunge command is issued automatically, otherwise it should "
"be\n"
"             triggered manually through the D-Bus interface."
msgstr ""
