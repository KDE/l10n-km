#: kmobile.cpp:334
msgid ""
"<qt>You have no mobile devices configured yet.<p>Do you want to add a device "
"now ?</qt>"
msgstr ""
"<qt>អ្នក​មិន​ទាន់​បាន​កំណត់​រចនាសម្ព័ន្ធ​ឧបករណ៍​ចល័ត​នៅ​ឡើយ​ទេ ។<p>តើ​អ្នក​ចង់​បន្ថែម​ឧបករណ៍​មួយ ឥឡូវ​ឬ​ទេ ?</"
"qt>​"

