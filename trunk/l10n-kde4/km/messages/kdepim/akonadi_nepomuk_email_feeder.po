msgstr "Nepomuk មិន​ប្រតិបត្តិទេ"

#: shared/nepomukfeederagentbase.cpp:407
msgid "Nepomuk Indexing Disabled"
msgstr "បានបិទ​ការ​ដាក់​លិបិក្រម Nepomuk"

#: shared/nepomukfeederagentbase.cpp:467
msgid "Strigi is not available for indexing."
msgstr "Strigi មិនអាច​ប្រើបាន​សម្រាប់​ដាក់​លិបិក្រម​ទេ ។"

#: shared/nepomukfeederagentbase.cpp:516
#, fuzzy
