#: shared/nepomukfeederagentbase.cpp:228
#, kde-format
msgid "Indexing collection '%1'..."
msgstr "កំពុង​ដាក់​លិបិក្រម​សម្រាំង '%1'..."

#: shared/nepomukfeederagentbase.cpp:281
msgid "Indexing completed."
msgstr "បាន​បញ្ចប់​ការ​ដាក់​លិបិក្រម ។"

#: shared/nepomukfeederagentbase.cpp:339
msgid "Unable to start the Nepomuk server."
msgstr "មិនអាច​ចាប់ផ្ដើម​ម៉ាស៊ីនបម្រើ Nepomuk បាន​ទេ ។"

#: shared/nepomukfeederagentbase.cpp:345 shared/nepomukfeederagentbase.cpp:366
msgid "Waiting for the Nepomuk server to start..."
msgstr "កំពុង​រង់ចាំ​ម៉ាស៊ីនបម្រើ Nepomuk ចាប់ផ្ដើម..."

#: shared/nepomukfeederagentbase.cpp:359
#, kde-format
msgid "A blacklisted backend is used: '%1'."
msgstr "កម្មវិធី​ផ្នែក​ខាងក្រោយ​ដែលបាន​ដាក់​ក្នុង​បញ្ជីខ្មៅ​ត្រូ​វបាន​​ប្រើ ៖ '%1' ។"

#: shared/nepomukfeederagentbase.cpp:361
#, kde-format
msgid "Calling the Nepomuk storage service failed: '%1'."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ហៅ​សេវា​ផ្ទុក​របស់ Nepomuk ៖ '%1' ។"

#: shared/nepomukfeederagentbase.cpp:369
msgid "Nepomuk is not running."
msgstr "Nepomuk មិន​កំពុង​ដំណើរការ​ទេ ។"

#: shared/nepomukfeederagentbase.cpp:376
msgid "Nepomuk backend for Strigi is not available."
msgstr "កម្មវិធី​ផ្នែក​ខាងក្រោយ Nepomuk សម្រាប់ Strigi មិនអាច​ប្រើបាន​ទេ ។"

#: shared/nepomukfeederagentbase.cpp:388
msgid "Ready to index data."
msgstr "រួចរាល់​ដើម្បី​ដាក់​លិបិក្រម​ទិន្នន័យ ។"

#: shared/nepomukfeederagentbase.cpp:395
#, kde-format
msgid ""
"<b>Nepomuk Indexing Agents Have Been Disabled</b><br/>The Nepomuk service is "
"not available or fully operational and attempts to rectify this have failed. "
"Therefore indexing of all data stored in the Akonadi PIM service has been "
"disabled, which will severely limit the capabilities of any application "
"using this data.<br/><br/>The following problems were detected:<ul><li>%1</"
"li></ul>Additional help can be found here: <a href=\"http://userbase.kde.org/"
"Akonadi\">userbase.kde.org/Akonadi</a>"
msgstr ""
"<b>ភ្នាក់ងារ​ដាក់លិបិក្រម​របស់ Nepomuk ត្រូវ​បានបិទ</b><br/>សេវា Nepomuk មិន​អាច​ប្រើ​បាន ឬ​"
"ប្រតិបត្តិការ ឬ​ការ​ប៉ុនប៉ង​ពេញ​ ដើម្បី​កែតម្រូវ​នេះ​បាន​បរាជ័យ ។ ដូច្នេះ​ការ​ដាក់លិបិក្រម​របស់​ទិន្នន័យ​ដែល​បាន​"
"នៅ​ក្នុង​ Akonadi PIM ទាំង​អស់​ត្រូវ​បាន​បិទ ដែល​នឹង​មានដែន​កំណត់​សមត្ថភាព​របស់​កម្មវិធី​ណាមួយ​ដែលប្រើ​​ទិន្នន័យ "
"។<br/><br/>បញ្ហា​ដូច​ខាង​ក្រោម​ត្រូវបាន​រកឃើញ ៖<ul><li>%1</li></ul>ជំនួយ​បន្ថែម​អាច​រក​បាននៅ​"
"ទីនេះ ៖ <a href=\"http://userbase.kde.org/Akonadi\">userbase.kde.org/Akonadi</"
"a>"

#: shared/nepomukfeederagentbase.cpp:404
