#: freebusymanager.cpp:370
#, kde-format
msgid ""
"<qt><p>The software could not upload your free/busy list to the URL '%1'. "
"There might be a problem with the access rights, or you specified an "
"incorrect URL. The system said: <em>%2</em>.</p><p>Please check the URL or "
"contact your system administrator.</p></qt>"
msgstr ""
"<qt><p>កម្មវិធីមិនអាច​ផ្ទុក​បញ្ជី​ទំនេរ/រវល់​របស់​ទៅកាន់ URL '%1' បាន​ទេ ។ ប្រហែលជា​មាន​បញ្ហា​​ចំពោះ​"
"សិទ្ធិ ឬ​អ្នកបាន​បញ្ជាក់ URL មិន​ត្រឹមត្រូវ ។ ប្រព័ន្ធ​ជូន​ដំណឹង ៖ <em>%2</em> ។</p><p>សូម​ពិនិត្យ​មើល "
"URL ឬ​ទាក់ទង​​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​របស់​អ្នក ។</p></qt>"

#: freebusymanager.cpp:540
msgid ""
"<qt><p>No URL configured for uploading your free/busy list. Please set it in "
"KOrganizer's configuration dialog, on the \"Free/Busy\" page.</p><p>Contact "
"your system administrator for the exact URL and the account details.</p></qt>"
msgstr ""
"<qt><p>គ្មាន URL បាន​កំណត់​រចនាសម្ព័ន្ធ​សម្រាប់​បញ្ជី​រវល់/ទំនេរ​របស់​អ្នក​ទេ ។ សូម​កំណត់​វា​នៅ​ក្នុង​ប្រអប់​កំណត់​"
"រចនាសម្ព័ន្ធ​របស់ KOrganizer នៅ​ក្នុង​ទំព័រ​រវល់​/ទំនេរ ។</p><p>ទាក់ទង​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​របស់​អ្នក​"
"ចំពោះ URL ជាក់លាក់ និង​សេចក្ដីលម្អិត​គណនី ។</p></qt>"

