#: kdeaccountsresource.cpp:38
msgid "KDE Accounts"
msgstr "គណនី KDE"

#: kdeaccountsresource.cpp:54
#, kde-format
msgid "Contact with uid '%1' not found."
msgstr "រក​មិនឃើញ​ទំនាក់ទំនង​ជា​មួយ uid '%1' ។"

#: kdeaccountsresource.cpp:68
msgid "Select KDE Accounts File"
msgstr "ជ្រើស​ឯកសារ​គណនីរបស់​ KDE"

#: kdeaccountsresource.cpp:88 kdeaccountsresource.cpp:93
#: kdeaccountsresource.cpp:98
msgid "KDE Accounts file is read-only"
msgstr "ឯកសារ​គណនី KDE គឺ​បាន​តែ​អាន"

#: kdeaccountsresource.cpp:125
#, kde-format
msgid "Unable to open KDE accounts file '%1'."
msgstr "មិនអាច​បើក​ឯកសារ​គណនី KDE '%1' បាន​ទេ ។"

#: kdeaccountsresource.cpp:149
msgid "KDE Project"
msgstr "គម្រោង KDE"

#: kdeaccountsresource.cpp:150
msgid "KDE Developer"
msgstr "អ្នក​អភិវឌ្ឍន៍ KDE"

#. i18n: file: kdeaccountsresource.kcfg:10
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:3
msgid "Path to KDE accounts file."
msgstr "ផ្លូវ​ទៅ​កាន់​ឯកសារ​គណនី KDE ។"

#. i18n: file: kdeaccountsresource.kcfg:14
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:6
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាងក្រោយ​ពិតប្រាកដ ។"

#. i18n: file: kdeaccountsresource.kcfg:18
#. i18n: ectx: label, entry (MonitorFile), group (General)
#: rc.cpp:9
msgid "Monitor file for changes."
msgstr "ត្រួតពិនិត្យ​ឯកសារ​រក​មើល​ការ​ផ្លាស់ប្ដូរ ។"
