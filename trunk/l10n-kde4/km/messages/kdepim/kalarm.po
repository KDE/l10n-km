#: prefdlg.cpp:1200 rc.cpp:295 rc.cpp:661
msgctxt "@label"
msgid "In non-leap years, repeat yearly February 29th alarms on:"
msgstr "ក្នុង​ឆ្នាំ​មិន​បង្គ្រប់ ធ្វើ​ការជូនដំណឹងនៃ​ថ្ងៃ​ទី ២៩ កុម្ភៈ ជារៀងរាល់​ឆ្នាំ​នៅ​ថ្ងៃ ៖"

#: prefdlg.cpp:1209
