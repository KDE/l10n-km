#, kde-format
msgctxt "@info"
msgid "Command to invoke terminal window not found: <command>%1</command>"
msgstr "រក​មិនឃើញ​ពាក្យ​បញ្ជា​ដើម្បី​ហៅ​បង្អួច​ស្ថានីយ​មកប្រើ​ទេ ៖ <command>%1</command>"

