#: kamail.cpp:85
msgctxt "@info/plain"
msgid ""
"A 'From' email address must be configured in order to execute email alarms."
msgstr "អាសយដ្ឋាន​អ៊ីមែល 'ពី' ត្រូវ​តែ​បាន​កំណត់​រចនាសម្ព័ន្ធ ដើម្បី​ប្រតិបត្តិការជូនដំណឹង​​អ៊ីមែល ។"

