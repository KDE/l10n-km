#: kodemain.cpp:572
msgid "KDE Code Generator"
msgstr "កម្មវិធី​បង្កើត​កូដ​របស់ KDE"

#: kodemain.cpp:573
msgid "Cornelius Schumacher"
msgstr "Cornelius Schumacher"

#: kodemain.cpp:579
msgid "Create class"
msgstr "បង្កើត​ថ្នាក់"

#: kodemain.cpp:581
msgid "Create dialog"
msgstr "បង្កើត​ប្រអប់"

#: kodemain.cpp:582
msgid "Create kioslave"
msgstr "បង្កើត kioslave"

#: kodemain.cpp:583
msgid "Create main function template"
msgstr "បង្កើត​ពុម្ព​មុខងារ​ចម្បង"

#: kodemain.cpp:585
msgid "Create generator code for given source"
msgstr "បង្កើត​កូដ​កម្មវិធី​បង្កើត​សម្រាប់​ប្រភព​ដែល​បាន​ផ្ដល់"

#: kodemain.cpp:586
msgid "Add property to class"
msgstr "បន្ថែម​លក្ខណៈសម្បត្តិ​ទៅ​ថ្នាក់"

#: kodemain.cpp:587
msgid "Change file in place"
msgstr "ផ្លាស់ប្ដូរ​ឯកសារ​នៅ​នឹង​កន្លែង"

#: kodemain.cpp:588
msgid "Add author with given email address"
msgstr "បន្ថែម​អ្នកនិពន្ធ​ដែល​មាន​អាសយដ្ឋាន​អ៊ីមែល​ដែល​បានផ្ដល់"

#: kodemain.cpp:589
msgid "Name of project"
msgstr "ឈ្មោះ​គម្រោង"

#: kodemain.cpp:590
msgid "Use GPL as license"
msgstr "ប្រើ GPL ជា​អាជ្ញាបណ្ណ"

#: kodemain.cpp:591
msgid "Use LGPL as license"
msgstr "ប្រើ LGPL ជា​អាជ្ញាបណ្ណ"

#: kodemain.cpp:592
msgid "Name of class"
msgstr "ឈ្មោះ​ថ្នាក់"

#: kodemain.cpp:593
msgid "Name of file"
msgstr "ឈ្មោះ​ឯកសារ"

#: kodemain.cpp:594
msgid "Namespace"
msgstr "ឈ្មោះ​ចន្លោះ"

#: kodemain.cpp:595
msgid "Create warning about code generation"
msgstr "បង្កើត​កា​រព្រមាន​អំពី​កា​របង្កើត​កូដ"

#: kodemain.cpp:596
msgid "Add Qt exception to GPL"
msgstr "បន្ថែម Qt លើកលែង​តែ​ទៅ GPL"

#: kodemain.cpp:597
msgid "Create a singleton class"
msgstr "បង្កើត​ថ្នាក់​តែ​មួយ"

#: kodemain.cpp:598
msgid "kioslave protocol"
msgstr "ពិធីការ​របស់ kioslave"

#: kodemain.cpp:599
msgid "Source code file name"
msgstr "ឈ្មោះ​ឯកសារ​កូដ​ប្រភព"

