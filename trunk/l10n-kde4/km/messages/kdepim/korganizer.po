msgstr "ប្រភេទ​ធាតុ​ដែល​ត្រូវ​ទុក​ក្នុង​ប័ណ្ណសារ"

#: archivedialog.cpp:168
msgctxt "@option:check"
msgid "&Events"
msgstr "ព្រឹត្តិការណ៍"

