#: rc.cpp:483 rc.cpp:1339
msgid "Show to-dos in day, week and month views"
msgstr "បង្ហាញ​ការងារ​ត្រូវ​ធ្វើ ជាទិដ្ឋភាពថ្ងៃ សប្ដាហ៍ និង ខែ​"

#. i18n: tag whatsthis
#. i18n: file korganizer.kcfg line 185
#. i18n: tag whatsthis
#. i18n: file ./korganizer.kcfg line 185
#: rc.cpp:486 rc.cpp:1342
msgid ""
"Check this box to display to-dos in the day, week, and month view. This is "
"helpful when you have a lot of (recurring) to-dos."
msgstr ""
"ធីក​ប្រអប់​នេះ ដើម្បី​បង្ហាញ​ការងារ​ត្រូវ​ធ្វើ ជា​ទិដ្ឋភាពថ្ងៃ សប្ដាហ៍ និង ខែ ។ វា​មាន​ប្រយោជន៍ នៅ​ពេល​"
"អ្នក​មាន​ការងារ​ត្រូវ​ធ្វើ (កើតឡើង​ដដែលៗ) ច្រើន ។"

