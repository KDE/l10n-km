#: mboxresource.cpp:253
msgid ""
"The MBox file was changed by another program. A copy of the new file was "
"made and pending changes are appended to that copy. To prevent this from "
"happening use locking and make sure that all programs accessing the mbox use "
"the same locking method."
msgstr ""
"ឯកសារ MBox ត្រូវបាន​ផ្លាស់ប្ដូរ​ដោយ​កម្មវិធីផ្សេង ។ ច្បាប់​ចម្លង​របស់​ឯកសារ​ថ្មី​ត្រូវ​បាន​ធ្វើ​ឡើង​ ហើយ​នឹង​"
"រង់ចាំ​កា​រផ្លាស់ប្ដូរ​ដែល​នឹង​ត្រូវ​បានបន្ថែម​ទៅ​ច្បាប់​ចម្លង​នោះ ។ ដើម្បីការពារ​មិន​ឲ្យកើត​ឡើង​ ប្រើ​ការ​"
"ចាក់សោ និង​ប្រាកដ​ថា​ក​ម្មវិធី​ទាំងអស់​ចូល​ដំណើរការ​ mbox ដោយ​ប្រើ​វិធីសាស្ត្រ​ចាក់សោ​ដូច​គ្នា ។"

#: mboxresource.cpp:284
#, kde-format
msgid "Failed to save mbox file to %1"
msgstr "បាន​បរាជ័យ​ក្នុងការ​រក្សាទុក​ឯកសារ mbox ទៅ​កាន់ %1"

#: mboxresource.cpp:344
#, kde-format
msgid ""
"Failed to update the changed item because the old item could not be deleted "
"Reason: %1"
msgstr ""
"បាន​បរាជ័យ​ក្នុង​ធ្វើ​បច្ចុប្បន្នភាព​​ធាតុ​ដែល​បាន​ផ្លាស់ប្ដូរ ពីព្រោះ​ធាតុ​ចាស់​មិនអាច​ត្រូវ​បានលុប​ទេ ៖ %1"

