#: configdialog.cpp:35
msgid "Select a MailDir folder"
msgstr "ជ្រើស​ថត MailDir"

#: configdialog.cpp:51
msgid "The selected path is empty."
msgstr "ផ្លូវ​ដែលបាន​ជ្រើស​គឺ​ទទេ ។"

#: configdialog.cpp:65
msgid "The selected path contains valid Maildir folders."
msgstr "ផ្លូវ​ដែល​បាន​ជ្រើស​មាន​ថត Maildir ត្រឹមត្រូវ ។"

#: configdialog.cpp:72
msgid "The selected path is a valid Maildir."
msgstr "ផ្លូវ​ដែលបាន​ជ្រើស​គឺ​ជា Maildir ដែល​ត្រឹមត្រូវ ។"

#: configdialog.cpp:78
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr "ផ្លូវ​ដែលបាន​ជ្រើស​មិន​ទាន់មាននៅ​ឡើយ​ទេ Maildir នឹង​ត្រូវ​បានបង្កើត ។"

#: configdialog.cpp:81
msgid "The selected path does not exist."
msgstr "ផ្លូវ​ដែល​បាន​ជ្រើស​មិនទាន់មាន​នៅ​ឡើយ​ទេ ។"

#: maildirresource.cpp:94
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr "មិនអាច​ប្រមូលយក​ធាតុ ៖ ថត maildir \"%1\" គឺ​មិនត្រឹមត្រូវ ។"

#: maildirresource.cpp:149 maildirresource.cpp:174 maildirresource.cpp:214
#: maildirresource.cpp:245 maildirresource.cpp:342 maildirresource.cpp:375
#: maildirresource.cpp:417 maildirresource.cpp:448
msgid "Unusable configuration."
msgstr "កា​រកំណត់​រចនាសម្ព័ន្ធ​ដែល​មិនអាច​ប្រើបាន ។"

#: maildirresource.cpp:161 maildirresource.cpp:198
msgid "Error: Unsupported type."
msgstr "កំហុស​ ៖ ប្រភេទ​ដែល​មិន​បានគាំទ្រ ។"

#: maildirresource.cpp:221
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "ថត​ប្រភព​មិន​ត្រឹមត្រូវ ៖ '%1' ។"

#: maildirresource.cpp:227
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "ថត​ទិសដៅ​មិន​ត្រឹមត្រូវ ៖ '%1' ។"

#: maildirresource.cpp:233
#, kde-format
msgid "Could not move message '%1'."
msgstr "មិនអាច​ផ្លាស់ទី​សារ '%1' បាន​ទេ ។"

#: maildirresource.cpp:254
#, kde-format
msgid "Failed to delete message: %1"
msgstr "បានបរាជ័យ​ក្នុង​ការ​លុប​សារ ៖ %1"

#: maildirresource.cpp:319
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "Maildir '%1' សម្រាប់​សម្រាំង '%2' មិន​ត្រឹមត្រូវ​ទេ ។"

#: maildirresource.cpp:402
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "មិនអាច​ប្ដូរ​ឈ្មោះ​ថត maildir '%1' បាន​ទេ ។"

#: maildirresource.cpp:423
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "មិនអាច​ផ្លាស់ទី​ថត root maildir '%1' បាន​ទេ ។"

#: maildirresource.cpp:438
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "មិនអាច​ផ្លាស់ទី​ថត maildir '%1' ពី '%2' ទៅ '%3' បាន​ទេ ។"

#: maildirresource.cpp:454
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "មិនអាច​លុប​ថត maildir កម្រិត​កំពូល​បាន​ទេ '%1' ។"

#: maildirresource.cpp:463
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "បាន​បរាជ័យ​ក្នុងការ​លុប​ថត​រង '%1' ។"

#: maildirresource.cpp:472
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "មិនអាច​បង្កើត maildir '%1' បានទេ ។"

#: maildirresource.cpp:479
msgid "No usable storage location configured."
msgstr "គ្មាន​ទីតាង​ផ្ទុក​ដែល​អាច​ប្រើបាន​ បាន​កំណត់​រចនាសម្ព័ន្ធ​នោះ​ទេ ។"

#. i18n: file: settings.ui:15
#. i18n: ectx: property (windowTitle), widget (QWidget, ConfigDialog)
#: rc.cpp:3
msgid "Mail Directory Settings"
msgstr "ការ​កំណត់​ថត​សំបុត្រ"

#. i18n: file: settings.ui:21
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:6
msgid "Select the folder containing the maildir information:"
msgstr "ជ្រើស​ថត​ដែល​មាន​ព័ត៌មាន​ maildir  ៖"

#. i18n: file: settings.ui:31
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: rc.cpp:9
msgid "Open in read-only mode"
msgstr "បើក​នៅ​ក្នុង​របៀប បាន​តែ​អាន"

#. i18n: file: maildirresource.kcfg:10
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:12
msgid "Path to maildir"
msgstr "ផ្លូវទៅកាន់ maildir"

#. i18n: file: maildirresource.kcfg:14
#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: rc.cpp:15
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr "ចំណុច​ផ្លូវ​ទៅ​កាន់​ថត​មាន​ Maildirs ជំនួស​ឲ្យ maildir ខ្លួន​វា ។"

#. i18n: file: maildirresource.kcfg:18
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:18
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាងក្រោម​ពិត ។"

#~ msgid "Only email messages can be added to the Maildir resource."
#~ msgstr "មាន​តែ​សារ​អ៊ីមែល​ប៉ុណ្ណោះ​ដែល​អាច​បន្ថែម​ទៅកាន់​ធនធាន Maildir បាន ។"

#~ msgid "Invalid maildir: %1"
#~ msgstr "maildir មិនត្រឹមត្រូវ ៖ %1"
