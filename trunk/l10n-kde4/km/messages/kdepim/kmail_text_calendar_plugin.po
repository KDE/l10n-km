#: text_calendar.cpp:238
msgid "Incidence with no summary"
msgstr "ឧប្បត្ដិហេតុ​​ដែល​គ្មាន​សេចក្ដី​សង្ខេប"

#: text_calendar.cpp:242
#, kde-format
msgid "Answer: %1"
msgstr "ចម្លើយ ៖ %1"

#: text_calendar.cpp:245
#, kde-format
msgid "Delegated: %1"
msgstr "បាន​ទទួល ៖ %1"

#: text_calendar.cpp:248
#, kde-format
msgid "Forwarded: %1"
msgstr "បាន​បញ្ជូន​បន្ត ៖ %1"

#: text_calendar.cpp:265
msgid "Could not save file to KOrganizer"
msgstr "មិន​អាច​រក្សា​ទុក​ឯកសារ​ទៅ KOrganizer បាន​ឡើយ"

#: text_calendar.cpp:339
msgid "Delegation to organizer is not possible."
msgstr "មិន​អាច​ទទួល​ដើម្បី​រៀបចំ ។"

#: text_calendar.cpp:476
msgid "Accept incidence"
msgstr "ទទួល​យក​ឧប្បត្ដិហេតុ"

#: text_calendar.cpp:478
msgid "Accept incidence conditionally"
msgstr "ទទួល​យក​ឧប្បត្តិហេតុ​តាម​លក្ខខណ្ឌ"

#: text_calendar.cpp:480
msgid "Throw mail away"
msgstr "បោះ​សំបុត្រ​ចោល"

#: text_calendar.cpp:482
msgid "Decline incidence"
msgstr "បដិសេធ​ឧប្បត្ដិហេតុ"

#: text_calendar.cpp:484
msgid "Check my calendar..."
msgstr "ពិនិត្យ​ប្រតិទិន​របស់​ខ្ញុំ..."

#: text_calendar.cpp:486
msgid "Enter incidence into my calendar"
msgstr "បញ្ចូល​ឧប្បត្ដិហេតុ​ទៅ​ក្នុង​ប្រតិទិន​របស់​ខ្ញុំ"

#: text_calendar.cpp:488
msgid "Delegate incidence"
msgstr "កា​រផ្ទេរ​ឧប្បត្តិហេតុ"

#: text_calendar.cpp:490
msgid "Forward incidence"
msgstr "បញ្ជូន​ឧប្បត្តិហេតុ​បន្ត"

#: text_calendar.cpp:492
msgid "Remove incidence from my calendar"
msgstr "យក​ឧប្បត្ដិហេតុ​ចេញ​ពី​ប្រតិទិន​របស់​ខ្ញុំ"

