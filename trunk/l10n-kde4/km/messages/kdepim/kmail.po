#: rc.cpp:706
msgctxt "@label:textbox Prefix for quoted message lines"
msgid "&Quote indicator:"
msgstr "ទ្រនិចបង្ហាញ​សម្រង់ ៖"

#. i18n: file: ui/templatesconfiguration_base.ui:277
