#: configuredialog.cpp:3074
msgid ""
"<qt>The following placeholders are supported in the reply phrases:<br /"
"><table><tr><td><b>%D</b>: date</td><td><b>%S</b>: subject</td><td></td></"
"tr><tr><td><b>%e</b>: sender's address</td><td><b>%F</b>: sender's name</"
"td><td><b>%f</b>: sender's initials</td></tr><tr><td><b>%T</b>: recipient's "
"name</td><td><b>%t</b>: recipient's name and address</td><td></td></"
"tr><tr><td><b>%C</b>: carbon copy names</td><td><b>%c</b>: carbon copy names "
"and addresses</td><td></td></tr><tr><td><b>%%</b>: percent sign</td><td><b>%"
"_</b>: space</td><td><b>%L</b>: linebreak</td></tr></table></qt>"
msgstr ""
"<qt>បាន​គាំទ្រ​កន្លែង​ដាក់​ដូច​ខាង​ក្រោម​នៅ​ក្នុង​ឃ្លា​ឆ្លើយ​តប ៖<br /><table><tr><td><b>%D</b> ៖ "
"កាលបរិច្ឆេទ</td><td><b>%S</b> ៖ ប្រធានបទ</td><td></td></tr><tr><td><b>%e</b> ៖ "
"អាសយដ្ឋាន​របស់​អ្នក​ផ្ញើ</td><td><b>%F</b> ៖ ឈ្មោះ​របស់​អ្នក​ផ្ញើ</td><td><b>%f</b> ៖ "
"អាទិសង្កេត​របស់​អ្នក​ផ្ញើ</td></tr><tr><td><b>%T</b> ៖ ឈ្មោះ​របស់​អ្នក​ទទួល</td><td><b>%t</"
"b> ៖ ឈ្មោះ និង​អាសយដ្ឋាន​របស់អ្នក​ទទួល</td><td></td></tr><tr><td><b>%C</b> ៖ ឈ្មោះចម្លង​"
"ជា​សម្ងាត់ជូន</td><td><b>%c</b> ៖ ឈ្មោះ និង​អាសយដ្ឋាន​ចម្លង​ជា​សម្ងាត់​ជូន</td><td></td></"
"tr><tr><td><b>%%</b> ៖ សញ្ញា​ភាគរយ</td><td><b>%_</b> ៖ ចន្លោះ</td><td><b>%L</"
"b> ៖ បំបែកបន្ទាត់</td></tr></table></qt>"

