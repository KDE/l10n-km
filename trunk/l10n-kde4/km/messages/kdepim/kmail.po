msgctxt "Start kmail even when another instance is running."
msgid "Start %1"
msgstr "ចាប់ផ្ដើម %1"

#: kmstartup.cpp:193
msgctxt "Do not start another kmail instance."
msgid "Exit"
msgstr "​ចេញ"

