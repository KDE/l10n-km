msgid "Shows contact editor with given uid"
msgstr "បង្ហាញ​កម្មវិធី​និពន្ធ​ទំនាក់​ទំនង​ជាមួយ uid ដែល​បាន​ផ្ដល់​ឲ្យ"

#: kaddressbook_options.h:36
msgid "Launches in editor only mode"
