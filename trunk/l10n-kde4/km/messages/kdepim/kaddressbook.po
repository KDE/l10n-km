msgid "Work on given file"
msgstr "ធ្វើ​ការ​លើ​​ឯកសារ​ដែល​បាន​ផ្ដល់​ឲ្យ"

#: kaddressbook_options.h:39
msgid "Import the given vCard"
msgstr "នាំចូល vCard ដែល​បាន​ផ្ដល់​ឲ្យ​"

