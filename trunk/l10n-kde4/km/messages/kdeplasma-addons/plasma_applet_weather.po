#: weatherapplet.cpp:601
msgid "Watches Issued:"
msgstr "អាកាសធាតុ​បានចេញ​ផ្សាយ ៖"

#: weatherapplet.cpp:627
msgid "Notices"
msgstr "ចំណាំ"
