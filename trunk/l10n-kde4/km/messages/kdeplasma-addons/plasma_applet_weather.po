#: weatherapplet.cpp:174
msgctxt "Shown when you have not set a weather provider"
msgid "Please Configure"
msgstr "សូម​កំណត់​រចនាសម្ព័ន្ធ"

#: weatherapplet.cpp:177
#, kde-format
msgctxt ""
"%1 is the weather condition, %2 is the temperature, both come from the "
"weather provider"
msgid "%1 %2"
msgstr "%1 %2"

#: weatherapplet.cpp:232 weatherapplet.cpp:234 weatherapplet.cpp:239
#: weatherapplet.cpp:241
#, kde-format
msgctxt "temperature, unit"
msgid "%1%2"
msgstr "%1%2"

#: weatherapplet.cpp:261
#, kde-format
msgid "Low: %1"
msgstr "ទាប ៖ %1"

#: weatherapplet.cpp:263
#, kde-format
msgid "High: %1"
msgstr "ខ្ពស់ ៖ %1"

#: weatherapplet.cpp:265
#, kde-format
msgctxt "High & Low temperature"
msgid "H: %1 L: %2"
msgstr "ខ្ពស់ ៖ %1 ទាប ៖ %2"

#: weatherapplet.cpp:391
#, kde-format
msgctxt "certain weather condition, probability percentage"
msgid "%1 (%2%)"
msgstr "%1 (%2%)"

#: weatherapplet.cpp:405 weatherapplet.cpp:417
msgctxt "Short for no data available"
msgid "-"
msgstr "-"

#: weatherapplet.cpp:446
msgid "5 Days"
msgstr "៥ ថ្ងៃ"

#: weatherapplet.cpp:469
#, kde-format
msgctxt "windchill, unit"
msgid "Windchill: %1"
msgstr "ខ្យល់​ត្រជាក់ ៖ %1"

#: weatherapplet.cpp:477
#, kde-format
msgctxt "humidex, unit"
msgid "Humidex: %1"
msgstr "Humidex ៖ %1"

#: weatherapplet.cpp:484
#, kde-format
msgid "Dewpoint: %1"
msgstr "ចំណុច​សើម ៖ %1"

#: weatherapplet.cpp:490
#, kde-format
msgctxt "pressure, unit"
msgid "Pressure: %1 %2"
msgstr "សម្ពាធ ៖ %1 %2"

#: weatherapplet.cpp:496
#, kde-format
msgid "Pressure Tendency: %1"
msgstr "និន្នាការ​សម្ពាធ ៖ %1"

#: weatherapplet.cpp:506
#, kde-format
msgctxt "distance, unit"
