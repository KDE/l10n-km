msgstr "ភាព​​មើលឃើញ ៖ %1%2"

#: weatherapplet.cpp:508
#, kde-format
msgid "Visibility: %1"
msgstr "ភាព​​មើលឃើញ ៖ %1"

#: weatherapplet.cpp:516
#, kde-format
msgid "Humidity: %1"
msgstr "សំណើម ៖ %1"

#: weatherapplet.cpp:521
#, kde-format
msgctxt "wind direction, speed"
msgid "%1 %2 %3"
msgstr "%1 %2 %3"

#: weatherapplet.cpp:525
msgctxt "Not available"
msgid "N/A"
msgstr "គ្មាន"

#: weatherapplet.cpp:528
msgctxt "Wind condition"
