#: pastebin.cpp:217
msgctxt "The status of the applet has not been set - i.e. it is unset."
msgid "Unset"
msgstr "មិន​កំណត់"

#: pastebin.cpp:222
msgid "Drop text or an image onto me to upload it to Pastebin."
msgstr "ទម្លាក់​អត្ថបទ ឬ​រូបភាព​លើ​ខ្ញុំ ដើម្បី​ផ្ទុក​វា​ឡើង​ទៅ​កាន់ Pastebin ។"

#: pastebin.cpp:227
msgid "Error during upload. Try again."
msgstr "កំហុស​ក្នុងពេល​ផ្ទុក​ឡើង ។ ព្យាយាម​ម្ដង​ទៀត ។"

#: pastebin.cpp:235
#, kde-format
msgid "Successfully uploaded to %1."
msgstr "បាន​ផ្ទុកឡើង​ទៅ %1 ដោយជោគជ័យ ។"

#: pastebin.cpp:243
msgid "Sending...."
msgstr "កំពុង​ផ្ញើ..."

#: pastebin.cpp:371
msgid "Drop!"
msgstr "ទម្លាក់ !"

#: pastebin.cpp:390
msgid "Error: Try Again"
msgstr "កំហុស ៖ ព្យាយាម​ម្ដង​ទៀត"

#: pastebin.cpp:448
msgid "General"
msgstr "ទូទៅ"

#: pastebin.cpp:456
msgid "Servers"
msgstr "ម៉ាស៊ីនបម្រើ"

#: pastebin.cpp:517
#, kde-format
msgctxt ""
"Notification when the pastebin applet has copied the URL to the clipboard"
msgid "%1 has been copied to your clipboard"
msgstr "%1 ត្រូវ​បាន​ចម្លង​ទៅ​កាន់​ក្ដារតម្បៀតខ្ទាស់​របស់​អ្នក"

#: pastebin.cpp:519
msgid "Open browser"
msgstr "បើក​កម្មវិធី​រុករក"

