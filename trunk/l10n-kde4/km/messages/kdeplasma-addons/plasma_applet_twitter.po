#: twitter.cpp:89
msgid "Failed to load twitter DataEngine"
msgstr ""

#: twitter.cpp:239
msgid "Failed to access kwallet. Store password in config file instead?"
msgstr ""
"បានបរាជ័យ​ក្នុង​ការ​ចូល​ដំណើរការ kwallet ។ ទុក​ពាក្យ​សម្ងាត់​របស់​នៅ​ក្នុង​ឯកសារ config ជំនួស​វិញ​ឬ ?"

#: twitter.cpp:259 twitter.cpp:606
msgid "Refreshing timeline..."
msgstr "កំពុង​ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់..."

#: twitter.cpp:278
#, kde-format
msgid "1 new tweet"
msgid_plural "%1 new tweets"
msgstr[0] "tweets ថ្មី %1"

#: twitter.cpp:389
#, kde-format
msgid " from %1"
msgstr " ពី %1"

#: twitter.cpp:433
msgid " tweets"
msgstr " tweets"

#: twitter.cpp:435
msgid " minutes"
msgstr " នាទី"

#: twitter.cpp:438
msgid "User name:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: twitter.cpp:439
msgid "Password:"
msgstr "ពាក្យ​សម្ងាត់ ៖"

#: twitter.cpp:440
msgid "Timeline size:"
msgstr "ទំហំ​បន្ទាត់​ពេលវេលា ៖"

#: twitter.cpp:441
msgid "Timeline refresh:"
msgstr "ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់ ៖"

#: twitter.cpp:442
msgid "Show messages of friends:"
msgstr "បង្ហាញ​សារ​របស់​មិត្តភ័ក្រ ៖"

#: twitter.cpp:553
#, kde-format
msgid "1 character left"
msgid_plural "%1 characters left"
msgstr[0] ""

#: twitter.cpp:668
msgid "Less than a minute ago"
msgstr "តិចជាង​ ១ នាទី​កន្លង​ទៅ"

#: twitter.cpp:670
#, kde-format
msgid "1 minute ago"
msgid_plural "%1 minutes ago"
msgstr[0] "%1  នាទី​កន្លង​ទៅ"

#: twitter.cpp:672
msgid "Over an hour ago"
msgstr "១ ម៉ោង​កន្លង​ទៅ"

#: twitter.cpp:674
#, kde-format
msgid "1 hour ago"
msgid_plural "%1 hours ago"
msgstr[0] "%1 ម៉ោង​កន្លង​ទៅ"

