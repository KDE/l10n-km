#: rc.cpp:15
msgid "Timeline size:"
msgstr "ទំហំ​បន្ទាត់​ពេលវេលា ៖"

#. i18n: file: configuration.ui:93
#. i18n: ectx: property (suffix), widget (QSpinBox, historySizeSpinBox)
#: rc.cpp:18
msgid " messages"
