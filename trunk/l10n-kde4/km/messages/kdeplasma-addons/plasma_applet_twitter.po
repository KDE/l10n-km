msgstr[0] "%1  នាទី​កន្លង​ទៅ"

#: twitter.cpp:771
msgid "Over an hour ago"
msgstr "១ ម៉ោង​កន្លង​ទៅ"

#: twitter.cpp:773
#, kde-format
msgid "1 hour ago"
msgid_plural "%1 hours ago"
msgstr[0] "%1 ម៉ោង​កន្លង​ទៅ"
