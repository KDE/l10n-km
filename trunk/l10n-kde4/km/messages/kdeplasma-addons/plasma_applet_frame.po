#: configdialog.cpp:41
msgid ""
"This picture of a monitor contains a preview of the picture you currently "
"have in your frame."
msgstr "រូបភាព​របស់​ម៉ូនីទ័រ​នេះ​មាន​កា​រមើល​រូបភាព​ជា​មុន ដែល​បច្ចុប្បន្ន​មាន​នៅ​ក្នុង​ស៊ុម​របស់​អ្នក ។"

#: picture.cpp:68
msgctxt "Info"
msgid "Put your photo here or drop a folder to start a slideshow"
msgstr "ដាក់​រូបថត​របស់​អ្នក​នៅ​ទីនេះ ឬ​ទម្លាក់​ថត​ដើម្បី​ចាប់ផ្ដើម​បញ្ចាំង​ស្លាយ"

#: picture.cpp:73
msgctxt "Error"
msgid "Error loading image"
msgstr "កំហុស​ក្នុង​ការ​ផ្ទុក​រូបភាព"

