#: qalculate_settings.cpp:164
msgid "Fractional"
msgstr "ប្រភាគ"

#: qalculate_settings.cpp:165
msgid "Combined"
msgstr "បានបន្សំ"

#: qalculate_settings.cpp:171
msgid "Pure"
msgstr "សុទ្ធ"

#: qalculate_settings.cpp:172
msgid "Scientific"
msgstr "វិទ្យាសាស្ត្រ"

#: qalculate_settings.cpp:173
