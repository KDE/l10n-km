msgstr[0] "%1 ថ្ងៃកន្លង​ទៅ"

#: scroller.cpp:528
#, kde-format
msgid "%1 week ago"
msgid_plural "%1 weeks ago"
msgstr[0] "%1 សប្ដាហ៍​កន្លង​ទៅ"

