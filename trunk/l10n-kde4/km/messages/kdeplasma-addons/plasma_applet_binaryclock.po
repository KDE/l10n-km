#~ msgid "Check this if you want to see the inactive LEDs."
#~ msgstr "គូសធីក​វា​ប្រសិន​បើ​អ្នក​ចង់​មើលទ្រនិច​អសកម្ម ។"

#~ msgid "Show"
#~ msgstr "បង្ហាញ​"

#~ msgid "Use theme color"
