#: twitter.cpp:204
msgid "Failed to access kwallet. Store password in config file instead?"
msgstr "បាន​បរាជ័យ​ក្នុងការ​ចូលដំណើរការ kwallet ។ ទុក​ពាក្យ​សម្ងាត់​នៅ​ក្នុង​​ឯកសារ config ជំនួស​វិញ ?"

#: twitter.cpp:219 twitter.cpp:495
msgid "Refreshing timeline..."
msgstr "កំពុង​ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់..."

#: twitter.cpp:238
#, kde-format
msgid "%1 new tweets"
msgstr "tweets ថ្មី %1"

#: twitter.cpp:314
#, kde-format
msgid ""
"<tr><td align='right' width='99%'><font color='#9c9c9c'>%1 from %2</font></"
"td></tr>"
msgstr "<tr><td align='right' width='99%'><font color='#9c9c9c'>%1 ពី %2</font></td></tr>"

#: twitter.cpp:333
msgid "Configure Twitter Applet"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​អាប់ភ្លេត Twitter"

#: twitter.cpp:344
msgid " tweets"
msgstr " tweets"

#: twitter.cpp:346
msgid " minutes"
msgstr " នាទី"

#: twitter.cpp:349
msgid "Username"
msgstr "ឈ្មោះ​អ្នក​ប្រើ"

#: twitter.cpp:350
msgid "Password"
msgstr "ពាក្យសម្ងាត់"

#: twitter.cpp:351
msgid "Timeline size"
msgstr "ទំហំ​បន្ទាត់​ពេលវេលា"

#: twitter.cpp:352
msgid "Timeline refresh"
msgstr "ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់"

#: twitter.cpp:353
msgid "Show messages of friends"
msgstr "បង្ហាញ​សារ​របស់​មិត្តភក្ដិ"

#: twitter.cpp:521
msgid "less than 5 seconds ago"
msgstr "តិចជាង ៥ វិនាទី​កន្លង​ទៅ"

#: twitter.cpp:523
#, kde-format
msgid "less than %1 seconds ago"
msgstr "តិចជាង %1 វិនាទី​កន្លង​ទៅ"

#: twitter.cpp:525
#, kde-format
msgid "%1 minutes ago"
msgstr "%1 នាទី​កន្លង​ទៅ"

#: twitter.cpp:527
#, kde-format
msgid "about %1 hours ago"
msgstr "ប្រហែល %1 ម៉ោង​កន្លង​ទៅ"

