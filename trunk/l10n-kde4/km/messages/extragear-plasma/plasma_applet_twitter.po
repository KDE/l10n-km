#: twitter.cpp:213
msgid "Failed to access kwallet. Store password in config file instead?"
msgstr ""
"បានបរាជ័យ​ក្នុង​ការ​ចូល​ដំណើរការ kwallet ។ ទុក​ពាក្យ​សម្ងាត់​របស់​នៅ​ក្នុង​ឯកសារ config ជំនួស​វិញ​ឬ ?"

#: twitter.cpp:233 twitter.cpp:509
msgid "Refreshing timeline..."
msgstr "កំពុង​ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់..."

#: twitter.cpp:252
#, kde-format
msgid "%1 new tweets"
msgstr "tweets ថ្មី %1"

#: twitter.cpp:335
#, kde-format
msgid ""
"<tr><td align='left' width='1%'><font color='%2'>%1</font></td><td "
"align='right' width='99%'><font color='%2'>%3 from %4</font></td></tr>"
msgstr ""
"<tr><td align='left' width='1%'><font color='%2'>%1</font></td><td "
"align='right' width='99%'><font color='%2'>%3 ពី %4</font></td></tr>"

#: twitter.cpp:354
msgid "Configure Twitter Applet"
msgstr "កំណង់​រចនាសម្ព័ន្ធ​អាប់ភ្លេត Twitter"

#: twitter.cpp:365
msgid " tweets"
msgstr " tweets"

#: twitter.cpp:367
msgid " minutes"
msgstr " នាទី"

#: twitter.cpp:370
msgid "User name:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: twitter.cpp:371
msgid "Password:"
msgstr "ពាក្យ​សម្ងាត់ ៖"

#: twitter.cpp:372
msgid "Timeline size:"
msgstr "ទំហំ​បន្ទាត់​ពេលវេលា ៖"

#: twitter.cpp:373
msgid "Timeline refresh:"
msgstr "ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់ ៖"

#: twitter.cpp:374
msgid "Show messages of friends:"
msgstr "បង្ហាញ​សារ​របស់​មិត្តភ័ក្រ ៖"

#: twitter.cpp:537
msgid "1 minute ago"
msgstr "១ នាទី​កន្លង​ទៅ"

#: twitter.cpp:539
#, kde-format
msgid "%1 minutes ago"
msgstr "%1 កន្លង​ទៅ"

#: twitter.cpp:541
msgid "1 hour ago"
msgstr "១ ម៉ោង​កន្លង​ទៅ"

#: twitter.cpp:543
#, kde-format
msgid "%1 hours ago"
msgstr "%1 កន្លង​ទៅ"
