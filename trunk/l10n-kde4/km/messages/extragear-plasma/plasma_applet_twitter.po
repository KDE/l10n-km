#: twitter.cpp:212
msgid "Failed to access kwallet. Store password in config file instead?"
msgstr "បានបរាជ័យ​ក្នុង​ការ​ចូល​ដំណើរការ kwallet ។ ទុក​ពាក្យ​សម្ងាត់​របស់​នៅ​ក្នុង​ឯកសារ config ជំនួស​វិញ​ឬ ?"

#: twitter.cpp:232 twitter.cpp:520
msgid "Refreshing timeline..."
msgstr "កំពុង​ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់..."

#: twitter.cpp:251
#, kde-format
msgid "%1 new tweets"
msgstr "tweets ថ្មី %1"

#: twitter.cpp:337
#, kde-format
msgid ""
"<tr><td align='right' width='99%'><font color='#9c9c9c'>%1 from %2</font></"
"td></tr>"
msgstr ""
"<tr><td align='right' width='99%'><font color='#9c9c9c'>%1 ពី %2</font></"
"td></tr>"

#: twitter.cpp:356
msgid "Configure Twitter Applet"
msgstr "កំណង់​រចនាសម្ព័ន្ធ​អាប់ភ្លេត Twitter"

#: twitter.cpp:367
msgid " tweets"
msgstr " tweets"

#: twitter.cpp:369
msgid " minutes"
msgstr " នាទី"

#: twitter.cpp:372
msgid "Username"
msgstr "ឈ្មោះ​អ្នក​ប្រើ"

#: twitter.cpp:373
msgid "Password"
msgstr "ពាក្យ​សម្ងាត់"

#: twitter.cpp:374
msgid "Timeline size"
msgstr "ទំហំ​បន្ទាត់​ពេលវេលា"

#: twitter.cpp:375
msgid "Timeline refresh"
msgstr "ធ្វើ​ឲ្យ​បន្ទាត់​ពេលវេលា​ស្រស់"

#: twitter.cpp:376
msgid "Show messages of friends"
msgstr "បង្ហាញ​សារ​របស់​មិត្តភ័ក្រ"

#: twitter.cpp:548
msgid "less than 5 seconds ago"
msgstr "តិច​ជាង ៥ វិនាទី​កន្លង​ទៅ"

#: twitter.cpp:550
#, kde-format
msgid "less than %1 seconds ago"
msgstr "តិច​ជាង %1 វិនាទី​កន្លង​ទៅ"

#: twitter.cpp:552
#, kde-format
msgid "%1 minutes ago"
msgstr "%1 កន្លង​ទៅ"

#: twitter.cpp:554
#, kde-format
msgid "about %1 hours ago"
msgstr "ប្រហែល​ជា %1 ម៉ោង​កន្លង​ទៅ"

