#: binary-clock/plasma-applet-binaryclock.desktop:3
msgctxt "Name"
msgid "Binary Clock"
msgstr "នាឡិកា​គោលពីរ"

#: binary-clock/plasma-applet-binaryclock.desktop:7
msgctxt "Comment"
msgid "A binary clock"
msgstr "នាឡិកា​គោលពីរ"

#: bluemarble/plasma-applet-bluemarble.desktop:2
msgctxt "Name"
msgid "3D Earth Model"
msgstr "គំរូ​ផែនដី​ត្រីមាត្រ"

#: bluemarble/plasma-applet-bluemarble.desktop:10
msgctxt "Comment"
msgid "Shows Earth on your desktop"
msgstr "បង្ហាញ​ផែនទី​នៅ​លើ​ផ្ទៃតុ"

#: calculator/plasma-applet-calculator.desktop:2
msgctxt "Name"
msgid "Calculator"
msgstr "ម៉ាស៊ីន​គិតលេខ"

#: calculator/plasma-applet-calculator.desktop:4
msgctxt "Comment"
msgid "A simple calculator."
msgstr "ម៉ាស៊ីន​គិតលេខ​ធម្មតា"

#: comic/plasma-comic-default.desktop:2
msgctxt "Name"
msgid "Comic Strip"
msgstr "យក​កំប្លែង​ចេញ"

#: comic/plasma-comic-default.desktop:7
msgctxt "Comment"
msgid "Shows a comic strip from the internet."
msgstr "បង្ហាញ​ការ​យក​កំប្លែង​ចេញ​ពី​អ៊ីនធឺណិត ។"

#: dict/plasma-dict-default.desktop:2
msgctxt "Name"
msgid "Dictionary"
msgstr "វចនានុក្រម"

#: dict/plasma-dict-default.desktop:11
msgctxt "Comment"
msgid "Look up the meaning of words"
msgstr "រក​មើល​អត្ថន័យ​របស់​ពាក្យ"

#: ebn/plasma-applet-ebn.desktop:2
msgctxt "Name"
msgid "English Breakfast Network"
msgstr "បណ្ដាញ English Breakfast​"

#: ebn/plasma-applet-ebn.desktop:6
msgctxt "Comment"
msgid "Get information from the KDE automated quality checker"
msgstr "ទទួល​ព័ត៌មាន​ពី​កម្មវិធី​ត្រួតពិនិត្យ​គុណភាព​ដោយ​ស្វ័យ​ប្រវត្តិ​របស់ KDE"

#: fifteenPuzzle/plasma-applet-fifteenPuzzle.desktop:3
msgctxt "Name"
msgid "Fifteen Puzzle"
msgstr "ផ្ដុំ​រូបភាព​ ១៥"

#: fifteenPuzzle/plasma-applet-fifteenPuzzle.desktop:9
msgctxt "Comment"
msgid "Try to put the pieces in order"
msgstr "ព្យាយាម​ដាក់​ចម្រៀក​ក្នុង​លំដាប់"

#: fileWatcher/plasma-fileWatcher-default.desktop:2
msgctxt "Name"
msgid "File Watcher"
msgstr "កម្មវិធី​មើល​ឯកសារ"

#: frame/plasma-frame-default.desktop:2
msgctxt "Name"
msgid "Picture Frame"
msgstr "ស៊ុម​រូបភាព"

#: frame/plasma-frame-default.desktop:8
msgctxt "Comment"
msgid "Display your favorite pictures"
msgstr "បង្ហាញ​រូបភាព​ពេញចិត្ត​របស់​អ្នក"

#: fuzzy-clock/plasma-clock-fuzzy.desktop:3
msgctxt "Name"
msgid "Fuzzy Clock"
msgstr "នាឡិកា​ស្រពិចស្រពិល"

#: fuzzy-clock/plasma-clock-fuzzy.desktop:8
msgctxt "Comment"
msgid "A simple fuzzy clock"
msgstr "នាឡិកា​ស្រពិចស្រពិល​ធម្មតា"

#: kolourpicker/plasma-kolourpicker-default.desktop:2
msgctxt "Name"
msgid "Color Picker"
msgstr "ឧបករណ៍​ជ្រើស​ពណ៌"

#: kolourpicker/plasma-kolourpicker-default.desktop:10
msgctxt "Comment"
msgid "Pick a color from the desktop"
msgstr "រក​ពណ៌​ពី​ផ្ទៃតុ"

#: konqprofiles/plasma-applet-konqprofiles.desktop:2
msgctxt "Name"
msgid "Konq Profiles Applet"
msgstr "អាប់ភ្លេត​ទម្រង់​របស់ Konq"

#: konqprofiles/plasma-applet-konqprofiles.desktop:5
msgctxt "Comment"
msgid "Konq Profiles Launcher"
msgstr "កម្មវិធី​ចាប់ផ្ដើម​ទម្រង់​របស់ Konq"

#: konsoleprofiles/plasma-applet-konsoleprofiles.desktop:2
msgctxt "Name"
msgid "Konsole Profiles Applet"
msgstr "អាប់ភ្លេត​ទម្រង់​របស់​កុងសូល"

#: konsoleprofiles/plasma-applet-konsoleprofiles.desktop:5
msgctxt "Comment"
msgid "Konsole Profiles Launcher"
msgstr "កម្មវិធី​ចាប់ផ្ដើម​ទម្រង់​របស់​កុងសូល"

#: lancelot/app/src/applet/plasma-applet-lancelot.desktop:4
msgctxt "Name"
msgid "Lancelot Launcher"
msgstr "កម្មវិធី​ចាប់ផ្ដើម Lancelot"

#: lancelot/app/src/applet/plasma-applet-lancelot.desktop:7
msgctxt "Comment"
msgid "Launcher to start applications"
msgstr "កម្មវិធី​ចាប់ផ្ដើម ដើម្បី​ចាប់ផ្ដើម​កម្មវិធី"

#: lancelot/app/src/parts/plasma-applet-lancelot-part.desktop:4
msgctxt "Name"
msgid "Lancelot Part"
msgstr "ផ្នែក​របស់ Lancelot"

#: lancelot/app/src/parts/plasma-applet-lancelot-part.desktop:6
msgctxt "Comment"
msgid "Parts of Lancelot menu on the desktop"
msgstr "ផ្នែក​របស់​ម៉ឺន្យ​នៅលើ​ផ្ទៃតុ"

#: lancelot/app/themes/black/theme.desktop:2
msgctxt "Name"
msgid "Black night"
msgstr "ពេល​យប់​ខ្មៅ"

#: lancelot/app/themes/black/theme.desktop:3
msgctxt "Comment"
msgid "Dark theme for Lancelot"
msgstr "ស្បែក​ងងឹត​សម្រាប់ Lancelot"

#: lancelot/app/themes/blue/theme.desktop:2
msgctxt "Name"
msgid "Lancelot Blue"
msgstr "Lancelot ពណ៌​ខៀវ"

#: lancelot/app/themes/blue/theme.desktop:3
msgctxt "Comment"
msgid "Default theme for Lancelot"
msgstr "ស្បែក​លំនាំដើម​សម្រាប់ Lancelot"

#: luna/plasma-applet-luna.desktop:3
msgctxt "Name"
msgid "Luna"
msgstr "Luna"

#: luna/plasma-applet-luna.desktop:4
msgctxt "Comment"
msgid "Moon phase applet"
msgstr "អាប់ភ្លេត​ដំណើរ​ព្រះច័ន្ទ"

#: minimize-all/plasma-applet-minimize-all.desktop:2
msgctxt "Name"
msgid "Minimize All"
msgstr "បង្រួម​អប្បបរមា​ទាំងអស់"

#: minimize-all/plasma-applet-minimize-all.desktop:5
msgctxt "Comment"
msgid "Minimize all windows."
msgstr "បង្រួម​បង្អួច​ទាំងអស់​អប្បបរមា ។"

#: notes/plasma-notes-default.desktop:2
msgctxt "Name"
msgid "Notes"
msgstr "ចំណាំ"

#: notes/plasma-notes-default.desktop:11
msgctxt "Comment"
msgid "Postit-like Notes"
msgstr "ចំណាំ​ដូចនឹង Postit"

#: nowplaying/plasma-applet-nowplaying.desktop:3
msgctxt "Name"
msgid "Now Playing"
msgstr "កំពុង​ចាក់"

#: nowplaying/plasma-applet-nowplaying.desktop:10
msgctxt "Comment"
msgid "Displays currently playing audio"
msgstr "បង្ហាញ​អូឌីយ៉ូ​ដែល​កំពុង​ចាក់​បច្ចុប្បន្ន"

#: showdesktop/plasma-applet-showdesktop.desktop:3
msgctxt "Name"
msgid "Show Desktop"
msgstr "បង្ហាញ​ផ្ទៃតុ"

#: showdesktop/plasma-applet-showdesktop.desktop:6
msgctxt "Comment"
msgid "Lets you show the desktop"
msgstr "អនុញ្ញាត​ឲ្យ​អ្នក​បង្ហាញ​ផ្ទៃតុ"

#: twitter/plasma-twitter-default.desktop:2
msgctxt "Name"
msgid "Twitter Microblogging"
msgstr "Twitter Microblogging"

#: twitter/plasma-twitter-default.desktop:8
msgctxt "Comment"
msgid ""
"Lets you update your Twitter status and display your timeline. See http://"
"www.twitter.com for more information."
msgstr ""
"អនុញ្ញាត​ឲ្យ​អ្នក​ធ្វើ​ឲ្យ​ស្ថានភាព​សំឡេង​តិច​របស់​អ្នក​ទាន់សម័យ និង​បង្ហាញ​បន្ទាត់​ពេលវេលា​របស់​អ្នក​ ចំពោះ​ព័ត៌មាន​"
"បន្ថែម​សូម​មើល http://www.twitter.com ។"
