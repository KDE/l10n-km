#: rc.cpp:18 rc.cpp:53
msgid "Scene size"
msgstr "ទំហំ​ឆាក"

#. i18n: file: settings_appearance.ui:73
#. i18n: ectx: property (text), widget (QLabel, labelSmallScene)
#: rc.cpp:21 rc.cpp:56
msgid "Same as image size"
msgstr "ដូច​នឹង​ទំហំ​រូបភាព"

#. i18n: file: settings_appearance.ui:80
#. i18n: ectx: property (text), widget (QLabel, labelBigScene)
#: rc.cpp:24 rc.cpp:59
msgid "Five times the image size"
msgstr "៥​ ដង​​ទៅ​នឹង​ទំហំ​រូបភាព"

#. i18n: file: settings_appearance.ui:93
#. i18n: ectx: property (title), widget (QGroupBox, minimapBox)
#: rc.cpp:27 rc.cpp:62
msgid "Minimap"
msgstr "ផែនទី​តូច"

#. i18n: file: settings_appearance.ui:99
#. i18n: ectx: property (text), widget (QCheckBox, checkMinimapQuality)
#: rc.cpp:30 rc.cpp:65
msgid "Enable transparency effects"
msgstr "បើក​បែបផែនថ្លា"

#. i18n: file: settings_gameplay.ui:16
#. i18n: ectx: property (title), widget (QGroupBox, precisionBox)
#: rc.cpp:33 rc.cpp:68
msgid "Piece snapping precision"
msgstr "ភាព​ត្រឹមត្រូវ​នៃ​ការ​ខ្ទាស់​ចំណិត"

#. i18n: file: settings_gameplay.ui:50
#. i18n: ectx: property (text), widget (QLabel, labelLowPrecision)
#: rc.cpp:36 rc.cpp:71
msgid "Quite precise"
msgstr "ភាព​ត្រឹមត្រូវ​​ស្ងៀមស្ងាត់"

#. i18n: file: settings_gameplay.ui:57
#. i18n: ectx: property (text), widget (QLabel, labelHighPrecision)
#: rc.cpp:39 rc.cpp:74
msgid "Very unprecise"
msgstr "គ្មាន​ភាព​ត្រឹមត្រូវ"

