#. i18n: file: settings_appearance.ui:22
#. i18n: ectx: property (text), widget (QCheckBox, checkAntialiasing)
#: rc.cpp:12 rc.cpp:47
msgid "Use antialiasing"
msgstr "ប្រើ​ការ​ប្រឆាំង​ឈ្មោះ​ក្លែងក្លាយ"

#. i18n: file: settings_appearance.ui:29
#. i18n: ectx: property (text), widget (QCheckBox, checkHardwareAccel)
