#: blanktiledialog.cpp:26
msgid "Edit Blank Tile"
msgstr "កែ​សម្រួល​ក្រឡា​ទទេ"

#: blanktiledialog.cpp:36
msgid "You can set here which character(s) this blank tile represents."
msgstr "អ្នក​អាច​កំណត់​តួ​អក្សរ​មួយ​ណា ដែល​ដុំ​ឥដ្ឋ​ទទេ​នេះ​តំណាង​ឲ្យ​នៅ​ទីនេះ ។"

#: blanktiledialog.cpp:45
msgid "New letter(s):"
msgstr "តួ​អក្សរ​ថ្មី ៖"

#: blanktiledialog.cpp:97
#, kde-format
msgid "Actual setting: \"%1\""
msgstr "ការ​កំណត់​ពិត ៖ \"%1\""

#: chatwidget.cpp:56
#, kde-format
msgid "<font color=\"red\">* <b>%1</b> will be the language of the game</font>"
msgstr "<font color=\"red\">* <b>%1</b> នឹង​ជា​ភាសា​របស់​ល្បែង</font>"

#: chatwidget.cpp:61
#, kde-format
msgid "<font color=\"blue\">* <b>%1</b> has joined the game</font>"
msgstr "<font color=\"blue\">* <b>%1</b> បាន​ចូលរួម​ល្បែង</font>"

#: chatwidget.cpp:62
#, kde-format
msgid "<font color=\"blue\">* <b>%1</b> has entered the server</font>"
msgstr "<font color=\"blue\">* <b>%1</b> បាន​បញ្ចូល​ម៉ាស៊ីន​បម្រើ</font>"

#: chatwidget.cpp:68
#, kde-format
msgctxt "%1 is the nick, %2 is the message"
msgid "&lt;<font color=\"#3176B3\">%1</font>&gt; %2"
msgstr "&lt;<font color=\"#3176B3\">%1</font>&gt; %2"

#: chatwidget.cpp:73
msgid "<font color=\"blue\">* The game has started</font>"
msgstr "<font color=\"blue\">* ល្បែង​បាន​ចាប់ផ្ដើម​</font>"

#: chatwidget.cpp:78
msgid "<font color=\"blue\">* It is your turn</font>"
msgstr "<font color=\"blue\">* វា​ជា​វេន​របស់​អ្នក</font>"

#: chatwidget.cpp:79
#, kde-format
msgid "<font color=\"blue\">* It is the turn of %1</font>"
msgstr "<font color=\"blue\">* វា​ជា​វេន​របស់ %1</font>"

#: chatwidget.cpp:88
#, kde-format
msgctxt "%1 is the nick, %2 is the message"
msgid "&lt;%1&gt; %2"
msgstr "&lt;%1&gt; %2"

#: chatwidget.cpp:110
#, kde-format
msgid ""
"<font color=\"blue\">* %1 has used all his tiles. The game has ended!<br><b>%"
"2</b> has won!</font>"
msgstr ""
"<font color=\"blue\">* %1 បាន​ប្រើ​ក្បឿង​របស់​គាត់​ទាំងអស់ ។ ល្បែង​បាន​បញ្ចប់!<br><b>%2</b> "
"បាន​ឈ្នះ!</font>"

#: chatwidget.cpp:117
#, kde-format
msgid "<font color=\"blue\">* <b>%1</b> has left the game</font>"
msgstr "<font color=\"blue\">* <b>%1</b> បាន​ចាកចេញ​ពី​ល្បែង</font>"

#: chatwidget.cpp:121
#, kde-format
msgid "<font color=\"blue\">* <b>%1</b> has entered the game named %2</font>"
msgstr "<font color=\"blue\">* <b>%1</b> បាន​បញ្ចូល​ល្បែង​ដែល​មាន​ឈ្មោះ %2</font>"

#: chatwidget.cpp:127
msgid "<font color=\"blue\">* Disconnected from server</font>"
msgstr "<font color=\"blue\">* បាន​ផ្ដាច់​ពី​ម៉ាស៊ីន​បម្រើ</font>"

#: chatwidget.cpp:135
msgid ""
"<font color=\"red\">* You have used a word that contains tiles to make up a "
"excluve tile and that's forbidden</font>"
msgstr "<font color=\"red\">* អ្នក​បាន​ប្រើ​ពាក្យ​ដែល​មាន​ដុំ​ឥដ្ឋ​ដើម្បី​បង្កើត​ដុំ​ឥដ្ឋ​ដាច់​ដោយ​ឡែក ហើយ​ដែល​ត្រូវ​បាន​ហាម​ឃាត់</font>"

#: chatwidget.cpp:136
#, kde-format
msgid ""
"<font color=\"red\">* %1 has used a word that contains tiles to make up a "
"excluve tile and that's forbidden</font>"
msgstr "<font color=\"red\">* %1 បាន​ប្រើ​ពាក្យ​ដែល​មាន​ដុំ​ឥដ្ឋ​ដើម្បី​បង្កើត​ដុំ​ឥដ្ឋ​ដាច់​ដោយ​ឡែក ហើយ​ដែល​ត្រូវ​បាន​ហាម​ឃាត់</font>"

#: chatwidget.cpp:140
msgid "<font color=\"red\">* Your word was not accepted by the other players</font>"
msgstr "<font color=\"red\">* ពាក្យ​របស់​អ្នក​មិន​ត្រូវ​បាន​ទទួល​ដោយ​អ្នក​ប្រើ​ដទៃ​ទៀត​ទេ</font>"

#: chatwidget.cpp:141
#, kde-format
msgid "<font color=\"red\">* %1's word was not accepted by the other players</font>"
msgstr "<font color=\"red\">* ពាក្យ​របស់ %1 មិន​ត្រូវ​បាន​ទទួល​ដោយ​អ្នក​ប្រើ​ផ្សេង​ទៀត​ទេ</font>"

#: chatwidget.cpp:147
#, kde-format
msgid "<font color=\"blue\">* You made %1 points creating the words %2"
msgstr "<font color=\"blue\">* អ្នក​បាន​ប្រើ​ពិន្ទុ %1 ដើម្បី​បង្កើត​ពាក្យ %2"

#: chatwidget.cpp:148
#, kde-format
msgid "<font color=\"blue\">* %1 made %2 points creating the words %3"
msgstr "<font color=\"blue\">* %1 បាន​ពិន្ទុ​ %2 ដែល​បង្កើត​ពាក្យ %3"

#: chatwidget.cpp:153
msgid "<font color=\"blue\">* You skipped your turn</font>"
msgstr "<font color=\"blue\">* អ្នក​បាន​រំលង​វេន​របស់​អ្នក</font>"

#: chatwidget.cpp:154
#, kde-format
msgid "<font color=\"blue\">* %1 skipped his turn</font>"
msgstr "<font color=\"blue\">* %1 បាន​រំលង​វេន​របស់​គាត់</font>"

#: chatwidget.cpp:159
#, kde-format
msgid "<font color=\"blue\">* You exchanged %1 tile</font>"
msgid_plural "<font color=\"blue\">* You exchanged %1 tiles</font>"
msgstr[0] ""
msgstr[1] ""

#: chatwidget.cpp:160
#, kde-format
msgid "<font color=\"blue\">* %1 exchanged %2 tile</font>"
msgid_plural "<font color=\"blue\">* %1 exchanged %2 tiles</font>"
msgstr[0] ""
msgstr[1] ""

#: client.cpp:156
#, kde-format
msgctxt "current players / total players"
msgid "%1 / %2"
msgstr "%1 / %2"

#: client.cpp:160
msgctxt "Spectators not allowed"
msgid "Not allowed"
msgstr "មិន​អនុញ្ញាត"

#: client.cpp:192
msgid "Name of the game"
msgstr "ឈ្មោះ​ល្បែង"

#: client.cpp:195 server.cpp:111
msgid "Players"
msgstr "អ្នក​លេង"

#: client.cpp:198 server.cpp:112
msgid "Spectators"
msgstr "អ្នក​សង្កេត"

#: client.cpp:200
msgid "Game started"
msgstr "ចាប់ផ្ដើម​ល្បែង"

#: client.cpp:203 server.cpp:116
msgid "Comment"
msgstr "សេចក្តី​អធិប្បាយ"

#: client.cpp:206 server.cpp:117
msgid "Language"
msgstr "ភាសា"

#: client.cpp:245
msgid "The server uses a protocol version this client does not understand"
msgstr "ម៉ាស៊ីន​បម្រើ​ប្រើ​កំណែ​ពិធីការ ដែល​ម៉ាស៊ីន​នេះ​មិន​យល់"

#: client.cpp:260
msgid "The are too many users playing in that server"
msgstr "មាន​អ្នក​ប្រើច្រើន​កំពុង​លេង​ក្នុង​ម៉ាស៊ីន​បម្រើ​នោះ"

#: client.cpp:264
msgid "The server does not allow any spectator"
msgstr "ម៉ាស៊ីន​បម្រើ​មិន​អនុញ្ញាត​អ្នក​សង្កេត​ណា​ទេ"

#: client.cpp:281
msgid "There is someone already using that nick in that server"
msgstr "មាន​នរណា​ម្នាក់​កំពុង​ប្រើ​សន្មតិ​នាម​នោះ​ក្នុង​ម៉ាស៊ីន​បម្រើ​នោះ"

#: client.cpp:303
msgid "The are too many users in the server"
msgstr "មាន​អ្នក​ប្រើ​ច្រើន​ពេក​នៅ​ក្នុង​ម៉ាស៊ីន​បម្រើ"

#: client.cpp:334
msgid "Could not join the game as it is full."
msgstr "មិន​អាច​ចូលរួម​ល្បែង ពេល​វា​ពេញ ។"

#: client.cpp:334
msgid "Too many players"
msgstr "អ្នក​លេង​ច្រើន​ពេក"

#: client.cpp:340
msgid "It is not possible to create a game with less than 2 players."
msgstr "មិន​អាច​បង្កើត​ល្បែង​ដោយ​មាន​អ្នក​ប្រើ​តិច​ជាង​ពីរ ។"

#: client.cpp:340 client.cpp:344 client.cpp:348 client.cpp:353
msgid "Could not create a game"
msgstr "មិន​អាច​បង្កើន​ល្បែង"

#: client.cpp:344
msgid "It is not possible to create a game with an empty name."
msgstr "មិន​អាច​បង្កើត​ល្បែង​ជាមួយ​ឈ្មោះ​ទទេ ។"

#: client.cpp:348
msgid ""
"It is not possible to create a game with this name as there is already one "
"with it."
msgstr "មិន​អាច​បង្កើត​ល្បែង​មាន​ឈ្មោះ​នេះ ពេល​ដែល​មាន​មួយ​ហើយ ។"

#: client.cpp:353
msgid "It was not possible to create the game."
msgstr "មិន​អាច​បង្កើត​ល្បែង ។"

#: client.cpp:641
msgid "Could not connect to the server"
msgstr "មិន​អាច​តភ្ជាប់​ទៅ​ម៉ាស៊ីន​បម្រើ"

#: client.cpp:666
msgid "The server gave a wrong response."
msgstr "ម៉ាស៊ីន​បម្រើ​ផ្ដល់​ចម្លើយ​ខុស ។"

#: confirmwidget.cpp:54
msgid "&Reject"
msgstr "ច្រានចោល​"

#: confirmwidget.cpp:58
msgid "&Accept"
msgstr "យល់​ព្រម"

#: confirmwidget.cpp:136
#, kde-format
msgid ""
"<b>%1</b> sent the highlighted tiles.<br>Do you want to accept or reject the "
"word they have created?<br>If you do not answer, we will assume you accept "
"it."
msgstr "<b>%1</b> ផ្ញើ​ដុំ​ឥដ្ឋ​ដែល​បាន​បន្លិច ។<br>តើ​អ្នក​ចង់​ទទួល ឬ​បដិសេធ​ពាក្យ​ដែល​ពួក​គេ​បាន​បង្កើត?<br>បើ​អ្នក​មិន​ឆ្លើយ យើង​នឹង​សន្មត​ថា​អ្នក​ទទួល​វា ។"

#: eventslogwidget.cpp:40
#, kde-format
msgctxt "%1 represents the error message"
msgid "<font color=\"red\"><b>Error:</b></font> %1"
msgstr "<font color=\"red\"><b>កំហុស ៖</b></font> %1"

#: ignoredialog.cpp:18 multiwidget.cpp:23 server.cpp:110
msgid "Name"
msgstr "ឈ្មោះ"

#: kombination.cpp:71 kombination.cpp:343 kombination.cpp:350
#: kombination.cpp:547
msgid "Set me as ready"
msgstr "កំណត់​ខ្ញុំ​ជា​រួចរាល់"

#: kombination.cpp:104
msgid "&Ignore Players"
msgstr "មិន​អើពើ​អ្នក​លេង"

#: kombination.cpp:109
msgid "&Show Tiles' Scores"
msgstr "បង្ហាញ​ពិន្ទុ​របស់​ដុំ​ឥដ្ឋ"

#: kombination.cpp:114
msgid "Play &Log"
msgstr "កំណត់​ហេតុ​លេង"

#: kombination.cpp:177
msgid ""
"There is a game already in progress, are you sure you want to start another "
"one?"
msgstr "មាន​ល្បែង​កំពង់​តែ​លេង តើ​អ្នក​ពិត​ជា​ចង់​ចាប់ផ្ដើម​មួយ​ផ្សេង​ទៀត​ឬ?"

#: kombination.cpp:177
msgid "Game already in progress"
msgstr "ល្បែង​កំពុង​តែ​លេង"

#: kombination.cpp:188 kombination.cpp:219
msgid "The nick can not be empty."
msgstr "សម្មតិនាម​មិន​អាច​ទទេ ។"

#: kombination.cpp:188 kombination.cpp:219
msgid "Empty Nick"
msgstr "សម្មតិនាម​ទទេ"

#: kombination.cpp:192
msgid "You have to select a language for the game"
msgstr "អ្នក​ត្រូវ​តែ​ជ្រើស​ភាសា​សម្រាប់​ល្បែង"

#: kombination.cpp:192
msgid "No language chosen"
msgstr "មិន​បាន​ជ្រើស​ភាសា"

#: kombination.cpp:318
msgid "You can not join this game as you do not have the tile set for that language."
msgstr "អ្នក​មិន​បាន​ចូលរួម​ល្បែង​នេះ ដូច​ដែល​អ្នក​មិន​បាន​កំណត់​ដុំ​ឥដ្ឋ​សម្រាប់​ភាសា​នោះ ។"

#: kombination.cpp:318
msgid "No Valid Tiles Set"
msgstr "គ្មាន​ការ​កំណត់​ដុំ​ឥដ្ឋ​ត្រឹមត្រូវ"

#: kombination.cpp:352
msgid "The connection to the server has been lost. Can not continue the game"
msgstr "ការ​តភ្ជាប់​ទៅ​ម៉ាស៊ីន​បម្រើ​បាន​បាត់បង់ ។ មិន​អាច​បន្ត​ល្បែង"

#: kombination.cpp:352 kombination.cpp:517
msgid "Server Error"
msgstr "កំហុស​ម៉ាស៊ីន​បម្រើ​"

#: kombination.cpp:471
msgid "You can not create games without name."
msgstr "អ្នក​មិន​អាច​បង្កើត​ល្បែង​ដោយ​គ្មាន​ឈ្មោះ ។"

#: kombination.cpp:471
msgid "Name can not be empty"
msgstr "ឈ្មោះ​មិន​អាច​ទទេ"

#: kombination.cpp:495
msgid "Join as Player"
msgstr "ចូលរួម​ជា​អ្នក​លេង"

#: kombination.cpp:496 kombination.cpp:500
msgid "Join as Spectator"
msgstr "ចូលរួម​ជា​អក្ន​សង្កេត"

#: kombination.cpp:497
msgid "Join as..."
msgstr "ចូលរួម​ជា..."

#: kombination.cpp:497
msgid "Play as..."
msgstr "លេង​ជា..."

#: kombination.cpp:505
msgid ""
"You can not join this game as you do not have the dictionary of the game "
"language"
msgstr "អ្នក​មិន​អាច​ចូលរួម ដែល​អ្នក​មិន​មាន​វចនានុក្រម​នៃ​ភាសា​ខ្មែរ"

#: kombination.cpp:505
msgid "Language missing"
msgstr "បាត់​ភាសា"

#: kombination.cpp:511
msgid "Client Error"
msgstr "កំហុស​ម៉ាស៊ីន​ភ្ញៀវ"

#: kombination.cpp:531
msgid "Send word"
msgstr "ផ្ញើ​ពាក្យ"

#: kombination.cpp:543
msgid "Set me as not ready"
msgstr "កំណត់​ខ្ញុំ​ជា​រួចរាល់"

#: kombination.cpp:557
msgid ""
"You have placed no tiles during this turn. Do you want to pass the turn or "
"come back placing tiles?"
msgstr "អ្នក​មិន​បាន​ដាក់​ដុំ​ឥដ្ឋ​កំឡុង​ពេល​វេន​នេះ ។ តើ​អ្នក​ចង់​បន្ត​វេន ឬ​ត្រឡប់​មក​ដាក់​ដុំ​ឥដ្ឋ​វិញ?"

#: kombination.cpp:557
msgid "No Tiles Added"
msgstr "មិន​បាន​បន្ថែម​ដុំ​ឥដ្ឋ"

#: kombination.cpp:557
msgid "Pass"
msgstr "បញ្ជូន"

#: kombination.cpp:579
msgid "The first word of a game should cover the central position."
msgstr "ពាក្យ​នៃ​ល្បែង​គួរ​តែ​រួម​បញ្ចូល​ទាំង​ចំណុច​កណ្ដាល ។"

#: kombination.cpp:582
