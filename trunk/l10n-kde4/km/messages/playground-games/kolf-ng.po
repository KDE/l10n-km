#: editor/hmcreator-eraserbutton.cpp:30
msgid "Eraser"
msgstr "ជ័រលុប"

#: editor/hmcreator-eraserbutton.cpp:31
msgid "Paint on areas of the heightmap to reset those to the lowest height."
msgstr "គូរ​លើ​ផ្ទៃ​​ផែនទី​កម្ពស់​ដើម្បី​កំណត់​កម្ពស់​ដែល​ទាប​ទាំងអស់​នោះ​ឡើងវិញ ។"

#: editor/hmcreator-penbutton.cpp:31
msgid "Pen"
msgstr "ប៊ិច"

#: editor/hmcreator-penbutton.cpp:32
msgid "Paint on areas of the heightmap to set those to some fixed height."
msgstr "គូរ​លើ​ផ្ទៃផែនទី​កម្ពស់​ដើម្បី​កំណត់​កម្ពស់​ថេរ​ទាំងអស់​នោះ​ឡើងវិញ ។"

#: editor/hmcreator-fillbutton.cpp:32
msgid "Fill selection"
msgstr "បំពេញ​ជម្រើស"

#: editor/hmcreator-fillbutton.cpp:33
msgid ""
"Fills the selected area (or everything if nothing has been selected) with a "
"smooth gradient."
msgstr ""
"បំពេញ​ផ្ទៃ​ដែល​បាន​ជ្រើស (ឬ​គ្រប់យ៉ាង​​ ប្រសិនបើ​មិន​បាន​ជ្រើស​អ្វី​សោះ) "
"ជាមួយ​ជម្រាល​រលូន ។"

#: editor/hmcreator-ellipseselectbutton.cpp:29
msgid "Select ellipsoidal area"
msgstr "ជ្រើស​ផ្ទៃ​ ellipsoidal"

#: editor/hmcreator-ellipseselectbutton.cpp:30
msgid ""
"Restrict further operations to a certain ellipsoidal area of the heightmap."
msgstr "ដាក់​កម្រិត​​ប្រតិបត្តិការ​​ផ្សេង​ទៀត​​ចំពោះ​ផ្ទៃ​ ellipsoidal ជាក់លាក់​របស់​ផែនទី​កម្ពស់ ។"

#: editor/hmcreator-drawingboard.cpp:34
msgid "Terrain heightmap"
msgstr "ផែនទី​កម្ពស់ Terrain"

#: editor/hmcreator-allselectbutton.cpp:28
msgid "Clear selection"
msgstr "សម្អាត​ជម្រើស"

#: editor/hmcreator-allselectbutton.cpp:29
msgid "Clears any previous selection."
msgstr "សម្អាត​​ជម្រើស​​ណាមួយ​ពីមុន ។"

#: editor/blender-widget.cpp:31
msgid "Texture blender"
msgstr "កម្មវិធី​លាយ​វាយនភាព"

#: editor/blender-widget.cpp:45
msgid "Regenerate texture"
msgstr "បង្កើត​វាយនភាព​ឡើងវិញ"

#: editor/hmcreator-toolbox.cpp:35
msgid "Heightmap toolbox"
msgstr "ប្រអប់​ឧបករណ៍​ផែនទី​កម្ពស់"

#: editor/hmcreator-rectselectbutton.cpp:29
msgid "Select rectangular area"
msgstr "ជ្រើស​ផ្ទៃ​រាង​ចតុកោណកែង"

#: editor/hmcreator-rectselectbutton.cpp:30
msgid ""
"Restrict further operations to a certain rectangular area of the heightmap."
msgstr "ដាក់​កម្រិត​ប្រតិបត្តិការ​ផ្សេង​ទៀត​ចំពោះ​ផ្ទៃ​រាង​ចតុកោណ​ជាក់លាក់​របស់​ផែនទី​កម្ពស់ ។"

#: editor/blender-itemeditor.cpp:31
