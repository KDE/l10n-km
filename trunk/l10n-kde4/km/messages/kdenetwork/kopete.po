#. i18n: file ./kopete/addcontactwizard/addcontactwizard_base.ui line 16
#: rc.cpp:1087
msgid "Contact Addition Wizard"
msgstr "អ្នក​ជំនួយការ​បន្ថែម​ទំនាក់ទំនង"

#. i18n: tag string
#. i18n: file ./kopete/addcontactwizard/addcontactwizard_base.ui line 23
#: rc.cpp:1090
msgid "Introduction"
msgstr "សេចក្ដីណែនាំ"

#. i18n: tag string
#. i18n: file ./kopete/addcontactwizard/addcontactwizard_base.ui line 44
#: rc.cpp:1093
msgid ""
"<h2>Welcome to the Add Contact Wizard</h2>\n"
"\n"
"<p>This wizard will guide you through the process of adding a new contact to "
"Kopete.</p>"
msgstr ""
"<h2>សូម​ស្វាគមន៍​មក​កាន់​អ្នក​ជំនួយការ​បន្ថែម​ទំនាក់ទំនង</h2>\n"
"\n"
"<p>អ្នក​ជំនួយ​ការ​នឹង​ណែ​នាំ​អ្នក​អំពី​ដំណើរការ​នៃ​ការ​បន្ថែម​ទំនាក់ទំនង​ថ្មី​ទៅ Kopete ។</p>"

#. i18n: tag string
#. i18n: file ./kopete/addcontactwizard/addcontactwizard_base.ui line 59
#: rc.cpp:1098
msgid ""
"<p>Kopete shares contact information with the KDE Addressbook.  This gives "
"you seamless integration between instant messaging, e-mail and other "
"personal information management applications.</p>\n"
"<p>If you prefer not to store instant messaging information in the KDE "
"Addressbook, uncheck the box below.</p>"
msgstr ""
"<p>Kopete ចែករំលែក​ព័ត៌មាន​ទំនាក់ទំនង​ជាមួយ​នឹង​អាសយដ្ឋាន KDE ។ លក្ខណៈ​នេះ​អាច​បង្ក​ឲ្យ​មាន​លក្ខណៈ​"
"ងាយស្រួល​ដល់​អ្នក នៅ​ពេល​ប្រើប្រាស់​កម្មវិធី​ផ្ញើ​សារ​បន្ទាន់ កម្មវិធី​ផ្ញើអ៊ីមែល និង កម្មវិធី​គ្រប់គ្រង​ព័ត៌មាន​ផ្ទាល់​"
"ខ្លួន​ផ្សេង​ទៀត ។</p>\n"
"<p>បើ​អ្នក​មិន​ចង់​ទុក​ព័ត៌មាន​ការ​ផ្ញើសារ​បន្ទាន់ នៅ​ក្នុង​សៀវភៅអាសយដ្ឋាន KDE ទេ សូម​ដោះធីក​ពី​ប្រអប់​ខាង​"
"ក្រោម ។</p>"

#. i18n: tag string
