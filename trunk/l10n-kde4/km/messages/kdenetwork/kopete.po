#: libkopete/kopetepassword.cpp:274
msgid "Store &Unsafe"
msgstr "ទុក​ដោយ​គ្មាន​សុវត្ថិភាព"

#: libkopete/kopetegroup.cpp:45
msgid "Not in your contact list"
msgstr "មិន​ស្ថិត​ក្នុង​បញ្ជី​ទំនាក់ទំនង​របស់​អ្នក​ឡើយ"

