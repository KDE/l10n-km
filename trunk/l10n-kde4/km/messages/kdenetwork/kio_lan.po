#: kio_lan.cpp:141
#| msgid ""
#| "<qt>The Lisa daemon does not appear to be running.<p>In order to use the "
#| "LAN Browser the Lisa daemon must be installed and activated by the system "
#| "administrator."
msgid ""
"<qt>The Lisa daemon does not appear to be running.<br /><br />In order to "
"use the LAN Browser the Lisa daemon must be installed and activated by the "
"system administrator.</qt>"
msgstr "<qt>ដេមិន Lisa មិន​កំពុង​រត់​ទេ ។<br /><br />ដើម្បី​ប្រើកម្មវិធី​រុករក LAN គឺ​ត្រូវ​ដំឡើង​ដេមិន Lisa និង​ធ្វើ​ឲ្យ​វា​សកម្ម​ដោយ​អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ ។</qt>"

#: kio_lan.cpp:189 kio_lan.cpp:208
