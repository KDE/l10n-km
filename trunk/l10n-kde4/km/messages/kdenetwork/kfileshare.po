msgid ""
"<qt>There is already a share with the name <strong>%1</strong>.<br /> Please "
"choose another name.</qt>"
msgstr ""
"<qt>មាន​ការ​ចែក​រំលែក​ជាមួយ​ឈ្មោះ <strong>%1</strong> រួច​ហើយ ។<br> សូម​ជ្រើ​សរើស​ឈ្មោះ​ផ្សេង​"
"ទៀត ។</qt>"
