#: setupwizard.cpp:65
msgid "LISa Network Neighborhood Setup"
msgstr "រៀបចំ​បណ្តាញ​ជិត​ខាង​​ LISa"

#: setupwizard.cpp:73 setupwizard.cpp:538
msgid "Advanced Settings"
msgstr "ការ​កំណត់​កម្រិត​ខ្ពស់"

#: setupwizard.cpp:128
msgid ""
"<qt><p>This wizard will ask you a few questions about your network.</p> "
"<p>Usually you can simply keep the suggested settings.</p> <p>After you have "
"finished the wizard, you will be able to browse and use shared resources on "
"your LAN, not only Samba/Windows shares, but also FTP, HTTP and NFS "
"resources exactly the same way.</p> <p>Therefore you need to setup the "
"<i>LAN Information Server</i> (LISa) on your machine. Think of the LISa "
"server as an FTP or HTTP server; it has to be run by root, it should be "
"started during the boot process and only one LISa server can run on one "
"machine.</p></qt>"
msgstr ""
"<qt><p>អ្នក​ជំនួយ​ការ​នេះ​នឹង​សួរ​អ្នក​នូវ​សំនួរ​មួយ​ចំនួន​អំពី​បណ្ដាញ​របស់​អ្នក ។</p> <p>ជានិច្ច​ជាកាល អ្នក​អាច​"
"រក្សា​ទុក​ការ​កំណត់​ដែល​បាន​ផ្ដល់​យោបល់ ។</p> <p>បន្ទាប់​ពី​អ្នក​បាន​បញ្ចប់​អ្នក​ជំនួយ​ការ អ្នក​នឹង​អាច​រុករក និង​"
"ប្រើ​ធនធាន​ដែល​ចែក​រំលែក​លើ​បណ្ដាញ​មូលដ្ឋាន​របស់​អ្នក មិនមែន​តែ Samba/វីនដូ ទេ​ដែល​ចែក​រំលែក ប៉ុន្តែ​"
"ធនធាន FTP, HTTP និង NFS តាម​វិធី​ដូច​គ្នា​បេះបទ ។</p> <p>ហេតុ​ដូច្នេះ អ្នក​ត្រូវការ​រៀបចំ "
"<i>ម៉ាស៊ីន​បម្រើ​ព័ត៌មាន LAN</i> (LISa) នៅ​លើ​ម៉ាស៊ីន​របស់​អ្នក ។ គិត​ថា​ម៉ាស៊ីន​បម្រើ LISa ជា​ម៉ាស៊ីន​"
"បម្រើ FTP ឬ HTTP ។ វា​ត្រូវ​តែ​រត់​ដោយ root វា​គួរ​តែ​ត្រូវ​បាន​ចាប់ផ្ដើម​ដោយ​ដំណើរ​ការ​ចាប់ផ្ដើម និង​តែ​"
"ម៉ាស៊ីន​បម្រើ LISa មួយ​ប៉ុណ្ណោះ អាច​រត់​លើ​ម៉ាស៊ីន​មួយ ។</p></qt>"

#: setupwizard.cpp:151
msgid ""
"<qt><p>More than one network interface card was found on your system.</"
"p><p>Please choose the one to which your LAN is connected.</p></qt>"
msgstr ""
"<qt><p>ចំណុច​ប្រទាក់កាត​បណ្តាញច្រើនជាមួយ មិនត្រូវបានរកឃើញនៅ​ក្នុង​ប្រព័ន្ធរបស់អ្នកទេ ។ </"
"p><p>សូមជ្រើសយក LAN មួយណា​ដែល​អ្នក​បាន​ភ្ជាប់ ។</p></qt>"

#: setupwizard.cpp:168
msgid ""
"<qt><p><b>No network interface card was found on your system.</b></"
"p><p>Possible reason: no network card is installed. You probably want to "
"cancel now or enter your IP address and network manually</p>Example: "
"<code>192.168.0.1/255.255.255.0</code>.</qt>"
msgstr ""
"<qt><p><b>គ្មាន​ចំណុច​ប្រទាក់​កាត​បណ្តាញ ត្រូវ​បាន​រក​ឃើញ​នៅ​លើ​បណ្តាញ​របស់​អ្នក​ទេ ។</b></p><p>ហេតុផល​"
"មិន​អាច​ទៅរូច ៖ គ្មាន​កាត​បណ្តាញ​ត្រូវ​បាន​ដំឡើងនោះទេ ។ អ្នក​ប្រហែលជា​ចង់​បោះបង់​ចោល​ឥឡូវ​នេះ ឬ​បញ្ចូល​"
"អាសយដ្ឋាន IP និង​បណ្តាញ​កំណត់​ដោយ​ដៃ​</p>ឧទាហរណ៍ ៖<code>192.168.0.1/255.255.255.0</"
"code> ។</qt>"

#: setupwizard.cpp:190
msgid "There are two ways LISa can search hosts on your network."
msgstr "មាន​វិធី​ពីរ​ដែល LISa អាច​ស្វែងរក​ម៉ាស៊ីន​ជាច្រើន​នៅ​លើ​បណ្តាញ​របស់​អ្នក ។"

#: setupwizard.cpp:192
msgid "Send pings"
msgstr "ផ្ញើ​ភីង"

#: setupwizard.cpp:193
msgid ""
"All hosts with TCP/IP will respond,<br />whether or not they are samba "
"servers.<br />Don't use it if your network is very large, i.e. more than "
"1000 hosts.<br />"
msgstr ""
"គ្រប់​ម៉ាស៊ីន​ទាំងអស់​ជាមួយ TCP/IP នឹង​ឆ្លើយតប <br />ថា​តើ​ពួក​វា​មិនមែន​ជា ម៉ាស៊ីន​បំរើ samba ។<br />កុំ​"
"ប្រើ​វា បើ​មាន​បណ្តាញ​ធំ ឧទាហណ៍ មាន​ម៉ាស៊ីន​ច្រើន​ជាង ១០០០ គ្រឿង ។<br />"

#: setupwizard.cpp:198
msgid "Send NetBIOS broadcasts"
msgstr "ផ្ញើ NetBIOS ដើម្បី​ផ្សាយ"

#: setupwizard.cpp:199
msgid ""
"You need to have the samba package (nmblookup) installed.<br />Only samba/"
"windows servers will respond.<br />This method is not very reliable.<br /"
">You should enable it if you are part of a large network."
msgstr ""
"អ្នក​ត្រូវ​ដំឡើង​កញ្ចាប់​ samba (nmblookup) ។<br>មាន​តែ​​​ម៉ាស៊ីនបម្រើ samba/windows តែ​មួយ​គត់​ដែល​"
"វា​នឹង​ឆ្លើយតប <br>វិធីសាស្ត្រ​នេះ​គឺ​មិន​អាច​ទុក​ចិត្ត​បាន ។<br>អ្នក​ត្រូវ​អនុញ្ញាត​វា បើ​អ្នក​ជា​ផ្នែក​មួយ​នៃ​"
"បណ្តាញ​ធំ ។"

#: setupwizard.cpp:209 setupwizard.cpp:237 setupwizard.cpp:314
#: setupwizard.cpp:365
msgid "<b>If unsure, keep it as is.</b>"
msgstr "<b>ប្រសិន​បើ​មិន​ច្បាស់ ទុក​វា​នៅ​ដដែល ។</b>"

#: setupwizard.cpp:218
msgid ""
"All IP addresses included in the specified range will be pinged.<br />If you "
"are part of a small network, e.g. with network mask 255.255.255.0<br />use "
"your IP address/network mask.<br />"
msgstr ""
"គ្រប់​អាស័យដ្ឋាន IP រួម​បញ្ចូល​ទាំង​ក្នុង​លំដាប់​ជាក់លាក់​មួយ នឹង​ត្រូវ​បាន​ភីង ។<br>បើ​អ្នក​ជា​ផ្នែក​មួយ នៃ​បណ្តាញ​"
"តូច ឧទាហរណ៍ ៖ ជាមួយ​របាំង​បណ្តាញ 255.255.255.0<br>ប្រើ​អាស័យដ្ឋាន IP របាំង​បណ្តាញ ។<br>"

#: setupwizard.cpp:224
msgid ""
"<br />There are four ways to specify address ranges:<br />1. IP address/"
"network mask, like <code>192.168.0.0/255.255.255.0;</code><br />2. single IP "
"addresses, like <code>10.0.0.23;</code><br />3. continuous ranges, like "
"<code>10.0.1.0-10.0.1.200;</code><br />4. ranges for each part of the "
"address, like <code>10-10.1-5.1-25.1-3;</code><br />You can also enter "
"combinations of 1 to 4, separated by \";\", like<br /"
"><code>192.168.0.0/255.255.255.0;10.0.0.0;10.0.1.1-10.0.1.100;</code><br />"
msgstr ""
"<br>មាន​វិធីសាស្ត្រ​ ៤ យ៉ាង​ដើម្បី​បញ្ជាក់​ជួរ​អាសយដ្ឋាន ៖ <br>១. អាស័យដ្ឋាន IP /របាំងបណ្តាញ "
"ដូចជា<code>192.168.0.0/255.255.255.0;</code><br>២. IP  តែមួយគត់ ដូចជា "
"<code>10.0.0.23;</code><br>៣. ជួរ​បន្ត​គ្នា ដូចជា <code>10.0.1.0-10.0.1.200;</"
"code><br>៤. ជួរ​សម្រាប់​ផ្នែក​នីមួយៗ​នៃ​អាសយដ្ឋាន ដូចជា <code>10-10.1-5.1-25.1-3;</"
"code><br>អ្នក​អាច​បញ្ចូល​បន្សំ​នៃ ១ ដល់ ៤ ផង​ដែរ ដែល​បំបែក​ដោយ \";\", ដូច​"
"ជា<br><code>192.168.0.0/255.255.255.0;10.0.0.0;10.0.1.1-10.0.1.100;</"
"code><br>"

#: setupwizard.cpp:246
msgid ""
"<qt>This is a security related setting.<br />It provides a simple IP address "
"based way to specify \"trusted\" hosts.<br />Only hosts which fit into the "
"addresses given here are accepted by LISa as clients. The list of hosts "
"published by LISa will also only contain hosts which fit into this scheme."
"<br />Usually you enter your IP address/network mask here.</qt>"
msgstr ""
"<qt>នេះ​គឺ​ជា​ការ​កំណត់​ទាក់ទង​សុវត្ថិភាព ។<br />វា​ផ្ដល់​នូវ​វិធី​ដែល​ផ្អែក​លើ​អាសយដ្ឋាន​ធម្មតា​ដើម្បី​បញ្ជាក់​"
"ម៉ាស៊ីន \"ដែល​ទុក​ចិត្ត\" ។<br />មាន​តែ​ម៉ាស៊ីន ដែល​សម​ទៅ​នឹង​អាសយដ្ឋាន​ដែល​ផ្ដល់​ឲ្យ​នៅ​ទីនេះ ត្រូវ​បាន​ទទួល​"
"ដោយ LISa ម៉ាស៊ីន​ភ្ញៀវ ។ បញ្ជី​ម៉ាស៊ីន​ដែល​បោះពុម្ព​ដោយ LISa នឹង​មាន​តែ​ម៉ាស៊ីន​ដែល​សម​ទៅ​នឹង​គ្រោង​នេះ ។"
"<br />ជា​ធម្មតា​អ្នក​បញ្ចូល​អាសយដ្ឋាន/របាំង​បណ្ដាញ​របស់​អ្នក​ទីនេះ ។</qt>"

#: setupwizard.cpp:261 setupwizard.cpp:284
msgid "<qt><b>If unsure, keep it as is.</b></qt>"
msgstr "<qt><b>ប្រសិន​បើ​មិន​ច្បាស់ ទុក​វា​នៅ​ដដែល ។</b></qt>"

#: setupwizard.cpp:270
msgid ""
"<qt><br />Enter your IP address and network mask here, like "
"<code>192.168.0.1/255.255.255.0</code></qt>"
msgstr ""
"<qt><br />បញ្ចូល​អសយដ្ឋាន IP និង​របាំង​បណ្តាញ​របស់​អ្នក​ទីនេះ "
"ដូចជា<code>192.168.0.1/255.255.255.0</code></qt>"

#: setupwizard.cpp:275
msgid ""
"<qt><br />To reduce the network load, the LISa servers in one network<br /"
">cooperate with each other. Therefore you have to enter the broadcast<br /"
">address here. If you are connected to more than one network, choose <br /"
">one of the broadcast addresses.</qt>"
msgstr ""
"<qt><br />ដើម្បី​កាត់​បន្ថយ​បន្ទុក​បណ្ដាញ ម៉ាស៊ីន​បម្រើ LISa ក្នុង​បណ្ដាញ​មួយ<br />សហប្រតិបត្តិការ​ជាមួយ​"
"គ្នា ។ ហេតុ​ដូច្នេះ អ្នក​ត្រូវ​តែ​បញ្ចូល​អាសយដ្ឋាន​ផ្សាយ<br />នៅ​ទីនេះ ។ បើ​អ្នក​តភ្ជាប់​ទៅ​បណ្ដាញ​ច្រើន​"
"ជាង​មួយ ជ្រើស <br />អាសយដ្ឋាន​ផ្សាយ​មួយ ។</qt>"

#: setupwizard.cpp:295
msgid ""
"<br />Enter the interval after which LISa, if busy, will update its host "
"list."
msgstr "<br />បញ្ចូល​ចន្លោះ​ពេល បន្ទាប់​ពី LISa បើ​រវល់ នឹង​ធ្វើ​ឲ្យ​ទាន់​សម័យ​បញ្ជី​ម៉ាស៊ីន​របស់​វា ។"

#: setupwizard.cpp:303
msgid ""
"<br />Please note that the update interval will grow automatically by up to "
"16 times the value you enter here, if nobody accesses the LISa server. So if "
"you enter 300 sec = 5 min here, this does not mean that LISa will ping your "
"whole network every 5 minutes. The interval will increase up to 16 x 5 min = "
"80 min."
msgstr ""
"<br />សូម​ចំណាំ​ថា ចន្លោះ​ពេល​ភាព​ទាន់​សម័យ​នឹង​បង្កើន​ដោយ​ស្វ័យ​ប្រវត្តិ​ដល់​ទៅ ១៦ ដង តម្លៃ​ដែល​អ្នក​បញ្ចូល​"
"ទីនេះ បើ​គ្មាន​នរណា​ចូល​ដំណើរ​ការ​ម៉ាស៊ីន​បម្រើ LISa ។ ដូច្នេះ​បើ​អ្នក​បញ្ចូល 300 វិនាទី = 5 នាទី ទីនេះ "
"នេះ​មិន​មាន​ន័យ​ថា LISa នឹង​ភីង​បណ្ដាញ​ទាំងមូល​របស់​អ្នក​រាល់ 5 នាទី ទេ ។ ចន្លោះ​ពេល​នឹង​បង្កើន​ដល់​ទៅ 16 "
"x 5 នាទី = 80 នាទី ។"

#: setupwizard.cpp:324
msgid ""
"This page contains several settings you usually only<br />need if LISa "
"doesn't find all hosts in your network."
msgstr ""
"ទំព័រ​នេះ​មាន​ការ​កំណត់​មួយ​ចំនួន ដែល​អ្នក<br />ត្រូវការ​ជានិច្ច​ជាកាល បើ LISa មិន​រក​ឃើញ​ម៉ាស៊ីន​ទាំងអស់​ក្នុង​"
"បណ្ដាញ​របស់​អ្នក ។"

#: setupwizard.cpp:327
msgid "Re&port unnamed hosts"
msgstr "រាយការណ៍​ម៉ាស៊ីន​ដែល​គ្មាន​ឈ្មោះ"

#: setupwizard.cpp:328
#| msgid ""
#| "Should hosts for which LISa can't resolve the name be included in the "
#| "host list?<br>"
msgid ""
"Should hosts for which LISa can't resolve the name be included in the host "
"list?<br />"
msgstr "គួរ​តែ​ម៉ាស៊ីន​សម្រាប់ LISa មិន​អាច​ដោះស្រាយ​ឈ្មោះ​ដែល​ត្រូវ​បាន​បញ្ចូល​ក្នុង​បញ្ជី​ម៉ាស៊ីន?<br />"

#: setupwizard.cpp:332
msgid "Wait for replies after first scan"
msgstr "រង់ចាំ​​ការ​ឆ្លើយតប​ បន្ទាប់​ពី​ការ​ស្កេន​ជា​លើក​ដំបូង"

#: setupwizard.cpp:337
#| msgid ""
#| "How long should LISa wait for answers to pings?<br>If LISa doesn't find "
#| "all hosts, try to increase this value.<br>"
msgid ""
"How long should LISa wait for answers to pings?<br />If LISa doesn't find "
"all hosts, try to increase this value.<br />"
msgstr "តើ​រយៈ​ពេល​ប៉ុន្មាន​ដែល LISa គួរ​រង់ចាំ​ចម្លើយ​ដើម្បី​ភីង?<br />បើ LISa រក​មិន​ឃើញ​ម៉ាស៊ីន​ទាំងអស់ ព្យាយាម​បង្កើន​តម្លៃ​នេះ ។<br />"

#: setupwizard.cpp:341
msgid "Max. number of pings to send at once"
msgstr "ចំនួន​អតិបរមា​នៃ​ភីង​សម្រាប់​ផ្ញើ​ម្តង"

#: setupwizard.cpp:346
#| msgid ""
#| "How many ping packets should LISa send at once?<br>If LISa doesn't find "
#| "all hosts you could try to decrease this value.<br>"
msgid ""
"How many ping packets should LISa send at once?<br />If LISa doesn't find "
"all hosts you could try to decrease this value.<br />"
msgstr "តើ​មាន​កញ្ចប់​​ភីង​ចំនួន​ប៉ុន្មាន​ត្រូវ​បាន LISa បញ្ចូន​ចេញ​តែ​ម្ដង?<br />ប្រសិន​បើ​ LISa មិន​បាន​ស្វែង​រក​គ្រប់​ម៉ាស៊ីន​ទេ​ អ្នក​អាច​ព្យាយាម​បន្ថយ​ចំនួន​នេះ ។​<br>"

#: setupwizard.cpp:349
msgid "Al&ways scan twice"
msgstr "ស្កេន​ពីរ​ដង​ជានិច្ច"

#: setupwizard.cpp:353
msgid "Wait for replies after second scan"
msgstr "រង់ចាំ​ការ​ឆ្លើយតប បន្ទាប់​ពី​ស្កេន​លើក​ទីពីរ"

#: setupwizard.cpp:359
msgid "If LISa does not find all hosts, enable this option."
msgstr "បើ LISa រក​មិន​ឃើញ​ម៉ាស៊ីន​ទាំងអស់ បើក​ជម្រើស​នេះ ។"

#: setupwizard.cpp:375
#| msgid ""
#| "<br>Your LAN browsing has been successfully set up.<br><br>Make sure that "
#| "the LISa server is started during the boot process. How this is done "
#| "depends on your distribution and OS. Usually you have to insert it "
#| "somewhere in a boot script under <code>/etc</code>.<br>Start the LISa "
#| "server as root and without any command line options.<br>The config file "
#| "will now be saved to <code>/etc/lisarc</code>.<br>To test the server, try "
#| "<code>lan:/</code> in Konqueror.<br><br>If you have problems or "
#| "suggestions, visit http://lisa-home.sourceforge.net."
msgid ""
"<br />Your LAN browsing has been successfully set up.<br /><br />Make sure "
"that the LISa server is started during the boot process. How this is done "
"depends on your distribution and OS. Usually you have to insert it somewhere "
"in a boot script under <code>/etc</code>.<br />Start the LISa server as root "
"and without any command line options.<br />The config file will now be saved "
"to <code>/etc/lisarc</code>.<br />To test the server, try <code>lan:/</code> "
"in Konqueror.<br /><br />If you have problems or suggestions, visit http://"
"lisa-home.sourceforge.net."
msgstr ""
"<br />ការ​រុករក​បណ្ដាញ​មូលដ្ឋាន​របស់​អ្នក​បាន​ត្រូវ​ដំឡើង​ដោយ​ជោគជ័យ ។<br /><br />សូម​ប្រាកដ​ថា ម៉ាស៊ីន​បម្រើ LISa ត្រូវ​បាន​ចាប់ផ្ដើម​កំឡុង​ពេល​ដំណើរ​ការ​ចាប់ផ្ដើម ។ របៀប​នេះ​ធ្វើ​រួច​ផ្អែក​លើ​ការ​ចែកចាយ និង​ប្រព័ន្ធ​ដំណើរ​ការ​របស់​អ្នក ។ ជានិច្ច​ជាកាល អ្នក​ត្រូវ​តែ​បញ្ចូល​វា​នៅ​កន្លែង​ណា​មួយ​ក្នុង​ស្គ្រីប​ចាប់ផ្ដើម​ក្រោម <code>/etc</code> ។<br />ចាប់ផ្ដើម​ម៉ាស៊ីន​បម្រើ LISa ជា root "
"និង​ដោយ​គ្មាន​ជម្រើស​បន្ទាត់​ពាក្យ​បញ្ជា ។<br />ឯកសារ​កំណត់​រចនា​សម្ព័ន្ធ​នឹង​ត្រូវ​បាន​រក្សា​ទុក​ទៅ <code>/etc/lisarc</code> ។<br />ដើម្បី​សាកល្បង​ម៉ាស៊ីន​បម្រើ សាកល្បង <code>lan:/</code> "
"ក្នុង Konqueror ។<br /><br />បើ​អ្នក​មាន​បញ្ហា ឬ​ការ​ផ្ដល់​យោបល់ សូម​ទស្សាន http://"
"lisa-home.sourceforge.net ។"

#: setupwizard.cpp:463
msgid "Congratulations"
msgstr "អប់អរ​សាទរ"

#: setupwizard.cpp:488
#| msgid "You can use the same syntax as on the previous page.<br>"
msgid "You can use the same syntax as on the previous page.<br />"
msgstr "អ្នក​អាច​ប្រើ​វាក្យសម្ព័ន្ធ​ដូច​ទៅ​នឹង​វាក្យសម្ព័ន្ធ​មុន ។<br />"

#: setupwizard.cpp:490
#| msgid ""
#| "There are three ways to specify IP addresses:<br>1. IP address/network "
#| "mask, like<code> 192.168.0.0/255.255.255.0;</code><br>2. continuous "
#| "ranges, like<code> 10.0.1.0-10.0.1.200;</code><br>3. single IP addresses, "
#| "like<code> 10.0.0.23;</code><br>You can also enter combinations of 1 to "
#| "3, separated by \";\", <br>like<code> "
#| "192.168.0.0/255.255.255.0;10.0.0.0;10.0.1.1-10.0.1.100;</code><br>"
msgid ""
"<qt>There are three ways to specify IP addresses:<br />1. IP address/network "
"mask, like<code> 192.168.0.0/255.255.255.0;</code><br />2. continuous "
"ranges, like<code> 10.0.1.0-10.0.1.200;</code><br />3. single IP addresses, "
"like<code> 10.0.0.23;</code><br />You can also enter combinations of 1 to 3, "
"separated by \";\", <br />like<code> "
"192.168.0.0/255.255.255.0;10.0.0.0;10.0.1.1-10.0.1.100;</code><br /></qt>"
msgstr ""
"<qt>​មាន​វិធីបី​ដើម្បី​បញ្ជាក់​អាសយដ្ឋាន IP ៖<br />១. អាសយដ្ឋាន IP/របាំង​បណ្ដាញ ដូចជា<code> 192.168.0.0/255.255.255.0;</code><br />២. ជួរ​បន្ត​គ្នា ដូចជា<code> 10.0.1.0-10.0.1.200;</code><br />៣. អាសយដ្ឋាន IP តែ​មួយ ដូចជា<code> 10.0.0.23;</code><br />អ្នក​អាច​បញ្ចូល​បន្សំ​នៃ ១ ដល់ ៣ ដែល​បំបែក​ដោយ \";\", <br />ដូចជា<code> "
"192.168.0.0/255.255.255.0;10.0.0.0;10.0.1.1-10.0.1.100;</code><br /></qt>"

