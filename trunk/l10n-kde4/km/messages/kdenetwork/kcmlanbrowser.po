#: kcmkiolan.cpp:45
msgid "Show Links for Following Services"
msgstr "បង្ហាញ​តំណ​សំរាប់​សេវា​ខាងក្រោម"

#: kcmkiolan.cpp:48
msgid "FTP (TCP, port 21): "
msgstr "FTP (TCP ច្រក 21) ៖ "

#: kcmkiolan.cpp:49
msgid "HTTP (TCP, port 80): "
msgstr "HTTP (TCP ច្រក 80) ៖ "

#: kcmkiolan.cpp:50
msgid "NFS (TCP, port 2049): "
msgstr "NFS (TCP ច្រក 2049) ៖ "

#: kcmkiolan.cpp:51
msgid "Windows shares (TCP, ports 445 and 139):"
msgstr "ចែក​រំលែក​ (TCP ច្រក 445 និង 139) ៖"

#: kcmkiolan.cpp:52
msgid "Secure Shell/Fish (TCP, port 22): "
msgstr "សែល​ដែល​មាន​សុវត្តិភាព / Fish (TCP ច្រក 22) ៖ "

#: kcmkiolan.cpp:53
msgid "Show &short hostnames (without domain suffix)"
msgstr "បង្ហាញ​ឈ្មោះ​ម៉ាស៊ីន​ខ្លី (គ្មាន​បច្ច័យ​ដែន)"

#: kcmkiolan.cpp:58
msgid "Default LISa server host: "
msgstr "ម៉ាស៊ីន​បម្រើ​លំនាំ​ដើម LISa ៖ "

#: kcmlisa.cpp:66
msgid "Tell LISa Daemon How to Search for Hosts"
msgstr "ប្រាប់​ដេមិន LISa ពី​របៀប​ស្វែងរក​ម៉ាស៊ីន"

#: kcmlisa.cpp:70
msgid "Send &NetBIOS broadcasts using nmblookup"
msgstr "ផ្ញើ​ការ​ផ្សាយ NetBIOS ដោយ​ប្រើ nmblookup"

#: kcmlisa.cpp:71
msgid "Only hosts running SMB servers will answer"
msgstr "មាន​តែ​ម៉ាស៊ីន​ដែល​រត់​ម៉ាស៊ីន​បម្រើ SMB នឹង​ឆ្លើយ"

#: kcmlisa.cpp:73
msgid "Send &pings (ICMP echo packets)"
msgstr "ផ្ញើ​ភីង (ICMP echo កញ្ចប់)"

#: kcmlisa.cpp:74
msgid "All hosts running TCP/IP will answer"
msgstr "ម៉ាស៊ីន​ទាំងអស់​ដែល​រត់ TCP/IP នឹង​ឆ្លើយ"

#: kcmlisa.cpp:81
msgid "To these &IP addresses:"
msgstr "ទៅ​កាន់​អសយដ្ឋាន IP ទាំងនេះ ៖"

#: kcmlisa.cpp:82
msgid ""
"Enter all ranges to scan, using the format "
"'192.168.0.1/255.255.255.0;10.0.0.1;255.0.0.0'"
msgstr ""
"បញ្ចូល​ជួរ​ទាំងអស់​ដើម្បី​ស្កេន ដោយ​ប្រើ​ទ្រង់ទ្រាយ "
"'192.168.0.1/255.255.255.0;10.0.0.1;255.0.0.0'"

#: kcmlisa.cpp:94
msgid "&Broadcast network address:"
msgstr "អាសយដ្ឋាន​បណ្ដាញ​ផ្សាយ ៖"

#: kcmlisa.cpp:95
msgid "Your network address/subnet mask (e.g. 192.168.0.0/255.255.255.0;)"
msgstr "អស័ដ្ឋាន​បណ្តាញ​/របាំង​បណ្តាញ​របស់​អ្នក (ឧទាហរណ៍ 192.168.0.0/255.255.255.0;)"

#: kcmlisa.cpp:103
msgid "&Trusted IP addresses:"
msgstr "អសយដ្ឋាន IP ដែល​ជឿ​ទុក​ចិត្ត ៖"

#: kcmlisa.cpp:104
msgid "Usually your network address/subnet mask (e.g. 192.168.0.0/255.255.255.0;)"
msgstr "ជា​ធម្មតា​អសយដ្ឋាន​បណ្តាញ/របាំង​បណ្តាញ​របស់​អ្នក (ឧទាហរណ៍ 192.168.0.0/255.255.255.0;)"

#: kcmlisa.cpp:120
msgid "Setup Wizard..."
msgstr "រៀបចំ​អ្នក​ជំនួយ​ការ..."

#: kcmlisa.cpp:123
msgid "&Suggest Settings"
msgstr "ការ​កំណត់​ការ​ផ្ដល់​យោបល់"

#: kcmlisa.cpp:127
msgid "Ad&vanced Settings..."
msgstr "ការ​កំណត់​កម្រិត​ខ្ពស់..."

#: kcmlisa.cpp:130
msgid "Advanced Settings for LISa"
msgstr "ការ​កំណត់​កម្រិត​ខ្ពស់សំរាប់ LISa"

#: kcmlisa.cpp:138
msgid "&Additionally Check These Hosts"
msgstr "ពិនិត្យ​ម៉ាស៊ីន​ទាំងនេះ​បន្ថែម"

#: kcmlisa.cpp:140
msgid "The hosts listed here will be pinged"
msgstr "ម៉ាស៊ីន​ដែល​រាយ​បញ្ជី​ទីនេះ​នឹង​ត្រូវ​បាន​ភីង"

#: kcmlisa.cpp:144
msgid "Show &hosts without DNS names"
msgstr "បង្ហាញ​ម៉ាស៊ីន​ដោយ​ពុំ​ចាំបាច់​មាន​ឈ្មោះ DNS"

#: kcmlisa.cpp:149
msgid "Host list update interval:"
msgstr "ចន្លោះ​ពេល​ធ្វើ​ឲ្យ​ទាន់​សម័យ​បញ្ជី​ម៉ាស៊ីន ៖"

#: kcmlisa.cpp:150 kcmlisa.cpp:155
msgid "Search hosts after this number of seconds"
msgstr "ស្វែងរក​ម៉ាស៊ីន​បន្ទាប់​ពី​ចំនួន​វិនាទី​នេះ​កន្លង​ផុត"

#: kcmlisa.cpp:154 setupwizard.cpp:301
msgid " sec"
msgstr " វិ."

#: kcmlisa.cpp:157
msgid "Always check twice for hosts when searching"
msgstr "ពិនិត្យ​ម៉ាស៊ីន​ពីរ​ដង​ជានិច្ច ពេល​ស្វែងរក"

#: kcmlisa.cpp:160
msgid "Wait for replies from hosts after first scan:"
msgstr "រង់ចាំ​ការ​ឆ្លើយតប​ពី​ម៉ាស៊ីន​បន្ទាប់​ពី​ការ​ស្កេន​លើក​ទីមួយ ៖"

#: kcmlisa.cpp:161 kcmlisa.cpp:166 kcmlisa.cpp:169 kcmlisa.cpp:174
msgid "How long to wait for replies to the ICMP echo requests from hosts"
msgstr "រយៈ​ពេល​ត្រូវ​រង់ចាំ​ការ​ឆ្លើយតប​ទៅ​សំណើ​បង្ហាញ ICMP ពី​ម៉ាស៊ីន"

#: kcmlisa.cpp:165 kcmlisa.cpp:173 setupwizard.cpp:336 setupwizard.cpp:358
msgid " ms"
msgstr " មី.វិ."

#: kcmlisa.cpp:168
msgid "Wait for replies from hosts after second scan:"
msgstr "រង់ចាំ​ការ​ឆ្លើយតប​ពី​ម៉ាស៊ីន បន្ទាប់​ពី​ស្កេន​លើក​ទីពីរ ៖"

#: kcmlisa.cpp:176
msgid "Max. number of ping packets to send at once:"
msgstr "ចំនួន​អតិបរមា​នៃ​កញ្ចប់​ភីង​ដើម្បី​ផ្ញើ​នៅ​ពេល​តែ​ម្ដង ៖"

#: kcmlisa.cpp:323
#, kde-format
msgid "Saving the results to %1 failed."
msgstr "ការ​រក្សា​ទុក​លទ្ធផល​ទៅ %1 បាន​​បរាជ័យ ។"

#: kcmlisa.cpp:332
msgid "No network interface cards found."
msgstr "រក​មិន​ឃើញ​កាត​ចំណុច​ប្រទាក់​បណ្តាញ ។"

#: kcmlisa.cpp:354
msgid ""
"You have more than one network interface installed.<br />Please make sure "
"the suggested settings are correct.<br /><br />The following interfaces were "
"found:<br /><br />"
msgstr ""
"អ្នក​បាន​ដំឡើង​ចំណុច​ប្រទាក់​បណ្តាញ​ច្រើន​ជាង​មួយ<br>សូម​ឲ្យ​ប្រាកដ​ថា ការ​ណែនាំ​រៀបចំ​គឺ ត្រឹមត្រូវ ។​"
"<br><br>ចំណុច​ប្រទាក់​ខាងក្រោម​នេះ​ត្រូវ​បាន​រក​ឃើញ​៖<br><br>"

#: kcmlisa.cpp:403
msgid ""
"The configuration has been saved to /etc/lisarc.\n"
"Make sure that the LISa daemon is started,\n"
" e.g. using an init script when booting.\n"
"You can find examples and documentation at http://lisa-home.sourceforge.net ."
msgstr ""
"ការ​កំណត់​​រចនាសម្ព័ន្ធ​ត្រូវ​បាន​រក្សា​ទៅ​កាន់​ទីតាំង /etc/lisarc.\n"
"ប្រាកដ​ថា​ LISa ដេមិន​បាន​ចាប់ផ្តើម ​\n"
" ឧទាហរណ៍ ការ​ប្រើប្រាស់​ស្គ្រីប init នៅ​ពេល​កំពុង​ចាប់ផ្តើម ។​\n"
"អ្នក​អាច​ស្វែងរក​ ឧទាហរណ៍ និង​ឯកសារ​នៅ​ទីតាំង​ http://lisa-home.sourceforge.net ។"

