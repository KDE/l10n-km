#, kde-format
msgid ""
"auction\n"
"ended"
msgstr ""
"បាន​បញ្ចប់​ការ\n"
"​លក់ឡាយឡុង"

#: auction.cpp:56
#, kde-format
msgid "No BuyNow Option"
msgstr "គ្មាន​ជម្រើស BuyNow"

#: auction.cpp:58
#, kde-format
