#: kfritz.desktop:2
msgctxt "Name"
msgid "KFritz"
msgstr "KFritz"

#: kfritz.desktop:30
msgctxt "GenericName"
msgid "Call notificator"
msgstr "កម្មវិធីជូន​ដំណឹង​​នៃ​ការ​ហៅ"

#: kfritz.desktop:52
msgctxt "Comment"
msgid ""
"Access call history and phone book of your Fritz!Box and get notifications "
"on incoming and outgoing calls."
msgstr ""
"ចូល​មើល​ប្រវត្តិ​ហៅ និង​សៀវភៅ​ទូរស័ព្ទ​នៃ Fritz!Box របស់​អ្នក​ ហើយ​យក​ការ​ជូនដំណឹង​​នៅ​ពេល​ហៅ​ចូល និង​ចេញ ។"

#: kfritz.notifyrc:5
msgctxt "Name"
msgid "Incoming Call"
msgstr "ការ​ហៅ​ចូល"

#: kfritz.notifyrc:32
msgctxt "Name"
msgid "Outgoing Call"
msgstr "ការ​ហៅ​ចេញ"

#: kfritz.notifyrc:58
msgctxt "Name"
msgid "Call got connected"
msgstr "ការ​ហៅ​ត្រូវបាន​តភ្ជាប់"

#: kfritz.notifyrc:82
msgctxt "Name"
msgid "Call got disconnected"
msgstr "ការ​ហៅ​ត្រូវ​បានផ្ដាច់"
