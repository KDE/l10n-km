msgstr "រៀប​ចំ​ឧបករណ៍​ប៊្លូធូស"

#: wizard/wizarddialog.cpp:102
msgid "This wizard will help to setup your Bluetooth devices."
msgstr "អ្នក​ជំនួយ​ការ​នេះ​នឹង​ជួយ​អ្នក​​ក្នុង​ការ​រៀបចំ​ឧបករណ៍​ប្ល៊ូធូស​របស់​អ្នក ។"

#: wizard/wizarddialog.cpp:120
msgid "Please select your Bluetooth device."
msgstr "សូម​ជ្រើស​ឧបករណ៍​ប៊្លូធូស​របស់​អ្នក ។"

#: wizard/wizarddialog.cpp:126
msgid "<b>If your Device is not in the List:</b>"
msgstr "<b>ប្រសិន​ឧបករណ៍​មិន​នៅ​ក្នុង​បញ្ជី ៖</b>"

#: wizard/wizarddialog.cpp:158
msgid "Select the PIN method to pair with the device"
msgstr "ជ្រើស​វិធី​សាស្ត្រ​ PIN ​ដើម្បី​ផ្គូ​ផ្គង​ជា​មួយ​ឧបករណ៍"

