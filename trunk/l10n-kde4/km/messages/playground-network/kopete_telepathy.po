#: telepathyaccount.cpp:122
msgid "&Change Alias..."
msgstr "ប្ដូរ​ឈ្មោះ​ក្លែងក្លាយ..."

#: telepathyaccount.cpp:126
msgid "Change &Avatar..."
msgstr "ផ្លាស់ប្ដូរ Avatar..."

#: telepathyaccount.cpp:531
#, kde-format
msgid "Creating account failed. Error was: %1 - %2"
msgstr "បាន​បរាជ័យ​​ក្នុង​ការ​បង្កើត​គណនី ។ កំហុស​គឺ ៖ %1  %2"

#: telepathyaccount.cpp:533
msgid "Error - Creating account"
msgstr "កំហុស  ក្នុង​ការ​បង្កើត​គណនី"

#: telepathyaccount.cpp:839
msgid "Change alias"
msgstr "បាន​ផ្លាស់ប្ដូរ​ឈ្មោះ​ក្លែងក្លាយ"

#: telepathyaccount.cpp:840
msgid "Enter the new alias by which you want to be visible to your friends:"
msgstr "បញ្ចូល​ឈ្មោះ​​ក្លែងក្លាយ​ថ្មី​​ដែល​អ្នក​​អាច​មើល​ឃើញ​មិត្តភ័ក្ដិ​របស់​អ្នក ៖"

#: telepathychatsession.cpp:51
msgid "S&hare My Desktop"
msgstr "ចែករំលែក​ផ្ទៃតុ​របស់​ខ្ញុំ"

#: telepathychatsession.cpp:298
msgid ""
"An error occurred sharing your desktop. Please ensure that you have krfb "
"installed."
msgstr "មាន​កំហុស​ក្នុង​ការ​ចែករំលែក​ផ្ទៃតុ​របស់​អ្នក ។ សូម​​ប្រាកដ​ថា​អ្នក​បាន​ដំឡើង krfb រួច​ហើយ ។"

#: telepathychatsession.cpp:300 telepathychatsession.cpp:304
msgid "Error - Share My Desktop"
msgstr "កំហុស  ចែករំលែក​ផ្ទៃតុ​របស់​ខ្ញុំ"

#: telepathychatsession.cpp:303
msgid "An unknown error occurred sharing your desktop."
msgstr "មាន​កំហុស​ដែល​មិន​ស្គាល់​ក្នុង​ការ​ចែករំលែក​ផ្ទៃតុ​របស់​ខ្ញុំ ។"

#: telepathycontact.cpp:118
msgid "(Re)request Presence Authorization"
msgstr "ស្នើ​ឲ្យ​មាន​សេចក្ដី​អនុញ្ញាត​ឡើង​វិញ"

#: telepathycontact.cpp:124
msgid "Send Presence Authorization"
msgstr "ផ្ញើ​សេចក្ដី​អនុញ្ញាត"

#: telepathycontact.cpp:130
msgid "Remove Presence Authorization"
msgstr "យក​សេចក្ដី​អនុញ្ញាត​ចេញ"

#: telepathycontact.cpp:243
msgid "Kopete File Transfer"
msgstr "ផ្ទេរ​ឯកសារ Kopete"

#: telepathycontact.cpp:457
#, kde-format
msgid ""
"The contact %1 disallowed %2 from receiving his/her presence. This account "
"will no longer be able to view his/her online status. Do you want to delete "
"the contact?"
msgstr ""
"ទាក់ទង %1 ដែល​មិន​បាន​អនុញ្ញាត​ឲ្យ %2 ពី​ការ​ទទួល​វត្តមាន របស់​គាត់/របស់​នាង ។ គណនី​នេះ​នឹង​មិន​អាច​មើល​"
"ឃើញ​ស្ថានភាព​ របស់​គាត/របស់​នាង​ លើ​បណ្ដាញ​បាន​ទៀត​ទេ​ឬ ?"

