#: sane_widget.cpp:331
msgid "No scanner device has been found."
msgstr "រក​មិនឃើញ​​ម៉ាស៊ីន​ស្កេន​ទេ ។"

#: sane_widget.cpp:375
msgid "Test Scanner"
msgstr "សាកល្បង​ម៉ាស៊ីន​ស្កេន"

#: sane_widget.cpp:449
msgid "Zoom in preview image"
msgstr "ពង្រីក​រូបភាព​មើល​ជា​មុន"

#: sane_widget.cpp:452
msgid "Zoom out preview image"
msgstr "បង្រួម​រូបភាព​មើល​ជា​មុន"

#: sane_widget.cpp:455
msgid "Zoom to selection of preview image"
msgstr "ពង្រីក​ទៅជម្រើស​របស់​រូបភាព​មើលជា​មុន"

#: sane_widget.cpp:458
msgid "Zoom to fit preview image"
msgstr "បង្រីក​ឲ្យ​សម​នឹង​រូបភាព​មើល​ជា​មុន"

#: sane_widget.cpp:464
msgid "Cancel current scan operation"
msgstr "បោះបង់​ប្រតិបត្តិការ​ស្កេន​បច្ចុប្បន្ន"

#: sane_widget.cpp:469
msgid "Scan preview image from device"
msgstr "វិភាគ​រក​រូបភាព​មើល​ជា​មុន​ពី​ឧបករណ៍"

#: sane_widget.cpp:472
msgid "Scan final image from device"
msgstr "វិភាគ​រក​រូបភាព​ចុងក្រោយ​ពី​ឧបករណ៍"

#: sane_widget.cpp:542
msgid "Option Level"
msgstr "កម្រិង​ជម្រើស"

#: sane_widget.cpp:685
msgid "Separate color intensity tables"
msgstr "បំបែក​តរាង​អាំងតង់ស៊ីតេ​ពណ៌"

#: sane_widget.cpp:1176
msgid "Scanning Failed!"
msgstr "បានបរាជ័យ​ក្នុងកា​រវិភាគ​រក !"

#: sane_widget.cpp:1605 sane_widget.cpp:1646
msgid ""
"The image data contains 16 bits per color, but QImage support only 8 bits "
"per color. The image data will be truncated to 8 bits per color."
msgstr ""
"ទិន្នន័យ​រូបភាព​មាន​ ១៦ ប៊ីត/ពណ៌ ប៉ុន្តែ​ QImage គាំទ្រ​តែ​ ៨ ប៊ីត/ពណ៌​ប៉ុណ្ណោះ ។ ទិន្នន័យ​រូបភាព​នឹង​ត្រូវ​"
"បានកាត់​ឲ្យ​ខ្លី​ទៅជា ៨ ប៊ីត/ពណ៌ ។"
