#: sane_widget.cpp:337
#| msgid "Test Scanner"
msgid "Tester"
msgstr "​ឧបករណ៍​សាកល្បង"

#: sane_widget.cpp:338
msgid "Model"
msgstr "គំរូ"

#: sane_widget.cpp:343
msgid "No scanner device has been found."
msgstr "រក​មិន​ឃើញ​ឧបករណ៍​ម៉ាស៊ីន​ស្កេន ។"

#: sane_widget.cpp:349
#| msgid "Test Scanner"
msgid "Select Scanner"
msgstr "ជ្រើស​ម៉ាស៊ីន​ស្កេន"

#: sane_widget.cpp:387
msgid "Test Scanner"
msgstr "សាកល្បង​ម៉ាស៊ីន​ស្កេន"

#: sane_widget.cpp:388
msgid "Test"
msgstr "សាកល្បង"

#: sane_widget.cpp:389
msgid "Debug"
msgstr "បំបាត់​កំហុស"

#: sane_widget.cpp:458
msgid "Zoom in preview image"
msgstr "ពង្រីក​ក្នុង​រូបភាព​មើលជា​មុន"

#: sane_widget.cpp:461
msgid "Zoom out preview image"
msgstr "បង្រួម​រូបភាព​​មើល​ជាមុន"

#: sane_widget.cpp:464
msgid "Zoom to selection of preview image"
msgstr "ពង្រីក​ទៅ​ជម្រើស​របស់​រូបភាព​មើល​ជា​មុន"

#: sane_widget.cpp:467
msgid "Zoom to fit preview image"
msgstr "ពង្រីក​ឲ្យ​សម​នឹង​រូបភាព​មើល​ជា​មុន"

#: sane_widget.cpp:473
msgid "Cancel current scan operation"
msgstr "បោះបង់​ប្រតិបត្តិ​ស្កេន​បច្ចុប្បន្ន"

#: sane_widget.cpp:478
msgid "Scan preview image from device"
msgstr "ស្កេន​រូបភាព​មើល​ជា​មុន​ពី​ឧបករណ៍"

#: sane_widget.cpp:481
msgid "Scan final image from device"
msgstr "ស្កេន​រូបភាព​ចុងក្រោយ​ពី​ឧបករណ៍"

#: sane_widget.cpp:543
msgid "Basic Options"
msgstr "ជម្រើស​មូលដ្ឋាន"

#: sane_widget.cpp:680
msgid "Separate color intensity tables"
msgstr "តារាង​អាំងតង់ស៊ីតេ​ពណ៌​ដោយ​ឡែក"

#: sane_widget.cpp:710
msgid "Other Options"
msgstr "ជ្រើស​ផ្សេងៗ"

#: sane_widget.cpp:1163
msgid "Scanning Failed!"
msgstr "កា​រស្កេន​បាន​បរាជ័យ !"

#: sane_widget.cpp:1592 sane_widget.cpp:1632
#| msgid ""
#| "The image data contains 16 bits per color, but QImage support only 8 bits "
#| "per color. The image data will be truncated to 8 bits per color."
msgid ""
"The image data contained 16 bits per color, but the color depth has been "
"truncated to 8 bits per color."
msgstr "ទិន្នន័យ​រូបភាព​មាន​ ១៦ ប៊ីត​/ពណ៌ ប៉ុន្តែ​ជម្រៅ​ពណ៌​ត្រូវ​បានកាត់​ឲ្យ​ខ្លី​ទៅ ៨ ប៊ីត/ពណ៌ ។"

