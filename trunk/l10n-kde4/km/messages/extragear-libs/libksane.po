#: labeled_gamma.cpp:58
msgid "Gamma"
msgstr "ហ្គាម៉ា"

#: radio_select.cpp:61
msgid "OK"
msgstr "យល់ព្រម"

#: radio_select.cpp:64
msgid "Cancel"
msgstr "បោះបង់"

#: sane_option.cpp:259
