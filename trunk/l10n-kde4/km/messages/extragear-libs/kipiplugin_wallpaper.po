#: plugin_wallpaper.cpp:62
msgid "&Set as Background"
msgstr "កំណត់​ជា​ផ្ទៃ​ខាង​ក្រោយ"

#: plugin_wallpaper.cpp:66
msgid "Centered"
msgstr "កណ្តាល"

#: plugin_wallpaper.cpp:72
msgid "Centered Tiled"
msgstr "ដាក់​កណ្ដាល​"

#: plugin_wallpaper.cpp:78
msgid "Centered Max-Aspect"
msgstr "ទិដ្ឋភាព​អតិ.​ដាក់​កណ្ដាល"

#: plugin_wallpaper.cpp:84
msgid "Tiled Max-Aspect"
msgstr "ទិដ្ឋភាព​អតិ.​ដែល​បានរៀប​ក្រឡា"

#: plugin_wallpaper.cpp:90
msgid "Scaled"
msgstr "បាន​ធ្វើ​មាត្រដ្ឋាន"

#: plugin_wallpaper.cpp:96
msgid "Centered Auto Fit"
msgstr "ដាក់​ឲ្យ​សម​កណ្ដាល​ឲ្យ​ស្វ័យ​ប្រវត្តិ"

#: plugin_wallpaper.cpp:102
msgid "Scale && Crop"
msgstr "ធ្វើមាត្រដ្ឋាន និង​ច្រិប"

#: plugin_wallpaper.cpp:194
msgid ""
"<qt><p>You selected a remote image. It needs to be saved to your local disk "
"to be used as a wallpaper.</p><p>You will now be asked where to save the "
"image.</p></qt>"
msgstr "<qt><p>អ្នក​បាន​ជ្រើស​រូបភាព​ពីចម្ងាយ ។ វា​តម្រូវ​ឲ្យ​រក្សាទុក​ទៅ​ថាស​មូលដ្ឋាន​របស់​អ្នក ត្រូវ​បាន​ប្រើ​ជា​​ផ្ទាំង​រូបភាព ។</p><p>ឥឡូវ​អ្ន​នឹង​ត្រូវ​បាន​សួរ​ពី​កន្លែង​ត្រូវ​រក្សាទុក​រូបភាព ។</p></qt>"

#: plugin_wallpaper.cpp:205
msgid "Change Background"
msgstr "ផ្លាស់ប្ដូរ​ផ្ទៃ​ខាង​ក្រោយ"

#: plugin_wallpaper.cpp:205
msgid "We can not change background."
msgstr "យើង​មិន​អាច​ផ្លាស់ប្ដូរ​ផ្ទៃ​ខាង​ក្រោយ​បាន​ទេ ។"

