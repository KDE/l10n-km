#: plugin_wallpaper.cpp:194
msgid ""
"<qt><p>You selected a remote image. It needs to be saved to your local disk "
"to be used as a wallpaper.</p><p>You will now be asked where to save the "
"image.</p></qt>"
msgstr "<qt><p>អ្នក​បានជ្រើស​រូបភាព​ពី​ចម្ងាយ ។ វា​តម្រូវ​ឲ្យ​រក្សាទុក​នៅ​ក្នុង​ថាស​មូលដ្ឋាន​របស់​អ្នក ដើម្បី​ប្រើ​ជា​ផ្ទាំង​រូបភាព ។</p><p>អ្នក​នឹង​រត្រូវ​បាន​សួរ​រក​កន្លែង​រក្សាទុក​រូបភាព ។</p></qt>"

