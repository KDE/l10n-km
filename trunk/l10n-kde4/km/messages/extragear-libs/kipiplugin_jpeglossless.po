#: plugin_jpeglossless.cpp:285
msgid ""
"<p>Are you sure you wish to convert the selected image(s) to black and "
"white? This operation <b>cannot</b> be undone.</p>"
msgstr ""
"<p>តើ​អ្នក​ប្រាកដ​ជា​ចង់​បម្លែង​រូបភាព​ដែល​បាន​ជ្រើស​ទៅ​ជា​ពណ៌ ស ​ខ្មៅ ? ប្រតិបត្តិការ​នេះ <b>មិនអាច​</"
"b> មិនអាច​មិនធ្វើ​វិញ​បានទេ ។</p>"

