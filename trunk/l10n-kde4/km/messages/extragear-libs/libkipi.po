#: libkipi/batchprogressdialog.cpp:124
msgid "<p>This is the current processing status.</p>"
msgstr "<p>នេះ​គឺ​ជា​ស្ថានភាព​ដំណើរការ​បច្ចុប្បន្ន ។</p>"

#: libkipi/batchprogressdialog.cpp:131
msgid "<p>This is the batch job progress in percentage.</p>"
msgstr "<p>នេះ​គឺ​ជា​វឌ្ឍនភាព​ការងារ​បាច់​គិត​ជា​ភាគរយ ។</p>"

