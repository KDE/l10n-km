#, kde-format
msgctxt "@label"
msgid "Detailed Description (optional):"
msgstr "សេចក្តី​ពិពណ៌នា​លម្អិត​ (ស្រេច​ចិត្ត​) ៖"

#: resourceactions.cpp:74
