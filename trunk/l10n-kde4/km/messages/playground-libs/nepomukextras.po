#: newresourcedialog.cpp:121
#, kde-format
msgctxt "@label:button"
msgid "Use existing"
msgstr "ប្រើ​ធន​ធាន​ដែល​មាន​ស្រាប់"

#: newresourcedialog.cpp:122
#, kde-format
msgctxt "@label:button"
msgid "Create new"
msgstr "បង្កើត​ថ្មី"

#: newresourcedialog.cpp:123
#, kde-format
msgctxt "@info"
msgid ""
"Existing resources matching your input have been found. Do you want to use "
"an existing resource or actually create a new one?"
msgstr ""
"បាន​រក​ឃើញ​ធន​ធាន​មានស្រាប់​ដែល​ផ្គូផ្គង​​ជា​មួយ​នឹង​ការបញ្ចូល​របស់​អ្នក​ ។ តើ​អ្នក​ចង់​ប្រើ​ធន​ធាន​ដែល​មាន​ស្រាប់ ឬ​"
"ក៏​ចង់​បង្កើត​ធន​ធាន​ថ្មី​ ?"

#: newresourcedialog.cpp:148
#, kde-format
msgctxt "@title:window"
msgid "Create new Resource"
msgstr "បង្កើត​ធន​ធាន​ថ្មី"

#: newresourcedialog.cpp:187
#, kde-format
msgctxt "@info error message box"
msgid "Please specify a label for the new resource"
msgstr "សូម​បញ្ជាក់​ស្លាកថ្មី​សម្រាប់​ធន​ធាន​ថ្មី"

#: newresourcedialog.cpp:189
#, kde-format
msgctxt "@title:window Message box title"
msgid "No label specified"
msgstr "គ្មាន​ស្លាក​ត្រូវ​បាន​បញ្ជាក់​ទេ"

#: newresourcedialog.cpp:193
#, kde-format
msgctxt "@info error message box"
msgid "The label should contain at least four characters"
msgstr "ស្លាក​គួរ​តែ​មាន​អក្សរ​យ៉ាង​ហោច​ណាស់​បួន​តួ"

#: newresourcedialog.cpp:195
#, kde-format
msgctxt "@title:window Message box title"
msgid "Invalid label specified"
msgstr "បាន​បញ្ជាក់​ស្លាកដែល​​មិន​ត្រឹម​ត្រូវ"

#: newresourcedialog.cpp:213
#, kde-format
msgctxt "@title:window"
msgid "Create New %1"
msgstr "បង្កើត​ថ្មី​ %1"

#: newresourcedialog.cpp:214
#, kde-format
msgctxt "@title:window subtitle to previous message"
msgid "with optional icon and description"
msgstr "ជា​មួយ​សេចក្តី​ពិពណ៌នា​ និង​រូប​តំណាង​ស្រេច​ចិត្ត"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: newresourcedialog.ui:41
#, kde-format
msgctxt "@label Resource name"
msgid "Name:"
msgstr "ឈ្មោះ​ ៖"

#. i18n: ectx: property (text), widget (QLabel, label)
