msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម,​អេង វណ្ណៈ, អោក ពិសិដ្ឋ​"

msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,vannak@khmeros.info,piseth_dv@khmeros.info"

#: main.cpp:31
msgid "Viewer for Plasma wallpapers"
msgstr "កម្មវិធី​មើល​សម្រាប់​ផ្ទាំង​រូបភាព​ប្លាស្ម"

#: main.cpp:54
msgid "No description available"
msgstr "មិនមាន​សេចក្ដីពិពណ៌នាទេ"

#: main.cpp:76
msgid "No wallpaper plugins installed."
msgstr "គ្មាន​កម្មវិធី​ជំនួយ​ផ្ទាំង​រូបភាព​ត្រូវ​បាន​ដំឡើង ។"

#: main.cpp:80
msgid "Installed wallpaper plugins:"
msgstr "កម្មវិធី​ជំនួយ​ផ្ទាំង​រូបភាព​ដែល​បាន​ដំឡើង ៖"

#: main.cpp:89
#, kde-format
msgid "Modes: %1"
msgstr "របៀប ៖ %1"

#: main.cpp:96
msgid "Plasma Wallpaper Viewer"
msgstr "កម្មវិធីមើល​ផ្ទាំង​រូបភាព​ប្លាស្មា"

#: main.cpp:98
msgid "(c) 2009, Aaron J. Seigo"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៩ ដោយ Aaron J. Seigo"

#: main.cpp:99
msgid "Aaron J. Seigo"
msgstr "Aaron J. Seigo"

#: main.cpp:100
msgid "Author and maintainer"
msgstr "អ្នក​និពន្ធ និង​អ្នកថែទាំ"

#: main.cpp:107
msgid "The desired height in pixels"
msgstr "កម្ពស់​ដែល​ចង់​បាន​គិត​ជា​ភីកសែល"

#: main.cpp:109
msgid "The desired width in pixels"
msgstr "ទទឹង​ដែល​ចង់​បាន​គិត​ជា​ភីកសែល"

#: main.cpp:111
msgid "The wallpaper plugin to use"
msgstr "កម្មវិធី​ជំនួយ​ផ្ទាំង​រូបភាព​ត្រូវ​ប្រើ"

#: main.cpp:113
msgid "The mode to put the wallpaper in"
msgstr "របៀប​ត្រូវ​ដាក់​ផ្ទាំង​រូបភាព"

#: main.cpp:114
msgid "List all the known wallpapers and their modes"
msgstr "រាយ​ផ្ទាំង​រូបភាព​ដែល​បានស្គាល់​ និង​របៀប​របស់​ពួកវា​ទាំង​អស់"

#: main.cpp:115
msgid "Open configuration dialog additionally to show the wallpaper plugin"
msgstr ""

#: wallpaperwidget.cpp:242
#, kde-format
msgid "Configure %1 Wallpaper"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​ផ្ទាំង​រូបភាព %1"
