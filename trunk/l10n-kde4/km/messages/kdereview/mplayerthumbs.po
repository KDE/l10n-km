#: mplayerthumbscfg.cpp:43
msgid "General"
msgstr "ទូទៅ"

#: mplayerthumbscfg.cpp:70
msgid ""
"Cleaning the cache will delete all the previously generated thumbnail.\n"
"Since the cache is unique, also other file type thumbnails will be deleted.\n"
"Do you really want to clean up the cache?"
msgstr ""
"ការ​ជម្រះ​ឃ្លាំង​សម្ងាត់​នឹង​លុប​រូបភាព​តូចៗ​ដែល​បាន​បង្កើត​ពី​មុន​ទាំង​អស់ ។\n"
"ព្រោះ​ថា​ឃ្លាំង​សម្ងាត់​មាន​តែ​មួយ​គត់ រូបភាព​ប្រភេទ​ឯកសារ​ផ្សេងៗ​នឹង​ត្រូ​វបាន​លុប​ដែរ ។\n"
"តើ​អ្នក​ពិត​ជា​ចង់​ជម្រះ​ឃ្លាំង​សម្ងាត់​ឬ ?"

#. i18n: file: configDialog.ui:16
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:3
msgid "Enter here the path for mplayer executable file."
msgstr "បញ្ចូល​ផ្លូវ​នៅ​ទីនេះ​សម្រាប់​ឯកសារ​ដែល​អាច​ប្រតិបត្តិ​បាន​របស់ mplayer ។"

#. i18n: file: configDialog.ui:23
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_createStrips)
#: rc.cpp:6
msgid "Create strips around thumbnails"
msgstr "បង្កើតឆ្នូត​ជុំវិញ​រូបភាព​តូច"

#. i18n: file: configDialog.ui:35
#. i18n: ectx: property (text), widget (KPushButton, clean_cache)
#: rc.cpp:9
msgid "Clean Cache"
msgstr "ជម្រះ​ឃ្លាំង​សមង្ងាត់"

#. i18n: file: configDialog.ui:57
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:12
msgid "Custom arguments for mplayer"
msgstr "អាគុយម៉ង​ផ្ទាល់ខ្លួន​សម្រាប់ mplayer"

#. i18n: file: configDialog.ui:93
#. i18n: ectx: property (title), widget (KEditListBox, kcfg_noextensions)
#: rc.cpp:15
msgid "Blacklisted File Extensions"
msgstr "ផ្នែក​បន្ថែម​ឯកសារ​បញ្ជី​ខ្មៅ"

#. i18n: file: mplayerthumbs.kcfg:7
#. i18n: ectx: label, entry (mplayerbin), group (MPlayerThumbsCfg)
#: rc.cpp:18
msgid "Full path of the mplayer binary to use."
msgstr "ផ្លូវ​ពេញលេញ​របស់​បណ្ណាល័យ mplayer ត្រូវ​ប្រើ ។"

#. i18n: file: mplayerthumbs.kcfg:10
#. i18n: ectx: label, entry (noextensions), group (MPlayerThumbsCfg)
#: rc.cpp:21
msgid "File extensions that mplayerthumbs should avoid"
msgstr "ផ្នែក​បន្ថែម​ឯកសារ​ដែល mplayerthumbs គួរ​ជៀសវាង"

#. i18n: file: mplayerthumbs.kcfg:13
#. i18n: ectx: label, entry (customargs), group (MPlayerThumbsCfg)
#: rc.cpp:24
msgid "Append custom arguments to mplayer"
msgstr "បន្ថែម​អាគុយម៉ង់​ផ្ទាល់ខ្លួន​ខាងចុង​ទៅ​កាន់ mplayer"

#. i18n: file: mplayerthumbs.kcfg:16
#. i18n: ectx: label, entry (createStrips), group (MPlayerThumbsCfg)
#: rc.cpp:27
msgid "Create strips in thumbnail"
msgstr "បង្កើត​ឆ្នូត​នៅ​ក្នុង​រូបភាព​តូចៗ"

