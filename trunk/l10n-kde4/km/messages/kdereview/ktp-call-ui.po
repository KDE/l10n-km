#: src/approver.cpp:38
msgid "Incoming video call"
msgstr "ការ​ហៅ​ជា​វីដេអូ​ចូល"

#: src/approver.cpp:39
#, kde-format
msgid "<p>%1 is asking you for a video call</p>"
msgstr "<p>%1 កំពុង​សួរ​រកការហៅ​ជា​វីដេអូ</p>"

#: src/approver.cpp:41
msgid "Incoming call"
msgstr "ការ​ហៅ​ចូល"

#: src/approver.cpp:42
#, kde-format
msgid "<p>%1 is calling you</p>"
msgstr "<p>%1 កំពុង​ហៅ​អ្នក</p>"

#: src/approver.cpp:58 src/approver.cpp:80
msgctxt "action, answers the incoming call"
msgid "Answer"
msgstr "ឆ្លើយតប"

#: src/approver.cpp:59 src/approver.cpp:82
msgctxt "action, rejects the incoming call"
msgid "Reject"
msgstr "បដិសេធ"

#: src/call-window.cpp:95
#, kde-format
msgid "Call with %1"
msgstr "ហៅ​ដោយ​ប្រើ %1"

#: src/call-window.cpp:109
msgctxt "@info:status"
msgid "Connecting..."
msgstr "កំពុង​តភ្ជាប់..."

#: src/call-window.cpp:113
msgctxt "@info:status the remote user's phone is ringing"
msgid "Ringing..."
msgstr "កំពុង​រោទិ៍..."

#: src/call-window.cpp:117
msgctxt "@info:status"
msgid "Remote user accepted the call, waiting for connection..."
msgstr "អ្នក​ប្រើ​ពី​ចម្ងាយ​បាន​ទទួល​ការ​ហៅ រង់ចាំ​ការ​តភ្ជាប់..."

#: src/call-window.cpp:120
msgctxt "@info:status"
msgid "Talking..."
msgstr "កំពុង​និយាយ..."

#: src/call-window.cpp:136
msgctxt "@info:status"
msgid "Remote contact ended the call."
msgstr "ទំនាក់​ទំនង​ពី​ចម្ងាយ​បាន​បញ្ចប់​ការ​ហៅ ។"

#: src/call-window.cpp:143
msgctxt "@info:status"
msgid "Remote contact rejected the call."
msgstr "ទំនាក់ទំនង​ពី​ចម្ងាយ​បាន​បដិសេធ​​កា​រហៅ ។"

#: src/call-window.cpp:148
msgctxt "@info:status"
msgid "Remote contact didn't answer."
msgstr "ទំនាក់ទំនង​ពី​ចម្ងាយ​មិន​បាន​ឆ្លើយតប​ទេ ។"

#: src/call-window.cpp:152
msgctxt "@info:status"
msgid "Invalid number or contact."
msgstr "លេខ ឬ​ទំនាក់ទំនង​មិន​ត្រឹមត្រូវ ។"

#: src/call-window.cpp:156
msgctxt "@info:status"
msgid "You don't have enough balance to make this call."
msgstr "អ្នក​មិនមាន​គណនី​គ្រប់គ្រាន់ ដើម្បីធ្វើការ​ហៅ​ចេញ ។"

#: src/call-window.cpp:158
msgctxt "@info:status"
msgid "You don't have permission to make this call."
msgstr "អ្នក​មិនមាន​សិទ្ធិ​ ដើម្បី​ធ្វើការ​ហៅ​ចេញ​ទេ ។"

#: src/call-window.cpp:163
msgctxt "@info:status"
msgid "Remote contact is currently busy."
msgstr "ទំនាក់ទំនង​ពី​ចម្ងាយ​បច្ចុប្បន្ន​កំពុង​រវល់ ។"

#: src/call-window.cpp:167
msgctxt "@info:status"
msgid "Internal component error."
msgstr "កំហុស​សមាសធាតុ​ខាង​ក្នុង ។"

#: src/call-window.cpp:170
msgctxt "@info:status"
msgid "Remote service error."
msgstr "កំហុស​សេវាកម្ម​ពី​ចម្ងាយ ។"

#: src/call-window.cpp:173
msgctxt "@info:status"
msgid "Network error."
msgstr "កំហុស​បណ្ដាញ ។"

#: src/call-window.cpp:177
msgctxt "@info:status"
msgid "Failed to negotiate codecs."
msgstr "បាន​បរាជ័យ​ក្នុងការ​ចរចារ​កូឌិក ។"

#: src/call-window.cpp:179
msgctxt "@info:status"
msgid "Unsupported media type."
msgstr "ប្រភេទ​មេឌៀ​ដែល​មិន​បានគាំទ្រ ។"

#: src/call-window.cpp:183
msgctxt "@info:status"
msgid "Connectivity error."
msgstr "កំហុស​ក្នុងការ​តភ្ជាប់ ។"

#: src/call-window.cpp:187
msgctxt "@info:status"
msgid "Unknown error."
msgstr "កំហុស​ដែល​​មិន​ស្គាល់ ។"

#: src/call-window.cpp:192
msgctxt "@info:status"
msgid "Disconnected."
msgstr "បាន​ផ្ដាច់ ។"

#: src/call-window.cpp:196
#, kde-format
msgctxt "@info:status the call was disconnected because..."
msgid "Disconnected: %1"
msgstr "បាន​ផ្ដាច់ ៖ %1"

#: src/call-window.cpp:339
msgctxt "@action"
msgid "Show my video"
msgstr "បង្ហាញ​វីដេអូ​របស់​ខ្ញុំ"

#: src/call-window.cpp:344
msgctxt "@action"
msgid "Show dialpad"
msgstr "បង្ហាញ​បន្ទះ​លេខ"

#: src/call-window.cpp:351
msgctxt "@action"
msgid "Send video"
msgstr "ផ្ញើ​វីដេអូ"

#: src/call-window.cpp:356 src/call-window.cpp:357
msgctxt "@action"
msgid "Mute"
msgstr "ស្ងាត់"

#: src/call-window.cpp:363
msgctxt "@action"
msgid "Hold"
msgstr "រង់ចាំ"

#: src/call-window.cpp:368
msgctxt "@action"
msgid "Hangup"
msgstr "រង់ចាំ"

#: src/main.cpp:36
msgid "KDE Telepathy Call Ui"
msgstr "ចំណុច​ប្រទាក់​ការ​ហៅ KDE Telepathyi"

#: src/main.cpp:37
msgid "VoIP client for KDE"
msgstr "ម៉ាស៊ីន​ VoIP សម្រាប់ KDE"

#: src/main.cpp:38
msgid "(C) 2009, George Kiagiadakis"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០៩ ដោយ George Kiagiadakis"

#: src/main.cpp:40
msgctxt "@info:credit"
msgid "George Kiagiadakis"
msgstr "George Kiagiadakis"

