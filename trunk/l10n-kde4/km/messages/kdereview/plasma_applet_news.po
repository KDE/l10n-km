msgstr "ធ្វើ​ឲ្យ​ចន្លោះពេល​ទាន់សម័យ ៖"

#. i18n: file: config.ui:164
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:18
msgid "minutes"
msgstr "នាទី​"

#. i18n: file: config.ui:180
#. i18n: ectx: attribute (title), widget (QWidget, tab_2)
#: rc.cpp:21
msgid "Look"
msgstr "មើល"

#. i18n: file: config.ui:189
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:24
msgid ""
"Note that timestamps, titles and descriptions are available only if they are "
"provided by feed."
msgstr ""
"ចំណាំ​ថា ត្រា​ពេល​វេលា ចំណង​ជើង និង​ការ​ពិពណ៌នា​មាន ក្នុង​ករណី​ដែល​​ពួក​វា​ត្រូវ​បាន​ផ្ដល់​ដោយ មតិ​ព័ត៌មាន ។"

#. i18n: file: config.ui:202
#. i18n: ectx: property (text), widget (QCheckBox, timestampCheckBox)
#: rc.cpp:27
msgid "Show timestamps"
msgstr "បង្ហាញ​ត្រា​ពេល​វេលា"

#. i18n: file: config.ui:209
#. i18n: ectx: property (text), widget (QCheckBox, titlesCheckBox)
#: rc.cpp:30
msgid "Show titles"
msgstr "បង្ហាញ​ចំណង"

#. i18n: file: config.ui:216
#. i18n: ectx: property (text), widget (QCheckBox, descriptionsCheckBox)
#: rc.cpp:33
msgid "Show descriptions"
msgstr "បង្ហាញ​ការ​ពិពណ៌នា"

