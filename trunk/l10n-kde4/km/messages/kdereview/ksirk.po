#: kgamewin.cpp:311
msgid "Finish moves"
msgstr "បញ្ចប់​ផ្លាស់ទី"

#: kgamewin.cpp:313
msgid "Finish now current sprites movements"
msgstr "បញ្ចប់​ការ​ផ្លាស់ទី sprites បច្ចុប្បន្ន​ឥឡូវ​នេះ"

#: kgamewin.cpp:458
msgid ""
"UNO definition XML file not found - Verify your installation<br/>Program "
"cannot continue"
msgstr "រក​មិន​ឃើញ​ឯកសារ XML ការ​កំណត់ UNO - អះអាង​ការ​ដំឡើង​របស់​អ្នក<br/>កម្មវិធី​មិន​អាច​បន្ត"

#: kgamewin.cpp:684
#, kde-format
msgid "%1, you are defeated! Bye, bye..."
msgstr "%1 អ្នក​ត្រូវ​បាន​បង្ក្រាប! លា​ហើយ..."

#: kgamewin.cpp:685
msgid "KsirK - Game Over !"
msgstr "KsirK - ល្បែង​ចប់ !"

#: kgamewin.cpp:725
#, kde-format
msgid "%1 : it is up to you again"
msgstr "%1 ៖ វា​ស្រេច​ទៅ​លើ​អ្នក"

#: kgamewin.cpp:929
msgid "Do you want to quit the game ?"
msgstr "តើ​អ្នក​ចង់​ចេញ​ពី​ល្បែង​ឬ ?"

#: kgamewin.cpp:938
msgid "Before you quit, do want to save your game?"
msgstr "មុន​ពេល​អ្នក​ចេញ តើ​អ្នក​ចង់​រក្សា​ទុក​ល្បែង​របស់​អ្នក​ឬ?"

#: kgamewin.cpp:954
msgid "KsirK - Load Game"
msgstr "KsirK - ផ្ទុក​ល្បែង"

#: kgamewin.cpp:990
#, kde-format
msgid "Waiting for the connection of %1 network players."
msgstr "រង់ចាំ​ការ​ភ្ជាប់​នៃ​អ្នក​លេង​លើ​បណ្ដាញ %1 ។"

#: kgamewin.cpp:1052
msgid "Redistribute"
msgstr "ចែកចាយ​ឡើង​វិញ"

