msgstr "វាយ​ប្រហារ​ជាមួយ​ទ័ព​ពីរ"

#: kgamewin.cpp:1096
msgid "Attack with three armies"
msgstr "វាយ​ប្រហារ​ជាមួយ​ទ័ព​បី"

#: kgamewin.cpp:1097
msgid "Move armies"
msgstr "ផ្លាស់ទី​ទ័ព"

#: kgamewin.cpp:1123
msgid "Defend with one army"
msgstr "ការពារ​ជាមួយ​ទ័ព​មួយ"

#: kgamewin.cpp:1124
msgid "Defend with two armies"
msgstr "ការពារ​ជាមួយ​ទ័ព​ពីរ"

#: kgamewin.cpp:1201
msgid "Invade with one army"
msgstr "ឈ្លានពាន​ជាមួយ​ទ័ព​មួយ"

#: kgamewin.cpp:1202
msgid "Invade with five armies"
msgstr "ឈ្លានពាន​ជាមួយ​ទ័ព​ប្រាំ"

#: kgamewin.cpp:1203
msgid "Invade with ten armies"
msgstr "ឈ្លានពាន​ជាមួយ​ទ័ព​ដប់"

#: kgamewin.cpp:1204
msgid "End Invasion"
msgstr "បញ្ចប់​ការ​ឈ្លានពាន"

#: kgamewin.cpp:1205
msgid "Retract one army"
msgstr "ដក​ទ័ព​មួយ"

#: kgamewin.cpp:1206
msgid "Retract five armies"
msgstr "ដក​ទ័ព​ប្រាំ"

#: kgamewin.cpp:1207
msgid "Retract ten armies"
msgstr "ដក​ទ័ព​ដប់"

#: kgamewin.cpp:1220
msgid "Cancel"
msgstr "បោះបង់"

#: kgamewin.cpp:1381
#, kde-format
msgid "Waiting for %1 players to connect"
msgstr "រង់ចាំ​អ្នក​លេង %1 ដើម្បី​តភ្ជាប់"

#: kgamewin.cpp:1849 kgamewin.cpp:1888
msgid "There is no country here!"
msgstr "គ្មាន​ប្រទេស​នៅ​ទីនេះ!"

#: kgamewin.cpp:1872
#, kde-format
msgid "Moving armies from %1 to %2."
msgstr "ផ្លាស់ទី​ទ័ព​ពី %1 ទៅ %2 ។"

#: kgamewin.cpp:1892
#, kde-format
msgid "You are not the owner of the first country: %1 !"
msgstr "អ្នក​មិន​មែន​ជា​ម្ចាស់​នៃ​ប្រទេស​ដំបូង ៖ %1 !"

#: kgamewin.cpp:1906
#, kde-format
msgid "%1 is not a neighbour of %2 !"
msgstr "%1 មិន​មែន​ជា​ប្រទេស​ជិត​ខាង​នៃ %2 !"

#: kgamewin.cpp:1912
msgid "Ready to fight !"
msgstr "រួចរាល់​ក្នុង​ការ​វាយ !"

#: kgamewin.cpp:1995
msgid "<font color=\"orange\">No country here !</font>"
msgstr "<font color=\"orange\">គ្មាន​ប្រទេស​នៅ​ទីនេះ !</font>"

#: kgamewin.cpp:2003
#, kde-format
msgid "<font color=\"orange\">You are not the owner of %1 !</font>"
msgstr "<font color=\"orange\">អ្នក​មិនមែន​ជា​ម្ចាស់​នៃ %1 !</font>"

#: kgamewin.cpp:2010
#, kde-format
msgid "<font color=\"orange\">There is only %1 armies in %2 !</font>"
msgstr "<font color=\"orange\">មាន​តែ %1 ទ័ព​ក្នុង %2 !</font>"

#: kgamewin.cpp:2135
#, kde-format
msgid "%1, you defend with the only army you have in %2."
msgstr "%1 អ្នក​ការពារ​ជាមួយ​តែ​ទ័ព ដែល​អ្នក​មាន​ក្នុង %2 ។"

#: kgamewin.cpp:2355
msgid "Exchange armies again or continue ?"
msgstr "ផ្លាស់ប្ដូរ​ទ័ព​ម្ដង​ទៀត ឬ​បន្ត ?"

#: kgamewin.cpp:2377
msgid ""
"You must distribute\n"
"all your armies"
msgstr ""
"អ្នក​ត្រូវ​តែ​ចែកចាយ\n"
"ទ័ព​របស់​អ្នក​ទាំងអស់"

#: kgamewin.cpp:2702
msgid "Do you really want to end your current game and start a new one ?"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​បញ្ចប់​ល្បែង​បច្ចុប្បន្ន​របស់​អ្នក​ឬ ?"

#: kgamewin.cpp:2954
msgid "All commands are issued through changing buttons and drag & drop."
msgstr "ពាក្យ​បញ្ជា​ទាំងអស់​ត្រូវ​បាន​ចេញ​ផ្សាយ​តាម​រយៈ​ការ​ផ្លាស់ប្ដូរ​ប៊ូតុង និង អូស & ទម្លាក់ ។"

#: kgamewin.cpp:2958
msgid "Start a new game or join a network game with the menu or the toolbar..."
msgstr "ចាប់ផ្ដើម​ល្បែង​ថ្មី ឬ​ចូលរួម​ល្បែង​លើ​បណ្ដាញ​ជាមួយ​ម៉ឺនុយ ឬ​របារ​ឧបករណ៍..."

#: kgamewin.cpp:2995
msgid ""
"and then let the system guide you through messages and tooltips appearing on "
"buttons when hovering above them. You can disable bubble help in the options "
"window."
msgstr ""
"ហើយ​បន្ទាប់​មក​អនុញ្ញាត​ឲ្យ​ប្រព័ន្ធ​នាំ​ផ្លូវ​អ្នក​តាម​រយៈ​សារ និង​ព័ត៌មាន​ជំនួយ ដែល​លេច​ឡើង​លើ​ប៊ូតុង ពេល​សំកាំង​លើ​"
"ពួក​វា ។ អ្នក​អាច​បិទ​ជំនួយ​ពពុះ​ក្នុង​បង្អួច​ជម្រើស ។"

#: kgamewin.cpp:3002
msgid "Don't show messages anymore"
msgstr "កុំ​បង្ហាញ​សារ​ទៀត"

