#: binaryclock.cpp:137
msgctxt "@title:window"
msgid "Configure Clock"
msgstr "កំណត់​រចនាសម្ព័ន្ធ​នាឡិកា"

#. i18n: tag string
#. i18n: file clockConfig.ui line 22
#: rc.cpp:3
msgid "Appearance"
msgstr "រូបរាង"

#. i18n: tag string
#. i18n: file clockConfig.ui line 31
#: rc.cpp:6
msgid "Show the second leds"
msgstr "បង្ហាញ​ទ្រនិច​វិនាទី"

#. i18n: tag string
#. i18n: file clockConfig.ui line 34
#: rc.cpp:9
msgid "Check this if you want to display second leds in order to see the seconds."
msgstr "ពិនិត្យ​មើល​វា​ប្រសិន​បើ​អ្នក​ចង់​បង្ហាញ​ទ្រនិច​វិនាទី​ដើម្បី​មើល​វិនាទី ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 37
#: rc.cpp:12
msgid "Show &seconds"
msgstr "បង្ហាញ​វិនាទី"

#. i18n: tag string
#. i18n: file clockConfig.ui line 44
#: rc.cpp:15
msgid "Show the grid"
msgstr "បង្ហាញ​ក្រឡាចត្រង្គ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 47
#: rc.cpp:18
msgid "Check this if you want to see a grid around leds."
msgstr "ពិនិត្យ​មើលប្រសិន​បើ​​អ្នក​ចង់​មើលក្រឡាចត្រង្គ​ជុំវិញ​ទ្រនិច ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 50
#: rc.cpp:21
msgid "Show grid"
msgstr "បង្ហាញ​ក្រឡាចត្រង្គ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 57
#: rc.cpp:24
msgid "Show the off leds"
msgstr "បង្ហាញ​កា​របិទ​ទ្រនិច"

#. i18n: tag string
#. i18n: file clockConfig.ui line 60
#: rc.cpp:27
msgid "Check this if you want to see off leds."
msgstr "ពិនិត្យ​មើល​ប្រសិន​បើ​អ្នក​ចង់​មើល​កា​របិទ​ទ្រនិច ។"

#. i18n: tag string
#. i18n: file clockConfig.ui line 63
#: rc.cpp:30
msgid "Show off leds"
msgstr "បង្ហាញ​កា​របិទ​ទ្រនិច"

#. i18n: tag string
#. i18n: file clockConfig.ui line 73
#: rc.cpp:33
msgid "Timezones"
msgstr "តំបន់​ពេលវេលា"

#. i18n: tag string
#. i18n: file clockConfig.ui line 82
#: rc.cpp:36
msgid "Use &local timezone"
msgstr "ប្រើ​តំបន់​ពេលវេលា​មូលដ្ឋាន"

#. i18n: tag string
#. i18n: file clockConfig.ui line 96
#: rc.cpp:39
msgid "Area"
msgstr "ផ្ទៃ"

#. i18n: tag string
#. i18n: file clockConfig.ui line 101
#: rc.cpp:42
msgid "Region"
msgstr "តំបន់"

#. i18n: tag string
#. i18n: file clockConfig.ui line 106
