#: src/MainWindow.cpp:220
#, kde-format
msgid "Human Player: %1"
msgstr "អ្នក​លេង​ជា​មនុស្ស ៖ %1"

#: src/MainWindow.cpp:223
#, kde-format
msgid "Computer: %1"
msgstr "កុំព្យូទ័រ ៖ %1"

#: src/MainWindow.cpp:231
msgid "Turn: computer"
msgstr "វេន ៖ កុំព្យូទ័រ"

#: src/MainWindow.cpp:245
msgid "Game Over"
msgstr "ល្បែង​ចប់​ហើយ"

