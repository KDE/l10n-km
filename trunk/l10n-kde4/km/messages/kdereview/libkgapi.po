#: libkgapi/accessmanager_p.cpp:87
msgid "No valid reply received"
msgstr "មិន​បាន​ទទួល​ចម្លើយ​តប​ត្រឹមត្រូវ​ទេ"

#: libkgapi/accessmanager_p.cpp:117
msgid "Bad request."
msgstr "សំណើ​មិន​ល្អ"

#: libkgapi/accessmanager_p.cpp:175 libkgapi/accessmanager_p.cpp:176
#, kde-format
msgid ""
"Requested resource is forbidden.\n"
"\n"
"Google replied '%1'"
msgstr "បាន​ទប់ស្កាត់​ធនធាន​ដែល​បាន​ស្នើ ។\n\nGoogle បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:184 libkgapi/accessmanager_p.cpp:185
#, kde-format
msgid ""
"Requested resource does not exist.\n"
"\n"
"Google replied '%1'"
msgstr "មិន​មាន​ធនធាន​ដែល​បាន​ស្នើ​ទេ ។\n\nGoogle បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:193 libkgapi/accessmanager_p.cpp:194
#, kde-format
msgid ""
"Conflict. Remote resource is newer then local.\n"
"\n"
"Google replied '%1'"
msgstr ""
"ប៉ះទង្គិច ធនធាន​ពី​ចម្ងាយ​គឺ​ថ្មី​ជាង​ធនធាន​មូលដ្ឋាន ។\n\nGoogle បាន​ឆ្លើយ '"
"%1'"

#: libkgapi/accessmanager_p.cpp:202 libkgapi/accessmanager_p.cpp:203
#, kde-format
msgid ""
"Requested resource does not exist anymore.\n"
"\n"
"Google replied '%1'"
msgstr "ធនធាន​ដែល​បាន​ស្នើ​មិន​មាន​ទៀត​ទេ ។\n\nGoogle បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:211 libkgapi/accessmanager_p.cpp:212
#, kde-format
msgid ""
"Internal server error. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"កំហុស​ម៉ាស៊ីន​បម្រើ​ខាងក្នុង សាកល្បង​ម្ដងទៀត​នៅ​ពេល​ក្រោយ ។\n\nGoogle "
"បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:220 libkgapi/accessmanager_p.cpp:221
#, kde-format
msgid ""
"User quota exceeded. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"បាន​លើស​ពី​កូតា​អ្នកប្រើ សូម​ព្យាយាម​ម្ដងទៀត​នៅ​ពេល​ក្រោយ ។\n\nGoogle "
"បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:229
#, kde-format
msgid ""
"Unknown error.\n"
"\n"
"Google replied '%1'"
msgstr "មិន​ស្គាល់​កំហុស ។\n\nGoogle បាន​ឆ្លើយ '%1'"

#: libkgapi/accessmanager_p.cpp:259 libkgapi/accessmanager_p.cpp:260
msgid "Unknown reply content type!"
msgstr "មិន​ស្គាល់​ប្រភេទ​មាតិកា​ឆ្លើយតប !"

#: libkgapi/accessmanager_p.cpp:336
#, kde-format
msgid "Invalid request, service %1 is not registered."
msgstr "សំណើ​មិន​ត្រឹមត្រូវ សេវាកម្ម %1 មិន​ត្រូវ​បាន​ចុះឈ្មោះ​ទេ ។"

#: libkgapi/common.h:95
msgid "An unknown error has occurred."
msgstr "មាន​កំហុស​មិន​ស្គាល់​បាន​កើតឡើង ។"

#: libkgapi/common.h:121
#, kde-format
msgid "Unknown account '%1'"
msgstr "មិន​ស្គាល់​គណនី '%1'"

#: libkgapi/common.h:134
#, kde-format
msgid "Unknown service '%1'"
msgstr "មិន​ស្គាល់​សេវាកម្ម '%1'"

#: libkgapi/common.h:160
msgid "KWallet is not opened."
msgstr "KWallet មិន​បាន​បើក​ទេ ។"

#: libkgapi/common.h:173
msgid "The account is invalid."
msgstr "គណនី​មិន​ត្រឹមត្រូវ ។"

#: libkgapi/ui/authwidget_p.cpp:66
msgid "Authorizing token. This should take just a moment..."
msgstr "កំពុង​អនុញ្ញាត​ថូខិន ។ វា​ប្រើ​ពេល​បន្តិចបន្តួច​ប៉ុណ្ណោះ..."

#: libkgapi/ui/authwidget_p.cpp:158
msgid "Parsing token page failed."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ញែក​ទំព័រ​ថូខឹន ។"

#: libkgapi/ui/authwidget_p.cpp:163
#| msgid "Failed to refresh the list of calendars"
msgid "Failed to obtain token."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ទទួល​ថូខឹន"

#: libkgapi/ui/authwidget_p.cpp:196
#, kde-format
#| msgid "Authentication"
msgid ""
"Authentization failed:\n"
"%1"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ ៖\n%1"

#: libkgapi/ui/authwidget_p.cpp:205
#| msgid "Failed to refresh the list of calendars"
msgid "Failed to parse server response."
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ញែក​ចម្លើយ​តប​ម៉ាស៊ីន​បម្រើ ។"

#: libkgapi/auth_p.cpp:168
#| msgid "Authentication"
msgid "Authentication cancelled"
msgstr "បាន​បោះបង់​ការ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ"

#: libkgapi/auth_p.cpp:222
#| msgid "Failed to refresh the list of calendars"
msgid "Failed to parse newly fetched tokens"
msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ញែក​ថូខឹន​ដែល​បាន​ទៅ​ប្រមូល​យក​ថ្មីៗ"
