#: savesystem/timeline.cpp:312
msgid "<b>No changes have been made in order to create a savepoint!</b>"
msgstr "<b>គ្មាន​ការ​ផ្លាស់ប្ដូរ​ ដើម្បី​បង្កើត savepoint ឡើយ !</b>"

#: savesystem/timeline.cpp:345
msgid ""
"<b>You are restoring the selected save point.</b> \n"
"With this operation, all the save points and branches created starting from "
"it, will be deleted.\n"
"Continue anyway?"
msgstr ""
"<b>អ្នក​កំពុង​ស្ដារ​ចំណុច​រក្សាទុក​ដែល​បាន​ជ្រើស ។</b> \n"
"ជា​មួយ​ប្រតិបត្តិការ​នេះ ចំណុច​រក្សាទុក​ទាំងអស់ និង​ភាគ​ដើម​ដែល​បាន​បង្កើត​ពី​វា នឹង​ត្រូវ​បាន​លុប ។\n"
"​បន្ត​ឬ ?"

#: savesystem/timeline.cpp:361
msgid ""
"<b>You are going to move to the selected save point.</b>\n"
"To perform this, a new branch will be created and your current work may be "
"lost if you do not have saved it as a Savepoint.\n"
"Continue?"
msgstr ""
"<b>អ្នក​នឹង​ផ្លាស់ទី​ចំណុច​រក្សាទុក​ដែល​បាន​​ជ្រើស ។</b>\n"
"ដើម្បី​ប្រតិបត្តិ ភាគ​ថ្មី​នឹង​ត្រូវ​បាន​បង្កើត ហើយ​ការងារ​បច្ចុប្បន្ន​របស់​​អ្នក​អាច​ត្រូវ​បាន​បាត់បង់ ប្រសិនបើ​អ្នក​"
"មិន​បាន​រក្សាទុក​ទេ​នោះ វា​ជា​ Savepoint ។\n"
"បន្ត​ឬ ?"

#: savesystem/timeline.cpp:376
msgid ""
"<b>Cannot rename the section</b>: a section with this name already exists."
msgstr "<b>មិន​អាច​ប្ដូរ​ឈ្មោះ​ភាគ​បាន​ទេ</b> ៖ ភាគ​មាន​ឈ្មោះ​នេះ​​រួច​ហើយ ។"

#: savesystem/timeline.cpp:405
msgid ""
"<b>You are going to combine two branch.</b>\n"
" With this operation, a new save point will be created; then you should have "
"to manually resolve some conflicts on source code. Continue?"
msgstr ""
"<b>អ្នក​នឹង​ផ្សំ​ភាគ​ពីរ ។</b>\n"
" ជា​មួយ​ប្រតិបត្តិការ​នេះ ចំណុច​រក្សាទុក​ថ្មី​នឹង​ត្រូវ​បាន​បង្កើត បន្ទាប់​មក​អ្នក​គួរ​ដោះស្រាយ​ដោយ​ដៃ​ការ​ប៉ះ​ទង្គិច​"
"លើ​កូដ​ប្រភព ។ បន្ត ?"

#: savesystem/timeline.cpp:443
msgid ""
"<b>You are going to remove the selected branch.</b>\n"
" With this operation, you will also delete all save points and branches "
"performed inside it.\n"
"Continue anyway?"
msgstr ""
"<b>អ្នក​នឹង​យក​ភាគ​ដែល​បាន​ជ្រើស​ចេញ ។</b>\n"
" ជា​មួយ​​ប្រតិបត្តិការ​នេះ អ្នក​នឹង​លុប​ចំណុច​រក្សាទុក​ទាំងអស់ ហើយ​ភាគ​ដែល​បាន​ប្រតិបត្តិ​នៅ​ខាង​ក្នុង​វា ។\n"
"យ៉ាងណាក៏ដោយ​បន្ត​ឬ ?"

#: savesystem/timeline.cpp:471
msgid "Cannot rename the section: a section with this name already exists."
msgstr "មិន​អាច​ប្ដូរ​ឈ្មោះ​ភាគ ៖ ភាគ​ជា​មួយ​ឈ្មោះ​នេះ​មាន​ហើយ ។"

