#: main.cpp:21
msgid "KDE Space Game"
msgstr "ល្បែង​លំហ KDE"

#: main.cpp:25
msgid "KAsteroids"
msgstr "KAsteroids"

#. i18n: tag label
#. i18n: file kasteroids.kcfg line 9
#. i18n: tag label
#. i18n: file kasteroids.kcfg line 13
#: rc.cpp:3 rc.cpp:6
msgid "Whether power upgrades can be shot."
msgstr "ថា​តើ​ការ​ដំឡើង ថាមពល អាច​បាញ់​បាន ។"

#. i18n: tag label
#. i18n: file kasteroids.kcfg line 17
#: rc.cpp:9
msgid "The number of ships per game."
msgstr "ចំនួន​នាវា​ក្នុង​ល្បែង ។"

#. i18n: tag label
#. i18n: file kasteroids.kcfg line 23
#: rc.cpp:12
msgid "Whether to play sounds."
msgstr "ថា​តើ​ត្រូវ​ចាក់​សម្លេង ។"

#. i18n: tag label
#. i18n: file kasteroids.kcfg line 27
#: rc.cpp:15
msgid "Sound to play when a ship gets destroyed."
msgstr "សម្លេង​ដើម្បី​ចាក់ នៅ​ពេល​នាវា​ត្រូវ​បាន​កំទេច ។"

#. i18n: tag label
#. i18n: file kasteroids.kcfg line 31
#: rc.cpp:18
msgid "Sound to play when a rock gets destroyed."
msgstr "សម្លេង​ដើម្បី​ចាក់ នៅ​ពេល​ថ្ម​ត្រូវ​បាន​កំទេច ។"

#: rc.cpp:19
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, ប៉ុច សុគន្ធ, អេង វណ្ណៈ, អោក ពិសិដ្ឋ"

#: rc.cpp:20
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ""
"khoemsokhem@khmeros.info,sokun_poch@khmeros.info,evannak@khmeros.info,"
"piseth_dv@khmeros.info"

#: toplevel.cpp:108
msgid "Score"
msgstr "ពិន្ទុ"

#: toplevel.cpp:122
msgid "Level"
msgstr "កម្រិត"

#: toplevel.cpp:136
msgid "Ships"
msgstr "នាវា"

#: toplevel.cpp:238
msgid "Fuel"
msgstr "សាំង"

#: toplevel.cpp:300
msgid "Thrust"
msgstr "កម្លាំង​បុក"

#: toplevel.cpp:304
msgid "Rotate Left"
msgstr "បង្វិល​ទៅ​ឆ្វេង"

#: toplevel.cpp:308
msgid "Rotate Right"
msgstr "បង្វិល​ទៅ​ស្ដាំ"

#: toplevel.cpp:312
msgid "Shoot"
msgstr "បាញ់"

#: toplevel.cpp:316
msgid "Brake"
msgstr "ហ្វ្រាំង"

#: toplevel.cpp:320
msgid "Shield"
msgstr "ខែល"

#: toplevel.cpp:339
msgid "Launch"
msgstr "បើក​ដំណើរការ"

#: toplevel.cpp:511 toplevel.cpp:604
#, qt-format
msgid "Press %1 to launch."
msgstr "ចុច %1 ដើម្បី​បើក​ដំណើរការ ។"

#: toplevel.cpp:536
#, qt-format
msgid "Ship Destroyed. Press %1 to launch."
msgstr "នាវាត្រូវ​បាន​កំទេច ។ ចុច %1 ដើម្បី​បើក​ដំណើរការ ។"

#: toplevel.cpp:542
msgid "Game Over!"
msgstr "ល្បែង​ចប់ !"

#: toplevel.cpp:625
msgid "Start new game with"
msgstr "ចាប់ផ្ដើម​ល្បែង​ថ្មី​ជាមួយ"

#: toplevel.cpp:630
msgid " ships."
msgstr " នាវា ។"

#: toplevel.cpp:637
msgid "Show highscores on Game Over"
msgstr "បង្ហាញ​ពិន្ទុ​ខ្ពស់​ពេល​ល្បែង​ចប់"

#: toplevel.cpp:639
msgid "Player can destroy Powerups"
msgstr "អ្នក​លេង​អាច​កំទេច​ដុំ​ថាមពល"

#: toplevel.cpp:648
msgid "General"
msgstr "ទូទៅ"

#: toplevel.cpp:668
#, qt-format
msgid ""
"Game Over\n"
"\n"
"Shots fired:\t%1\n"
"  Hit:\t%2\n"
"  Missed:\t%3\n"
"Hit ratio:\t%4 %\t\t"
msgstr ""
"ចប់​ល្បែង\n"
"\n"
"គ្រាប់​បាន​បាញ់ ៖\t%1\n"
"  បាញ់​ត្រូវ ៖\t%2\n"
"  បាញ់​ខុស ៖\t%3\n"
"អនុបាត​បាញ់​ត្រូវ ៖\t%4 %\t\t"

#: toplevel.cpp:692
msgid "KAsteroids is paused."
msgstr "KAsteroids បាន​ផ្អាក ។"

#: toplevel.cpp:693
msgid "Paused"
msgstr "បាន​ផ្អាក"
