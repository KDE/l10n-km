#: app.cpp:96 app.cpp:318
msgid " Cheat mode "
msgstr " របៀប​បញ្ឆោត "

#: app.cpp:138
msgid "&Finish"
msgstr "បញ្ចប់"

#: app.cpp:175
msgid "This game is solvable."
msgstr "ល្បែង​នេះ​អាចដោះស្រាយ​បាន ។"

#: app.cpp:177
msgid "This game is NOT solvable."
msgstr "ល្បែង​នេះ​មិន​អាច​ដោះស្រាយ​បាន​ទេ ។"

#: app.cpp:252
msgid "No more moves possible!"
msgstr "មិន​អាច​ផ្លាស់ទី​បាន​ទៀត​ទេ​ !"

#: app.cpp:252 app.cpp:284
msgid "End of Game"
msgstr "ល្បែង​ចប់"

#: app.cpp:279
#, qt-format
msgid "Congratulations! You made it in %1:%2:%3"
msgstr "អបអរសាទរ ! អ្នក​បាន​ធ្វើ​វា​ក្នុងរយៈ​ពេល %1 ៖ %2:%3"

#: app.cpp:299
msgid "(Paused) "
msgstr "(បាន​ផ្អាក) "

#: app.cpp:295
#, qt-format
msgid " Your time: %1:%2:%3 %4"
msgstr " រយៈពេល​របស់​អ្នក ៖ %1:%2:%3 %4"

#: app.cpp:305
#, qt-format
msgid " Removed: %1/%2 "
msgstr " បាន​យកចេញ ៖ %1/%2 "

#: app.cpp:337
#, fuzzy
msgid ""
"You have made it into the \"Hall Of Fame\". Type in\n"
"your name so mankind will always remember\n"
"your cool rating."
msgstr ""
"អ្នក​បាន​ធ្វើ​វា​យ៉ាង​ល្អ ដោយ​ត្រូវ​មាន​វត្តមាន​ក្នុង \"សាល​កិត្តិនាម\" ។ វាយ​បញ្ចូល\n"
"ឈ្មោះ​របស​់​អ្នក ដូច្នេះ​មនុស្ស​ជាតិ​នឹង​ចងចាំ​ជានិច្ច​នូវ\n"
"អត្រា​ដ៏​ប្រពៃ​របស់​អ្នក ។"

#: app.cpp:340
msgid "Your name:"
msgstr "ឈ្មោះ​របស់​អ្នក ៖"

#: app.cpp:575 app.cpp:580
msgid "Hall of Fame"
msgstr "សាល​កិត្តិនាម"

#: app.cpp:602
msgid "Rank"
msgstr "ចំណាត់​ថ្នាក់"

#: app.cpp:606
msgid "Name"
msgstr "ឈ្មោះ"

#: app.cpp:610
msgid "Time"
msgstr "ពេលវេលា"

#: app.cpp:614
msgid "Size"
msgstr "ទំហំ"

#: app.cpp:618
msgid "Score"
msgstr "ពិន្ទុ"

#: app.cpp:669
msgid "(gravity)"
msgstr "(ទំនាញ)"

#: app.cpp:735
msgid "General"
msgstr "ទូទៅ"

