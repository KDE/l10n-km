#: kbbmainwindow.cpp:243
msgid "Give Up"
msgstr "បោះបង់"

#: kbbmainwindow.cpp:257
#, qt-format
msgid ""
"Your final score is: %1\n"
"You did really well!"
msgstr ""
"ពិន្ទុ​ចុង​ក្រោយ​របស់អ្នកគឺ ៖ %1\n"
