#: MainWindow.cpp:47
msgid "&Level Collection"
msgstr "ការ​ប្រមូល​កម្រិត"

#: MainWindow.cpp:115
msgid "&Next Level"
msgstr "កម្រិត​បន្ទាប់"

#: MainWindow.cpp:121
msgid "&Previous Level"
msgstr "កម្រិត​មុន"

#: MainWindow.cpp:127
msgid "Re&start Level"
msgstr "ចាប់ផ្ដើម​កម្រិត​ឡើង​វិញ"

#: MainWindow.cpp:142
msgid "&Slow"
msgstr "យឺត"

#: MainWindow.cpp:145
msgid "&Medium"
msgstr "មធ្យម"

#: MainWindow.cpp:148
msgid "&Fast"
msgstr "លឿន"

#: MainWindow.cpp:151
msgid "&Off"
msgstr "បិទ"

#: MainWindow.cpp:175 MainWindow.cpp:203
msgid "(unused)"
msgstr "(មិន​បាន​ប្រើ)"

#: MainWindow.cpp:244
msgid "(invalid)"
msgstr "(មិន​ត្រឹម​ត្រូវ)"

#: MainWindow.cpp:299
msgid "Load Levels From File"
msgstr "ផ្ទុក​កម្រិត​ពី​ឯកសារ"

#: MainWindow.cpp:338
msgid "No levels found in file"
msgstr "រក​មិន​ឃើញ​កម្រិត​ក្នុង​ឯកសារ"

#: PlayField.cpp:59
msgid "Level:"
msgstr "កម្រិត ៖​"

#: PlayField.cpp:59
msgid "Steps:"
msgstr "ជំហាន ៖"

#: PlayField.cpp:60
msgid "Pushes:"
msgstr "រុញ ៖"

#: PlayField.cpp:473
msgid "Level completed"
msgstr "បាន​បញ្ចប់​កម្រិត"

#: PlayField.cpp:824
msgid ""
"This is the last level in\n"
"the current collection."
msgstr ""
"នេះ​ជា​កម្រិត​ចុងក្រោយ​ក្នុង\n"
"ការ​ប្រមូល​បច្ចុប្បន្ន ។"

#: PlayField.cpp:830
msgid ""
"You have not completed\n"
"this level yet."
msgstr ""
"អ្នក​មិន​ទាន់​បាន​បញ្ចប់\n"
"កម្រិត​នេះ​នៅ​ឡើយ​ទេ ។"

#: PlayField.cpp:844
msgid ""
"This is the first level in\n"
"the current collection."
msgstr ""
"នេះ​ជា​កម្រិត​ដំបូង​ក្នុង\n"
"ការ​ប្រមូល​បច្ចុប្បន្ន ។"

#: PlayField.cpp:997
msgid ""
"Sorry, bookmarks for external levels\n"
"is not implemented yet."
msgstr ""
"សូម​អភ័យទោស ចំណាំ​សម្រាប់​កម្រិត​ខាង​ក្រៅ\n"
"មិន​ទាន់​ត្រូវ​បាន​អនុវត្ត​នៅ​ឡើយ​ទេ ។"

#: PlayField.cpp:1021
msgid "This level is broken"
msgstr "កម្រិត​នេះ​ខូច​ហើយ"

#: main.cpp:30
msgid "The japanese warehouse keeper game"
msgstr "ល្បែង​ថែរក្សា​ឃ្លាំង​របស់​ជន​ជាតិ​ជប៉ុន"

#: main.cpp:37
msgid "Level collection file to load"
msgstr "ឯកសារ​ប្រមូល​កម្រិត ដែល​ត្រូវ​ផ្ទុក"

#: main.cpp:45
