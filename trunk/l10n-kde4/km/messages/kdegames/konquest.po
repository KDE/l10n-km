#: gamelogic.cc:208
#, kde-format
msgid "Reinforcements (1 ship) have arrived for planet %2."
msgid_plural "Reinforcements (%1 ships) have arrived for planet %2."
msgstr[0] "ទ័ព​ជំនួយ (%1 នាវា) បាន​មក​ដល់​​ផ្កាយព្រះគ្រោះ %2 ។"

#: gamelogic.cc:258
#, kde-format
msgid "Planet %2 has held against an attack from %1."
msgstr "ផ្កាយ​ព្រះ​គ្រោះ​ %2 បាន​ទប់​ទល់​នឹង​ការ​វាយ​ប្រហារ​ពី %1 ។"

#: gamelogic.cc:266
#, kde-format
msgid "Planet %2 has fallen to %1."
msgstr "ផ្កាយ​ព្រះ​គ្រោះ​ %2 បាន​ធ្លាក់​ទៅ​កាន់​ %1 ។"

