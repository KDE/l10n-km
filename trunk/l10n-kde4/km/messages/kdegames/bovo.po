msgid "Theme"
msgstr "ស្បែក"

#. i18n: file: gui/bovo.kcfg:13
#. i18n: ectx: label, entry (skill), group (bovo)
#: rc.cpp:8
msgid "Difficulty level: strength of the computer player."
msgstr "កម្រិត​ពិបាក ៖ កម្លាំង​របស់​អ្នកលេង​ជា​កុំព្យូទ័រ ។"

#. i18n: file: gui/bovo.kcfg:17
#. i18n: ectx: label, entry (playbackSpeed), group (bovo)
#: rc.cpp:11
msgid "Speed of demo and replay playback."
msgstr "ល្បឿន​នៃ​កា​របង្ហាញ​សាកល្បង និង​ចាក់​ឡើងវិញ ។"

#. i18n: file: gui/bovo.kcfg:23
#. i18n: ectx: label, entry (animation), group (bovo)
#: rc.cpp:14
msgid "Whether moves should be animated or not."
msgstr "ថាតើ​ការ​ផ្លាស់ទី​គួរ​មាន​ចលនា​ ឬ​ក៏អត់ ។"

#. i18n: file: gui/bovo.kcfg:27
#. i18n: ectx: label, entry (ai), group (bovo)
#: rc.cpp:17
msgid "AI engine to use."
msgstr "ម៉ាស៊ីន AI ត្រូវ​ប្រើ ។"

#: gui/main.cc:30
msgid "KDE Five in a Row Board Game"
msgstr "ល្បែ​ងប្រាំគ្រាប់​​ជា​ជួរ​នៅ​លើ​ក្ដារ​របស់ KDE"

#: gui/main.cc:35
msgid "Bovo"
msgstr "Bovo"

#: gui/main.cc:37
msgid "(c) 2002,2007 Aron Boström"
msgstr "រក្សាសិទ្ធិ​ឆ្នាំ ២០០២, ២០០៧ ដោយ Aron Boström"

#: gui/main.cc:38
msgid "Aron Boström"
msgstr "Aron Boström"

#: gui/main.cc:38
msgid "Author"
msgstr "អ្នក​និពន្ធ"

#: gui/mainwindow.cc:70 gui/mainwindow.cc:345 gui/mainwindow.cc:350
#, kde-format
msgid "Wins: %1"
msgstr "ឈ្នះ ៖ %1"

#: gui/mainwindow.cc:71 gui/mainwindow.cc:251 gui/mainwindow.cc:354
#: gui/mainwindow.cc:359
#, kde-format
msgid "Losses: %1"
