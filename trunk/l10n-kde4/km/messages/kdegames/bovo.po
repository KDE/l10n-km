#: gui/mainwindow.cc:183
msgid "&Replay"
msgstr "លេង​ម្ដង​ទៀត"

#: gui/mainwindow.cc:185
msgid "Replay game"
msgstr "លេង​ល្បែង​ម្ដង​ទៀត"

#: gui/mainwindow.cc:186
msgid "Replays your last game for you to watch."
msgstr "លេង​​ល្បែង​ចុងក្រោយ​ឡើង​វិញ​សម្រាប់​អ្នក​មើល ។"

#: gui/mainwindow.cc:192
msgid "&Animation"
msgstr "ចលនា"

#: gui/mainwindow.cc:335
msgid "Start a new Game to play"
msgstr "ចាប់ផ្ដើម​ល្បែង​ថ្មី​ដើម្បី​ចាក់​លេង"

#: gui/mainwindow.cc:364
msgid "GAME OVER. Tie!"
msgstr "ល្បែង​ចប់ ។ អ្នក​ឈ្នះ !"

#: gui/mainwindow.cc:367
msgid "GAME OVER. You won!"
msgstr "ល្បែង​ចប់ ។ អ្នក​ឈ្នះ !"

#: gui/mainwindow.cc:370
msgid "GAME OVER. You lost!"
msgstr "ល្បែងចប់ ។ អ្នក​ចាញ់ !"

#: gui/mainwindow.cc:382
msgid "It is your turn."
msgstr "វា​ជា​វេន​របស់​អ្នក ។"

#: gui/mainwindow.cc:386
msgid "Waiting for computer."
msgstr "រង់ចាំ​កុំព្យូទ័រ ។"

#: gui/mainwindow.cc:398
msgid "Replaying game"
msgstr "លេង​ល្បែង​ឡើងវិញ"

#: gui/mainwindow.cc:414
msgid "Game replayed."
msgstr "បាន​លេង​ល្បែង​ឡើង​វិញ ។"
