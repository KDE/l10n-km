msgstr "ភាព​ប្រសើរ​ឡើង​ផ្សេងៗ"

#: main.cpp:42
msgid "Ian Wadham"
msgstr "Ian Wadham"

#: main.cpp:43
msgid "Upgrade to KDE4 and SVG artwork support."
msgstr "ធ្វើ​ឲ្យ​ប្រសើរ​ទៅ​ KDE4 និង​ការគាំទ្រ​សិល្បៈ SVG ។"

#: main.cpp:45
msgid "Eugene Trounev"
msgstr "Eugene Trounev"

