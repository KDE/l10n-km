#: kjumpingcube.cpp:151
#, qt-format
msgid ""
"The file %1 exists.\n"
"Do you want to overwrite it?"
msgstr ""
"មាន​ឯកសារ %1 រួច​ហើយ ។\n"
"តើ​អ្នកចង់​សរសេរ​ជាន់​លើ​វា​ឬ ?"

#: kjumpingcube.cpp:153
msgid "Overwrite"
msgstr "សរ​សេរ​ជាន់​លើ"

