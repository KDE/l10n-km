#: kcubeboxwidget.cpp:351
#, kde-format
msgid ""
"The file's cube box size is outside the range %1 to %2. It will be set to %1."
msgstr "ទំហំ​ប្រអប់ cube របស់​ឯកសារ​គឺ​នៅ​ខាង​ក្រៅ​ជួរ %1 ទៅ %2 ។ វា​នឹង​ត្រូវ​បាន​កំណត់​ទៅ​កាន់ %1 ។"

#: kcubeboxwidget.cpp:369
#, kde-format
msgid "Missing input line for cube %1."
msgstr "បាត់​ជួរ​​ខាង​ក្នុង​ផល​សម្រាប់ cube %1 ។"

#: kcubeboxwidget.cpp:379
#, kde-format
msgid "Owner of cube %1 is outside the range 0 to 2."
msgstr "cube ផ្ទាល់ %1 នៅ​ខាង​ក្រៅ​ជួរ ០ ទៅ ២ ។"

#: kcubeboxwidget.cpp:385
#, kde-format
msgid "Value of cube %1 is outside the range 1 to %2."
msgstr "តម្លៃ cube %1 គឺ​នៅ​ខាង​ក្រៅ​ជួរ ១ ទៅ %2 ។"

#: kcubeboxwidget.cpp:404
msgid "Current player is neither 1 nor 2."
msgstr "អ្នក​លេង​ល្បែង​​បច្ចុប្បន្ន​មិន​មែន ១ ក៏​មិន​មែន​ ២ ។"

#: kjumpingcube.cpp:81
msgid "Current player:"
msgstr "អ្នក​លេង​​ល្បែង​បច្ចុប្បន្ន ៖"

#: kjumpingcube.cpp:119
msgid "Stop"
msgstr "បញ្ឈប់"

#: kjumpingcube.cpp:120
msgid "Force the computer to move immediately"
msgstr "បង្ខំ​កុំព្យូទ័រ​ឲ្យ​ផ្លាស់ទី​ភ្លាម​ៗ"

#: kjumpingcube.cpp:122
msgid ""
"Stop the computer's calculation of its current move and force it to move "
"immediately"
msgstr "បញ្ឈប់​ការ​គណនា​ការ​ផ្លាស់​ទី​បច្ចុប្បន្ន​របស់​កុំព្យូទ័រ​ រួច​បង្ខំ​ឲ្យ​វា​ផ្លាស់​ទី​ភ្លាម​ៗ"

#: kjumpingcube.cpp:139
msgid "New Game"
msgstr "ល្បែង​ថ្មី"

#: kjumpingcube.cpp:165
#, kde-format
msgid ""
"The file %1 exists.\n"
"Do you want to overwrite it?"
msgstr ""
"មាន​ឯកសារ %1 រួច​ហើយ ។\n"
"តើ​អ្នក​ចង់​សរសេរ​ជាន់​លើ​វា​ឬ ?"

#: kjumpingcube.cpp:167
msgid "Overwrite"
msgstr "សរ​សេរ​ជាន់​លើ"

#: kjumpingcube.cpp:188
#, kde-format
msgid "game saved as %1"
msgstr "បាន​រក្សាទុក​ល្បែង​ជា %1"

#: kjumpingcube.cpp:193
#, kde-format
msgid ""
"There was an error in saving file\n"
"%1"
msgstr ""
"មាន​កំហុស​ក្នុង​ការ​រក្សា​ទុក​ឯកសារ\n"
"%1"

#: kjumpingcube.cpp:209
#, kde-format
msgid "The file %1 does not exist!"
msgstr "ឯកសារ %1 មិន​មាន​ឡើយ !"

#: kjumpingcube.cpp:223
#, kde-format
msgid "The file %1 is not a KJumpingCube gamefile!"
msgstr "ឯកសារ %1 មិន​មែន​ជា​ឯកសារ​ល្បែង​របស់ KJumpingCube ឡើយ !"

#: kjumpingcube.cpp:238
#, kde-format
msgid ""
"There was an error loading file\n"
"%1"
msgstr ""
"មាន​កំហុស​ក្នុង​ការ​ផ្ទុក​ឯកសារ\n"
"%1"

#: kjumpingcube.cpp:249
msgid "stopped activity"
msgstr "សកម្ម​ភាព​ដែល​បាន​បញ្ឈប់"

#: kjumpingcube.cpp:272
#, kde-format
msgid "Winner is Player %1!"
msgstr "អ្នក​ឈ្នះ គឺ​អ្នក​លេង​ល្បែង %1 !"

#: kjumpingcube.cpp:274
msgid "Winner"
msgstr "អ្នក​ឈ្នះ"

#: kjumpingcube.cpp:289
msgid "Performing move."
msgstr "កំពុង​ធ្វើ​ការ​ផ្លាស់ទី ។"

#: kjumpingcube.cpp:295
msgid "Computing next move."
msgstr "កំពុង​គណនា​ការ​ផ្លាស់​ទី​បន្ទាប់ ។"

