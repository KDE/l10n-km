#: kjumpingcube.cpp:77
msgid "Current player:"
msgstr "អ្នក​លេង​បច្ចុប្បន្ន ៖"

#: kjumpingcube.cpp:107
msgid "Stop &Thinking"
msgstr "ឈប់​គិត"

#: kjumpingcube.cpp:122
msgid "New Game"
msgstr ""

#: kjumpingcube.cpp:148
#, qt-format
msgid ""
"The file %1 exists.\n"
"Do you want to overwrite it?"
msgstr ""
"មាន​ឯកសារ %1 រួច​ហើយ ។\n"
"តើ​អ្នកចង់​សរសេរ​ជាន់​លើ​វា​ឬ ?"

#: kjumpingcube.cpp:150
msgid "Overwrite"
msgstr "សរ​សេរ​ជាន់​លើ"

#: kjumpingcube.cpp:171
#, qt-format
msgid "game saved as %1"
msgstr "បាន​រក្សាទុក​ល្បែង​ជា %1"

#: kjumpingcube.cpp:176
#, qt-format
msgid ""
"There was an error in saving file\n"
"%1"
msgstr ""
"មាន​កំហុស​មួយ ពេល​រក្សាទុក​ឯកសារ\n"
"%1"

#: kjumpingcube.cpp:192
#, qt-format
msgid "The file %1 does not exist!"
msgstr "ឯកសារ %1 មិន​មាន​ឡើយ !"

#: kjumpingcube.cpp:206
#, fuzzy, qt-format
msgid "The file %1 is not a KJumpingCube gamefile!"
msgstr "ឯកសារ %1 មិន​មែន​ជា​ឯកសារ​ល្បែង​របស់ KJumpingCube ឡើយ !"

#: kjumpingcube.cpp:221
#, qt-format
msgid ""
"There was an error loading file\n"
"%1"
msgstr ""
"មាន​កំហុស​មួ​យ ពេល​ផ្ទុក​ឯកសារ\n"
"%1"

#: kjumpingcube.cpp:232
msgid "stopped activity"
msgstr "សកម្ម​ភាព​ដែល​បាន​បញ្ឈប់"

#: kjumpingcube.cpp:255
#, qt-format
msgid "Winner is Player %1!"
msgstr "អ្នក​ឈ្នះ គឺ​អ្នក​លេង %1 !"

#: kjumpingcube.cpp:256
msgid "Winner"
msgstr "អ្នក​ឈ្នះ"

#: kjumpingcube.cpp:272
msgid "Performing move."
msgstr "កំពុង​ធ្វើ​ការ​ផ្លាស់ទី ។"

#: kjumpingcube.cpp:278
msgid "Computing next move."
msgstr "កំពុង​គណនា​ការ​ផ្លាស់​ទី​បន្ទាប់ ។"

#: kjumpingcube.cpp:290
msgid "General"
msgstr "ទូទៅ"

#: main.cpp:32
msgid "Tactical one or two player game"
msgstr "ល្បែងក្បួន​យុទ្ធសាស្ត្រ ដែល​អាច​លេង​ម្នាក់​ឯង ឬ ពីរ​នាក់"

