#: gameengine.cpp:93
msgid "Game Paused!"
msgstr "ល្បែង​បាន​ផ្អាក !"

#: gameengine.cpp:212
msgid "Well done! You won the game!"
msgstr "ល្អណាស់ ! អ្នក​បាន​ឈ្នះ​ហើយ !"

#: gameengine.cpp:301 textitems.cpp:96
#, kde-format
msgid "Level %1"
msgstr "កម្រិត %1"

#: gameengine.cpp:451
msgid "Oops! You have lost the ball!"
msgstr "អុព្ហ ! អ្នក​បាន​ចាញ់​ហើយ !"

#: gameengine.cpp:515
msgid "Game Over!"
msgstr "ល្បែង​ចប់​ហើយ !"

#: gameengine.cpp:574
#, kde-format
msgid "Press %1 to fire the ball"
msgstr "ចុច %1 ដើម្បីបាញ់​បាល់"

#: main.cpp:28
msgid "KBreakOut"
msgstr "KBreakOut"

#: main.cpp:29
