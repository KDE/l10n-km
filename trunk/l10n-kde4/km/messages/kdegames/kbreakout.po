#: mainwindow.cpp:119
msgid "Fire Ball"
msgstr "បាញ់បាល់"

#: mainwindow.cpp:124
msgid "Pause"
msgstr "ផ្អាក"

#: mainwindow.cpp:147
msgid "Theme"
