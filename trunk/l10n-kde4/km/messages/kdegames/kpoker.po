msgid "&Deal New Round"
msgstr "ចែក​ជុំ​ថ្មី"

#: kpoker.cpp:898
msgid "&See!"
msgstr "មើល !"

#: kpoker.cpp:908
msgid "&Draw New Cards"
msgstr "ហូត​បៀ​ថ្មី"

#: kpoker.cpp:940
msgid "One Pair"
msgstr "មួយ​ផែ"

#: kpoker.cpp:944
msgid "Two Pairs"
msgstr "ពីរ​ផែ"

#: kpoker.cpp:948
msgid "3 of a Kind"
msgstr "៣ ដូច​គ្នា"

#: kpoker.cpp:952
msgid "Straight"
msgstr "រៀង"

#: kpoker.cpp:956
msgid "Flush"
msgstr "មួយ​ទឹក"

#: kpoker.cpp:960
msgid "Full House"
msgstr "ផ្ទះ​ពេញ"

#: kpoker.cpp:964
msgid "4 of a Kind"
msgstr "៤ ដូច​គ្នា"

