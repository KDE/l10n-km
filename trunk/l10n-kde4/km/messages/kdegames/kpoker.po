#: betbox.cpp:61
msgid "Adjust Bet"
msgstr "លៃ​តម្រូវ​ការ​ភ្នាល់"

#: betbox.cpp:62
msgid "Fold"
msgstr "បត់"

#: kpoker.cpp:178 newgamedlg.cpp:140
msgid "You"
msgstr "អ្នក"

#: kpoker.cpp:258 kpoker.cpp:374
msgid "&Deal"
msgstr "ចែក"

#: kpoker.cpp:273 kpoker.cpp:815
#, qt-format
msgid "You won %1"
msgstr "អ្នក​បាន​ឈ្នះ %1"

#: kpoker.cpp:311
msgid "Continue the round"
msgstr "បន្ត​ជុំ"

#: kpoker.cpp:312
msgid "The current pot"
msgstr "ចាន​បច្ចុប្បន្ន"

#: kpoker.cpp:532
msgid "Clicking on draw means you adjust your bet"
msgstr "ចុច​លើ​ហូត​មាន​ន័យ​ថា​អ្នក​លៃ​តម្រូវ​ការ​ភ្នាល់​របស់​អ្នក"

#: kpoker.cpp:534
msgid "Clicking on draw means you are out"
msgstr "ចុច​លើ​ហូត​មាន​ន័យ​ថា​អ្នក​ចេញ​ហើយ"

#: kpoker.cpp:657 kpoker.cpp:699
msgid "Nobody"
msgstr "គ្មាន​អ្នក​ណាម្នាក់"

#: kpoker.cpp:663 kpoker.cpp:701 kpoker.cpp:936 kpoker.cpp:976 kpoker.cpp:1216
msgid "Nothing"
msgstr "គ្មាន​អ្វីសោះ"

#: kpoker.cpp:690
#, qt-format
msgid "Pot: %1"
msgstr "ចាន ៖ %1"

