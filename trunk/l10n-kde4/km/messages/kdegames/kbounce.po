#: gamewidget.cpp:342
msgid ""
"Welcome to KBounce.\n"
" Click to start a game"
msgstr ""
"សូម​ស្វាគមន៍​មក​កាន់ KBounce ។\n"
" ចុច​ដើម្បី​ចាប់ផ្ដើម​ល្បែង"

#: gamewidget.cpp:345
msgid "Paused"
msgstr "បាន​ផ្អាក"

#: gamewidget.cpp:348
#, kde-format
msgid "You have successfully cleared more than %1% of the board\n"
msgstr "អ្នក​បាន​ជម្រះ​ដោយជោគជ័យ​នូវ​ក្ដារ​ច្រើន​ជាង %1%\n"

#: gamewidget.cpp:349
#, kde-format
msgid "%1 points: %2 points per remaining life\n"
msgstr "%1 ពិន្ទុ ៖ %2 ពិន្ទុ​/ជីវិត​ដែល​នៅ​សល់\n"

#: gamewidget.cpp:350
#, kde-format
msgid "%1 points: Bonus\n"
msgstr "%1 ពិន្ទុ ៖ ពិន្ទុ​បន្ថែម\n"

#: gamewidget.cpp:351
#, kde-format
msgid "%1 points: Total score for this level\n"
msgstr "%1 ពិន្ទុ ៖ ពិន្ទុ​សរុប​សម្រាប់​កម្រិត​នេះ\n"

#: gamewidget.cpp:352
#, kde-format
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr "បន្ត​ទៅ​កម្រិត %1 ។ ចងចាំ​ថា ពេល​នេះ​អ្នក​ទទួល​បាន​ជីវិត %2 !"

#: gamewidget.cpp:355
#| msgid ""
#| "Welcome to KBounce.\n"
#| " Click to start a game"
msgid ""
"Game over.\n"
" Click to start a game"
msgstr ""
"ល្បែង​ចប់ហើយ ។\n"
" ចុច​ដើម្បី​ចាប់ផ្ដើម​ល្បែង"

