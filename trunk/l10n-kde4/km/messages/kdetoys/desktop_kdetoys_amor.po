#: data/billyrc:5
msgctxt "Description"
msgid "Little Billy"
msgstr "កូនប៊ីលីតូច"

#: data/billyrc:76
msgctxt "About"
msgid "Static window sitter\\nGraphic from http://www.xbill.org/"
msgstr "អ្នក​ថែទាំ​បង្អួចថិតិវន្ត\\nរចនា​ក្រាហ្វិក​ពី http://www.xbill.org/"

#: data/blobrc:4
msgctxt "Description"
msgid "Multi-Talented Spot"
msgstr "ក្បាល​មាន​ទេពកោសល្យ​ច្រើន"

#: data/blobrc:68
msgctxt "About"
msgid "By Martin R. Jones\\nJet pack, beam and fire animations by Mark Grant"
msgstr "ដោយ Martin R. Jones\\nJet pack, ចលនា​ភ្លើង និង​បាច់​ពន្លឺ​ដោយ Mark Grant"

#: data/bonhommerc:8
msgctxt "Description"
msgid "Bonhomme"
msgstr "មនុស្ស​ឆ្អឹង"

#: data/bonhommerc:74 data/eyesrc:75
msgctxt "About"
msgid "By Jean-Claude Dumas"
msgstr "ដោយ Jean-Claude Dumas"

#: data/bsdrc:5
msgctxt "Description"
msgid "FreeBSD Mascot"
msgstr "សុភមង្គល​វត្ថុ FreeBSD"

#: data/bsdrc:73 data/tuxrc:74
msgctxt "About"
msgid "Static window sitter"
msgstr "អ្នក​ថែទាំ​បង្អួចឋិតិវន្ត"

#: data/eyesrc:6
msgctxt "Description"
msgid "Crazy Eyes"
msgstr "ភ្នែក​ឆ្កួតៗ"

#: data/ghostrc:4
msgctxt "Description"
msgid "Spooky Ghost"
msgstr "ខ្មោច​ដែល​គួរ​ឲ្យ​ព្រឺ​ក្បាល"

#: data/ghostrc:72
msgctxt "About"
msgid "By Martin R. Jones\\nBased on an icon by the KDE artist team."
msgstr "ដោយ Martin R. Jones\\nផ្អែកលើ​រូបតំណាង​រចនាដោយ​ក្រុម​វិចិត្រករ KDE ។"

#: data/nekokurorc:9
msgctxt "Description"
msgid "Neko Kuro"
msgstr "Neko Kuro"

#: data/nekokurorc:58
msgctxt "About"
msgid ""
"Artwork from oneko by Masayuki Koba\\nAMOR'd by Chris Spiegel\\nKuro (Black) "
"version by Bill Kendrick"
msgstr ""
"សិល្បៈ​ពី oneko ដោយ Masayuki Koba\\nAMOR'd ដោយ Chris Spiegel\\nKuro (Black) កំណែ​"
"ដោយ Bill Kendrick"

#: data/nekorc:7
msgctxt "Description"
msgid "Neko"
msgstr "នេកូ"

#: data/nekorc:77
msgctxt "About"
msgid "Artwork from oneko by Masayuki Koba\\nAMOR'd by Chris Spiegel"
msgstr ""
"សិល្បៈកម្ម​ពី អូនេកូ(oneko) ដោយ មាសាយូគី កូបា (Masayuki Koba)\\nAMOR'd ដោយ Chris "
"Spiegel"

#: data/pingurc:4
msgctxt "Description"
msgid "Tux"
msgstr "Tux"

#: data/pingurc:75
msgctxt "About"
msgid "By Frank Pieczynski\\nBased on graphics of the game \"pingus\"."
msgstr "ដោយ Frank Pieczynski\\nផ្អែកលើ​ក្រាហ្វិក​ល្បែង \"pingus\" ។"

#: data/taorc:4
msgctxt "Description"
msgid "Tao"
msgstr "Tao"

#: data/taorc:75
msgctxt "About"
msgid ""
"By Daniel Pfeiffer <occitan@esperanto.org>\\nYin Yang symbol inspired by my "
"Tai Chi practice."
msgstr ""
"ដោយ Daniel Pfeiffer <occitan@esperanto.org>\\nនិមិត្ត​សញ្ញាយីងយ៉ាង(Yin Yang) "
"ដែលបង្កើត​ឡើងដោយការអនុវត្តតាយឈី (Tai Chi) របស់​ខ្ញុំ ។"

#: data/tuxrc:5
msgctxt "Description"
msgid "Unanimated Tux"
msgstr "Tux គ្មាន​ចលនា"

#: data/wormrc:4
msgctxt "Description"
msgid "Little Worm"
msgstr "កូន​ដង្កូវ​តូច"

#: data/wormrc:75
msgctxt "About"
msgid "By Bartosz Trudnowski\\nMade for my wife"
msgstr "ដោយ Bartosz Trudnowski\\nសម្រាប់​ភរិយា​ខ្ញុំ"

