msgid "<screeninfo>&krdc; bookmarks menu</screeninfo>"
msgstr "<screeninfo>ជារូបតំណាង​សម្រាប់បិទ​ការតភ្ជាប់ផ្ទៃតុពីចម្ងាយ​</screeninfo>"

#. Tag: phrase
