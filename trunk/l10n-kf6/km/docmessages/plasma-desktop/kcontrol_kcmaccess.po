#. Tag: guilabel
#: index.docbook:520
#, no-c-format
msgid ""
"Use the system bell whenever a gesture is used to turn an accessibility "
"feature on or off"
msgstr ""

#. Tag: guilabel
#: index.docbook:523
#, no-c-format
msgid ""
"Show a confirmation dialog whenever a keyboard accessibility feature is "
"turned on or off"
msgstr ""

#. Tag: member
#: index.docbook:525
#, no-c-format
