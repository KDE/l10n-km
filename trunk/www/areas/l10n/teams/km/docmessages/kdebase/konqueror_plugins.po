#. Tag: chapterinfo
#: plugins.docbook:7
#, no-c-format
msgid "<date>2002-09-22</date> <releaseinfo>3.1</releaseinfo>"
msgstr "<date>២០០២-០៩-២២</date> <releaseinfo>៣.១</releaseinfo>"

#. Tag: title
#: plugins.docbook:14
#, no-c-format
msgid "Plugins"
msgstr "កម្មវិធី​ជំនួយ​"

#. Tag: title
#: plugins.docbook:17
#, no-c-format
msgid "&Netscape; Plugins"
msgstr "កម្មវិធី​ជំនួយ​ &Netscape;"

#. Tag: para
#: plugins.docbook:19
#, no-c-format
msgid "Currently, &konqueror; supports &Netscape; 4.x plugins."
msgstr "បច្ចុប្បន្ន​ &konqueror; គាំទ្រ​កម្មវិធី​ជំនួយ​ &Netscape; ៤.x ។​"

#. Tag: para
#: plugins.docbook:21
#, no-c-format
msgid ""
"Selecting <menuchoice><guimenu>Settings</guimenu><guisubmenu> "
"Configure Konqueror...</guisubmenu><guimenuitem>Plugins</guimenuitem> "
"</menuchoice> will give you a dialog box with two tabbed pages; <guilabel>"
"Scan</guilabel> and <guilabel>Plugins</guilabel>."
msgstr ""
"ជ្រើស​ <menuchoice><guimenu>ការកំណត់​</guimenu><guisubmenu> "
"កំណត់រចនាសម្ព័ន្ធ​Konqueror...</guisubmenu><guimenuitem>កម្មវិធី​ជំនួយ​</guimenuitem> "
"</menuchoice> វា​ និង​បង្ហាញ​ប្រអប់​ដែល​មាន​ផ្ទាំងពី​រ <guilabel>"
"ស្កេន​</guilabel> និង​ <guilabel>កម្មវិធី​ជំនួយ​</guilabel> ។​"

#. Tag: para
#: plugins.docbook:26
#, no-c-format
msgid ""
"The <guilabel>Scan</guilabel> page controls how &kde; scans for new &Netscape; "
"plugins, either manually by pressing the <guibutton>"
"Scan for New Plugins</guibutton> button or automatically each time &kde; starts "
"up."
msgstr " <guilabel>ស្កេន​</guilabel>វត្ថុ​បញ្ជា​ទំព័រ​ ថាតើ​ &kde; ស្កេន​កម្មវិធី​ជំនួយ​ថ្មី​របស់​ &Netscape; យ៉ាង​ដូចម្តេច  ចុច​ស្កេន​សៀវភៅ​ដៃលើ​ប៊ូតុង​​ <guibutton>កម្មវិធី​ជំនួយ​​ស្កេន​ថ្មី  </guibutton> ឬ button ចាប់​ផ្តើម​ &kde; រាល់​ពេល​ដោយ​ស្វ័យប្រវត្តិ ។ "

#. Tag: para
#: plugins.docbook:30
#, no-c-format
msgid ""
"The scan is done by looking through the folders listed in the <guilabel>"
"Scan Folders</guilabel> list for <literal role=\"extension\">.so</literal> "
"files containing plugin code. It examines every such file to find out which "
"<acronym>MIME</acronym> types the plugin supports. It then creates <acronym>"
"MIME</acronym> type definitions for &kde; in the user's <filename "
"class=\"directory\"> ~/.kde/share/mimelnk</filename> "
"folder to make other applications aware of them."
msgstr ""
"ស្កេន​ត្រូវ​បាន​ធ្វើ​រួច​ ដោយពិនិត្រ​មើល​ថត​ដែល​បាន​រាយ​បញ្ជី​ក្នុង​<guilabel>បញ្ជី​ថត​ស្កេន​</guilabel> សម្រាប់​ឯកសារ​ <literal role=\"extension\">.so</literal> "
"ដែល​មាន​កូដ​កម្មវិធី​ជំនួយ​ ។ វា​ពិនិត្យ​គ្រប់​ឯកសារ​ទាំង​អស់​ដើម្បី​រក​ឲ្យ​ឃើញ​នូវ​ប្រភេទ​កម្មវិធី​ជំនួយ​ដែល​គាំទ្រ​"
"<acronym>MIME</acronym>  ។ "
"វា​អាច​បង្កើត​ការកំណត់ប្រភេទ​ <acronym>"
"MIME</acronym> សម្រាប់​ &kde; ក្នុងថត​របស់​អ្នក​ប្រើ  <filename "
"class=\"directory\"> ~/.kde/share/mimelnk</filename> "
"ដើម្បី​បង្កើត​កម្មវិធី​ថ្មី​ផ្សេងទៀត​ដែល​អ្នក​ចង់​បាន​ ។​"

#. Tag: para
#: plugins.docbook:38
#, no-c-format
msgid ""
"The <guilabel>Plugins</guilabel> page shows you the &Netscape; plugins that "
"&kde; has found, and for each plugin it lists the <acronym>MIME</acronym> "
"types and the filename suffixes it uses to recognize them."
msgstr ""
"ទំព័រ​ <guilabel>កម្មវិធី​ជំនួយ​</guilabel> បង្ហាញ​​កម្មវិធី​ជំនួយ &Netscape; ដល់អ្នក​ដែល​"
"&kde; បាន​រក​ឃើញ​ ហើយ​សម្រាប់​កម្មវិធី​ជំនួយ​និមួយៗ "
"វា​បាន​រាយ​បញ្ជី​ប្រភេទ​ <acronym>MIME</acronym> និង​ប្រភេទ​បច្ចយ​ឈ្មោះ​ឯកសារ​ វា​ប្រើ​ដើម្បី​រៀបចំពួក​វា​ ។ "

#. Tag: para
#: plugins.docbook:42
#, no-c-format
msgid ""
"The dialog box also contains a checkbox <guilabel> Enable plugins "
"globally</guilabel> which you can use to enable or disable plugins that can be "
"contained in <acronym>HTML</acronym> pages (these can be considered a security "
"risk)."
msgstr ""
"ប្រអប់​ក៏​មាន​​ប្រអប់​ធីក​បើក​ <guilabel> កម្មវិធី​ជំនួយ​ជា​សកល​ផង​ដែរ​</guilabel> ដែល​​អ្នកអាច​ប្រើ​ដើម្បីបើក​ ឬ​បិទ​កម្មវិធី​ជំនួយ​ហើយ​អាច​មាន​ទំព័រ​ <acronym>HTML</acronym> ផងដែរ​ "
"(ប្រអប់​ទាំង​នោះ​អាច​ត្រូវ​បាន​ពិនិត្យ​ពី​សុវត្ថិភាព​) ។ "

#. Tag: title
#: plugins.docbook:50
#, no-c-format
msgid "&konqueror; Plugins"
msgstr "កម្មវិធី​ជំនួយ &konqueror; "

#. Tag: para
#: plugins.docbook:52
#, no-c-format
msgid ""
"The package kdeaddons contains several useful plugins that interact with "
"&konqueror; in various ways. These are explained briefly below, more detailed "
"information may be obtained by looking through the <guimenuitem>"
"Konqueror Plugins</guimenuitem> section in the &kde; Help Center."
msgstr ""
"កញ្ចប់​ kdeaddons មាន​កម្មវិធី​ជំនួយមាន​អន្តរកម្ម​ជា​មួយ​"
"&konqueror; ក្នុង​វិធី​ផ្សេង​គ្នា​​។ មាន​ការពន្យល់​យ៉ាងសង្ខេប​ដូចខាងក្រោម​ ព័ត៌​មាន​លម្អិត​បន្ថែម​ត្រូវ​បានទទួលបាន​ដោយ​"
"មើលកម្មវិធី​ជំនួយ​​ភាគ​ <guimenuitem>"
"Konqueror </guimenuitem> ក្នងមជ្ឈមណ្ឌលជំនួយ​របស់​ &kde; ​។ "

#. Tag: term
#: plugins.docbook:60
#, no-c-format
msgid "Web Page Translation"
msgstr "ការបកប្រែ​ទំព័រ​បណ្តាញ "

#. Tag: para
#: plugins.docbook:61
#, no-c-format
msgid ""
"This uses AltaVista's BabelFish site to translate the current <acronym>"
"HTML</acronym> page to whatever language you want (within reason). It can be "
"launched with <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"Translate Web Page</guisubmenu></menuchoice>."
msgstr "ប្រើ​តំបន់បណ្តាញ​ BabelFish របស់​ AltaVista ដើម្បីបក​ប្រែ​ទំព័រ​ <acronym>HTML</acronym> បច្ចុប្បន្ន​ទៅ​កាន់ភាសាអ្វី​ដែល​អ្នកចង់បាន​ (ជា​មូលហេតុ​)​។ វា​អាច​ត្រូវ​បាន​បើក​ដំណើរការ​កម្មវិធី​ជា​មួយ<menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu>​បក​ប្រែ​ទំព័រ​បណ្តាញ  </guisubmenu></menuchoice> ។ "

#. Tag: term
#: plugins.docbook:68
#, no-c-format
msgid "Folder View Filter"
msgstr "តម្រង​មើល​ថត​"

#. Tag: para
#: plugins.docbook:69
#, no-c-format
msgid ""
"This is controlled by <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"View Filter</guisubmenu></menuchoice> and allows you to choose which types of "
"item are displayed in a folder."
msgstr ""
"តម្រង​នេះ​ត្រូវ​បាន​ពិនិត្យ​តាម​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu>"
"តម្រង​មើល​</guisubmenu></menuchoice> ហើយ​អនុញ្ញាត​ឲ្យ​អ្នក​ជ្រើស​ប្រភេទ​នៃធាតុ​ដែល​ត្រូវ​បង្ហាញក្នុង​ថត​​។ "

#. Tag: term
#: plugins.docbook:76
#, no-c-format
msgid "DOM Tree Viewer"
msgstr "កម្មវិធីទិដ្ឋភាព​មែកធាង ​DOM"

#. Tag: para
#: plugins.docbook:77
#, no-c-format
msgid ""
"Selecting <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"Show DOM Tree</guisubmenu></menuchoice> opens a new window which displays the "
"document object model (DOM) of the current <acronym>HTML</acronym> page."
msgstr ""
"ជ្រើស​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu>"
"បង្ហាញ​មែកធាង​ DOM </guisubmenu></menuchoice> បើក​បង្អួច​ថ្មី​ដែល​បង្ហាញ​ម៉ូដែល​វត្ថុឯកសារ​ (DOM) នៃ​ទំព័រ​ <acronym>HTML</acronym> បច្ចុប្បន្ន​​។​"

#. Tag: term
#: plugins.docbook:84
#, no-c-format
msgid "HTML Validator"
msgstr "កម្មវិធី​ធ្វើ​ឲ្យ HTML មានសុពលភាព​"

#. Tag: para
#: plugins.docbook:85
#, no-c-format
msgid ""
"This is started with <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"Validate Web Page</guisubmenu><guimenuitem>Validate HTML</guimenuitem>"
"</menuchoice>. It uses the W3C HTML validator to validate the current page, "
"very useful when creating web pages."
msgstr ""
"ការនេះ​បានចាប់ផ្តើម​ជា​មួយ​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu>"
"ទំព័រ​បណ្តាញ​ដែល​មានសុពលភាព​ </guisubmenu><guimenuitem>ធ្វើ​ឲ្យ​ HTML មាន​សុពលភាព​</guimenuitem></menuchoice> ។​"
"វា​ប្រើ​កម្មវិធី​ធ្វើ​ឲ្យ​ W3C HTML មាន​សុពលភាព​ ទៅ​ទំព័រ​បច្ចុប្បន្ន​ដែល​មាន​សុពលភាព ហើយ​វា​មានប្រយោជន៍​ពេល​បង្កើត​ទំព័រ​"
"បណ្តាញ  ។​"

#. Tag: term
#: plugins.docbook:93
#, no-c-format
msgid "CSS Validator"
msgstr "ធ្វើ​ឲ្យ CSS មានសុពលភាព​"

#. Tag: para
#: plugins.docbook:94
#, no-c-format
msgid ""
"Started with <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"Validate Web Page</guisubmenu><guimenuitem>Validate CSS</guimenuitem>"
"</menuchoice>, it uses the W3C CSS validator to validate the current page's "
"Cascading Style Sheets."
msgstr ""
"បាន​ចាប់​ផ្តើម​ជា​មួយ​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu>"
"ទំព័រ​បណ្តាញ​ធ្វើ​ឲ្យ​មាន​សុពល​ភាព​ </guisubmenu><guimenuitem>ធ្វើ​ឲ្យ​ CSS មានសុពលភាព​</guimenuitem></menuchoice>, វា​ប្រើ​​ W3C CSS ធ្វើ​ឲ្យ​មានសុពល​ភាពទៅ​​សន្លឹក​រចនាប័ទ្ម​ល្បាក់​របស់​ទំព័រ​បច្ចុប្បន្ន​ធ្វើ​ឲ្យ​មាន "
"​សុពល​ភាព​ ។"

#. Tag: term
#: plugins.docbook:102
#, no-c-format
msgid "HTML Settings"
msgstr "ការកំណត់ HTML "

#. Tag: para
#: plugins.docbook:103
#, no-c-format
msgid ""
"Select <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"HTML Settings</guisubmenu></menuchoice> to enable or disable a number of HTML "
"settings without going through the <guimenu>Settings</guimenu> dialog."
msgstr ""
"ជ្រើស​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu>ការកំណត់​"
"HTML </guisubmenu></menuchoice> ដើម្បី​បើក ឬ​បិទការកំណត់​ចំនួន​ HTML ដោយ​ពុំ​បាច់​ឆ្លង​កាត់​ប្រអប់​ <guimenu>ការ "
"កំណត់​</guimenu> ។​"

#. Tag: term
#: plugins.docbook:110
#, no-c-format
msgid "Image Gallery"
msgstr "វិចិត្រសាល​រូបភាព​"

#. Tag: para
#: plugins.docbook:111
#, no-c-format
msgid ""
"In File Manager mode, you can select <menuchoice><guimenu>Tools</guimenu>"
"<guisubmenu>Create Image Gallery</guisubmenu></menuchoice> "
"to create an HTML page with thumbnails of all the images in the current folder. "
"By default the HTML page is called <filename>images.html</filename> "
"and the thumbnails are put into a new <filename>thumbs</filename> folder."
msgstr ""
"នៅ​ក្នុង​របៀប​កម្មវិធី​គ្រប់គ្រង​ឯកសារ​"
"អ្នក​អាច​ជ្រើស​ <menuchoice><guimenu>ឧបករណ៍​</guimenu>"
"<guisubmenu>បង្កើត​វិចិត្រសាល​រូបភាព​ </guisubmenu></menuchoice> "
"ដើម្បីបង្កើត​ទំព័រ​ HTML ជា​មួយ​រូបភាព​តូចៗ​នៃ​រូបភាព​ទាំង​អស់​ក្នុង​ថត​បច្ចុប្បន្ន​ ។ តាម​លំនាំដើម​ ទំព័រ​ HTML ត្រូវ​បាន​គេហៅ​ <filename>images.html</filename> "
"ហើយ​រូបភាព​តូចៗ​ត្រូវ​បានដាក់​បញ្ចូល​ក្នុង​ថត​ <filename>thumbs</filename> ថ្មី​​មួយ​​​។ "

#. Tag: term
#: plugins.docbook:121
#, no-c-format
msgid "User Agent Changer"
msgstr "កម្មវិធី​ផ្លាស់ប្តូរ​ភ្នាក់ងារ​អ្នក​ប្រើ​"

#. Tag: para
#: plugins.docbook:122
#, no-c-format
msgid ""
"Select <menuchoice><guimenu>Tools</guimenu><guisubmenu>"
"Change Browser Identification</guisubmenu></menuchoice> "
"to get a menu that allows you to change the User Agent string without going "
"through the <guimenu>Settings </guimenu> dialog procedure."
msgstr ""
"ជ្រើស​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu> ផ្លាស់ប្តូរ​អត្ថសញ្ញាណ​កម្មវិធី​រុករក​"
"</guisubmenu></menuchoice> ដើម្បី​ទទួល​យក​ម៉ឺនុយ​ដែល​អនុញ្ញាត​ឲ្យ​អ្នក​​ផ្លាស់ប្តូរ​ភ្នាក់ងារ​អ្នក​ប្រើ​ខ្សែអក្សរដោយ​ពុំចាំបាច់​បន្ត​ឆ្លង​កាត់​ប្រអប់​ <guimenu>ការកំណត់​ </guimenu> បែបបទ​។​"

#. Tag: term
#: plugins.docbook:130
#, no-c-format
msgid "Archive Web Page"
msgstr "ទំព័រ​បណ្តាញ ប័ណ្ណសា​"

#. Tag: para
#: plugins.docbook:131
#, no-c-format
msgid ""
"Invoked with <menuchoice><guimenu>Tools</guimenu><guisubmenu> "
"Archive Web Page</guisubmenu></menuchoice>, this tool creates an archive "
"(<literal role=\"extension\">.war</literal> ) file containing the web page "
"being viewed including the images. <mousebutton>Left</mousebutton> "
"click on the archive file name to view the saved page."
msgstr ""
"ហៅ​ <menuchoice><guimenu>ឧបករណ៍​</guimenu><guisubmenu> "
"ទំព័រ​បណ្តាញ​ប័ណ្ណសា​</guisubmenu></menuchoice>, "
"ឧបករណ៍​នេះ​​បង្កើត​ប័ណ្ណសា​"
"ឯកសារ​ (<literal role=\"extension\">.war</literal> ) ដែល​មាន​ទំព័រ​បណ្តាញ​ចាប់​ផ្តើម​មើល​រួមទាំងរូបភាព​​។​ <mousebutton>ចុច​កណ្តុរ​ឆ្វេង​</mousebutton> លើ​ឈ្មោះឯកសារ​ប័ណ្ណសា​ដើម្បីមើល​ទំព័រ​ដែល​បានរក្សាទុក​​។​"

#. Tag: term
#: plugins.docbook:140
#, no-c-format
msgid "Navigation Panel Media Player"
msgstr "បន្ទះការរុករក​កម្មវិធី​ចាក់មេឌៀ​"

#. Tag: para
#: plugins.docbook:141
#, no-c-format
msgid ""
"This is a simple media player, embedded as a tab page in the Navigation Panel. "
"You can drag songs or videos onto this page to play them."
msgstr "នេះ​ជា​គំរូ​កម្មវិធី​ចាក់​មេឌឪ​ ត្រូវ​បានបង្កប់​ជា​ផ្ទាំង​ទំព័រ​ក្នុង​បន្ទះ​ការរុករក​។ អ្នកអាច​ទាញ​ចម្រៀង ឬ​វីដេអូ​លើ​ទំព័រ​នេះ​ដើម្បី​ចាក់​ពួក​វា​​។ "

