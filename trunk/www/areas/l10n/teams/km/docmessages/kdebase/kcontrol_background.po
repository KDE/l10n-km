#. Tag: keyword
#: index.docbook:25
#, no-c-format
msgid "KControl"
msgstr "KControl"

#. Tag: keyword
#: index.docbook:26
#, no-c-format
msgid "background"
msgstr "ផ្ទៃខាងក្រោយ​"

#. Tag: keyword
#: index.docbook:27
#, no-c-format
msgid "wallpaper"
msgstr "ក្រដាស់​បិត​ផ្ទៃតុ​"

#. Tag: title
#: index.docbook:33
#, no-c-format
msgid "<title>Background</title>"
msgstr "<title>ផ្ទៃខាងក្រោយ​</title>"

#. Tag: para
#: index.docbook:35
#, no-c-format
msgid ""
"The Background module allows you to configure colors or wallpapers for your "
"desktop background."
msgstr ""
"ម៉ូឌុល​ផ្ទៃខាងក្រោយ​អនុញ្ញាត​ឲ្យ​អ្នក​កំណត់​"
"រចនាសម្ព័ន្ធពណ៌​ ឬ​ក្រដាស់​បិត​ផ្ទៃតុ​​សម្រាប់​ផ្ទៃខាងក្រោយ​របស់​ផ្ទៃតុ ។"

#. Tag: para
#: index.docbook:38
#, no-c-format
msgid "It is comprised of four areas:"
msgstr "វា​បានបញ្ចូល​ទៅ​ក្នុង​បួន​តំបន់​ ៖"

#. Tag: para
#: index.docbook:42
#, no-c-format
msgid "Desktop selection area"
msgstr "ការជ្រើស​ផ្ទៃ​សម្រាប់​ផ្ទៃតុ​"

#. Tag: para
#: index.docbook:45
#, no-c-format
msgid "An area for selecting background images"
msgstr "ជ្រើស​រូបភាព​ផ្ទៃខាងក្រោយ​​សម្រាប់​ផ្ទៃ​"

#. Tag: para
#: index.docbook:48
#, no-c-format
msgid "The background Preview Monitor"
msgstr "មើល​​ផ្ទៃខាងក្រោយ​របស់​ម៉ូនីទ័រ​ជាមុន​"

#. Tag: para
#: index.docbook:51
#, no-c-format
msgid "An area for determining the background color"
msgstr "ផ្ទៃ​សម្រាប់​កំណត់​ពណ៌​ផ្ទៃខាងក្រោយ​"

#. Tag: term
#: index.docbook:57
#, no-c-format
msgid "Selecting the desktop"
msgstr "ដោយ​ជ្រើស​ផ្ទៃតុ"

#. Tag: para
#: index.docbook:59
#, no-c-format
msgid ""
"The drop down box labeled <guilabel>Setting for desktop:</guilabel> "
"is used to select the desktop you want to configure. You can select any of the "
"desktops individually, or you can select <guilabel>All Desktops</guilabel> "
"and the changes you make will be applied to all desktops."
msgstr ""
"ការកំណត់​ប្រអប់​ធ្លាក់ចុះ​ដែលបាន​ដាក់ឈ្មោះ  <guilabel>សម្រាប់​ផ្ទៃតុ​ ៖ </guilabel> "
"ត្រូវ​បានប្រើសម្រាប់ជ្រើស​ផ្ទៃតុ​ដែល​អ្នកចង់​កំណត់ "
"រចនាសម្ព័ន្ធ​​។ អ្នកអាច​ជ្រើស​ផ្ទៃតុ​ផ្សេងទៀត​ដែល​ជា​ផ្ទៃតុ​ផ្ទាល់ខ្លូន​ ឬ​អ្នកអាច​ជ្រើស​យក​ <guilabel>ផ្ទៃតុ​ទាំងអស់​</guilabel> ហើយ​ផ្លាស់ប្តូរ​អ្វី​ដែល​អ្នកបាន​អនុវត្ត​គ្រប់ផ្ទៃតុ​ទាំងអស់​​​ ។"

#. Tag: term
#: index.docbook:68
#, no-c-format
msgid "Preview Monitor"
msgstr "ម៉ូនីទ័រ​មើល​ជា​មុន​"

#. Tag: para
#: index.docbook:70
#, no-c-format
msgid ""
"This is a preview window. It will give you a sense of what to expect with each "
"change."
msgstr ""
"នេះជា​បង្អួច​មើល​មុន​ ។ វា​បាន​ផ្តល់​​ឲ្យ​អ្នក​នូវអ្វី​ដែល​"
"អ្នក​បាន​រំពឹង​ទុក​​រាល់​ការផ្លាស់ប្តូរ​ ។​"

#. Tag: guilabel
#: index.docbook:76
#, no-c-format
msgid "<guilabel>Background</guilabel>"
msgstr "<guilabel>ផ្ទៃខាងក្រោយ​</guilabel>"

#. Tag: para
#: index.docbook:78
#, no-c-format
msgid ""
"This section allows you to load a wallpaper on top of the color gradient chosen "
"in the section below."
msgstr ""
"ភាគ​នេះ​អនុញ្ញាតឲ្យ​អ្នក​ផ្ទុក​ក្រដាស​បិត​ផ្ទៃតុ​លើ​"
"ចំណុច​កំពូល​នៃ​ជម្រាល​ពណ៌​ដែល​បានជ្រើស​ក្នុង​"
"ភា​គ​ខាងក្រោម​ ។​"

#. Tag: para
#: index.docbook:81
#, no-c-format
msgid "There are three choices available here:"
msgstr "មាន​បីជម្រើស​ដែល​អាច​រក​បាននៅ​ទី​នេះ​ ៖​"

#. Tag: guilabel
#: index.docbook:85
#, no-c-format
msgid "No Picture"
msgstr "គ្មាន​រូបភាព​"

#. Tag: para
#: index.docbook:87
#, no-c-format
msgid ""
"No picture background will be shown. The color and pattern choices below will "
"still take effect."
msgstr ""
"ផ្ទៃខាងក្រោយ​គ្មាន​រូបភាព​"
"ដែល​​ត្រូវ​បានបង្ហាញ​​។ ពណ៌​ និ​ង​លំនាំ​ដែល​បានជ្រើស​ខាងក្រោមយ​នៅ​តែ​មាន​ប្រសិទ្ធភាព​ដដែល​ ។​"

#. Tag: guilabel
#: index.docbook:93
#, no-c-format
msgid "Picture"
msgstr "រូបភាព​"

#. Tag: para
#: index.docbook:95
#, no-c-format
msgid "A single picture will be used as the background for the selected desktops."
msgstr ""
"មាន​រូបភាព​តែ​មួយ​ប្រើដើម្បី​ដាក់​ជា​ផ្ទៃខាងក្រោយ "
"សម្រាប់​ផ្ទៃតុ​ដែល​បានជ្រើស​។​"

#. Tag: para
#: index.docbook:97
#, no-c-format
#, fuzzy
msgid "How this picture is positioned and scaled can be fine tuned below."
msgstr "How this picture is positioned and scaled can be fine tuned below."

#. Tag: guilabel
#: index.docbook:103
#, no-c-format
msgid "Slide show"
msgstr "បង្ហាញ​ស្លាយ​"

#. Tag: para
#: index.docbook:105
#, no-c-format
msgid ""
"&kde; allows you to have an automatic slide show of wallpaper images. To enable "
"this option, press the <guibutton>Setup...</guibutton> "
"button. In the resulting dialog you may choose any image or folder of images "
"available on your computer, using the <guibutton>Add...</guibutton> "
"button to navigate your file system. <guibutton>Remove</guibutton> "
"will remove the currently selected entry from the list."
msgstr ""
"kde អនុញ្ញាត​ឲ្យ​អ្នក​បង្ហាញ​ស្លាយ​នៃ​រូបភាព​ក្រដាស​បិតផ្ទៃតុ​ដោយស្វ័យប្រវត្តិ​ ។ ដើម្បី​បើក​ជ្រើស​នេះ​ "
"ចុចប៊ូតុង​​ <guibutton>រៀបចំ​បចំ​...</guibutton> "
" នៅ​ក្នុង​ប្រអប់​លទ្ធផល​អ្នក​ប្រហែល​ជា​បាន "
"ជ្រើសរូបភាព​ ឬ​ថត​រូបភាពដែល​អាច​រក​បាន​នៅ​លើ​កុំព្យូទ័រ​របស់​អ្នក ប្រើ​tប៊ូតុង​he <guibuttបន្ថែម​Add...</guibuttoដើម្បី​រុករក​ប្រព័ន្ធ​ឯកសារ​របស់​អ្នក​ ។ em. <guibuttយកចេញ​ove</guibuttonនឹង ត្រូវ​បាន​យកធាតុ​ដែល​ជ្រើស​បច្ចុប្បន្ន​ចេញ​ពី​បញ្ជី​ ។​st."

#. Tag: para
#: index.docbook:113
#, no-c-format
msgid ""
"You may choose the length of time any image is displayed in the <guilabel>"
"Change picture after:</guilabel> box, and you may choose <guibutton>"
"Show pictures in random order</guibutton> if you don't want them displayed in "
"the order they are listed."
msgstr ""
"អ្នក​អាច​ជ្រើសរើស​រយៈពេល​សម្រាប់​រូបភាព​ដែល​ត្រូវ​បាន​បង្ហាញ​ក្នុង​ <guilabel> ការផ្លាស់ប្តូរ​រូបភាព​ពេលក្រោយ​ ៖ </guilabel> ប្រអប់នេះ​អ្នកអាច​ជ្រើស​ <guibutton> រូបភាព​បង្ហាញដោយចៃដន្យ​"
"</guibutton> បើ​អ្នក​មិន​ចង់​ឲ្យ​ពួក​វា​បង្ហាញ "
"តាមលំដាប់លំដោយ​ទេ ពួក​វា​ត្រូវ​បាន​រាយ​ជា​បញ្ជី​ ។​"

#. Tag: para
#: index.docbook:118
#, no-c-format
msgid ""
"Displaying wallpaper requires that the image be kept in memory. If you are low "
"on memory, using a small, tiled image or none at all is recommended."
msgstr ""
"ការបង្ហាញ​ក្រដាស​បិត​ផ្ទៃតុ​ទាមទារ​ឲ្យ​រូបភាព​ត្រូវ​"
"រក្សាទុក​ក្នុង​សតិ​ ។ តាមការផ្តល់អនុសាសន៍​​​ថា​ "
"បើ​អ្នក​មាន​សតិ​តិច​ ប្រើរូបភាព​"
"ក្បឿង​តូចៗ​ ឬ​មិន​ដាក់រូបភាព​អ្វីទាំងអស់​"

#. Tag: para
#: index.docbook:122
#, no-c-format
msgid ""
"Scaling or centering a small image still requires an image the size of your "
"display to be maintained in memory."
msgstr "ការធ្វើ​មាត្រដ្ឋាន និង​ធ្វើ​ឲ្យ​រូបភាព​តូចៗ​ដាក់​​​ចំកណ្តាល​នៅ​តែទាមទារ​ឲ្យ​ទំហំ​រូបភាព​នៃ​ការបង្ហាញ​របស់​ត្រស្ថិត​ក្នុង​សតិ​ ។​​"

#. Tag: guilabel
#: index.docbook:131
#, no-c-format
msgid "Options"
msgstr "ជម្រើស​"

#. Tag: guilabel
#: index.docbook:135
#, no-c-format
msgid "Position:"
msgstr "ទីតាំង​ ៖"

#. Tag: term
#: index.docbook:137
#, no-c-format
msgid "Centered"
msgstr "កណ្តាល​"

#. Tag: para
#: index.docbook:138
#, no-c-format
msgid ""
"The image will be centered on the screen without changing the size of the "
"image. The background colors will be present anywhere the image does not cover."
msgstr ""
"រូបភាពបានដាក់​ឲ្យ​ចំកណ្តាល​លើ​អេក្រង់​ដោយ​គ្មាន "
"ការផ្លាស់ប្តូរ​ទំហំ​នៃ​រូបភាព ។"
"ពណ៌​ផ្ទៃខាងក្រោយ​ និង​បង្ហាញគ្រប់ទីកន្លែងដែល​មាន​រូបភាព​ស្ថិតនៅ​ ។​"

#. Tag: term
#: index.docbook:143
#, no-c-format
msgid "Tiled"
msgstr "ក្បឿង"

#. Tag: para
#: index.docbook:144
#, no-c-format
msgid ""
"The image will be duplicated until it fills the entire desktop. The first image "
"will be placed in the upper left corner of the screen, and duplicated downward "
"and to the right."
msgstr ""
"រូបភាព​ និង​បង្ហាញ​ស្ទួន​រហូត​ពេញ​ផ្ទៃ​ទាំងស្រុង​ ។ "
"រូបភាព​ដំបូង​ត្រូវ​បាន​ដាក់​នៅខាងលើ​ជ្រុង​ខាងឆ្វេង​នៃ​អេក្រង់​ ហើយ​បន្តស្ទួន​ទៅ​ក្រោម​ទៅ​ផ្នែក​ខាងស្តាំ​វិញម្តង​ ។​"

#. Tag: term
#: index.docbook:149
#, no-c-format
msgid "Center Tiled"
msgstr "ក្បឿង​កណ្តាល​"

#. Tag: para
#: index.docbook:150
#, no-c-format
msgid ""
"The image will be duplicated until it fills the entire desktop. The first image "
"will be placed in the center of the screen, and duplicated upward, downward to "
"the right, and to the left."
msgstr ""
"រូបភាព​ និង​បង្ហាញ​ស្ទួន​រហូត​ពេញ​ផ្ទៃ​ទាំងស្រុង​ ។  "
"រូបភាព​ដំបូង​ត្រូវ​បាន​ដាក់​ឲ្យ​ចំកណ្តាល​នៃ​អេក្រង់​ "
"ហើយ​បន្តស្ទួន​ទៅ​ខាងលើ​ ខាក្រោម​ទៅ​ឆ្វេង​ និង​ទៅ​ស្តាំ​ ។​"

#. Tag: term
#: index.docbook:155
#, no-c-format
#, fuzzy
msgid "Centered Maxpect"
msgstr "កណ្ដាល Maxpect"

#. Tag: para
#: index.docbook:156
#, no-c-format
#, fuzzy
msgid ""
"The image will be placed in the center of the screen. It will be scaled to fit "
"the desktop, but it will not change the aspect ratio of the original image. "
"This will provide you with an image that is not distorted."
msgstr "អ៊ិន្ឈ៍ ដល់ សមាមាត្រ ដើម ជា."

#. Tag: term
#: index.docbook:162
#, no-c-format
#, fuzzy
msgid "Tiled Maxpect"
msgstr "ក្បឿង Maxpect "

#. Tag: para
#: index.docbook:164
#, no-c-format
#, fuzzy
msgid ""
"The image will be placed in the corner of the screen. It will be scaled to fit "
"the desktop, but it will not change the aspect ratio of the original image. "
"This will provide you with an image that is not distorted. If there is any "
"space over, the image will be duplicated to fill it."
msgstr "អ៊ិន្ឈ៍ ដល់ សមាមាត្រ ដើម ជា ជា ដល់."

#. Tag: term
#: index.docbook:172
#, no-c-format
#, fuzzy
msgid "Scaled"
msgstr "មាត្រដ្ឋាន"

#. Tag: para
#: index.docbook:173
#, no-c-format
#, fuzzy
msgid ""
"The image will be scaled to fit the desktop. It will be stretched to fit to all "
