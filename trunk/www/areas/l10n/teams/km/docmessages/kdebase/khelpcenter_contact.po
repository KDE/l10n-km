#. Tag: chapterinfo
#: contact.docbook:2
#, no-c-format
msgid "<date>2002-10-29</date> <releaseinfo>3.5.5</releaseinfo>"
msgstr "<date>២៩-២០-២០០២</date> <releaseinfo>៣.៥.៥</releaseinfo>​"

#. Tag: title
#: contact.docbook:6
#, no-c-format
msgid "Contact the &kde; team"
msgstr "ទាក់ទង​​ក្រុម &kde;"

#. Tag: title
#: contact.docbook:10
#, no-c-format
msgid "Mailing lists"
msgstr "បញ្ជី​សំបុត្រ​រួម"

#. Tag: para
#: contact.docbook:12
#, no-c-format
msgid ""
"&kde; has several mailing lists up. See below for some of the most useful. "
"Older articles can be found in the <ulink url=\"http://lists.kde.org\">"
"mailing list archive</ulink>."
msgstr ""
"&kde; មាន​បញ្ជី​សំបុត្រ​រួម​ជាច្រើន ។ សូម​មើល​បញ្ជី​សំបុត្ររួម​ដែលមាន​ប្រយោជន៍​បំផុត​មួយ​ចំនួន​នៅខាងក្រោម ។ "
"អត្ថបទ​ចាស់ៗ​អាច​រកបាន​នៅក្នុង <ulink url=\"http://lists.kde.org\">"
"បណ្ណសារ​បញ្ជី​សំបុត្រ​រួម</ulink> ។"

#. Tag: ulink
#: contact.docbook:19
#, no-c-format
msgid "<ulink>kde</ulink>"
msgstr "<ulink>kde</ulink>"

#. Tag: para
#: contact.docbook:20
#, no-c-format
msgid "For general discussion, users helping each other."
msgstr "សម្រាប់​ការពិភាក្សា​ទូទៅ គឺ​អ្នក​ប្រើ​ជួយ​គ្នា​ទៅវិញ​ទៅមក ។"

#. Tag: ulink
#: contact.docbook:24
#, no-c-format
msgid "kde-announce"
msgstr "ការ​ប្រកាស​របស់ kde"

#. Tag: para
#: contact.docbook:25
#, no-c-format
msgid "Announcements of new &kde; applications"
msgstr "ការប្រកាស​អំពី​កម្មវិធី​ថ្មីៗ​របស់ &kde;"

#. Tag: ulink
#: contact.docbook:29
#, no-c-format
msgid "kde-devel"
msgstr "ការអភិវឌ្ឍន៍ kde"

#. Tag: para
#: contact.docbook:30
#, no-c-format
msgid "For developers."
msgstr "សម្រាប់​អ្នក​អភិវឌ្ឍន៍ ។"

#. Tag: ulink
#: contact.docbook:34
#, no-c-format
msgid "kde-artists"
msgstr "សិល្បៈ kde"

#. Tag: para
#: contact.docbook:35
#, no-c-format
msgid "Creating icons and other artwork"
msgstr "ការ​បង្កើត​រូបតំណាង និង​សិល្បៈ​កម្ម​ផ្សេងទៀត"

#. Tag: ulink
#: contact.docbook:39
#, no-c-format
msgid "kde-doc-english"
msgstr "ឯកសារ​ជាភាសា​អង់គ្លេស​សម្រាប់ kde"

#. Tag: para
#: contact.docbook:40
#, no-c-format
msgid "For people interested in writing documentation for &kde;."
msgstr "សម្រាប់​មនុស្ស​ដែល​ចាប់​អារម្មណ៍​ក្នុងការ​សរសេរ​ឯកសារ​សម្រាប់ &kde; ។"

#. Tag: ulink
#: contact.docbook:44
#, no-c-format
msgid "kde-i18n-doc"
msgstr "ឯកសារ​អន្តរជា​តូបនីយកម្ម​សម្រាប់ kde"

#. Tag: para
#: contact.docbook:45
#, no-c-format
msgid "Internationalization and documentation issues"
msgstr "ការធ្វើ​អន្តរជា​តូបនីយកម្ម និង​ការចេញផ្សាយ​ឯកសារ"

#. Tag: ulink
#: contact.docbook:49
#, no-c-format
msgid "http://l10n.kde.org/teams/"
msgstr "http://l10n.kde.org/teams/"

#. Tag: para
#: contact.docbook:50
#, no-c-format
msgid ""
"For localized information, which may include user email lists and websites, "
"check the translation teams page at the above &URL;."
msgstr "សម្រាប់​ព័ត៌មាន​ដែលបាន​ធ្វើ​ជាតូបនីយកម្ម ដែលរួម​មាន​បញ្ជី​អ៊ីមែល និង​តំបន់​បណ្ដាញ​របស់​អ្នក​ប្រើ និង​ពិនិត្យ​មើល​ទំព័រ​ក្រុម​បកប្រែ​នៅ​ &URL; ខាងលើ ។"

#. Tag: title
#: contact.docbook:60
#, no-c-format
msgid "Contacting the &kde; developers"
msgstr "ទំនាក់ទំនង​អ្នក​អភិវឌ្ឍន៍ &kde;"

#. Tag: para
#: contact.docbook:62
#, no-c-format
msgid "On this page, you can find links to &kde; related web sites."
msgstr "នៅលើទំព័រ​នេះ អ្នក​អាច​រក​តំណ​ទៅកាន់​តំបន់​បណ្ដាញ​ដែលទាក់​ទង​នឹង &kde; ។"

#. Tag: para
#: contact.docbook:64
#, no-c-format
msgid ""
"The K Desktop Environment is developed by a large group of people around the "
"world. Our main communication channel is the Internet. For general questions, "
"you will be best served by asking on the mailing lists mentioned in the <link "
"linkend=\"contact-mailinglists\">previous section</link>"
", and contact addresses for individual developers can be found in the "
"documentation of their individual application."
msgstr ""
"បរិស្ថាន​ផ្ទៃតុ K ត្រូវបាន​ផ្ដល់​ដោយ​ក្រុម​មនុស្ស​ជុំវិញ​ពិភពលោកមួយ​ក្រុម​ធំ ។ ប៉ុស្តិ៍​ទំនាក់ទំនង​ចម្បង​របស់ពួក​យើង​គឺ​អ៊ីន​ធឺណិត ។ ចំពោះ​សំណួរ​ទូទៅ អ្នក​នឹង​ត្រូវបាន​បម្រើ​យ៉ាង​ពេញ​ចេញ ដោយ​ធ្វើការ​សួរ​នៅលើ​បញ្ជី​សំបុត្រ​រួម​ដែលបាន​​បញ្ជាក់​នៅក្នុង <link "
"linkend=\"contact-mailinglists\">ផ្នែក​មុន</link>"
" ហើយ​អាសយដ្ឋាន​ទំនាក់ទំនង​​អ្នក​អភិវឌ្ឍន៍​នីមួយ​ៗ​ គឺ​អាច​រកបាន​នៅ​ក្នុងឯកសារ​កម្មវិធី​ផ្ទាល់​ខ្លួន​របស់​ពួក​គេ​ដែរ ។"

#. Tag: para
#: contact.docbook:71
#, no-c-format
msgid ""
"Please visit our <ulink url=\"http://www.kde.org/contact/representatives.php\">"
"Official Representatives</ulink> page for official enquiries regarding &kde; "
"(&eg; interviews)."
msgstr ""
"សូម​ចូល​ទស្សនាទំព័រ <ulink url=\"http://www.kde.org/contact/representatives.php\">"
"អ្នក​តំណាង​ជាផ្លូវការ</ulink> របស់យើង ដើម្បី​មើល​ការសាកសួរ​ជាផ្លូវការ​របស់ &kde; "
"(ឧ. បទ​សម្ភាសន៍) ។"

#. Tag: para
#: contact.docbook:76
#, no-c-format
msgid "More information about &kde; is available at &kde-http;."
msgstr "ព័ត៌មាន​បន្ថែម​អំពី &kde; គឺ​មាន​នៅ &kde-http; ។"

#. Tag: para
#: contact.docbook:78
#, no-c-format
msgid "Other &kde; websites include:"
msgstr "តំបន់​បណ្ដាញ​ផ្សេងទៀត​របស់ &kde; រួម​មាន ៖"

#. Tag: ulink
#: contact.docbook:82
#, no-c-format
msgid "www.kde.org"
msgstr "www.kde.org"

#. Tag: para
#: contact.docbook:83
#, no-c-format
msgid "&kde;'s official website"
msgstr "តំបន់​បណ្ដាញ​ជាផ្លូវការ​របស់ &kde;"

#. Tag: ulink
#: contact.docbook:87
#, no-c-format
msgid "developer.kde.org"
msgstr "developer.kde.org"

#. Tag: para
#: contact.docbook:88
#, no-c-format
msgid "The &kde; developers center"
msgstr "មជ្ឈមណ្ឌល​អ្នក​អភិវឌ្ឍន៍ &kde;"

#. Tag: ulink
#: contact.docbook:92
#, no-c-format
msgid "websvn.kde.org"
msgstr "websvn.kde.org"

#. Tag: para
#: contact.docbook:93
#, no-c-format
msgid "A web interface to the &kde; Subversion repository"
msgstr "ចំណុច​ប្រទាក់​បណ្ដាញ​ទៅកាន់​ឃ្លាំង​កំណែ​រង​របស់ &kde;"

#. Tag: ulink
#: contact.docbook:97
#, no-c-format
msgid "l10n.kde.org"
msgstr "l10n.kde.org"

#. Tag: para
#: contact.docbook:98
#, no-c-format
msgid "&kde;'s internationalization and documentation server"
msgstr "ម៉ាស៊ីន​បម្រើ​ការធ្វើ​អន្តរជាតូបនីយ​កម្ម និង​ឯកសារ​របស់ &kde;"

#. Tag: ulink
#: contact.docbook:102
#, no-c-format
msgid "ftp.kde.org"
msgstr "ftp.kde.org"

#. Tag: para
#: contact.docbook:103
#, no-c-format
msgid ""
"The main &kde; &FTP; server. Please have a look at the link below to find a "
"mirror site in your geographic region."
msgstr "ម៉ាស៊ីន​បម្រើ &FTP; ចំបង​របស់ &kde; ។ សូម​មើល​តំណ​ខាងក្រោម​ដើម្បីរក​តំបន់​កញ្ចក់​នៅក្នុង​តំបន់​ភូមិសាស្ត្រ​របស់អ្នក ។"

#. Tag: ulink
#: contact.docbook:109
#, no-c-format
msgid "www.kde.org/mirrors"
msgstr "www.kde.org/mirrors"

#. Tag: para
#: contact.docbook:110
#, no-c-format
msgid "&kde; web and &FTP; mirror sites"
msgstr "បណ្ដាញ និង​តំបន់​កញ្ចក់ &FTP; របស់ &kde;"

#. Tag: ulink
#: contact.docbook:114
#, no-c-format
msgid "www.kde-apps.org"
msgstr "www.kde-apps.org"

#. Tag: para
#: contact.docbook:115
#, no-c-format
msgid "A directory of &kde; applications."
msgstr "ថត​កម្មវិធី​របស់ &kde; ។"

#. Tag: ulink
#: contact.docbook:119
#, no-c-format
msgid "www.kde-look.org"
msgstr "www.kde-look.org"

#. Tag: para
#: contact.docbook:120
#, no-c-format
msgid "&kde; themes, icons, and other items to change the look of your desktop."
msgstr "ស្បែក រូប​តំណាង និង​ធាតុ​ផ្សេងទៀត​របស់ &kde; ដើម្បី​ផ្លាស់ប្ដូរ​រូបរាង​ផ្ទៃតុ​របស់អ្នក ។"

