#. Tag: title
#: faq.docbook:12
#, no-c-format
msgid "Questions and Answers"
msgstr "សំណួរ និង​ចម្លើយ"

#. Tag: para
#: faq.docbook:26
#, no-c-format
msgid "Can I run &konqueror; from another window manager?"
msgstr "តើ​ខ្ញុំអាច​រត់ &konqueror; ពី​កម្មវិធី​គ្រប់គ្រង​បង្អួច​ផ្សេង​បានទេ ?"

#. Tag: para
#: faq.docbook:29
#, no-c-format
msgid ""
"Just install &Qt;, kdelibs and kdebase, and from your favorite window manager, "
"launch &konqueror;. It should work just fine, but if it doesn't (&kde; "
"developers don't test that case often), report it to <ulink "
"url=\"http://bugs.kde.org\">http://bugs.kde.org</ulink> "
"and try running <application>kdeinit</application> before running &konqueror;; "
"it usually helps."
msgstr ""

#. Tag: para
#: faq.docbook:38
#, no-c-format
msgid "Where does &konqueror; keep all its configuration data?"
msgstr "តើ​ &konqueror; ទុក​ទិន្នន័យ​កំណត់​រចនា​សម្ព័ន្ធ​របស់​វា​ទាំង​អស់​នៅ​ឯណា ?"

#. Tag: para
#: faq.docbook:40
#, no-c-format
msgid ""
"Generally in the <filename>~/.kde</filename> folder (this may be <filename>"
"~/.kde3</filename> on your system, depending on how &kde; 3 was installed). "
"Don't alter these files unless you really know what you are doing."
msgstr ""
"ជាទូទៅ​ក្នុង​ថត <filename>~/.kde</filename> (ប្រហែល​ជា <filename>"
"~/.kde3</filename> នៅលើ​ប្រព័ន្ធ​របស់អ្នក ដោយ​ពឹង​ផ្អែក​លើ​របៀប​ដែល &kde; 3 ត្រូវបាន​ដំឡើង) ។ "
"កុំកែប្រែ​ឯកសារ​ទាំងនេះ​ លុះត្រា​តែ​អ្នក​ដឹង​ថា​អ្នក​ធ្វើអ្វី​ពិត​ប្រាកដ​ ។"

#. Tag: para
#: faq.docbook:47
#, no-c-format
msgid ""
"The <filename "
"class=\"directory\">~/.kde/share/apps/konqueror/profiles</filename> "
"folder holds individual files containing settings for each of your <link "
"linkend=\"save-settings\">profiles. </link>"
msgstr ""
"ថត <filename "
"class=\"directory\">~/.kde/share/apps/konqueror/profiles</filename> "
"ដាក់​នូវ​ឯកសារ​នីមួយ​ៗ​ដែលមាន​ការកំណត់​សម្រាប់​ <link "
"linkend=\"save-settings\">ទម្រង់ </link> នីមួយ​ៗ​របស់អ្នក ។"

#. Tag: para
#: faq.docbook:52
#, no-c-format
msgid ""
"Your bookmarks are held in <filename class=\"directory\">"
"~/.kde/share/apps/konqueror/bookmarks.xml</filename>"
msgstr ""
"ចំណាំ​របស់​អ្នក​ត្រូវបាន​ដាក់​នៅក្នុង <filename class=\"directory\">"
"~/.kde/share/apps/konqueror/bookmarks.xml</filename>"

#. Tag: para
#: faq.docbook:54
#, no-c-format
msgid ""
"Cookies are held in <filename "
"class=\"directory\">~/.kde/share/apps/kcookiejar/cookies</filename>"
msgstr ""
"ខូគី​ត្រូវបាន​ដាក់​នៅក្នុង <filename "
"class=\"directory\">~/.kde/share/apps/kcookiejar/cookies</filename>"

#. Tag: para
#: faq.docbook:56
#, no-c-format
msgid ""
"Your history, as used for the auto-completion feature, is in <filename>"
"~/.kde/share/config/konq_history</filename>"
msgstr ""

#. Tag: para
#: faq.docbook:59
#, no-c-format
msgid ""
"In the folder <filename class=\"directory\">~/.kde/share/config/</filename> "
"the files <filename>konqiconviewrc</filename>, <filename>"
"konqlistviewrc</filename> and <filename>konquerorrc</filename> "
"hold a whole lot of general configuration settings."
msgstr ""
"នៅ​ក្នុង​ថត <filename class=\"directory\">~/.kde/share/config/</filename> "
"ឯកសារ <filename>konqiconviewrc</filename> <filename>"
"konqlistviewrc</filename> និង <filename>konquerorrc</filename> ទុក​នូវ​ការកំណត់​រចនា​សម្ព័ន្ធ​ទូទៅ​ជាច្រើ​ន ។"

#. Tag: para
#: faq.docbook:65
#, no-c-format
msgid ""
"The folder <filename class=\"directory\">~/.kde/share/cache/http/</filename> "
"contains the browser cache."
msgstr ""
"ថត <filename class=\"directory\">~/.kde/share/cache/http/</filename> "
"មាន​ឃ្លាំង​កម្មវិធី​រុករក ។"

#. Tag: para
#: faq.docbook:69
#, no-c-format
msgid ""
"The Navigation Panel uses the files and subfolders in <filename "
"class=\"directory\">~/.kde/share/apps/konqsidebartng</filename>"
msgstr ""
"បន្ទះ​រុករក​ប្រើ​ឯកសារ និង​ថតរក​នៅក្នុង <filename "
"class=\"directory\">~/.kde/share/apps/konqsidebartng</filename>"

#. Tag: para
#: faq.docbook:74
#, no-c-format
msgid ""
"Any folder specific view settings are put into <literal role=\"extension\">"
".directory</literal> files in the individual folders."
msgstr ""

#. Tag: para
#: faq.docbook:80
#, no-c-format
msgid "How do I clear out the history file?"
msgstr "តើ​ខ្ញុំត្រូវ​ជម្រះ​ឯកសារ​ប្រវត្តិ​យ៉ាង​ដូចម្តេច​?"

#. Tag: para
#: faq.docbook:81
#, no-c-format
msgid "There are two <quote>histories</quote>:"
msgstr "មាន​ <quote>ប្រវត្តិ​ពីរ</quote> ៖"

#. Tag: para
#: faq.docbook:83
#, no-c-format
msgid ""
"One is used for text completion in the Location Toolbar text entry box. To "
"clear this <mousebutton>right</mousebutton> click on the text entry box and "
"select <guimenuitem>Clear History </guimenuitem>."
msgstr ""
"មួយ​ត្រូវ​បាន​ប្រើ​សម្រាប់​​បំពេញ​អត្ថបទ​ក្នុង​ប្រអប់​ធាតុ​អត្ថបទ​របារឧបករណ៍​ទីតាំង ។​ ដើម្បី​ជម្រះ​វា​"
" <mousebutton>ចុច​កណ្តុរ​ស្តាំ</mousebutton> លើ​"
"ប្រអប់​ធាតុ​អត្ថបទ​ ហើយ​ជ្រើស​"
" <guimenuitem>ជម្រះ​ប្រវត្តិ </guimenuitem>​។"

#. Tag: para
#: faq.docbook:88
#, no-c-format
msgid ""
"The other is the log of visited locations. Select the History page in the "
"Navigation Panel, <mousebutton>right</mousebutton> click on an entry and choose "
"<guimenuitem>Remove Entry</guimenuitem> to remove just that entry or "
"<guimenuitem>Clear History</guimenuitem> to delete all entries."
msgstr ""
"ប្រវត្តិ​ជា​កំណត់ហេតុ​នៃ​ទីតាំង​ដែល​បានចូល​ទស្សនា ។ ជ្រើស​ទំព័រ​ប្រវត្តិ​ក្នុង​បន្ទះ​កម្មវិធី​រុករក​ <mousebutton>ចុច​កណ្តុរ​ស្តាំ​</mousebutton> "
"លើ​ធាតុ​ ហើយ​ជ្រើស​"
"<guimenuitem>យកធាតុ​ចេញ​ </guimenuitem> "
"ដើម្បី​យក​ធាតុចេញ  ឬ​"
"<guimenuitem>ជម្រះ​ប្រវត្តិ​</guimenuitem> ដើម្បី​លុបធាតុ​ទាំងអស់​ ។​"

#. Tag: para
#: faq.docbook:101
#, no-c-format
msgid "How do I enable, disable or clear the browser cache?"
msgstr ""
"តើ​ខ្ញុំ​ត្រូវ បិទបើក ឬ​ជម្រះ​ឃ្លាំងសម្ងាត់​កម្មវិធី​រុករក "
"​យ៉ាង​ដូចម្តេច​?"

#. Tag: para
#: faq.docbook:103
#, no-c-format
msgid ""
"If you select <guimenuitem>Cache</guimenuitem> in the dialog launched by "
"selecting <menuchoice><guimenu>Settings</guimenu><guimenuitem>"
"Configure Konqueror... </guimenuitem></menuchoice>, you will be presented with "
"a dialog box that lets you disable the cache, clear it or set its size, and "
"change the caching policy."
msgstr ""
"If you select <guimenuitem>Cache</guimenuitem> in the dialog launched by "
"selecting <menuchoice><guimenu>Settings</guimenu><guimenuitem>"
"Configure Konqueror... </guimenuitem></menuchoice>, you will be presented with "
"a dialog box that lets you disable the cache, clear it or set its size, and "
"change the caching policy."

#. Tag: para
#: faq.docbook:113
#, no-c-format
#, fuzzy
msgid "How can I change the timeout values used by &konqueror; when web browsing?"
msgstr "I អស់ពេល&konqueror;?"

#. Tag: para
#: faq.docbook:115
#, no-c-format
#, fuzzy
msgid ""
"In the Control Center <menuchoice><guimenu>Internet &amp; Network</guimenu> "
"<guimenuitem>Preferences</guimenuitem></menuchoice> page."
msgstr "ក្នុង វត្ថុ​បញ្ជា កណ្ដាល<menuchoice><guimenu> អ៊ីនធឺណិត&amp; បណ្តាញ</guimenu><guimenuitem> ចំណង់​ចំណូល​ចិត្ត</guimenuitem></menuchoice>."

#. Tag: para
#: faq.docbook:121
#, no-c-format
#, fuzzy
msgid "How do I set my <quote>home</quote> page - the page loaded on startup?"
msgstr "I<quote></quote> បានផ្ទុក​?"

#. Tag: para
#: faq.docbook:123
#, no-c-format
#, fuzzy
msgid ""
"Start &konqueror; with the <guiicon>Web Browser</guiicon> "
"icon on the panel. Open the page you want to be loaded in any new <quote>"
"Web Browser</quote> window and select <guimenuitem>Save View Profile \"Web "
"Browsing\"</guimenuitem> from the <guimenu>Settings</guimenu> menu."
msgstr "ចាប់ផ្ដើម&konqueror;<guiicon> វិប កម្មវិធី​រុករក</guiicon> បើក ដល់ បានផ្ទុក​ អ៊ិន្ឈ៍<quote> វិប កម្មវិធី​រុករក</quote> និង<guimenuitem> រក្សាទុក មើល វិប កំពុងរុករក</guimenuitem><guimenu> ការ​កំណត់</guimenu>."

#. Tag: para
#: faq.docbook:128
#, no-c-format
#, fuzzy
msgid ""
"All new &konqueror; windows that are started with the <guiicon>"
"Web Browser</guiicon> icon on the panel, or from the <guimenu>location</guimenu> "
"menu, and new empty tabs, will now start at this page."
msgstr "ទាំង​អស់&konqueror;<guiicon> វិប កម្មវិធី​រុករក</guiicon> ឬ<guimenu></guimenu> និង ទទេ ឥឡូវ នៅ."

#. Tag: para
#: faq.docbook:132
#, no-c-format
#, fuzzy
msgid ""
"This does not change the behavior of the <guiicon>Home</guiicon> "
"button on the &konqueror; toolbar, which will continue to take you to the &URI; "
"defined in the &konqueror; configuration module. You can reach that module from "
"within &konqueror;, via <menuchoice><guimenu>Settings</guimenu><guimenuitem>"
"Configure Konqueror</guimenuitem><guilabel>Behavior</guilabel></menuchoice>"
". By default this is set to <userinput>~</userinput>"
", which is your Home folder. You may set this to any &URI;, either local or "
"remote, and pressing the <guiicon>Home</guiicon> icon on the toolbar will "
"display it."
msgstr "<guiicon> ផ្ទះ</guiicon>&konqueror; ដល់ ដល់&URI; អ៊ិន្ឈ៍&konqueror; អ្នក&konqueror;<menuchoice><guimenu> ការ​កំណត់</guimenu><guimenuitem> កំណត់​រចនាសម្ព័ន្ធ Konqueror</guimenuitem><guilabel> ឥរិយាបថ</guilabel></menuchoice> លំនាំដើម ជា ដល់<userinput></userinput> ជា ផ្ទះ អ្នក ដល់&URI; ឬ និង<guiicon> ផ្ទះ</guiicon>."

#. Tag: para
#: faq.docbook:142
#, no-c-format
#, fuzzy
msgid ""
"To have &konqueror; start up with no page loaded, use <userinput>"
"about:blank</userinput>."
msgstr "ទៅ&konqueror; ទេ បានផ្ទុក​<userinput></userinput>."

