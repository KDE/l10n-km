#. Tag: guimenuitem
#: index.docbook:1759
#, no-c-format
#, fuzzy
msgid "Text Label"
msgstr "ស្លាក​អត្ថបទ"

#. Tag: para
#: index.docbook:1761
#, no-c-format
#, fuzzy
