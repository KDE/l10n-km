msgstr "ឬ<link linkend=\"panel-menus\"> ការកំណត់​រចនាសម្ព័ន្ធ</link> សម្រាប់."

#. Tag: title
#: index.docbook:1637
#, no-c-format
#, fuzzy
msgid "Applets"
msgstr "អាប់​ភ្លេត"

#. Tag: para
#: index.docbook:1639
#, no-c-format
#, fuzzy
msgid ""
"Applets are small applications running inside of &kicker;. Almost everything "
