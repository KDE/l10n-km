#. Tag: chapterinfo
#: path-complete.docbook:7
#, no-c-format
msgid "<date>2003-11-05</date> <releaseinfo>3.2</releaseinfo>"
msgstr "<date>២០០៣-១១-០៥</date> <releaseinfo>៣.២</releaseinfo>"

#. Tag: title
#: path-complete.docbook:14
#, no-c-format
msgid "Automatic Text Completion"
msgstr "ការបំពេញ​អត្ថបទ​ដោយ​ស្វ័យប្រវត្តិ​"

#. Tag: para
#: path-complete.docbook:16
#, no-c-format
msgid ""
"You can get &konqueror; to help you enter a path or &URL; into the Location "
"Toolbar by enabling one of the <guimenuitem>Text Completion</guimenuitem> "
"features. To do this <mousebutton>right</mousebutton> "
"click on a clear part of the Location Toolbar text entry box and select "
"<guisubmenu>Text Completion</guisubmenu> from the pop up menu. This will let "
"you choose between the following options:"
msgstr ""
"អ្នកអាច​ទទួល​យក​ &konqueror; ដើម្បី​ជួយ​អ្នក​បញ្ចូល​ផ្លូវ​ ឬ​ &URL; ក្នុង​របារឧបករណ៍​ទីតាំង​"
"ដោយ​បើកលក្ខណៈពិសេស​នៃ​ <guimenuitem>ការបំពេញ​អត្ថបទ​</guimenuitem> ​។ ដើម្បី​ធ្វ​ដូច​នេះ​បាន​ <mousebutton>ចុច​កណ្តុរ​ស្តាំ​</mousebutton> ចុច​លើ​ប្រអប់​"
"ជម្រះ​ផ្នែក​របារឧបករណ៍​ទីតាំង​ធាតុ​អត្ថបទ​"
"ហើយ​ជ្រើស​"
"<guisubmenu>ការបំពេញ​អត្ថបទ​</guisubmenu> ពី​ម៉ឺនុយ​លេចឡើង​ ។ ការនេះ​ នឹង​អនុញ្ញាត​ឲ្យ​អ្នក​​ជ្រើស​រវាង​ជម្រើស​ដូច​ខាង​ក្រោម​នេះ  ៖"

#. Tag: guimenuitem
#: path-complete.docbook:26
#, no-c-format
msgid "None"
msgstr "គ្មាន​"

#. Tag: para
#: path-complete.docbook:27
#, no-c-format
msgid "What you get is what you type."
msgstr "អ្វី​ដែល​អ្នក​ទទួល​បាន តើ​ជា​ប្រភេ​ទ​អ្វី​"

#. Tag: guimenuitem
#: path-complete.docbook:31
#, no-c-format
msgid "Manual"
msgstr "សៀវភៅ​ដៃ"

#. Tag: para
#: path-complete.docbook:32
#, no-c-format
msgid ""
"When you have typed part of a path or &URL;, pressing <keycombo "
"action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo> "
"will complete the entry if it is possible to do so unambiguously."
msgstr ""
"ពេល​ដែល​អ្នក​បាន​វាយ​ផ្នែក​នៃ​ផ្លូវ​ ឬ​ &URL;, ចុច​ <keycombo "
"action=\"simul\">&បញ្ជា​;<keycap>E</keycap></keycombo> "
"វា​ និង​បំពេញ​ធាតុ​ បើ​វា​ធ្វើ​ការច្បាស់លាស់​ដែល​អាច​ធ្វើទៅ​បាន​ ។​"

#. Tag: guimenuitem
#: path-complete.docbook:38
#, no-c-format
msgid "Automatic"
msgstr "ស្វ័យប្រវត្តិ"

#. Tag: para
#: path-complete.docbook:39
#, no-c-format
msgid ""
"As you type into the Location Toolbar window &konqueror; will automatically "
"extend what you type to complete one possible path or &URL;, highlighting the "
"characters it has added. Continue typing if that's not what you wanted or press "
"&Enter; to accept it."
msgstr ""
"ដូចដែរ​អ្នក​វាយ​ក្នុង​របារឧបករណ៍​ទីតាំង​ បង្អួច​ &konqueror; "
"នឹង​ពង្រីក​ដោយស្វ័យប្រវត្តិ​នូវ​អ្វី​ដែល​អ្នកវាយ​បំពេញ​ក្នុង​ផ្លូវ​ ឬ​  &URL;, បន្លិច​តួអក្សរ​ដែល​វា​បានបន្ថែម​។ បន្ត​វាយ​ បើ​វា​មិន​មែន​ជា​អ្វី​ដែល​អ្នកចង់បាន​ ឬ​ចុច​"
"&បញ្ចូល​; ដើម្បី​យល់ព្រម​វា​ ។"

#. Tag: guimenuitem
#: path-complete.docbook:46
#, no-c-format
msgid "Dropdown List"
msgstr "បញ្ជី​ធ្លាក់ចុះ​"

#. Tag: para
#: path-complete.docbook:47
#, no-c-format
msgid ""
"A drop-down window will appear as you type, showing the possible matches to "
"what you have typed so far. When the path or &URL; that you want appears in the "
"window double click on it with the &LMB;. You can also use the <keysym>"
"Down Arrow</keysym> and <keysym>Up Arrow</keysym> keys to select it then press "
"&Enter;."
msgstr ""
"បង្អួច​ធ្លាក់ចុះ​ និង​លេចឡើង​ដូច​អ្នក​វាយ​ បង្ហាញផ្គួផ្គង​ដែល​អាច​ធ្វើទៅ​បាន​​ទៅ​កាន់​អ្វី​ដែល​អ្នកបាន​វាយ​ ។ ពេល​ផ្លូវ​ ឬ &URL; ដែល​អ្នក​ចង់​ឲ្យ​លេចឡើង​ក្នុង​បង្អួច​ចុច​ទ្វេរដង​លើ​វា​ ជាមួយ​ &LMB;​។ អ្នកអាច​ប្រើ​ <keysym>គ្រាប់ចុច​"
"ព្រួញចុះក្រោម​</keysym> និង​ <keysym>ព្រួញ​ឡើង​លើ​ </keysym> ដើម្បីជ្រើស​វា​បន្ទាប់​ពី​ចុ​ច"
"&បញ្ចូល​; ។​"

#. Tag: guimenuitem
#: path-complete.docbook:56
#, no-c-format
msgid "Short Automatic"
msgstr "ខ្លី​ស្វ័យប្រវត្តិ​"

#. Tag: para
#: path-complete.docbook:57
#, no-c-format
msgid ""
"This is like Automatic mode except that it only extends what you have typed as "
"far as the next <keycap>/</keycap> symbol in the path or &URL;. Press <keycombo "
"action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo> "
"to accept the suggestion, &Enter; when the complete path or &URL; is shown."
msgstr ""
"នេះ​ជា​របៀប​ស្វ័យប្រវត្តិ​លើកលែង​តែ​អ្វី​ដែល​អ្នក​បាន​វាយ​ជា​"
"អត្ថបទ​ <keycap>/</keycap> វាក្យស័ព្ទ​ក្នុង​ផ្លូវ ឬ​ &URL; ។​ ចុច​ <keycombo "
"action=\"simul\">&បញ្ជា​;<keycap>E</keycap></keycombo> "
"ដើម្បី​យល់ព្រម​យោបល​, &បញ្ចូល​; ពេល​បំពេញ​ផ្លូវ​ ឬ​ &URL; "
"ត្រូវ​បានបង្ហាញ​ ។​"

#. Tag: para
#: path-complete.docbook:65
#, no-c-format
msgid "You should try out these different modes and pick the one that suits you best."
msgstr "អ្នក​ត្រូវ​តែ​ព្យាយាម​ក្នុង​រៀប​ខុសៗគ្នា​ ហើយ​រើស​យក​មួយ​ដែលអ្នក​គិត​ថា​វា​ល្អ​បំផុត​ ។ "

#. Tag: para
#: path-complete.docbook:67
#, no-c-format
msgid ""
"The history of recently visited &URL;s that &konqueror; uses for the Text "
"Completion function can be viewed and edited in the <guilabel>"
"History </guilabel> page of the <link linkend=\"sidebar\">"
"Navigation Panel</link>."
msgstr ""
"ប្រវត្តិ​បច្ចុប្បន្ន​ត្រូវ​បាន​ចូល​ទស្សនា​ &URL; ដែល​ &konqueror; ប្រើ​ចំពោះ​មុខងារ​ការបំពេញ​អត្ថបទ​ត្រូវ​បាន​មើល​ និង​កែសម្រួល​ក្នុង​ទំព័រ​ <guilabel>ប្រវត្តិ </guilabel> នៃ​<link linkend=\"sidebar\"> "
"បន្ទះ​ការរុករក</link>​។​"

