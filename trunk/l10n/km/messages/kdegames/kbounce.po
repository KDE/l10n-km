#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "កែវ សុផុន, ខឹម សុខែម, លៀង ជុំសុបិន្ត, សាន ទិត្យវិរៈ, សិទ្ធ ចាន់រត្ថា, ហុក កក្កដា"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "keosophon@khmeros.info,khoemsokhem@khmeros.info,soben@khmeros.info,titvirak@khmeros.info,sethchanratha@khmeros.info,hokkakada@khmeros.infoinfo/"

#: highscores.cpp:9
msgid "Level"
msgstr "កម្រិត"

#: kbounce.cpp:63
msgid "Level:"
msgstr "កម្រិត ៖​"

#: kbounce.cpp:68
msgid "Score:"
msgstr "ពិន្ទុ ៖ "

#: kbounce.cpp:75
msgid "Filled area:"
msgstr "ផ្ទៃ​ដែល​បំពេញ ៖"

#: kbounce.cpp:80
msgid "Lives:"
msgstr "ចំណាំ ៖"

#: kbounce.cpp:85
msgid "Time:"
msgstr "ពេលវេលា ៖"

#: kbounce.cpp:102
msgid "Press %1 to start a game!"
msgstr "ចុច %1 ដើម្បី​ចាប់​ផ្ដើម​ល្បែង!"

#: kbounce.cpp:135
msgid "&Select Background Folder..."
msgstr "ជ្រើស​ថត​ផ្ទៃ​ខាង​ក្រោយ..."

#: kbounce.cpp:138
msgid "Show &Backgrounds"
msgstr "បង្ហាញ​ផ្ទៃ​ខាង​ក្រោយ"

#: kbounce.cpp:140
msgid "Hide &Backgrounds"
msgstr "លាក់​ផ្ទៃ​ខាង​ក្រោយ"

#: kbounce.cpp:144
msgid "&Play Sounds"
msgstr "លេង​សម្លេង"

#: kbounce.cpp:180
msgid "Do you really want to close the running game?"
msgstr "តើ​អ្នក​ពិត​ជា​ត្រូវ​ការ​បិទ​ការ​រត់​ល្បែង?"

#: kbounce.cpp:200
msgid "Game paused."
msgstr "ល្បែង​ដែល​ផ្អាក ។"

#: kbounce.cpp:231
#, c-format
msgid "Game Over! Score: %1"
msgstr "ល្បែង​ចប់! ពិន្ទុ ៖ %1"

#: kbounce.cpp:232
msgid "Game over. Press <Space> for a new game"
msgstr "ល្បែង​ចប់ ។ ចុច <Space> សម្រាប់​ល្បែង​ថ្មី"

#: kbounce.cpp:259
msgid "Select Background Image Folder"
msgstr "ជ្រើស​ថត​រូប​ភាព​ផ្ទៃ​ខាង​ក្រោយ"

#: kbounce.cpp:279
msgid "You may now turn on background images."
msgstr "ឥឡូវ​អ្នក​អាច​បើក​រូប​ភាព​ផ្ទៃ​ខាង​ក្រោយ​បាន ។"

#: kbounce.cpp:335
msgid "Game suspended"
msgstr "ល្បែង​ដែល​បាន​ផ្អាក"

#: kbounce.cpp:463
#, c-format
msgid "You have successfully cleared more than 75% of the board.\n"
msgstr ""

#: kbounce.cpp:464
msgid "%1 points: 15 points per remaining life\n"
msgstr "%1 គ្រាប់​ ៖ 15 គ្រាប់​ក្នុង​ជីវិត​ដែល​នៅ​សល់\n"

#: kbounce.cpp:465
msgid "%1 points: Bonus\n"
msgstr "%1 គ្រាប់ ៖ បន្ថែម\n"

#: kbounce.cpp:466
msgid "%1 points: Total score for this level\n"
msgstr "%1 គ្រាប់ ៖ ពិន្ទុ​សរុប​សម្រាប់​កម្រិត​នេះ\n"

#: kbounce.cpp:467
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr "នៅ​ក្នុង​កម្រិត %1 ។ អ្នក​ត្រូវ​តែចងចាំ %2 ចំណាំពេលនេះ!"

#: main.cpp:38
msgid "KDE Bounce Ball Game"
msgstr "ល្បែង​បាល់​របស់ Bounce ក្នុង KDE"

#: main.cpp:45
msgid "KBounce"
msgstr "KBounce"

#: main.cpp:49
msgid "Original author"
msgstr "អ្នក​និពន្ធ​ដើម"

#: main.cpp:51
msgid "Contributions"
msgstr "ការ​បរិច្ចាគ"

