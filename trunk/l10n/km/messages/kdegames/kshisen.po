#: main.cpp:47
msgid "A KDE game similiar to Mahjongg"
msgstr "ល្បែង KDE ដូចគ្នា​នឹង Mahjongg"

#: main.cpp:52
msgid ""
"_: Menu title\n"
"&Move"
msgstr "ផ្លាស់ទី"

#: main.cpp:56
msgid "Shisen-Sho"
msgstr "Shisen-Sho"

#: main.cpp:59
msgid "Current Maintainer"
msgstr "អ្នក​ថែរក្សា​បច្ចុប្បន្ន"

#: main.cpp:60
msgid "Original Author"
msgstr "អ្នក​និពន្ធ​ដើម"

#: main.cpp:61
msgid ""
"Added 'tiles removed' counter\n"
"Tile smooth-scaling and window resizing"
msgstr ""
"ឧបករណ៍​រាប់ 'ដុំ​បានយកចេញ' ដែល​បាន​បន្ថែម\n"
"ដុំ​រាបស្មើ-ការ​កំណត់​មាត្រដ្ឋាន និង​ការ​ផ្លាស់ប្ដូរ​ទំហំ​បង្អួច"

#: main.cpp:62
msgid "Thanks also to everyone who should be listed here but isn't!"
msgstr "សូម​អរគុណផងដែរ ​ដល់​អ្នក​ទាំង​អស់គ្នា​ដែល​​គួរ​ត្រូវ​បាន​រាយ​នៅ​ទីនេះ មែនទេ​​ !"

#: board.cpp:471
msgid "Game Paused"
msgstr "ល្បែងបានផ្អាក"

#: app.cpp:80 app.cpp:340
msgid " Cheat mode "
msgstr "របៀប​បញ្ឆោត"

#: app.cpp:123
msgid "&Finish"
msgstr "បញ្ចប់"

#: app.cpp:160
msgid "This game is solvable."
msgstr "ល្បែង​នេះ​អាច​​ដោះ​ស្រាយ​បាន"

#: app.cpp:162
msgid "This game is NOT solvable."
msgstr "ល្បែង​នេះ​មិន​អាច​ដោះ​ស្រាយ​បាន"

#: app.cpp:274
msgid "No more moves possible!"
msgstr "មិន​អាច​ផ្លាស់ទី​បាន​ទៀត​ទេ​ !"

#: app.cpp:274 app.cpp:306
msgid "End of Game"
msgstr "ល្បែង​ចប់"

#: app.cpp:301
msgid "Congratulations! You made it in %1:%2:%3"
msgstr "អបអរសាទរ ! អ្នក​បាន​ធ្វើ​វា​ក្នុងរយៈ​ពេល %1:%2:%3"

#: app.cpp:317
msgid " Your time: %1:%2:%3 %4"
msgstr "ពេល​វេលា​របស់​អ្នក ៖ %1:%2:%3 %4"

#: app.cpp:321
msgid "(Paused) "
msgstr "(បាន​ផ្អាក) "

#: app.cpp:327
msgid " Removed: %1/%2 "
msgstr "បាន​យកចេញ ៖ %1/%2 "

#: app.cpp:358
msgid ""
"You've made it into the \"Hall Of Fame\". Type in\n"
"your name so mankind will always remember\n"
"your cool rating."
msgstr ""
"អ្នក​បាន​ធ្វើ​វា​​ក្នុង​ \"បញ្ជី​កិត្តិនាម\"​។ វាយ​ក្នុង​\n"
"ឈ្មោះ​របស​់​អ្នក​ ដូច្នេះ​ឈ្មោះ​​របស់​អ្នក​នឹង​ចងចាំ​ជានិច្ច​\n"
"ក្នុងអត្រា​របស់​អ្នក​។"

#: app.cpp:361
msgid "Your name:"
msgstr "ឈ្មោះ​របស់​អ្នក ៖"

#: app.cpp:597 app.cpp:601
msgid "Hall of Fame"
msgstr "បញ្ជី​កិត្តិនាម"

#: app.cpp:622
msgid "Rank"
msgstr "ចំណាត់​ថ្នាក់"

#: app.cpp:626
msgid "Name"
msgstr "ឈ្មោះ"

#: app.cpp:630
msgid "Time"
msgstr "ពេលវេលា"

#: app.cpp:634
msgid "Size"
msgstr "ទំហំ"

#: app.cpp:638
msgid "Score"
msgstr "ពិន្ទុ"

#: app.cpp:689
msgid "(gravity)"
msgstr "(ស្រូបទាញ)"

#: app.cpp:754
msgid "General"
msgstr "ទូទៅ"

