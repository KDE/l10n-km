#, no-c-format
msgid "The layout of the tiles."
msgstr "ប្លង់​នៃ​ក្បឿង ។"

#. i18n: file kmahjongg.kcfg line 18
#: rc.cpp:57
#, no-c-format
msgid "Whether to show removed tiles."
msgstr "ទោះ​ជា​បង្ហាញ​ក្បឿង​ដែល​យក​ចេញ​ក៏​ដោយ ។"

#. i18n: file kmahjongg.kcfg line 22
#: rc.cpp:60
#, no-c-format
msgid "Whether to use miniature tiles."
msgstr "ទោះ​ជា​ប្រើ​ក្បឿង​តូច​ៗ​ក៏​ដោយ ។"

#. i18n: file kmahjongg.kcfg line 26
#: rc.cpp:63
#, no-c-format
msgid "Whether the tiles have shadows."
msgstr "ទោះ​ជា​ក្បឿង​មាន​ស្រមោល​ក៏​ដោយ ។"

#. i18n: file kmahjongg.kcfg line 30
#: rc.cpp:66
#, no-c-format
msgid "Whether all games should be solvable."
msgstr "ទោះ​ជា​ល្បែង​ទាំង​អស់​គួរ​តែ​ត្រូវ​ដោះ​ស្រាយ​ក៏​ដោយ ។"

#. i18n: file kmahjongg.kcfg line 34
#: rc.cpp:69
#, no-c-format
msgid "Whether the background should be tiled instead of scaled."
msgstr "ទោះ​ជា​ផ្ទៃ​ខាង​ក្រោយ​គួរ​តែ​ក្បឿង​ជំនួស​ដោយ​មាត្រដ្ឋាន​ក៏​ដោយ ។"

#. i18n: file kmahjongg.kcfg line 38
#: rc.cpp:72
#, no-c-format
msgid "Whether an animation should be played on victory."
msgstr "ទោះ​ជា​ជីវចល​គួរ​តែ​ត្រូវ​បាន​លែង​ឈ្នះ​ក៏​ដោយ ។"

#. i18n: file kmahjongg.kcfg line 42
#: rc.cpp:75
#, no-c-format
msgid "Whether matching tiles are shown."
msgstr "ទោះ​ជា​ដំណូច​ក្បឿង​ត្រូវ​បាន​បង្ហាញ​ក៏​ដោយ ។"
