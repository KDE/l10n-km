#: boardwidget.cpp:47
msgid ""
"An error occurred when loading the tileset file %1\n"
"KMahjongg will now terminate."
msgstr ""
"កំហុស​ដែល​កើត​ឡើង​នៅ​ពេលឯកសារសំណុំ​ក្បឿង​ផ្ទុក %1\n"
"KMahjongg នឹង​ចាប់​ផ្តើម​ឥឡូវ ។"

#: boardwidget.cpp:58
#, c-format
msgid ""
"An error occurred when loading the background image\n"
"%1"
msgstr ""
"កំហុស​បាន​កើត​ឡើង​នៅ​ពេល​រូប​ភាព​ផ្ទៃ​ខាង​ក្រោយ​កំពុង​ផ្ទុក\n"
"%1"

#: boardwidget.cpp:59
msgid "KMahjongg will now terminate."
msgstr "KMahjongg នឹង​បញ្ចប់​ឥឡូវ ។"

#: boardwidget.cpp:67
msgid ""
"An error occurred when loading the board layout %1\n"
"KMahjongg will now terminate."
msgstr ""
"កំហុស​បាន​កើត​ឡើង​នៅ​ពេល​ប្លង់​ក្តារ​កំពុង​ផ្ទុក%1\n"
"KMahjongg នឹង​បញ្ចប់​ឥឡូវ ។"

#: boardwidget.cpp:112
msgid ""
"KMahjongg could not locate the file: %1\n"
"or the default file of type: %2\n"
"KMahjongg will now terminate"
msgstr ""
"KMahjongg មិន​មាន​ឯកសារ​ទីតាំង ៖ %1\n"
"ឬ ប្រភេទ​នៃ​ឯកសារ​លំនាំ​ដើម ៖ %2\n"
"KMahjongg នឹង​បញ្ចប់​ឥឡូវ"

#: boardwidget.cpp:503
msgid "Undo operation done successfully."
msgstr "ការ​ប្រតិបត្តិ​មិន​ធ្វើ​វិញ​បាន​ដោយ​ជោគ​ជ័យ ។"

#: boardwidget.cpp:507
msgid "What do you want to undo? You have done nothing!"
msgstr "អ្វី​ទៅ​ដែល​អ្នក​ត្រូវ​ការ​ធ្វើ​វិញ? អ្នក​បាន​ធ្វើ​រួច!"

#: boardwidget.cpp:526
msgid "Sorry, you have lost the game."
msgstr "សូម​ទោស អ្នក​បាន​ចាញ់​ល្បែង​ហើយ ។"

#: boardwidget.cpp:568
msgid "Demo mode. Click mousebutton to stop."
msgstr "របៀប Demo ​។ ចុច​ប៊ូតុង​កណ្តុរ​ដើម្បី​បញ្ឈប់ ។"

#: boardwidget.cpp:577
msgid "Now it's you again."
msgstr "ឥឡូវ​វេន​អ្នក​ម្តង​ទៀត ។"

#: boardwidget.cpp:600
msgid "Your computer has lost the game."
