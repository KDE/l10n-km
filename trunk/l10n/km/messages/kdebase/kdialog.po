#: kdialog.cpp:63
msgid "Question message box with yes/no buttons"
msgstr "ប្រអប់​សារ​សំណួរ​ដែល​មាន​ប៊ូតុង បាទ/ទេ"

#: kdialog.cpp:64
msgid "Question message box with yes/no/cancel buttons"
msgstr "ប្រអប់​សារ​សំណួរ​ដែល​មាន​ប៊ូតុង​ បាទ/​ទេ/​បោះបង់"

#: kdialog.cpp:65
msgid "Warning message box with yes/no buttons"
msgstr "ប្រអប់​សារ​ព្រមាន​ដែល​មាន​ប៊ូតុង​ បាទ/ទេ"

#: kdialog.cpp:66
msgid "Warning message box with continue/cancel buttons"
msgstr "ប្រអប់​សារ​ព្រមាន​ដែល​មាន​ប៊ូតុង បន្ដ/បោះបង់"

#: kdialog.cpp:67
msgid "Warning message box with yes/no/cancel buttons"
msgstr "ប្រអប់​សារ​ព្រមាន​ដែល​មាន​ប៊ូតុង បាទ/​ទេ/បោះបង់"

#: kdialog.cpp:68
msgid "'Sorry' message box"
msgstr "ប្រអប់​សារ​ 'សូម​ទោស'"

#: kdialog.cpp:69
msgid "'Error' message box"
msgstr "ប្រអប់​សារ 'កំហុស'"

#: kdialog.cpp:70
msgid "Message Box dialog"
msgstr "ប្រអប់​សារ"

#: kdialog.cpp:71
msgid "Input Box dialog"
msgstr "ប្រអប់​បញ្ចូល"

#: kdialog.cpp:72
msgid "Password dialog"
msgstr "ប្រអប់​ពាក្យ​សម្ងាត់"

#: kdialog.cpp:73
msgid "Text Box dialog"
msgstr "ប្រអប់​អត្ថបទ"

#: kdialog.cpp:74
msgid "Text Input Box dialog"
msgstr "ប្រអប់​បញ្ចូល​អត្ថបទ"

#: kdialog.cpp:75
msgid "ComboBox dialog"
msgstr "ប្រអប់​ ប្រអប់​បន្សំ"

#: kdialog.cpp:76
msgid "Menu dialog"
msgstr "ប្រអប់​ម៉ឺនុយ"

#: kdialog.cpp:77
msgid "Check List dialog"
msgstr "ប្រអប់​បញ្ជី​ធីក"

#: kdialog.cpp:78
msgid "Radio List dialog"
msgstr "ប្រអប់​បញ្ជី​មូល"

#: kdialog.cpp:79
msgid "Passive Popup"
msgstr "បង្អួច​លេច​ឡើង​អសកម្ម"

#: kdialog.cpp:80
msgid "File dialog to open an existing file"
msgstr "ប្រអប់​ឯកសារ​ ដើម្បី​បើក​ឯកសារ​ដែល​មាន​ស្រាប់​មួយ"

#: kdialog.cpp:81
msgid "File dialog to save a file"
msgstr "ប្រអប់​ឯកសារ​ ដើម្បី​រក្សា​ទុក​ឯកសារ​មួយ"

#: kdialog.cpp:82
msgid "File dialog to select an existing directory"
msgstr "ប្រអប់​ឯកសារ​ ដើម្បី​ជ្រើស​ថត​ដែល​មាន​ស្រាប់​មួយ"

#: kdialog.cpp:83
msgid "File dialog to open an existing URL"
msgstr "ប្រអប់​ឯកសារ​ ដើម្បី​បើក​ URL ដែល​មាន​ស្រាប់​មួយ"

#: kdialog.cpp:84
msgid "File dialog to save a URL"
msgstr "ប្រអប់​ឯកសារ​ ដើម្បី​រក្សា​ទុក URL មួយ"

#: kdialog.cpp:85
msgid "Icon chooser dialog"
msgstr "ប្រអប់​ឧបករណ៍​ជ្រើស​រូបតំណាង"

#: kdialog.cpp:86
msgid "Progress bar dialog, returns a DCOP reference for communication"
msgstr "ប្រអប់​របារ​វឌ្ឍនភាព​ ត្រឡប់​សេចក្តី​យោង​ DCOP មួយ​ដើម្បី​ទាក់ទង"

#: kdialog.cpp:90
msgid "Dialog title"
msgstr "ចំណង​ជើង​ប្រអប់"

#: kdialog.cpp:91
msgid "Default entry to use for combobox and menu"
msgstr "ធាតុ​លំនាំ​ដើម​ត្រូវ​ប្រើ​ សម្រាប់​ប្រអប់​បន្សំ និងម៉ឺនុយ"

#: kdialog.cpp:92
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple files"
msgstr ""
"អនុញ្ញាត​ជម្រើស --getopenurl និង --getopenfilename ដើម្បី​ត្រឡប់​ឯកសារ​ច្រើន"

#: kdialog.cpp:93
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr ""
"ត្រឡប់​ធាតុ​បញ្ជី​នៅ​លើ​បន្ទាត់​ដោយ​ឡែកៗ​ពីគ្នា (សម្រាប់​ជម្រើស​បញ្ជី​ធីក "
"និង​បើក​ឯកសារជាមួយ --ច្រើន)"

#: kdialog.cpp:94
msgid "Outputs the winId of each dialog"
msgstr "បង្កើត​ winId សម្រាប់​ប្រអប់​នីមួយៗ"

#: kdialog.cpp:95
msgid "Makes the dialog transient for an X app specified by winid"
msgstr ""
"ធ្វើ​ប្រអប់​បណ្ដោះ​អាសន្ន​សម្រាប់​​កម្មវិធី X បាន​បញ្ជាក់​លម្អិត​ដោយ winid"

#: kdialog.cpp:96
msgid ""
"Config file and option name for saving the \"dont-show/ask-again\" state"
msgstr ""
"ឯកសារ​កំណត់​រចនាសម្ព័ន្ធ​ និង​​ឈ្មោះ​ជម្រើស​សម្រាប់​រក្សា​ទុក​សភាព​របស់ "
"\"dont-show/ask-again\""

#: kdialog.cpp:98
msgid "Arguments - depending on main option"
msgstr "អាគុយម៉ង់ - ពឹង​ផ្អែក​លើ​ជម្រើស​ដ៏​សំខាន់"

#: kdialog.cpp:666
msgid "KDialog"
msgstr "KDialog"

#: kdialog.cpp:667
msgid "KDialog can be used to show nice dialog boxes from shell scripts"
msgstr ""
"KDialog អាច​ត្រូវ​បាន​ប្រើ​ដើម្បី​បង្ហាញ​ប្រអប់​​ដ៏​ស្អាត​ពី​ស្គ្រីប​សែល"

#: kdialog.cpp:670
msgid "Current maintainer"
msgstr "អ្នក​ថែរក្សា​បច្ចុប្បន្ន"

#: widgets.cpp:96
msgid "kdialog: could not open file "
msgstr "kdialog: មិនអាច​បើក​ឯកសារ"
