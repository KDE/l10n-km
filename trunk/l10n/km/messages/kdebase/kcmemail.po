#: email.cpp:85
msgid "KDE Email Control Module"
msgstr "ម៉ូឌុល​បញ្ជា​អ៊ីម៉ែល KDE"

#: email.cpp:86
msgid "Configure your identity, email addresses, mail servers, etc."
msgstr "កំណត់​រចនាសម្ព័ន្ធ​អត្ត​សញ្ញាណ អាសយដ្ឋាន​អ៊ីម៉ែល ម៉ាស៊ីន​បម្រើ​អ៊ីម៉ែលរបស់​អ្នក ។ល។"

#: email.cpp:88
msgid "Current maintainer"
msgstr "អ្នក​ថែទាំ​បច្ចុប្បន្ន"

#: email.cpp:191
msgid "New Email Profile"
msgstr "ទម្រង់​អ៊ីម៉ែល​ថ្មី"

#: email.cpp:198
msgid "Name:"
msgstr "ឈ្មោះ ៖"

#: email.cpp:219
msgid "Please enter a name for the profile."
msgstr "សូម​បញ្ចូល​ឈ្មោះ​មួយ​សម្រាប់​ទម្រង់ ។"

#: email.cpp:221
msgid "This email profile already exists, and cannot be created again."
msgstr "ទម្រង់​អ៊ីម៉ែល​នេះ​មាន​រួច​ហើយ និង​មិន​អាច​ត្រូវ​បាន​បង្កើត​ម្តង​ទៀត ។"

#: email.cpp:295
msgid "<h1>Email</h1> This module allows you to enter basic email information for the current user. The information here is used, among other things, for sending bug reports to the KDE developers when you use the bug report dialog.<p> Note that email programs like KMail offer many more features, but they provide their own configuration facilities."
msgstr "<h1>អ៊ីម៉ែល</h1> ម៉ូឌុល​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​បញ្ចូល​ព័ត៌មាន​អ៊ីម៉ែល​មូលដ្ឋាន​សម្រាប់​អ្នក​ប្រើ​បច្ចុប្បន្ន ។ ព័ត៌មាន​ទីនេះ​ត្រូវ​បាន​ប្រើ​សម្រាប់​ផ្ញើ​របាយការណ៍​កំហុស​ទៅអ្នក​បង្កើត KDE ពេល​អ្នក​ប្រើ​ប្រអប់របាយការណ៍​កំហុស ។<p> ចំណាំថា កម្មវិធី​អ៊ីម៉ែល​ដូចជា KMail ផ្តល់​នូវ​លក្ខណៈជា​ច្រើន ប៉ុន្តែ​ពួកវា​ផ្តល់​នូវភាព​ងាយស្រួល​ក្នុង​ការ​កំណត់​រចនាសម្ព័ន្ធ​ផ្ទាល់ខ្លួន​ពួក​វា ។"

#: email.cpp:314
msgid "Do you wish to discard changes to the current profile?"
msgstr "តើ​អ្នក​ចង់​បោះចោលភាព​ផ្លាស់ប្តូរ​ទៅ​ទម្រង់​បច្ចុប្បន្ន​ឬ ?"

#: email.cpp:315
msgid "Do you wish to save changes to the current profile?"
msgstr "តើ​អ្នក​ចង់​រក្សាទុក​ភាពផ្លាស់ប្តូរ​ទៅ​ទម្រង់​បច្ចុប្បន្ន​ឬ ?"

#: rc.cpp:1
msgid "Email"
msgstr "អ៊ីម៉ែល"

#: rc.cpp:2
msgid "User Information"
msgstr "ព័ត៌មាន​អ្នក​ប្រើ"

#: rc.cpp:3
msgid "You can set a reply address if you want replies to your email messages to go to a different address than the email address above. Most likely, you should leave the reply address blank, so replies go to the email address you entered above.<p><em> Please note:</em> <ul><li>You do not need to enter the same email address as above.</li><li>You should not use a reply address if you frequently use discussion mailing lists.</li></ul>"
msgstr "អ្នក​អាច​កំណត់​អាសយដ្ឋាន​ឆ្លើយតប បើ​អ្នក​ចង់​ឆ្លើយតប​សារ​អ៊ីម៉ែល​របស់​អ្នក​ទៅ​អាសយដ្ឋាន​ផ្សេងមួយ ក្រៅ​ពី​អាសយដ្ឋាន​អ៊ីម៉ែល​ខាង​លើ ។ ភាគ​ច្រើន អ្នក​គួរ​ទុក​អាសយដ្ឋាន​ឆ្លើយ​តប​ឲ្យ​ទទេ ដូច្នេះ​ការ​ឆ្លើយ​តបនឹង​​ទៅ​អាសយដ្ឋាន​អ៊ីម៉ែល​ដែល​អ្នក​បាន​បញ្ចូល​ខាងលើ ។<p><em> សូម​ចំណាំ​ថា ៖</em> <ul><li>អ្នក​មិន​ចាំបាច់​ត្រូវ​បញ្ចូល​អាសយដ្ឋាន​អ៊ីម៉ែល​ដូច​ខាង​លើ​ទេ ។​</li><li>អ្នក​មិន​គួរ​ប្រើ​អាសយដ្ឋាន​ឆ្លើយ​តប​ទេ បើ​ជា​ញឹកញាប់​អ្នក​ប្រើ​បញ្ជី​សំបុត្រ​រួម​ពិភាគ្សា​ ។</li></ul>"

#: rc.cpp:4
msgid ""
"Enter your email address here, e.g. \"john@doe.com\" (without the quotation marks). This information is mandatory if you want to use email.<p>\n"
"Do <em>not</em> enter something like John Doe &lt;john@doe.com&gt;\", just a plain email address. Your email address must not contain any blank spaces."
msgstr ""
"បញ្ចូល​អាសយដ្ឋាន​អ៊ីម៉ែល​របស់​អ្នក​នៅ​ទីនេះ ឧទាហរណ៍ \"john@doe.com\" (ដោយ​គ្មាន​សញ្ញា​សម្រង់) ។ ព័ត៌មាន​នេះ​គឺ​ចាំបាច់ ​បើ​អ្នកចង់​​ប្រើ​អ៊ីម៉ែល ។<p>\n"
"<em>កុំ</em> បញ្ចូល​អ្វី​ផ្សេង ដូចជា John Doe &lt;john@doe.com&gt;\" គឺ​គ្រាន់តែ​ជា​អាសយដ្ឋាន​អ៊ីម៉ែល​ធម្មតា ។ អាសយដ្ឋាន​អ៊ីម៉ែល​របស់​អ្នក​ មិន​ត្រូវ​មាន​ដក​ឃ្លា​ទេ ។"

#: rc.cpp:5
msgid "Organi&zation:"
msgstr "អង្គការ ៖ "

#: rc.cpp:6
msgid "Reply-&to address:"
msgstr "ឆ្លើយ​តប​ទៅ​អាសយដ្ឋាន ៖ "

#: rc.cpp:7
msgid "Here you can enter the name of your organization, company or university. This field is <em>optional</em>. However, if you are using a business account and communicate with persons working for other companies, providing the name of your organization is recommended."
msgstr "ទីនេះ អ្នក​អាច​បញ្ចូល​ឈ្មោះ​អង្គការ​ ក្រុមហ៊ុន ឬ សកលវិទ្យាល័យ​របស់​អ្នក ។ វាល​នេះ​គឺ<em>ស្រេចចិត្ត</em> ។ ទោះ​យ៉ាងណា បើ​អ្នក​ប្រើ​គណនី​ពាណិជ្ជកម្ម និង​ទាក់ទង​ជាមួយ​អ្នក​ដែល​ធ្វើការ​ឲ្យ​ក្រុមហ៊ុន​ផ្សេង នោះ​ការ​ផ្តល់​ឈ្មោះអង្គការ​​របស់​អ្នកត្រូវ​បាន​ផ្តល់​អនុសាសន៍ ។"

#: rc.cpp:8
msgid "E&mail address:"
msgstr "អាសយដ្ឋាន​អ៊ីម៉ែល ៖ "

#: rc.cpp:9
#, fuzzy
msgid ""
"Enter your full name here, e.g. \"John Doe\" (without the quotation\n"
"marks). Some people like to provide a nickname only. You can leave this field blank and still use email. However, providing your full name is <em>recommended</em> as this makes it much easier for your recipient to browse his or her email."
msgstr "បញ្ចូល​ឈ្មោះ​ពេញ​របស់​អ្នក​នៅ​ទីនេះ ឧទាហរណ៍ \"សៅ ជ័យ\" (ដោយ​មិន​មាន​សញ្ញា​សម្រង់) ។អ្នក​ខ្លះ​ចូលចិត្ត​ផ្តល់​នូវ​សម្មិតនាម​ប៉ុណ្ណោះ ។ អ្នក​អាច​ទុក​វាល​នេះ​ឲ្យ​ទទេ និង​នៅ​តែ​ប្រើ​អ៊ីម៉ែល ។ ទោះ​យ៉ាងណា ការ​ផ្តល់​ឈ្មោះ​ពេញ​របស់​អ្នក​<em>ត្រូវ​បាន​ផ្តល់​អនុសាសន៍</em> ដោយសារ​វា​ជួយ​សម្រួល​ច្រើន​ដល់​អ្នក​ទទួល​របស់​អ្នក​ក្នុង​ការ​រក​មើលអ៊ីម៉ែល​របស់​គាត់ ឬ របស់​នាង ។"

#: rc.cpp:10
msgid "Full &name:"
msgstr "ឈ្មោះ​ពេញ ៖ "

#: rc.cpp:11
msgid "SMTP server:"
msgstr "ម៉ាស៊ីន​បម្រើ SMTP ៖"

#: rc.cpp:12
msgid ""
"<qt>You can specify the server to send mail to here.\n"
"<br><br> SMTP means Simple Mail Transfer Protocol and is the standard way to send mail.</qt>"
msgstr ""
"<qt>អ្នក​អាច​បញ្ជាក់​លម្អិត​ម៉ាស៊ីន​បម្រើ​ដែល​ត្រូវ​ផ្ញើ​អ៊ីម៉ែល​ទៅ​កាន់​នៅ​ទីនេះ ។\n"
"<br><br> SMTP មាន​ន័យ​ថា ពិធីការ​បញ្ចូន​សារ​សាមញ្ញ និង​ជា​មធ្យោបាយ​ខ្នាត​គំរូ​ក្នុង​ការ​ផ្ញើ​សារ ។</qt>"

#: rc.cpp:13
msgid "C&urrent profile:"
msgstr "ទម្រង់​បច្ចុប្បន្ន ៖ "

#: rc.cpp:14
msgid "&New Profile..."
msgstr "ទម្រង់​ថ្មី... ៖ "

