#: configdialog.cpp:49
msgid "&General"
msgstr "ទូទៅ"

#: configdialog.cpp:52
msgid "Ac&tions"
msgstr "សកម្មភាព"

#: configdialog.cpp:55
msgid "&Shortcuts"
msgstr "ផ្លូវ​កាត់"

#: configdialog.cpp:99
msgid "&Popup menu at mouse-cursor position"
msgstr "ម៉ឺនុយ​លេចឡើង នៅ​ទី​តាំង​កណ្ដុរ-ទស្សន៍​ទ្រនិច"

#: configdialog.cpp:101
msgid "Save clipboard contents on e&xit"
msgstr "រក្សា​មាតិកា​ក្ដា​តម្បៀត​ខ្ទាស់​ពេល​ចេញ"

#: configdialog.cpp:103
msgid "Remove whitespace when executing actions"
msgstr "យក​ចន្លោះ​ស​ចេញ នៅ​ពេល​ប្រតិបត្តិ​សកម្មភាព"

#: configdialog.cpp:105
msgid ""
"Sometimes, the selected text has some whitespace at the end, which, if loaded "
"as URL in a browser would cause an error. Enabling this option removes any "
"whitespace at the beginning or end of the selected string (the original "
"clipboard contents will not be modified)."
msgstr ""
"ជួនកាល អត្ថបទ​ដែល​ជ្រើស​មាន​ចន្លោះ​ស​នៅ​ខាង​ចុង ដែល​ប្រសិន​បើត្រូវ​ផ្ទុក​ជា URL "
"ក្នុង​កម្មវិធី​រុករក​នឹង​ធ្វើ​ឲ្យ​មាន​បញ្ហា ។ ធ្វើ​ឲ្យ​ជម្រើស​នេះ​ប្រើ​បាន "
"យក​ចេញ​នូវ​ចន្លោះ​ស​ទាំង​អស់​ដែល​នៅ​ខាង​ដើម ឬ ខាង​ចុច​នៃ​ខ្សែ​អក្សរ​ដែល​ជ្រើស "
"(ក្តារ​តម្បៀត​ខ្ទាស់​ដើម​នឹង​មិន​ត្រូវ​បាន​កែប្រែ​ទេ) ។"

#: configdialog.cpp:107
msgid "&Replay actions on an item selected from history"
msgstr "លេង​សកម្មភាព​ឡើង​វិញ​លើ​វត្ថុ​ដែល​ជ្រើស​ពី​ប្រវត្តិ"

#: configdialog.cpp:110
msgid "Pre&vent empty clipboard"
msgstr "បង្កា​ក្ដារ​តម្បៀត​ខ្ទាស់​ទទេ"

#: configdialog.cpp:112
msgid ""
"Selecting this option has the effect, that the clipboard can never be emptied. "
"E.g. when an application exits, the clipboard would usually be emptied."
msgstr ""
"ដោយ​ជ្រើស​ជម្រើស​នេះ​មាន​ឥទ្ធិពល ដែល​ក្តារ​តម្បៀត​ខ្ទាស់​មិន​អាច​ជម្រះ​បាន​ ។ "
"ឧ. នៅ​ពេល​កម្មវីធី​ចេញ ក្តារ​តម្បៀត​ខ្ទាស់​នឹង​ជា​ធម្មតា​ត្រូវ​ជម្រះ ។"

#: configdialog.cpp:117
msgid "&Ignore selection"
msgstr "មិន​អើពើ​ជម្រើស"

#: configdialog.cpp:119
msgid ""
"This option prevents the selection being recorded in the clipboard history. "
"Only explicit clipboard changes are recorded."
msgstr ""
"ជម្រើស​នេះ​បង្កា​ជម្រើស​ដែល​កំពុង​តែ​កត់ត្រា "
"នៅ​ក្នុង​ប្រវត្តិ​ក្ដារ​តម្បៀត​ខ្ទាស់ ។ "
"មាន​តែ​ការ​ផ្លាស់​ប្ដូរ​ក្ដារ​តម្បៀត​ខ្ទាស់​ច្បាស់លាស់​ដែល​ត្រូវ​កត់ត្រា ។"

#: configdialog.cpp:123
msgid "Clipboard/Selection Behavior"
msgstr "ឥរិយាបថ​ក្ដារ​តម្បៀត​ខ្ទាស់/ជម្រើស"

#: configdialog.cpp:127
msgid ""
"<qt>There are two different clipboard buffers available:"
"<br>"
"<br><b>Clipboard</b> is filled by selecting something and pressing Ctrl+C, or "
"by clicking \"Copy\" in a toolbar or menubar."
"<br>"
"<br><b>Selection</b> is available immediately after selecting some text. The "
"only way to access the selection is to press the middle mouse button."
"<br>"
"<br>You can configure the relationship between Clipboard and Selection.</qt>"
msgstr ""
"<qt>មាន​សតិ​បណ្ដោះ​អាសន្ន​ក្តារ​តម្បៀត​ខ្ទាស់​ពីរ​ខុស​គ្នា ៖"
"<br>"
"<br><b>ក្តារ​តម្បៀត​ខ្ទាស់</b> ដែល​បំពេញ​ដោយ​ជ្រើស​អ្វី​មួយ និង​សង្កត់ បញ្ជា "
"(Ctrl)+C ឬ ដោយ​ចុច \"ចម្លង\" ក្នុង​របារ​ឧបករណ៍ ឬ របារ​ម៉ឺនុយ ។"
"<br>"
"<br><b>ជម្រើស</b> មាន​ភ្លាមៗ​ក្រោយ​បេល​ជ្រើស​អត្ថបទ​ខ្លះ ។ "
"វិធី​តែ​មួយ​ដើម្បី​ចូល​ប្រើ​ជម្រើស​គឺ​សង្កត់​ប៊ូតុង​កណ្ដាល​របស់​កណ្ដុរ ។"
"<br>"
"<br>អ្នក​អាច​កំណត់​រចនា​សម្ព័ន្ធ​ទំនាក់​ទំនង​រវាង ក្តារ​តម្បៀត​ខ្ទាស់ "
"និង​ជម្រើស ។</qt>"

#: configdialog.cpp:138
msgid "Sy&nchronize contents of the clipboard and the selection"
msgstr "ធ្វើ​សមកាលកម្ម​មាតិកា របស់​ក្ដារ​តម្បៀត​ខ្ទាស់ និង​ជម្រើស"

#: configdialog.cpp:141
msgid ""
"Selecting this option synchronizes these two buffers, so they work the same way "
"as in KDE 1.x and 2.x."
msgstr ""
"ជ្រើស​ជម្រើស​នេះ ធ្វើ​សមកាលកម្ម​សតិ​បណ្ដោះ​អាសន្ន​ទាំង​ពីរ​នេះ "
"ដូច្នេះ​ពួក​គេ​ធ្វើ​ការ​ដូច​ក្នុង KDE 1.x និង 2.x ។"

#: configdialog.cpp:145
msgid "Separate clipboard and selection"
msgstr "បំបែក​ក្ដារ​តម្បៀត​ខ្ទាស់ និង ជម្រើស"

#: configdialog.cpp:148
msgid ""
"Using this option will only set the selection when highlighting something and "
"the clipboard when choosing e.g. \"Copy\" in a menubar."
msgstr ""
"ប្រើ​ជម្រើស​នេះ នឹង​គ្រាន់តែ​កំណត់​ជម្រើស​នៅ​ពេល​ធ្វើ​ការ​បន្លិច​អ្វី​មួយ "
"និង​ក្តារ​តម្បៀត​ខ្ទាស់​នៅ​ពេល​ជ្រើស​រើស ឧ. \"ចម្លង\" ក្នុង​របារ​ម៉ឺនុយ ។"

#: configdialog.cpp:155
msgid "Tim&eout for action popups:"
msgstr "ពេល​សម្រាក​សម្រាប់​ការ​លេចឡើង​សកម្មភាព ៖"

#: configdialog.cpp:157
msgid " sec"
msgstr " វិនាទី"

#: configdialog.cpp:158
msgid "A value of 0 disables the timeout"
msgstr "តម្លៃ 0 ធ្វើ​ឲ្យ​ការ​អស់ពេល​ប្រើ​លែង​បាន"

#: configdialog.cpp:161
msgid "C&lipboard history size:"
msgstr "ទំហំ​ប្រវត្តិ​ក្ដារ​តម្បៀត​ខ្ទាស់ ៖"

#: configdialog.cpp:183
msgid ""
"_n:  entry\n"
" entries"
msgstr ""
"_n:  entry\n"
" ធាតុ"

#: configdialog.cpp:229
msgid "Action &list (right click to add/remove commands):"
msgstr "បញ្ជី​សកម្មភាព (ចុច​ខាង​ស្ដាំ​ដើម្បី​បន្ថែម/យក​ចេញ​ពាក្យ​បញ្ជា) ៖"

#: configdialog.cpp:233
msgid "Regular Expression (see http://doc.trolltech.com/qregexp.html#details)"
msgstr "កន្សោម​និយ័ត (មើល http://doc.trolltech.com/qregexp.html#details)"

#: configdialog.cpp:234
msgid "Description"
msgstr "ពិពណ៌នា"

#: configdialog.cpp:286
msgid "&Use graphical editor for editing regular expressions"
msgstr "ប្រើ​កម្មវិធី​និពន្ធ​ជា​រូបភាព​សម្រាប់ កែ​សម្រួល​កន្សោម​និយ័ត"

#: configdialog.cpp:295
msgid "&Add Action"
msgstr "បន្ថែម​សកម្មភាព"

#: configdialog.cpp:298
msgid "&Delete Action"
msgstr "លុប​សកម្មភាព"

#: configdialog.cpp:301
#, c-format
msgid ""
"Click on a highlighted item's column to change it. \"%s\" in a command will be "
"replaced with the clipboard contents."
msgstr ""
"ចុច​លើ​ជួរ​ឈរ​របស់​វត្ថុ​ដែល​បន្លិច ដើម្បី​ប្ដូរ​វា ។ \"%s\" "
"ក្នុង​ពាក្យ​បញ្ជា​នឹង​ត្រូវ​ជំនួស​ដោយ​មាតិកា​ក្តារ​តម្បៀត​ខ្ទាស់ ។"

#: configdialog.cpp:307
msgid "Advanced..."
msgstr "កម្រិត​ខ្ពស់..."

#: configdialog.cpp:332
msgid "Add Command"
msgstr "បន្ថែម​ពាក្យ​បញ្ជា"

#: configdialog.cpp:333
msgid "Remove Command"
msgstr "យកចេញ​ពាក្យ​បញ្ជា"

#: configdialog.cpp:343
msgid "Click here to set the command to be executed"
msgstr "ចុច​ទី​នេះ​ដើម្បី​កំណត់​ពាក្យ​បញ្ជា​ដែល​ត្រូវ​ប្រតិបត្តិ"

#: configdialog.cpp:344
msgid "<new command>"
msgstr "<ពាក្យ​បញ្ជា​ថ្មី>"

#: configdialog.cpp:366
msgid "Click here to set the regexp"
msgstr "ចុច​ទី​នេះ​ដើម្បី​កំណត់ regexp"

#: configdialog.cpp:367
msgid "<new action>"
msgstr "<សកម្មភាព​ថ្មី>"

#: configdialog.cpp:407
msgid "Advanced Settings"
msgstr "កំណត់​កម្រិត​ខ្ពស់"

#: configdialog.cpp:424
msgid "D&isable Actions for Windows of Type WM_CLASS"
msgstr "ធ្វើ​ឲ្យ​សកម្មភាព​ប្រើ​លែង​បាន​សម្រាប់ Windows នៃ​ប្រភេទ WM_CLASS"

#: configdialog.cpp:427
msgid ""
"<qt>This lets you specify windows in which Klipper should not invoke "
"\"actions\". Use"
"<br>"
"<br>"
"<center><b>xprop | grep WM_CLASS</b></center>"
"<br>in a terminal to find out the WM_CLASS of a window. Next, click on the "
"window you want to examine. The first string it outputs after the equal sign is "
"the one you need to enter here.</qt>"
msgstr ""
"<qt>ទង្វើ​នេះ​អនុញ្ញាត​ឲ្យ​អ្នក​បញ្ជាក់​ពី​បង្អួច​ដែល Klipper មិន​គួរ​យក "
"\"សកម្មភាព\" មក​ប្រើ ។ ប្រើ"
"<br>"
"<br>"
"<center><b>xprop | grep WM_CLASS</b></center>"
"<br>នៅ​ក្នុង​ស្ថានីយ៍​ដើម្បី​រក WM_CLASS របស់​បង្អួច ។ បន្ទាប់​មក "
"ចុច​លើ​បង្អួច​ដែល​អ្នក​ចង់​ពិនិត្យ ។ "
"ខ្សែ​អក្សរ​ទី​មួយ​បញ្ចេញ​ពី​ក្រោយ​សញ្ញា​ស្មើ "
"គឺ​ជា​អ្វី​ដែល​អ្នក​ត្រូវការ​ដើម្បី​បញ្ចូល​ទី​នេះ ។</qt>"

