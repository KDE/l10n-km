#  i18n: file bgadvanced_ui.ui line 81
#: rc.cpp:24
#: rc.cpp:280
#, no-c-format
msgid ""
"<qt>\n"
"<p>Click here to modify the programs options. You usually can get the available options to a suitable program by typing in a terminal emulator the name of the executable file plus --help. (example: kwebdesktop --help).</p>\n"
"<p>One useful example is the program kwebdesktop. It draws a web page on the background of your desktop.  You can use this program by selecting it on the listbox on the right, but it will draw a predefined web page. To change the web page it renders, select the kwebdesktop program on the listbox, then click here. A dialog will appear, allowing you to change the web page by replacing the old address (URL) with a new one.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>ចុច​ទីនេះ​ដើម្បី​កែប្រែ​ជម្រើស​កម្មវិធី ។ ជា​ធម្មតា អ្នក​អាច​យក​ជម្រើស​ដែល​អាច​ប្រើ​បាន​ទៅ​កម្មវិធី​ដែល​សក្ដិសម ដោយ​វាយ​ក្នុង​វត្ថុ​ត្រាប់​តាម​ស្ថានីយ​នូវ​ឈ្មោះ​ឯកសារ​ដែល​អាច​ប្រតិបត្តិ​បានបូក​ថែម​ --help. (ឧទាហរណ៍ ៖ kwebdesktop --help).</p>\n"
"<p>ឧទាហរណ៍​ដ៏​មាន​ប្រយោជន៍​មួយ​គឺ kwebdesktop ។ វា​គូរ​ទំព័រ​បណ្ដាញ​មួយ​លើ​ផ្ទៃ​ខាង​ក្រោយ​ផ្ទៃ​តុ​របស់​អ្នក ។ អ្នក​អាច​ប្រើ​កម្មវិធី​នេះ​ដោយ​ជ្រើស​វា​ក្នុង​ប្រអប់​បញ្ជី​នៅ​ខាង​ស្ដាំ ប៉ុន្តែ​វា​នឹង​គូរ​ទំព័រ​បណ្ដាញ​មួយដែល​បាន​កំណត់​ជា​មុន​ ។ ដើម្បី​ប្តូរ​ទំព័រ​បណ្ដាញ​ដែល​វា​បង្ហាញ ជ្រើស​កម្មវិធី kwebdesktop ក្នុង​ប្រអប់​បញ្ជី បន្ទាប់​មក​ចុច​ទីនេះ ។ ប្រអប់​មួយ​នឹង​លេច​ឡើង ដែល​អនុញ្ញាត​ឲ្យ​អ្នកប្តូរ​​ទំព័រ​បណ្ដាញ​ដោយ​ជំនួស​អាសយដ្ឋាន​ចាស់ (URL) ដោយ​អាសយដ្ឋាន​ថ្មី​មួយ ។</p>\n"
"</qt>"

