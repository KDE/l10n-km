#: kcmtaskbar.cpp:82
msgid "Show Task List"
msgstr "បង្ហាញ​បញ្ជី​ភារកិច្ច"

#: kcmtaskbar.cpp:82
msgid "Show Operations Menu"
msgstr "បង្ហាញ​ម៉ឺនុយ​ប្រតិបត្តិការ"

#: kcmtaskbar.cpp:83
msgid "Activate, Raise or Minimize Task"
msgstr "ធ្វើ​ឲ្យ​ភារកិច្ច​សកម្ម លើក​ភារកិច្ច​ឡើងលើ ឬ ​បង្រួម​ភារកិច្ច​អប្បបរមា"

#: kcmtaskbar.cpp:84
msgid "Activate Task"
msgstr "ធ្វើ​ឲ្យ​ភារកិច្ច​សកម្ម"

#: kcmtaskbar.cpp:84
msgid "Raise Task"
msgstr "លើក​ភារកិច្ច​ឡើងលើ"

#: kcmtaskbar.cpp:85
msgid "Lower Task"
msgstr "បន្ទាប​ភារកិច្ច​ចុះក្រោម"

#: kcmtaskbar.cpp:85
msgid "Minimize Task"
msgstr "បង្រួម​ភារកិច្ច​អប្បបរមា"

#: kcmtaskbar.cpp:86
msgid "To Current Desktop"
msgstr "ទៅ​ផ្ទៃតុ​បច្ចុប្បន្ន"

#: kcmtaskbar.cpp:104
msgid "Never"
msgstr "មិន​ដែល"

#: kcmtaskbar.cpp:104
msgid "When Taskbar Full"
msgstr "ពេល​របារ​ភារកិច្ច​ពេញ"

#: kcmtaskbar.cpp:105
msgid "Always"
msgstr "ជានិច្ច"

#: kcmtaskbar.cpp:127
msgid "Elegant"
msgstr "ប្រណិត"

#: kcmtaskbar.cpp:128
msgid "Classic"
msgstr "បុរាណ"

#: kcmtaskbar.cpp:129
msgid "For Transparency"
msgstr "សម្រាប់​ភាព​ថ្លា"

#: kcmtaskbar.cpp:142
msgid "<h1>Taskbar</h1> You can configure the taskbar here. This includes options such as whether or not the taskbar should show all windows at once or only those on the current desktop. You can also configure whether or not the Window List button will be displayed."
msgstr "<h1>របារ​ភារកិច្ច</h1> អ្នក​អាច​កំណត់​រចនាសម្ព័ន្ធ​របារ​ភារកិច្ច​នៅ​ទីនេះ ។ នេះ​រួម​មាន​ជម្រើស​ជា​ច្រើន​ដូច​ជា ថាតើ​របារ​ភារកិច្ច​គួរ​បង្ហាញ​បង្អួច​ទាំង​អស់​នៅ​ពេល​តែ​មួយ​ ឬ​ក៏​អត់ ឬក៏​​បង្ហាញ​តែ​របារ​ភារកិច្ច​ទាំង​នោះ​​នៅលើ​ផ្ទៃតុ​បច្ចុប្បន្ន​​ប៉ុណ្ណោះ ។ អ្នក​ក៏​អាច​កំណត់​រចនាសម្ព័ន្ធ​ផង​ដែរ​ ថាតើ​​ប៊ូតុង​បញ្ជី​បង្អួច​​នឹង​ត្រូវ​បាន​បង្ហាញ​ ឬក៏​អត់ ។"

