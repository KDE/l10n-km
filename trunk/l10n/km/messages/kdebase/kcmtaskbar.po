#  i18n: file kcmtaskbarui.ui line 47
#: rc.cpp:9
#, no-c-format
msgid "Show windows from all sc&reens"
msgstr "បង្ហាញ​បង្អួច​ពី​អេក្រង់​ទាំង​អស់"

#  i18n: file kcmtaskbarui.ui line 55
#: rc.cpp:12
#, no-c-format
msgid ""
"Turning this option off will cause the taskbar to display <b>only</b> windows which are on the same Xinerama screen as the taskbar.\n"
"\n"
"By default, this option is selected and all windows are shown."
msgstr ""
"បិទ​ជម្រើស​នេះ​ នឹង​បណ្ដាល​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​ <b>តែ</b> បង្អួច​ដែល​នៅ​លើ​អេក្រង់ Xinerama ដូច​របារ​ភារកិច្ច ។\n"
"\n"
"តាម​លំនាំ​ដើម ជម្រើស​នេះ​ត្រូវ​បានជ្រើស​ និង​បង្អួច​​ទាំង​អស់​ត្រូវ​បាន​បង្ហាញ ។"

#  i18n: file kcmtaskbarui.ui line 63
#: rc.cpp:17
#, no-c-format
msgid "Sort windows by desk&top"
msgstr "តម្រៀប​បង្អួច​តាម​ផ្ទៃតុ"

#  i18n: file kcmtaskbarui.ui line 71
#: rc.cpp:20
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to show windows in order of the desktop they appear on.\n"
"\n"
"By default this option is selected."
msgstr ""
"ការ​ជ្រើស​ជម្រើស​នេះ​បណ្ដាល​ឲ្យ​របារ​ភារកិច្ច​​បង្ហាញ​បង្អួច​ក្នុង​លំដាប់​របស់​ផ្ទៃតុ​ដែល​ពួក​វា​បង្ហាញ ។\n"
"\n"
"តាម​លំនាំដើម ជម្រើស​នេះ​ត្រូវ​បានជ្រើស ។"

#  i18n: file kcmtaskbarui.ui line 96
#: rc.cpp:25
#, no-c-format
msgid "&Show windows from all desktops"
msgstr "បង្ហាញ​បង្អួច​ពី​ផ្ទៃ​តុ​ទាំង​អស់"

#  i18n: file kcmtaskbarui.ui line 104
#: rc.cpp:28
#, no-c-format
msgid ""
"Turning this option off will cause the taskbar to display <b>only</b> the windows on the current desktop. \n"
"\n"
"By default, this option is selected and all windows are shown."
msgstr ""
"បិទ​ជម្រើស​នេះ​ នឹង​បណ្ដាល​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ <b>តែ</b> បង្អួច​នៅ​លើ​ផ្ទៃតុ​បច្ចុប្បន្នប៉ុណ្ណោះ ។ \n"
"\n"
"តាម​លំនាំ​ដើម ជម្រើស​នេះ​ត្រូវ​បានជ្រើស​ និង​បង្អួច​ទាំង​អស់​ត្រូវ​បាន​បង្ហាញ ។"

#  i18n: file kcmtaskbarui.ui line 112
#: rc.cpp:33
#, no-c-format
msgid "Sho&w application icons"
msgstr "បង្ហាញ​រូបតំណាង​កម្មវិធី"

#  i18n: file kcmtaskbarui.ui line 120
#: rc.cpp:36
#, no-c-format
msgid ""
"Select this option if you want window icons to appear along with their titles in the taskbar.\n"
"\n"
"By default this option is selected."
msgstr ""
"ជ្រើស​ជម្រើស​នេះ​ ប្រសិន​បើ​អ្នក​ចង់​ឲ្យ​រូបតំណាង​របស់​បង្អួច​បង្ហាញ​ជាមួយ​នឹង​ចំណង​ជើង​របស់​វា​ក្នុង​របារ​ភារកិច្ច ។\n"
"\n"
"តាម​លំនាំ​ដើម​ ជម្រើស​នេះ​ត្រូវ​បានជ្រើស ។"

#  i18n: file kcmtaskbarui.ui line 128
#: rc.cpp:41
#, no-c-format
msgid "Show window list &button"
msgstr "បង្ហាញ​ប៊ូតុង​បញ្ជី​របស់​បង្អួច"

#  i18n: file kcmtaskbarui.ui line 134
#: rc.cpp:44
#, no-c-format
msgid "Selecting this option causes the taskbar to display a button that, when clicked, shows a list of all windows in a popup menu."
msgstr "ការ​ជ្រើស​ជម្រើស​នេះ​​បណ្ដាល​ឲ្យ​របារ​ភារកិច្ច​​​បង្ហាញ​ប៊ូតុង​នៅ​ពេល​ចុច ដែល​បង្ហាញ​​បញ្ជី​របស់​បង្អួច​ទាំង​អស់​ក្នុង​ម៉ឺនុយ​លេច​ឡើង ។"

#  i18n: file kcmtaskbarui.ui line 142
#: rc.cpp:47
#, no-c-format
msgid "Show o&nly minimized windows"
msgstr "បង្ហាញ​តែ​បង្អួច​ដែល​បាន​បង្រួម​អប្បបរមា​ប៉ុណ្ណោះ"

#  i18n: file kcmtaskbarui.ui line 147
#: rc.cpp:50
#, no-c-format
msgid ""
"Select this option if you want the taskbar to display <b>only</b> minimized windows. \n"
"\n"
"By default, this option is not selected and the taskbar will show all windows."
msgstr ""
"ជ្រើស​ជម្រើស​នេះ​ ប្រសិន​បើ​អ្នក​ចង់​​ឲ្យ​របារ​ភារកិច្ច​បង្ហាញ​ <b>តែ</b> បង្អួច​ដែល​បាន​បង្រួម​អប្បបរមា ។ \n"
"\n"
"តាម​លំនាំ​ដើម ជម្រើស​នេះ​មិន​ត្រូវ​បានជ្រើស​ទេ និង​របារ​ភារកិច្ច​នឹង​បង្ហាញ​បង្អួច​ទាំង​អស់ ។"

#  i18n: file kcmtaskbarui.ui line 155
#: rc.cpp:55
#, no-c-format
msgid "&Group similar tasks:"
msgstr "ដាក់​ភារកិច្ច​ដែល​ដូច​គ្នា​ជា​ក្រុម ៖"

#  i18n: file kcmtaskbarui.ui line 178
#: rc.cpp:58
#, no-c-format
msgid ""
"The taskbar can group similar windows into single buttons. When one of these window group buttons are clicked on a menu appears showing all the windows in that group. This can be especially useful with the <em>Show all windows</em> option.\n"
"\n"
"You can set the taskbar to <strong>Never</strong> group windows, to <strong>Always</strong> group windows or to group windows only <strong>When the Taskbar is Full</strong>.\n"
"\n"
"By default the taskbar groups windows when it is full."
msgstr ""
"របារ​ភារកិច្ច​អាច​ដាក់​បង្អួច​ដែល​ដូច​គ្នា​ជា​ក្រុមទៅ​​ជា​ប៊ូតុង​តែ​មួយ ។ នៅ​ពេល​ដែល​ប៊ូតុង​ក្រុម​បង្អួច​មួយ​ក្នុង​ចំណោមប៊ូតុង​ក្រុម​​បង្អួច​ទាំង​នេះ​ត្រូវ​បាន​ចុច​​លើ​ម៉ឺនុយ​មួយ ​នោះ​លេច​ឡើង​ដោយ​បង្ហាញ​បង្អួច​ទាំង​អស់​ក្នុង​ក្រុម​នោះ ។ នេះ​អាច​​មាន​​ប្រយោជន៍​ជា​ពិសេសជាមួយជម្រើស <em>បង្ហាញ​បង្អួច​ទាំង​អស់</em> ។\n"
"\n"
"អ្នក​អាច​កំណត់​របារ​ភារកិច្ច​​​ជា <strong>មិន​ដែល</strong> ដាក់​បង្អួច​ជា​ក្រុម  <strong>តែងតែ</strong> ដាក់​បង្អួច​ជា​ក្រុម ឬ ​ដាក់​បង្អួច​ជា​ក្រុម​​តែ​ <strong>នៅ​ពេល​របារ​ភារកិច្ច​ពេញ</strong> ។\n"
"\n"
"តាម​លំនាំដើម​ របារ​ភារកិច្ច​ដាក់​បង្អួច​ជា​ក្រុម​នៅ​ពេល​ដែល​វា​ពេញ ។"

