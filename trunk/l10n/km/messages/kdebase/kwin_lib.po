#: kcommondecoration.cpp:265
msgid ""
"_: %1 is the name of window decoration style\n"
"<center><b>%1 preview</b></center>"
msgstr "<center><b>%1 មើល​ជា​មុន</b></center>"

#: kcommondecoration.cpp:329
msgid "Menu"
msgstr "ម៉ឺនុយ"

#: kcommondecoration.cpp:342 kcommondecoration.cpp:527
msgid "Not on all desktops"
msgstr "គ្មាន​អ្វី​នៅ​លើ​ផ្ទៃ​តុ​ទាំង​អស់"

#: kcommondecoration.cpp:342 kcommondecoration.cpp:528
msgid "On all desktops"
msgstr "នៅ​លើ​ផ្ទៃ​តុ​ទាំង​អស់"

#: kcommondecoration.cpp:364
msgid "Minimize"
msgstr "បង្រួម​អប្បបរមា"

#: kcommondecoration.cpp:376 kcommondecoration.cpp:516
msgid "Maximize"
msgstr "ពង្រីក​អតិបរមា"

#: kcommondecoration.cpp:399 kcommondecoration.cpp:570
msgid "Do not keep above others"
msgstr "កុំ​ដាក់​លើ​គេ"

#: kcommondecoration.cpp:399 kcommondecoration.cpp:570
#: kcommondecoration.cpp:594
msgid "Keep above others"
msgstr "ដាក់​លើ​គេ"

#: kcommondecoration.cpp:412 kcommondecoration.cpp:587
msgid "Do not keep below others"
msgstr "កុំ​ដាក់​ក្រោម​គេ"

#: kcommondecoration.cpp:412 kcommondecoration.cpp:577
#: kcommondecoration.cpp:587
msgid "Keep below others"
msgstr "ដាក់​ក្រោម​គេ"

#: kcommondecoration.cpp:425 kcommondecoration.cpp:539
msgid "Unshade"
msgstr "ដោះ​ស្រមោល"

#: kcommondecoration.cpp:425 kcommondecoration.cpp:540
msgid "Shade"
msgstr "ស្រមោល"

#: kdecoration_plugins_p.cpp:120
msgid "No window decoration plugin library was found."
msgstr "រក​មិន​ឃើញ​បណ្ណាល័យ​កម្មវិធី​ជំនួយ​ខាង​ក្នុងការ​តុបតែង​បង្អួច ។"

#: kdecoration_plugins_p.cpp:145
msgid "The default decoration plugin is corrupt and could not be loaded."
msgstr "កម្មវិធី​ជំនួយ​ខាង​ក្នុងការ​​តុប​តែង​លំនាំ​ដើម​ត្រូវ​ខូច និង មិន​អាច​ផ្ទុក​បាន ។"

#: kdecoration_plugins_p.cpp:159
msgid "The library %1 is not a KWin plugin."
msgstr "បណ្ណាល័យ %1 មិន​មានជា​​កម្មវិធី​ជំនួយ​ខាង​ក្នុង KWin ។"

