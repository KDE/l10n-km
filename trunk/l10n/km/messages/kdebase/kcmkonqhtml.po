msgid "Policy"
msgstr "គោលការណ៍"

#: domainlistview.cpp:55
msgid "&New..."
msgstr "ថ្មី"

#: domainlistview.cpp:59
msgid "Chan&ge..."
msgstr "ផ្លាស់ប្តូរ..."

#: domainlistview.cpp:63
msgid "De&lete"
msgstr "លុប"

#: domainlistview.cpp:67
