msgstr "មិន​រៀបចំ​ URL ដែល​បាន​ផ្ដល់​ឲ្យ"

#: mounthelper/kio_media_mounthelper.cpp:186
msgid "Mount given URL (default)"
msgstr "រៀបចំ​ URL ដែល​បាន​ផ្ដល់​ឲ្យ (លំនាំដើម)"

#: mounthelper/kio_media_mounthelper.cpp:187
msgid "Eject given URL via kdeeject"
msgstr "ច្រាន​ចោល​ URL ដែល​បាន​ផ្ដល់​ឲ្យ​តាម​រយៈ kdeeject"

#: mounthelper/kio_media_mounthelper.cpp:188
msgid "Unmount and Eject given URL (necessary for some USB devices)"
msgstr ""
"មិន​រៀបចំ​ និង​ច្រានចោល​ URL ដែល​បាន​ផ្ដល់​ឲ្យ (ចាំបាច់​សម្រាប់ឧបករណ៍ USB "
"មួយ​ចំនួន)"

#: mounthelper/kio_media_mounthelper.cpp:189
msgid "media:/ URL to mount/unmount/eject/remove"
msgstr "ឧបករណ៍​ផ្ទុក ៖/ URL ត្រូវ​រៀបចំ/​មិន​រៀបចំ/​ច្រាន​ចោល/​យកចេញ"
