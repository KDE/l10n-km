#: kio/KioFonts.cpp:2117
msgid "<p>Only fonts may be installed.</p><p>If installing a fonts package (*%1), then extract the components, and install individually.</p>"
msgstr "<p>មាន​តែ​ពុម្ពអក្សរ​អាច​ត្រូវ​បាន​ដំឡើង ។</p><p>ប្រសិន​បើ​ការ​ដំឡើង​កញ្ចប់​ពុម្ពអក្សរ​មួយ (*%1) បន្ទាប់​មកស្រង់​សមាសភាគ និង​ដំឡើង​ដោយ​ឡែកៗ​ពី​គ្នា ។</p>"

#: kio/KioFonts.cpp:2273
msgid ""
"<p>This font is located in a file alongside other fonts; in order to proceed with the moving they will all have to be moved. The other affected fonts are:</p><ul>%1</ul><p>\n"
" Do you wish to move all of these?</p>"
msgstr ""
"<p>ពុម្ពអក្សរ​នេះ​ត្រូវ​បាន​កំណត់​ទីតាំ​ង​ក្នុង​ឯកសារ​មួយ​ជាមួយ​នឹង​ពុម្ពអក្សរ​ផ្សេងៗ​ទៀត ដើម្បី​ធ្វើ​ជាមួយ​នឹង​ការ​ផ្លាស់​ទី ពួក​វា​​ទាំង​អស់​នឹង​ត្រូវ​តែ​បាន​ផ្លាស់ទី ។ ពុម្ពអក្សរ​ដែល​បាន​ប៉ះពាល់​ផ្សេងៗ​គឺ ៖</p><ul>%1</ul><p>\n"
" តើ​អ្នក​ចង់​ផ្លាស់​ទី​ទាំង​អស់​នេះ​ដែរ​ឬទេ ?</p>"

#: kio/KioFonts.cpp:2278
msgid ""
"<p>This font is located in a file alongside other fonts; in order to proceed with the copying they will all have to be copied. The other affected fonts are:</p><ul>%1</ul><p>\n"
" Do you wish to copy all of these?</p>"
msgstr ""
"<p>ពុម្ពអក្សរ​នេះ​ត្រូវ​បាន​កំណត់ទីតាំង​ក្នុង​ឯកសារ​មួយ​ជាមួយ​នឹង​ពុម្ពអក្សរ​ផ្សេងៗ ដើម្បី​បន្ត​ជាមួយ​ការ​ចម្លង ពួកវា​ទាំង​អស់​ត្រូវ​តែ​បាន​ចម្លង ។ ពុម្ពអក្សរ​ដែល​បាន​ប៉ះពាល់​ផ្សេងៗ​គឺ ៖</p><ul>%1</ul><p>\n"
" តើ​អ្នក​ចង់​ចម្លង​ទាំង​អស់​នេះ​ឬទែ ?</p>"

#: kio/KioFonts.cpp:2282
msgid ""
"<p>This font is located in a file alongside other fonts; in order to proceed with the deleting they will all have to be deleted. The other affected fonts are:</p><ul>%1</ul><p>\n"
" Do you wish to delete all of these?</p>"
msgstr ""
"<p>ពុម្ពអក្សរ​នេះ​ត្រូវ​បាន​កំណត់​ទីតាំង​ក្នុង​ឯកសារ​មួយ​ជាមួយ​នឹង​ពុម្ពអក្សរ​ផ្សេងៗ ដើម្បី​បន្ត​ជាមួយ​ការ​លុប ពួក​វា​ទាំង​អស់​នឹងត្រូវ​តែ​បានលុប​ ។ ពុម្ពអក្សរ​ដែល​បានប៉ះពាល់​ផ្សេងៗ​គឺ ៖</p><ul>%1</ul><p>\n"
" តើ​អ្នក​ចង់​លុប​ទាំង​អស់​នេះ​ដែរឬទេ ?</p>"

