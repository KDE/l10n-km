msgstr "របារ​ឧបករណ៍"

#: fonts.cpp:520
msgid "Menu"
msgstr "ម៉ឺនុយ"

#: fonts.cpp:521
msgid "Window title"
msgstr "ចំណងជើង​បង្អួច"

#: fonts.cpp:522
msgid "Taskbar"
msgstr "របារ​ភារកិច្ច"

#: fonts.cpp:523
msgid "Desktop"
msgstr "ផ្ទៃតុ"

#: fonts.cpp:557
msgid "Used for normal text (e.g. button labels, list items)."
msgstr "ប្រើ​សម្រាប់​អត្ថបទ​ធម្មតា ( ឧទាហរណ៍ ស្លាក​ប៊ូតុង ធាតុ​បញ្ជី) ។"

#: fonts.cpp:558
msgid "A non-proportional font (i.e. typewriter font)."
msgstr "ពុម្ព​អក្សរ​គ្មាន​សមាមាត្រ (មាន​ន័យថា ពុម្ពអក្សរអង្គុលីលេខ) ។"

#: fonts.cpp:559
msgid "Used to display text beside toolbar icons."
msgstr "ប្រើ​ដើម្បី​បង្ហាញ​អត្ថបទ​ក្បែរ​រូបតំណាង​របារ​ឧបករណ៍ ។"

#: fonts.cpp:560
msgid "Used by menu bars and popup menus."
msgstr "បាន​ប្រើ​ដោយ​របារ​ម៉ឺនុយ និង​ម៉ឺនុយ​លេចឡើង ។"

#: fonts.cpp:561
msgid "Used by the window titlebar."
msgstr "បាន​ប្រើ​ដោយ​របារ​ចំណងជើង​បង្អួច ។"

#: fonts.cpp:562
msgid "Used by the taskbar."
msgstr "បាន​ប្រើ​ដោយ​របារ​ភារកិច្ច ។"

#: fonts.cpp:563
msgid "Used for desktop icons."
msgstr "ប្រើ​សម្រាប់​រូបតំណាង​ផ្ទៃតុ ។"

#: fonts.cpp:614
msgid "Ad&just All Fonts..."
msgstr "លៃ​តម្រូវ​ពុម្ពអក្សរ​ទាំងអស់..."

#: fonts.cpp:615
msgid "Click to change all fonts"
msgstr "ចុច​ដើម្បី​ប្តូរ​ពុម្ពអក្សរ​ទាំងអស់"

#: fonts.cpp:622
msgid "Use a&nti-aliasing for fonts"
msgstr "ប្រើ​ការ​ប្រឆាំង​រឆេតរឆូត​សម្រាប់​ពុម្ពអក្សរ"

#: fonts.cpp:623
msgid ""
"If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr ""
"បើ​ជម្រើស​នេះ​ត្រូវ​បាន​ជ្រើស KDE នឹង​ធ្វើ​ឲ្យ​គែម​កំណោង​ពុម្ពអក្សរ​រលោង ។"

#: fonts.cpp:626
msgid "Configure..."
msgstr "កំណត់​រចនាសម្ព័ន្ធ..."

#: fonts.cpp:714
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"<p>អ្នក​បាន​ប្តូរ​ការ​កំណត់​ដែល​ទាក់ទង​នឹង​ការ​ប្រឆាំង​រឆេតរឆូត ។ "
"ការ​ផ្លាស់ប្តូរ​នេះ​នឹង​មាន​ឥទ្ធិពល​តែ​លើ​កម្មវិធី​ដែល​ទើប​ចាប់ផ្តើម​ថ្មីៗ ។​</p"
">"

#: fonts.cpp:715
msgid "Anti-Aliasing Settings Changed"
msgstr "ការ​កំណត់​ការ​ប្រឆាំង​រឆេតរឆូត​ត្រូវ​បាន​ផ្លាស់ប្តូរ"

