#  i18n: file componentchooser_ui.ui line 46
#: rc.cpp:19
#, no-c-format
msgid "Here you can change the component program. Components are programs that handle basic tasks, like the terminal emulator, the text editor and the email client. Different KDE applications sometimes need to invoke a console emulator, send a mail or display some text. To do so consistently, these applications always call the same components. You can choose here which programs these components are."
msgstr "ទីនេះ អ្នក​អាច​ប្តូរ​កម្មវិធី​​សមាសភាគ ។ សមាសភាគជា​កម្មវិធី​ដែល​គ្រប់គ្រង​ភារកិច្ច​មួលដ្ឋាន ដូចជា វត្ថុ​ត្រាប់​តាម​ស្ថានីយ កម្មវិធី​និពន្ធ​អត្ថបទ និងកម្មវិធី​អ៊ីម៉ែល ។ ​ជួនកាលកម្មវិធី KDE ផ្សេង​ត្រូវ ហៅ​វត្ថុ​ត្រាប់​តាម​កុងសូល  ផ្ញើ​សំបុត្រ ឬ បង្ហាញ​អត្ថបទ​ខ្លះៗ ។ ដើម្បី​ធ្វើ​ដូច្នេះ​ដោយ​ងាយ​ស្រួល​ កម្មវិធី​ទាំងនេះ​តែងតែ​ហៅ​សមាសភាគ​ដូចគ្នា ។ អ្នក​អាច​ជ្រើស​ទីនេះ​នូវ​កម្មវិធី​ដែល​ជារបស់​សមាសភាគ​ទាំងនេះ ។"

#  i18n: file componentchooser_ui.ui line 75
#: rc.cpp:22
#, no-c-format
msgid "Component Description"
msgstr "ពិពណ៌នា​សមាសភាគ"

#  i18n: file componentchooser_ui.ui line 78
#: rc.cpp:25
#, no-c-format
msgid "Here you can read a small description of the currently selected component. To change the selected component, click on the list to the left. To change the component program,  please choose it below."
msgstr "ទីនេះ​អ្នក​អាច​អាន​ពិពណ៌នា​ខ្លីមួយ​អំពី​សមាសភាគ​ដែល​បាន​ជ្រើស​បច្ចុប្បន្ន ។ ដើម្បី​ប្តូរ​សមាសភាគ​ដែល​បាន​ជ្រើស ចុច​លើ​បញ្ជី​ខាង​ឆ្វេង ។ ដើម្បី​ប្តូរ​កម្មវិធី​សមាសភាគ សូម​ជ្រើស​វា​ខាង​ក្រោម ។"

#  i18n: file componentchooser_ui.ui line 119
#: rc.cpp:29
#, no-c-format
msgid ""
"<qt>\n"
"<p>This list shows the configurable component types. Click the component you want to configure.</p>\n"
"<p>In this dialog you can change KDE default components. Components are programs that handle basic tasks, like the terminal emulator, the text editor and the email client. Different KDE applications sometimes need to invoke a console emulator, send a mail or display some text. To do so consistently, these applications always call the same components. Here you can select which programs these components are.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>បញ្ជី​នេះ​បង្ហាញ​ប្រភេទ​សមាសភាគ​ដែល​អាច​កំណត់​រចនាសម្ព័ន្ធ​បាន ។ ចុច​លើ​សមាសភាគ​ដែល​អ្នក​ចង់​កំណត់​រចនាសម្ព័ន្ធ ។</p>\n"
"<p>ក្នុង​ប្រអប់​នេះ អ្នក​អាច​ប្តូរ​សមាសភាគ​លំនាំដើម KDE ។ សមាសភាគ ជា​កម្មវិធី​ដែល​គ្រប់គ្រង​ភារកិច្ច​មួលដ្ឋាន ដូចជា វត្ថុ​ត្រាប់​តាម​ស្ថានីយ កម្មវិធី​និពន្ធ​អត្ថបទ និងកម្មវិធី​អ៊ីម៉ែល ។ ​ជួនកាលកម្មវិធី KDE ផ្សេង​ត្រូវ ហៅ​វត្ថុ​ត្រាប់​តាម​កុងសូល ផ្ញើ​សំបុត្រ ឬ បង្ហាញ​អត្ថបទ​ខ្លះៗ ។ ដើម្បី​ធ្វើ​ដូច្នេះ​ដោយ​ងាយ​ស្រួល​ កម្មវិធី​ទាំងនេះ​តែងតែ​ហៅ​សមាសភាគ​ដូចគ្នា ។ អ្នក​អាច​ជ្រើស​ទីនេះ​នូវ​កម្មវិធី​ដែល​ជារបស់​សមាសភាគ​ទាំងនេះ ។</p>\n"
"</qt>"

#  i18n: file emailclientconfig_ui.ui line 83
#: rc.cpp:37
#, no-c-format
msgid "<ul> <li>%t: Recipient's address</li> <li>%s: Subject</li> <li>%c: Carbon Copy (CC)</li> <li>%b: Blind Carbon Copy (BCC)</li> <li>%B: Template body text</li> <li>%A: Attachment </li> </ul>"
msgstr "<ul> <li>%t ៖ អាសយដ្ឋាន​អ្នក​ទទួល</li> <li>%s ៖ ប្រធានបទ</li> <li>%c ៖ ចម្លង</li> <li>%b ៖ លាក់</li> <li>%B ៖ អត្តបទ​តួពុម្ព</li> <li>%A ៖ ឯកសារ​ភ្ជាប់ </li> </ul>"

#  i18n: file emailclientconfig_ui.ui line 86
#: rc.cpp:40
#, no-c-format
msgid "Press this button to select your favorite email client. Please note that the file you select has to have the executable attribute set in order to be accepted.<br> You can also use several placeholders which will be replaced with the actual values when the email client is called:<ul> <li>%t: Recipient's address</li> <li>%s: Subject</li> <li>%c: Carbon Copy (CC)</li> <li>%b: Blind Carbon Copy (BCC)</li> <li>%B: Template body text</li> <li>%A: Attachment </li> </ul>"
msgstr "ចុច​ប៊ូតុង​នេះ​ដើម្បី​ជ្រើស​ស្ថានីយ​សំណព្វ​របស់​អ្នក ។ សូម​ចំណាំថា ដើម្បី​ទទួល​យកបាន ឯកសារ​ដែល​អ្នក​បាន​ជ្រើស​ត្រូវ​តែ​មាន​​​គុណលក្ខណៈ​ដែល​អាច​ប្រតិបត្តិ​បាន និង​ដែល​ត្រូវ​បាន​តម្រៀប​តាម​លំដាប់​ ។ អ្នក​អាច​ប្រើ​កន្លែង​ដាក់​ច្រើន​ ដែល​នឹង​ត្រូវ​បាន​ជំនួស​ដោយ​តម្លៃ​ពិត​ ពេល​ហៅ​កម្មវិធី​អ៊ីម៉ែល ៖<ul> <li>%t ៖ អាសយដ្ឋាន​អ្នក​ទទួល</li> <li>%s ៖ ប្រធានបទ</li> <li>%c ៖ ចម្លង</li> <li>%b ៖ លាក់</li> <li>%B ៖ អត្តបទ​តួពុម្ព</li> <li>%A ៖ ឯកសារ​ភ្ជាប់ </li> </ul>"

