#: mounthelper/kio_devices_mounthelper.cpp:96
msgid ""
"\n"
"Please check that the disk is entered correctly."
msgstr ""
"\n"
"សូម​ពិនិត្យ​ថា ថាស​ត្រូវ​បាន​បញ្ចូល​យ៉ាង​ត្រឹម​ត្រូវ ។"

#: mounthelper/kio_devices_mounthelper.cpp:109
msgid "Unmount given URL"
msgstr "មិន​បាន​រៀបចំ​ URL ដែល​បាន​ផ្ដល់​ឲ្យ"

#: mounthelper/kio_devices_mounthelper.cpp:110
msgid "Mount given URL (default)"
msgstr "រៀបចំ​ URL ដែល​បាន​ផ្ដល់​ឲ្យ (លំនាំដើម)"

#: mounthelper/kio_devices_mounthelper.cpp:111
msgid "Eject given URL via kdeeject"
msgstr "ច្រាន​ចោល​ URL ដែល​បាន​ផ្ដល់​ឲ្យ​តាម​រយៈ kdeeject"

#: mounthelper/kio_devices_mounthelper.cpp:112
msgid "devices:/ URL to mount/unmount/eject"
msgstr "ឧបករណ៍ ៖/ URL ដើម្បី​រៀប​ចំ/មិន​រៀបចំ/ច្រាន​ចោល"

#: kio_devices.cc:123
msgid "This device name already exists"
msgstr "ឈ្មោះ​ឧបករណ៍​នេះ​មាន​រួច​ហើយ"

#: kio_devices.cc:147
#, c-format
msgid "Unknown device %1"
msgstr "មិន​ស្គាល់​ឧបករណ៍ %1"

#: kio_devices.cc:168
msgid "Device not accessible"
msgstr "ឧបករណ៍​មិន​អាច​ចូល​ដំណើរ​ការ​បាន"

#: kio_devices.cc:183
msgid "Device not mounted"
msgstr "ឧបករណ៍​មិន​បាន​រៀប​ចំ"

#: kio_devices.cc:197
msgid "Illegal data received"
msgstr "បាន​ទទួល​ទិន្នន័យ​មិន​ត្រឹម​ត្រូវ"

#: kio_devices.cc:209
msgid "System"
msgstr "ប្រព័ន្ធ"

#: kio_devices.cc:211
msgid "Devices"
msgstr "ឧបករណ៍"

#: kio_devices.cc:459
msgid ""
"The KDE mountwatcher is not running. Please activate it in Control "
"Center->KDE Components->Service Manager, if you want to use the devices:/ "
"protocol"
msgstr "ឧបករណ៍​តាមដាន​ការ​រៀបចំ​របស់ KDE មិន​កំពុង​រត់ ។ សូម​ធ្វើ​ឲ្យ​វា​សកម្ម​ក្នុង​មជ្ឈមណ្ឌល​បញ្ជា->សមាសភាគ​ KDE->កម្មវិធី​គ្រប់​គ្រង​សេវា ប្រសិនបើ​អ្នក​ចង់​ប្រើ​ឧបករណ៍ ៖/ ពិធីការ"

