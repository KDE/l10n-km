#  i18n: file kcmlayoutwidget.ui line 62
#. i18n: file kcmlayoutwidget.ui line 62
#: rc.cpp:6
#, no-c-format
msgid "&Enable keyboard layouts"
msgstr "អនុញ្ញាត​ប្លង់​ក្ដារ​ចុច"

#  i18n: file kcmlayoutwidget.ui line 76
#. i18n: file kcmlayoutwidget.ui line 76
#: rc.cpp:10
#, no-c-format
msgid ""
"<h1>Keyboard Layout</h1> Here you can choose your keyboard layout and model. "
"The 'model' refers to the type of keyboard that is connected to your computer, "
"while the keyboard layout defines \"which key does what\" and may be different "
"for different countries."
msgstr ""
"<h1>ប្លង់​ក្ដារចុច</h1> នៅ​ទីនេះ​អ្នក​អាច​ជ្រើស​ប្លង់​ក្ដារចុច​ "
"និង​គំរូ​របស់​អ្នក ។ 'គំរូ' "
"សំដៅលើ​ប្រភេទ​របស់​ក្ដារ​ចុច​ដែល​ត្រូវ​បាន​តភ្ជាប់​ទៅ​កុំព្យូទ័រ​របស់​អ្នក "
"ខណៈ​ពេល​ប្លង់​ក្ដារ​ចុច​កំណត់ \"គ្រាប់​ចុច​មួយ​ណា​ធ្វើ​អ្វី\" "
"និង​អាច​ខុស​គ្នា​សម្រាប់​ប្រភេទ​ខុសៗគ្នា ។"

#  i18n: file kcmlayoutwidget.ui line 95
#. i18n: file kcmlayoutwidget.ui line 95
#: rc.cpp:13
#, no-c-format
msgid "Available layouts:"
msgstr "ប្លង់​ដែល​អាច​រក​បាន ៖"

#  i18n: file kcmlayoutwidget.ui line 103
#. i18n: file kcmlayoutwidget.ui line 103
#: rc.cpp:16
#, no-c-format
msgid "Active layouts:"
msgstr "ប្លង់​សកម្ម ៖"

#  i18n: file kcmlayoutwidget.ui line 111
#. i18n: file kcmlayoutwidget.ui line 111
#: rc.cpp:19
#, no-c-format
msgid "Keyboard &model:"
msgstr "គំរូ​ក្ដារ​ចុច ៖"

#  i18n: file kcmlayoutwidget.ui line 131
#. i18n: file kcmlayoutwidget.ui line 131
#: rc.cpp:22
#, no-c-format
msgid ""
"Here you can choose a keyboard model. This setting is independent of your "
"keyboard layout and refers to the \"hardware\" model, i.e. the way your "
"keyboard is manufactured. Modern keyboards that come with your computer usually "
"have two extra keys and are referred to as \"104-key\" models, which is "
"probably what you want if you do not know what kind of keyboard you have.\n"
msgstr ""
"នៅ​ទីនេះ​អ្នក​អាច​ជ្រើស​គំរូ​ក្ដារ​ចុច​មួយ ។ "
"ការ​កំណត់​នេះ​គឺ​ឯករាជ្យ​​នៃ​ប្លង់​ក្ដារ​ចុច​របស់​អ្នក​ និង​សំដៅ​លើ​គំរូ "
"\"ផ្នែក​រឹង\" ឧ. មធ្យោបាយ​ដែល​ក្ដារ​ចុច​របស់​អ្នក​ត្រូវ​បាន​បង្កើត ។ "
"ក្ដារចុច​ដែល​មាន​ជាមួយ​កុំព្យូទ័រ​របស់​អ្នក​តាម​​ធម្មតា​មាន​គ្រាប់​ចុច​បន្ថែម​ពី"
"រ​ និង​ត្រូវ​បាន​សំដៅ​ទៅ​គំរូ \"គ្រាប់​ចុច 104\" "
"ដែល​ប្រហែល​ជា​អ្វី​ដែល​អ្នក​ចង់​បាន​ "
"ប្រសិន​បើអ្នក​មិន​ដឹង​​ប្រភេទក្ដារ​ចុច​អ្វី​ដែល​អ្នក​​មាន ។\n"

#  i18n: file kcmlayoutwidget.ui line 142
#. i18n: file kcmlayoutwidget.ui line 142
#: rc.cpp:26
#, no-c-format
msgid "Include latin layout"
msgstr "រួម​ទាំង​ប្លង់​ឡាតាំង"

#  i18n: file kcmlayoutwidget.ui line 145
#. i18n: file kcmlayoutwidget.ui line 145
#: rc.cpp:29
#, no-c-format
msgid ""
"If after you switch to this layout some keyboard shortcuts based on latin keys "
"do not work try to enable this option."
msgstr ""
"ប្រសិន​បើ​បន្ទាប់​ពី​អ្នក​ប្ដូរ​ទៅ​ប្លង់​នេះ "
"ផ្លូវកាត់​ក្ដារចុច​មួយ​ចំនួន​ដែល​បាន​ផ្អែក​លើ​គ្រាប់​ចុច​ឡាតាំង​មិន​ព្យាយាម​អនុញ"
"្ញាត​ជម្រើស​នេះ ។"

#  i18n: file kcmlayoutwidget.ui line 173
#. i18n: file kcmlayoutwidget.ui line 173
#: rc.cpp:36 rc.cpp:61
#, no-c-format
msgid "Keymap"
msgstr "ផែនទី​គ្រាប់​ចុច"

#  i18n: file kcmlayoutwidget.ui line 189
#. i18n: file kcmlayoutwidget.ui line 189
#: rc.cpp:39
#, no-c-format
msgid ""
"If more than one layout is present in this list, the KDE panel will offer a "
"docked flag. By clicking on this flag you can easily switch between layouts. "
"The first layout will be default one."
msgstr ""
"ប្រសិន​បើ​មាន​ប្លង់​ច្រើន​ជាង​មួយ​គឺ​ថ្មី​ក្នុង​បញ្ជី​នេះ ស្លាប​ព្រិល​ KDE "
"នឹង​ផ្ដល់​ទង់​ដែល​បាន​ចូល​ផែ​មួយ ។ ដោយ​ចុច​លើ​ទង់​នេះ​​ "
"អ្នក​អាច​ប្ដូរ​រវាង​ប្លង់​ទាំងនេះ​យ៉ាង​ងាយ ។ "
"ប្លង់​ទី​មួយ​នឹង​​ជា​ប្លង់​លំនាំ​ដើម​ ។​"

#  i18n: file kcmlayoutwidget.ui line 205
#. i18n: file kcmlayoutwidget.ui line 205
#: rc.cpp:42
#, no-c-format
msgid "Layout variant:"
msgstr "ប្លង់​ផ្សេងៗ ៖"

#  i18n: file kcmlayoutwidget.ui line 217
#. i18n: file kcmlayoutwidget.ui line 217
#: rc.cpp:45
#, no-c-format
msgid ""
"Here you can choose a variant of selected keyboard layout. Layout variants "
"usually represent different key maps for the same language. For example, "
"Ukrainian layout might have four variants: basic, winkeys (as in Windows), "
"typewriter (as in typewriters) and phonetic (each Ukrainian letter is placed on "
"a transliterated latin one).\n"
msgstr ""
"នៅ​ទីនេះ​អ្នក​អាច​ជ្រើស​ប្លង់​ក្ដារ​ចុច​ដែល​បានជ្រើស​ផ្សេងៗ ។ "
"ប្លង់​ផ្សេងៗ​តាម​ធម្មតា​តំណាង​ឲ្យ​ផែនទី​គ្រាប់​សម្រាប់​ភាសា​ដូច​គ្នា ។ ឧទាហរណ៍ "
"ប្លង់​អ៊ុយ​ក្រែន​អាច​មាន​ប្លង់​ផ្សេងៗ​ចំនួន​បួន ៖ មូលដ្ឋាន winkeys (ដូច​ក្នុង "
"Windows) ម៉ាស៊ីន​អង្គុលីលេខ (ដូច​ក្នុង​ម៉ាស៊ីន​អង្គុលីលេខ) និង​សូរសព្ទ "
"(អក្សរ​អ៊ុយក្រែន​នីមួយៗ​ត្រូវ​បាន​ដាក់​លើ​អក្សរ​ឡាតាំង​ដែល​បាន​សរសេរ​ជា​ភាសា​មួយ"
"​) ។\n"

