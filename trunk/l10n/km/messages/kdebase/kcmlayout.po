#: kcmlayout.cpp:796
msgid "Group Shift/Lock behavior"
msgstr "ឥរិយាបថ​ក្រុមគ្រាប់​ចុច​ ប្ដូរ (Shift)/ចាក់​សោ"

#: kcmlayout.cpp:797
msgid "R-Alt switches group while pressed"
msgstr "គ្រាប់​ចុច​ឆ្លាស់ (R-Alt) ប្ដូរ​ក្រុម​ខណៈ​ពេល​ចុច"

#: kcmlayout.cpp:798
msgid "Right Alt key changes group"
msgstr "គ្រាប់​ចុច​ឆ្លាស់ (Right Alt) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:799
msgid "Caps Lock key changes group"
msgstr "គ្រាប់​ចុចប្ដូរ​ជាប់ (Caps Lock) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:800
msgid "Menu key changes group"
msgstr "គ្រាប់​ចុច​ម៉ឺនុយ​ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:801
msgid "Both Shift keys together change group"
msgstr "គ្រាប់​ចុច​ប្ដូរ​ (Shift) ទាំង​ពីរ​រួម​គ្នា​ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:802
msgid "Control+Shift changes group"
msgstr "គ្រាប់​ចុច​បញ្ជា (Ctrl)+ប្ដូរ (Shift) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:803
msgid "Alt+Control changes group"
msgstr "គ្រាប់​ជំនួស (Alt)+បញ្ជា (Ctrl) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:804
msgid "Alt+Shift changes group"
msgstr "គ្រាប់​ចុច​ជំនួស (Alt)+បញ្ជា (Shift) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:805
msgid "Control Key Position"
msgstr "ទីតាំង​គ្រាប់​ចុច​បញ្ជា (Ctrl)"

#: kcmlayout.cpp:806
msgid "Make CapsLock an additional Control"
msgstr "បង្កើត​គ្រាប់ចុច​ ប្ដូរ​ជាប់ ជា​វត្ថុ​វត្ថុ​បញ្ជា​បន្ថែម"

#: kcmlayout.cpp:807
msgid "Swap Control and Caps Lock"
msgstr "ដូរ​គ្រាប់​ចុច​បញ្ជា (Ctrl) និងប្ដូរ​ជាប់ (Caps Lock)"

#: kcmlayout.cpp:808
msgid "Control key at left of 'A'"
msgstr "គ្រាប់​ចុច​បញ្ជា (Ctrl) នៅ​ខាង​ឆ្វេង 'A'"

#: kcmlayout.cpp:809
msgid "Control key at bottom left"
msgstr "គ្រាប់​ចុច​បញ្ជា (Ctrl) ​នៅ​បាត​ខាង​ឆ្វេង"

#: kcmlayout.cpp:810
msgid "Use keyboard LED to show alternative group"
msgstr "ប្រើ​ក្ដារ​ចុច​ LED ដើម្បី​បង្ហាញ​ក្រុម​ជំនួស"

#: kcmlayout.cpp:811
msgid "Num_Lock LED shows alternative group"
msgstr "Num_Lock LED បង្ហាញ​ក្រុម​ជំនួស"

#: kcmlayout.cpp:812
msgid "Caps_Lock LED shows alternative group"
msgstr "Caps_Lock LED បង្ហាញ​ក្រុម​ជំនួស"

#: kcmlayout.cpp:813
msgid "Scroll_Lock LED shows alternative group"
msgstr "Scroll_Lock LED បង្ហាញ​ក្រុម​​ជំនួស"

#: kcmlayout.cpp:816
msgid "Left Win-key switches group while pressed"
msgstr "គ្រាប់​ចុច​ Left Win ប្ដូរ​ក្រុម​ខណៈ​ពេល​ចុច"

#: kcmlayout.cpp:817
msgid "Right Win-key switches group while pressed"
msgstr "គ្រាប់​ចុច​ Right Win ប្ដូរ​ក្រុម​ខណៈពេល​ចុច"

#: kcmlayout.cpp:818
msgid "Both Win-keys switch group while pressed"
msgstr "គ្រាប់​ចុច​ Win ទាំង​ពីរ​រួម​គ្នា​ប្ដូរ​ក្រុម​ខណៈ​ពេល​ចុច"

#: kcmlayout.cpp:819
msgid "Left Win-key changes group"
msgstr "គ្រាប់​ចុច​ Left Win ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:820
msgid "Right Win-key changes group"
msgstr "គ្រាប់​ចុច​ Right Win ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:821
msgid "Third level choosers"
msgstr "វត្ថុ​ជ្រើស​កម្រិត​ទី ៣"

#: kcmlayout.cpp:822
msgid "Press Right Control to choose 3rd level"
msgstr "ចុច​គ្រាប់​ចុច​បញ្ជាស្ដាំ (Right Ctrl) ដើម្បី​ជ្រើស​កម្រិត​ទី ៣"

#: kcmlayout.cpp:823
msgid "Press Menu key to choose 3rd level"
msgstr "ចុច​គ្រាប់​ចុច​ម៉ឺនុយ (Menu Key) ​ដើម្បី​ជ្រើស​កម្រិត​ទី ៣"

#: kcmlayout.cpp:824
msgid "Press any of Win-keys to choose 3rd level"
msgstr "ចុច​គ្រាប់​ចុច Win ណាមួយ ដើម្បី​ជ្រើស​កម្រិត​ទី ៣"

#: kcmlayout.cpp:825
msgid "Press Left Win-key to choose 3rd level"
msgstr "ចុច​គ្រាប់​ចុច​ Left Win ដើម្បី​ជ្រើស​កម្រិត​ទី ៣"

#: kcmlayout.cpp:826
msgid "Press Right Win-key to choose 3rd level"
msgstr "ចុច​គ្រាប់​ចុច​ Right Win ដើម្បី​ជ្រើស​កម្រិត​ទី ៣"

#: kcmlayout.cpp:827
msgid "CapsLock key behavior"
msgstr "ឥរិយាបថ​គ្រាប់​ចុច​ប្ដូរ​ជាប់ (CapsLock)"

#: kcmlayout.cpp:828
msgid "uses internal capitalization. Shift cancels Caps."
msgstr ""
"ប្រើ​ការ​សរសេរ​ជា​អក្សរ​ធំ​ខាង​ក្នុង ។ គ្រាប់​ចុច​ប្ដូរ (Shift) "
"បោះបង់​គ្រាប់​ចុច ​​ប្ដូរ​ជាប់ (Caps) ។"

#: kcmlayout.cpp:829
msgid "uses internal capitalization. Shift doesn't cancel Caps."
msgstr ""
"ប្រើ​ការ​សរសេរជា​អក្សរ​ខាង​ក្នុង ។ គ្រាប់​ចុច​ប្ដូរ (Shift) មិន​បោះបង់ "
"ប្ដូរ​ជាប់ (Caps) ។​"

#: kcmlayout.cpp:830
msgid "acts as Shift with locking. Shift cancels Caps."
msgstr ""
"ធ្វើ​ជា​​គ្រាប់​ប្ដូរ (Shift) ជាមួយ​ការ​ចាក់​សោ ។ គ្រាប់​ចុច​ប្ដូរ (Shift) "
"បោះបង់ ប្ដូរ​ជាប់ (Caps) ។"

#: kcmlayout.cpp:831
msgid "acts as Shift with locking. Shift doesn't cancel Caps."
msgstr ""
"ដើរ​តួជា​​គ្រាប់​ចុច​ប្ដូរ (Shift) ជាមួយ​ការ​ចាក់សោ ។ គ្រាប់​ចុច​ប្ដូរ (Shift) "
"មិន​បោះបង់ ប្ដូរ​ជាប់ (Caps) ។"

#: kcmlayout.cpp:832
msgid "Alt/Win key behavior"
msgstr "ឥរិយាបថ​គ្រាប់​ចុច​ (Alt/Win)"

#: kcmlayout.cpp:833
msgid "Add the standard behavior to Menu key."
msgstr "បន្ថែម​ឥរិយាបថ​ខ្នាត​គំរូ​ទៅ​គ្រាប់​ចុច​ម៉ឺនុយ ។"

#: kcmlayout.cpp:834
msgid "Alt and Meta on the Alt keys (default)."
msgstr "ជំនួស (Alt) និង Meta នៅ​លើ​គ្រាប់​ចុច​ជំនួស (Alt) (លំនាំដើម) ។"

#: kcmlayout.cpp:835
msgid "Meta is mapped to the Win-keys."
msgstr "Meta ត្រូវ​បាន​កំណត់​​ទៅ​គ្រាប់​ចុច​ Win ។"

#: kcmlayout.cpp:836
msgid "Meta is mapped to the left Win-key."
msgstr "Meta ត្រូវ​បាន​កំណត់​ទៅ​គ្រាប់​ចុច​​ Win ឆ្វេង (left Win) ។"

#: kcmlayout.cpp:837
msgid "Super is mapped to the Win-keys (default)."
msgstr "Super ត្រូវ​បាន​កំណត់​ទៅ​គ្រាប់​ចុច Win (លំនាំដើម) ។"

#: kcmlayout.cpp:838
msgid "Hyper is mapped to the Win-keys."
msgstr "Hyper ត្រូវ​បាន​កំណត់​ទៅ​គ្រាប់​ចុច​ Win ។"

#: kcmlayout.cpp:839
msgid "Right Alt is Compose"
msgstr "គ្រាប់​ចុច​ឆ្លាស់​ (Right Alt) គឺ​តែង"

#: kcmlayout.cpp:840
msgid "Right Win-key is Compose"
msgstr "គ្រាប់​ចុច​ Win ស្ដាំ​ (Right Win) គឺ​តែង"

#: kcmlayout.cpp:841
msgid "Menu is Compose"
msgstr "ម៉ឺនុយ​គឺ​តែង"

#: kcmlayout.cpp:844
msgid "Both Ctrl keys together change group"
msgstr "គ្រាប់​ចុច​បញ្ជា (Ctrl) ទាំង​ពីរ​រួម​គ្នា​ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:845
msgid "Both Alt keys together change group"
msgstr "គ្រាប់​ចុចជំនួស​ (Alt) ទាំង​ពីររួម​គ្នា​ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:846
msgid "Left Shift key changes group"
msgstr "គ្រាប់​ចុច​ប្ដូរ​ឆ្វេង (Left Shift) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:847
msgid "Right Shift key changes group"
msgstr "គ្រាប់​ចុច​ប្ដូរ​ស្ដាំ (Right Shift) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:848
msgid "Right Ctrl key changes group"
msgstr "គ្រាប់​ចុច​បញ្ជា​ស្ដាំ (Right Ctrl) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:849
msgid "Left Alt key changes group"
msgstr "គ្រាប់​ចុច​ជំនួស (Left Alt) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:850
msgid "Left Ctrl key changes group"
msgstr "គ្រាប់ចុច​បញ្ជា​ឆ្វេង​ (Left Ctrl) ផ្លាស់​ប្ដូរ​ក្រុម"

#: kcmlayout.cpp:851
msgid "Compose Key"
msgstr "គ្រាប់​ចុច​តែង"

#: kcmlayout.cpp:854
msgid "Shift with numpad keys works as in MS Windows."
msgstr ""
"គ្រាប់​ប្ដូរ​ (Shift) ជា​មួយ​គ្រាប់​ចុច​លេខ​ធ្វើ​ការ​ដូច​ក្នុង MS Windows ។"

#: kcmlayout.cpp:855
msgid "Special keys (Ctrl+Alt+<key>) handled in a server."
msgstr ""
"គ្រាប់​ចុច​ពិសេស (បញ្ជា(Ctrl)+ជំនួស(Alt)+<key>) "
"បាន​គ្រប់​គ្រង​ក្នុង​ក្នុង​ម៉ាស៊ីន​បម្រើ​មួយ ។"

#: kcmlayout.cpp:856
msgid "Miscellaneous compatibility options"
msgstr "ជម្រើស​ភាព​ឆប​គ្នា​ផ្សេងៗ"

#: kcmlayout.cpp:857
msgid "Right Control key works as Right Alt"
msgstr ""
"គ្រាប់​ចុច​បញ្ជា​ស្ដាំ (Right Ctrl) ធ្វើ​ការ​ដូច​គ្រាប់​ចុច​ឆ្លាស់ (Right Alt)"

#: kcmlayout.cpp:860
msgid "Right Alt key switches group while pressed"
msgstr "គ្រាប់​ចុច​ឆ្លាស់ (Right Alt) ប្ដូរ​ក្រុម​ខណៈ​ពេល​ចុច"

#: kcmlayout.cpp:861
msgid "Left Alt key switches group while pressed"
msgstr "គ្រាប់​ចុច​ជំនួស (Left Alt) ប្ដូរ​ក្រុម​ខណៈ​ពេល​ចុច"

#: kcmlayout.cpp:862
msgid "Press Right Alt-key to choose 3rd level"
msgstr "ចុច​គ្រាប់​ចុច​ឆ្លាស់ (Right Alt) ដើម្បីជ្រើស​កម្រិត​ទី ៣"

