#: ktrash.cpp:30
msgid "Empty the contents of the trash"
msgstr "សំអាត​មាតិកា​របស់​ធុង​សំរាម"

#: ktrash.cpp:32
msgid "Restore a trashed file to its original location"
msgstr "ស្ដារ​ឯកសារ​​ដែល​បាន​ដាក់​ក្នុង​ធុង​សំរាម​ទៅ​ទីតាំង​ដើម​របស់​វា"

#: ktrash.cpp:34
msgid "Ignored"
msgstr "មិនអើពើ"

#: ktrash.cpp:42
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:43
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kfmclient move "
"'url' trash:/\""
msgstr ""
"កម្មវិធី​​ជំនួយ​​ដើម្បី​ដោះស្រាយ​ធុង​សំរាម​របស់​ KDE\n"
"ចំណាំ ៖ ដើម្បី​ផ្លាស់ទី​ឯកសារ​ទៅ​ធុង​សំរាម​ កុំប្រើ ktrash ប៉ន្ដែ \"kfmclient ផ្លាស់​ទីធុង​សំរាម "
"'url ៖/\""

#: kio_trash.cpp:46
msgid "Protocol name"
msgstr "ឈ្មោះ​ពិធីការ"

#: kio_trash.cpp:47 kio_trash.cpp:48
msgid "Socket name"
msgstr "ឈ្មោះ​រុន្ធ"

#: kio_trash.cpp:97 kio_trash.cpp:160 kio_trash.cpp:317 kio_trash.cpp:349
#: kio_trash.cpp:505 kio_trash.cpp:517
#, c-format
msgid "Malformed URL %1"
msgstr "URL មិន​ប្រក្រតី %1"

#: kio_trash.cpp:116
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr "ថត %1 គ្មាន​​អ្វី​ទេ ដូច្នេះ​វា​មិន​អាច​ស្ដារ​ធាតុ​នេះ​ទៅ​ទីតាំង​ដើម​របស់​វាឡើងវិញ​បានទេ ។ អ្នក​អាច​បង្កើត​ថត​នោះ និង​ប្រើ​ប្រតិបត្តិការ​ស្ដារ​ឡើងវិញ​ម្ដង​ទៀត ឬ អូស​ធាតុ​ពី​កន្លែង​ផ្សេង​​ដើម្បី​ស្ដារ​វា​ឡើង​វិញ ។"

#: kio_trash.cpp:145
msgid "This file is already in the trash bin."
msgstr "ឯកសារ​នេះ​នៅ​ក្នុង​ធុង​សំរាម​រួច​ហើយ ។"

