#: knewthemedlg.cpp:28
msgid "New Theme"
msgstr "ស្បែក​​ថ្មី"

#: kthememanager.cpp:49
msgid "KDE Theme Manager"
msgstr "កម្មវិធី​គ្រប់គ្រងស្បែក KDE"

#: kthememanager.cpp:50 kthememanager.cpp:56
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr ""
"ម៉ូឌុល​បញ្ជា​នេះ​ដោះស្រាយ​រាល់​ការ​ដំឡើង, យកចេញ និង​បង្កើតស្បែក KDE "
"ដែល​មើល​ឃើញ ។"

#: kthememanager.cpp:203
msgid "Theme Files"
msgstr "ឯកសារ​ស្បែក"

#: kthememanager.cpp:204
msgid "Select Theme File"
msgstr "ជ្រើស​​ឯកសារស្បែក"

#: kthememanager.cpp:238
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "តើ​អ្នក​ពិត​ជា​ចង់​យក​ស្បែក <b>%1</b> ចេញ​ឬ ?"

#: kthememanager.cpp:239
msgid "Remove Theme"
msgstr "យក​ស្បែក​​ចេញ"

#: kthememanager.cpp:261
msgid "My Theme"
msgstr "ស្បែក​​របស់​ខ្ញុំ"

#: kthememanager.cpp:272
msgid "Theme %1 already exists."
msgstr "ស្បែក %1 មាន​រួច​ហើយ ។"

#: kthememanager.cpp:292
#, c-format
msgid "Your theme has been successfully created in %1."
msgstr "ស្បែក​​របស់​អ្នក​​បាន​បង្កើត​ដោយ​ជោគជ័យ​ក្នុង %1 ។"

#: kthememanager.cpp:293
msgid "Theme Created"
msgstr "ស្បែក​​ត្រូវ​បាន​បង្កើត"

#: kthememanager.cpp:295
msgid "An error occurred while creating your theme."
msgstr "កំហុស​មួយ​បាន​កើតឡើង ខណៈ​ពេល​បង្កើត​ស្បែក​​របស់​អ្នក ។"

#: kthememanager.cpp:296
msgid "Theme Not Created"
msgstr "មិន​បាន​បង្កើត​ស្បែក​ឡើយ"

#: kthememanager.cpp:323
msgid "This theme does not contain a preview."
msgstr "ស្បែក​នេះ​មិន​មាន​ទិដ្ឋភាព​សម្រាប់​មើល​ជាមុន​ឡើយ ។"

#: kthememanager.cpp:328
msgid "Author: %1<br>Email: %2<br>Version: %3<br>Homepage: %4"
msgstr "អ្នក​និពន្ធ ៖ %1<br>អ៊ីម៉ែល ៖ %2<br>កំណែ ៖ %3<br>គេហទំព័រ ៖ %4"

