#  i18n: file cssconfig.ui line 125
#: rc.cpp:27
#, no-c-format
msgid "<b>Use accessibility stylesheet defined in &quot;Customize&quot;-tab</b><p>Selecting this option will allow you to define a default font, font size, and font color with a few simple clicks of the mouse. Simply wander over to the Customize tab and pick out your desired options.</p>"
msgstr "<b>ប្រើសន្លឹក​រចនាប័ទ្មភាព​ចូល​ដំណើរការ​ដែល​បាន​កំណត់​ក្នុង សញ្ញា​សម្រង់ សញ្ញាសម្រង់​ប្តូរ​តាម​បំណង ​ផ្ទាំង</b><p>ការ​ជ្រើស​ជម្រើស​នេះ​នឹង​អនុញ្ញាត​ឲ្យ​អ្នក​កំណត់​ពុម្ពអក្សរ​លំនាំដើម ទំហំ​ពុម្ព​អក្សរ និង​ពណ៌​ពុម្ពអក្សរដោយ​ចុច​កណ្ដុរ​ពីរ​បី​ដង ។ គ្រាន់តែ​ចូល​ទៅ​កាន់​ផ្ទាំង​​ប្តូរ​តាម​បំណង និង​ជ្រើស​ជម្រើស​តាម​បំណង​របស់​អ្នក ។</p>"

