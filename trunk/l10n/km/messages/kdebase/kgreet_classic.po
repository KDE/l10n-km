#: kgreet_classic.cpp:97
msgid "&Username:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: kgreet_classic.cpp:102
msgid "Username:"
msgstr "ឈ្មោះ​អ្នក​ប្រើ ៖"

#: kgreet_classic.cpp:124
msgid "&Password:"
msgstr "ពាក្យ​សម្ងាត់ ៖"

#: kgreet_classic.cpp:125
msgid "Current &password:"
