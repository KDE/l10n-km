#: kvaio.cpp:158
msgid "Memory Stick inserted"
msgstr "Memory Stick បាន​បញ្ចូល"

#: kvaio.cpp:161
msgid "Memory Stick ejected"
msgstr "Memory Stick បាន​បញ្ចេញ"

#: kvaio.cpp:170
msgid "Unhandled event: "
msgstr "ព្រឹត្តិការណ៍​មិន​បាន​ដោះស្រាយ ៖"

#: kvaio.cpp:387
msgid "AC Connected"
msgstr "ចរន្ត​ឆ្លាស់​បាន​ត​ភ្ជាប់"

#: kvaio.cpp:387
msgid "AC Disconnected"
msgstr "ចរន្ត​ឆ្លាស់​បាន​ផ្ដាច់"

#: kvaio.cpp:393
msgid "Battery is Fully Charged. "
msgstr "ថ្ម​បាន​សាក​ពេញ ។ "

#: kvaio.cpp:400
msgid "Caution: Battery is Almost Empty (%1% remaining)."
msgstr "ប្រយ័ត្ន ៖ ថ្ម​ជិត​អស់ (នៅសល់ %1%) ។"

#: kvaio.cpp:403
msgid "Alert: Battery is Empty!"
msgstr "ព្រមាន ៖ ថ្ម​អស់ !"

#: kvaio.cpp:406
msgid "No Battery Inserted."
msgstr "មិន​បាន​បញ្ចូល​ថ្ម ។"

#: kvaio.cpp:409
msgid "Remaining Battery Capacity: %1%"
msgstr "សមាសភាព​ថ្ម​ដែល​នៅ​សល់ ៖ %1%"

#: kvaio.cpp:434 kvaio.cpp:447
msgid "Brightness"
msgstr "ពន្លឺ"

#: kvaio.cpp:455
msgid "Volume"
msgstr "កម្រិត​សម្លេង"

#: kvaio.cpp:481 kvaio.cpp:548
msgid "Starting KMix..."
msgstr "កំពុង​ចាប់ផ្ដើម KMix..."

#: kvaio.cpp:500 kvaio.cpp:571
msgid "It seems that KMix is not running."
msgstr "វា​ហាក់​ដូច​ជា KMix មិន​កំពុង​រត់​ទេ ។"

#: kvaio.cpp:592
msgid "Mute on"
msgstr "បើក​ស្ងាត់"

#: kvaio.cpp:595
msgid "Mute off"
msgstr "បិទ​ស្ងាត់"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr ""
"កែវ សុផុន, ខឹម សុខែម, លៀង ជុំសុបិន្ត, សាន ទិត្យវិរៈ, សិទ្ធ ចាន់រត្ថា, ហុក "
"កក្កដា"

