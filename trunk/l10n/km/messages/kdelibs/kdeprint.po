"<li> Gamma:     1000 </li> </ul>  </p>  </qt>"
msgstr ""
" <qt>  <p><b>កំណត់​ទៅ​តម្លៃ​លំនាំ​ដើម​ឡើងវិញ</b> </p>  <p> កំណត់​ការ​កំណត់​ពណ៌​ទាំង​អស់​ទៅ​តម្លៃ​លំនាំ​ដើម​ឡើងវិញ ។ តម្លៃ​លំនាំ​ដើម​គឺ ៖  <ul>  <li> ពន្លឺ ៖១០០"
"</li> <li> ភាព​ព្រឿងៗ (ពណ៌​ព្រឿង) ។   0 </li> <li> តិត្ថិភាព ៖ ១០០ </li> <li> ហ្គាម៉ា ៖     "
"១០០០ </li> </ul>  </p>  </qt>"

#: cups/kpimagepage.cpp:222
msgid ""
" <qt>  "
"<p><b>Image Positioning:</b></p>  "
