#: kfile/kpropertiesdialog.cpp:1658
msgid "Specifies the actions that the members of the group are allowed to do."
msgstr "បញ្ជាក់​អំពី​សកម្មភាព​ដែល​សមាជិក​របស់​ក្រុម​មាន​សិទ្ធិ​ធ្វើ ។"

#: kfile/kpropertiesdialog.cpp:1660
msgid "O&thers:"
msgstr "ផ្សេងទៀត ៖"

#: kfile/kpropertiesdialog.cpp:1666
msgid ""
"Specifies the actions that all users, who are neither owner nor in the "
"group, are allowed to do."
msgstr "បញ្ជាក់​អំពើ​ដែល​អ្នក​ប្រើ​ទាំងអស់ ទាំង​អ្នក​មិន​មែន​ជា​ម្ចាស់ ឬ ស្ថិត​នៅក្រុម អាចធ្វើ ។​"

#: kfile/kpropertiesdialog.cpp:1671
msgid "Only own&er can rename and delete folder content"
