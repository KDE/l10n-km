msgstr "បញ្ចូល​ពាក្យ​សម្ងាត់​របស់​ពាក្យ​សម្ងាត់ ៖"

#: kio/tcpslavebase.cpp:674
msgid "SSL Certificate Password"
msgstr "ពាក្យ​សម្ងាត់​វិញ្ញាបនបត្រ SSL"

#: kio/tcpslavebase.cpp:687
msgid "Unable to open the certificate. Try a new password?"
msgstr "មិន​អាច​បើក​វិញ្ញាបនបត្រ ។ សាកល្បង​ពាក្យ​សម្ងាត់​ថ្មី​ ?"

#: kio/tcpslavebase.cpp:700
msgid "The procedure to set the client certificate for the session failed."
msgstr "បែប​បទ​កំណត់​វិញ្ញាបនបត្រ​របស់​ម៉ាស៊ីន​ភ្ញៀវ សម្រាប់​សម័យ​នេះ​ បាន​បរាជ័យ ។"

#: kio/tcpslavebase.cpp:854
msgid ""
"The IP address of the host %1 does not match the one the certificate was "
"issued to."
msgstr "អាសយដ្ឋាន IP របស់​កុំព្យូទ័រ %1 មិន​ដូច​ទៅ​នឹង​អាសយដ្ឋាន IP ដែល​បាន​ទទួល​វិញ្ញាបនបត្រ ។​"

