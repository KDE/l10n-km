#: about/aboutpage.cpp:175
#, fuzzy, kde-format
#| msgid ""
#| "<br><b>To</b> edit project data, different views and editors can be "
#| "selected in the View Selector docker.<br><b>The</b> views are generally "
#| "used to inspect data after the project has been scheduled. No data will "
#| "appear in the views if the project has not been scheduled. Scheduling is "
#| "done in the Schedules editor.<br><b>You</b> can edit attributes in the "
#| "various editors by selecting the item you want to edit (doubleclick or "
#| "press F2), or open a dialog using the context menu.</ul>"
msgid ""
"<br/><b>To</b> edit project data, different views and editors can be "
"selected in the View Selector docker.<br/><b>The</b> views are generally "
"used to inspect data after the project has been scheduled. No data will "
"appear in the views if the project has not been scheduled. Scheduling is "
"done in the Schedules editor.<br/><b>You</b> can edit attributes in the "
"various editors by selecting the item you want to edit (doubleclick or press "
"F2), or open a dialog using the context menu.</ul>"
msgstr ""
"<br><b>ដើម្បី​</b> កែ​សម្រួល​ទិន្នន័យ​គម្រោង​ ទិដ្ឋភាព និង​កម្មវិធី​កែ​សម្រួល​ផ្សេង​ៗ​អាច​ត្រូវ​បាន​ជ្រើស​​នៅ​ក្នុង​"
"កម្មវិធី​ចូល​ផែ​របស់​កម្មវិធី​ជ្រើស​ទិដ្ឋភាព ។<br><b>ទិដ្ឋ​ភាព​</b> ​ជា​ទូទៅ​ត្រូវ​បាន​គេ​ប្រើ​សម្រាប់​ការត្រួត​"
"ពិនិត្យ​ទិន្នន័យ​ បន្ទាប់​ពី​បាន​កំណត់​ពេល​របស់​គម្រោង​ហើយ​ ។ នឹង​គ្មាន​ទិន្នន័យ​ណា​មួយ​បង្ហាញ​នៅ​ក្នុង​ទិដ្ឋភាព​ទេ បើសិន​"
"ជា​គម្រោង​មិន​ត្រូវ​បាន​គេ​កំណត់​ពេល​ ។ ការ​កំណត់​ពេល​ត្រូវ​បាន​ធ្វើ​រួច​ហើយ​នៅ​ក្នុង​កម្មវិធី​កែ​សម្រួល​កាល​វិភាគ ។"
"<br><b>​អ្នក​</b> ​អាច​កែ​សម្រួល​គុណលក្ខណៈ​នៅ​ក្នុង​កម្មវិធី​កែ​សម្រួល​ផ្សេង​ៗ​ ដោយ​ជ្រើស​យក​ធាតុ​ដែល​អ្នក​ចង់​កែ​"
"សម្រួល​ (ចុច​ទ្វេដង ឬ​ចុច​ F2) ឬ​បើក​ប្រអប់ ដោយ​ប្រើ​ម៉ឺនុយ​បរិបទ ។</ul>"

