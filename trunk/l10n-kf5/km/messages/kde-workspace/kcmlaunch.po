msgstr "ទស្សន៍​ទ្រនិច​ជាប់​រវល់​អកម្ម"

#: kcmlaunch.cpp:70
#, kde-format
msgid "Blinking Cursor"
msgstr "ទស្សន៍​ទ្រនិច​លោត​ភ្លឹប​ភ្លែតៗ"

#: kcmlaunch.cpp:71
#, kde-format
msgid "Bouncing Cursor"
msgstr "ទស្សន៍​ទ្រនិច​លោត"

#: kcmlaunch.cpp:78
#, kde-format
msgid "&Startup indication timeout:"
msgstr "ពេល​សម្រាក​ជូន​ដំណឹង​ពេល​ចាប់ផ្ដើម ៖"

#: kcmlaunch.cpp:82 kcmlaunch.cpp:114
#, kde-format
