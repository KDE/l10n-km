#, kde-format
msgctxt "@info:status"
msgid "Cannot move root maildir folder '%1'."
msgstr "មិនអាច​ផ្លាស់ទី​ថត root maildir '%1' បាន​ទេ ។"

#: mixedmaildirresource.cpp:398
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "មិន​អាច​លុប​ថត maildir កម្រិត​កំពូល​ '%1' បាន​ទេ ។"

#: mixedmaildirresource.cpp:412
#, kde-format
msgctxt "@info:status"
