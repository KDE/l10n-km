#: mixedmaildirresource.cpp:421
msgctxt "@info:status"
msgid "No usable storage location configured."
msgstr "គ្មាន​ទីតាំង​ផ្ទុក​ដែលអាច​ប្រើ​បាន​ត្រូវ​បាន​កំណត់​រចនាសម្ព័ន្ធ​ទេ ។"

#. i18n: ectx: label, entry (Path), group (General)
#: mixedmaildirresource.kcfg:10
msgid "Path to KMail mail folder"
msgstr "ផ្លូវ​ទៅកាន់​ថត​សំបុត្រ KMail"

#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: mixedmaildirresource.kcfg:14
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr "ចំណុច​ផ្លូវ​ទៅកាន់​ថត​ដែល​មាន​ Maildirs ជំនួស​ឲ្យទៅ​កាន់ maildir ខ្លួន​វា ។"

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: mixedmaildirresource.kcfg:18
msgid "Do not change the actual backend data."
msgstr "កុំ​ផ្លាស់ប្ដូរ​ទិន្នន័យ​កម្មវិធី​ខាង​ក្រោយ​ពិតប្រាកដ ។"

