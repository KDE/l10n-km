#: jobs.cpp:287
msgid "Unable to create POP3 slave, aborting mail check."
msgstr "មិនអាច​បង្កើត​ POP3 slave បាន​ទេ បោះបង់​ការ​ពិនិត្យ​មើល​សំបុត្រ ។"

#: pop3resource.cpp:107
msgid "Mail check aborted."
msgstr "បាន​បោះបង់​ការ​ពិនិត្យ​មើល​សំបុត្រ ។"

#: pop3resource.cpp:113
msgid "Mail check was canceled manually."
msgstr "កា​រពិនិត្យ​មើល​សំបុត្រ​ត្រូវ​បាន​បោះបង់​ដោយដៃ ។"

#: pop3resource.cpp:146
#, kde-format
msgid "Please enter the username and password for account '%1'."
msgstr "សូម​បញ្ចូល​ឈ្មោះ​អ្នកប្រើ និង​ពាក្យសម្ងាត់​សម្រាប់​គណនី '%1' ។"

#: pop3resource.cpp:172
msgid ""
"You are asked here because the password could not be loaded from the wallet."
msgstr "អ្នក​ត្រូវ​បាន​សួរ​នៅ​ទីនេះ ពីព្រោះ​ពាក្យ​សម្ងាត់​មិន​អាច​ត្រូវ​បាន​ផ្ទុក​ពី​កាបូប​ទេ ។"

#: pop3resource.cpp:211
msgid "Account:"
msgstr "គណនី ៖"

#: pop3resource.cpp:228
msgid "No username and password supplied."
msgstr "គ្មាន​ឈ្មោះ​អ្នកប្រើ និង​ពាក្យ​សម្ងាត់​បាន​ផ្ដល់​ទេ ។"

#: pop3resource.cpp:251
#, kde-format
msgid "Preparing transmission from \"%1\"."
msgstr "រៀបចំ​បញ្ជូន​ពី \"%1\" ។"

#: pop3resource.cpp:278
msgid "Executing precommand."
msgstr "ប្រតិបត្តិ​ពាក្យ​បញ្ជា ។"

#: pop3resource.cpp:310
msgid "You are asked here because the previous login was not successful."
msgstr "អ្នក​ត្រូវ​បាន​សួរ​នៅ​ទីនេះ ពីព្រោះ​ការ​ចូល​ពី​លើក​មុន​មិន​ជោគជ័យ​ឡើយ ។"

#: pop3resource.cpp:312
msgid "You are asked here because the username you supplied is empty."
msgstr "អ្នក​ត្រូវ​បាន​សួរ​នៅ​ទីនេះ ពីព្រោះ​ឈ្មោះ​អ្នកប្រើ​ដែល​អ្នក​ផ្ដល់​គឺ​ទទេ ។"

#: pop3resource.cpp:314
msgid "You are asked here because the wallet password storage is disabled."
msgstr "អ្នក​ត្រូវ​បាន​សួរ​នៅ​ទីនេះ ពីព្រោះ​ពាក្យ​សម្ងាត់​មិន​អាច​ត្រូវ​បាន​ផ្ទុក​ពី​កាបូប​ទេ ។​"

#: pop3resource.cpp:348
msgid "Fetching mail listing."
msgstr "ទៅយក​បញ្ជី​សំបុត្រ​រួម ។"

#: pop3resource.cpp:407
msgid "Saving downloaded messages."
msgstr "រក្សាទុក​សារ​ដែលបាន​ទាញយក ។"

#: pop3resource.cpp:422
msgid "Deleting messages from the server."
msgstr "លុប​សារ​ពី​ម៉ាស៊ីនបម្រើ ។"

#: pop3resource.cpp:450
msgid "Saving password to the wallet."
msgstr "រក្សាទុក​ពាក្យ​សម្ងាត់​ទៅកាន់​កាបូប ។"

#: pop3resource.cpp:468
msgid "Error while trying to get the local inbox folder, aborting mail check."
msgstr "កំហុស​ខណៈពេលព្យាយាម​យក​ថត​ប្រអប់​​ទទួល​មូលដ្ឋាន​ បោះបង់​ការ​ពិនិត្យ​សំបុត្រ ។"

#: pop3resource.cpp:474
#, kde-format
msgid ""
"<qt>The folder you deleted was associated with the account <b>%1</b> which "
"delivered mail into it. The folder the account delivers new mail into was "
"reset to the main Inbox folder.</qt>"
msgstr ""
"<qt>ថត​ដែល​អ្នក​បាន​លុប​ត្រូវ​បាន​ភ្ជាប់​ជា​មួយ​គណនី <b>%1</b> ដែល​បាន​បញ្ចូល​សំបុត្រ​ឲ្យ​វា ។ ថត​ដែល​គណនី​"
"បញ្ជូន​សំបុត្រ​ថ្មី​ទៅ​ត្រូវ​បាន​កំណត់​ជា​ថត​ប្រអប់​ទទួល​មេ ។</qt>"

#: pop3resource.cpp:494
msgid ""
"Error while trying to get the folder for incoming mail, aborting mail check."
msgstr "កំហុស​ខណៈ​ពេល​ព្យាយាម​យក​ថត​សម្រាប់​សំបុត្រ​ចូល បោះបង់​ការ​ពិនិត្យ​សំបុត្រ ។"

#: pop3resource.cpp:507
msgid "Could not find folder for incoming mail, aborting mail check."
msgstr "មិន​អាច​រក​ថត​សម្រាប់​សំបុត្រ​ចូល​បានទេ បោះបង់​ការ​ពិនិត្យ​សំបុត្រ ។"

#: pop3resource.cpp:519
msgid "Error while executing precommand."
msgstr "កំហុស​ ខណៈ​ពេល​ប្រតិបត្តិ​​មុន​ពាក្យ​បញ្ជា​"

#: pop3resource.cpp:534
#, kde-format
msgid "Unable to login to the server %1."
msgstr "មិន​អាច​ចូល​​ទៅ​កាន់​ម៉ាស៊ីន​បម្រើ​ %1 បាន​ទេ ។"

#: pop3resource.cpp:545
msgid "Error while getting the list of messages on the server."
msgstr "កំហុស​ខណៈ​ពេល​យក​បញ្ជី​សារ​នៅ​លើ​ម៉ាស៊ីន​បម្រើ ។"

#: pop3resource.cpp:560
msgid "Error while getting list of unique mail identifiers from the server."
msgstr "កំហុស​ខណៈ​ពេល​យក​បញ្ជី​របស់​ឧបករណ៍​សម្គាល់​អត្តសញ្ញាណ​​សំបុត្រ​តែ​មួយ​គត់​ពី​ម៉ាស៊ីន​បម្រើ ។"

#: pop3resource.cpp:575
#, kde-format
msgid ""
"Your POP3 server (Account: %1) does not support the UIDL command: this "
"command is required to determine, in a reliable way, which of the mails on "
"the server KMail has already seen before;\n"
"the feature to leave the mails on the server will therefore not work "
"properly."
msgstr ""
"ម៉ាស៊ីន​បម្រើ POP3 របស់​អ្នក (គណនី ៖ %1) មិន​គាំទ្រ​ពាក្យ​បញ្ជា UIDL ៖ ពាក្យ​បញ្ជា​នេះ​ត្រូ​វបាន​ទាមទារ​"
"ឲ្យ​កំណត់ នៅ​​ក្នុង​វិធីដែលអាច​ទុកចិត្ត​បាន ដែលសំបុត្រ​នៅ​លើ​ម៉ាស៊ីនបម្រើ KMail បាន​ឃើញ​រួច​ហើយ​ពីមុន\n"
"លក្ខណពិសេស​ គឺ​ត្រូវទុក​សំបុត្រ​នៅ​លើ​ម៉ាស៊ីន​បម្រើ​ ដូច្នេះ​នឹង​មិន​ដំណើរការ​ត្រឹមត្រូវ​ទេ ។"

#: pop3resource.cpp:589
msgid "Error while fetching mails from the server."
msgstr "កំហុស​ខណៈពេល​ទៅយក​សំបុត្រ​​ពី​ម៉ាស៊ីន​បម្រើ ។"

#: pop3resource.cpp:658
#, kde-format
msgid ""
"Fetching message %1 of %2 (%3 of %4 KB) for %5 (%6 KB remain on the server)."
msgstr "ទៅ​យក​សារ %1 នៃ %2 (%3 នៃ %4 KB) សម្រាប់ %5 (នៅ​សល់​ %6 គីឡូបៃ​នៅ​លើ​ម៉ាស៊ីន​បម្រើ) ។"

#: pop3resource.cpp:666
#, kde-format
msgid "Fetching message %1 of %2 (%3 of %4 KB) for %5"
msgstr "ទៅ​យក​សារ %1 នៃ %2 (%3 នៃ %4 KB) សម្រាប់ %5"

#: pop3resource.cpp:687
msgid "Unable to store downloaded mails."
msgstr "មិន​អាច​រក្សា​​ទុក​សំបុត្រ​ដែល​ទាញ​យក​បាន​ទេ ។"

#: pop3resource.cpp:818
msgid "Failed to delete the messages from the server."
msgstr "បាន​បរាជ័យ​ក្នុងការ​លុប​សារ​ពី​ម៉ាស៊ីន​បម្រើ ។"

#: pop3resource.cpp:858
msgid "Finished mail check, no message downloaded."
msgstr "បាន​បញ្ចប់​ការ​ពិនិត្យ​មើល​សំបុត្រ គ្មានសារ​ត្រូវ​​ទាញយកទេ"

#: pop3resource.cpp:860
#, kde-format
msgid "Finished mail check, 1 message downloaded."
msgid_plural "Finished mail check, %1 messages downloaded."
msgstr[0] "បាន​បញ្ចប់​ការ​ពិនិត្យ​សារ បាន​ទាញ​យកសារ %1 ។"

#: pop3resource.cpp:870
msgid "Unable to complete the mail fetch."
msgstr "មិនអាច​បញ្ចប់​ការ​ទៅយក​សំបុត្រ​នេះ​បាន​ទេ ។"

#: pop3resource.cpp:1008
msgid "Mail check already in progress, unable to start a second check."
msgstr "កំពុង​ពិនិត្យ​មើល​សំបុត្រ​ហើយ មិន​អាច​ចាប់ផ្ដើម​ពិនិត្យ​ជាលើក​ទីពីរ​បាន​ទេ ។"

#: pop3resource.cpp:1030
msgid "Ready"
msgstr "រួចហើយ"

#: pop3resource.cpp:1033
msgid "Mail check aborted after going offline."
msgstr "បាន​បោះបង់​ការ​ពិនិត្យ​មើល​សំបុត្រ បន្ទាប់​ពី​ទៅ​ក្រៅ​បណ្ដាញ ។"

#: pop3resource.cpp:1035
msgid "Offline"
msgstr "ក្រៅ​បណ្ដាញ"

#. i18n: ectx: property (text), widget (QLabel, titleLabel)
#: popsettings.ui:23
msgid "Account Type: POP Account"
msgstr "ប្រភេទ​គណនី ៖ គណនី POP"

#. i18n: ectx: attribute (title), widget (QWidget, page1)
#: popsettings.ui:46
msgid "General"
msgstr "ទូទៅ"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_4)
#: popsettings.ui:65
msgid "Mail Checking Options"
msgstr "ជម្រើស​ពិនិត្យ​មើល​សំបុត្រ"

#. i18n: ectx: property (toolTip), widget (QCheckBox, intervalCheck)
#: popsettings.ui:71
msgid ""
"If active, the POP3 account will be checked for new mail every x minutes"
msgstr "ប្រសិនបើ​សកម្ម គណនី POP3 នឹង​ត្រូវ​បាន​ពិនិត្យ​មើល​សំបុត្រ​ថ្មី​រៀងរាល់ x នាទី"

#. i18n: ectx: property (text), widget (QCheckBox, intervalCheck)
#: popsettings.ui:74
msgid "Enable &interval mail checking"
msgstr "បើក​ចន្លោះ​ពេល​ពិនិត្យ​មើល​សំបុត្រ"

#. i18n: ectx: property (text), widget (QLabel, intervalLabel)
#: popsettings.ui:83
msgid "Check mail interval:"
msgstr "ចន្លោះពេល​ពិនិត្យ​មើល​សំបុត្រ ៖"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: popsettings.ui:108
msgid "Account Information"
msgstr "ព័ត៌មាន​គណនី"

#. i18n: ectx: property (whatsThis), widget (QLabel, label_2)
#. i18n: ectx: property (whatsThis), widget (KLineEdit, loginEdit)
#: popsettings.ui:117 popsettings.ui:179
msgid ""
"Your Internet Service Provider gave you a <em>user name</em> which is used "
"to authenticate you with their servers. It usually is the first part of your "
"email address (the part before <em>@</em>)."
msgstr ""
"ក្រុមហ៊ុន​ផ្ដល់សេវា​អ៊ីនធឺណិត​របស់​អ្នក​បាន​ផ្ដល់​ឲ្យ​​អ្នក​នូវ <em>ឈ្មោះ​អ្នកប្រើ</em> ដែល​ត្រូវ​បាន​ប្រើ​ដើម្បី​"
"ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​របស់​អ្នក​ជា​មួយ​នឹង​ម៉ាស៊ីន​បម្រើ​របស់​ពួកគេ ។ តាម​ធម្មតា​ វា​ជា​ផ្នែកដំបូង​របស់​នៃ​"
"អាសយដ្ឋាន​អ៊ីមែល​របស់​អ្នក (ផ្នែកខាង​មុខ <em>@</em>) ។"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: popsettings.ui:120
msgid "Account &name:"
msgstr "ឈ្មោះ​គណនី ៖"

#. i18n: ectx: property (toolTip), widget (KLineEdit, nameEdit)
#: popsettings.ui:130
msgid "Name displayed in the list of accounts"
msgstr "ឈ្មោះ​បានបង្ហាញ​នៅ​ក្នុង​បញ្ជី​គណនី"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, nameEdit)
#: popsettings.ui:133
msgid "Account name: This defines the name displayed in the account list."
msgstr "ឈ្មោះគណនី ៖ វា​កំណត់​ឈ្មោះ​ដែលបានបង្ហាញ​នៅ​ក្នុង​បញ្ជីគណនី ។"

#. i18n: ectx: property (text), widget (QLabel, label_5)
#: popsettings.ui:143
msgid "Incoming mail &server:"
msgstr "ម៉ាស៊ីនបម្រើ​សំបុត្រ​ចូល ៖"

#. i18n: ectx: property (toolTip), widget (KLineEdit, hostEdit)
#: popsettings.ui:153
msgid "Address of the mail POP3 server"
msgstr "អាសយដ្ឋាន​របស់​ម៉ាស៊ីន​បម្រើ​សំបុត្រ POP3"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, hostEdit)
#: popsettings.ui:156
msgid ""
"The address of the POP3 server, e.g. pop3.yourprovider.org. You should get "
"this address from your mail provider."
msgstr ""
"អាសយដ្ឋាន​របស់​ម៉ាស៊ីន​បម្រើ POP3 ឧ. pop3.yourprovider.org ។ អ្នក​គួរ​ទទួល​អាសយដ្ឋាន​នេះ​ពី​ក្រុមហ៊ុន​"
"ផ្ដល់​អ៊ីមែល​របស់​អ្នក ។"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: popsettings.ui:166
msgid "Username:"
msgstr "ឈ្មោះ​អ្នកប្រើ ៖"

#. i18n: ectx: property (toolTip), widget (KLineEdit, loginEdit)
#: popsettings.ui:176
msgid "The username that identifies you against the mail server"
msgstr "ឈ្មោះអ្នកប្រើ​ដែល​កំណត់​​អត្តសញ្ញាណ​របស់​អ្នក​ប្រឆាំង​នឹង​ម៉ាស៊ីន​បម្រើសំបុត្រ"

#. i18n: ectx: property (text), widget (QLabel, passwordLabel)
#: popsettings.ui:189
msgid "P&assword:"
msgstr "ពាក្យសម្ងាត់ ៖"

#. i18n: ectx: property (toolTip), widget (KLineEdit, passwordEdit)
#: popsettings.ui:199
msgid "Password for access to the mail server"
msgstr "ពាក្យ​សម្ងាត់​សម្រាប់​ចូលដំណើរការ​ទៅកាន់ម៉ាស៊ីនបម្រើ​សំបុត្រ"

#. i18n: ectx: property (whatsThis), widget (KLineEdit, passwordEdit)
#: popsettings.ui:202
msgid "Password: The password given to you by your mail provider."
msgstr "ពាក្យ​សម្ងាត់ ៖ ពាក្យ​សម្ងាត់​ដែលបានផ្ដល់​​ឲ្យ​អ្នក​ដោយ​ក្រុមហ៊ុនផ្ដល់​អ៊ីមែល​របស់​អ្នក ។"

#. i18n: ectx: attribute (title), widget (QWidget, page2)
#: popsettings.ui:219
msgid "Advanced"
msgstr "កម្រិត​ខ្ពស់"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_5)
#: popsettings.ui:225
msgid "POP Settings"
msgstr "ការ​កំណត់ POP"

#. i18n: ectx: property (toolTip), widget (QCheckBox, leaveOnServerCheck)
#: popsettings.ui:231
msgid "If checked the message is not deleted from the mail server"
msgstr "ប្រសិន​បើ​បាន​គូស​ធីក សារ​មិន​ត្រូវ​បាន​លុប​ពី​ម៉ាស៊ីន​បម្រើ​សំបុត្រ​ទេ"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, leaveOnServerCheck)
#: popsettings.ui:234
msgid ""
"Check this option if you want to fetch only copies of the mails and leave "
"the original mails on the server."
msgstr ""
"គូស​ធីក​ជម្រើស​នេះ ប្រសិនបើ​អ្នក​ចង់​ទៅ​យក​តែ​ច្បាប់​ចម្លង​របស់​សំបុត្រ ហើយ​ទុក​សំបុត្រ​ដើម​នៅ​លើ​ម៉ាស៊ីន​បម្រើ ។"

#. i18n: ectx: property (text), widget (QCheckBox, leaveOnServerCheck)
#: popsettings.ui:237
msgid "Lea&ve fetched messages on the server"
msgstr "ទុក​សារ​ដែលបានទៅយក​នៅ​លើ​ម៉ាស៊ីន​បម្រើ"

#. i18n: ectx: property (toolTip), widget (QCheckBox, leaveOnServerDaysCheck)
#: popsettings.ui:250
msgid "The original message is deleted from the server after x days"
msgstr "សារ​ដើម​ត្រូវ​បានលុប​ពី​ម៉ាស៊ីនបម្រើបន្ទាប់​ពី​រយៈពេល  x ថ្ងៃ"

#. i18n: ectx: property (text), widget (QCheckBox, leaveOnServerDaysCheck)
#: popsettings.ui:253
msgid "Days to leave messages on the server:"
msgstr "ចំនួន​ថ្ងៃ​ត្រូវ​ទុកសារ​នៅ​លើ​ម៉ាស៊ីនបម្រើ ៖"

#. i18n: ectx: property (toolTip), widget (QCheckBox, leaveOnServerCountCheck)
#: popsettings.ui:276
msgid "Only the x most recent messages are kept on the server"
msgstr "ទុក​តែ​សារ​ថ្មីៗ​បំផុត x នៅ​លើ​ម៉ាស៊ីនបម្រើ"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, leaveOnServerCountCheck)
#: popsettings.ui:279
msgid ""
"Check this option if you want to only keep the x most recent messages on the "
"server and delete all older."
msgstr ""
"គូស​ធីក​ជម្រើស​នេះ ប្រសិនបើ​អ្នក​ចង់​ទុក​តែ​សារ​ដែល​ថ្មីៗ​បំផុត x នៅ​លើ​ម៉ាស៊ីន​បម្រើ ហើយ​លុប​​សារ​ចាស់​ទាំងអស់ ។"

#. i18n: ectx: property (text), widget (QCheckBox, leaveOnServerCountCheck)
#: popsettings.ui:282
msgid "Number of messages to keep:"
msgstr "ចំនួនសារ​ដែល​ត្រូវ​ទុក ៖"

#. i18n: ectx: property (toolTip), widget (QCheckBox, leaveOnServerSizeCheck)
#: popsettings.ui:305
msgid "Keep most recent messages within the quota and delete oldest"
msgstr "ទុកសារ​ថ្មីៗ​បំផុត​នៅ​ក្នុង​កូតា ហើយលុប​សារ​ដែល​ចាស់បំផុត"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, leaveOnServerSizeCheck)
#: popsettings.ui:308
msgid ""
"If active, most recent messages are kept until the quota is reached and "
"oldest messages are deleted."
msgstr "ប្រសិនបើ​សកម្ម សារ​ថ្មីៗ​បំផុត​ត្រូ​វបាន​ទុក​រហូត​ដល់​ពេញកូតា ហើយ​សារ​ចាស់ៗ​ត្រូ​វបាន​លុប ។"

#. i18n: ectx: property (text), widget (QCheckBox, leaveOnServerSizeCheck)
#: popsettings.ui:311
msgid "Maximum megabytes to keep:"
msgstr "មេកាបៃ​អតិបរមា​ត្រូវ​រក្សាទុក ៖"

#. i18n: ectx: property (suffix), widget (QSpinBox, leaveOnServerSizeSpin)
#: popsettings.ui:330
msgid " MB"
msgstr "មេកាបៃ"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, filterOnServerCheck)
