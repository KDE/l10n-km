msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ខឹម សុខែម, អេង វណ្ណៈ, អោក ពិសិដ្ឋ"

msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "khoemsokhem@khmeros.info,​​evannak@khmeros.info,piseth_dv@khmeros.info"

#: main.cpp:52
msgid "Run Plasma widgets in their own window"
msgstr "រត់​ធាតុក្រាហ្វិក​ប្លាស្មា​នៅ​ក្នុង​បង្អួច​ផ្ទាល់​របស់​ពួកវា"

#: main.cpp:103
msgid "No description available"
msgstr "មិន​មាន​សេចក្ដីពិពណ៌​នា"

#: main.cpp:120
msgid "Plasma Widget Viewer"
msgstr "កម្មវិធី​មើល​ធាតុក្រាហ្វិក​ប្លាស្មា"

#: main.cpp:122
msgid "2007-2008, Frerich Raabe"
msgstr "រក្សាសិទ្ធិ ២០០៧-២០០៨ ដោយ Frerich Raabe"

#: main.cpp:124
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:125
msgid "Original author"
msgstr "អ្នកនិពន្ធ​ដើម"

#: main.cpp:132
msgid "Name of the containment plugin"
msgstr "ឈ្មោះ​របស់​កម្មវិធី​ជំនួយ​ឧបករណ៍​ផ្ទុក"

#: main.cpp:134
#, fuzzy
#| msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
#| msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid ""
"The formfactor to use (horizontal, vertical, mediacenter, planar or "
"application)"
msgstr "formfactor ត្រូវ​ប្រើ (ផ្ដេក បញ្ឈរ mediacenter or planar)"

#: main.cpp:136
msgid "Displays a list of known applets"
msgstr "បង្ហាញ​បញ្ជី​អាប់ភ្លេត​ដែលស្គាល់"

#: main.cpp:138
msgid "Displays a list of known wallpapers"
msgstr "បង្ហាញ​បញ្ជី​ផ្ទាំង​រូបភាព​​ដែល​បាន​ស្គាល់"

#: main.cpp:140
msgid "Displays a list of known containments"
msgstr "បង្ហាញ​បញ្ជី​ការ​ផ្ទុក​ដែល​ស្គាល់"

#: main.cpp:142
msgid "Displays a list of known themes"
msgstr "បង្ហាញ​បញ្ជី​រូបរាង​​អាប់ភ្លេត​ដែលស្គាល់"

#: main.cpp:143
msgid "Disables save and restore of the config between runs"
msgstr "បិទ​កា​ររក្សាទុក និង​ស្ដារ​ការ​កំណត់​រចនាសម្ព័​ន្ធ​រវាង​ដំណើរការ"

#: main.cpp:145
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr "កម្រិត​ទីតាំង​​ដើម្បី​ចាប់ផ្ដើម​​ទប់​ជា​មួយ (អណ្ដែត ផ្ទៃតុ ពេញអេក្រង់ កំបូល បាត ឆ្វេង ស្ដាម)"

#: main.cpp:147
#, fuzzy
#| msgid "The size in kB to set the pixmap cache to"
msgid "The size in kB to set the pixmap cache to"
msgstr "ទំហំ​គិតជា​គីឡូបៃ​ ដើម្បី​កំណត់​ឃ្លាំង​សម្ងាត់​ pixmap"

#: main.cpp:149
msgid ""
"Takes a screenshot of the widget and saves it the working directory as "
"<pluginname>.png"
msgstr "ថត​រូប​អេក្រង់​របស់​ធាតុក្រាហ្វិក ហើយ​រក្សាទុក​វា​ក្នុងថត​ដំណើរការ​ជា<pluginname>.png"

#: main.cpp:151
msgid ""
"Takes a screenshot of each widget and saves it the working directory as "
"<pluginname>.png"
msgstr "ថត​រូប​អេក្រង់​របស់​ធាតុក្រាហ្វិក​នីមួយៗ​ ហើយ​រក្សាទុក​វា​ក្នុង​ថត​ដំណើរការ​ជា <pluginname>.png"

#: main.cpp:153
msgid "Desktop SVG theme to use"
msgstr "ស្បែក​ផ្ទៃតុ SVG ត្រូវ​ប្រើ"

#: main.cpp:155
msgid "Initial size"
msgstr ""

#: main.cpp:157
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr "ឈ្មោះ​របស់​កម្មវិធី​ជំនួយ​ផ្ទាំង​រូបភាព ។ តម្រូវ​ឲ្យ​បញ្ជាក់​​កម្មវិធី​ជំនួយ​ផ្ទុក ។"

#: main.cpp:158
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"ឈ្មោះ​អាប់ភ្លេត​ត្រូវ​មើល អាច​សំអាង​លើ​ឈ្មោះ​កម្មវិធី​ជំនួយ ឬ​ជា​ផ្លូវ (ពេញលេញ ឬ​ទាក់ទង) ទៅ​កញ្ចប់ ។ "
"ប្រសិនបើ​មិន​បានផ្ដល់ បន្ទាប់​មក​ការ​ប៉ុនប៉ង​ត្រូ​វបាន​ធ្វើ​ឡើង ដើម្បី​ផ្ទុក​កញ្ចប់​ពី​ថត​បច្ចុប្បន្ន ។"

#: main.cpp:161
msgid "Optional arguments of the applet to add"
msgstr "អាគុយម៉ង់​ជម្រើស​របស់​អាប់ភ្លេត​ត្រូវ​បន្ថែម"

#: main.cpp:162
msgid "List zeroconf announced remote widgets"
msgstr "រាយ​ zeroconf ដែល​បានប្រកាស​ធាតុ​ក្រាហ្វិក​ពីចម្ងាយ"

