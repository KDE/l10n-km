#: src/scheduler.cpp:245
msgctxt "@info"
msgid ""
"<para>You accepted an invitation update, but an earlier version of the item "
"could not be found in your calendar.</para><para>This may have occurred "
"because:<list><item>the organizer did not include you in the original "
"invitation</item><item>you did not accept the original invitation yet</"
"item><item>you deleted the original invitation from your calendar</"
"item><item>you no longer have access to the calendar containing the "
"invitation</item></list></para><para>This is not a problem, but we thought "
"you should know.</para>"
msgstr ""
"<para>អ្នក​ព្រម​ទទួល​យក​បច្ចុប្បន្នភាព​នៃ​ការ​អញ្ជើញ ប៉ុន្តែ​កំណែ​មុន​របស់​ធាតុ​មិន​ត្រូវ​បាន​រក​ឃើញ​នៅ​ក្នុង​ប្រតិទិន​"
"របស់​អ្នក​ទេ ។</para><para>​នេះ​អាច​បណ្ដាល​​មកពី ៖<list><item>កម្មវិធី​រៀបចំ​មិន​រួមបញ្ចូល​ការ​អញ្ជើញ​"
"ដើម</item><item>អ្នក​មិន​ព្រម​ទទួល​ការ​អញ្ជើញ​ដើម</item><item>អ្នក​បាន​លុប​ការ​អញ្ជើញ​ដើម​ពី​ប្រតិទិន​"
"របស់​អ្នក</item><item>អ្នក​មិន​មាន​សិទ្ធិ​ក្នុង​ការ​ប្រើ​ប្រតិទិន​ដែល​មានការ​អញ្ជើញ​តទៅទៀត</item></"
"list></para><para>វា​មិនមែន​ជា​បញ្ហា​ទេ ប៉ុន្តែ​អ្នក​គួរតែ​ដឹង ។</para>"

#: src/scheduler.cpp:254
msgctxt "@title"
msgid "Cannot find invitation to be updated"
msgstr "រក​មិន​ឃើញ​ការ​អញ្ជើញ​ដែល​ត្រូវ​ធ្វើ​បច្ចុប្បន្នភាព​ទេ"

#: src/scheduler.cpp:349
msgctxt "@info"
msgid ""
"The event or task could not be removed from your calendar. Maybe it has "
"already been deleted or is not owned by you. Or it might belong to a read-"
"only or disabled calendar."
msgstr ""
"មិន​អាច​យក​ព្រឹត្តិការណ៍ ឬ​ភារកិច្ច​ចេញពី​ប្រតិទិន​របស់​អ្នក​បាន​ទេ ។ វា​ប្រហែលជា​ត្រូវ​បាន​លុប ឬ​អ្នក​មិនមែន​ជា​"
"ម្ចាស់ ។ ឬ​វា​ប្រហែលជា​បានតែ​អាន ឬ​ប្រតិទិន​បាន​បិទ ។"

