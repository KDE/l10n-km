msgstr "សារ​ដែល​បាន​អ៊ិនគ្រីប (មិនអាច​ធ្វើការ​ឌិគ្រីប​បាន)"

#: viewer/messagepart.cpp:228
#, kde-format
msgid "Reason: %1"
msgstr "ហេតុផល ៖ %1"

#: viewer/messagepart.cpp:245
msgid "End of encrypted message"
msgstr "ខាងចុង​សារដែលបាន​អ៊ិនគ្រីប"

#: viewer/messagepart.cpp:290
msgid "Error: Signature not verified"
msgstr "មាន​កំហុស ៖ មិនបាន​បញ្ជាក់​ហត្ថលេខាឡើយ"

#: viewer/messagepart.cpp:293
msgid "Good signature"
msgstr "ហត្ថលេខា​ដែល​ល្អ"

#: viewer/messagepart.cpp:296
msgid "<b>Bad</b> signature"
msgstr "ហត្ថលេខា<b>អាក្រក់</b>"

#: viewer/messagepart.cpp:299
msgid "No public key to verify the signature"
msgstr "គ្មាន​សាធារណៈ​ដែល​ត្រូវ​ផ្ទៀងផ្ទាត់​ហត្ថលេខាឡើយ"

#: viewer/messagepart.cpp:302
msgid "No signature found"
msgstr "គ្មាន​ហត្ថលេខា​ដែល​រកឃើញ​ឡើយ"

#: viewer/messagepart.cpp:305
msgid "Error verifying the signature"
msgstr "មាន​កំហុស​នៅខណៈ​ពេល​ដែល​កំពុង​ផ្ទៀងផ្ទាត់​ហត្ថលេខា"

#: viewer/messagepart.cpp:308
msgid "Different results for signatures"
msgstr "លទ្ធផល​ផ្សេងគ្នា​ សម្រាប់​ហត្ថលេខា"

#: viewer/messagepart.cpp:327
msgid "No status information available."
msgstr "មិនមាន​ព័ត៌មាន​ស្ថានភាពឡើយ ។"

#: viewer/messagepart.cpp:334 viewer/messagepart.cpp:420
msgid "Good signature."
msgstr "ហត្ថលេខា​ល្អ ។"

#: viewer/messagepart.cpp:355
msgid "One key has expired."
msgstr "សោ​មួយ​បាន​ផុតកំណត់​ហើយ ។"

#: viewer/messagepart.cpp:359
msgid "The signature has expired."
msgstr "ហត្ថលេខា​បាន​ផុត​កំណត់​ហើយ ។"

#: viewer/messagepart.cpp:364
msgid "Unable to verify: key missing."
msgstr "មិនអាចផ្ទៀងផ្ទាត់បាន ៖ បាត់បង់សោ ។"

#: viewer/messagepart.cpp:371
msgid "CRL not available."
msgstr "មិនមាន CRL ។"

#: viewer/messagepart.cpp:375
msgid "Available CRL is too old."
msgstr "CRL ដែល​មាន​ គឺ​ចាស់​ពេក ។"

#: viewer/messagepart.cpp:379
msgid "A policy was not met."
msgstr "មិបានជួប​គោលការណ៍ឡើយ ។"

#: viewer/messagepart.cpp:383
msgid "A system error occurred."
msgstr "កំហុស​ប្រព័ន្ធ​បាន​កើត​មានឡើយ ។"

#: viewer/messagepart.cpp:394
msgid "One key has been revoked."
msgstr "សោ​មួយ​ត្រូវបាន​ដកហូតវិញ ។"

#: viewer/messagepart.cpp:422
msgid "<b>Bad</b> signature."
msgstr "ហត្ថលេខា<b>មិន​ត្រឹមត្រូវ</b> ។"

#: viewer/messagepart.cpp:448
msgid "Invalid signature."
msgstr "ហត្ថលេខា​មិន​ត្រឹមត្រូវ ។"

#: viewer/messagepart.cpp:451
msgid "Not enough information to check signature validity."
msgstr "មិន​មាន​ព័ត៌មាន​គ្រប់គ្រាន់​ដើម្បី​ពិនិត្យ​មើល​សុពលភាព​របស់​ហត្ថលេខា​ឡើយ ។"

#: viewer/messagepart.cpp:465
msgid "Signature is valid."
msgstr "ហត្ថលេខា​គឺ​ត្រឹមត្រូវ ។"

#: viewer/messagepart.cpp:467
#, kde-format
msgid "Signed by <a href=\"mailto:%1\">%2</a>."
msgstr "បាន​ចុះហត្ថលេខា​ដោយ <a href=\"mailto:%1\">%2</a> ។"

#: viewer/messagepart.cpp:472
msgid "Unknown signature state"
msgstr "មិន​ស្គាល់​ស្ថានភាព​ហត្ថលេខា"

#: viewer/messagepart.cpp:480
msgid "Show Details"
msgstr "បង្ហាញសេចក្តី​​​លម្អិត"

#: viewer/messagepart.cpp:503
msgid "No Audit Log available"
msgstr "គ្មាន​កំណត់​ត្រួតពិនិត្យ"

#: viewer/messagepart.cpp:505
#, kde-format
msgid "Error Retrieving Audit Log: %1"
msgstr "កំហុស​ក្នុង​ការ​ទៅយក​កំណត់​ហេតុ​ការ​ត្រួត​ពិនិត្យ ៖ %1"

#: viewer/messagepart.cpp:516
msgctxt "The Audit Log is a detailed error log from the gnupg backend"
msgid "Show Audit Log"
msgstr "បង្ហាញ​កំណត់ហេតុ​ត្រួតពិនិត្យ"

#: viewer/messagepart.cpp:527
msgid "Hide Details"
msgstr "លាក់​សេចក្តី​លម្អិត"

#: viewer/messagepart.cpp:548
msgid "Please wait while the signature is being verified..."
msgstr "សូម​រង់ចាំ​ខណៈ​ពេល​ដែល​ហត្ថលេខា​កំពុង​ត្រូវ​បាន​ផ្ទៀងផ្ទាត់​​..."

#: viewer/messagepart.cpp:639 viewer/messagepart.cpp:641
msgid "certificate"
msgstr "​វិញ្ញាបនបត្រ"

#: viewer/messagepart.cpp:647 viewer/messagepart.cpp:673
msgctxt "Start of warning message."
msgid "Warning:"
msgstr "​ការព្រមាន ៖"

#: viewer/messagepart.cpp:649
#, kde-format
msgid "Sender's mail address is not stored in the %1 used for signing."
msgstr ""
"អាសយដ្ឋាន​សំបុត្រ​របស់អ្នកផ្ញើ គឺ​​មិនត្រូវបាន​ទុក​នៅក្នុង​ %1 ដែលត្រូវបាន​ប្រើសម្រាប់​ការចុះហត្ថលេខាឡើយ​ ។"

#: viewer/messagepart.cpp:652
msgid "sender: "
msgstr "អ្នកផ្ញើ ៖ "

#: viewer/messagepart.cpp:655
msgid "stored: "
msgstr "បានទុក ៖ "

#: viewer/messagepart.cpp:675
#, kde-format
msgid ""
"No mail address is stored in the %1 used for signing, so we cannot compare "
"it to the sender's address %2."
msgstr ""
"គ្មាន​​អាសយដ្ឋាន​សំបុត្រ​​​បាន​ទុក​នៅក្នុង %1 ដែលបានប្រើ​សម្រាប់​ការចុះហត្ថលេខាឡើយ ដូច្នេះ​យើង​មិនអាច​"
"ប្រៀបធៀប​វា​ទៅកាន់​អាសយដ្ឋាន​របស់​អ្នក​ផ្ញើ​ %2 ទេ ។"

#: viewer/messagepart.cpp:698
#, kde-format
msgid "Not enough information to check signature. %1"
msgstr "គ្មាន​ព័ត៌មាន​គ្រប់គ្រាន់​ដើម្បី​ពិនិត្យ​ហត្ថលេខាទេ ។ %1"

#: viewer/messagepart.cpp:714 viewer/messagepart.cpp:781
msgid "Message was signed with unknown key."
msgstr "សារត្រូវបាន​ចុះហត្ថលេខា​ដោយ​ប្រើ​សោ​មិនស្គាល់ ។"

#: viewer/messagepart.cpp:716 viewer/messagepart.cpp:811
#: viewer/messagepart.cpp:844
#, kde-format
msgid "Message was signed by %1."
msgstr "សារ​ត្រូវ​បាន​ចុះហត្ថលេខា​ដោយ %1 ។"

#: viewer/messagepart.cpp:723 viewer/messagepart.cpp:730
#: viewer/messagepart.cpp:739
#, kde-format
msgid "Message was signed with key %1."
msgstr "សារ​ត្រូវបាន​ចុះហត្ថលេខា​ដោយប្រើសោ %1 ។"

#: viewer/messagepart.cpp:725
#, kde-format
msgid "Message was signed on %1 with key %2."
msgstr "សារ​ត្រូវ​បាន​ចុះហត្ថលេខា​នៅ​លើ %1 ដោយ​ប្រើ​សោ %2 ។"

#: viewer/messagepart.cpp:732
#, kde-format
msgid "Message was signed by %3 on %1 with key %2"
msgstr "សារ​ត្រូវ​បាន​ចុះហត្ថលេខា​ដោយ %3 នៅ​លើ %1 ដោយ​ប្រើ​សោ %2"

#: viewer/messagepart.cpp:741
#, kde-format
msgid "Message was signed by %2 with key %1."
msgstr "សារ​ត្រូវ​បាន​ចុះហត្ថលេខា​ដោយ %2 ដោយ​ប្រើ %1 ។"

#: viewer/messagepart.cpp:750 viewer/messagepart.cpp:788
#: viewer/messagepart.cpp:1855
msgid "Status: "
msgstr "ស្ថានភាព ៖ "

#: viewer/messagepart.cpp:774
#, kde-format
msgid "Message was signed on %1 with unknown key %2."
msgstr "សារ​ត្រូវ​បាន​ចុះហត្ថលេខា​នៅ​លើ %1 ដោយ​ប្រើ​សោ​មិន​ស្គាល់ %2 ។"

#: viewer/messagepart.cpp:778
#, kde-format
msgid "Message was signed with unknown key %1."
msgstr "សារ​ត្រូវ​បាន​ចុះហត្ថលេខា​ដោយ​សោ​មិន​ស្គាល់ %1 ។"

#: viewer/messagepart.cpp:784
msgid "The validity of the signature cannot be verified."
msgstr "មិនអាច​ផ្ទៀងផ្ទាត់​សុពលភាព​របស់​ហត្ថលេខា​បានឡើយ ។"

#: viewer/messagepart.cpp:807 viewer/messagepart.cpp:840
#, kde-format
msgid "Message was signed by %2 (Key ID: %1)."
msgstr "ហត្ថលេខា​ត្រូវ​បាន​ចុះ​ហត្ថលេខា​ដោយ %2 (លេខ​សម្គាល់​សោ ៖ %1) ។"

#: viewer/messagepart.cpp:817
msgid "The signature is valid, but the key's validity is unknown."
msgstr "ហត្ថលេខា​គឺ​ត្រឹមត្រូវ ប៉ុន្តែ​មិនស្គាល់​សុពលភាព​របស់​សោទេ ។"

#: viewer/messagepart.cpp:821
msgid "The signature is valid and the key is marginally trusted."
msgstr "ហត្ថលេខា​គឺ​ត្រឹមត្រូវ ហើយ សោ​មិនទាន់​បាន​ទុកចិត្ត​គ្របគ្រាន់ទេ ។"

#: viewer/messagepart.cpp:825
msgid "The signature is valid and the key is fully trusted."
msgstr "ហត្ថលេខា​គឺ​ត្រឹមត្រូវ​ ហើយ សោ​គឺ​ត្រូវ​បាន​ទុក​ចិត្ត​យ៉ាងពេញលេញ ។"

#: viewer/messagepart.cpp:829
msgid "The signature is valid and the key is ultimately trusted."
msgstr "ហត្ថលេខា​គឺ​ត្រឹមត្រូវ ហើយ​ សោ​គឺ​ត្រូវ​បាន​ទុក​ចិត្ត​ជាទីបំផុត ។"

#: viewer/messagepart.cpp:833
msgid "The signature is valid, but the key is untrusted."
msgstr "ហត្ថលេខា​គឺ​ត្រឹមត្រូវ ប៉ុន្តែ​សារ​មិនត្រូវបាន​ទុក​ចិត្តឡើយ ។"

#: viewer/messagepart.cpp:847
msgid "Warning: The signature is bad."
msgstr "ព្រមាន ៖ ហត្ថលេខា​គឺអាក្រក់ ។"

#: viewer/messagepart.cpp:879
msgid "End of signed message"
msgstr "ខាងចុង​សារ​ដែលបាន​ចុះហត្ថលេខា"

#: viewer/messagepart.cpp:1443
msgid ""
"<b>Note:</b> This HTML message may contain external references to images "
"etc. For security/privacy reasons external references are not loaded. If you "
"trust the sender of this message then you can load the external references "
"for this message <a href=\"kmail:loadExternal\">by clicking here</a>."
msgstr ""
"<b>ចំណាំ ៖</b> សារ​ HTML នេះ​អាច​មាន​សេចក្ដី​យោង​​​ខាងក្រៅដែលទៅកាន់​រូបភាព ។ល។ ចំពោះ​ហេតុផល "
"សុវត្ថិភាព​/ភាព​ជា​ឯកជន សេចក្ដី​យោង​ខាងក្រៅគឺមិនត្រូវបាន​ផ្ទុក​ឡើយ ។ ប្រសិន​បើអ្នកទុកចិត្ត​លើអ្នក​ផ្ញើ​"
"សារនេះ ពេលនោះ​អ្នក​អាច​ផ្ទុក​សេចក្ដី​យោង​ខាងក្រៅ​​សម្រាប់​សារ​នេះ <a href=\"kmail:loadExternal"
"\">ដោយ​ចុច​នៅទីនេះ</a> ។"

#: viewer/messagepart.cpp:1456
msgid ""
"<b>Note:</b> This is an HTML message. For security reasons, only the raw "
"HTML code is shown. If you trust the sender of this message then you can "
"activate formatted HTML display for this message <a href=\"kmail:showHTML"
"\">by clicking here</a>."
