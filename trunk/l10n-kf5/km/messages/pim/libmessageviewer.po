#: viewer/messagepart.cpp:222
msgid "Please wait while the message is being decrypted..."
msgstr "សូម​រង់​ចាំ​ខណៈ​ពេល​សារ​កំពុង​ត្រូវ​ឌិគ្រីប​​..."

#: viewer/messagepart.cpp:224
