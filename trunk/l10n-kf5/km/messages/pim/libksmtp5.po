#: loginjob.cpp:95
#, kde-format
msgid "Login"
msgstr "ចូល"

#: loginjob.cpp:214
#, kde-format
msgid ""
"Could not authenticate to the SMTP server because no matching authentication "
"method has been found"
msgstr ""
"មិនអាច​ផ្ទៀងផ្ទាត់​ម៉ាស៊ីន​បម្រើ SMTP បានទេ ពីព្រោះ​រក​មិនឃើញ​វិធីសាស្ត្រ​ផ្ទៀងផ្ទាត់​ភាព​ត្រឹមត្រូវ​ដែល​ផ្គូផ្គង"

#: loginjob.cpp:301
#, kde-format
msgid "Login failed, cannot initialize the SASL library"
msgstr ""

#: sendjob.cpp:73
#, kde-format
msgid "SendJob"
msgstr "SendJob"

#: sendjob.cpp:83
#, kde-format
msgid ""
"Could not send the message because either the sender or recipient field is "
"missing or invalid"
msgstr "មិនអាច​ផ្ញើ​សារ​បាន​ទេ ពីព្រោះ​ទាំង​​វាល​អ្នក​ផ្ញើ ឬ​អ្នក​ទទួល​បាត់ ឬ​មិន​ត្រឹមត្រូវ"

#: sendjob.cpp:91
#, kde-format
msgid ""
"Could not send the message because it exceeds the maximum allowed size of %1 "
"bytes. (Message size: %2 bytes.)"
msgstr ""
"មិនអាច​ផ្ញើ​សារ​បាន​ទេ​ ពីព្រោះ​វា​លើស​ទំហំ​ដែលបាន​អនុញ្ញាត​អតិបរមា %1 បៃ ។ (ទំហំ​សារ ៖ %2 បៃ ។)"
