#: adddevicedialog.cpp:45
#, fuzzy, kde-format
#| msgid ""
#| "<qt><p>If your scanner has not been automatically detected, you can "
#| "specify it here. The <b>Scanner device name</b> should be a backend name "
#| "(with optional parameters) that is understood by SANE, see <a href=\"man:/"
#| "sane\">sane(7)</a> or <a href=\"man:/sane-dll\">sane-dll(5)</a> for more "
#| "information on available backends. The <b>Type</b> and <b>Description</b> "
#| "can be used to identify the scanner later.<p>For the information that "
#| "needs to be entered here, try to locate the device using the <a href="
#| "\"man:/sane-find-scanner\">sane-find-scanner(1)</a> command. For a USB or "
#| "networked HP scanner using <a href=\"http://hplip.sourceforge.net/"
#| "\">HPLIP</a>, try using the <u>hp-probe</u> command to locate it, for "
#| "example 'hp-probe&nbsp;-b&nbsp;usb' or 'hp-probe&nbsp;-b&nbsp;net'. If "
#| "the scanner is found, then enter the device name displayed by these "
#| "commands; note that if using HPLIP then \"hp:\" needs to be be replaced "
#| "by \"hpaio:\".<p>If these commands fail to locate your scanner, then it "
#| "may not be supported by SANE. Check the SANE documentation for a <a href="
#| "\"http://www.sane-project.org/sane-supported-devices.html\">list of "
#| "supported devices</a>.<br>"
msgid ""
"<qt><p>If your scanner has not been automatically detected, you can specify "
"it here. The <b>Scanner device name</b> should be a backend name (with "
"optional parameters) that is understood by SANE, see <a href=\"man:/sane"
"\">sane(7)</a> or <a href=\"man:/sane-dll\">sane-dll(5)</a> for more "
"information on available backends. The <b>Type</b> and <b>Description</b> "
"can be used to identify the scanner later.<p>For the information that needs "
"to be entered here, try to locate the device using the <a href=\"man:/sane-"
"find-scanner\">sane-find-scanner(1)</a> command. For a USB or networked HP "
"scanner using <a href=\"http://hplip.sourceforge.net/\">HPLIP</a>, try using "
"the <u>hp-probe</u> command to locate it, for example 'hp-probe&nbsp;-b&nbsp;"
"usb' or 'hp-probe&nbsp;-b&nbsp;net'. If the scanner is found, then enter the "
"device name displayed by these commands; note that if using HPLIP then \"hp:"
"\" needs to be replaced by \"hpaio:\".<p>If these commands fail to locate "
"your scanner, then it may not be supported by SANE. Check the SANE "
"documentation for a <a href=\"http://www.sane-project.org/sane-supported-"
"devices.html\">list of supported devices</a>.<br>"
msgstr ""
"<qt><p>ប្រសិនបើ​ម៉ាស៊ីន​ស្កេន​របស់​អ្នក​មិន​ត្រូវ​បាន​រក​ឃើញ​ដោយ​ស្វ័យ​ប្រវត្តិ​ទេ​នោះ អ្នក​អាច​បញ្ជា​វា​បាន​នៅ​"
"ទីនេះ ។ <b>ឈ្មោះ​ឧបករណ៍​ម៉ាស៊ីន​ស៊ីនស្កេន</b> គួរតែ​ជា​ឈ្មោះ​កម្មវិធី​ខាងក្រោយ (ដោយ​មាន​ប៉ារ៉ាម៉ែត្រ​ជា​"
"ជម្រើស) ដែល​ត្រូវ​បាន​ស្គាល់​ដោយ SANE សូម​មើល <a href=\"man:/sane\">sane(7)</a> or <a "
"href=\"man:/sane-dll\">sane-dll(5)</a> សម្រាប់​ព័ត៌មាន​បន្ថែម​​មាន​នៅ​កម្មវិធី​ខាងក្រោយ ។ "
"<b>ប្រភេទ</b> និង <b>សេចក្ដី​ពិពណ៌នា</b> អាច​ត្រូវ​បាន​ប្រើ ដើម្បី​កំណត់​ម៉ាស៊ីន​ស្កេន​ពេល​ក្រោយ ។"
"<p>សម្រាប់​ព័ត៌មាន​ដែល​​ចាំបាច់​ត្រូវ​បាន​បញ្ចូល​នៅ​ទីនេះ ព្យាយាម​រក​ទីតាំង​ឧបករណ៍​ដោយ​ប្រើ​ពាក្យ​បញ្ជា <a "
"href=\"man:/sane-find-scanner\">sane-find-scanner(1)</a> ។ សម្រាប់ USB ឬ​ការ​ប្រើ​"
"ម៉ាស៊ីន​ស្កេន HP ដែល​បាន​ភ្ជាប់​បណ្ដាញ <a href=\"http://hplip.sourceforge.net/\">HPLIP</"
"a> សាកល្បង​ដោយ​ប្រើ​ពាក្យ​បញ្ជា <u>hp-probe</u> ដើម្បី​រក​ទីតាំង​របស់​វា ឧទាហរណ៍ 'hp-"
"probe&nbsp;-b&nbsp;usb' or 'hp-probe&nbsp;-b&nbsp;net' ។ ប្រសិនបើ​រក​មិន​ឃើញ​ម៉ាស៊ីន​"
"ស្កេន​ទេ​នោះ បញ្ចូល​ឈ្មោះ​ឧបករណ៍​ដែល​បាន​បង្ហាញ​ដោយ​ពាក្យ​បញ្ជា​ទាំង​នេះ ចំណាំ​ថា ប្រសិនបើ​ប្រើ HPLIP "
"បន្ទាប់ \"hp:\" ត្រូវ​ជំនួស​ដោយ \"hpaio:\" ។<p>ប្រសិនបើ​បរាជ័យ​ពាក្យ​បញ្ជា ត្រូវ​រក​ម៉ាស៊ីន​ស្កេន​របស់​"
"អ្នក នោះ​វា​មិន​អាច​ត្រូវ​បាន​គាំទ្រ​ដោយ SANE ឡើយ ។ ពិនិត្យ​មើល​ឯកសារ SANE សម្រាប់​បញ្ជី <a href="
"\"http://www.sane-project.org/sane-supported-devices.html\">នៃ​ឧបករណ៍​ដែល​បាន​"
"គាំទ្រ</a> ។<br>"

