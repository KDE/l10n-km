#: data/org.kde.yakuake.desktop:2
msgctxt "Name"
msgid "Yakuake"
msgstr "Yakuake"

#: data/org.kde.yakuake.desktop:61
msgctxt "GenericName"
msgid "Drop-down Terminal"
msgstr "ស្ថានីយ​ទម្លាក់​ចុះ"

#: data/org.kde.yakuake.desktop:117
msgctxt "Comment"
msgid "A drop-down terminal emulator based on KDE Konsole technology."
msgstr "កម្មវិធី​ត្រាប់​ស្ថានីយ​ធ្លាក់​ចុះ​ដែល​មាន​មូលដ្ឋាន​លើ​បច្ចេក​វិទ្យា​កុងសូល​របស់ KDE ។"

