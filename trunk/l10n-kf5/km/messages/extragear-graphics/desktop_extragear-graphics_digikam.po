#: app/main/digikam.notifyrc:3
msgctxt "Comment"
msgid "digiKam"
msgstr "digiKam ​"

#: app/main/digikam.notifyrc:55
msgctxt "Name"
msgid "Download complete"
msgstr "ការទាញ​យកបាន​​បញ្ចប់"

#: app/main/digikam.notifyrc:101
msgctxt "Comment"
msgid "A download from a camera or other device has finished."
msgstr "កា​ទាញ​យក​ពី​ម៉ាស៊ីន​ថត​ ឬ​ឧបករណ៍​ផ្សេង​ទៀត​បាន​បញ្ចប់​ ។"

#: app/main/digikam.notifyrc:148
msgctxt "Name"
msgid "Save file complete"
msgstr "បាន​បញ្ចប់​ការ​រក្សាទុក​ឯកសារ​"

#: app/main/digikam.notifyrc:188
msgctxt "Comment"
msgid "A file from image editor is saved."
msgstr "ឯកសារ​មក​ពី​​កម្មវិធី​កែសម្រួល​រូបភាព​​ត្រូវ​បាន​រក្សាទុក ។"

#: app/main/digikam.notifyrc:231
msgctxt "Name"
msgid "Batch queue completed"
msgstr "បាន​បញ្ចប់​ជួរ​ជា​​ក្រុម​"

#: app/main/digikam.notifyrc:272
msgctxt "Comment"
msgid "A queue in the batch queue manager has been completed."
msgstr "ជួរ​​នៅ​ក្នុង​កម្មវិធី​គ្រប់​គ្រង​ជួរជា​​ក្រុម​ត្រូវ​បាន​បញ្ចប់ ។"

#: app/main/digikam.notifyrc:315
msgctxt "Name"
msgid "Update of fingerprint database complete"
msgstr "បាន​បញ្ចប់​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​​ស្នាម​ម្រាម​ដៃ​"

#: app/main/digikam.notifyrc:357
msgctxt "Comment"
msgid "The update of the fingerprint database has been completed."
msgstr "បានបញ្ចប់​​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​ស្នាម​ម្រាម​ដៃ​ ។"

#: app/main/digikam.notifyrc:402
msgctxt "Name"
msgid "Update of thumbnails database complete"
msgstr "បានបញ្ចប់​ការ​ធ្វើ​​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​រូបភាពតូច​ៗ"

#: app/main/digikam.notifyrc:444
msgctxt "Comment"
msgid "The update of the thumbnails database has been completed."
msgstr "បានបញ្ចប់​កា​រ​ធ្វើ​បច្ចុប្បន្នភាព​​មូលដ្ឋាន​ទិន្នន័យ​រូបភាព​តូច​ៗ ។"

#: app/main/digikam.notifyrc:489
msgctxt "Name"
msgid "Synchronization of images' metadata with database completed"
msgstr "ការ​ធ្វើ​សមកាល​កម្ម​ទិន្នន័យ​មេតា​របស់​រូបភាព​ជា​មួយ​នឹង​មូលដ្ឋាន​ទិន្នន័យ​បាន​បញ្ចប់ ។"

#: app/main/digikam.notifyrc:530
msgctxt "Comment"
msgid ""
"The synchronization of the images' metadata with the database has been "
"completed."
msgstr "ការ​ធ្វើ​សមកាល​កម្ម​ទិន្នន័យ​មេតា​របស់​រូបភាព​ជា​មួយ​នឹង​មូលដ្ឋាន​ទិន្នន័យ​ត្រូវ​បាន​បញ្ចប់ ។"

#: app/main/digikam.notifyrc:574
msgctxt "Name"
msgid "Update of detected faces database complete"
msgstr "បាន​បញ្ចប់​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​​​ដែល​រក​​ផ្ទៃ​​ដែល​រក​ឃើញ​"

#: app/main/digikam.notifyrc:613
msgctxt "Comment"
msgid "The update of the detected faces database has completed."
msgstr "បាន​បញ្ចប់​​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​ផ្ទៃ​ដែល​រក​ឃើញ ។"

#: app/main/digikam.notifyrc:655
msgctxt "Name"
msgid "Update of duplicates items in database complete"
msgstr "បាន​បញ្ចប់​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​​​ដែល​រក​​ផ្ទៃ​​ដែល​រក​ឃើញ​"

#: app/main/digikam.notifyrc:693
msgctxt "Comment"
msgid "The update of the duplicates items in database has completed."
msgstr "បាន​បញ្ចប់​​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​ផ្ទៃ​ដែល​រក​ឃើញ ។"

#: app/main/digikam.notifyrc:734
msgctxt "Name"
msgid "Find of new items in database complete"
msgstr "បាន​បញ្ចប់​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​​ស្នាម​ម្រាម​ដៃ​"

#: app/main/digikam.notifyrc:772
msgctxt "Comment"
msgid "The scan of the new items in database has completed."
msgstr "បាន​បញ្ចប់​​ការ​ធ្វើ​បច្ចុប្បន្នភាព​មូលដ្ឋាន​ទិន្នន័យ​ផ្ទៃ​ដែល​រក​ឃើញ ។"

