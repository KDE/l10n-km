#| "will attempt to start now, but it will <b>not</b> be functional. Please "
#| "check the database settings in the <b>configuration menu</b>.</p>"
msgid ""
"<p>Failed to open the database. Error message from database:</p><p><b>%1</"
"b></p><p>You cannot use digiKam without a working database. digiKam will "
"attempt to start now, but it will <b>not</b> be functional. Please check the "
"database settings in the <b>configuration menu</b>.</p>"
msgstr ""
"<p>បាន​បរាជ័យ​ក្នុង​ការ​បើក​មូលដ្ឋាន​ទិន្នន័យ ។ កំហុស​សារ​ពី​មូលដ្ឋាន​ទិន្នន័យ ៖</p><p><b>%1</b></p></"
"p><p>អ្នក​មិន​អាច​ប្រើ digiKam ដោយ​គ្មាន​មូលដ្ឋាន​ទិន្នន័យ​បាន​ទេ ។ digiKam នឹង​ចាប់ផ្ដើម​ឥឡូវ​នេះ "
"ប៉ុន្តែ​នឹង <b>មិន​</b> ដំណើរការ​ឡើយ ។ សូម​ពិនិត្យមើល​ការ​កំណត់​មូលដ្ឋាន​ទិន្នន័យ​របស់​អ្នក​នៅ​ក្នុង <b>ម៉ឺនុយ​ការ​"
"កំណត់​រចនា​សម្ព័ន្ធ</b> ។</p>"

#: core/libs/album/manager/albummanager_database.cpp:236
#, kde-format
msgid ""
"Your locale has changed since this album was last opened.\n"
"Old locale: %1, new locale: %2\n"
"If you have recently changed your locale, you need not be concerned.\n"
"Please note that if you switched to a locale that does not support some of "
"the filenames in your collection, these files may no longer be found in the "
"collection. If you are sure that you want to continue, click 'Yes'. "
"Otherwise, click 'No' and correct your locale setting before restarting "
"digiKam."
msgstr ""
"អ្នក​បាន​ផ្លាស់​ប្ដូរ​ នៅ​ពេល​អាល់ប៊ុម​នេះ​ត្រូវ​បាន​បើក​ចុងក្រោយ ។\n"
"​ទីតាំង​​ចាស់  ៖ %1 ទីតាំង​ថ្មី ៖ %2\n"
"ប្រសិនបើ​​អ្នក​បាន​ផ្លាស់ប្ដូរ​​ទីតាំង​​របស់​អ្នក​បច្ចុប្បន្ន ។ អ្នក​មិន​ចាំបាច់​ព្រួយបារម្ភ​ឡើយ\n"
"សូម​ចំណាំ​ថា ប្រសិនបើ​អ្នក​ប្ដូរ​ទៅ​​ទីតាំង ដែល​មិន​គាំទ្រ​ឈ្មោះ​ឯកសារ​មួយ​ចំនួន​នៅ​ក្នុង​សម្រាំង​របស់​អ្នក​ទេ​នោះ ឯកសារ​"
"ទាំង​នេះ​អាច​នឹង​មិន​ត្រូវ​បាន​រក​ឃើញ​នៅ​ក្នុង​សម្រាំង​ទៀត​ទេ ។ ប្រសិនបើ​អ្នក​ប្រាកដ​ថា អ្នក​ចង់​បន្ត ចុច 'បាទ/"
"ចាស់' ។ បើ​មិន​ដូច្នេះ​ទេ ចុច 'ទេ' ហើយ​កែ​ការកំណត់​ទីតាំង​​របស់​អ្នក មុន​ពេល​ចាប់ផ្ដើម digiKam ឡើង​វិញ ។"

#: core/libs/album/manager/albummanager_database.cpp:278
#, kde-format
msgid ""
"<p>The collection </p><p><b>%1</b><br/>(%2)</p><p> is currently not found on "
"your system.<br/> Please choose the most appropriate option to handle this "
"situation:</p>"
msgstr ""
"រក​មិន​ឃើញ​<p>សម្រាំង </p><p><b>%1</b><br/>(%2)</p><p> បច្ចុប្បន្ន​នៅ​លើ​ប្រព័ន្ធ​របស់​អ្នក​ឡើយ ។"
"<br/> សូម​ជ្រើស​ជម្រើស​ត្រឹមត្រូវ​បំផុត ដើម្បី​ដោះស្រាយ​ស្ថានភាព​នេះ ៖</p>"

#: core/libs/album/manager/albummanager_database.cpp:296
#, kde-format
msgid ""
"<p>The collection is still available, but the identifier changed.<br/>This "
"can be caused by restoring a backup, changing the partition layout or the "
"file system settings.<br/>The collection is now located at this place:</p>"
msgstr ""
"<p>សម្រាំង​នៅ​តែ​អាច​រក​បាន ប៉ុន្តែ​បាន​ផ្លាស់ប្ដូរ​ឧបករណ៍​សម្គាល់ ។<br/>វា​អាច​បណ្ដាល​ដោយ​​ទុក​ការ​បម្រុង​ឡើង​"
"វិញ ការ​ផ្លាស់ប្ដូរ​​ប្លង់​ភាគ​ថាស ឬ​ការ​កំណត់​ប្រព័ន្ធ​ឯកសារ ។<br/>ឥឡូវ​នេះ​សម្រាំង​ត្រូវ​បាន​ដាក់​​នៅ​ទីកន្លែង​"
"នេះ ៖</p>"

#: core/libs/album/manager/albummanager_database.cpp:315
#, kde-format
msgid ""
"The collection is located on a storage device which is not always attached. "
"Mark the collection as a removable collection."
msgstr ""
"សម្រាំង​ត្រូវ​បាន​ដាក់​នៅ​លើ​ឧបករណ៍​ផ្ទុក ដែល​​មិន​ត្រូវ​បាន​​ភ្ជាប់​ជានិច្ច ។ សម្គាល់​ការ​សម្រាំង​ជា​សម្រាំងចល័ត ។"

