#: data/kdenlive.notifyrc:46
msgctxt "Name"
msgid "Rendering finished"
msgstr "បាន​បញ្ចប់​ការ​បង្ហាញ"

#: data/kdenlive.notifyrc:83
msgctxt "Comment"
