msgstr ""
"Kmail គាំទ្រ​ការអ៊ិនគ្រីប​តាម​រយៈ <guilabel>SSL</guilabel> និង​ <guilabel>TLS</"
"guilabel> (<guilabel>TLS</guilabel> គួរ​តែ​ពេញ​និយម​ជា​ង​បើ​វា​អាច​ប្រើបាន) ។"

#. Tag: para
#: getting-started.docbook:320
#, no-c-format
msgid "For POP3 &kmail; supports:"
msgstr "ចំពោះ POP3 ដែល​ Kmail គាំទ្រ ៖"

#. Tag: para
#: getting-started.docbook:323
#, no-c-format
msgid "<guilabel>Clear text</guilabel>,"
msgstr "<guilabel>ជម្រះអត្ថបទ​</guilabel> "

#. Tag: para
