#, no-c-format
msgid "<screeninfo>&kontact;'s Main View</screeninfo>"
msgstr "<screeninfo>ទិដ្ឋភាព​មេ​របស់ Kontact</screeninfo>"

#. Tag: phrase
#: index.docbook:203
#, no-c-format
