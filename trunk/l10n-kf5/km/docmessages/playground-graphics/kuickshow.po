#: index.docbook:779
#, no-c-format
msgid "Toggles showing the browser, if an image window is open"
msgstr "បិទ/បើក​ការ​បង្ហាញ​កម្មវិធី​រុករក បើ​បង្អួច​រូបភាព​បើក"

#. Tag: keycap
#: index.docbook:782
#, no-c-format
msgid "any alpha-numeric character"
msgstr ""

#. Tag: entry
#: index.docbook:783
#, no-c-format
msgid ""
"Opens the edit field used for <quote>completion</quote>. Enter the first "
"characters of a filename to search for, and if found, the file will be "
"selected."
msgstr ""
"បើក​វាល​កែ​សម្រួល​ដែល​ប្រើ​សម្រាប់ <quote>ការ​បំពេញ</quote> ។ បញ្ចូល​តួ​អក្សរ​ដំបូង​នៃ​ឈ្មោះ​ឯកសារ​ដើម្បី​"
"ស្វែងរក និង​បើ​រក​ឃើញ ឯកសារ​នឹង​ត្រូវ​បាន​ជ្រើស ។"

#. Tag: entry
#: index.docbook:797
#, no-c-format
msgid "Deletes the current file. You will be asked to confirm the action."
msgstr "លុប​ឯកសារ​បច្ចុប្បន្ន ។ អ្នក​មិន​ត្រូវ​បាន​សួរ​ដើម្បី​បញ្ជាក់​សកម្មភាព ។"

#. Tag: entry
#: index.docbook:803
#, no-c-format
msgid "Deletes the current file without asking for confirmation."
msgstr "លុប​ឯកសារ​បច្ចុប្បន្ន​ដោយ​មិន​សួរ​សម្រាប់​ការ​បញ្ជាក់ ។"

