#. Tag: programlisting
#: development.docbook:741
#, no-c-format
msgid "&lt;HlCOct (common attributes) /&gt;"
msgstr ""

#. Tag: para
#: development.docbook:742 development.docbook:751 development.docbook:760
#: development.docbook:781 development.docbook:848 development.docbook:863
#, no-c-format
msgid "This rule has no specific attributes."
msgstr ""

#. Tag: term
#: development.docbook:747
#, no-c-format
msgid "HlCHex"
msgstr ""

#. Tag: para
#: development.docbook:749
#, no-c-format
msgid "Detect a hexadecimal number representation."
msgstr ""

#. Tag: programlisting
#: development.docbook:750
#, no-c-format
msgid "&lt;HlCHex (common attributes) /&gt;"
